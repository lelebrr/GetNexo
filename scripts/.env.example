# Configurações para Sentinel v3

# URL do site
SITE_URL=https://getnexo.com.br

# Diretórios de logs e backup
LOGS_DIR=/logs
BACKUP_DIR=/mnt/backup

# Telegram para notificações (opcional)
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# TinyPNG para otimização de imagens
TINYPING_API_KEY=your_tinypng_api_key

# Sentinel específico
SENTINEL_AUTO_FIX=true
SENTINEL_DRY_RUN=false