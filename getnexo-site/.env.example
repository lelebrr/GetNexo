# GetNexo Platform - Environment Variables
# Copie este arquivo para .env e configure com suas chaves

# =============================================
# BANCO DE DADOS
# =============================================
DATABASE_URL=postgresql://username:password@localhost:5432/getnexo_db
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20

# =============================================
# CACHE & SESSIONS
# =============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
SESSION_SECRET=your-super-secret-session-key-here

# =============================================
# AUTENTICAÇÃO JWT
# =============================================
JWT_SECRET=your-jwt-secret-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-token-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================
# OAUTH PROVIDERS
# =============================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URL=http://localhost:3000/api/auth/github/callback

# =============================================
# INTELIGÊNCIA ARTIFICIAL
# =============================================
ANTHROPIC_API_KEY=your-anthropic-claude-api-key
OPENAI_API_KEY=your-openai-api-key-optional
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GROK_API_KEY=your-grok-api-key
AI_MODEL=claude-3-sonnet-20240229
AI_MAX_TOKENS=4096

# =============================================
# EMAIL SERVICE
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@getnexo.com
EMAIL_FROM_NAME=GetNexo Platform

# =============================================
# PAGAMENTOS (STRIPE)
# =============================================
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_BASIC=price_basic_plan_id
STRIPE_PRICE_PRO=price_pro_plan_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_plan_id

# =============================================
# ARMAZENAMENTO DE ARQUIVOS (AWS S3)
# =============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=getnexo-uploads
AWS_S3_URL=https://getnexo-uploads.s3.amazonaws.com
AWS_CLOUDFRONT_URL=https://cdn.getnexo.com

# =============================================
# MONITORAMENTO & LOGGING
# =============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log

SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# =============================================
# ANALYTICS & TRACKING
# =============================================
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
MIXPANEL_TOKEN=your-mixpanel-token
HOTJAR_ID=your-hotjar-site-id

# =============================================
# WEBHOOKS & INTEGRAÇÕES
# =============================================
WEBHOOK_SECRET=your-webhook-secret-key
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/webhook-id/

# =============================================
# MAPS & LOCATION
# =============================================
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
OPENCAGE_API_KEY=your-opencage-api-key

# =============================================
# PUSH NOTIFICATIONS
# =============================================
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================
# FILE UPLOAD
# =============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,pdf,doc,docx,txt,mp4,avi,mov
UPLOAD_PATH=uploads/

# =============================================
# CDN & PERFORMANCE
# =============================================
CDN_URL=https://cdn.getnexo.com
IMAGE_OPTIMIZATION=true
COMPRESSION_LEVEL=6

# =============================================
# SECURITY
# =============================================
CORS_ORIGIN=http://localhost:3000
CSP_ENABLED=true
HSTS_ENABLED=true
FORCE_HTTPS=true

# =============================================
# DEVELOPMENT
# =============================================
NODE_ENV=development
DEBUG=false
DEV_PORT=3000
API_BASE_URL=http://localhost:3000

# =============================================
# PRODUCTION OVERRIDE
# =============================================
# DOCKER & INFRASTRUCTURE
# =============================================
DB_USER=your-database-username
DB_PASSWORD=your-secure-database-password
DB_NAME=n8n
N8N_USER=admin
N8N_PASSWORD=your-n8n-admin-password
N8N_HOST=getnexo.com.br
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_URL=http://evolution:8080
CLOUDFLARED_TOKEN=your-cloudflared-token
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
QDRANT_API_KEY=your-qdrant-api-key
TRAEFIK_DASHBOARD_AUTH=your-traefik-dashboard-auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your-keycloak-admin-password
CHATWOOT_SECRET_KEY_BASE=your-chatwoot-secret-key-base
CHATWOOT_ENCRYPTION_KEY=your-chatwoot-encryption-key
ADMIN_PASSWORD=your-admin-password
TZ=America/Sao_Paulo

# =============================================
# AI PROVIDER CONFIGURATION
# =============================================
GEMINI_ENABLED=true
GEMINI_PRIORITY=1
GEMINI_COST_INPUT=0.00035
GEMINI_COST_OUTPUT=0.00105
GROK_ENABLED=true
GROK_PRIORITY=2
DEEPSEEK_ENABLED=true
DEEPSEEK_PRIORITY=3
CLAUDE_ENABLED=false
MISTRAL_ENABLED=false
OLLAMA_ENABLED=true
OLLAMA_MODEL=phi3:mini
GUARDRAIL_PII_REGEX=(?:\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}|\\d{11})
GUARDRAIL_MAX_TOKENS=4000

# =============================================
# SOCIAL MEDIA INTEGRATIONS
# =============================================
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_ACCOUNT_ID=your-linkedin-account-id

# =============================================
# E-COMMERCE INTEGRATIONS
# =============================================
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_STORE=your-shopify-store-name
VTEX_APP_KEY=your-vtex-app-key
VTEX_APP_TOKEN=your-vtex-app-token
VTEX_ACCOUNT=your-vtex-account
NUVEMSHOP_ACCESS_TOKEN=your-nuvemshop-access-token
NUVEMSHOP_STORE_ID=your-nuvemshop-store-id
WIX_SITE_ID=your-wix-site-id
WIX_API_KEY=your-wix-api-key
BLING_API_KEY=your-bling-api-key
FRENET_TOKEN=your-frenet-token
MELHOR_ENVIO_TOKEN=your-melhor-envio-token
LOGGI_TOKEN=your-loggi-token
UBER_DIRECT_TOKEN=your-uber-direct-token
CORREIOS_CONTRATO=your-correios-contrato
CORREIOS_CODIGO=your-correios-codigo
CORREIOS_SENHA=your-correios-senha
WOOCOMMERCE_CONSUMER_KEY=your-woocommerce-consumer-key
WOOCOMMERCE_CONSUMER_SECRET=your-woocommerce-consumer-secret
PAGSEGURO_EMAIL=your-pagseguro-email
PAGSEGURO_TOKEN=your-pagseguro-token

# =============================================
# INSTALLATION & METADATA
# =============================================
INSTALL_DATE=2024-01-01
VERSION=1.0.0

# =============================================
# PRODUCTION OVERRIDES
# =============================================
# PROD_DATABASE_URL=postgresql://prod-user:prod-pass@prod-host:5432/prod-db
# PROD_REDIS_URL=redis://prod-redis:6379
# ALLOWED_HOSTS=getnexo.com,www.getnexo.com,api.getnexo.com