{
    "crons": [
        {
            "path": "/api/monitor/daily-report",
            "schedule": "0 7 * * *"
        }
    ],
    "headers": [
        {
            "source": "/custom/js/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ]
}