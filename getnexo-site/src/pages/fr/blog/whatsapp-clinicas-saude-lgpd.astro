---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Santé Digitale : Cliniques, Médecins et Conformité",
      "description": "Santé Digitale : WhatsApp pour Cliniques et Médecins | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Santé Digitale : WhatsApp pour Cliniques et Médecins | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Santé Digitale :<br/><span class="text-primary">Cliniques, Médecins et Conformité</span></h1>
    <p>Planification sécurisée et conformité totale dans le secteur de la santé.</p>
    <a href="/fr/creer-bot" class="btn-primary">IA pour la Santé</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
