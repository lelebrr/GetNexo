---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "SaaS Growth : Onboarding avec l'IA",
      "description": "SaaS Growth : Mise à l'échelle avec l'API WhatsApp | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="SaaS Growth : Mise à l'échelle avec l'API WhatsApp | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>SaaS Growth :<br/><span class="text-primary">Onboarding avec l'IA</span></h1>
    <p>Mettez votre logiciel à l'échelle avec l'automatisation intelligente sur WhatsApp.</p>
    <a href="/fr/creer-bot" class="btn-primary">Créer Bot SaaS</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
