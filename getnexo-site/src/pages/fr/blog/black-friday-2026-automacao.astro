---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Black Friday 2026 : Guide de Bataille de l'Automatisation",
      "description": "Guide de Bataille Black Friday 2026 : Automatisation | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Guide de Bataille Black Friday 2026 : Automatisation | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Black Friday 2026 :<br/><span class="text-primary">Guide de Bataille de l'Automatisation</span></h1>
    <p>Préparez votre opération pour la plus grande guerre de vente de l'année.</p>
    <a href="/fr/creer-bot" class="btn-primary">Préparer Black Friday</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
