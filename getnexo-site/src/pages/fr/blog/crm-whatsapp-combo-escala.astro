---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "CRM + WhatsApp : Le Combo Ultime pour la Mise à l'Échelle",
      "description": "CRM + WhatsApp : Le Combo Ultime pour Scaler | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="CRM + WhatsApp : Le Combo Ultime pour Scaler | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>CRM + WhatsApp :<br/><span class="text-primary">Le Combo Ultime pour la Mise à l'Échelle</span></h1>
    <p>Le secret des entreprises qui se développent avec organisation et données.</p>
    <a href="/fr/creer-bot" class="btn-primary">Scaler de Manière Organisée</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
