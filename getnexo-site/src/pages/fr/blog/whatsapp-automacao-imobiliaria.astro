---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "WhatsApp pour l'Immobilier : Automatisez Capture et Visites",
      "description": "WhatsApp pour l'Immobilier : Capture et Visites | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="WhatsApp pour l'Immobilier : Capture et Visites | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>WhatsApp pour l'Immobilier :<br/><span class="text-primary">Automatisez Capture et Visites</span></h1>
    <p>Automatisez la capture de leads et la prise de rendez-vous pour les visites avec l'IA de manière efficace.</p>
    <a href="/fr/creer-bot" class="btn-primary">Solution Immobilière</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
