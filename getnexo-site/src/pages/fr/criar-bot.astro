---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Créer le Plugin GetNexo – Installez sur n'importe quel site">
  <!-- intl-tel-input CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css" />

  <div class="page-wrapper">
    <!-- AUTH GATE SECTION -->
    <div id="auth-gate" class="auth-gate hidden">
      <div class="auth-card glass-panel reveal">
        <div class="auth-header">
           <div class="auth-logo">N</div>
           <h1>Commencez votre voyage</h1>
           <p>Vous devez être connecté pour configurer votre plugin et accéder au support prioritaire.</p>
        </div>

        <div id="auth-choice" class="auth-choice">
          <button class="btn-auth-primary" onclick="showAuthMode('register')">Créer un compte gratuit</button>
          <button class="btn-auth-secondary" onclick="showAuthMode('login')">J'ai déjà un compte (Connexion)</button>
          <div class="auth-divider"><span>ou continuez avec</span></div>
          <div class="social-auth">
            <button class="social-btn" onclick="loginWithGoogle()">Google</button>
            <button class="social-btn" onclick="loginWithGitHub()">GitHub</button>
          </div>
        </div>

        <!-- LOGIN FORM -->
        <form id="login-form" class="auth-form hidden">
          <div class="field">
            <label>E-mail</label>
            <input type="email" name="email" required placeholder="votre@email.com" />
          </div>
          <div class="field">
            <label>Mot de passe</label>
            <input type="password" name="password" required placeholder="••••••••" />
          </div>
          <button type="submit" class="btn-next">Connexion →</button>
          <p class="auth-switch">Vous n'avez pas encore de compte ? <a href="#" onclick="showAuthMode('register')">Inscrivez-vous</a></p>
        </form>

        <!-- REGISTER FORM -->
        <form id="register-form" class="auth-form hidden">
          <div class="form-grid">
            <div class="field">
              <label>Votre nom complet *</label>
              <input type="text" name="name" id="reg-name" required placeholder="Jean Dupont" />
            </div>
            <div class="field">
              <label>E-mail professionnel/réel *</label>
              <input type="email" name="email" id="reg-email" required placeholder="jean@entreprise.fr" />
            </div>
            <div class="field">
              <label>Créez un mot de passe *</label>
              <input type="password" name="password" id="reg-password" required placeholder="Minimum 8 caractères" minlength="8" />
            </div>
            <div class="field">
               <label>Type de personne *</label>
               <select name="person_type" id="reg-person-type" required onchange="togglePersonFields()">
                 <option value="">Sélectionnez...</option>
                 <option value="pf">Particulier</option>
                 <option value="pj">Entreprise</option>
               </select>
            </div>
            <div class="field" id="cpf-field" style="display: none;">
               <label>Numéro d'identification fiscale (Particulier) *</label>
               <input type="text" name="cpf" id="reg-cpf" placeholder="000.000.000-00" />
            </div>
            <div class="field" id="cnpj-field" style="display: none;">
               <label>Numéro d'entreprise (SIRET/CNPJ) *</label>
               <input type="text" name="cnpj" id="reg-cnpj" placeholder="00.000.000/0000-00" />
            </div>
            <div class="field">
              <label>Nom de l'entreprise (Optionnel)</label>
              <input type="text" name="company" placeholder="Mon Entreprise SAS" />
            </div>
            <div class="field">
              <label>Votre site principal *</label>
              <input type="url" name="website" id="reg-site" required placeholder="https://votresite.fr" />
            </div>
            <div class="field">
              <label>WhatsApp professionnel *</label>
              <input type="tel" name="whatsapp" id="reg-whatsapp" required />
            </div>
            <div class="field">
              <label>Secteur d'activité *</label>
              <select name="segment" required>
                <option value="">Sélectionnez...</option>
                <option value="ecommerce">E-commerce / Retail</option>
                <option value="servicos">Services / Conseil</option>
                <option value="saude">Santé / Bien-être</option>
                <option value="infoproducts">Infoproduits / Éducation</option>
                <option value="outros">Autres</option>
              </select>
            </div>
          </div>
          <div class="auth-checks">
            <label class="checkbox-container">
              <input type="checkbox" required checked />
              <span class="checkmark"></span>
              J'accepte les <a href="/fr/termos">Conditions d'utilisation</a> et la <a href="/fr/privacidade">Politique de confidentialité</a>
            </label>
          </div>
          <div id="reg-error" class="error-msg"></div>
          <button type="submit" class="btn-next" id="btn-submit-register">Créer mon compte →</button>
          <p class="auth-switch">Vous avez déjà un compte ? <a href="#" onclick="showAuthMode('login')">Se connecter</a></p>
        </form>

        <!-- OTP VERIFICATION -->
        <div id="otp-section" class="auth-form hidden">
           <h2>Valider WhatsApp</h2>
           <p>Nous avons envoyé un code à 6 chiffres sur votre WhatsApp. Entrez-le ci-dessous pour activer votre compte.</p>
           <div class="otp-input-container">
             <input type="text" id="otp-code" maxlength="6" placeholder="000000" />
           </div>
           <div id="otp-error" class="error-msg"></div>
           <button class="btn-next" onclick="verifyOTP()">Valider le code ✅</button>
           <p class="resend-text">Pas reçu ? <a href="#" onclick="resendOTP()">Renvoyer dans <span id="otp-timer">30</span>s</a></p>
        </div>
      </div>
    </div>

    <!-- WIZARD SECTION (Only visible if logged in) -->
    <div id="wizard-section" class="wizard-container hidden">
      <header class="wizard-header">
        <h1>Créer le Plugin</h1>
        <p>Tableau de bord : <span id="user-display-name">Chargement...</span></p>
        <div class="all-required-notice">Configuration terminée avec succès</div>
      </header>

      <!-- Step Indicators -->
      <div class="step-indicators">
        <div class="step-item active" data-step="1">
          <span class="step-number">1</span>
          <span class="step-label">Personnalisation</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item" data-step="2">
          <span class="step-number">2</span>
          <span class="step-label">Visuel</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item" data-step="3">
          <span class="step-number">3</span>
          <span class="step-label">Code</span>
        </div>
      </div>

      <!-- Wizard Step 1: Config (Simplified since we have user data) -->
      <div class="step-content" id="step1">
        <h2>🎨 Configurez votre Bot</h2>
        <form id="wizard-form" class="wizard-form">
           <div class="form-grid">
             <div class="field">
               <label>Nom de l'assistant *</label>
               <input type="text" id="bot-name" placeholder="Ex: Nexus Ventes" required />
             </div>
             <div class="field">
               <label>Site pour le Widget *</label>
               <input type="url" id="bot-site" placeholder="https://votresite.fr" required />
             </div>
             <div class="field">
                <label>Ton de voix</label>
                <select id="bot-tone">
                  <option value="formal">Formel et Professionnel</option>
                  <option value="casual" selected>Décontracté et Amical</option>
                  <option value="urgencia">Axé sur l'urgence/Ventes</option>
                </select>
             </div>
             <div class="field">
                <label>Emoji mis en avant</label>
                <input type="text" id="bot-emoji" value="🤖" placeholder="Choisissez un emoji" />
             </div>
           </div>
           <button type="submit" class="btn-next">Générer l'aperçu visuel →</button>
        </form>
      </div>

      <!-- Wizard Step 2: Preview -->
      <div class="step-content hidden" id="step2">
         <h2>✨ Aperçu du Style</h2>
         <div class="preview-area glass-panel">
            <div class="mock-widget">
               <div class="mock-header">
                 <span id="preview-emoji">🤖</span>
                 <strong id="preview-name">Nexus Bot</strong>
               </div>
               <div class="mock-body">
                 <div class="mock-msg">Bonjour ! Comment puis-je vous aider aujourd'hui ?</div>
               </div>
            </div>
            <div class="theme-choices">
               <label>Thème de couleur :</label>
               <div class="theme-dots">
                 <div class="dot active" style="background:#00d4ff;" onclick="setTheme('neon')"></div>
                 <div class="dot" style="background:#00ff9d;" onclick="setTheme('matrix')"></div>
                 <div class="dot" style="background:#f43f5e;" onclick="setTheme('sunset')"></div>
               </div>
            </div>
         </div>
         <div class="step-actions">
            <button class="btn-back" onclick="goToStep(1)">← Modifier</button>
            <button class="btn-next" onclick="generateFinalCode()" id="btn-final-step">Obtenir le code du Plugin →</button>
         </div>
      </div>

      <!-- Wizard Step 3: Result -->
      <div class="step-content hidden" id="step3">
        <h2>🚀 Tout est prêt !</h2>
        <p>Installez le code ci-dessous dans la balise <code>&lt;head&gt;</code> ou avant la fermeture de <code>&lt;/body&gt;</code> de votre site.</p>
        <div class="code-box">
          <code id="widget-code">Chargement du code...</code>
          <button onclick="copiarCodigo()" class="btn-copy">Copier</button>
        </div>
        <div class="wizard-footer">
          <a href="/fr/dashboard" class="btn-next">Accéder à mon tableau de bord →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script nonce={Astro.locals.nonce} is:inline>
    // State Management
    let currentUser = null;
    let registrationData = {};
    let selectedTheme = 'neon';

    const API_URL = '';

    async function checkAuth() {
      try {
        const res = await fetch('/api/auth/me');
        const data = await res.json();
        if (data.authenticated) {
          currentUser = data.user;
          showWizard();
        } else {
          showAuthGate();
        }
      } catch (e) {
        showAuthGate();
      }
    }

    function showAuthGate() {
      document.getElementById('auth-gate').classList.remove('hidden');
      document.getElementById('wizard-section').classList.add('hidden');
      initMasks();
    }

    function showWizard() {
      document.getElementById('auth-gate').classList.add('hidden');
      document.getElementById('wizard-section').classList.remove('hidden');
      document.getElementById('user-display-name').textContent = currentUser.name || currentUser.email;
      
      if (registrationData.website) {
        document.getElementById('bot-site').value = registrationData.website;
      }
    }

    function showAuthMode(mode) {
      document.getElementById('auth-choice').classList.add('hidden');
      document.querySelectorAll('.auth-form').forEach(f => f.classList.add('hidden'));
      
      if (mode === 'login') {
        document.getElementById('login-form').classList.remove('hidden');
      } else if (mode === 'register') {
        document.getElementById('register-form').classList.remove('hidden');
      }
    }

    // Auth Actions
    function loginWithGoogle() { window.location.href = '/api/auth/google'; }
    function loginWithGitHub() { window.location.href = '/api/auth/github'; }

    // Forms
    document.getElementById('login-form').onsubmit = async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const data = Object.fromEntries(fd.entries());
      
      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(data)
        });
        const resData = await res.json();
        if (resData.user) {
          currentUser = resData.user;
          showWizard();
        } else {
          alert('Erreur de connexion : ' + (resData.error || 'Identifiants invalides'));
        }
      } catch (e) { alert('Erreur lors de la connexion au serveur'); }
    }

    document.getElementById('register-form').onsubmit = async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-submit-register');
      btn.disabled = true;
      btn.textContent = 'Envoi en cours...';

      const fd = new FormData(e.target);
      const data = Object.fromEntries(fd.entries());
      
      const whatsapp = data.whatsapp.replace(/\D/g, '');
      if (whatsapp.length < 8) {
        document.getElementById('reg-error').textContent = '❌ WhatsApp invalide.';
        btn.disabled = false;
        btn.textContent = 'Créer mon compte →';
        return;
      }
      data.whatsapp = whatsapp;

      registrationData = data;

      try {
        const res = await fetch(`${API_URL}/api/trial/register`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(data)
        });
        const resData = await res.json();
        if (resData.ok) {
          showOTP();
        } else {
          document.getElementById('reg-error').textContent = '❌ ' + (resData.error || 'Erreur lors de l\'inscription');
        }
      } catch (e) { alert('Erreur lors de l\'inscription'); }
      finally {
        btn.disabled = false;
        btn.textContent = 'Créer mon compte →';
      }
    }

    function showOTP() {
      document.getElementById('register-form').classList.add('hidden');
      document.getElementById('otp-section').classList.remove('hidden');
      startOTPTimer();
    }

    async function verifyOTP() {
      const code = document.getElementById('otp-code').value;
      const errorEl = document.getElementById('otp-error');
      errorEl.textContent = '';

      try {
        const res = await fetch(`${API_URL}/api/trial/verify`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ whatsapp: registrationData.whatsapp, code })
        });
        const data = await res.json();
        if (data.ok) {
          completeFullRegistration();
        } else {
          errorEl.textContent = '❌ Code incorrect ou expiré.';
        }
      } catch (e) { errorEl.textContent = 'Erreur réseau'; }
    }

    async function completeFullRegistration() {
      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(registrationData)
        });
        const data = await res.json();
        if (data.success) {
          currentUser = data.user;
          showWizard();
        } else {
          alert('Erreur lors de la finalisation du compte : ' + data.error);
        }
      } catch (e) { alert('Défaillance critique du système d\'inscription.'); }
    }

    // Wizard Logic
    function goToStep(step) {
      document.querySelectorAll('.step-item').forEach((el, i) => {
        if (i + 1 <= step) el.classList.add('active');
        else el.classList.remove('active');
      });
      document.querySelectorAll('.step-content').forEach((el, i) => {
        if (i + 1 === step) el.classList.remove('hidden');
        else el.classList.add('hidden');
      });
    }

    document.getElementById('wizard-form').onsubmit = (e) => {
      e.preventDefault();
      const name = document.getElementById('bot-name').value;
      const emoji = document.getElementById('bot-emoji').value;
      
      document.getElementById('preview-name').textContent = name;
      document.getElementById('preview-emoji').textContent = emoji;
      
      goToStep(2);
    }

    function generateFinalCode() {
      const botId = 'bot_' + Math.random().toString(36).substr(2, 9);
      const scriptUrl = window.location.hostname === 'localhost'
        ? 'http://localhost:8080/widget.js'
        : '/widget.js';
      
      const code = `<script src="${scriptUrl}" data-bot="${botId}" data-theme="${selectedTheme}"><\/script>`;
      document.getElementById('widget-code').textContent = code;
      goToStep(3);
    }

    function togglePersonFields() {
      const personType = document.getElementById('reg-person-type').value;
      const cpfField = document.getElementById('cpf-field');
      const cnpjField = document.getElementById('cnpj-field');
      const cpfInput = document.getElementById('reg-cpf');
      const cnpjInput = document.getElementById('reg-cnpj');

      if (personType === 'pf') {
        cpfField.style.display = 'block';
        cnpjField.style.display = 'none';
        cpfInput.required = true;
        cnpjInput.required = false;
      } else if (personType === 'pj') {
        cpfField.style.display = 'none';
        cnpjField.style.display = 'block';
        cpfInput.required = false;
        cnpjInput.required = true;
      } else {
        cpfField.style.display = 'none';
        cnpjField.style.display = 'none';
        cpfInput.required = false;
        cnpjInput.required = false;
      }
    }

    function initMasks() {
      // Pas de masques spécifiques pour la France dans cette version simplifiée
    }

    function startOTPTimer() {
      let timeLeft = 30;
      const timerEl = document.getElementById('otp-timer');
      const interval = setInterval(() => {
        timeLeft--;
        timerEl.textContent = timeLeft;
        if (timeLeft <= 0) clearInterval(interval);
      }, 1000);
    }

    function setTheme(theme) {
      selectedTheme = theme;
      document.querySelectorAll('.dot').forEach(d => d.classList.remove('active'));
      event.target.classList.add('active');
    }

    window.copiarCodigo = function() {
      const code = document.getElementById('widget-code').textContent;
      navigator.clipboard.writeText(code).then(() => alert('✅ Code copié !'));
    }

    checkAuth();
  </script>
</Layout>

<style>
  .page-wrapper {
    min-height: 90vh;
    padding: 100px 5% 50px;
  }

  /* Auth Gate Styles */
  .auth-gate {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .auth-card {
    max-width: 900px;
    width: 100%;
    padding: 3rem;
    border-radius: 30px;
  }
  .auth-header { text-align: center; margin-bottom: 3rem; }
  .auth-logo { 
    width: 60px; height: 60px; 
    background: linear-gradient(135deg, #00d4ff, #00ff9d); 
    color: black; display: flex; align-items: center; justify-content: center; 
    font-weight: 900; font-size: 2rem; border-radius: 15px; margin: 0 auto 1.5rem;
    box-shadow: 0 0 30px rgba(0, 212, 255, 0.4);
  }
  .auth-header h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem; }
  .auth-header p { color: #94a3b8; font-size: 1.1rem; }

  .auth-choice { display: flex; flex-direction: column; gap: 1rem; max-width: 400px; margin: 0 auto; }
  .btn-auth-primary { background: white; color: black; padding: 1.2rem; border-radius: 15px; font-weight: 800; border: none; cursor: pointer; transition: 0.3s; font-size: 1.1rem; }
  .btn-auth-secondary { background: rgba(255,255,255,0.05); color: white; padding: 1.2rem; border-radius: 15px; font-weight: 700; border: 1px solid rgba(255,255,255,0.1); cursor: pointer; transition: 0.3s; }
  .btn-auth-primary:hover { background: #00ff9d; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0, 255, 157, 0.3); }
  .btn-auth-secondary:hover { background: rgba(255,255,255,0.1); border-color: #00d4ff; }

  .auth-divider { position: relative; text-align: center; margin: 2rem 0; }
  .auth-divider::before { content: ''; position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: rgba(255,255,255,0.1); }
  .auth-divider span { background: #030712; padding: 0 1rem; color: #475569; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; position: relative; }

  .social-auth { display: flex; gap: 1rem; }
  .social-btn { flex: 1; background: #0f172a; border: 1px solid #334155; color: white; padding: 0.8rem; border-radius: 10px; cursor: pointer; transition: 0.2s; }
  .social-btn:hover { border-color: #00d4ff; background: #1e293b; }

  .auth-form { animation: fadeIn 0.4s ease-out; }
  .auth-switch { text-align: center; margin-top: 2rem; color: #94a3b8; font-size: 0.9rem; }
  .auth-switch a { color: #00ff9d; font-weight: 700; text-decoration: none; }

  .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; text-align: left; }
  @media (max-width: 768px) { .form-grid { grid-template-columns: 1fr; } }

  .field { display: flex; flex-direction: column; gap: 0.5rem; }
  .field label { font-size: 0.85rem; font-weight: 600; color: #e2e8f0; }
  .field input, .field select { 
    background: #020617; border: 1px solid #1e293b; color: white; 
    padding: 0.8rem 1rem; border-radius: 10px; font-size: 0.95rem; outline: none; transition: 0.3s;
  }
  .field input:focus, .field select:focus { border-color: #00d4ff; box-shadow: 0 0 15px rgba(0, 212, 255, 0.15); }

  .checkbox-container { display: flex; align-items: center; gap: 0.8rem; cursor: pointer; user-select: none; margin: 1.5rem 0; font-size: 0.85rem; color: #94a3b8; }
  .checkbox-container input { display: none; }
  .checkmark { width: 22px; height: 22px; background: #020617; border: 2px solid #1e293b; border-radius: 6px; position: relative; }
  .checkbox-container input:checked ~ .checkmark { background: #00ff9d; border-color: #00ff9d; }
  .checkmark:after { content: "✓"; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: black; display: none; font-weight: 900; }
  .checkbox-container input:checked ~ .checkmark:after { display: block; }

  .error-msg { color: #f43f5e; font-size: 0.85rem; margin: 1rem 0; font-weight: 600; }

  /* Wizard Styles */
  .wizard-container { max-width: 1000px; margin: 0 auto; animation: fadeInUp 0.5s ease-out; }
  .wizard-header { text-align: center; margin-bottom: 3rem; }
  .wizard-header h1 { font-size: 3rem; font-weight: 800; color: #00ff9d; margin: 0; }
  .wizard-header p { color: #94a3b8; margin-top: 0.5rem; }

  .step-indicators { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 3rem; }
  .step-item { opacity: 0.3; transition: 0.3s; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .step-item.active { opacity: 1; }
  .step-number { width: 40px; height: 40px; border-radius: 50%; background: #1e293b; display: flex; align-items: center; justify-content: center; font-weight: 800; color: white; }
  .step-item.active .step-number { background: #00d4ff; color: black; box-shadow: 0 0 20px rgba(0, 212, 255, 0.4); }
  .step-label { font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; }
  .step-line { height: 2px; width: 60px; background: #1e293b; margin-top: -25px; }

  .step-content { background: rgba(15, 23, 42, 0.6); padding: 4rem; border-radius: 30px; border: 1px solid rgba(255,255,255,0.05); }
  .step-content.hidden { display: none; }
  .step-content h2 { margin-bottom: 2.5rem; font-size: 2rem; font-weight: 800; }

  .btn-next { 
    width: 100%; border: none; padding: 1.2rem; border-radius: 15px; font-weight: 800; font-size: 1.1rem;
    background: linear-gradient(90deg, #00d4ff, #00ff9d); color: black; cursor: pointer; transition: 0.3s;
    margin-top: 1.5rem;
  }
  .btn-next:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0, 255, 157, 0.3); }

  .btn-back { background: rgba(255,255,255,0.05); color: white; padding: 0.8rem 1.5rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); cursor: pointer; font-weight: 600; }

  .preview-area { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  @media (max-width: 768px) { .preview-area { grid-template-columns: 1fr; } }
  
  .mock-widget { 
    background: #0f172a; border-radius: 15px; border: 1px solid #1e293b; overflow: hidden;
