---
import Layout from '../../layouts/Layout.astro';
import VideoDemo from '../../components/VideoDemo.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import Testimonials from '../../components/Testimonials.astro';
import TourGuided from '../../components/TourGuided.astro';
import { verificaDataVariavel } from '../../lib/feriados.js';
import '../../styles/index-premium.css';

const title = "Chatbot WhatsApp IA pour Ventes 24h | API Officielle Meta | GetNexo";
const description = "Automatisez vos ventes WhatsApp avec l'Intelligence Artificielle Générative. API Officielle Meta, PIX natif, CRM intelligent et Analytics. Augmentez votre conversion jusqu'à 10x sans mensualités fixes.";
const keywords = "chatbot whatsapp ventes, ia pour whatsapp, automatisation whatsapp ventes, api officielle whatsapp business, chatbot avec pix, crm pour whatsapp, intelligence artificielle vendeuse, chatbot whatsapp gratuit, récupérer panier abandonné whatsapp, chatbot auto-hébergé";

const lang = 'fr';
const { default: t } = await import(`../../i18n/fr.json`);

const feriadosData = await fetch('/data/feriados.json').then(r => r.json()).catch(() => ({ feriados: [] }));
const hoje = new Date().toISOString().slice(0,10);
const idiomaNavegador = typeof navigator !== 'undefined' ? (navigator.language || 'fr-FR') : 'fr-FR';
const idiomaCurto = idiomaNavegador.split('-')[0];

const feriadoHoje = feriadosData.feriados.find(f => {
  if (f.data === hoje) return true;
  const anoAtual = new Date().getFullYear();
  const dataCalculada = verificaDataVariavel(f.data, anoAtual);
  return dataCalculada === hoje;
});

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://getnexo.com.br/#organization",
      "name": "GetNexo",
      "url": "https://getnexo.com.br",
      "logo": "https://getnexo.com.br/logo.svg",
      "description": "Plateforme IA pour ventes WhatsApp 24h. API Officielle Meta, PIX automatique, CRM intégré.",
      "foundingDate": "2024",
      "sameAs": [
        "https://linkedin.com/company/getnexo",
        "https://instagram.com/getnexo",
        "https://github.com/lelebrr",
        "https://youtube.com/@getnexo",
        "https://tiktok.com/@getnexo"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+55-11-4003-XXXX",
        "contactType": "customer service",
        "availableLanguage": ["Portuguese", "English", "Spanish", "French"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://getnexo.com.br/#website",
      "url": "https://getnexo.com.br",
      "name": "GetNexo - IA pour Ventes WhatsApp",
      "description": "IA qui ferme les ventes WhatsApp 24h. Plateforme complète avec API Officielle Meta, PIX, CRM, fidélité et analytics.",
      "publisher": { "@id": "https://getnexo.com.br/#organization" },
      "inLanguage": "fr-FR",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://getnexo.com.br/fr/rechercher?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://getnexo.com.br/#software",
      "name": "GetNexo",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, WhatsApp",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "BRL",
        "priceValidUntil": "2026-12-31",
        "description": "Plan gratuit avec fonctionnalités avancées"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "500",
        "bestRating": "5",
        "worstRating": "1"
      },
      "author": { "@id": "https://getnexo.com.br/#organization" }
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} isLanding={true}>

  {feriadoHoje && (
    <link rel="stylesheet" href="/custom/css/holiday-effects.css" is:inline />
  )}

  {feriadoHoje && (
    <script nonce={Astro.locals.nonce} is:inline define:vars={{ efeito: feriadoHoje.efeito }}>
      document.body.classList.add(efeito);
    </script>
  )}

  <script nonce={Astro.locals.nonce} type="application/ld+json" is:inline set:html={JSON.stringify(homeSchema)}></script>

  <section class="hero-split">
    <div class="hero-content">
      {feriadoHoje && (
        <div class="feriado-banner animate-on-scroll">
          <span class="feriado-emoji">🎉</span>
          <span class="feriado-texto">
            {feriadoHoje.bot_frase.fr || feriadoHoje.bot_frase.pt}
          </span>
          <span class="feriado-nome">| {feriadoHoje.idiomas.fr || feriadoHoje.idiomas.pt}</span>
        </div>
      )}

      <div class="hero-badge animate-on-scroll">🚀 TRANSFORMEZ VOTRE WHATSAPP EN MACHINE DE VENTES AUTOMATISÉE</div>
      <h1 class="hero-title animate-on-scroll">
        <span class="text-gradient-animated">IA INTELLIGENTE</span><br/>
        VEND 24H/JOUR SANS BESOIN <span class="no-break">D'ATTENDANTS</span>
      </h1>
      <p class="hero-subtitle animate-on-scroll">
        <span id="typing-text"></span><span class="cursor">|</span>
      </p>
      <div class="hero-ctas animate-on-scroll">
        <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow">COMMENCER GRATUITEMENT</a>
        <button onclick="window.ouvrirModalDemo()" class="btn-surprise animate-on-scroll">TESTER ICI.. SOYEZ SURPRIS</button>
      </div>
      <div class="hero-trust animate-on-scroll">
        <span>✅ API Officielle Meta</span>
        <span>✅ Configuration en 12min</span>
        <span>✅ Zéro Mensualité</span>
      </div>
    </div>

    <div class="hero-visual animate-on-scroll">
        <div class="visual-container">
            <div class="visual-glow"></div>
            <div class="smart-phone-mockup">
                <div class="screen-content">
                    <div class="chat-header-sim">
                        <div class="sim-avatar">N</div>
                        <div class="sim-info">
                            <span class="sim-name">Nexus Smart Bot</span>
                            <span class="sim-status">online</span>
                        </div>
                    </div>
                    <div class="chat-body-mega" id="mega-chat-container">
                    </div>
                    <div class="chat-input-sim">
                        <div class="sim-mic">🎤</div>
                        <span>Dis quelque chose...</span>
                        <div class="sim-audio-icon">🎧</div>
                        <div class="sim-send">🚀</div>
                    </div>
                    <div id="sim-finger-cursor" class="sim-finger">☝️</div>
                </div>
            </div>

            <div class="floating-elements">
                <div class="f-pill">💰 PIX Actif</div>
                <div class="f-pill">🚀 10x ROI</div>
            </div>
        </div>
    </div>
  </section>

  <TourGuided slot="dock-left" targetPage="home" mobileOptimized={true} />

  <div class="section-header animate-on-scroll">
        <h2 class="text-gradient">L'Infrastructure Définitive pour Faire Évoluer vos Ventes</h2>
        <p>L'unique plateforme qui combine IA Générative, PIX Natif et Automatisation Officielle Meta pour transformer votre Chat en machine à profit 24h par jour.</p>
    </div>

    <div class="grid-cards">
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">🤖</div>
        <h3>IA Générative de Ventes</h3>
        <p>Agent virtuel entraîné avec votre catalogue qui convertit les leads en profit 24/7 de manière humanisée.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Explorer IA →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">💰</div>
        <h3>Checkout & PIX Natif</h3>
        <p>Expérience d'achat fluide avec génération automatique de PIX et confirmation sans quitter le chat.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Voir Checkout →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">🚀</div>
        <h3>Broadcast & Ads Haute Performance</h3>
        <p>Envois en masse intelligents et Click-to-WhatsApp Ads avec mesure de ROI en temps réel.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Activer Ads →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">👥</div>
        <h3>Pipeline & CRM Stratégique</h3>
        <p>Vue 360º de votre entonnoir avec gestion multi-agent et automatisation intelligente de suivi.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Gérer Leads →</a>
      </div>
    </div>

  <section class="metrics-section">
    <div class="metric-card animate-on-scroll">
        <span class="m-val">10x</span>
        <span class="m-label">Plus de Conversion</span>
    </div>
    <div class="metric-card animate-on-scroll">
        <span class="m-val">24/7</span>
        <span class="m-label">Disponibilité</span>
    </div>
    <div class="metric-card animate-on-scroll">
        <span class="m-val">R$ 0</span>
        <span class="m-label">Frais par Message</span>
    </div>
  </section>

  <Testimonials />

  <ROICalculator />

  <section class="giant-features">
    <div class="giant-feature-row animate-on-scroll">
        <div class="giant-feature-visual">
            <img src="/assets/features/magic-replies.webp" alt="Magic Replies AI" width="501" height="501" class="premium-visual" />
        </div>
        <div class="giant-feature-info">
            <div class="feature-tag">Exclusif</div>
            <h2 class="text-gradient">{t.features_giant.magic_replies.title}</h2>
            <p>{t.features_giant.magic_replies.description}</p>
            <ul class="feature-bullets">
                <li><span>✨</span> {t.features_giant.magic_replies.f1}</li>
                <li><span>🧠</span> {t.features_giant.magic_replies.f2}</li>
                <li><span>📈</span> {t.features_giant.magic_replies.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">Découvrir Magic Replies</a>
        </div>
    </div>

    <div class="giant-feature-row reverse animate-on-scroll">
        <div class="giant-feature-info">
            <div class="feature-tag gold">Rétention</div>
            <h2 class="text-gradient">{t.features_giant.loyalty.title}</h2>
            <p>{t.features_giant.loyalty.description}</p>
            <ul class="feature-bullets">
                <li><span>🏆</span> {t.features_giant.loyalty.f1}</li>
                <li><span>🎁</span> {t.features_giant.loyalty.f2}</li>
                <li><span>❤️</span> {t.features_giant.loyalty.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">Voir Fidélité</a>
        </div>
        <div class="giant-feature-visual">
            <img src="/assets/features/loyalty.webp" alt="Loyalty System" width="501" height="501" class="premium-visual" />
        </div>
    </div>

    <div class="giant-feature-row animate-on-scroll">
        <div class="giant-feature-visual">
            <img src="/assets/features/analytics.webp" alt="Advanced Analytics" width="501" height="501" class="premium-visual" />
        </div>
        <div class="giant-feature-info">
            <div class="feature-tag blue">Intelligence</div>
            <h2 class="text-gradient">{t.features_giant.analytics.title}</h2>
            <p>{t.features_giant.analytics.description}</p>
            <ul class="feature-bullets">
                <li><span>📊</span> {t.features_giant.analytics.f1}</li>
                <li><span>📝</span> {t.features_giant.analytics.f2}</li>
                <li><span>🌍</span> {t.features_giant.analytics.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">Explorer Données</a>
        </div>
    </div>

    <div class="giant-feature-row reverse animate-on-scroll">
        <div class="giant-feature-info">
            <div class="feature-tag green">Écosystème</div>
            <h2 class="text-gradient">{t.features_giant.integrations.title}</h2>
            <p>{t.features_giant.integrations.description}</p>
            <ul class="feature-bullets">
                <li><span>🔗</span> {t.features_giant.integrations.f1}</li>
                <li><span>⚙️</span> {t.features_giant.integrations.f2}</li>
                <li><span>📡</span> {t.features_giant.integrations.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.integrations}`} class="btn-outline-glow">Voir Toutes les Intégrations</a>
        </div>
        <div class="giant-feature-visual">
            <img src="/assets/features/integrations.webp" alt="Integrations Map" width="501" height="501" class="premium-visual" />
        </div>
    </div>
  </section>

  <section class="security-section">
    <div class="section-header animate-on-scroll">
        <h2 class="text-gradient">🛡️ Sécurité Maximale dans GetNexo</h2>
        <p>Protégez Votre Boutique et Vos Clients avec Confiance Totale</p>
    </div>

    <div class="security-grid animate-on-scroll">
      <div class="security-card glass-panel">
        <div class="security-icon">🛡️</div>
        <h3>Cloudflare Shield</h3>
        <p>Protection contre DDoS, Firewall Avancé (WAF) et Gestion des Bots. Votre boutique protégée comme les plus grandes du monde.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">🔐</div>
        <h3>Chiffrement AES</h3>
        <p>Chiffrement LGPD-compliant avec AES-256. Conformité 100% LGPD. Zéro stockage inutile.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">🚪</div>
        <h3>Réseau Zero Trust</h3>
        <p>Cloudflare Tunnel avec Zero Trust. Aucun port ouvert sur le serveur. Connexion outbound uniquement.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">⏰</div>
        <h3>Monitoring 24h</h3>
        <p>Rate Limiting intelligent, détection des menaces en temps réel et sauvegardes sécurisées automatisées.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">💳</div>
        <h3>PIX Sécurisé</h3>
        <p>Intégration directe avec des passerelles de confiance. QR Code validé et chiffré en temps réel.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">✅</div>
        <h3>99.99% Uptime</h3>
        <p>Votre boutique ne tombe jamais hors ligne. Aucun historique de breaches. Mises à jour automatiques.</p>
      </div>
    </div>

    <div class="security-cta animate-on-scroll">
        <p class="security-notice">💡 Sécurité WhatsApp Business n'est pas un luxe — c'est une nécessité.</p>
        <p class="security-benefit">Avec GetNexo, vous avez une protection de niveau enterprise sans complication ni coût exorbitant.</p>
        <div class="security-actions">
            <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow security-btn">Tester Gratuitement →</a>
            <button onclick="ouvrirModalDemo()" class="btn-outline security-btn">Voir Certifications</button>
        </div>
        <p class="security-footer">© 2026 GetNexo. Tous droits réservés. | GetNexo: L'avant-garde de l'Automatisation WhatsApp et IA pour Affaires.</p>
    </div>
  </section>

  <section class="final-cta animate-on-scroll">
    <div class="glass-panel cta-box p-12 text-center">
        <h2 class="text-gradient text-4xl font-black mb-6">Prêt à Dominer WhatsApp avec IA?</h2>
        <p class="text-xl text-gray-400 mb-8 max-w-2xl mx-auto">
            Dominez WhatsApp avec l'infrastructure la plus robuste du marché. 💡 Sécurité WhatsApp Business n'est pas un luxe — c'est une nécessité. Activez votre IA en moins de 10 minutes.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
            <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow">COMMENCER GRATUITEMENT</a>
            <button onclick="window.ouvrirModalDemo()" class="btn-outline">TESTER DÉMO IA</button>
        </div>
    </div>
  </section>

<script nonce={Astro.locals.nonce} is:inline src="/custom/js/hero-animations.js"></script>
<script nonce={Astro.locals.nonce} is:inline>
  // Carregamento dinâmico de scripts de demonstração para otimizar performance
  // Scripts são carregados apenas quando o usuário interage com a página
  (function() {
    'use strict';
    
    let scriptsLoaded = false;
    let scriptsLoading = false;
    
    function loadDemoScripts() {
      if (scriptsLoaded || scriptsLoading) return;
      
      scriptsLoading = true;
      
      // Carrega os scripts de demonstração dinamicamente
      const scripts = [
        '/custom/js/mega-chat-sim.js',
        '/custom/js/modals-demo.js',
        '/custom/js/click-fireworks.js'
      ];
      
      scripts.forEach(src => {
        const script = document.createElement('script');
        script.src = src;
        script.isInline = true;
        document.head.appendChild(script);
      });
      
      scriptsLoaded = true;
      console.log('Scripts de demonstração carregados dinamicamente');
    }
    
    // Carrega scripts quando o usuário interage pela primeira vez
    const interactionEvents = ['click', 'scroll', 'mousemove', 'touchstart'];
    
    function handleFirstInteraction() {
      loadDemoScripts();
      // Remove listeners após o primeiro carregamento
      interactionEvents.forEach(event => {
        document.removeEventListener(event, handleFirstInteraction);
      });
    }
    
    // Adiciona listeners de interação
    interactionEvents.forEach(event => {
      document.addEventListener(event, handleFirstInteraction, { once: true });
    });
    
    // Também carrega quando o DOM estiver pronto (para garantir que os elementos existam)
    document.addEventListener('DOMContentLoaded', () => {
      // Verifica se há elementos que precisam dos scripts
      const hasDemoElements = document.querySelector('[onclick*="ouvrirModalDemo"], [onclick*="ouvrirModalChat"], [onclick*="ouvrirModalIA"]');
      if (hasDemoElements) {
        // Adia o carregamento para não bloquear o render inicial
        setTimeout(loadDemoScripts, 1000);
      }
    });
  })();
</script>

</Layout>
