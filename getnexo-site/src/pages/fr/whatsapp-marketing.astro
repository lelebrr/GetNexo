---
import Layout from '../../layouts/Layout.astro';
const title = "Marketing WhatsApp : Comment doubler votre ROI avec l'IA | GetNexo";
const description = "Découvrez comment doubler votre ROI sur WhatsApp en utilisant l'IA pour automatiser le marketing, récupérer les paniers et personnaliser les ventes à grande échelle.";
const keywords = "marketing whatsapp, roi whatsapp, automatisation marketing, ia whatsapp, ventes whatsapp, conversion whatsapp";
---

<Layout title={title} description={description} keywords={keywords}>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-badge">🚀 Stratégies Marketing</div>
      <h1>Doublez votre ROI avec le Marketing WhatsApp Intelligent</h1>
      <p>L'IA GetNexo transforme votre WhatsApp en une machine de vente automatique. Personnalisation de masse, récupération de panier et engagement proactif.</p>
      
      <div class="hero-ctas">
        <a href="/fr/creer-bot" class="btn-primary">Essayer gratuitement maintenant</a>
        <a href="#strategies" class="btn-secondary">Voir les stratégies</a>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section id="strategies" class="content-section">
    <div class="container">
      <h2>Stratégies avancées pour WhatsApp Marketing</h2>
      
      <div class="strategy-grid">
        <div class="strategy-card">
          <div class="icon">🛒</div>
          <h3>Récupération de panier abandonné</h3>
          <p>L'IA détecte l'abandon et envoie un message personnalisé avec un coupon ou un argument de vente spécifique au produit délaissé.</p>
        </div>
        
        <div class="strategy-card">
          <div class="icon">🎯</div>
          <h3>Segmentation hyper-précise</h3>
          <p>Regroupez vos clients par comportement d'achat et envoyez des offres que seul ce groupe spécifique voudra acheter.</p>
        </div>
        
        <div class="strategy-card">
          <div class="icon">✨</div>
          <h3>Upsell et Cross-sell IA</h3>
          <p>Après un achat, l'IA suggère automatiquement des compléments parfaits, augmentant la valeur de vie de chaque client.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="final-cta">
    <div class="cta-content">
      <h2>Prêt à révolutionner votre marketing ?</h2>
      <p>Rejoignez plus de 1000 entreprises qui utilisent déjà GetNexo pour scaler leurs ventes.</p>
      <a href="/fr/creer-bot" class="btn-primary-large">Commencer maintenant →</a>
    </div>
  </section>
</Layout>

<style>
  .hero-section { padding: 8rem 5%; text-align: center; background: #030712; }
  .hero-content h1 { font-size: 3.5rem; font-weight: 900; margin-bottom: 2rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .hero-content p { font-size: 1.3rem; color: #94a3b8; max-width: 800px; margin: 0 auto 3rem; }
  .hero-ctas { display: flex; gap: 1.5rem; justify-content: center; }
  
  .content-section { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .strategy-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .strategy-card { background: rgba(255,255,255,0.05); padding: 3rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); }
  .strategy-card h3 { color: white; margin-bottom: 1rem; }
  .strategy-card p { color: #94a3b8; }
</style>
