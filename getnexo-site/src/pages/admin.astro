---
import Layout from '../layouts/Layout.astro';

// Props para dados do dashboard
const { dashboardData } = Astro.props || {};
---

<Layout title="Dashboard Administrativo - GetNexo">
  <div class="min-h-screen bg-gray-100">
    <div class="py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">Dashboard Administrativo</h1>

        <!-- KPIs Principais -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                  </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dl>
                    <dt class="text-sm font-medium text-gray-500 truncate">Total de Usuários</dt>
                    <dd class="text-lg font-medium text-gray-900" id="total-users">-</dd>
                  </dl>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                  </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dl>
                    <dt class="text-sm font-medium text-gray-500 truncate">Receita Mensal</dt>
                    <dd class="text-lg font-medium text-gray-900" id="monthly-revenue">-</dd>
                  </dl>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                  </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dl>
                    <dt class="text-sm font-medium text-gray-500 truncate">Taxa de Conversão</dt>
                    <dd class="text-lg font-medium text-gray-900" id="conversion-rate">-</dd>
                  </dl>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
              <div class="flex items-center">
                <div class="flex-shrink-0">
                  <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                  </svg>
                </div>
                <div class="ml-5 w-0 flex-1">
                  <dl>
                    <dt class="text-sm font-medium text-gray-500 truncate">Crescimento Receita</dt>
                    <dd class="text-lg font-medium text-gray-900" id="revenue-growth">-</dd>
                  </dl>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Alertas de Risco -->
        <div class="mb-8" id="risk-alerts"></div>

        <!-- Gráficos -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
          <div class="bg-white shadow rounded-lg p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Receita Mensal</h3>
            <canvas id="revenue-chart" width="400" height="200"></canvas>
          </div>

          <div class="bg-white shadow rounded-lg p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Crescimento de Usuários</h3>
            <canvas id="users-chart" width="400" height="200"></canvas>
          </div>
        </div>

        <!-- Projeções -->
        <div class="bg-white shadow rounded-lg p-6 mb-8">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Projeções (3 meses)</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200" id="forecast-table">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mês</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Receita Projetada</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Usuários Projetados</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Confiança</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200"></tbody>
            </table>
          </div>
        </div>

        <!-- Métricas de Sistema -->
        <div class="bg-white shadow rounded-lg p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Métricas do Sistema</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Uptime</dt>
              <dd class="text-lg font-medium text-gray-900" id="system-uptime">-</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Memória Usada</dt>
              <dd class="text-lg font-medium text-gray-900" id="system-memory">-</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Status</dt>
              <dd class="text-lg font-medium text-green-600" id="system-status">Online</dd>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  let revenueChart, usersChart;

  async function loadDashboardData() {
    try {
      const response = await fetch('/api/stream/dashboard', {
        headers: {
          'Authorization': `Bearer ${localStorage.getItem('admin_token') || 'demo_token'}`
        }
      });

      if (!response.ok) {
        console.error('Failed to load dashboard data');
        return;
      }

      const data = await response.json();
      updateDashboard(data);
    } catch (error) {
      console.error('Error loading dashboard:', error);
    }
  }

  function updateDashboard(data) {
    // Atualizar KPIs
    document.getElementById('total-users').textContent = data.totalUsers?.toLocaleString() || '-';
    document.getElementById('monthly-revenue').textContent = `R$ ${(data.monthlyRevenue || 0).toLocaleString('pt-BR')}`;
    document.getElementById('conversion-rate').textContent = `${data.conversionRate || 0}%`;
    document.getElementById('revenue-growth').textContent = `${data.revenueGrowthPercent || 0}%`;

    // Atualizar alertas de risco
    updateRiskAlerts(data.risks || []);

    // Atualizar gráficos
    updateCharts(data);

    // Atualizar projeções
    updateForecastTable(data.forecasts || []);

    // Atualizar métricas do sistema
    updateSystemMetrics(data.systemMetrics || {});
  }

  function updateRiskAlerts(risks) {
    const alertsContainer = document.getElementById('risk-alerts');

    if (risks.length === 0) {
      alertsContainer.innerHTML = '';
      return;
    }

    const alertsHtml = risks.map(risk => `
      <div class="bg-${risk.level === 'high' ? 'red' : risk.level === 'medium' ? 'yellow' : 'blue'}-50 border-l-4 border-${risk.level === 'high' ? 'red' : risk.level === 'medium' ? 'yellow' : 'blue'}-400 p-4 mb-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-${risk.level === 'high' ? 'red' : risk.level === 'medium' ? 'yellow' : 'blue'}-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-${risk.level === 'high' ? 'red' : risk.level === 'medium' ? 'yellow' : 'blue'}-700">
              <strong>${risk.message}</strong> - ${risk.action}
            </p>
          </div>
        </div>
      </div>
    `).join('');

    alertsContainer.innerHTML = alertsHtml;
  }

  function updateCharts(data) {
    const ctxRevenue = document.getElementById('revenue-chart');
    const ctxUsers = document.getElementById('users-chart');

    if (revenueChart) revenueChart.destroy();
    if (usersChart) usersChart.destroy();

    revenueChart = new Chart(ctxRevenue, {
      type: 'line',
      data: {
        labels: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'],
        datasets: [{
          label: 'Receita (R$)',
          data: data.monthlyRevenue || [],
          borderColor: 'rgb(59, 130, 246)',
          backgroundColor: 'rgba(59, 130, 246, 0.1)',
          tension: 0.1
        }]
      },
      options: {
        responsive: true,
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(value) {
                return 'R$ ' + value.toLocaleString('pt-BR');
              }
            }
          }
        }
      }
    });

    usersChart = new Chart(ctxUsers, {
      type: 'bar',
      data: {
        labels: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'],
        datasets: [{
          label: 'Usuários',
          data: data.monthlyUsers || [],
          backgroundColor: 'rgba(16, 185, 129, 0.8)',
          borderColor: 'rgb(16, 185, 129)',
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });
  }

  function updateForecastTable(forecasts) {
    const tbody = document.querySelector('#forecast-table tbody');
    tbody.innerHTML = forecasts.map(forecast => `
      <tr>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${forecast.month}</td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">R$ ${forecast.projectedRevenue?.toLocaleString('pt-BR')}</td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${forecast.projectedUsers?.toLocaleString()}</td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${(forecast.confidence * 100).toFixed(1)}%</td>
      </tr>
    `).join('');
  }

  function updateSystemMetrics(metrics) {
    document.getElementById('system-uptime').textContent = `${Math.floor((metrics.uptime || 0) / 3600)}h ${Math.floor(((metrics.uptime || 0) % 3600) / 60)}m`;
    document.getElementById('system-memory').textContent = `${Math.round((metrics.memory?.heapUsed || 0) / 1024 / 1024)} MB`;
    document.getElementById('system-status').textContent = 'Online';
  }

  // Carregar dados inicialmente
  loadDashboardData();

  // Atualizar a cada 30 segundos
  setInterval(loadDashboardData, 30000);
</script>

<style>
  /* Chart.js customizações se necessário */
</style>
