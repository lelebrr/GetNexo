---
import Layout from '../../layouts/Layout.astro';

// SEO Meta Tags
const title = "Analytics GetNexo - Aumente Vendas com Dados em Tempo Real | GetNexo";
const description = "Dashboard de analytics completo para monitorar vendas, conversão e performance do seu chatbot WhatsApp. Aumente vendas com insights inteligentes e relatórios automáticos!";
const keywords = "analytics getnexo, dashboard vendas, métricas chatbot, relatórios automáticos, aumento vendas, performance WhatsApp";
const canonical = "https://getnexo.com.br/pt/analytics";

// Structured Data - Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "logo": "https://getnexo.com.br/logo.png",
  "sameAs": [
    "https://www.linkedin.com/company/getnexo",
    "https://twitter.com/getnexo",
    "https://github.com/getnexo"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+5511999999999",
    "contactType": "customer service",
    "areaServed": "BR",
    "availableLanguage": "pt-BR"
  }
};

// WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://getnexo.com.br/buscar?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Início",
      "item": "https://getnexo.com.br"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Analytics",
      "item": "https://getnexo.com.br/pt/analytics"
    }
  ]
};

// SoftwareApplication Schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "GetNexo - Analytics Avançado",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "97",
    "priceCurrency": "BRL",
    "availability": "https://schema.org/InStock"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "5000"
  }
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Como o analytics aumenta vendas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Com dados em tempo real, você identifica oportunidades, otimiza funis de vendas e toma decisões baseadas em métricas, aumentando conversões em até 40%."
      }
    },
    {
      "@type": "Question",
      "name": "Quais métricas são monitoradas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Conversão, taxa de resposta, tempo de atendimento, satisfação do cliente, ROI, comportamento do usuário e muito mais."
      }
    },
    {
      "@type": "Question",
      "name": "Os relatórios são automáticos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim! Receba relatórios diários, semanais e mensais automáticos por email ou WhatsApp."
      }
    }
  ]
};

// Metrics data
const metrics = [
  {
    icon: "📈",
    title: "Conversão",
    value: "42%",
    change: "+15%",
    desc: "Taxa de conversão de leads para vendas",
    trend: "up"
  },
  {
    icon: "⚡",
    title: "Tempo Resposta",
    value: "2.3s",
    change: "-40%",
    desc: "Média de resposta do chatbot",
    trend: "down"
  },
  {
    icon: "😊",
    title: "Satisfação",
    value: "4.9/5",
    change: "+0.3",
    desc: "Avaliação dos clientes",
    trend: "up"
  },
  {
    icon: "💰",
    title: "ROI",
    value: "320%",
    change: "+80%",
    desc: "Retorno sobre investimento",
    trend: "up"
  }
];

// Features data
const features = [
  {
    icon: "📊",
    title: "Dashboard em Tempo Real",
    desc: "Monitore todas as métricas em um único painel",
    benefits: [
      "Atualização a cada segundo",
      "Gráficos interativos",
      "Filtros avançados",
      "Exportação de dados"
    ],
    stats: ["+40% velocidade", "99.9% uptime", "Dados em tempo real"]
  },
  {
    icon: "🎯",
    title: "Funil de Vendas Inteligente",
    desc: "Visualize cada etapa do processo de vendas",
    benefits: [
      "Identificação de gargalos",
      "Otimização automática",
      "Previsão de conversão",
      "A/B testing integrado"
    ],
    stats: ["+35% conversão", "Identificação em 2min", "ROI mensurável"]
  },
  {
    icon: "🔔",
    title: "Alertas Inteligentes",
    desc: "Receba notificações quando métricas mudarem",
    benefits: [
      "Alertas por email/WhatsApp",
      "Configuração personalizada",
      "Ações automáticas",
      "Integração com Slack"
    ],
    stats: ["+50% agilidade", "Resposta em 5min", "Sem perdas"]
  },
  {
    icon: "🤖",
    title: "Insights com IA",
    desc: "Recomendações automáticas para melhorar performance",
    benefits: [
      "Análise preditiva",
      "Sugestões de otimização",
      "Benchmarking do mercado",
      "Relatórios automáticos"
    ],
    stats: ["+25% otimização", "Decisões baseadas", "ROI comprovado"]
  },
  {
    icon: "📱",
    title: "Relatórios Automáticos",
    desc: "Receba relatórios diários, semanais e mensais",
    benefits: [
      "Envio automático",
      "Personalização completa",
      "Comparativo histórico",
      "Exportação em PDF/Excel"
    ],
    stats: ["-90% tempo", "Sem erros", "Sempre atualizado"]
  },
  {
    icon: "🔗",
    title: "Integrações",
    desc: "Conecte com suas ferramentas favoritas",
    benefits: [
      "Google Analytics",
      "CRM (HubSpot, Salesforce)",
      "E-commerce (Shopify, WooCommerce)",
      "API completa"
    ],
    stats: ["+50% eficiência", "Dados unificados", "Sem duplicidade"]
  }
];

// Use cases data
const useCases = [
  {
    title: "E-commerce",
    desc: "Monitore vendas, carrinhos abandonados e conversão",
    results: ["+45% conversão", "-30% abandono", "ROI 300%"]
  },
  {
    title: "Serviços",
    desc: "Acompanhe agendamentos e satisfação do cliente",
    results: ["+40% retenção", "Satisfação 4.9/5", "Crescimento 50%"]
  },
  {
    title: "Consultoria",
    desc: "Monitore leads qualificados e fechamento de contratos",
    results: ["+35% fechamento", "Qualificação 24/7", "ROI 280%"]
  },
  {
    title: "Educação",
    desc: "Acompanhe matrículas e engajamento dos alunos",
    results: ["+50% matrículas", "Engajamento 85%", "Retenção 90%"]
  }
];

// Testimonials data
const testimonials = [
  {
    name: "Carlos Mendes",
    role: "CEO",
    company: "TechStore",
    quote: "Com o analytics, identificamos oportunidades que geraram R$ 120k extra em 3 meses.",
    results: [
      { value: "+40%", label: "conversão" },
      { value: "R$ 120k", label: "faturamento extra" },
      { value: "3 meses", label: "resultado" }
    ]
  },
  {
    name: "Ana Paula",
    role: "Gerente",
    company: "Clínica Vida",
    quote: "Os relatórios automáticos nos ajudaram a reduzir custos e aumentar satisfação.",
    results: [
      { value: "-25%", label: "custos" },
      { value: "+35%", label: "satisfação" },
      { value: "4.9/5", label: "avaliação" }
    ]
  }
];

// Stats data
const stats = [
  { value: "50+", label: "métricas", desc: "monitoradas" },
  { value: "99.9%", label: "uptime", desc: "garantido" },
  { value: "24/7", label: "monitoramento", desc: "em tempo real" },
  { value: "Grátis", label: "setup", desc: "sem cartão" }
];

// Trust badges
const trustBadges = [
  { icon: "📊", title: "Dashboard", desc: "Em tempo real" },
  { icon: "🔔", title: "Alertas", desc: "Inteligentes" },
  { icon: "🤖", title: "Insights", desc: "Com IA" },
  { icon: "📈", title: "ROI", desc: "Comprovado" }
];
---

<Layout title={title} description={description} keywords={keywords}>

  <!-- SEO Schemas -->
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="analytics-hero" aria-label="Analytics GetNexo">
    <div class="hero-badge">📊 Analytics Avançado</div>
    <h1>Analytics que <span class="text-gradient">Aumentam Vendas</span></h1>
    <p class="hero-desc">
      Dashboard completo com <strong>dados em tempo real</strong>, insights com IA e relatórios automáticos. <strong>Aumente vendas em 40%+</strong> com decisões baseadas em métricas!
    </p>

    <!-- Trust Badges -->
    <div class="trust-badges">
      {trustBadges.map(badge => (
        <div class="trust-badge">
          <span class="trust-icon">{badge.icon}</span>
          <div>
            <strong>{badge.title}</strong>
            <span>{badge.desc}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-ctas">
      <a href="/criar-bot" class="btn-primary-glow" aria-label="Começar analytics">
        Começar Analytics
      </a>
      <a href="/contato" class="btn-outline" aria-label="Ver dashboard">
        Ver Dashboard
      </a>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="max-w-6xl mx-auto px-5">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map(stat => (
          <div class="stat-card glass-panel p-6 text-center">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-desc">{stat.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Metrics Section -->
  <section class="metrics-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Métricas em <span class="text-gradient">Tempo Real</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Monitore todas as métricas importantes em um único painel</p>
      </div>

      <div class="metrics-grid">
        {metrics.map(metric => (
          <div class="metric-card glass-panel p-8 rounded-3xl">
            <div class="metric-header">
              <span class="metric-icon">{metric.icon}</span>
              <div class="metric-change">
                <span class={`change-value ${metric.trend === 'up' ? 'up' : 'down'}`}>
                  {metric.change}
                </span>
              </div>
            </div>
            <div class="metric-value">{metric.value}</div>
            <div class="metric-title">{metric.title}</div>
            <div class="metric-desc">{metric.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Recursos do <span class="text-gradient">Dashboard</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Tudo que você precisa para monitorar e otimizar vendas</p>
      </div>

      <div class="features-grid">
        {features.map(feature => (
          <div class="feature-card glass-panel p-8 rounded-3xl">
            <div class="feature-icon">{feature.icon}</div>
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-desc">{feature.desc}</p>
            <ul class="feature-benefits">
              {feature.benefits.map(benefit => (
                <li class="benefit-item">
                  <span class="benefit-check">✓</span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
            <div class="feature-stats">
              {feature.stats.map(stat => (
                <span class="stat-tag">{stat}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="use-cases-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Casos de <span class="text-gradient">Uso</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Veja como diferentes segmentos usam analytics para crescer</p>
      </div>

      <div class="use-cases-grid">
        {useCases.map(useCase => (
          <div class="use-case-card glass-panel p-8 rounded-3xl">
            <h3 class="use-case-title">{useCase.title}</h3>
            <p class="use-case-desc">{useCase.desc}</p>
            <div class="use-case-results">
              {useCase.results.map(result => (
                <span class="result-tag">{result}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Depoimentos de <span class="text-gradient">Clientes</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">O que nossos clientes dizem sobre os resultados</p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map(testimonial => (
          <div class="testimonial-card glass-panel p-8 rounded-3xl">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <span class="avatar-placeholder">{testimonial.name.charAt(0)}</span>
              </div>
              <div>
                <h3 class="testimonial-name">{testimonial.name}</h3>
                <p class="testimonial-role">{testimonial.role}</p>
                <p class="testimonial-company">{testimonial.company}</p>
              </div>
            </div>
            <blockquote class="testimonial-quote">"{testimonial.quote}"</blockquote>
            <div class="testimonial-results">
              {testimonial.results.map(result => (
                <div class="result-item">
                  <span class="result-value">{result.value}</span>
                  <span class="result-label">{result.label}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="max-w-4xl mx-auto px-5">
      <h2 class="text-center text-3xl font-bold text-white mb-4">Perguntas <span class="text-gradient">Frequentes</span></h2>
      <p class="text-center text-slate-400 mb-12">Tire suas dúvidas sobre analytics</p>
      
      <div class="space-y-4">
        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            Como o analytics aumenta vendas?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Com dados em tempo real, você identifica oportunidades, otimiza funis de vendas e toma decisões baseadas em métricas, aumentando conversões em até 40%.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            Quais métricas são monitoradas?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Conversão, taxa de resposta, tempo de atendimento, satisfação do cliente, ROI, comportamento do usuário e muito mais.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            Os relatórios são automáticos?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Sim! Receba relatórios diários, semanais e mensais automáticos por email ou WhatsApp.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            Posso exportar os dados?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Sim! Exporte dados em PDF, Excel ou CSV. Também oferecemos API para integrações personalizadas.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            Como funciona o dashboard?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Dashboard intuitivo com gráficos interativos, filtros avançados e atualização em tempo real. Acesse via web ou mobile.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            Tem integração com outras ferramentas?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Sim! Integra com Google Analytics, HubSpot, Salesforce, Shopify, WooCommerce e muitas outras via API.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Implementation Guide -->
  <section class="implementation-section py-20 px-5 max-w-6xl mx-auto">
    <div class="glass-panel p-12 rounded-3xl">
      <h2 class="text-3xl font-bold text-white mb-6 text-center">Guia de <span class="text-gradient">Implementação</span></h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="step-number">1</div>
          <h3 class="text-xl font-bold text-white mb-2">Conecte</h3>
          <p class="text-slate-400">Integre com seu chatbot e ferramentas existentes</p>
        </div>
        <div class="text-center">
          <div class="step-number">2</div>
          <h3 class="text-xl font-bold text-white mb-2">Configure</h3>
          <p class="text-slate-400">Defina métricas e alertas que importam para você</p>
        </div>
        <div class="text-center">
          <div class="step-number">3</div>
          <h3 class="text-xl font-bold text-white mb-2">Monitore</h3>
          <p class="text-slate-400">Acompanhe resultados e tome decisões inteligentes</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta py-20 text-center px-4">
    <div class="max-w-4xl mx-auto glass-panel p-12 rounded-3xl">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-6">Pronto para <span class="text-blue-400">dominar</span> seus dados?</h2>
      <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto">
        Comece com GetNexo e transforme dados em vendas reais.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/criar-bot" class="btn-primary-glow bg-blue-600 hover:bg-blue-500" aria-label="Começar analytics">
          Começar Analytics
        </a>
        <a href="/contato" class="px-10 py-5 bg-transparent border border-blue-500 text-blue-400 font-bold rounded-2xl hover:bg-blue-500 hover:text-white transition-colors text-lg" aria-label="Ver dashboard">
          Ver Dashboard
        </a>
      </div>
      <p class="mt-8 text-sm text-slate-500">
        ✅ Sem cartão de crédito • ✅ Cancelamento fácil • ✅ Suporte em português
      </p>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .analytics-hero { 
    padding: 8rem 5% 4rem; 
    text-align: center; 
    max-width: 1300px; 
    margin: 0 auto; 
  }
  
  .hero-badge { 
    background: rgba(34, 197, 94, 0.1); 
    color: #22c55e; 
    padding: 0.5rem 1.2rem; 
    border-radius: 50px; 
    font-size: 0.85rem; 
    font-weight: 700; 
    border: 1px solid rgba(34, 197, 94, 0.2); 
    display: inline-block; 
    margin-bottom: 2rem; 
  }
  
  .analytics-hero h1 { 
    font-size: 3.5rem; 
    margin-bottom: 1.5rem; 
    color: white;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  
  .hero-desc { 
    font-size: 1.35rem; 
    color: #94a3b8; 
    max-width: 900px; 
    margin: 0 auto 3rem; 
    line-height: 1.6;
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
  }
  .trust-icon {
    font-size: 1.5rem;
  }
  .trust-badge strong {
    display: block;
    color: white;
    font-size: 0.9rem;
