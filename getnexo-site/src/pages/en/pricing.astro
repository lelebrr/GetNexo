    features: [
      { text: "Unlimited messages", included: true, highlight: true },
      { text: "All features unlocked", included: true, highlight: false },
      { text: "Your data, your sovereignty", included: true, highlight: false },
      { text: "Unlimited multi-agent", included: true, highlight: false },
      { text: "Community updates", included: true, highlight: false },
      { text: "Self-installation", included: false, highlight: false },
      { text: "Community support", included: false, highlight: false }
    ],
    cta: "Download on GitHub",
    ctaLink: "https://github.com/lelebrr",
