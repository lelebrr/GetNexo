  {
    name: "Enterprise",
    type: "Large Operations",
    price: "Custom",
    period: "",
    description: "For high-volume operations and specific requirements.",
    features: [
      { text: "Multiple AI instances", included: true, highlight: true },
      { text: "Dedicated RESTful API (High Throughput)", included: true, highlight: false },
      { text: "AI Consulting included", included: true, highlight: false },
      { text: "Contract-guaranteed SLA", included: true, highlight: false },
      { text: "Full White Label", included: true, highlight: false },
      { text: "Dedicated Account Manager", included: true, highlight: true },
      { text: "Team training", included: true, highlight: false }
