  },
  {
    name: "GetNexo Pro",
    type: "Managed Cloud",
    price: "$ 19",
    period: "/month",
    description: "We handle everything. You just sell.",
    features: [
      { text: "Everything in Free", included: true, highlight: true },
      { text: "Ultra-fast NVMe servers", included: true, highlight: false },
      { text: "Activation in 5 minutes", included: true, highlight: false },
      { text: "Daily automatic backups", included: true, highlight: false },
      { text: "SSL and domain included", included: true, highlight: false },
      { text: "VIP Support via WhatsApp", included: true, highlight: true },
      { text: "Automatic updates", included: true, highlight: false }
