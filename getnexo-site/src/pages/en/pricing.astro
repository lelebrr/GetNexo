const comparison = [
  { feature: "Messages/month", selfhosted: "∞ Unlimited", pro: "∞ Unlimited", enterprise: "∞ Unlimited" },
  { feature: "Generative AI", selfhosted: "OpenAI/Gemini", pro: "OpenAI/Gemini", enterprise: "Custom Model" },
  { feature: "Simultaneous Agents", selfhosted: "Unlimited", pro: "Unlimited", enterprise: "Unlimited" },
  { feature: "PIX Checkout", selfhosted: "✓", pro: "✓", enterprise: "✓" },
  { feature: "CRM Kanban", selfhosted: "✓", pro: "✓", enterprise: "✓" },
  { feature: "Broadcast", selfhosted: "✓", pro: "✓", enterprise: "Priority" },
  { feature: "Integrations", selfhosted: "All", pro: "All", enterprise: "All + Custom" },
  { feature: "Support", selfhosted: "Community", pro: "VIP WhatsApp", enterprise: "Dedicated 24/7" },
  { feature: "SLA Uptime", selfhosted: "N/A", pro: "99.5%", enterprise: "99.9%" },
  { feature: "Backups", selfhosted: "Manual", pro: "Automatic", enterprise: "Automatic + Geo" }
