---
import Layout from '../../layouts/Layout.astro';
// Enhanced SEO Constants for Top Google Ranking
const title = "GetNexo Plans and Pricing | Best Value in WhatsApp Automation";
const description = "Compare GetNexo plans: Starter, Pro, and Enterprise. WhatsApp automation with AI, unlimited API keys, and premium support.";
const keywords = "getnexo price, whatsapp api plans, whatsapp bot value, whatsapp automation cost";

const lang = 'en';
const { default: t } = await import(`../../i18n/${lang}.json`);

const plans = [
  {
    name: "Self-Hosted",
