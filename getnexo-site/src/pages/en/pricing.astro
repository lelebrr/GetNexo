};
---

<Layout title={title} description={description} keywords={keywords}>
  
  <!-- Hero Section -->
  <section class="pricing-hero">
    <div class="hero-badge">💰 Unbeatable ROI</div>
    <h1>Transparent <span class="text-gradient">pricing</span></h1>
    <p class="hero-subtitle">
      No surprises. No hidden fees. No commitment. Choose the plan that works for you.
    </p>
  </section>

  <!-- Guarantees Bar -->
  <section class="guarantees-section">
    <div class="guarantees-grid">
      {guarantees.map(g => (
        <div class="guarantee-item">
          <span class="g-icon">{g.icon}</span>
          <div>
            <strong>{g.title}</strong>
            <span>{g.desc}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="pricing-cards-section">
    <div class="pricing-grid">
      {plans.map(plan => (
        <div class={`pricing-card glass-panel ${plan.popular ? 'featured' : ''}`}>
          {plan.popular && <div class="popular-badge">Most Chosen</div>}
          <div class="card-type">{plan.type}</div>
          <h3>{plan.name}</h3>
          <div class="card-price">
            {plan.price}<span>{plan.period}</span>
          </div>
          <p class="card-desc">{plan.description}</p>
          
          <ul class="card-features">
            {plan.features.map(f => (
              <li class={f.highlight ? 'highlight' : ''}>
                {f.included ? '✅' : '❌'} <span set:html={f.text}></span>
              </li>
            ))}
          </ul>
          
          <a 
            href={plan.ctaLink} 
            class={plan.popular ? 'btn-xl-glow' : 'btn-outline-glow'}
            target={plan.ctaLink.startsWith('http') ? '_blank' : '_self'}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- ROI Calculator -->
  <section class="roi-calculator-section">
    <h2>Calculate your <span class="text-gradient">savings</span></h2>
    <p class="section-subtitle">See how much you can save by replacing attendants or expensive SaaS</p>
    
    <div class="roi-wrapper glass-panel">
      <div class="roi-controls">
        <div class="control-group">
          <label>Monthly Leads: <span id="lead-value">5.000</span></label>
          <input type="range" id="lead-slider" min="500" max="50000" step="500" value="5000" class="premium-slider" />
        </div>
        <div class="control-group">
          <label>Cost per Agent/SaaS: <span id="cost-value">$ 300</span></label>
          <input type="range" id="cost-slider" min="100" max="2000" step="50" value="300" class="premium-slider" />
        </div>
      </div>
      <div class="roi-result">
        <div class="result-card">
          <span class="res-label">Estimated Monthly Savings</span>
          <span class="res-value" id="roi-savings">$ 881.00</span>
          <p>Based on 1 AI replacing 3 attendants.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="comparison-section">
    <h2>Detailed <span class="text-gradient">comparison</span></h2>
    
    <div class="comparison-table glass-panel">
      <div class="table-header">
        <span>Feature</span>
        <span>Self-Hosted</span>
        <span class="highlight">Pro</span>
        <span>Enterprise</span>
      </div>
      {comparison.map(row => (
        <div class="table-row">
          <span class="row-feature">{row.feature}</span>
          <span>{row.selfhosted}</span>
          <span class="highlight">{row.pro}</span>
          <span>{row.enterprise}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Add-ons -->
  <section class="addons-section">
    <h2>Optional <span class="text-gradient">add-ons</span></h2>
    
    <div class="addons-grid">
      {addons.map(addon => (
        <div class="addon-card glass-panel">
          <div class="addon-info">
            <strong>{addon.name}</strong>
            <span>{addon.desc}</span>
          </div>
          <span class="addon-price">{addon.price}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section">
    <h2>What customers <span class="text-gradient">say about the price</span></h2>
    
    <div class="testimonials-grid">
      {testimonialPricing.map(t => (
        <div class="testimonial-card glass-panel">
          <div class="t-header">
            <span class="t-avatar">{t.avatar}</span>
            <div class="t-info">
              <strong>{t.name}</strong>
              <span>{t.company}</span>
            </div>
          </div>
          <p class="t-text">"{t.text}"</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <h2>Questions about <span class="text-gradient">pricing</span></h2>
    
    <div class="faq-list">
      {faqs.map(faq => (
        <details class="faq-item glass-panel">
          <summary>
            <span class="faq-q">{faq.q}</span>
            <span class="faq-toggle">+</span>
          </summary>
          <p class="faq-a">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="glass-panel cta-box">
      <h2>Ready to <span class="text-gradient">save</span>?</h2>
      <p>Start for free or choose the Pro plan for VIP support.</p>
      <div class="cta-buttons">
        <a href="/en/create-bot" class="btn-primary-glow">Start Free</a>
        <a href="/en/contact" class="btn-outline">Talk to Sales</a>
      </div>
      <p class="cta-note">7-day free trial • No credit card required • Cancel anytime</p>
    </div>
  </section>

  <script nonce={Astro.locals.nonce} type="application/ld+json" is:inline set:html={JSON.stringify(priceSchema)}></script>

</Layout>

<script nonce={Astro.locals.nonce} is:inline>
  const leadSlider = document.getElementById('lead-slider');
  const costSlider = document.getElementById('cost-slider');
  const leadVal = document.getElementById('lead-value');
  const costVal = document.getElementById('cost-value');
  const roiSavings = document.getElementById('roi-savings');

  function updateROI() {
    const leads = parseInt(leadSlider.value);
    const costPerHuman = parseInt(costSlider.value);
    
    let humansSaved = 1;
    if (leads > 2000) humansSaved = 3;
    if (leads > 10000) humansSaved = 6;
    if (leads > 30000) humansSaved = 12;

    const totalCostSaved = (humansSaved * costPerHuman) - 19;
    
    leadVal.innerText = leads.toLocaleString();
    costVal.innerText = `$ ${costPerHuman.toLocaleString()}`;
    roiSavings.innerText = `$ ${Math.max(0, totalCostSaved).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
  }

  leadSlider?.addEventListener('input', updateROI);
  costSlider?.addEventListener('input', updateROI);
  updateROI();
</script>

