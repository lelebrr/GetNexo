const addons = [
  { name: "Additional WhatsApp Number", price: "$ 9/month", desc: "Each extra number for multiple businesses" },
  { name: "Assisted Installation", price: "$ 59 one-time", desc: "Full self-hosted setup with training" },
  { name: "AI Consulting", price: "$ 39/hour", desc: "Prompt and flow optimization" },
  { name: "White Label", price: "Upon request", desc: "Your brand, your domain, custom interface" }
];

const guarantees = [
  { icon: "💰", title: "7 days free", desc: "Test the Pro plan without commitment" },
  { icon: "🔒", title: "No strings attached", desc: "Cancel anytime, no fees" },
  { icon: "📊", title: "No fee per message", desc: "Pay only the fixed monthly fee" },
  { icon: "🔄", title: "Free migration", desc: "We help bring your data" }
];

const faqs = [
  {
    q: "Is there a fee per message sent?",
    a: "No! You only pay the Pro plan monthly fee ($ 19) or nothing for self-hosted. The only additional fees are those charged by Meta if you exceed the free Tier of the Cloud API (first 1000 conversations/month are free)."
  },
  {
    q: "What is the difference between Self-Hosted and Pro?",
    a: "On Self-Hosted, you install and maintain everything on your server. On Pro, we handle infrastructure, backups, SSL, updates, and offer VIP support. AI and automation features are identical in both."
  },
  {
    q: "Can I start for free and migrate to Pro later?",
    a: "Yes! Many customers start self-hosted to test and then migrate to the Pro cloud when they want convenience. Migration is simple and we help with the process."
  },
  {
    q: "If I cancel, do I lose my data?",
    a: "No. You can export all your data before canceling. On self-hosted, the data is already yours. On Pro, we provide a full backup for download."
  },
  {
    q: "What forms of payment do you accept?",
    a: "Credit Card, PayPal, and Bank Transfer. For Enterprise, special conditions are negotiated."
  },
  {
    q: "What if I need more than 3 numbers?",
    a: "No problem! Each additional number costs $ 9/month. For larger volumes (10+), we offer a progressive discount on the Enterprise plan."
  }
];

const testimonialPricing = [
  { name: "Richard", company: "Online Store", text: "I spent $ 1,000/month with 3 attendants. Today I pay $ 19 and the AI does more than they did!", avatar: "👨‍💼" },
  { name: "Sarah", company: "Aesthetics Clinic", text: "The ROI was insane. Within the first week, I had already recovered 6 months of monthly fees.", avatar: "👩‍⚕️" }
];

const priceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://getnexo.com.br/#organization",
      "name": "GetNexo",
      "url": "https://getnexo.com.br/en/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://getnexo.com.br/logo.svg"
      }
