---
import Layout from '../../layouts/Layout.astro';

const title = "Contact GetNexo | Support, Privacy, and GDPR Requests";
const description = "Contact GetNexo. Technical support, ARCO rights requests (GDPR), DPO, privacy questions, and personal data.";
const keywords = "getnexo contact, whatsapp api support, gdpr rights, getnexo dpo, data privacy, request data deletion, technical support";
---

<Layout title={title} description={description} keywords={keywords}>
  <section class="contact-hero">
    <div class="hero-badge">Contact</div>
    <h1 class="text-gradient">Contact Us</h1>
    <p>Technical support, ARCO rights requests (GDPR), and personalized service.</p>
  </section>

  <section class="contact-content">
    <div class="contact-grid">
      <!-- General Support -->
      <div class="contact-card">
        <div class="card-header">
          <div class="card-icon">💬</div>
          <h3>General Support</h3>
        </div>
        <div class="card-body">
          <p>Questions about installation, configuration, or platform use.</p>
          <div class="contact-methods">
            <a href="https://wa.me/5511999999999?text=Hello%20GetNexo!%20I%20need%20help..." target="_blank" class="contact-link whatsapp">
              <span>📱</span> WhatsApp
            </a>
            <a href="mailto:support@getnexo.com.br" class="contact-link email">
              <span>📧</span> support@getnexo.com.br
            </a>
          </div>
        </div>
      </div>

      <!-- Privacy and GDPR -->
      <div class="contact-card featured">
        <div class="card-header">
          <div class="card-icon">🔒</div>
          <h3>Privacy & GDPR</h3>
        </div>
        <div class="card-body">
          <p>ARCO rights requests, questions about data protection, and DPO.</p>
          <div class="contact-methods">
            <a href="mailto:dpo@getnexo.com.br" class="contact-link email">
              <span>🛡️</span> dpo@getnexo.com.br
            </a>
            <a href="mailto:privacy@getnexo.com.br" class="contact-link email">
              <span>📋</span> privacy@getnexo.com.br
            </a>
          </div>
          <div class="lgpd-notice">
            <p><strong>Controller Data:</strong></p>
            <p>GetNexo Tecnologia Ltda.<br>Tax ID: 45.678.901/0001-23<br>Officer: Leandro Brandão</p>
          </div>
        </div>
      </div>

      <!-- Sales and Partnerships -->
      <div class="contact-card">
        <div class="card-header">
          <div class="card-icon">🚀</div>
          <h3>Sales & Partnerships</h3>
        </div>
        <div class="card-body">
          <p>Demos, business proposals, and reseller program.</p>
          <div class="contact-methods">
            <a href="https://wa.me/5511999999999?text=Hello!%20I%20would%20like%20to%20know%20more%20about%20GetNexo..." target="_blank" class="contact-link whatsapp">
              <span>📱</span> Sales WhatsApp
            </a>
            <a href="mailto:sales@getnexo.com.br" class="contact-link email">
              <span>📧</span> sales@getnexo.com.br
            </a>
          </div>
        </div>
      </div>

      <!-- Legal -->
      <div class="contact-card">
        <div class="card-header">
          <div class="card-icon">⚖️</div>
          <h3>Legal Matters</h3>
        </div>
        <div class="card-body">
          <p>Contracts, compliance, and legal issues.</p>
          <div class="contact-methods">
            <a href="mailto:legal@getnexo.com.br" class="contact-link email">
              <span>📜</span> legal@getnexo.com.br
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ARCO Rights Request Form -->
    <div class="lgpd-form-section">
      <div class="glass-panel lgpd-form-wrap">
        <h2>ARCO Rights Request (GDPR)</h2>
        <p>Use this form to exercise your rights under the General Data Protection Law:</p>

        <form id="lgpd-request-form" class="lgpd-form">
          <div class="form-row">
            <div class="form-group">
              <label for="requester-name">Full Name *</label>
              <input type="text" id="requester-name" name="name" required placeholder="Your full name" />
            </div>
            <div class="form-group">
              <label for="requester-email">E-mail *</label>
              <input type="email" id="requester-email" name="email" required placeholder="your@email.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="requester-doc">Social Security Number / Tax ID *</label>
              <input type="text" id="requester-doc" name="document" required placeholder="000.000.000-00 or 00.000.000/0000-00" />
            </div>
            <div class="form-group">
              <label for="requester-phone">Phone (WhatsApp)</label>
              <input type="tel" id="requester-phone" name="phone" placeholder="+1 (555) 000-0000" />
            </div>
          </div>

          <div class="form-group">
            <label for="request-type">Request Type *</label>
            <select id="request-type" name="request_type" required>
              <option value="">Select the right you wish to exercise</option>
              <option value="confirmation">Confirmation of data processing</option>
              <option value="access">Access to personal data</option>
              <option value="correction">Correction of incomplete/inaccurate data</option>
              <option value="anonymization">Data anonymization</option>
              <option value="portability">Data portability</option>
              <option value="deletion">Data deletion</option>
              <option value="information">Information about sharing</option>
              <option value="opposition">Opposition to processing</option>
              <option value="revocation">Revocation of consent</option>
              <option value="other">Other (specify below)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="request-description">Request Description *</label>
            <textarea id="request-description" name="description" required rows="4" placeholder="Describe your request in detail. Include information that helps us identify your data (approximate period of use, services used, etc.)"></textarea>
          </div>

          <div class="form-group">
            <label for="request-evidence">Evidence/Verification (Optional)</label>
            <input type="file" id="request-evidence" name="evidence" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
            <small>Accepted formats: PDF, JPG, PNG, DOC, DOCX (max. 5MB)</small>
          </div>

          <div class="form-consent">
            <input type="checkbox" id="lgpd-consent" name="consent" required />
            <label for="lgpd-consent">
              I declare that the information provided is true and that I am aware that the request will be processed according to GDPR regulations. *
            </label>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary">Send Request</button>
            <button type="reset" class="btn-secondary">Clear Form</button>
          </div>
        </form>

        <div class="lgpd-info">
          <h3>ℹ️ About ARCO Rights</h3>
          <p>ARCO rights (Access, Rectification, Cancellation, and Opposition) are fundamental privacy rights. We will process your request within 15 business days, extendable for a further 15 days if necessary.</p>
          <p><strong>Guaranteed response:</strong> You will receive a receipt confirmation within 24 hours and a final response within the legal timeframe.</p>
        </div>
      </div>
    </div>

    <!-- Service Hours -->
    <div class="support-hours">
      <h2>Service Hours</h2>
      <div class="hours-grid">
        <div class="hours-item">
          <h4>Technical Support</h4>
          <p>Monday to Friday: 9am to 6pm<br>Saturday: 9am to 12pm (BRT)</p>
        </div>
        <div class="hours-item">
          <h4>Privacy & GDPR</h4>
          <p>Monday to Friday: 9am to 6pm<br>Response within 24h</p>
        </div>
        <div class="hours-item">
          <h4>Emergencies</h4>
          <p>24/7 for critical issues<br>WhatsApp: +55 11 99999-9999</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-hero {
    text-align: center;
    padding: 10rem 5% 4rem;
  }
  .hero-badge {
    background: rgba(0, 212, 255, 0.1);
    color: #00d4ff;
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 2rem;
    border: 1px solid rgba(0,212,255,0.2);
  }
  .contact-hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    font-weight: 800;
  }
  .contact-hero p {
    color: #94a3b8;
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 5% 10rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 6rem;
  }

  .contact-card {
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 2rem;
    transition: 0.3s;
  }

  .contact-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 212, 255, 0.2);
  }

  .contact-card.featured {
    border-color: rgba(0, 255, 157, 0.3);
    background: rgba(0, 255, 157, 0.02);
  }

  .contact-card.featured:hover {
    border-color: rgba(0, 255, 157, 0.5);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .card-icon {
    font-size: 2rem;
    width: 60px;
    height: 60px;
    background: rgba(0, 212, 255, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-card.featured .card-icon {
    background: rgba(0, 255, 157, 0.1);
  }

  .card-header h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: white;
    margin: 0;
  }

  .card-body p {
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    color: #cbd5e1;
    text-decoration: none;
    transition: 0.3s;
  }

  .contact-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    transform: translateX(5px);
  }

  .contact-link.whatsapp:hover {
    background: #25d366;
    color: white;
  }

  .lgpd-notice {
    margin-top: 1.5rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    border-left: 3px solid #00d4ff;
  }

  .lgpd-notice p {
    margin: 0.3rem 0;
    font-size: 0.85rem;
    color: #cbd5e1;
  }

  .lgpd-form-section {
    margin-bottom: 6rem;
  }

  .lgpd-form-wrap {
    padding: 3rem;
    border-radius: 24px;
    border-color: rgba(0, 212, 255, 0.2);
  }

  .lgpd-form-wrap h2 {
    color: white;
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .lgpd-form-wrap > p {
    color: #94a3b8;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .lgpd-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 1rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: white;
    font-size: 1rem;
    outline: none;
    transition: 0.3s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: #00d4ff;
    background: rgba(0, 0, 0, 0.5);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group input[type="file"] {
    padding: 0.5rem;
  }

  .form-group small {
    color: #64748b;
    font-size: 0.8rem;
  }

  .form-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .form-consent input[type="checkbox"] {
    margin-top: 0.2rem;
    width: 16px;
    height: 16px;
    accent-color: #00d4ff;
  }

  .form-consent label {
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    cursor: pointer;
  }

  .form-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .btn-primary, .btn-secondary {
    padding: 1rem 2rem;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    font-size: 1rem;
    transition: 0.3s;
  }

  .btn-primary {
    background: linear-gradient(135deg, #00d4ff, #00ff9d);
    color: black;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 212, 255, 0.3);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lgpd-info {
    margin-top: 3rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    border-left: 4px solid #00ff9d;
  }

  .lgpd-info h3 {
    color: #00ff9d;
    margin-bottom: 1rem;
    font-size: 1.2rem;
  }

  .lgpd-info p {
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .lgpd-info p:last-child {
    margin-bottom: 0;
  }

  .support-hours {
    text-align: center;
  }

  .support-hours h2 {
    color: white;
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 2rem;
  }

  .hours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .hours-item {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 2rem;
  }

  .hours-item h4 {
    color: #00d4ff;
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hours-item p {
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .lgpd-form-wrap {
      padding: 2rem;
    }

    .hours-grid {
      grid-template-columns: 1fr;
    }

    .contact-hero h1 {
      font-size: 2.5rem;
    }

    .lgpd-form-wrap h2 {
      font-size: 1.5rem;
    }
  }
</style>

<script is:inline>
  // Form handling for GDPR requests
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('lgpd-request-form');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Basic validation
        if (!data.name || !data.email || !data.document || !data.request_type || !data.description) {
          alert('Please fill in all required fields.');
          return;
        }

        // Email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(data.email.toString())) {
          alert('Please enter a valid email address.');
          return;
        }

        // Show loading
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Sending...';
        submitBtn.disabled = true;

        try {
          // Send to backend (simulated)
          const response = await fetch('/api/lgpd-request', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              ...data,
              timestamp: new Date().toISOString(),
              lang: 'en'
            })
          });

          if (response.ok) {
            alert('Request sent successfully! You will receive confirmation via email within 24 hours.');
            form.reset();
          } else {
            throw new Error('Error sending request');
          }
        } catch (error) {
          console.error('Error submitting GDPR request:', error);
          alert('Error sending request. Please try again or contact us directly via email.');
        } finally {
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      });
    }
  });
</script>
</Layout>
