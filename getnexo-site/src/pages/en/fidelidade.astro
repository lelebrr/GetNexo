---
import Layout from '../../layouts/Layout.astro';
const title = "GetNexo Loyalty System - Transform Customers into Fans";
const description = "Native points, rewards and gamification system to transform occasional customers into passionate fans.";
const keywords = "loyalty system, points, rewards, gamification, customer retention";
---

<Layout title={title} description={description} keywords={keywords}>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-badge">🎁 Loyalty System</div>
      <h1>Transform Customers into Passionate Fans</h1>
      <p>Native points, rewards and gamification system integrated with WhatsApp. Increase retention and engagement with your customers.</p>
      <div class="hero-features">
        <span>✅ Automatic scoring</span>
        <span>✅ Redemption in chat</span>
        <span>✅ Gamification</span>
      </div>
      <div class="hero-ctas">
        <a href="/en/criar-bot" class="btn-primary">Implement Loyalty</a>
        <a href="/contato" class="btn-secondary">Talk to Experts</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="loyalty-dashboard">
        <div class="dashboard-header">🏆 Loyalty System</div>
        <div class="loyalty-stats">
          <div class="stat-item">
            <div class="stat-value">1.250</div>
            <div class="stat-label">Points Accumulated</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">3</div>
            <div class="stat-label">Rewards Redeemed</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">Level 5</div>
            <div class="stat-label">Current Level</div>
          </div>
        </div>
        <div class="rewards-list">
          <div class="reward-item">
            <span class="reward-icon">🎁</span>
            <span class="reward-name">10% OFF Coupon</span>
            <span class="reward-points">500 pts</span>
          </div>
          <div class="reward-item">
            <span class="reward-icon">📦</span>
            <span class="reward-name">Free Shipping</span>
            <span class="reward-points">800 pts</span>
          </div>
          <div class="reward-item">
            <span class="reward-icon">⭐</span>
            <span class="reward-name">Surprise Gift</span>
            <span class="reward-points">1.500 pts</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="section-header">
      <h2>System Features</h2>
      <p>Complete to transform customers into fans</p>
    </div>

    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🎯</div>
        <h3>Automatic Scoring</h3>
        <p>Accumulate points automatically with each purchase, interaction and recommendation.</p>
        <ul class="feature-list">
          <li>✅ By purchase value</li>
          <li>✅ By chat interaction</li>
          <li>✅ By referrals</li>
          <li>✅ By reviews</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">🎁</div>
        <h3>Smart Rewards</h3>
        <p>Create personalized rewards that encourage specific behaviors.</p>
        <ul class="feature-list">
          <li>✅ Discount coupons</li>
          <li>✅ Free shipping</li>
          <li>✅ Exclusive gifts</li>
          <li>✅ Early access</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">🎮</div>
        <h3>Gamification</h3>
        <p>Levels, badges and challenges that keep customers engaged and motivated.</p>
        <ul class="feature-list">
          <li>✅ Level system</li>
          <li>✅ Exclusive badges</li>
          <li>✅ Weekly challenges</li>
          <li>✅ Customer ranking</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">📱</div>
        <h3>Redemption in Chat</h3>
        <p>Customers redeem rewards directly in WhatsApp, without leaving the chat.</p>
        <ul class="feature-list">
          <li>✅ Simple commands</li>
          <li>✅ Automatic confirmation</li>
          <li>✅ Notifications</li>
          <li>✅ Complete history</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>Loyalty Analytics</h3>
        <p>Monitor engagement, retention and ROI of the loyalty program.</p>
        <ul class="feature-list">
          <li>✅ Retention rate</li>
          <li>✅ Customer value</li>
          <li>✅ Points redeemed</li>
          <li>✅ Program ROI</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">🔗</div>
        <h3>Total Integration</h3>
        <p>Connect with your CRM, e-commerce and payment systems.</p>
        <ul class="feature-list">
          <li>✅ Automatic synchronization</li>
          <li>✅ Webhooks</li>
          <li>✅ REST API</li>
          <li>✅ Payment integration</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works-section">
    <div class="section-header">
      <h2>How It Works</h2>
      <p>Complete flow of the loyalty system</p>
    </div>

    <div class="steps-grid">
      <div class="step-card">
        <div class="step-number">1</div>
        <div class="step-icon">🛒</div>
        <h3>Customer Buys</h3>
        <p>Customer makes a purchase and accumulates points automatically.</p>
      </div>

      <div class="step-card">
        <div class="step-number">2</div>
        <div class="step-icon">📱</div>
        <h3>Notification in Chat</h3>
        <p>Customer receives notification in WhatsApp with accumulated points.</p>
      </div>

      <div class="step-card">
        <div class="step-number">3</div>
        <div class="step-icon">🎯</div>
        <h3>Reward Redemption</h3>
        <p>Customer chooses reward and redeems directly in chat.</p>
      </div>

      <div class="step-card">
        <div class="step-number">4</div>
        <div class="step-icon">🎉</div>
        <h3>Loyal Customer</h3>
        <p>Customer becomes a passionate fan and continues buying.</p>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="benefits-section">
    <div class="section-header">
      <h2>Program Benefits</h2>
      <p>Why invest in loyalty</p>
    </div>

    <div class="benefits-grid">
      <div class="benefit-card">
        <div class="benefit-icon">📈</div>
        <h3>+40% Retention</h3>
        <p>Loyal customers buy more and more frequently.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">💰</div>
        <h3>+3x LTV</h3>
        <p>Customer value over time increases significantly.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">🌟</div>
        <h3>+60% Engagement</h3>
        <p>Customers interact more with your brand.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">🎯</div>
        <h3>+50% Recommendations</h3>
        <p>Loyal customers recommend your brand to friends.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">🔄</div>
        <h3>-30% CAC</h3>
        <p>Reduction in customer acquisition cost.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">📊</div>
        <h3>Valuable Insights</h3>
        <p>Understand customer behavior and preferences.</p>
      </div>
    </div>
  </section>

  <!-- Examples -->
  <section class="examples-section">
    <div class="section-header">
      <h2>Reward Examples</h2>
      <p>Ideas for your loyalty program</p>
    </div>

    <div class="examples-grid">
      <div class="example-card">
        <div class="example-icon">🛍️</div>
        <h3>E-commerce</h3>
        <ul class="example-list">
          <li>✅ 10% OFF Coupon</li>
          <li>✅ Free Shipping</li>
          <li>✅ Surprise gift</li>
          <li>✅ Early access</li>
        </ul>
      </div>

      <div class="example-card">
        <div class="example-icon">☕</div>
        <h3>Café & Restaurant</h3>
        <ul class="example-list">
          <li>✅ Free coffee</li>
          <li>✅ 50% OFF Meal</li>
          <li>✅ Special combo</li>
          <li>✅ VIP table</li>
        </ul>
      </div>

      <div class="example-card">
        <div class="example-icon">💇</div>
        <h3>Services</h3>
        <ul class="example-list">
          <li>✅ Free cuts</li>
          <li>✅ 50% OFF Treatment</li>
          <li>✅ Service upgrade</li>
          <li>✅ VIP time slot</li>
        </ul>
      </div>

      <div class="example-card">
        <div class="example-icon">🎓</div>
        <h3>Education</h3>
        <ul class="example-list">
          <li>✅ Extra class</li>
          <li>✅ Free material</li>
          <li>✅ Mentoring</li>
          <li>✅ Certificate</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section">
    <div class="section-header">
      <h2>Loyalty Plans</h2>
      <p>Choose the ideal plan for your business</p>
    </div>

    <div class="pricing-cards">
      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Starter</h3>
          <div class="price">$47<span>/month</span></div>
          <p>For small businesses</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Basic points system</li>
          <li>✅ 3 rewards</li>
          <li>✅ Chat redemption</li>
          <li>✅ Simple dashboard</li>
        </ul>
        <a href="/en/criar-bot" class="pricing-cta">Start Starter</a>
      </div>

      <div class="pricing-card featured">
        <div class="pricing-badge">Most Popular</div>
        <div class="pricing-header">
          <h3>Professional</h3>
          <div class="price">$97<span>/month</span></div>
          <p>For growing businesses</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Everything from Starter</li>
          <li>✅ Complete gamification</li>
          <li>✅ 10 rewards</li>
          <li>✅ Advanced analytics</li>
          <li>✅ Integrations</li>
        </ul>
        <a href="/en/criar-bot" class="pricing-cta">Choose Professional</a>
      </div>

      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Enterprise</h3>
          <div class="price">$197<span>/month</span></div>
          <p>For large enterprises</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Everything from Professional</li>
          <li>✅ Unlimited rewards</li>
          <li>✅ Custom programs</li>
          <li>✅ Guaranteed SLA</li>
          <li>✅ Consultancy</li>
        </ul>
        <a href="/contato" class="pricing-cta">Talk to Sales</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="section-header">
      <h2>Frequently Asked Questions</h2>
    </div>

    <div class="faq-list">
      <details class="faq-item">
        <summary>How does automatic scoring work?</summary>
        <div class="faq-answer">
          <p>Configure scoring rules: "$1 = 1 point", "Purchase above $100 = +50 points", "Referral = +100 points". The AI calculates automatically.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Can I create personalized rewards?</summary>
        <div class="faq-answer">
          <p>Yes! Create unlimited rewards with different values, conditions and redemption rules.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>How do customers redeem rewards?</summary>
        <div class="faq-answer">
          <p>Type "redeem" in chat, choose the reward and confirm. Everything done directly in WhatsApp.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Can I integrate with my e-commerce?</summary>
        <div class="faq-answer">
          <p>Yes! Full integration with Shopify, WooCommerce, VTEX and custom systems via API.</p>
        </div>
      </details>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="final-cta">
    <div class="cta-content">
      <h2>Start Loyalty Today</h2>
      <p>Transform occasional customers into passionate fans. Results in 30 days.</p>
      <a href="/en/criar-bot" class="btn-primary-large">Implement Loyalty →</a>
    </div>
  </section>
</Layout>

<style>
  .hero-section { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; padding: 8rem 5%; max-width: 1400px; margin: 0 auto; align-items: center; }
  .hero-badge { background: rgba(0, 212, 255, 0.1); color: #00d4ff; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.9rem; font-weight: 600; display: inline-block; margin-bottom: 2rem; }
  .hero-content h1 { font-size: 3rem; font-weight: 900; margin-bottom: 1.5rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .hero-content p { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 2rem; line-height: 1.6; }
  .hero-features { display: flex; gap: 1rem; margin-bottom: 3rem; flex-wrap: wrap; }
  .hero-features span { background: rgba(0, 255, 157, 0.1); color: #00ff9d; padding: 0.5rem 1rem; border-radius: 15px; font-size: 0.9rem; font-weight: 600; }
  .hero-ctas { display: flex; gap: 1.5rem; }
  .btn-primary { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1rem 2rem; border-radius: 12px; font-weight: 800; text-decoration: none; transition: 0.3s; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0, 212, 255, 0.3); }
  .btn-secondary { border: 1px solid rgba(255,255,255,0.3); color: white; padding: 1rem 2rem; border-radius: 12px; font-weight: 600; text-decoration: none; transition: 0.3s; }
  .btn-secondary:hover { background: rgba(255,255,255,0.1); }

  .loyalty-dashboard { background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2rem; }
  .dashboard-header { font-size: 1.2rem; font-weight: 800; color: #00d4ff; margin-bottom: 2rem; text-align: center; }
  .loyalty-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem; }
  .stat-item { text-align: center; background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 10px; }
  .stat-value { font-size: 1.5rem; font-weight: 900; color: #00ff9d; }
  .stat-label { font-size: 0.8rem; color: #94a3b8; }
  .rewards-list { display: flex; flex-direction: column; gap: 0.8rem; }
  .reward-item { display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.05); padding: 0.8rem; border-radius: 10px; }
  .reward-icon { font-size: 1.5rem; }
  .reward-name { color: white; font-weight: 600; }
  .reward-points { color: #00ff9d; font-weight: 700; }

  .features-section { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .feature-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 3rem; text-align: center; transition: 0.3s; }
  .feature-card:hover { transform: translateY(-10px); border-color: rgba(0, 212, 255, 0.3); }
  .feature-icon { font-size: 3rem; margin-bottom: 1.5rem; }
  .feature-card h3 { color: white; font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; }
  .feature-card p { color: #e2e8f0; line-height: 1.6; margin-bottom: 1.5rem; }
  .feature-list { list-style: none; text-align: left; }
  .feature-list li { color: #e2e8f0; margin-bottom: 0.5rem; }

  .how-it-works-section { padding: 8rem 5%; }
  .steps-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .step-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2.5rem; text-align: center; }
  .step-number { font-size: 2rem; font-weight: 900; color: #00d4ff; margin-bottom: 1rem; }
  .step-icon { font-size: 3rem; margin-bottom: 1rem; }
  .step-card h3 { color: white; font-size: 1.3rem; margin-bottom: 1rem; }
  .step-card p { color: #e2e8f0; line-height: 1.6; }

  .benefits-section { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .benefit-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2.5rem; text-align: center; }
  .benefit-icon { font-size: 3rem; margin-bottom: 1rem; }
  .benefit-card h3 { color: white; font-size: 1.3rem; margin-bottom: 1rem; }
  .benefit-card p { color: #e2e8f0; line-height: 1.6; }

  .examples-section { padding: 8rem 5%; }
  .examples-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .example-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2.5rem; text-align: center; }
  .example-icon { font-size: 3rem; margin-bottom: 1rem; }
  .example-card h3 { color: white; font-size: 1.3rem; margin-bottom: 1rem; }
  .example-list { list-style: none; text-align: left; }
  .example-list li { color: #e2e8f0; margin-bottom: 0.5rem; }

  .pricing-section { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .pricing-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .pricing-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 3rem; text-align: center; position: relative; }
  .pricing-card.featured { border-color: #00d4ff; box-shadow: 0 0 30px rgba(0, 212, 255, 0.2); }
  .pricing-badge { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: #00d4ff; color: black; padding: 0.5rem 1rem; border-radius: 15px; font-weight: 800; font-size: 0.8rem; }
  .pricing-header h3 { color: white; font-size: 1.5rem; margin-bottom: 1rem; }
  .price { font-size: 3rem; font-weight: 900; color: #00ff9d; }
  .price span { font-size: 1rem; color: #94a3b8; }
  .pricing-features { list-style: none; text-align: left; margin: 2rem 0; }
  .pricing-features li { color: #e2e8f0; margin-bottom: 0.8rem; }
  .pricing-cta { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1rem 2rem; border-radius: 12px; font-weight: 800; text-decoration: none; display: inline-block; margin-top: 2rem; }

  .faq-section { padding: 8rem 5%; max-width: 800px; margin: 0 auto; }
  .faq-list { margin-top: 4rem; }
  .faq-item { border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; margin-bottom: 1rem; overflow: hidden; }
  .faq-item summary { padding: 1.5rem; background: rgba(15, 23, 42, 0.6); color: white; font-weight: 600; cursor: pointer; }
  .faq-item summary:hover { background: rgba(15, 23, 42, 0.8); }
  .faq-answer { padding: 0 1.5rem 1.5rem; color: #e2e8f0; line-height: 1.6; }

  .final-cta { padding: 8rem 5%; background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 255, 157, 0.1)); text-align: center; }
  .cta-content h2 { font-size: 3rem; font-weight: 900; margin-bottom: 1.5rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .cta-content p { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 3rem; }
  .btn-primary-large { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1.5rem 3rem; border-radius: 15px; font-weight: 900; font-size: 1.2rem; text-decoration: none; transition: 0.3s; }
  .btn-primary-large:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(0, 212, 255, 0.4); }

  .section-header { text-align: center; margin-bottom: 4rem; }
  .section-header h2 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .section-header p { color: #e2e8f0; font-size: 1.1rem; }

  @media (max-width: 900px) {
    .hero-section { grid-template-columns: 1fr; text-align: center; }
    .loyalty-stats { grid-template-columns: 1fr; }
  }
</style>
