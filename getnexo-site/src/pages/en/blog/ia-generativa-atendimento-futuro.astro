---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Generative AI Support: The End of Queues",
      "description": "End waiting lines and drastically reduce costs with AI.",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Innovation"
    }
  ]
};
---
<Layout
  title="Generative AI Support: The End of Queues | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <header class="post-header">
      <div class="meta">Innovation • Jan 2026</div>
      <h1>Generative AI Support:<br/><span class="text-primary">The End of Queues</span></h1>
      <p class="subtitle">End waiting lines and drastically reduce costs with AI.</p>
    </header>
    <div class="post-content">
      <p>Waiting is the #1 reason for customer dissatisfaction. Generative AI resolves 80% of issues instantly.</p>
      <a href="/en/create-bot" class="btn-primary">Get Started</a>
    </div>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
