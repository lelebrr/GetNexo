---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Immersive Ecommerce: 360°, AR, and VR Strategies",
      "description": "Transform your ecommerce with immersive experiences.",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Spatial Commerce"
    }
  ]
};
---
<Layout
  title="360 Image, AR, and VR: The Ultimate Ecommerce Guide | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <header class="post-header">
      <div class="meta">Spatial Commerce • Jan 2026</div>
      <h1>Immersive Ecommerce:<br/><span class="text-primary">360°, AR, and VR Strategies</span></h1>
      <p class="subtitle">Transform your ecommerce with immersive experiences.</p>
    </header>
    <div class="post-content">
      <p>Seeing is believing. Immersive tech reduces returns and increases conversion by giving customers a real feel for the product.</p>
      <a href="/en/create-bot" class="btn-primary">Learn Immersive</a>
    </div>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
