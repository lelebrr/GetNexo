---

<Layout title={pageTitle} description={pageDescription}>
  <div class="blog-index-page">
    <header class="blog-header">
      <div class="custom-container">
        <span class="header-badge animate-fade-in">Strategies & Insights</span>
        <h1 class="hero-title animate-title">GetNexo <span class="text-gradient">Blog</span></h1>
        <p class="hero-subtitle animate-fade-in delay-200">
          Learn to scale your operation with AI, advanced automation, and high-performance WhatsApp traffic.
        </p>
      </div>
    </header>

    <main class="blog-main">
      <div class="custom-container">
        <div class="blog-grid">
          {posts.map(post => (
            <article class:list={["blog-card glass-panel", { "featured": post.featured }]}>
              <div class="card-content">
                <div class="card-meta">
                  <span class="card-category">{post.category}</span>
                  <span class="card-date">{post.date}</span>
                </div>
                <h2><a href={`/en/blog/${post.slug}`}>{post.title}</a></h2>
                <p>{post.excerpt}</p>
                <a href={`/en/blog/${post.slug}`} class="read-more">
                  Read Article <span class="arrow">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
/* Reusing styles from original blog/index.astro */
  .blog-index-page { background: #030712; min-height: 100vh; padding-bottom: 8rem; }
  .custom-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .blog-header { padding: 10rem 0 6rem; text-align: center; }
  .header-badge { background: rgba(0, 212, 255, 0.1); color: #00d4ff; padding: 0.5rem 1.2rem; border-radius: 50px; font-size: 0.85rem; font-weight: 700; display: inline-block; margin-bottom: 2rem; }
  .hero-title { font-size: 4rem; font-weight: 800; margin-bottom: 1.5rem; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; }
  .blog-card { padding: 2.5rem; display: flex; flex-direction: column; justify-content: space-between; height: 100%; transition: 0.4s; }
  .blog-card:hover { transform: translateY(-8px); border-color: #00d4ff; }
  .card-meta { display: flex; justify-content: space-between; margin-bottom: 1.5rem; }
  .card-category { font-size: 0.75rem; font-weight: 800; color: #00ff9d; }
  .card-date { font-size: 0.8rem; color: #64748b; }
  .blog-card h2 { font-size: 1.6rem; font-weight: 800; margin-bottom: 1rem; }
  .blog-card h2 a { color: white; text-decoration: none; }
  .blog-card p { color: #94a3b8; line-height: 1.6; margin-bottom: 2rem; }
  .read-more { font-weight: 700; color: #fff; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; }
</style>
