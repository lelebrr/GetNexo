---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Reducing CPL: AI Qualification Secrets",
      "description": "How to automatically qualify leads and reduce your acquisition costs.",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Performance"
    }
  ]
};
---
<Layout
  title="Reducing CPL with AI Qualification | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <header class="post-header">
      <div class="meta">Performance • Jan 2026</div>
      <h1>Reducing CPL:<br/><span class="text-primary">AI Qualification Secrets</span></h1>
      <p class="subtitle">How to automatically qualify leads and reduce your acquisition costs.</p>
    </header>
    <div class="post-content">
      <p>Lower acquisition costs by filtering leads before they talk to a human. Save money and time.</p>
      <a href="/en/create-bot" class="btn-primary">Optimize Now</a>
    </div>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
