<!-- Modals & Scripts -->
<script nonce={Astro.locals.nonce} is:inline src="/custom/js/hero-animations.js"></script>
<script nonce={Astro.locals.nonce} is:inline>
  // Carregamento dinâmico de scripts de demonstração para otimizar performance
  (function() {
    'use strict';
    
    function loadDemoScripts() {
      if (!window.getNexoState || window.getNexoState.scriptsLoaded || window.getNexoState.scriptsLoading) return;
      
      window.getNexoState.scriptsLoading = true;
      
      const scripts = [
        '/custom/js/mega-chat-sim.js',
        '/custom/js/modals-demo.js',
        '/custom/js/click-fireworks.js'
      ];
      
      const currentNonce = document.querySelector('script[nonce]')?.nonce || '';
      
      scripts.forEach(src => {
        const script = document.createElement('script');
        script.src = src;
        script.defer = true;
        if (currentNonce) script.setAttribute('nonce', currentNonce);
        document.head.appendChild(script);
      });
      
      window.getNexoScriptsLoaded = true;
    }
    
    document.addEventListener('click', (e) => {
      const target = e.target.closest('#hero-demo-btn, #chat-fab, [data-open-modal]');
      if (target) {
        loadDemoScripts();
        if (target.dataset.openModal === 'demo' && typeof window.abrirModalDemo === 'function') {
           window.abrirModalDemo();
        }
      }
    }, { passive: true });
    
    setTimeout(() => {
      if (!window.getNexoScriptsLoaded) loadDemoScripts();
    }, 5000);
  })();
</script>

