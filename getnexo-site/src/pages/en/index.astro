---
import Layout from '../../layouts/Layout.astro';
import VideoDemo from '../../components/VideoDemo.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import Testimonials from '../../components/Testimonials.astro';
import TourGuided from '../../components/TourGuided.astro';
import { verificaDataVariavel } from '../../lib/feriados.js';
import '../../styles/index-premium.css';

const title = "WhatsApp AI Chatbot for Sales 24h | Official Meta API | GetNexo";
const description = "Automate your WhatsApp sales with Generative AI. Official Meta API, native PIX, intelligent CRM and Analytics. Increase your conversion by up to 10x without monthly fees.";
const keywords = "whatsapp chatbot sales, ai for whatsapp, whatsapp automation sales, official whatsapp business api, chatbot with pix, crm for whatsapp, artificial intelligence sales assistant, whatsapp chatbot free, recover abandoned whatsapp cart, whatsapp auto-hosted chatbot";

const lang = 'en';
const { default: t } = await import(`../../i18n/en.json`);

import feriadosData from '../../data/feriados.json';

const hoje = new Date().toISOString().slice(0,10);
const idiomaNavegador = typeof navigator !== 'undefined' ? (navigator.language || 'en-US') : 'en-US';
const idiomaCurto = idiomaNavegador.split('-')[0];

const feriadoHoje = feriadosData.feriados.find(f => {
  if (f.data === hoje) return true;
  const anoAtual = new Date().getFullYear();
  const dataCalculada = verificaDataVariavel(f.data, anoAtual);
  return dataCalculada === hoje;
});

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://getnexo.com.br/#organization",
      "name": "GetNexo",
      "url": "https://getnexo.com.br",
      "logo": "https://getnexo.com.br/logo.svg",
      "description": "AI platform for 24h WhatsApp sales. Official Meta API, automatic PIX, integrated CRM.",
      "foundingDate": "2024",
      "sameAs": [
        "https://linkedin.com/company/getnexo",
        "https://instagram.com/getnexo",
        "https://github.com/lelebrr",
        "https://youtube.com/@getnexo",
        "https://tiktok.com/@getnexo"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+55-11-4003-XXXX",
        "contactType": "customer service",
        "availableLanguage": ["Portuguese", "English", "Spanish", "French"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://getnexo.com.br/#website",
      "url": "https://getnexo.com.br",
      "name": "GetNexo - AI for WhatsApp Sales",
      "description": "AI that closes WhatsApp sales 24h. Complete platform with Official Meta API, PIX, CRM, loyalty and analytics.",
      "publisher": { "@id": "https://getnexo.com.br/#organization" },
      "inLanguage": "en-US",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://getnexo.com.br/en/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://getnexo.com.br/#software",
      "name": "GetNexo",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, WhatsApp",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "BRL",
        "priceValidUntil": "2026-12-31",
        "description": "Free plan with advanced features"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "500",
        "bestRating": "5",
        "worstRating": "1"
      },
      "author": { "@id": "https://getnexo.com.br/#organization" }
    },
    {
      "@type": "Service",
      "@id": "https://getnexo.com.br/#service",
      "name": "WhatsApp Sales Automation with AI",
      "description": "Complete WhatsApp sales automation service with advanced artificial intelligence",
      "provider": { "@id": "https://getnexo.com.br/#organization" },
      "serviceType": "Business Automation",
      "areaServed": "Worldwide",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "GetNexo Plans",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Free Plan",
              "description": "Full access to basic features"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Pro Plan",
              "description": "Advanced features and priority support"
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is GetNexo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GetNexo is an AI platform that automates WhatsApp sales 24 hours a day. It uses Official Meta API, automatic PIX, integrated CRM and much more."
          }
        },
        {
          "@type": "Question",
          "name": "How does AI for sales work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our AI is trained with your product catalog and sales history. It naturally converses with customers, answers questions, suggests products and closes sales automatically."
          }
        },
        {
          "@type": "Question",
          "name": "Does GetNexo have PIX integrated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! We have native PIX. The bot generates QR Code or copy-paste code automatically and confirms payments in real time in the conversation."
          }
        },
        {
          "@type": "Question",
          "name": "How much does it cost to use GetNexo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The basic plan is 100% FREE! You only pay a small fee per completed transaction. No monthly fees or long contracts."
          }
        },
        {
          "@type": "Question",
          "name": "What integrations are available?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We integrate with Shopify, WooCommerce, VTEX, Bling, Tiny, PagSeguro, Mercado Pago, Correios, Melhor Envio and much more. Complete REST API available."
          }
        },
        {
          "@type": "Question",
          "name": "Does GetNexo work with Official WhatsApp API?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! We are 100% compatible with Meta's Official API via Evolution API. Zero ban risk, maximum security and compliance."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to set up?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Complete setup in up to 12 minutes! Our platform is self-hosted, you install on your server and start selling immediately."
          }
        },
        {
          "@type": "Question",
          "name": "Is there an integrated loyalty system?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! Complete system of points, tiers, rewards and gamification. Your customers accumulate points automatically and redeem prizes via WhatsApp."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to configure GetNexo in 5 steps",
      "description": "Step-by-step guide to configure your WhatsApp sales AI",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Installation",
          "text": "Install the platform on your server (Docker or manual)"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Connect WhatsApp",
          "text": "Configure the Official WhatsApp Business API"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Configure Catalog",
          "text": "Import your products and set prices"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Train AI",
          "text": "Configure responses and AI behavior"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Activate Sales",
          "text": "Configure PIX, CRM and analytics. Ready to sell!"
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} isLanding={true}>

  <!-- Importar CSS de efeitos festivos se houver feriado hoje -->
  {feriadoHoje && (
    <link rel="stylesheet" href="/custom/css/holiday-effects.css" is:inline />
  )}

  <!-- Aplicar efeito visual ao body se houver feriado hoje -->
  {feriadoHoje && (
    <script nonce={Astro.locals.nonce} is:inline define:vars={{ efeito: feriadoHoje.efeito }}>
      document.body.classList.add(efeito);
    </script>
  )}

  <script nonce={Astro.locals.nonce} type="application/ld+json" is:inline set:html={JSON.stringify(homeSchema)}></script>

  <!-- Modern Hero with 3D Phone Simulation -->
  <section class="hero-split">
    <div class="hero-content">
      <!-- Banner de Feriado -->
      {feriadoHoje && (
        <div class="feriado-banner animate-on-scroll">
          <span class="feriado-emoji">🎉</span>
          <span class="feriado-texto">
            {feriadoHoje.bot_frase.en || feriadoHoje.bot_frase.pt}
          </span>
          <span class="feriado-nome">| {feriadoHoje.idiomas.en || feriadoHoje.idiomas.pt}</span>
        </div>
      )}

      <div class="hero-badge animate-on-scroll">🚀 TRANSFORM YOUR WHATSAPP INTO AN AUTOMATED SALES MACHINE</div>
      <h1 class="hero-title animate-on-scroll">
        <span class="text-gradient-animated">INTELLIGENT AI</span><br/>
        SELLS 24H/DAY WITHOUT NEEDING <span class="no-break">ATTENDANTS</span>
      </h1>
      <p class="hero-subtitle animate-on-scroll">
        <span id="typing-text"></span><span class="cursor">|</span>
      </p>
      <div class="hero-ctas animate-on-scroll">
        <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow">START NOW FOR FREE</a>
        <button data-open-modal="demo" class="btn-surprise animate-on-scroll">TEST HERE.. SURPRISE YOURSELF</button>
      </div>
      <div class="hero-trust animate-on-scroll">
        <span>✅ Official Meta API</span>
        <span>✅ Setup in 12min</span>
        <span>✅ Zero Monthly Fee</span>
      </div>

      <!-- Language Selector -->
    </div>

    <div class="hero-visual animate-on-scroll">
        <div class="visual-container">
            <div class="visual-glow"></div>
            <!-- Replacement for potentially broken hologram -->
            <div class="smart-phone-mockup">
                <div class="screen-content">
                    <div class="chat-header-sim">
                        <div class="sim-avatar">N</div>
                        <div class="sim-info">
                            <span class="sim-name">Nexus Smart Bot</span>
                            <span class="sim-status">online</span>
                        </div>
                    </div>
                    <div class="chat-body-mega" id="mega-chat-container">
                        <!-- Conteúdo dinâmico aqui -->
                    </div>
                    <div class="chat-input-sim">
                        <div class="sim-mic">🎤</div>
                        <span>Say something...</span>
                        <div class="sim-audio-icon">🎧</div>
                        <div class="sim-send">🚀</div>
                    </div>
                    <!-- Cursor simulado para o clique RAR -->
                    <div id="sim-finger-cursor" class="sim-finger">☝️</div>
                </div>
            </div>

            <div class="floating-elements">
                <div class="f-pill">💰 Active PIX</div>
                <div class="f-pill">🚀 10x ROI</div>
            </div>
        </div>
    </div>
  </section>

  <!-- Tour Guided Component -->
  <TourGuided slot="dock-left" targetPage="home" mobileOptimized={true} />

  <!-- Value Propositions Grid -->
    <div class="section-header animate-on-scroll">
        <h2 class="text-gradient">The Definitive Infrastructure to Scale Your Sales</h2>
        <p>The only platform that combines Generative AI, Native PIX and Official Meta Automation to transform your Chat into a 24h profit machine.</p>
    </div>

    <div class="grid-cards">
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">🤖</div>
        <h3>Generative Sales AI</h3>
        <p>Virtual agent trained with your catalog that converts leads into profit 24/7 in a humanized way.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Explore AI →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">💰</div>
        <h3>Native Checkout & PIX</h3>
        <p>Fluid purchase experience with automatic PIX generation and confirmation without leaving the chat.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">View Checkout →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">🚀</div>
        <h3>High-Performance Broadcast & Ads</h3>
        <p>Intelligent mass sending and Click-to-WhatsApp Ads with real-time ROI measurement.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Activate Ads →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">👥</div>
        <h3>Strategic Pipeline & CRM</h3>
        <p>360º view of your funnel with multi-agent management and intelligent follow-up automation.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Manage Leads →</a>
      </div>
    </div>

  <!-- Performance Metrics -->
  <section class="metrics-section">
    <div class="metric-card animate-on-scroll">
        <span class="m-val">10x</span>
        <span class="m-label">More Conversion</span>
    </div>
    <div class="metric-card animate-on-scroll">
        <span class="m-val">24/7</span>
        <span class="m-label">Availability</span>
    </div>
    <div class="metric-card animate-on-scroll">
        <span class="m-val">R$ 0</span>
        <span class="m-label">Per Message Fee</span>
    </div>
  </section>

  <!-- Testimonials Section -->
  <Testimonials />

  <!-- ROI Calculator Section -->
  <ROICalculator />

  <!-- Giant Features Showcase -->
  <section class="giant-features">
    <!-- Magic Replies -->
    <div class="giant-feature-row animate-on-scroll">
        <div class="giant-feature-visual">
            <img src="/assets/features/magic-replies.webp" alt="Magic Replies AI" width="501" height="501" class="premium-visual" />
        </div>
        <div class="giant-feature-info">
            <div class="feature-tag">Exclusive</div>
            <h2 class="text-gradient">{t.features_giant.magic_replies.title}</h2>
            <p>{t.features_giant.magic_replies.description}</p>
            <ul class="feature-bullets">
                <li><span>✨</span> {t.features_giant.magic_replies.f1}</li>
                <li><span>🧠</span> {t.features_giant.magic_replies.f2}</li>
                <li><span>📈</span> {t.features_giant.magic_replies.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">Learn about Magic Replies</a>
        </div>
    </div>

    <!-- Loyalty System -->
    <div class="giant-feature-row reverse animate-on-scroll">
        <div class="giant-feature-info">
            <div class="feature-tag gold">Retention</div>
            <h2 class="text-gradient">{t.features_giant.loyalty.title}</h2>
            <p>{t.features_giant.loyalty.description}</p>
            <ul class="feature-bullets">
                <li><span>🏆</span> {t.features_giant.loyalty.f1}</li>
                <li><span>🎁</span> {t.features_giant.loyalty.f2}</li>
                <li><span>❤️</span> {t.features_giant.loyalty.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">View Loyalty</a>
        </div>
        <div class="giant-feature-visual">
            <img src="/assets/features/loyalty.webp" alt="Loyalty System" width="501" height="501" class="premium-visual" />
        </div>
    </div>

    <!-- Analytics -->
    <div class="giant-feature-row animate-on-scroll">
        <div class="giant-feature-visual">
            <img src="/assets/features/analytics.webp" alt="Advanced Analytics" width="501" height="501" class="premium-visual" />
        </div>
        <div class="giant-feature-info">
            <div class="feature-tag blue">Intelligence</div>
            <h2 class="text-gradient">{t.features_giant.analytics.title}</h2>
            <p>{t.features_giant.analytics.description}</p>
            <ul class="feature-bullets">
                <li><span>📊</span> {t.features_giant.analytics.f1}</li>
                <li><span>📝</span> {t.features_giant.analytics.f2}</li>
                <li><span>🌍</span> {t.features_giant.analytics.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">Explore Data</a>
        </div>
    </div>

    <!-- Integrations -->
    <div class="giant-feature-row reverse animate-on-scroll">
        <div class="giant-feature-info">
            <div class="feature-tag green">Ecosystem</div>
            <h2 class="text-gradient">{t.features_giant.integrations.title}</h2>
            <p>{t.features_giant.integrations.description}</p>
            <ul class="feature-bullets">
                <li><span>🔗</span> {t.features_giant.integrations.f1}</li>
                <li><span>⚙️</span> {t.features_giant.integrations.f2}</li>
                <li><span>📡</span> {t.features_giant.integrations.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.integrations}`} class="btn-outline-glow">View All Integrations</a>
        </div>
        <div class="giant-feature-visual">
            <img src="/assets/features/integrations.webp" alt="Integrations Map" width="501" height="501" class="premium-visual" />
        </div>
    </div>
  </section>

  <!-- Security Section -->
  <section class="security-section">
    <div class="section-header animate-on-scroll">
        <h2 class="text-gradient">🛡️ Maximum Security in GetNexo</h2>
        <p>Protect Your Store and Your Customers with Total Confidence</p>
    </div>

    <div class="security-grid animate-on-scroll">
      <div class="security-card glass-panel">
        <div class="security-icon">🛡️</div>
        <h3>Cloudflare Shield</h3>
        <p>DDoS protection, Advanced Firewall (WAF) and Bot Management. Your store protected like the world's largest.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">🔐</div>
        <h3>AES Encryption</h3>
        <p>LGPD-compliant AES-256 encryption. 100% LGPD compliance. Zero unnecessary storage.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">🚪</div>
        <h3>Zero Trust Network</h3>
        <p>Cloudflare Tunnel with Zero Trust. No open ports on the server. Outbound connection only.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">⏰</div>
        <h3>24h Monitoring</h3>
        <p>Intelligent Rate Limiting, real-time threat detection and automated secure backups.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">💳</div>
        <h3>Secure PIX</h3>
        <p>Direct integration with trusted gateways. Validated and encrypted QR Code in real time.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">✅</div>
        <h3>99.99% Uptime</h3>
        <p>Your store never goes offline. No breach history. Automatic updates.</p>
      </div>
    </div>

    <div class="security-cta animate-on-scroll">
        <p class="security-notice">💡 WhatsApp Business security is not a luxury — it's a necessity.</p>
        <p class="security-benefit">With GetNexo, you have enterprise-level protection without complication or exorbitant cost.</p>
        <div class="security-actions">
            <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow security-btn">Test Free Now →</a>
            <button data-open-modal="demo" class="btn-outline security-btn">View Certifications</button>
        </div>
        <p class="security-footer">© 2026 GetNexo. All rights reserved. | GetNexo: The vanguard in WhatsApp Automation and AI for Business.</p>
    </div>
  </section>

  <!-- Final Squeeze -->
  <section class="final-cta animate-on-scroll">
    <div class="glass-panel cta-box p-12 text-center">
        <h2 class="text-gradient text-4xl font-black mb-6">Ready to Dominate WhatsApp with AI?</h2>
        <p class="text-xl text-gray-400 mb-8 max-w-2xl mx-auto">
            Dominate WhatsApp with the most robust infrastructure on the market. 💡 WhatsApp Business security is not a luxury — it's a necessity. Activate your AI in less than 10 minutes.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
            <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow">START NOW FOR FREE</a>
            <button data-open-modal="demo" class="btn-outline">TEST AI DEMO</button>
        </div>
    </div>
  </section>




<!-- Modal Demo IA Redesigned -->
<div id="demo-modal" class="fixed inset-0 hidden z-[9999] flex items-center justify-center bg-black/90 backdrop-blur-xl" style="display: none;">
  <div class="bg-void-black border border-white/10 rounded-[2rem] p-8 w-full max-w-4xl shadow-2xl relative overflow-hidden">
    <!-- Background Glows -->
    <div class="absolute -top-24 -left-24 w-64 h-64 bg-neon-blue/20 blur-[100px] pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-64 h-64 bg-matrix-green/20 blur-[100px] pointer-events-none"></div>

    <div class="flex justify-between items-start mb-8 relative z-10">
      <div>
        <h3 class="text-3xl font-extrabold text-white mb-2">Choose Your Experience</h3>
        <p class="text-gray-400">Transform your service with the power of GetNexo AI</p>
      </div>
      <button onclick="closeModalDemo()" class="text-white/50 hover:text-white transition-all text-4xl">&times;</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
      <!-- Option 1 -->
      <div onclick="openModalChat()" class="group relative p-6 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 hover:border-neon-blue/50 transition-all cursor-pointer overflow-hidden">
        <div class="text-3xl mb-4 group-hover:scale-110 transition-transform">💬</div>
        <h4 class="text-xl font-bold text-white mb-2">Complete AI Chat</h4>
        <p class="text-sm text-gray-400">Demonstration of fluid and natural conversation.</p>
        <div class="mt-4 text-neon-blue text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity">View Demo →</div>
      </div>

      <!-- Option 2 -->
      <div onclick="openModalIA()" class="group relative p-6 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 hover:border-cyber-gold/50 transition-all cursor-pointer overflow-hidden">
        <div class="text-3xl mb-4 group-hover:scale-110 transition-transform">🤖</div>
        <h4 class="text-xl font-bold text-white mb-2">Multimídia AI</h4>
        <p class="text-sm text-gray-400">Products, cards and immersive experiences.</p>
        <div class="mt-4 text-cyber-gold text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity">View Demo →</div>
      </div>

      <!-- Option 3 -->
      <div onclick="window.open('https://wa.me/5511999999999', '_blank')" class="group relative p-6 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 hover:border-matrix-green/50 transition-all cursor-pointer overflow-hidden">
        <div class="text-3xl mb-4 group-hover:scale-110 transition-transform">📱</div>
        <h4 class="text-xl font-bold text-white mb-2">WhatsApp Demo</h4>
        <p class="text-sm text-gray-400">The real experience in the official app.</p>
        <div class="mt-4 text-matrix-green text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity">Open Whats →</div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Chat Completo -->
