---
import Layout from '../../layouts/Layout.astro';

// SEO Meta Tags
const title = "GetNexo Store - Advanced Implementations | 360° Image, AR, Voice & More!";
const description = "Discover GetNexo's advanced implementations: 360° Image, Augmented Reality, Voice Commands, Intelligent Chatbots and much more. Transform your online store!";
const keywords = "getnexo store, advanced implementations, 360 image, augmented reality, voice commands, chatbot store, intelligent e-commerce";
const canonical = "https://getnexo.com.br/en/loja";

// Structured Data - Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "logo": "https://getnexo.com.br/logo.png",
  "sameAs": [
    "https://www.linkedin.com/company/getnexo",
    "https://twitter.com/getnexo",
    "https://github.com/getnexo"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+5511999999999",
    "contactType": "customer service",
    "areaServed": "BR",
    "availableLanguage": "en-US"
  }
};

// WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://getnexo.com.br/buscar?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getnexo.com.br"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Store",
      "item": "https://getnexo.com.br/en/loja"
    }
  ]
};

// Product Schema
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "GetNexo - Intelligent Store",
  "description": "Complete virtual store system with AI, 360° image, AR and voice commands",
  "brand": {
    "@type": "Brand",
    "name": "GetNexo"
  },
  "offers": {
    "@type": "Offer",
    "price": "97",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "US",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnPeriod",
      "merchantReturnDays": 7,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": 0,
        "currency": "USD"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 0,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 0,
          "unitCode": "DAY"
        }
      }
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "5000"
  }
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is 360° image in WhatsApp?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "360° image allows customers to view the product from all angles directly in WhatsApp, increasing confidence and reducing returns."
      }
    },
    {
      "@type": "Question",
      "name": "How does Augmented Reality work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Customers can visualize the product in their environment using their phone camera, seeing how it would look in their home or office."
      }
    },
    {
      "@type": "Question",
      "name": "Does voice command work in English?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! The system recognizes commands in English, allowing customers to search products, add to cart and complete purchases with voice."
      }
    }
  ]
};

// Features data
const features = [
  {
    icon: "📸",
    title: "Interactive 360° Image",
    desc: "View products from all angles directly in WhatsApp",
    benefits: [
      "Increases customer confidence",
      "Reduces returns by 40%",
      "Improves shopping experience",
      "Simple integration"
    ],
    stats: ["+40% conversion", "-40% returns", "95% satisfaction"]
  },
  {
    icon: "👓",
    title: "Augmented Reality",
    desc: "See the product in your environment before buying",
    benefits: [
      "Real-scale visualization",
      "Color and size testing",
      "Camera integration",
      "No extra app needed"
    ],
    stats: ["+60% confidence", "-30% doubts", "4.8/5 rating"]
  },
  {
    icon: "🎤",
    title: "Voice Command",
    desc: "Search and buy using only your voice",
    benefits: [
      "English recognition",
      "Hands-free navigation",
      "Full accessibility",
      "Alexa/Google integration"
    ],
    stats: ["+50% usage", "99% accuracy", "Accessible"]
  },
  {
    icon: "🤖",
    title: "Intelligent Chatbot",
    desc: "24/7 support with specialized AI",
    benefits: [
      "Instant responses",
      "Personalized recommendations",
      "After-sales support",
      "CRM integration"
    ],
    stats: ["24/7 availability", "95% resolved", "4.9/5 satisfaction"]
  },
  {
    icon: "💳",
    title: "Smart Checkout",
    desc: "Complete purchases with one click in WhatsApp",
    benefits: [
      "Automatic payment",
      "Saved cards",
      "Calculated shipping",
      "Instant confirmation"
    ],
    stats: ["+35% conversion", "2min checkout", "99% success"]
  },
  {
    icon: "📊",
    title: "Advanced Analytics",
    desc: "Track everything in real-time",
    benefits: [
      "Complete dashboard",
      "Customer behavior",
      "A/B testing",
      "Automatic reports"
    ],
    stats: ["+25% optimization", "Real-time data", "Measurable ROI"]
  }
];

// Use cases data
const useCases = [
  {
    title: "Fashion E-commerce",
    desc: "View clothes in 360° and try with AR",
    results: ["+50% conversion", "-35% returns", "4.9/5 satisfaction"]
  },
  {
    title: "Furniture & Decoration",
    desc: "See how it looks in your home with AR",
    results: ["+60% confidence", "-40% doubts", "45% closure"]
  },
  {
    title: "Electronics",
    desc: "Explore details with 360° image and voice",
    results: ["+45% engagement", "2min response", "4.8/5 satisfaction"]
  },
  {
    title: "Food & Beverages",
    desc: "Buy with voice and receive in 2h",
    results: ["+70% recurrence", "Fast delivery", "4.9/5 rating"]
  }
];

// Testimonials data
const testimonials = [
  {
    name: "Maria Silva",
    role: "Founder",
    company: "EasyFashion",
    quote: "The 360° image increased our sales by 50% and reduced returns by half.",
    results: [
      { value: "+50%", label: "sales" },
      { value: "-50%", label: "returns" },
      { value: "4.9", label: "satisfaction" }
    ]
  },
  {
    name: "John Santos",
    role: "CEO",
    company: "Modern Furniture",
    quote: "AR transformed our store. Customers see the furniture at home before buying.",
    results: [
      { value: "+60%", label: "confidence" },
      { value: "-40%", label: "doubts" },
      { value: "45%", label: "closure" }
    ]
  }
];

// Stats data
const stats = [
  { value: "50+", label: "implementations", desc: "available" },
  { value: "99%", label: "accuracy", desc: "recognition" },
  { value: "24/7", label: "support", desc: "in English" },
  { value: "Free", label: "setup", desc: "no card" }
];

// Trust badges
const trustBadges = [
  { icon: "📸", title: "360° Image", desc: "Interactive" },
  { icon: "👓", title: "Augmented Reality", desc: "AR" },
  { icon: "🎤", title: "Voice Command", desc: "English" },
  { icon: "🤖", title: "AI Chatbot", desc: "Intelligent" }
];
---

<Layout title={title} description={description} keywords={keywords}>

  <!-- SEO Schemas -->
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="loja-hero" aria-label="GetNexo Store">
    <div class="hero-badge">🚀 Advanced Implementations</div>
    <h1><span class="text-gradient">Smart</span> Store with AI</h1>
    <p class="hero-desc">
      Transform your virtual store with <strong>cutting-edge technologies</strong>: 360° Image, Augmented Reality, Voice Commands and Intelligent Chatbots. <strong>Increase sales by 50%+</strong> and offer a unique experience!
    </p>

    <!-- Trust Badges -->
    <div class="trust-badges">
      {trustBadges.map(badge => (
        <div class="trust-badge">
          <span class="trust-icon">{badge.icon}</span>
          <div>
            <strong>{badge.title}</strong>
            <span>{badge.desc}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-ctas">
      <a href="/en/criar-bot" class="btn-primary-glow" aria-label="Create smart store">
        Create Smart Store
      </a>
      <a href="/contato" class="btn-outline" aria-label="See demo">
        See Demo
      </a>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="max-w-6xl mx-auto px-5">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map(stat => (
          <div class="stat-card glass-panel p-6 text-center">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-desc">{stat.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4"><span class="text-gradient">Advanced</span> Implementations</h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Cutting-edge technologies to transform your virtual store</p>
      </div>

      <div class="features-grid">
        {features.map(feature => (
          <div class="feature-card glass-panel p-8 rounded-3xl">
            <div class="feature-icon">{feature.icon}</div>
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-desc">{feature.desc}</p>
            <ul class="feature-benefits">
              {feature.benefits.map(benefit => (
                <li class="benefit-item">
                  <span class="benefit-check">✓</span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
            <div class="feature-stats">
              {feature.stats.map(stat => (
                <span class="stat-tag">{stat}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="use-cases-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4"><span class="text-gradient">Use</span> Cases</h2>
        <p class="text-slate-400 max-w-2xl mx-auto">See how different segments are using our smart store</p>
      </div>

      <div class="use-cases-grid">
        {useCases.map(useCase => (
          <div class="use-case-card glass-panel p-8 rounded-3xl">
            <h3 class="use-case-title">{useCase.title}</h3>
            <p class="use-case-desc">{useCase.desc}</p>
            <div class="use-case-results">
              {useCase.results.map(result => (
                <span class="result-tag">{result}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4"><span class="text-gradient">Client</span> Testimonials</h2>
        <p class="text-slate-400 max-w-2xl mx-auto">What our clients say about the implementations</p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map(testimonial => (
          <div class="testimonial-card glass-panel p-8 rounded-3xl">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <span class="avatar-placeholder">{testimonial.name.charAt(0)}</span>
              </div>
              <div>
                <h3 class="testimonial-name">{testimonial.name}</h3>
                <p class="testimonial-role">{testimonial.role}</p>
                <p class="testimonial-company">{testimonial.company}</p>
              </div>
            </div>
            <blockquote class="testimonial-quote">"{testimonial.quote}"</blockquote>
            <div class="testimonial-results">
              {testimonial.results.map(result => (
                <div class="result-item">
                  <span class="result-value">{result.value}</span>
                  <span class="result-label">{result.label}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="max-w-4xl mx-auto px-5">
      <h2 class="text-center text-3xl font-bold text-white mb-4"><span class="text-gradient">Frequently</span> Asked Questions</h2>
      <p class="text-center text-slate-400 mb-12">Get your questions about advanced implementations</p>
      
      <div class="space-y-4">
        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            What is 360° image in WhatsApp?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            360° image allows customers to view the product from all angles directly in WhatsApp, increasing confidence and reducing returns.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            How does Augmented Reality work?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Customers can visualize the product in their environment using their phone camera, seeing how it would look in their home or office.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            Does voice command work in English?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Yes! The system recognizes commands in English, allowing customers to search products, add to cart and complete purchases with voice.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            Do I need an extra app for AR?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            No! Augmented Reality works directly in the browser, without the need to install additional apps.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            How do I integrate with my current store?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            We offer complete API and plugins for Shopify, WooCommerce, Magento and other platforms. Setup in minutes.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            What is the cost of the implementations?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Start free with the Starter plan. Advanced implementations available in the Pro plan ($97/month) and Enterprise (custom).
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Implementation Guide -->
  <section class="implementation-section py-20 px-5 max-w-6xl mx-auto">
    <div class="glass-panel p-12 rounded-3xl">
      <h2 class="text-3xl font-bold text-white mb-6 text-center"><span class="text-gradient">Implementation</span> Guide</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="step-number">1</div>
          <h3 class="text-xl font-bold text-white mb-2">Choose Features</h3>
          <p class="text-slate-400">Select the implementations you want (360°, AR, Voice, etc.)</p>
        </div>
        <div class="text-center">
          <div class="step-number">2</div>
          <h3 class="text-xl font-bold text-white mb-2">Configure</h3>
          <p class="text-slate-400">Upload images and configure parameters</p>
        </div>
        <div class="text-center">
          <div class="step-number">3</div>
          <h3 class="text-xl font-bold text-white mb-2">Launch</h3>
          <p class="text-slate-400">Activate and monitor conversion increase</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta py-20 text-center px-4">
    <div class="max-w-4xl mx-auto glass-panel p-12 rounded-3xl">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-6">Ready to <span class="text-blue-400">transform</span> your store?</h2>
      <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto">
        Start with GetNexo and offer the best shopping experience in the market.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/en/criar-bot" class="btn-primary-glow bg-blue-600 hover:bg-blue-500" aria-label="Create smart store">
          Create Smart Store
        </a>
        <a href="/contato" class="px-10 py-5 bg-transparent border border-blue-500 text-blue-400 font-bold rounded-2xl hover:bg-blue-500 hover:text-white transition-colors text-lg" aria-label="See demo">
          See Demo
        </a>
      </div>
      <p class="mt-8 text-sm text-slate-500">
        ✅ No credit card required • ✅ Easy cancellation • ✅ Support in English
      </p>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .loja-hero { 
    padding: 8rem 5% 4rem; 
    text-align: center; 
    max-width: 1300px; 
    margin: 0 auto; 
  }
  
  .hero-badge { 
    background: rgba(139, 92, 246, 0.1); 
    color: #8b5cf6; 
    padding: 0.5rem 1.2rem; 
    border-radius: 50px; 
    font-size: 0.85rem; 
    font-weight: 700; 
    border: 1px solid rgba(139, 92, 246, 0.2); 
    display: inline-block; 
    margin-bottom: 2rem; 
  }
  
  .loja-hero h1 { 
    font-size: 3.5rem; 
    margin-bottom: 1.5rem; 
    color: white;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  
  .hero-desc { 
    font-size: 1.35rem; 
    color: #94a3b8; 
    max-width: 900px; 
    margin: 0 auto 3rem; 
    line-height: 1.6;
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
  }
  .trust-icon {
    font-size: 1.5rem;
  }
  .trust-badge strong {
    display: block;
    color: white;
    font-size: 0.9rem;
    margin-bottom: 0.1rem;
  }
  .trust-badge span {
    display: block;
    color: #94a3b8;
    font-size: 0.75rem;
  }

  .hero-ctas {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary-glow { 
    background: linear-gradient(135deg, #3b82f6, #06b6d4); 
    color: white; 
    padding: 1.2rem 2.8rem; 
    border-radius: 14px; 
    font-weight: 800; 
    text-decoration: none; 
    transition: 0.3s; 
    box-shadow: 0 10px 40px rgba(59, 130, 246, 0.25); 
    display: inline-flex; 
    align-items: center; 
    gap: 0.5rem; 
  }
  
  .btn-primary-glow:hover { transform: translateY(-4px); box-shadow: 0 20px 50px rgba(59, 130, 246, 0.4); }

  .btn-outline { 
    border: 1px solid rgba(255,255,255,0.15); 
    color: white; 
    padding: 1.2rem 2.8rem; 
    border-radius: 14px; 
    font-weight: 700; 
    text-decoration: none; 
    background: rgba(255,255,255,0.03); 
    transition: 0.3s; 
  }
  
  .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: #3b82f6; }

  /* Stats Section */
  .stats-section {
    padding: 4rem 5%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .stat-card {
    padding: 2rem;
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 900;
    color: #8b5cf6;
    line-height: 1;
  }

  .stat-label {
    display: block;
    color: white;
    font-weight: 700;
    font-size: 1rem;
    margin-top: 0.3rem;
  }

  .stat-desc {
    display: block;
    color: #64748b;
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }

  /* Features Section */
  .features-section {
    padding: 6rem 5%;
    max-width: 1400px;
    margin: 0 auto;
  }

