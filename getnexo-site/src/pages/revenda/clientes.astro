---
import ResellerLayout from '../../layouts/ResellerLayout.astro';
---

<ResellerLayout title="Meus Clientes">
    <div class="panel-header">
        <h2 class="text-neon-blue">MEUS CLIENTES</h2>
        <a href="/revenda/gerar" class="btn-gold">+ NOVO CLIENTE</a>
    </div>

    <div class="filter-bar">
        <input type="text" id="search-input" placeholder="BUSCAR POR NOME OU DOMÍNIO..." class="search-input">
    </div>

    <div class="table-container">
        <table id="clients-table">
            <thead>
                <tr>
                    <th>NOME</th>
                    <th>DOMÍNIO</th>
                    <th>PLATAFORMA</th>
                    <th>STATUS</th>
                    <th>RECEITA</th>
                    <th>COMISSÃO</th>
                    <th>DATA</th>
                </tr>
            </thead>
            <tbody id="clients-body">
                <tr><td colspan="7" style="text-align:center; padding: 2rem;">CARREGANDO DADOS...</td></tr>
            </tbody>
        </table>
    </div>

</ResellerLayout>

<style>
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .btn-gold { background: #ffd700; color: #000; padding: 0.8rem 1.5rem; text-decoration: none; font-weight: bold; border-radius: 4px; box-shadow: 0 0 10px rgba(255, 215, 0, 0.4); text-transform: uppercase; }
    .btn-gold:hover { background: #ffe44d; }

    .filter-bar { margin-bottom: 1.5rem; }
    .search-input { width: 100%; background: #111; border: 1px solid #333; padding: 1rem; color: #fff; font-family: 'JetBrains Mono', monospace; outline: none; }
    .search-input:focus { border-color: #00f3ff; }

    .table-container { background: #0a0a0a; border: 1px solid #333; border-radius: 4px; overflow: hidden; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 1rem; color: #00f3ff; border-bottom: 1px solid #333; font-size: 0.9rem; }
    td { padding: 1rem; border-bottom: 1px solid #1a1a1a; color: #ccc; }
    tr:hover { background: rgba(0, 243, 255, 0.05); }

    .status-active { color: #00ff41; }
    .status-trial { color: #ffd700; }
</style>

<script nonce={Astro.locals.nonce} is:inline>
    const API_URL = '';
    let allClients = [];

    async function fetchClients() {
        try {
            const token = localStorage.getItem('token');
            const res = await fetch(`${API_URL}/api/revenda/clientes`, { headers: { 'Authorization': token } });
            allClients = await res.json();
            renderTable(allClients);
        } catch (e) {
            console.error(e);
            document.getElementById('clients-body').innerHTML = '<tr><td colspan="7">ERRO AO CARREGAR</td></tr>';
        }
    }

    function renderTable(data) {
        const tbody = document.getElementById('clients-body');
        if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;">NENHUM CLIENTE ENCONTRADO</td></tr>';
            return;
        }

        tbody.innerHTML = data.map(c => `
            <tr>
                <td style="font-weight:bold; color:#fff;">${c.nome}</td>
                <td>${c.dominio}</td>
                <td>${c.plataforma.toUpperCase()}</td>
                <td class="status-${c.status === 'active' ? 'active' : 'trial'}">${c.status === 'active' ? 'ATIVO' : 'TESTE'}</td>
                <td>${c.receita}</td>
                <td style="color:#ffd700;">${c.comissao}</td>
                <td>${c.data}</td>
            </tr>
        `).join('');
    }

    document.getElementById('search-input').addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        const filtered = allClients.filter(c => 
            c.nome.toLowerCase().includes(term) || 
            c.dominio.toLowerCase().includes(term)
        );
        renderTable(filtered);
    });

    fetchClients();
</script>
