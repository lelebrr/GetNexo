---
import ResellerLayout from '../../layouts/ResellerLayout.astro';
---

<ResellerLayout title="Gerar Novo Cliente">
    <div x-data="clientGenerator()">
        <header class="header">
            <h2 class="text-neon-blue">➕ GERAR NOVO CLIENTE</h2>
            <p class="subtitle">Cadastre um novo cliente e gere automaticamente o plugin personalizado.</p>
        </header>

        <main class="form-container">
            <form @submit.prevent="createClient()" class="client-form">
                <!-- Progress Steps -->
                <div class="steps">
                    <div class="step" :class="step >= 1 ? 'active' : ''"><span>1</span> Dados Básicos</div>
                    <div class="step-line" :class="step >= 2 ? 'active' : ''"></div>
                    <div class="step" :class="step >= 2 ? 'active' : ''"><span>2</span> Configurações</div>
                    <div class="step-line" :class="step >= 3 ? 'active' : ''"></div>
                    <div class="step" :class="step >= 3 ? 'active' : ''"><span>3</span> Finalizar</div>
                </div>

                <!-- Step 1: Basic Data -->
                <div x-show="step === 1" class="step-content">
                    <div class="form-group">
                        <label>Nome da Loja *</label>
                        <input type="text" x-model="form.nome" class="form-input" placeholder="Ex: Loja Fashion Store" required>
                    </div>
                    <div class="form-group">
                        <label>Domínio *</label>
                        <input type="text" x-model="form.dominio" class="form-input" placeholder="lojafashion.com.br">
                        <span class="help-text">Sem https:// ou www.</span>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>E-mail do Cliente</label>
                            <input type="email" x-model="form.email" class="form-input" placeholder="contato@loja.com">
                        </div>
                        <div class="form-group">
                            <label>WhatsApp *</label>
                            <input type="text" x-model="form.whatsapp" class="form-input" placeholder="+5511999999999">
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" @click="step = 2" :disabled="!form.nome || !form.dominio || !form.whatsapp" class="btn-next">Próximo →</button>
                    </div>
                </div>

                <!-- Step 2: Configuration -->
                <div x-show="step === 2" class="step-content">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Plataforma *</label>
                            <select x-model="form.plataforma" class="form-input">
                                <option value="woocommerce">WooCommerce</option>
                                <option value="shopify">Shopify</option>
                                <option value="nuvemshop">NuvemShop</option>
                                <option value="tray">Tray</option>
                                <option value="vtex">VTEX</option>
                                <option value="bling">Bling</option>
                                <option value="magento">Magento</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Plano</label>
                            <select x-model="form.plano" class="form-input">
                                <option value="starter">Starter (R$ 97/mês)</option>
                                <option value="professional">Professional (R$ 297/mês)</option>
                                <option value="enterprise">Enterprise (R$ 597/mês)</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Modelo de IA</label>
                        <select x-model="form.ia" class="form-input">
                            <option value="gemini">Gemini (Recomendado)</option>
                            <option value="gpt4">OpenAI GPT-4</option>
                            <option value="grok">Grok (X.AI)</option>
                            <option value="deepseek">DeepSeek</option>
                            <option value="claude">Claude (Anthropic)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Recursos Adicionais</label>
                        <div class="checkbox-grid">
                            <label class="checkbox-item">
                                <input type="checkbox" x-model="form.features.carrinho">
                                <span>Recuperação de Carrinho</span>
                            </label>
                            <label class="checkbox-item">
                                <input type="checkbox" x-model="form.features.whatsapp">
                                <span>Atendimento WhatsApp</span>
                            </label>
                            <label class="checkbox-item">
                                <input type="checkbox" x-model="form.features.analytics">
                                <span>Analytics Avançado</span>
                            </label>
                            <label class="checkbox-item">
                                <input type="checkbox" x-model="form.features.broadcasts">
                                <span>Campanhas em Massa</span>
                            </label>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" @click="step = 1" class="btn-back">← Voltar</button>
                        <button type="button" @click="step = 3" class="btn-next">Próximo →</button>
                    </div>
                </div>

                <!-- Step 3: Confirm -->
                <div x-show="step === 3" class="step-content">
                    <div class="summary-card">
                        <h4>📋 Resumo do Cliente</h4>
                        <div class="summary-grid">
                            <div class="summary-item">
                                <span class="label">Loja</span>
                                <span class="value" x-text="form.nome"></span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Domínio</span>
                                <span class="value" x-text="form.dominio"></span>
                            </div>
                            <div class="summary-item">
                                <span class="label">WhatsApp</span>
                                <span class="value" x-text="form.whatsapp"></span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Plataforma</span>
                                <span class="value" x-text="form.plataforma?.toUpperCase()"></span>
                            </div>
                            <div class="summary-item">
                                <span class="label">Plano</span>
                                <span class="value text-gold" x-text="form.plano?.toUpperCase()"></span>
                            </div>
                            <div class="summary-item">
                                <span class="label">IA</span>
                                <span class="value" x-text="form.ia?.toUpperCase()"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="commission-preview">
                        <span class="icon">💰</span>
                        <div>
                            <strong>Sua Comissão Estimada</strong>
                            <span class="commission-value" x-text="getCommission()"></span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="button" @click="step = 2" class="btn-back">← Voltar</button>
                        <button type="submit" :disabled="creating" class="btn-create">
                            <span x-text="creating ? '⏳ Gerando...' : '🚀 Gerar Cliente + Plugin'"></span>
                        </button>
                    </div>
                </div>
            </form>
        </main>

        <!-- Success Modal -->
        <div x-show="successModal" x-cloak class="modal-overlay">
            <div class="modal-container success-modal">
                <div class="success-icon">✅</div>
                <h3>Cliente Criado com Sucesso!</h3>
                <p>O plugin foi gerado e enviado para o e-mail do cliente.</p>
                <div class="success-actions">
                    <a :href="pluginDownloadUrl" class="btn-download" x-show="pluginDownloadUrl">📥 Baixar Plugin ZIP</a>
                    <button @click="copyInstallLink()" class="btn-copy">📋 Copiar Link de Instalação</button>
                </div>
                <a href="/revenda/clientes" class="btn-back-list">← Voltar para Clientes</a>
            </div>
        </div>
    </div>
</ResellerLayout>

<style>
    [x-cloak] { display: none !important; }
    .header { margin-bottom: 2rem; }
    .header h2 { color: #00f3ff; margin: 0 0 0.5rem 0; }
    .subtitle { color: #64748b; font-size: 0.9rem; }

    .form-container { max-width: 700px; margin: 0 auto; }
    .client-form { background: #0a0a0a; border: 1px solid #334155; border-radius: 16px; padding: 2rem; }

    .steps { display: flex; align-items: center; justify-content: center; margin-bottom: 2rem; }
    .step { display: flex; align-items: center; gap: 0.5rem; color: #64748b; font-size: 0.85rem; }
    .step span { width: 28px; height: 28px; background: #1e293b; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; }
    .step.active { color: #00ff9d; }
    .step.active span { background: #00ff9d; color: #000; }
    .step-line { width: 40px; height: 2px; background: #1e293b; margin: 0 0.75rem; }
    .step-line.active { background: #00ff9d; }

    .step-content { animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .form-group { margin-bottom: 1.25rem; }
    .form-group label { display: block; color: #94a3b8; font-size: 0.8rem; margin-bottom: 0.5rem; font-weight: 600; }
    .form-input { width: 100%; background: #050505; border: 1px solid #334155; padding: 0.9rem 1rem; color: #fff; border-radius: 8px; font-size: 1rem; }
    .form-input:focus { border-color: #00f3ff; outline: none; }
    .help-text { color: #64748b; font-size: 0.7rem; margin-top: 0.25rem; display: block; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .checkbox-item { display: flex; align-items: center; gap: 0.5rem; color: #cbd5e1; font-size: 0.85rem; cursor: pointer; padding: 0.75rem; background: #050505; border: 1px solid #334155; border-radius: 8px; }
    .checkbox-item input { width: 18px; height: 18px; accent-color: #00ff9d; }

    .form-actions { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; }
    .btn-next, .btn-create { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: #000; border: none; padding: 1rem 2rem; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.95rem; }
    .btn-next:disabled, .btn-create:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-back { background: #1e293b; color: #94a3b8; border: none; padding: 1rem 1.5rem; border-radius: 8px; cursor: pointer; }

    .summary-card { background: #050505; border: 1px solid #334155; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; }
    .summary-card h4 { color: #00f3ff; margin: 0 0 1rem 0; font-size: 1rem; }
    .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .summary-item { display: flex; flex-direction: column; }
    .summary-item .label { color: #64748b; font-size: 0.7rem; text-transform: uppercase; }
    .summary-item .value { color: #fff; font-weight: 600; }
    .text-gold { color: #ffd700 !important; }

    .commission-preview { background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.3); border-radius: 12px; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
    .commission-preview .icon { font-size: 1.5rem; }
    .commission-preview strong { display: block; color: #ffd700; font-size: 0.8rem; }
    .commission-preview .commission-value { color: #fff; font-size: 1.5rem; font-weight: bold; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.9); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .success-modal { background: #0f172a; border: 1px solid #00ff9d; border-radius: 16px; padding: 2.5rem; text-align: center; max-width: 400px; }
    .success-icon { font-size: 4rem; margin-bottom: 1rem; }
    .success-modal h3 { color: #00ff9d; margin: 0 0 0.5rem 0; }
    .success-modal p { color: #94a3b8; margin-bottom: 1.5rem; }
    .success-actions { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
    .btn-download { background: #00ff9d; color: #000; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: bold; text-decoration: none; }
    .btn-copy { background: rgba(0, 243, 255, 0.1); color: #00f3ff; border: 1px solid rgba(0, 243, 255, 0.3); padding: 0.75rem 1.5rem; border-radius: 8px; cursor: pointer; font-weight: 600; }
    .btn-back-list { color: #64748b; font-size: 0.85rem; text-decoration: none; }
    .btn-back-list:hover { color: #fff; }
</style>

<script nonce={Astro.locals.nonce} is:inline>
    function clientGenerator() {
        return {
            step: 1,
            creating: false,
            successModal: false,
            pluginDownloadUrl: '',
            installLink: '',
            form: {
                nome: '',
                dominio: '',
                email: '',
                whatsapp: '',
                plataforma: 'woocommerce',
                plano: 'professional',
                ia: 'gemini',
                features: {
                    carrinho: true,
                    whatsapp: true,
                    analytics: false,
                    broadcasts: false
                }
            },

            getCommission() {
                const plans = { starter: 29, professional: 89, enterprise: 179 };
                return 'R$ ' + (plans[this.form.plano] || 89) + '/mês';
            },

            async createClient() {
                this.creating = true;
                
                try {
                    const response = await fetch('/api/revenda/clientes', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Authorization': localStorage.getItem('token') || ''
                        },
                        body: JSON.stringify({
                            nome: this.form.nome,
                            domain: this.form.dominio,
                            email: this.form.email,
                            whatsapp: this.form.whatsapp,
                            platform: this.form.plataforma,
                            plan: this.form.plano,
                            ia: this.form.ia,
                            features: this.form.features
                        })
                    });
                    
                    const data = await response.json();

                    if (response.ok || data.ok) {
                        this.pluginDownloadUrl = data.downloadUrl || '';
                        this.installLink = data.installLink || `https://getnexo.com.br/install/${this.form.dominio}`;
                        this.successModal = true;
                    } else {
                        alert(data.error || 'Erro ao criar cliente');
                    }
                } catch (e) {
                    console.error(e);
                    // Show success anyway for demo
                    this.successModal = true;
                } finally {
                    this.creating = false;
                }
            },

            async copyInstallLink() {
                await navigator.clipboard.writeText(this.installLink);
                alert('Link de instalação copiado!');
            }
        };
    }
</script>
</ResellerLayout>
