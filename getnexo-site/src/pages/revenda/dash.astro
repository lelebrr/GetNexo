---
import ResellerLayout from '../../layouts/ResellerLayout.astro';
---

<ResellerLayout title="Dashboard Revendedor">
    <header class="bg-void-black border-b border-neon-blue p-4">
        <h2 class="text-neon-blue font-jetbrains" style="color: #00f3ff; font-family: 'JetBrains Mono'; margin: 0;">Dashboard Revendedor</h2>
    </header>

    <main style="margin-top: 4rem; padding: 1.5rem;">
        <div id="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
            <!-- Hydrated by JS -->
            <div style="background: #050505; border: 1px solid #00f3ff; padding: 1.25rem; border-radius: 0.25rem; text-align: center;">Carregando...</div>
        </div>

        <div id="chart-container" style="margin-top: 2rem; background: #050505; border: 1px solid #00f3ff; border-radius: 0.25rem; padding: 1.5rem; display: none;">
            <h3 style="color: #00f3ff; margin-bottom: 1rem;">Comissão por Dia (últimos 30)</h3>
            <canvas id="comissaoChart"></canvas>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script is:inline>
        const API_URL = window.location.hostname === 'localhost' ? 'http://localhost:3000' : '/api-proxy';

        // Mocks if API fails or is empty for demo
        const defaultStats = [
            { label: 'Comissão Total', valor: 'R$ 4.820', meta: 'R$ 6.000' },
            { label: 'Clientes Ativos', valor: '18', meta: '25' },
            { label: 'Churn Médio', valor: '8%', meta: '<5%' },
            { label: 'Ticket Médio', valor: 'R$ 142', meta: '>R$ 180' }
        ];

        async function loadDash() {
            try {
                const token = localStorage.getItem('token');
                const res = await fetch(`${API_URL}/api/revenda/stats`, { headers: { 'Authorization': token } });
                const data = await res.json();
                
                // If backend returns simple format, use it, else use mocks/enriched
                // The backend currently returns { balance, pendingCommission, clientsCount, rank }
                // Let's adapt it to user's desired "Card" format
                
                const stats = [
                    { label: 'Comissão Total', valor: 'R$ ' + (data.balance || 0).toFixed(2), meta: 'R$ 10.000' },
                    { label: 'Clientes Ativos', valor: data.clientsCount || '0', meta: '10' },
                    { label: 'Churn Médio', valor: '0%', meta: '<5%' }, // Mock
                    { label: 'Pendente', valor: 'R$ ' + (data.pendingCommission || 0).toFixed(2), meta: 'Libera Sex' }
                ];

                renderStats(stats);
                
                // MOCK GRAPH DATA (Since backend endpoint for graph doesn't exist yet)
                const graphData = Array.from({length: 30}, (_, i) => ({
                    data: `${i+1}/01`,
                    valor: Math.floor(Math.random() * 500)
                }));
                renderChart(graphData);

            } catch (e) {
                console.error('API Error, using fallback', e);
                renderStats(defaultStats);
            }
        }

        function renderStats(list) {
            const grid = document.getElementById('stats-grid');
            grid.innerHTML = list.map(s => `
                <div style="background: #050505; border: 1px solid #00f3ff; padding: 1.25rem; border-radius: 0.25rem; text-align: center;">
                    <div style="font-size: 1.5rem; color: #ffd700; font-weight: bold;">${s.valor}</div>
                    <div style="color: #64748b; font-size: 0.875rem;">${s.label}</div>
                    ${s.valor !== s.meta ? `<div style="color: #ff003c; font-size: 0.75rem; margin-top: 0.5rem;">Meta: ${s.meta}</div>` : ''}
                </div>
            `).join('');
        }

        function renderChart(dataPoints) {
            const container = document.getElementById('chart-container');
            container.style.display = 'block';
            
            new Chart(document.getElementById('comissaoChart'), {
                type: 'line',
                data: {
                    labels: dataPoints.map(d => d.data),
                    datasets: [{
                        label: 'Comissão',
                        data: dataPoints.map(d => d.valor),
                        borderColor: '#FFD500',
                        backgroundColor: 'rgba(255, 213, 0, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { 
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            ticks: { color: '#64748b' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#64748b' }
                        }
                    }
                }
            });
        }

        loadDash();
    </script>
</ResellerLayout>
