---
import ResellerLayout from '../../../layouts/ResellerLayout.astro';
---

<ResellerLayout title="Clientes Inativos">
    <div class="panel-header">
        <h2 class="text-neon-pink">⏸️ CLIENTES INATIVOS / EM TESTE</h2>
        <a href="/revenda/gerar" class="btn-gold">+ NOVO CLIENTE</a>
    </div>

    <div class="filter-bar">
        <input type="text" id="search-input" placeholder="FILTRAR POR NOME OU DOMÍNIO..." class="search-input">
    </div>

    <div class="table-container">
        <table id="clients-table">
            <thead>
                <tr>
                    <th>NOME</th>
                    <th>DOMÍNIO</th>
                    <th>PLATAFORMA</th>
                    <th>STATUS</th>
                    <th>ULTIMA ATIVIDADE</th>
                    <th>AÇÃO</th>
                </tr>
            </thead>
            <tbody id="clients-body">
                <tr><td colspan="6" style="text-align:center; padding: 2rem;">CARREGANDO DADOS...</td></tr>
            </tbody>
        </table>
    </div>

</ResellerLayout>

<style>
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .text-neon-pink { color: #f43f5e; text-shadow: 0 0 10px rgba(244, 63, 94, 0.4); }
    .btn-gold { background: #ffd700; color: #000; padding: 0.8rem 1.5rem; text-decoration: none; font-weight: bold; border-radius: 4px; box-shadow: 0 0 10px rgba(255, 215, 0, 0.4); text-transform: uppercase; }
    
    .filter-bar { margin-bottom: 1.5rem; }
    .search-input { width: 100%; background: #0a0a0a; border: 1px solid #334155; padding: 1rem; color: #fff; font-family: 'JetBrains Mono', monospace; outline: none; border-radius: 8px; }
    .search-input:focus { border-color: #f43f5e; }

    .table-container { background: #0a0a0a; border: 1px solid #334155; border-radius: 8px; overflow: hidden; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 1rem; color: #f43f5e; border-bottom: 1px solid #334155; font-size: 0.8rem; text-transform: uppercase; }
    td { padding: 1rem; border-bottom: 1px solid #1a1a1a; color: #cbd5e1; font-size: 0.9rem; }
    tr:hover { background: rgba(244, 63, 94, 0.05); }

    .status-trial { color: #ffd700; font-weight: bold; }
    .status-inactive { color: #64748b; }
    .btn-reactivate { background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid #f43f5e; padding: 0.4rem 0.8rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold; cursor: pointer; transition: all 0.2s; }
    .btn-reactivate:hover { background: #f43f5e; color: white; }
</style>

<script is:inline>
    let allClients = [];

    async function fetchInactiveClients() {
        try {
            const res = await fetch('/api/revenda/clientes?status=inactive');
            allClients = await res.json();
            renderTable(allClients);
        } catch (e) {
            console.error(e);
            document.getElementById('clients-body').innerHTML = '<tr><td colspan="6">ERRO AO CARREGAR</td></tr>';
        }
    }

    function renderTable(data) {
        const tbody = document.getElementById('clients-body');
        if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">NENHUM CLIENTE INATIVO ENCONTRADO</td></tr>';
            return;
        }

        tbody.innerHTML = data.map(c => `
            <tr>
                <td style="font-weight:bold; color:#fff;">${c.nome}</td>
                <td>${c.dominio}</td>
                <td>${c.plataforma.toUpperCase()}</td>
                <td class="status-${c.status}">${c.status === 'trial' ? 'EM TESTE' : 'INATIVO'}</td>
                <td>${c.data}</td>
                <td>
                    <button class="btn-reactivate">REATIVAR</button>
                </td>
            </tr>
        `).join('');
    }

    document.getElementById('search-input').addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        const filtered = allClients.filter(c => 
            c.nome.toLowerCase().includes(term) || 
            c.dominio.toLowerCase().includes(term)
        );
        renderTable(filtered);
    });

    fetchInactiveClients();
</script>
