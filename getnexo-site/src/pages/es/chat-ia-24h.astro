---
import Layout from '../../layouts/Layout.astro';
const title = "Chat IA 24h - GetNexo";
const description = "Chatbot con IA avanzada funcionando 24 horas por día, 7 días por semana. Venda más con automatización inteligente.";
const keywords = "chat ia 24h, chatbot inteligente, automatización whatsapp, ventas 24h";
---

<Layout title={title} description={description} keywords={keywords}>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-badge">🤖 IA 24/7</div>
      <h1>Chat IA 24h - Venda Siempre</h1>
      <p>Chatbot con IA avanzada funcionando 24 horas por día, 7 días por semana. Nunca más pierda una venta por falta de atención.</p>
      <div class="hero-features">
        <span>✅ Vende 24/7</span>
        <span>✅ Respuestas instantáneas</span>
        <span>✅ Aprendizaje continuo</span>
      </div>
      <div class="hero-ctas">
        <a href="/es/criar-bot" class="btn-primary">Crear Chat IA</a>
        <a href="#demo" class="btn-secondary">Ver Demostración</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="chat-demo">
        <div class="chat-header">💬 Chat IA 24h</div>
        <div class="chat-messages">
          <div class="message bot">
            <div class="message-content">
              <span class="message-text">¡Hola! ¿Cómo puedo ayudarte hoy?</span>
            </div>
          </div>
          <div class="message user">
            <div class="message-content">
              <span class="message-text">Quiero saber sobre sus productos</span>
            </div>
          </div>
          <div class="message bot">
            <div class="message-content">
              <span class="message-text">¡Tengo productos excelentes! Puedo ayudarte a encontrar el ideal para ti. ¿Qué tipo de producto buscas?</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="section-header">
      <h2>Funcionalidades del Chat IA 24h</h2>
      <p>Todo lo que necesitas para vender más</p>
    </div>

    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🧠</div>
        <h3>IA Avanzada GPT-4</h3>
        <p>Usamos la tecnología más avanzada de IA para entender contexto, sentimiento e intención del cliente.</p>
        <ul class="feature-list">
          <li>✅ Entendimiento de contexto</li>
          <li>✅ Análisis de sentimiento</li>
          <li>✅ Personalización avanzada</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Respuestas Instantáneas</h3>
        <p>Respuestas en menos de 1 segundo. No hagas que tus clientes esperen.</p>
        <ul class="feature-list">
          <li>✅ Tiempo de respuesta < 1s</li>
          <li>✅ Sin filas</li>
          <li>✅ Disponibilidad total</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">🎯</div>
        <h3>Vendas Automáticas</h3>
        <p>Califica leads, presenta productos, responde dudas y cierra ventas automáticamente.</p>
        <ul class="feature-list">
          <li>✅ Calificación automática</li>
          <li>✅ Presentación de productos</li>
          <li>✅ Cierre de ventas</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">🔄</div>
        <h3>Aprendizaje Continuo</h3>
        <p>La IA aprende con cada interacción, mejorando respuestas y aumentando conversión.</p>
        <ul class="feature-list">
          <li>✅ Mejoría continua</li>
          <li>✅ Aprendizaje con datos</li>
          <li>✅ Optimización automática</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>Analytics en Tiempo Real</h3>
        <p>Monitorea conversaciones, tasas de conversión y performance en tiempo real.</p>
        <ul class="feature-list">
          <li>✅ Dashboard completo</li>
          <li>✅ Métricas de conversión</li>
          <li>✅ Análisis de sentimientos</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">🔗</div>
        <h3>Integraciones</h3>
        <p>Conecta con tu CRM, e-commerce, pagamientos y mucho más.</p>
        <ul class="feature-list">
          <li>✅ Integración total</li>
          <li>✅ Webhooks</li>
          <li>✅ API REST</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="use-cases">
    <div class="section-header">
      <h2>Casos de Uso</h2>
      <p>Cómo diferentes sectores usan el Chat IA 24h</p>
    </div>

    <div class="cases-grid">
      <div class="case-card">
        <div class="case-icon">🛍️</div>
        <h3>E-commerce</h3>
        <p>Recuperação de carrinho, suporte pós-venda, recomendações de produtos e upsell automático.</p>
        <div class="case-metrics">
          <span>📈 +40% conversão</span>
          <span>⏱️ -75% tempo</span>
        </div>
      </div>

      <div class="case-card">
        <div class="case-icon">🏢</div>
        <h3>B2B</h3>
        <p>Qualificação de leads, agendamento de reuniões, follow-ups automáticos e CRM integrado.</p>
        <div class="case-metrics">
          <span>📈 +60% leads</span>
          <span>⏱️ -50% tempo</span>
        </div>
      </div>

      <div class="case-card">
        <div class="case-icon">🏥</div>
        <h3>Serviços</h3>
        <p>Agendamento automático, confirmações, lembretes e follow-ups pós-serviço.</p>
        <div class="case-metrics">
          <span>📈 +35% retenção</span>
          <span>⏱️ -80% no-show</span>
        </div>
      </div>

      <div class="case-card">
        <div class="case-icon">🎓</div>
        <h3>Educação</h3>
        <p>Suporte a alunos, agendamento de aulas, lembretes de tarefas e comunicação com responsáveis.</p>
        <div class="case-metrics">
          <span>📈 +45% engajamento</span>
          <span>⏱️ -60% trabalho</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Performance -->
  <section class="performance-section">
    <div class="section-header">
      <h2>Resultados Comprobados</h2>
      <p>Números que impresionan</p>
    </div>

    <div class="performance-grid">
      <div class="performance-card">
        <div class="performance-value">98%</div>
        <div class="performance-label">Tasa de Acierto</div>
        <div class="performance-desc">IA responde correctamente 98% de las preguntas</div>
      </div>

      <div class="performance-card">
        <div class="performance-value">24/7</div>
        <div class="performance-label">Disponibilidad</div>
        <div class="performance-desc">Funciona 24 horas por día, 7 días por semana</div>
      </div>

      <div class="performance-card">
        <div class="performance-value">1s</div>
        <div class="performance-label">Tiempo de Respuesta</div>
        <div class="performance-desc">Respuestas instantáneas en menos de 1 segundo</div>
      </div>

      <div class="performance-card">
        <div class="performance-value">+40%</div>
        <div class="performance-label">Aumento de Ventas</div>
        <div class="performance-desc">Promedio de aumento en ventas con IA</div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section">
    <div class="section-header">
      <h2>Planes del Chat IA 24h</h2>
      <p>Elige el plan ideal para tu negocio</p>
    </div>

    <div class="pricing-cards">
      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Starter</h3>
          <div class="price">R$ 47<span>/mes</span></div>
          <p>Hasta 1.000 conversas/mes</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Chat IA básico</li>
          <li>✅ 24/7 automático</li>
          <li>✅ Analytics simple</li>
          <li>✅ Soporte por chat</li>
        </ul>
        <a href="/es/criar-bot" class="pricing-cta">Comenzar Starter</a>
      </div>

      <div class="pricing-card featured">
        <div class="pricing-badge">Más Popular</div>
        <div class="pricing-header">
          <h3>Professional</h3>
          <div class="price">R$ 97<span>/mes</span></div>
          <p>Hasta 5.000 conversas/mes</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Todo del Starter</li>
          <li>✅ IA avanzada</li>
          <li>✅ Integraciones</li>
          <li>✅ Analytics avanzado</li>
          <li>✅ Multi-agentes</li>
        </ul>
        <a href="/es/criar-bot" class="pricing-cta">Elegir Professional</a>
      </div>

      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Enterprise</h3>
          <div class="price">R$ 197<span>/mes</span></div>
          <p>Conversas ilimitadas</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Todo del Professional</li>
          <li>✅ Conversas ilimitadas</li>
          <li>✅ SLA garantizado</li>
          <li>✅ Consultoría</li>
          <li>✅ White-label</li>
        </ul>
        <a href="/es/contato" class="pricing-cta">Hablar con Ventas</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="section-header">
      <h2>Preguntas Frecuentes</h2>
    </div>

    <div class="faq-list">
      <details class="faq-item">
        <summary>¿Cómo funciona el Chat IA 24h?</summary>
        <div class="faq-answer">
          <p>Usamos IA avanzada (GPT-4) para entender y responder mensajes automáticamente. La IA aprende con cada interacción y mejora continuamente.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>¿Puedo configurar respuestas personalizadas?</summary>
        <div class="faq-answer">
          <p>¡Sí! Puedes configurar respuestas, reglas de negocio y entrenar la IA con tus datos específicos.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>¿Cómo funciona con WhatsApp Business API?</summary>
        <div class="faq-answer">
          <p>Integración nativa con WhatsApp Business API oficial. Mantiene conversación en WhatsApp nativo, pero con capas de IA avanzada.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>¿Puedo escalar a miles de conversas?</summary>
        <div class="faq-answer">
          <p>¡Sí! Nuestra infraestructura es escalable y soporta miles de conversas simultáneas sin problemas.</p>
        </div>
      </details>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="final-cta">
    <div class="cta-content">
      <h2>Comienza a Vender 24/7 con IA</h2>
      <p>Crea tu chatbot inteligente ahora mismo. Resultados en 30 días.</p>
      <a href="/es/criar-bot" class="btn-primary-large">Crear Chat IA →</a>
    </div>
  </section>
</Layout>

<style>
  .hero-section { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; padding: 8rem 5%; max-width: 1400px; margin: 0 auto; align-items: center; }
  .hero-badge { background: rgba(0, 212, 255, 0.1); color: #00d4ff; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.9rem; font-weight: 600; display: inline-block; margin-bottom: 2rem; }
  .hero-content h1 { font-size: 3rem; font-weight: 900; margin-bottom: 1.5rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .hero-content p { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 2rem; line-height: 1.6; }
  .hero-features { display: flex; gap: 1rem; margin-bottom: 3rem; flex-wrap: wrap; }
  .hero-features span { background: rgba(0, 255, 157, 0.1); color: #00ff9d; padding: 0.5rem 1rem; border-radius: 15px; font-size: 0.9rem; font-weight: 600; }
  .hero-ctas { display: flex; gap: 1.5rem; }
  .btn-primary { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1rem 2rem; border-radius: 12px; font-weight: 800; text-decoration: none; transition: 0.3s; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0, 212, 255, 0.3); }
  .btn-secondary { border: 1px solid rgba(255,255,255,0.3); color: white; padding: 1rem 2rem; border-radius: 12px; font-weight: 600; text-decoration: none; transition: 0.3s; }
  .btn-secondary:hover { background: rgba(255,255,255,0.1); }

  .chat-demo { background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 1.5rem; }
  .chat-header { font-size: 1.2rem; font-weight: 800; color: #00d4ff; margin-bottom: 1rem; text-align: center; }
  .chat-messages { display: flex; flex-direction: column; gap: 1rem; }
  .message { display: flex; }
  .message.bot { justify-content: flex-start; }
  .message.user { justify-content: flex-end; }
  .message-content { background: rgba(255,255,255,0.05); padding: 0.8rem 1rem; border-radius: 12px; max-width: 80%; }
  .message.user .message-content { background: rgba(0, 255, 157, 0.1); }
  .message-text { color: white; font-size: 0.9rem; }

  .features-section { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .feature-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 3rem; text-align: center; transition: 0.3s; }
  .feature-card:hover { transform: translateY(-10px); border-color: rgba(0, 212, 255, 0.3); }
  .feature-icon { font-size: 3rem; margin-bottom: 1.5rem; }
  .feature-card h3 { color: white; font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; }
  .feature-card p { color: #e2e8f0; line-height: 1.6; margin-bottom: 1.5rem; }
  .feature-list { list-style: none; text-align: left; }
  .feature-list li { color: #e2e8f0; margin-bottom: 0.5rem; }

  .use-cases { padding: 8rem 5%; }
  .cases-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .case-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2.5rem; text-align: center; }
  .case-icon { font-size: 3rem; margin-bottom: 1rem; }
  .case-card h3 { color: white; font-size: 1.3rem; margin-bottom: 1rem; }
  .case-card p { color: #e2e8f0; line-height: 1.6; margin-bottom: 1.5rem; }
  .case-metrics { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .case-metrics span { background: rgba(0, 255, 157, 0.1); color: #00ff9d; padding: 0.5rem 1rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; }

  .performance-section { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .performance-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .performance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 3rem; text-align: center; }
  .performance-value { font-size: 3rem; font-weight: 900; color: #00ff9d; margin-bottom: 1rem; }
  .performance-label { color: white; font-weight: 600; margin-bottom: 0.5rem; }
  .performance-desc { color: #94a3b8; font-size: 0.9rem; }

  .pricing-section { padding: 8rem 5%; max-width: 1200px; margin: 0 auto; }
  .pricing-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .pricing-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 3rem; text-align: center; position: relative; }
  .pricing-card.featured { border-color: #00d4ff; box-shadow: 0 0 30px rgba(0, 212, 255, 0.2); }
  .pricing-badge { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: #00d4ff; color: black; padding: 0.5rem 1rem; border-radius: 15px; font-weight: 800; font-size: 0.8rem; }
  .pricing-header h3 { color: white; font-size: 1.5rem; margin-bottom: 1rem; }
  .price { font-size: 3rem; font-weight: 900; color: #00ff9d; }
  .price span { font-size: 1rem; color: #94a3b8; }
  .pricing-features { list-style: none; text-align: left; margin: 2rem 0; }
  .pricing-features li { color: #e2e8f0; margin-bottom: 0.8rem; }
  .pricing-cta { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1rem 2rem; border-radius: 12px; font-weight: 800; text-decoration: none; display: inline-block; margin-top: 2rem; }

  .faq-section { padding: 8rem 5%; max-width: 800px; margin: 0 auto; }
  .faq-list { margin-top: 4rem; }
  .faq-item { border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; margin-bottom: 1rem; overflow: hidden; }
  .faq-item summary { padding: 1.5rem; background: rgba(15, 23, 42, 0.6); color: white; font-weight: 600; cursor: pointer; }
  .faq-item summary:hover { background: rgba(15, 23, 42, 0.8); }
  .faq-answer { padding: 0 1.5rem 1.5rem; color: #e2e8f0; line-height: 1.6; }

  .final-cta { padding: 8rem 5%; background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 255, 157, 0.1)); text-align: center; }
  .cta-content h2 { font-size: 3rem; font-weight: 900; margin-bottom: 1.5rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .cta-content p { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 3rem; }
  .btn-primary-large { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1.5rem 3rem; border-radius: 15px; font-weight: 900; font-size: 1.2rem; text-decoration: none; transition: 0.3s; }
  .btn-primary-large:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(0, 212, 255, 0.4); }

  .section-header { text-align: center; margin-bottom: 4rem; }
  .section-header h2 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .section-header p { color: #e2e8f0; font-size: 1.1rem; }

  @media (max-width: 900px) {
    .hero-section { grid-template-columns: 1fr; text-align: center; }
    .chat-demo { display: none; }
  }
</style>
