---
import Layout from '../../layouts/Layout.astro';
import VideoDemo from '../../components/VideoDemo.astro';
import ROICalculator from '../../components/ROICalculator.astro';
import Testimonials from '../../components/Testimonials.astro';
import TourGuided from '../../components/TourGuided.astro';
import { verificaDataVariavel } from '../../lib/feriados.js';
import '../../styles/index-premium.css';

const title = "Chatbot WhatsApp IA para Ventas 24h | API Oficial Meta | GetNexo";
const description = "Automatiza tus ventas en WhatsApp con Inteligencia Artificial Generativa. API Oficial Meta, PIX nativo, CRM inteligente y Analytics. Aumenta tu conversión hasta 10x sin mensualidades fijas.";
const keywords = "chatbot whatsapp ventas, ia para whatsapp, automatización whatsapp ventas, api oficial whatsapp business, chatbot con pix, crm para whatsapp, inteligencia artificial vendedora, chatbot whatsapp gratis, recuperar carrito abandonado whatsapp, chatbot auto-hospedado";

const lang = 'es';
const { default: t } = await import(`../../i18n/es.json`);

const feriadosData = await fetch('/data/feriados.json').then(r => r.json()).catch(() => ({ feriados: [] }));
const hoje = new Date().toISOString().slice(0,10);
const idiomaNavegador = typeof navigator !== 'undefined' ? (navigator.language || 'es-ES') : 'es-ES';
const idiomaCurto = idiomaNavegador.split('-')[0];

const feriadoHoje = feriadosData.feriados.find(f => {
  if (f.data === hoje) return true;
  const anoAtual = new Date().getFullYear();
  const dataCalculada = verificaDataVariavel(f.data, anoAtual);
  return dataCalculada === hoje;
});

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://getnexo.com.br/#organization",
      "name": "GetNexo",
      "url": "https://getnexo.com.br",
      "logo": "https://getnexo.com.br/logo.svg",
      "description": "Plataforma de IA para ventas WhatsApp 24h. API Oficial Meta, PIX automático, CRM integrado.",
      "foundingDate": "2024",
      "sameAs": [
        "https://linkedin.com/company/getnexo",
        "https://instagram.com/getnexo",
        "https://github.com/lelebrr",
        "https://youtube.com/@getnexo",
        "https://tiktok.com/@getnexo"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+55-11-4003-XXXX",
        "contactType": "customer service",
        "availableLanguage": ["Portuguese", "English", "Spanish", "French"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://getnexo.com.br/#website",
      "url": "https://getnexo.com.br",
      "name": "GetNexo - IA para Ventas WhatsApp",
      "description": "IA que cierra ventas en WhatsApp 24h. Plataforma completa con API Oficial Meta, PIX, CRM, fidelidad y analytics.",
      "publisher": { "@id": "https://getnexo.com.br/#organization" },
      "inLanguage": "es-ES",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://getnexo.com.br/es/buscar?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://getnexo.com.br/#software",
      "name": "GetNexo",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, WhatsApp",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "BRL",
        "priceValidUntil": "2026-12-31",
        "description": "Plan gratuito con funcionalidades avanzadas"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "500",
        "bestRating": "5",
        "worstRating": "1"
      },
      "author": { "@id": "https://getnexo.com.br/#organization" }
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} isLanding={true}>

  {feriadoHoje && (
    <link rel="stylesheet" href="/custom/css/holiday-effects.css" is:inline />
  )}

  {feriadoHoje && (
    <script nonce={Astro.locals.nonce} is:inline define:vars={{ efeito: feriadoHoje.efeito }}>
      document.body.classList.add(efeito);
    </script>
  )}

  <script nonce={Astro.locals.nonce} type="application/ld+json" is:inline set:html={JSON.stringify(homeSchema)}></script>

  <section class="hero-split">
    <div class="hero-content">
      {feriadoHoje && (
        <div class="feriado-banner animate-on-scroll">
          <span class="feriado-emoji">🎉</span>
          <span class="feriado-texto">
            {feriadoHoje.bot_frase.es || feriadoHoje.bot_frase.pt}
          </span>
          <span class="feriado-nome">| {feriadoHoje.idiomas.es || feriadoHoje.idiomas.pt}</span>
        </div>
      )}

      <div class="hero-badge animate-on-scroll">🚀 TRANSFORMA TU WHATSAPP EN UNA MÁQUINA DE VENTAS AUTOMATIZADA</div>
      <h1 class="hero-title animate-on-scroll">
        <span class="text-gradient-animated">IA INTELIGENTE</span><br/>
        VENDE 24H/DÍA SIN NECESITAR <span class="no-break">ATENDIENTES</span>
      </h1>
      <p class="hero-subtitle animate-on-scroll">
        <span id="typing-text"></span><span class="cursor">|</span>
      </p>
      <div class="hero-ctas animate-on-scroll">
        <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow">COMIENZA GRATIS AHORA</a>
        <button onclick="window.abrirModalDemo()" class="btn-surprise animate-on-scroll">PRUEBA AQUÍ.. SORPRÉNDETE</button>
      </div>
      <div class="hero-trust animate-on-scroll">
        <span>✅ API Oficial Meta</span>
        <span>✅ Configuración en 12min</span>
        <span>✅ Cero Mensualidad</span>
      </div>
    </div>

    <div class="hero-visual animate-on-scroll">
        <div class="visual-container">
            <div class="visual-glow"></div>
            <div class="smart-phone-mockup">
                <div class="screen-content">
                    <div class="chat-header-sim">
                        <div class="sim-avatar">N</div>
                        <div class="sim-info">
                            <span class="sim-name">Nexus Smart Bot</span>
                            <span class="sim-status">online</span>
                        </div>
                    </div>
                    <div class="chat-body-mega" id="mega-chat-container">
                    </div>
                    <div class="chat-input-sim">
                        <div class="sim-mic">🎤</div>
                        <span>Di algo...</span>
                        <div class="sim-audio-icon">🎧</div>
                        <div class="sim-send">🚀</div>
                    </div>
                    <div id="sim-finger-cursor" class="sim-finger">☝️</div>
                </div>
            </div>

            <div class="floating-elements">
                <div class="f-pill">💰 PIX Activo</div>
                <div class="f-pill">🚀 10x ROI</div>
            </div>
        </div>
    </div>
  </section>

  <TourGuided slot="dock-left" targetPage="home" mobileOptimized={true} />

  <div class="section-header animate-on-scroll">
        <h2 class="text-gradient">La Infraestructura Definitiva para Escalar tus Ventas</h2>
        <p>La única plataforma que combina IA Generativa, PIX Nativo y Automatización Oficial Meta para transformar tu Chat en una máquina de lucro 24h por día.</p>
    </div>

    <div class="grid-cards">
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">🤖</div>
        <h3>IA Generativa de Ventas</h3>
        <p>Agente virtual entrenado con tu catálogo que convierte leads en lucro 24/7 de forma humanizada.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Explorar IA →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">💰</div>
        <h3>Checkout & PIX Nativo</h3>
        <p>Experiencia de compra fluida con generación de PIX y confirmación automática sin salir del chat.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Ver Checkout →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">🚀</div>
        <h3>Broadcast & Ads de Alto Rendimiento</h3>
        <p>Envíos en masa inteligentes y Click-to-WhatsApp Ads con medición de ROI en tiempo real.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Activar Ads →</a>
      </div>
      <div class="glass-panel p-card animate-on-scroll">
        <div class="p-icon">👥</div>
        <h3>Pipeline & CRM Estratégico</h3>
        <p>Visión 360º de tu embudo con gestión multi-agente y automatización inteligente de follow-up.</p>
        <a href={`/${lang}/${t.slugs.analytics}`} class="p-link">Gestionar Leads →</a>
      </div>
    </div>

  <section class="metrics-section">
    <div class="metric-card animate-on-scroll">
        <span class="m-val">10x</span>
        <span class="m-label">Más Conversión</span>
    </div>
    <div class="metric-card animate-on-scroll">
        <span class="m-val">24/7</span>
        <span class="m-label">Disponibilidad</span>
    </div>
    <div class="metric-card animate-on-scroll">
        <span class="m-val">R$ 0</span>
        <span class="m-label">Tarifa por Mensaje</span>
    </div>
  </section>

  <Testimonials />

  <ROICalculator />

  <section class="giant-features">
    <div class="giant-feature-row animate-on-scroll">
        <div class="giant-feature-visual">
            <img src="/assets/features/magic-replies.webp" alt="Magic Replies AI" width="501" height="501" class="premium-visual" />
        </div>
        <div class="giant-feature-info">
            <div class="feature-tag">Exclusivo</div>
            <h2 class="text-gradient">{t.features_giant.magic_replies.title}</h2>
            <p>{t.features_giant.magic_replies.description}</p>
            <ul class="feature-bullets">
                <li><span>✨</span> {t.features_giant.magic_replies.f1}</li>
                <li><span>🧠</span> {t.features_giant.magic_replies.f2}</li>
                <li><span>📈</span> {t.features_giant.magic_replies.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">Conocer Magic Replies</a>
        </div>
    </div>

    <div class="giant-feature-row reverse animate-on-scroll">
        <div class="giant-feature-info">
            <div class="feature-tag gold">Retención</div>
            <h2 class="text-gradient">{t.features_giant.loyalty.title}</h2>
            <p>{t.features_giant.loyalty.description}</p>
            <ul class="feature-bullets">
                <li><span>🏆</span> {t.features_giant.loyalty.f1}</li>
                <li><span>🎁</span> {t.features_giant.loyalty.f2}</li>
                <li><span>❤️</span> {t.features_giant.loyalty.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">Ver Fidelidad</a>
        </div>
        <div class="giant-feature-visual">
            <img src="/assets/features/loyalty.webp" alt="Loyalty System" width="501" height="501" class="premium-visual" />
        </div>
    </div>

    <div class="giant-feature-row animate-on-scroll">
        <div class="giant-feature-visual">
            <img src="/assets/features/analytics.webp" alt="Advanced Analytics" width="501" height="501" class="premium-visual" />
        </div>
        <div class="giant-feature-info">
            <div class="feature-tag blue">Inteligencia</div>
            <h2 class="text-gradient">{t.features_giant.analytics.title}</h2>
            <p>{t.features_giant.analytics.description}</p>
            <ul class="feature-bullets">
                <li><span>📊</span> {t.features_giant.analytics.f1}</li>
                <li><span>📝</span> {t.features_giant.analytics.f2}</li>
                <li><span>🌍</span> {t.features_giant.analytics.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.analytics}`} class="btn-outline-glow">Explorar Datos</a>
        </div>
    </div>

    <div class="giant-feature-row reverse animate-on-scroll">
        <div class="giant-feature-info">
            <div class="feature-tag green">Ecosistema</div>
            <h2 class="text-gradient">{t.features_giant.integrations.title}</h2>
            <p>{t.features_giant.integrations.description}</p>
            <ul class="feature-bullets">
                <li><span>🔗</span> {t.features_giant.integrations.f1}</li>
                <li><span>⚙️</span> {t.features_giant.integrations.f2}</li>
                <li><span>📡</span> {t.features_giant.integrations.f3}</li>
            </ul>
            <a href={`/${lang}/${t.slugs.integrations}`} class="btn-outline-glow">Ver Todas las Integraciones</a>
        </div>
        <div class="giant-feature-visual">
            <img src="/assets/features/integrations.webp" alt="Integrations Map" width="501" height="501" class="premium-visual" />
        </div>
    </div>
  </section>

  <section class="security-section">
    <div class="section-header animate-on-scroll">
        <h2 class="text-gradient">🛡️ Seguridad Máxima en GetNexo</h2>
        <p>Protege Tu Tienda y Tus Clientes con Confianza Total</p>
    </div>

    <div class="security-grid animate-on-scroll">
      <div class="security-card glass-panel">
        <div class="security-icon">🛡️</div>
        <h3>Cloudflare Shield</h3>
        <p>Protección contra DDoS, Firewall Avanzado (WAF) y Gestión de Bots. Tu tienda protegida como las más grandes del mundo.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">🔐</div>
        <h3>AES Encryption</h3>
        <p>Criptografía LGPD-compliant con AES-256. Cumplimiento 100% LGPD. Cero almacenamiento innecesario.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">🚪</div>
        <h3>Zero Trust Network</h3>
        <p>Cloudflare Tunnel con Zero Trust. Ningún puerto abierto en el servidor. Conexión outbound únicamente.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">⏰</div>
        <h3>24h Monitoring</h3>
        <p>Rate Limiting inteligente, detección de amenazas en tiempo real y backups seguros automatizados.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">💳</div>
        <h3>Secure PIX</h3>
        <p>Integración directa con gateways confiables. QR Code validado y encriptado en tiempo real.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">✅</div>
        <h3>99.99% Uptime</h3>
        <p>Tu tienda nunca se cae offline. Sin historial de breaches. Actualizaciones automáticas.</p>
      </div>
    </div>

    <div class="security-cta animate-on-scroll">
        <p class="security-notice">💡 Seguridad WhatsApp Business no es lujo — es necesidad.</p>
        <p class="security-benefit">Con GetNexo, tienes protección de nivel enterprise sin complicación ni costo exorbitante.</p>
        <div class="security-actions">
            <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow security-btn">Prueba Gratis Ahora →</a>
            <button onclick="abrirModalDemo()" class="btn-outline security-btn">Ver Certificaciones</button>
        </div>
        <p class="security-footer">© 2026 GetNexo. Todos los derechos reservados. | GetNexo: La vanguardia en Automatización WhatsApp y IA para Negocios.</p>
    </div>
  </section>

  <section class="final-cta animate-on-scroll">
    <div class="glass-panel cta-box p-12 text-center">
        <h2 class="text-gradient text-4xl font-black mb-6">¿Listo para Dominar WhatsApp con IA?</h2>
        <p class="text-xl text-gray-400 mb-8 max-w-2xl mx-auto">
            Domina WhatsApp con la infraestructura más robusta del mercado. 💡 Seguridad WhatsApp Business no es lujo — es necesidad. Activa tu IA en menos de 10 minutos.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
            <a href={`/${lang}/${t.slugs.create_bot}`} class="btn-primary-glow">COMIENZA GRATIS AHORA</a>
            <button onclick="window.abrirModalDemo()" class="btn-outline">PRUEBA DEMO IA</button>
        </div>
    </div>
  </section>

<script nonce={Astro.locals.nonce} is:inline src="/custom/js/hero-animations.js"></script>
<script nonce={Astro.locals.nonce} is:inline>
  // Carregamento dinâmico de scripts de demonstração para otimizar performance
  // Scripts são carregados apenas quando o usuário interage com a página
  (function() {
    'use strict';
    
    let scriptsLoaded = false;
    let scriptsLoading = false;
    
    function loadDemoScripts() {
      if (scriptsLoaded || scriptsLoading) return;
      
      scriptsLoading = true;
      
      // Carrega os scripts de demonstração dinamicamente
      const scripts = [
        '/custom/js/mega-chat-sim.js',
        '/custom/js/modals-demo.js',
        '/custom/js/click-fireworks.js'
      ];
      
      scripts.forEach(src => {
        const script = document.createElement('script');
        script.src = src;
        script.isInline = true;
        document.head.appendChild(script);
      });
      
      scriptsLoaded = true;
      console.log('Scripts de demonstração carregados dinamicamente');
    }
    
    // Carrega scripts quando o usuário interage pela primeira vez
    const interactionEvents = ['click', 'scroll', 'mousemove', 'touchstart'];
    
    function handleFirstInteraction() {
      loadDemoScripts();
      // Remove listeners após o primeiro carregamento
      interactionEvents.forEach(event => {
        document.removeEventListener(event, handleFirstInteraction);
      });
    }
    
    // Adiciona listeners de interação
    interactionEvents.forEach(event => {
      document.addEventListener(event, handleFirstInteraction, { once: true });
    });
    
    // Também carrega quando o DOM estiver pronto (para garantir que os elementos existam)
    document.addEventListener('DOMContentLoaded', () => {
      // Verifica se há elementos que precisam dos scripts
      const hasDemoElements = document.querySelector('[onclick*="abrirModalDemo"], [onclick*="abrirModalChat"], [onclick*="abrirModalIA"]');
      if (hasDemoElements) {
        // Adia o carregamento para não bloquear o render inicial
        setTimeout(loadDemoScripts, 1000);
      }
    });
  })();
</script>

</Layout>
