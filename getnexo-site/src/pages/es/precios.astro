};
---

<Layout title={title} description={description} keywords={keywords}>
  
  <!-- Hero Section -->
  <section class="pricing-hero">
    <div class="hero-badge">💰 ROI Imbatible</div>
    <h1>Precios <span class="text-gradient">transparentes</span></h1>
    <p class="hero-subtitle">
      Sin sorpresas. Sin tarifas ocultas. Sin compromiso. Elige el plan que mejor te funcione.
    </p>
  </section>

  <!-- Guarantees Bar -->
  <section class="guarantees-section">
    <div class="guarantees-grid">
      {guarantees.map(g => (
        <div class="guarantee-item">
          <span class="g-icon">{g.icon}</span>
          <div>
            <strong>{g.title}</strong>
            <span>{g.desc}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="pricing-cards-section">
    <div class="pricing-grid">
      {plans.map(plan => (
        <div class={`pricing-card glass-panel ${plan.popular ? 'featured' : ''}`}>
          {plan.popular && <div class="popular-badge">Más Elegido</div>}
          <div class="card-type">{plan.type}</div>
          <h3>{plan.name}</h3>
          <div class="card-price">
            {plan.price}<span>{plan.period}</span>
          </div>
          <p class="card-desc">{plan.description}</p>
          
          <ul class="card-features">
            {plan.features.map(f => (
              <li class={f.highlight ? 'highlight' : ''}>
                {f.included ? '✅' : '❌'} <span set:html={f.text}></span>
              </li>
            ))}
          </ul>
          
          <a 
            href={plan.ctaLink} 
            class={plan.popular ? 'btn-xl-glow' : 'btn-outline-glow'}
            target={plan.ctaLink.startsWith('http') ? '_blank' : '_self'}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="roi-calculator-section">
    <h2>Calcula tu <span class="text-gradient">ahorro</span></h2>
    <p class="section-subtitle">Mira cuánto puedes ahorrar reemplazando empleados o SaaS caros</p>
    
    <div class="roi-wrapper glass-panel">
      <div class="roi-controls">
        <div class="control-group">
          <label>Leads Mensuales: <span id="lead-value">5.000</span></label>
          <input type="range" id="lead-slider" min="500" max="50000" step="500" value="5000" class="premium-slider" />
        </div>
        <div class="control-group">
          <label>Costo por Agente/SaaS: <span id="cost-value">R$ 1.500</span></label>
          <input type="range" id="cost-slider" min="500" max="10000" step="100" value="1500" class="premium-slider" />
        </div>
      </div>
      <div class="roi-result">
        <div class="result-card">
          <span class="res-label">Ahorro Mensual Estimado</span>
          <span class="res-value" id="roi-savings">R$ 4.500,00</span>
          <p>Basado en 1 IA reemplazando a 3 empleados.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="comparison-section">
    <h2>Comparativa <span class="text-gradient">detallada</span></h2>
    
    <div class="comparison-table glass-panel">
      <div class="table-header">
        <span>Función</span>
        <span>Self-Hosted</span>
        <span class="highlight">Pro</span>
        <span>Enterprise</span>
      </div>
      {comparison.map(row => (
        <div class="table-row">
          <span class="row-feature">{row.feature}</span>
          <span>{row.selfhosted}</span>
          <span class="highlight">{row.pro}</span>
          <span>{row.enterprise}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="addons-section">
    <h2>Complementos <span class="text-gradient">opcionales</span></h2>
    
    <div class="addons-grid">
      {addons.map(addon => (
        <div class="addon-card glass-panel">
          <div class="addon-info">
            <strong>{addon.name}</strong>
            <span>{addon.desc}</span>
          </div>
          <span class="addon-price">{addon.price}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="faq-section">
    <h2>Preguntas sobre <span class="text-gradient">precios</span></h2>
    
    <div class="faq-list">
      {faqs.map(faq => (
        <details class="faq-item glass-panel">
          <summary>
            <span class="faq-q">{faq.q}</span>
            <span class="faq-toggle">+</span>
          </summary>
          <p class="faq-a">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="final-cta">
    <div class="glass-panel cta-box">
      <h2>¿Listo para <span class="text-gradient">ahorrar</span>?</h2>
      <p>Comienza gratis o elige el plan Pro para soporte VIP.</p>
      <div class="cta-buttons">
        <a href="/es/crear-bot" class="btn-primary-glow">Empezar Gratis</a>
        <a href="/es/contacto" class="btn-outline">Hablar con Ventas</a>
      </div>
      <p class="cta-note">Prueba 7 días gratis • Sin tarjeta de crédito • Cancela cuando quieras</p>
    </div>
  </section>

</Layout>

<script nonce={Astro.locals.nonce} is:inline>
  const leadSlider = document.getElementById('lead-slider');
  const costSlider = document.getElementById('cost-slider');
  const leadVal = document.getElementById('lead-value');
  const costVal = document.getElementById('cost-value');
  const roiSavings = document.getElementById('roi-savings');

  function updateROI() {
    const leads = parseInt(leadSlider.value);
    const costPerHuman = parseInt(costSlider.value);
    
    let humansSaved = 1;
    if (leads > 2000) humansSaved = 3;
    if (leads > 10000) humansSaved = 6;
    if (leads > 30000) humansSaved = 12;

    const totalCostSaved = (humansSaved * costPerHuman) - 97;
    
    leadVal.innerText = leads.toLocaleString();
    costVal.innerText = `R$ ${costPerHuman.toLocaleString()}`;
    roiSavings.innerText = `R$ ${Math.max(0, totalCostSaved).toLocaleString('es-ES', { minimumFractionDigits: 2 })}`;
  }

  leadSlider?.addEventListener('input', updateROI);
  costSlider?.addEventListener('input', updateROI);
  updateROI();
</script>

