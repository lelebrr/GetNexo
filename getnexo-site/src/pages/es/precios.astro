      { text: "Todo del plan Gratis", included: true, highlight: true },
      { text: "Servidores NVMe ultra-rápidos", included: true, highlight: false },
      { text: "Activación en 5 minutos", included: true, highlight: false },
      { text: "Copias de seguridad automáticas diarias", included: true, highlight: false },
      { text: "SSL y dominio incluido", included: true, highlight: false },
