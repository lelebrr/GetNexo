const comparison = [
  { feature: "Mensajes/mes", selfhosted: "∞ Ilimitado", pro: "∞ Ilimitado", enterprise: "∞ Ilimitado" },
  { feature: "IA Generativa", selfhosted: "OpenAI/Gemini", pro: "OpenAI/Gemini", enterprise: "Modelo personalizado" },
  { feature: "Agentes simultáneos", selfhosted: "Ilimitado", pro: "Ilimitado", enterprise: "Ilimitado" },
  { feature: "Checkout PIX", selfhosted: "✓", pro: "✓", enterprise: "✓" },
  { feature: "CRM Kanban", selfhosted: "✓", pro: "✓", enterprise: "✓" },
  { feature: "Broadcast", selfhosted: "✓", pro: "✓", enterprise: "Prioridad" },
  { feature: "Integraciones", selfhosted: "Todas", pro: "Todas", enterprise: "Todas + Personalizadas" },
  { feature: "Soporte", selfhosted: "Comunidad", pro: "VIP WhatsApp", enterprise: "Dedicado 24/7" },
  { feature: "SLA uptime", selfhosted: "N/A", pro: "99.5%", enterprise: "99.9%" },
  { feature: "Copias de seguridad", selfhosted: "Manual", pro: "Automáticas", enterprise: "Automáticas + Geo" }
];

const addons = [
  { name: "Número WhatsApp Adicional", price: "R$ 47/mes", desc: "Cada número extra para múltiples negocios" },
  { name: "Instalación Asistida", price: "R$ 297 pago único", desc: "Configuración completa self-hosted con capacitación" },
  { name: "Consultoría de IA", price: "R$ 197/hora", desc: "Optimización de prompts y flujos" },
  { name: "White Label", price: "Bajo consulta", desc: "Su marca, su dominio, interfaz personalizada" }
];

const guarantees = [
  { icon: "💰", title: "7 días gratis", desc: "Prueba el plan Pro sin compromiso" },
  { icon: "🔒", title: "Sin compromiso", desc: "Cancela cuando quieras, sin multas" },
  { icon: "📊", title: "Sin tarifa por msg", desc: "Paga solo la mensualidad fija" },
  { icon: "🔄", title: "Migración gratis", desc: "Te ayudamos a traer tus datos" }
];

const faqs = [
  {
    q: "¿Hay tarifa por mensaje enviado?",
    a: "¡No! Solo pagas la mensualidad del plan Pro (R$ 97) o nada en el self-hosted. Las únicas tarifas adicionales son las cobradas por Meta si excedes el límite gratuito de la API Cloud (las primeras 1000 conversaciones/mes son gratuitas)."
  },
  {
    q: "¿Cuál es la diferencia entre Self-Hosted y Pro?",
    a: "En Self-Hosted tú instalas y mantienes todo en tu servidor. En Pro, nosotros nos encargamos de la infraestructura, copias de seguridad, SSL, actualizaciones y ofrecemos soporte VIP. Las funciones de IA y automatización son idénticas en ambos."
  },
  {
    q: "¿Puedo empezar gratis y migrar a Pro después?",
    a: "¡Sí! Muchos clientes empiezan self-hosted para probar y luego migran a la nube Pro cuando quieren practicidad. La migración es sencilla y ayudamos en el proceso."
  },
  {
    q: "Si cancelo, ¿pierdo mis datos?",
    a: "No. Puedes exportar todos tus datos antes de cancelar. En self-hosted, los datos ya son tuyos. En Pro, proporcionamos una copia de seguridad completa para descargar."
  },
  {
    q: "¿Qué formas de pago aceptan?",
    a: "PIX (con 5% de descuento), tarjeta de crédito (hasta 12x), boleto y transferencia bancaria."
  }
];

const testimonialPricing = [
  { name: "Ricardo", company: "Tienda Virtual", text: "Gastaba R$ 4.500/mes con 3 empleados. ¡Hoy pago R$ 97 y la IA hace más que ellos!", avatar: "👨‍💼" },
  { name: "Fernanda", company: "Clínica Estética", text: "El ROI fue absurdo. En la primera semana ya había recuperado 6 meses de mensualidad.", avatar: "👩‍⚕️" }
];

const priceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://getnexo.com.br/#organization",
      "name": "GetNexo",
      "url": "https://getnexo.com.br/es/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://getnexo.com.br/logo.svg"
      }
    }
