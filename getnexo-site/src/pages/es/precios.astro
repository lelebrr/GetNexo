    features: [
      { text: "Múltiples instancias de IA", included: true, highlight: true },
      { text: "API RESTful dedicada (Alta Capacidad)", included: true, highlight: false },
      { text: "Consultoría de IA incluida", included: true, highlight: false },
      { text: "SLA garantizado por contrato", included: true, highlight: false },
