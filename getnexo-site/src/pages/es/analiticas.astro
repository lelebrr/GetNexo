---
import Layout from '../../layouts/Layout.astro';

// SEO Meta Tags
const title = "Analytics GetNexo - Aumente Ventas con Datos en Tiempo Real | GetNexo";
const description = "Dashboard de analytics completo para monitorear ventas, conversión y rendimiento de tu chatbot WhatsApp. Aumenta ventas con insights inteligentes y reportes automáticos!";
const keywords = "analytics getnexo, dashboard ventas, métricas chatbot, reportes automáticos, aumento ventas, performance WhatsApp";
const canonical = "https://getnexo.com.br/es/analytics";

// Structured Data - Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "logo": "https://getnexo.com.br/logo.png",
  "sameAs": [
    "https://www.linkedin.com/company/getnexo",
    "https://twitter.com/getnexo",
    "https://github.com/getnexo"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+5511999999999",
    "contactType": "customer service",
    "areaServed": "BR",
    "availableLanguage": "es"
  }
};

// WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://getnexo.com.br/buscar?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://getnexo.com.br"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Analytics",
      "item": "https://getnexo.com.br/es/analytics"
    }
  ]
};

// SoftwareApplication Schema
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
    "image": "https://getnexo.com.br/assets/og-poster.jpg",
  "name": "GetNexo - Analytics Avançado",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "97",
    "priceCurrency": "BRL",
    "availability": "https://schema.org/InStock"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "ratingCount": "5000"
  }
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cómo el analytics aumenta ventas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Con datos en tiempo real, identificas oportunidades, optimizas funnels de ventas y tomas decisiones basadas en métricas, aumentando conversiones hasta en 40%."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué métricas se monitorean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Conversión, tasa de respuesta, tiempo de atención, satisfacción del cliente, ROI, comportamiento del usuario y mucho más."
      }
    },
    {
      "@type": "Question",
      "name": "¿Los reportes son automáticos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "¡Sí! Recibe reportes diarios, semanales y mensuales automáticos por email o WhatsApp."
      }
    }
  ]
};

// Metrics data
const metrics = [
  {
    icon: "📈",
    title: "Conversión",
    value: "42%",
    change: "+15%",
    desc: "Tasa de conversión de leads a ventas",
    trend: "up"
  },
  {
    icon: "⚡",
    title: "Tiempo Respuesta",
    value: "2.3s",
    change: "-40%",
    desc: "Promedio de respuesta del chatbot",
    trend: "down"
  },
  {
    icon: "😊",
    title: "Satisfacción",
    value: "4.9/5",
    change: "+0.3",
    desc: "Evaluación de los clientes",
    trend: "up"
  },
  {
    icon: "💰",
    title: "ROI",
    value: "320%",
    change: "+80%",
    desc: "Retorno sobre inversión",
    trend: "up"
  }
];

// Features data
const features = [
  {
    icon: "📊",
    title: "Dashboard en Tiempo Real",
    desc: "Monitorea todas las métricas en un solo panel",
    benefits: [
      "Actualización cada segundo",
      "Gráficos interactivos",
      "Filtros avanzados",
      "Exportación de datos"
    ],
    stats: ["+40% velocidad", "99.9% uptime", "Datos en tiempo real"]
  },
  {
    icon: "🎯",
    title: "Funnel de Ventas Inteligente",
    desc: "Visualiza cada etapa del proceso de ventas",
    benefits: [
      "Identificación de cuellos de botella",
      "Optimización automática",
      "Previsión de conversión",
      "A/B testing integrado"
    ],
    stats: ["+35% conversión", "Identificación en 2min", "ROI mensurable"]
  },
  {
    icon: "🔔",
    title: "Alertas Inteligentes",
    desc: "Recibe notificaciones cuando las métricas cambien",
    benefits: [
      "Alertas por email/WhatsApp",
      "Configuración personalizada",
      "Acciones automáticas",
      "Integración con Slack"
    ],
    stats: ["+50% agilidad", "Respuesta en 5min", "Sin pérdidas"]
  },
  {
    icon: "🤖",
    title: "Insights con IA",
    desc: "Recomendaciones automáticas para mejorar rendimiento",
    benefits: [
      "Análisis predictivo",
      "Sugerencias de optimización",
      "Benchmarking del mercado",
      "Reportes automáticos"
    ],
    stats: ["+25% optimización", "Decisiones basadas", "ROI comprobado"]
  },
  {
    icon: "📱",
    title: "Reportes Automáticos",
    desc: "Recibe reportes diarios, semanales y mensuales",
    benefits: [
      "Envío automático",
      "Personalización completa",
      "Comparativo histórico",
      "Exportación en PDF/Excel"
    ],
    stats: ["-90% tiempo", "Sin errores", "Siempre actualizado"]
  },
  {
    icon: "🔗",
    title: "Integraciones",
    desc: "Conecta con tus herramientas favoritas",
    benefits: [
      "Google Analytics",
      "CRM (HubSpot, Salesforce)",
      "E-commerce (Shopify, WooCommerce)",
      "API completa"
    ],
    stats: ["+50% eficiencia", "Datos unificados", "Sin duplicidad"]
  }
];

// Use cases data
const useCases = [
  {
    title: "E-commerce",
    desc: "Monitorea ventas, carritos abandonados y conversión",
    results: ["+45% conversión", "-30% abandono", "ROI 300%"]
  },
  {
    title: "Servicios",
    desc: "Acompaña citas y satisfacción del cliente",
    results: ["+40% retención", "Satisfacción 4.9/5", "Crecimiento 50%"]
  },
  {
    title: "Consultoría",
    desc: "Monitorea leads calificados y cierre de contratos",
    results: ["+35% cierre", "Calificación 24/7", "ROI 280%"]
  },
  {
    title: "Educación",
    desc: "Acompaña matrículas y engagement de los alumnos",
    results: ["+50% matrículas", "Engagement 85%", "Retención 90%"]
  }
];

// Testimonials data
const testimonials = [
  {
    name: "Carlos Mendes",
    role: "CEO",
    company: "TechStore",
    quote: "Con el analytics, identificamos oportunidades que generaron R$ 120k extra en 3 meses.",
    results: [
      { value: "+40%", label: "conversión" },
      { value: "R$ 120k", label: "facturación extra" },
      { value: "3 meses", label: "resultado" }
    ]
  },
  {
    name: "Ana Paula",
    role: "Gerente",
    company: "Clínica Vida",
    quote: "Los reportes automáticos nos ayudaron a reducir costos y aumentar satisfacción.",
    results: [
      { value: "-25%", label: "costos" },
      { value: "+35%", label: "satisfacción" },
      { value: "4.9/5", label: "evaluación" }
    ]
  }
];

// Stats data
const stats = [
  { value: "50+", label: "métricas", desc: "monitoradas" },
  { value: "99.9%", label: "uptime", desc: "garantido" },
  { value: "24/7", label: "monitoramento", desc: "em tempo real" },
  { value: "Grátis", label: "setup", desc: "sem cartão" }
];

// Trust badges
const trustBadges = [
  { icon: "📊", title: "Dashboard", desc: "Em tempo real" },
  { icon: "🔔", title: "Alertas", desc: "Inteligentes" },
  { icon: "🤖", title: "Insights", desc: "Com IA" },
  { icon: "📈", title: "ROI", desc: "Comprovado" }
];
---

<Layout title={title} description={description} keywords={keywords}>

  <!-- SEO Schemas -->
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="analytics-hero" aria-label="Analytics GetNexo">
    <div class="hero-badge">📊 Analytics Avanzado</div>
    <h1>Analytics que <span class="text-gradient">Aumentan Ventas</span></h1>
    <p class="hero-desc">
      Dashboard completo con <strong>datos en tiempo real</strong>, insights con IA y reportes automáticos. <strong>Aumenta ventas en 40%+</strong> con decisiones basadas en métricas!
    </p>

    <!-- Trust Badges -->
    <div class="trust-badges">
      {trustBadges.map(badge => (
        <div class="trust-badge">
          <span class="trust-icon">{badge.icon}</span>
          <div>
            <strong>{badge.title}</strong>
            <span>{badge.desc}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-ctas">
      <a href="/crear-bot" class="btn-primary-glow" aria-label="Comenzar analytics">
        Comenzar Analytics
      </a>
      <a href="/contacto" class="btn-outline" aria-label="Ver dashboard">
        Ver Dashboard
      </a>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="max-w-6xl mx-auto px-5">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map(stat => (
          <div class="stat-card glass-panel p-6 text-center">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-desc">{stat.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Metrics Section -->
  <section class="metrics-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Métricas en <span class="text-gradient">Tiempo Real</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Monitorea todas las métricas importantes en un solo panel</p>
      </div>

      <div class="metrics-grid">
        {metrics.map(metric => (
          <div class="metric-card glass-panel p-8 rounded-3xl">
            <div class="metric-header">
              <span class="metric-icon">{metric.icon}</span>
              <div class="metric-change">
                <span class={`change-value ${metric.trend === 'up' ? 'up' : 'down'}`}>
                  {metric.change}
                </span>
              </div>
            </div>
            <div class="metric-value">{metric.value}</div>
            <div class="metric-title">{metric.title}</div>
            <div class="metric-desc">{metric.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Recursos del <span class="text-gradient">Dashboard</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Todo lo que necesitas para monitorear y optimizar ventas</p>
      </div>

      <div class="features-grid">
        {features.map(feature => (
          <div class="feature-card glass-panel p-8 rounded-3xl">
            <div class="feature-icon">{feature.icon}</div>
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-desc">{feature.desc}</p>
            <ul class="feature-benefits">
              {feature.benefits.map(benefit => (
                <li class="benefit-item">
                  <span class="benefit-check">✓</span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
            <div class="feature-stats">
              {feature.stats.map(stat => (
                <span class="stat-tag">{stat}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="use-cases-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Casos de <span class="text-gradient">Uso</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Ve cómo diferentes segmentos usan analytics para crecer</p>
      </div>

      <div class="use-cases-grid">
        {useCases.map(useCase => (
          <div class="use-case-card glass-panel p-8 rounded-3xl">
            <h3 class="use-case-title">{useCase.title}</h3>
            <p class="use-case-desc">{useCase.desc}</p>
            <div class="use-case-results">
              {useCase.results.map(result => (
                <span class="result-tag">{result}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Depoimentos de <span class="text-gradient">Clientes</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Lo que nuestros clientes dicen sobre los resultados</p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map(testimonial => (
          <div class="testimonial-card glass-panel p-8 rounded-3xl">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <span class="avatar-placeholder">{testimonial.name.charAt(0)}</span>
              </div>
              <div>
                <h3 class="testimonial-name">{testimonial.name}</h3>
                <p class="testimonial-role">{testimonial.role}</p>
                <p class="testimonial-company">{testimonial.company}</p>
              </div>
            </div>
            <blockquote class="testimonial-quote">"{testimonial.quote}"</blockquote>
            <div class="testimonial-results">
              {testimonial.results.map(result => (
                <div class="result-item">
                  <span class="result-value">{result.value}</span>
                  <span class="result-label">{result.label}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="max-w-4xl mx-auto px-5">
      <h2 class="text-center text-3xl font-bold text-white mb-4">Preguntas <span class="text-gradient">Frecuentes</span></h2>
      <p class="text-center text-slate-400 mb-12">Resuelve tus dudas sobre analytics</p>
      
      <div class="space-y-4">
        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            ¿Cómo el analytics aumenta ventas?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Con datos en tiempo real, identificas oportunidades, optimizas funnels de ventas y tomas decisiones basadas en métricas, aumentando conversiones hasta en 40%.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            ¿Qué métricas se monitorean?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Conversión, tasa de respuesta, tiempo de atención, satisfacción del cliente, ROI, comportamiento del usuario y mucho más.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            ¿Los reportes son automáticos?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            ¡Sí! Recibe reportes diarios, semanales y mensuales automáticos por email o WhatsApp.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            ¿Puedo exportar los datos?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            ¡Sí! Exporta datos en PDF, Excel o CSV. También ofrecemos API para integraciones personalizadas.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            ¿Cómo funciona el dashboard?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            Dashboard intuitivo con gráficos interactivos, filtros avanzados y actualización en tiempo real. Accede vía web o mobile.
          </p>
        </details>

        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            ¿Tiene integración con otras herramientas?
            <span class="text-blue-400 text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            ¡Sí! Se integra con Google Analytics, HubSpot, Salesforce, Shopify, WooCommerce y muchas otras vía API.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Implementation Guide -->
  <section class="implementation-section py-20 px-5 max-w-6xl mx-auto">
    <div class="glass-panel p-12 rounded-3xl">
      <h2 class="text-3xl font-bold text-white mb-6 text-center">Guía de <span class="text-gradient">Implementación</span></h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="step-number">1</div>
          <h3 class="text-xl font-bold text-white mb-2">Conecte</h3>
          <p class="text-slate-400">Integra con tu chatbot y herramientas existentes</p>
        </div>
        <div class="text-center">
          <div class="step-number">2</div>
          <h3 class="text-xl font-bold text-white mb-2">Configure</h3>
          <p class="text-slate-400">Define métricas y alertas que importan para ti</p>
        </div>
        <div class="text-center">
          <div class="step-number">3</div>
          <h3 class="text-xl font-bold text-white mb-2">Monitoree</h3>
          <p class="text-slate-400">Acompaña resultados y toma decisiones inteligentes</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta py-20 text-center px-4">
    <div class="max-w-4xl mx-auto glass-panel p-12 rounded-3xl">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-6">¿Listo para <span class="text-blue-400">dominar</span> tus datos?</h2>
      <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto">
        Comienza con GetNexo y transforma datos en ventas reales.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/crear-bot" class="btn-primary-glow bg-blue-600 hover:bg-blue-500" aria-label="Comenzar analytics">
          Comenzar Analytics
        </a>
        <a href="/contacto" class="px-10 py-5 bg-transparent border border-blue-500 text-blue-400 font-bold rounded-2xl hover:bg-blue-500 hover:text-white transition-colors text-lg" aria-label="Ver dashboard">
          Ver Dashboard
        </a>
      </div>
      <p class="mt-8 text-sm text-slate-500">
        ✅ Sin tarjeta de crédito • ✅ Cancelación fácil • ✅ Soporte en español
      </p>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .analytics-hero { 
    padding: 8rem 5% 4rem; 
    text-align: center; 
    max-width: 1300px; 
    margin: 0 auto; 
  }
  
  .hero-badge { 
    background: rgba(34, 197, 94, 0.1); 
    color: #22c55e; 
    padding: 0.5rem 1.2rem; 
    border-radius: 50px; 
    font-size: 0.85rem; 
    font-weight: 700; 
    border: 1px solid rgba(34, 197, 94, 0.2); 
    display: inline-block; 
    margin-bottom: 2rem; 
  }
  
  .analytics-hero h1 { 
    font-size: 3.5rem; 
    margin-bottom: 1.5rem; 
    color: white;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  
  .hero-desc { 
    font-size: 1.35rem; 
    color: #94a3b8; 
    max-width: 900px; 
    margin: 0 auto 3rem; 
    line-height: 1.6;
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
  }
  .trust-icon {
    font-size: 1.5rem;
  }
  .trust-badge strong {
