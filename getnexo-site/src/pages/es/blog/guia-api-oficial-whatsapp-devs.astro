---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Guía API Oficial de WhatsApp: Todo lo que los Desarrolladores Necesitan",
      "description": "Guía API Oficial de WhatsApp para Devs | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Guía API Oficial de WhatsApp para Devs | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Guía API Oficial de WhatsApp:<br/><span class="text-primary">Todo lo que los Desarrolladores Necesitan</span></h1>
    <p>Todo lo que necesita para una integración robusta y escalable.</p>
    <a href="/es/crear-bot" class="btn-primary">Ver Documentación</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
