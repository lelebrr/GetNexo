---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Gamificación de Ventas: Estrategias de Elite",
      "description": "Transforme metas en logros y vendedores en campeones.",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Productividad"
    }
  ]
};
---
<Layout
  title="Gamificación de Ventas: Estrategias de Elite | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <header class="post-header">
      <div class="meta">Productividad • Ene 2026</div>
      <h1>Gamificación de Ventas:<br/><span class="text-primary">Estrategias de Elite</span></h1>
      <p class="subtitle">Transforme metas en logros y vendedores en campeones.</p>
    </header>
    <div class="post-content">
      <p>La gamificación no es solo juegos; es resultados.</p>
      <a href="/es/crear-bot" class="btn-primary">Comenzar</a>
    </div>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  .post-header { text-align: center; margin-bottom: 5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
