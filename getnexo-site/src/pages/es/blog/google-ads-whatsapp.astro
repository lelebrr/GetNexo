---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Google Ads para WhatsApp: La Estrategia de Conversión Oculta",
      "description": "Google Ads para WhatsApp: La Estrategia Oculta | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Google Ads para WhatsApp: La Estrategia Oculta | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Google Ads para WhatsApp:<br/><span class="text-primary">La Estrategia de Conversión Oculta</span></h1>
    <p>Capture la intención de búsqueda y muévala directamente a una conversación personal.</p>
    <a href="/es/crear-bot" class="btn-primary">Conectar Google Ads</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
