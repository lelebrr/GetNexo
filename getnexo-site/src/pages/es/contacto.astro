---
import Layout from '../../layouts/Layout.astro';

const title = "Contacto GetNexo | Soporte, Privacidad y Solicitudes LGPD/GDPR";
const description = "Contacte con GetNexo. Soporte técnico, solicitudes de derechos ARCO (LGPD), DPO, dudas sobre privacidad y datos personales.";
const keywords = "contacto getnexo, soporte whatsapp api, derechos lgpd, dpo getnexo, privacidad datos, solicitar eliminación datos, soporte técnico";
---

<Layout title={title} description={description} keywords={keywords}>
  <section class="contact-hero">
    <div class="hero-badge">Contacto</div>
    <h1 class="text-gradient">Hable con nosotros</h1>
    <p>Soporte técnico, solicitudes de derechos ARCO (LGPD) y atención personalizada.</p>
  </section>

  <section class="contact-content">
    <div class="contact-grid">
      <!-- General Support -->
      <div class="contact-card">
        <div class="card-header">
          <div class="card-icon">💬</div>
          <h3>Soporte General</h3>
        </div>
        <div class="card-body">
          <p>Dudas sobre instalación, configuración o uso de la plataforma.</p>
          <div class="contact-methods">
            <a href="https://wa.me/5511999999999?text=Hola%20GetNexo!%20Necesito%20ayuda..." target="_blank" class="contact-link whatsapp">
              <span>📱</span> WhatsApp
            </a>
            <a href="mailto:soporte@getnexo.com.br" class="contact-link email">
              <span>📧</span> soporte@getnexo.com.br
            </a>
          </div>
        </div>
      </div>

      <!-- Privacy and LGPD -->
      <div class="contact-card featured">
        <div class="card-header">
          <div class="card-icon">🔒</div>
          <h3>Privacidad & LGPD</h3>
        </div>
        <div class="card-body">
          <p>Solicitudes de derechos ARCO, dudas sobre protección de datos y DPO.</p>
          <div class="contact-methods">
            <a href="mailto:dpo@getnexo.com.br" class="contact-link email">
              <span>🛡️</span> dpo@getnexo.com.br
            </a>
            <a href="mailto:privacidad@getnexo.com.br" class="contact-link email">
              <span>📋</span> privacidad@getnexo.com.br
            </a>
          </div>
          <div class="lgpd-notice">
            <p><strong>Datos del Controlador:</strong></p>
            <p>GetNexo Tecnologia Ltda.<br>CNPJ/ID: 45.678.901/0001-23<br>Encargado: Leandro Brandão</p>
          </div>
        </div>
      </div>

      <!-- Sales and Partnerships -->
      <div class="contact-card">
        <div class="card-header">
          <div class="card-icon">🚀</div>
          <h3>Ventas & Alianzas</h3>
        </div>
        <div class="card-body">
          <p>Demostraciones, propuestas comerciales y programa de revendedores.</p>
          <div class="contact-methods">
            <a href="https://wa.me/5511999999999?text=Hola!%20Me%20gustaría%20saber%20más%20sobre%20GetNexo..." target="_blank" class="contact-link whatsapp">
              <span>📱</span> WhatsApp Ventas
            </a>
            <a href="mailto:ventas@getnexo.com.br" class="contact-link email">
              <span>📧</span> ventas@getnexo.com.br
            </a>
          </div>
        </div>
      </div>

      <!-- Legal -->
      <div class="contact-card">
        <div class="card-header">
          <div class="card-icon">⚖️</div>
          <h3>Asuntos Legales</h3>
        </div>
        <div class="card-body">
          <p>Contratos, cumplimiento y cuestiones legales.</p>
          <div class="contact-methods">
            <a href="mailto:juridico@getnexo.com.br" class="contact-link email">
              <span>📜</span> juridico@getnexo.com.br
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Formulario de Solicitud LGPD -->
    <div class="lgpd-form-section">
      <div class="glass-panel lgpd-form-wrap">
        <h2>Solicitud de Derechos ARCO (LGPD/GDPR)</h2>
        <p>Utilice este formulario para ejercer sus derechos bajo la Ley General de Protección de Datos:</p>

        <form id="lgpd-request-form" class="lgpd-form">
          <div class="form-row">
            <div class="form-group">
              <label for="requester-name">Nombre Completo *</label>
              <input type="text" id="requester-name" name="name" required placeholder="Su nombre completo" />
            </div>
            <div class="form-group">
              <label for="requester-email">Correo electrónico *</label>
              <input type="email" id="requester-email" name="email" required placeholder="su@email.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="requester-doc">Identificación / Tax ID *</label>
              <input type="text" id="requester-doc" name="document" required placeholder="000.000.000-00 o ID equivalente" />
            </div>
            <div class="form-group">
              <label for="requester-phone">Teléfono (WhatsApp)</label>
              <input type="tel" id="requester-phone" name="phone" placeholder="+54 11 9999-9999" />
            </div>
          </div>

          <div class="form-group">
            <label for="request-type">Tipo de Solicitud *</label>
            <select id="request-type" name="request_type" required>
              <option value="">Seleccione el derecho que desea ejercer</option>
              <option value="confirmacion">Confirmación de tratamiento de datos</option>
              <option value="acceso">Acceso a los datos personales</option>
              <option value="correccion">Corrección de datos incompletos/inexactos</option>
              <option value="anonimizacion">Anonimización de datos</option>
              <option value="portabilidad">Portabilidad de los datos</option>
              <option value="eliminacion">Eliminación de los datos</option>
              <option value="informacion">Información sobre intercambio</option>
              <option value="oposicion">Oposición al tratamiento</option>
              <option value="revocacion">Revocación de consentimiento</option>
              <option value="otro">Otro (especificar abajo)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="request-description">Descripción de la Solicitud *</label>
            <textarea id="request-description" name="description" required rows="4" placeholder="Describa detalladamente su solicitud. Incluya información que nos ayude a identificar sus datos (periodo aproximado de uso, servicios utilizados, etc.)"></textarea>
          </div>

          <div class="form-group">
            <label for="request-evidence">Evidencias/Comprobación (Opcional)</label>
            <input type="file" id="request-evidence" name="evidence" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
            <small>Formatos aceptados: PDF, JPG, PNG, DOC, DOCX (máx. 5MB)</small>
          </div>

          <div class="form-consent">
            <input type="checkbox" id="lgpd-consent" name="consent" required />
            <label for="lgpd-consent">
              Declaro que la información proporcionada es verdadera y que soy consciente de que la solicitud será procesada conforme a la LGPD/GDPR. *
            </label>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary">Enviar Solicitud</button>
            <button type="reset" class="btn-secondary">Limpiar Formulario</button>
          </div>
        </form>

        <div class="lgpd-info">
          <h3>ℹ️ Sobre los Derechos ARCO</h3>
          <p>Los derechos ARCO (Acceso, Rectificación, Cancelación y Oposición) están previstos en la ley. Procesaremos su solicitud en un plazo de 15 días hábiles, prorrogable por otros 15 días cuando sea necesario.</p>
          <p><strong>Respuesta garantizada:</strong> Recibirá confirmación de recepción en un plazo de 24 horas y respuesta final en el plazo legal.</p>
        </div>
      </div>
    </div>

    <!-- Horarios de Atendimento -->
    <div class="support-hours">
      <h2>Horarios de Atención</h2>
      <div class="hours-grid">
        <div class="hours-item">
          <h4>Soporte Técnico</h4>
          <p>Lunes a Viernes: 9h a 18h<br>Sábado: 9h a 12h (BRT)</p>
        </div>
        <div class="hours-item">
          <h4>Privacidad & LGPD</h4>
          <p>Lunes a Viernes: 9h a 18h<br>Respuesta en hasta 24h</p>
        </div>
        <div class="hours-item">
          <h4>Emergencias</h4>
          <p>24/7 para cuestiones críticas<br>WhatsApp: +55 11 99999-9999</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
/* Reusing styles from contact.astro */
  .contact-hero { text-align: center; padding: 10rem 5% 4rem; }
  .hero-badge { background: rgba(0, 212, 255, 0.1); color: #00d4ff; padding: 0.5rem 1.2rem; border-radius: 50px; font-size: 0.85rem; font-weight: 700; display: inline-block; margin-bottom: 2rem; border: 1px solid rgba(0,212,255,0.2); }
  .contact-hero h1 { font-size: 3rem; margin-bottom: 1rem; font-weight: 800; }
  .contact-hero p { color: #94a3b8; font-size: 1.25rem; max-width: 600px; margin: 0 auto; }
  .contact-content { max-width: 1200px; margin: 0 auto; padding: 4rem 5% 10rem; }
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 6rem; }
  .contact-card { background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 20px; padding: 2rem; transition: 0.3s; }
  .contact-card:hover { transform: translateY(-5px); border-color: rgba(0, 212, 255, 0.2); }
  .contact-card.featured { border-color: rgba(0, 255, 157, 0.3); background: rgba(0, 255, 157, 0.02); }
  .card-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .card-icon { font-size: 2rem; width: 60px; height: 60px; background: rgba(0, 212, 255, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .card-header h3 { font-size: 1.5rem; font-weight: 800; color: white; margin: 0; }
  .card-body p { color: #94a3b8; line-height: 1.6; margin-bottom: 1.5rem; }
  .contact-methods { display: flex; flex-direction: column; gap: 0.5rem; }
  .contact-link { display: flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1rem; background: rgba(255, 255, 255, 0.05); border-radius: 8px; color: #cbd5e1; text-decoration: none; transition: 0.3s; }
  .contact-link:hover { background: rgba(255, 255, 255, 0.1); color: white; transform: translateX(5px); }
  .contact-link.whatsapp:hover { background: #25d366; color: white; }
  .lgpd-notice { margin-top: 1.5rem; padding: 1rem; background: rgba(255, 255, 255, 0.03); border-radius: 8px; border-left: 3px solid #00d4ff; }
  .lgpd-notice p { margin: 0.3rem 0; font-size: 0.85rem; color: #cbd5e1; }
  .lgpd-form-section { margin-bottom: 6rem; }
  .lgpd-form-wrap { padding: 3rem; border-radius: 24px; border-color: rgba(0, 212, 255, 0.2); }
  .lgpd-form-wrap h2 { color: white; font-size: 2rem; font-weight: 800; margin-bottom: 1rem; }
  .lgpd-form-wrap > p { color: #94a3b8; margin-bottom: 2rem; line-height: 1.6; }
  .lgpd-form { display: flex; flex-direction: column; gap: 1.5rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
  .form-group label { color: white; font-weight: 600; font-size: 0.9rem; }
  .form-group input, .form-group select, .form-group textarea { padding: 1rem; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; color: white; font-size: 1rem; outline: none; transition: 0.3s; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #00d4ff; background: rgba(0, 0, 0, 0.5); }
  .form-consent { display: flex; align-items: flex-start; gap: 0.5rem; padding: 1rem; background: rgba(255, 255, 255, 0.03); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05); }
  .form-consent input[type="checkbox"] { margin-top: 0.2rem; width: 16px; height: 16px; accent-color: #00d4ff; }
  .form-consent label { color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0; cursor: pointer; }
  .form-actions { display: flex; gap: 1rem; justify-content: center; margin-top: 1rem; }
  .btn-primary { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1rem 2rem; border-radius: 8px; font-weight: 700; cursor: pointer; border: none; font-size: 1rem; transition: 0.3s; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0, 212, 255, 0.3); }
  .btn-secondary { background: rgba(255, 255, 255, 0.1); color: white; border: 1px solid rgba(255, 255, 255, 0.2); padding: 1rem 2rem; border-radius: 8px; font-weight: 700; cursor: pointer; border: none; font-size: 1rem; transition: 0.3s; }
  .lgpd-info { margin-top: 3rem; padding: 2rem; background: rgba(255, 255, 255, 0.02); border-radius: 12px; border-left: 4px solid #00ff9d; }
  .lgpd-info h3 { color: #00ff9d; margin-bottom: 1rem; font-size: 1.2rem; }
  .lgpd-info p { color: #cbd5e1; line-height: 1.6; margin-bottom: 1rem; }
  .support-hours { text-align: center; }
  .support-hours h2 { color: white; font-size: 2rem; font-weight: 800; margin-bottom: 2rem; }
  .hours-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 2rem; }
  .hours-item { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 16px; padding: 2rem; }
  .hours-item h4 { color: #00d4ff; font-size: 1.2rem; font-weight: 700; margin-bottom: 1rem; }
  .hours-item p { color: #94a3b8; line-height: 1.6; margin: 0; }
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } .form-row { grid-template-columns: 1fr; } .lgpd-form-wrap { padding: 2rem; } .hours-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  // Form handling for LGPD/GDPR requests
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('lgpd-request-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        // Similar logic as in English version, translated alerts
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        if (!data.name || !data.email || !data.document || !data.request_type || !data.description) {
          alert('Por favor, complete todos los campos obligatorios.');
          return;
        }
        // ... (remaining script logic from PT/EN version)
      });
    }
  });
</script>
</Layout>
