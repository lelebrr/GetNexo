---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Perfil | OmniNexo">
    <div style="display:flex; flex-direction:column; gap:2rem;">

        <div style="display:flex; justify-content:space-between; align-items:center;">
            <h1 style="font-size:1.8rem; font-weight:800; color:white; margin:0;">Meu Perfil</h1>
            <button style="background:var(--neon-blue); color:black; font-weight:800; border:none; padding:10px 20px; border-radius:8px; cursor:pointer;">
                Salvar Alterações
            </button>
        </div>

        <div style="display:grid; grid-template-columns: 1fr 2fr; gap:2rem;">

            <!-- Profile Card -->
            <div class="glass-panel" style="padding:2rem; text-align:center;">
                <div style="margin-bottom:2rem;">
                    <img src="https://ui-avatars.com/api/?name=Admin&background=00d4ff&color=000&size=120" style="width:120px; height:120px; border-radius:50%; border:4px solid var(--neon-blue);" alt="Profile" />
                </div>

                <h2 style="color:white; font-size:1.5rem; margin:0 0 0.5rem;">Admin User</h2>
                <p style="color:#94a3b8; margin:0 0 2rem;">admin@getnexo.com.br</p>

                <div style="display:flex; flex-direction:column; gap:1rem;">
                    <button style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); color:white; padding:10px; border-radius:8px; cursor:pointer;">
                        📷 Alterar Foto
                    </button>
                    <button style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); color:white; padding:10px; border-radius:8px; cursor:pointer;">
                        🔐 Alterar Senha
                    </button>
                </div>
            </div>

            <!-- Profile Form -->
            <div class="glass-panel" style="padding:2rem;">
                <h3 style="color:white; font-size:1.3rem; margin:0 0 2rem;">Informações Pessoais</h3>

                <form style="display:flex; flex-direction:column; gap:1.5rem;">

                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:1rem;">
                        <div>
                            <label style="display:block; color:#e5e7eb; font-size:0.9rem; font-weight:600; margin-bottom:0.5rem;">Nome</label>
                            <input type="text" value="Admin" style="width:100%; padding:0.8rem; background:rgba(15,23,42,0.6); border:1px solid #334155; border-radius:8px; color:white;" />
                        </div>
                        <div>
                            <label style="display:block; color:#e5e7eb; font-size:0.9rem; font-weight:600; margin-bottom:0.5rem;">Sobrenome</label>
                            <input type="text" value="User" style="width:100%; padding:0.8rem; background:rgba(15,23,42,0.6); border:1px solid #334155; border-radius:8px; color:white;" />
                        </div>
                    </div>

                    <div>
                        <label style="display:block; color:#e5e7eb; font-size:0.9rem; font-weight:600; margin-bottom:0.5rem;">E-mail</label>
                        <input type="email" value="admin@getnexo.com.br" style="width:100%; padding:0.8rem; background:rgba(15,23,42,0.6); border:1px solid #334155; border-radius:8px; color:white;" />
                    </div>

                    <div>
                        <label style="display:block; color:#e5e7eb; font-size:0.9rem; font-weight:600; margin-bottom:0.5rem;">Telefone</label>
                        <input type="tel" value="+55 11 99999-9999" style="width:100%; padding:0.8rem; background:rgba(15,23,42,0.6); border:1px solid #334155; border-radius:8px; color:white;" />
                    </div>

                    <div>
                        <label style="display:block; color:#e5e7eb; font-size:0.9rem; font-weight:600; margin-bottom:0.5rem;">Empresa</label>
                        <input type="text" value="GetNexo Tecnologia" style="width:100%; padding:0.8rem; background:rgba(15,23,42,0.6); border:1px solid #334155; border-radius:8px; color:white;" />
                    </div>

                    <div>
                        <label style="display:block; color:#e5e7eb; font-size:0.9rem; font-weight:600; margin-bottom:0.5rem;">Cargo</label>
                        <input type="text" value="Administrador" style="width:100%; padding:0.8rem; background:rgba(15,23,42,0.6); border:1px solid #334155; border-radius:8px; color:white;" />
                    </div>

                </form>
            </div>

        </div>

        <!-- Security Settings -->
        <div class="glass-panel" style="padding:2rem;">
            <h3 style="color:white; font-size:1.3rem; margin:0 0 2rem;">Configurações de Segurança</h3>

            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap:1.5rem;">

                <div style="padding:1.5rem; border:1px solid rgba(255,255,255,0.1); border-radius:12px;">
                    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
                        <span style="font-size:1.5rem;">🔐</span>
                        <div>
                            <h4 style="color:white; margin:0; font-size:1rem;">Autenticação de Dois Fatores</h4>
                            <p style="color:#94a3b8; margin:0; font-size:0.8rem;">Adicione uma camada extra de segurança</p>
                        </div>
                    </div>
                    <button style="background:var(--neon-blue); color:black; font-weight:700; border:none; padding:8px 16px; border-radius:6px; cursor:pointer;">
                        Configurar 2FA
                    </button>
                </div>

                <div style="padding:1.5rem; border:1px solid rgba(255,255,255,0.1); border-radius:12px;">
                    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem;">
                        <span style="font-size:1.5rem;">📱</span>
                        <div>
                            <h4 style="color:white; margin:0; font-size:1rem;">Sessões Ativas</h4>
                            <p style="color:#94a3b8; margin:0; font-size:0.8rem;">Gerencie seus dispositivos conectados</p>
                        </div>
                    </div>
                    <button style="background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.2); padding:8px 16px; border-radius:6px; cursor:pointer;">
                        Ver Sessões
                    </button>
                </div>

            </div>
        </div>

    </div>

    <script is:inline>
        // Profile page interactions
        document.addEventListener('DOMContentLoaded', () => {
            // Add form validation and save functionality
            const form = document.querySelector('form');
            if(form) {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    alert('Perfil atualizado com sucesso!');
                });
            }
        });
    </script>
</DashboardLayout>