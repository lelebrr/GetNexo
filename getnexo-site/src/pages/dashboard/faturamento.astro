---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Faturamento | OmniNexo">

    <div style="text-align:center; margin-bottom:3rem;">
        <h1 style="font-size:2.5rem; font-weight:800; color:white; margin:0; letter-spacing:-1px;">Faturamento & Planos</h1>
        <p style="color:#94a3b8; font-size:1.1rem;">Gerencie sua assinatura e desbloqueie o poder total da IA.</p>
    </div>

    <!-- Usage Stats -->
    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:1.5rem; margin-bottom:3rem;">
        <div class="glass-panel" style="padding:1.5rem;">
            <div style="font-size:0.8rem; color:#64748b; font-weight:700; text-transform:uppercase;">Conversas IA (Mensal)</div>
            <div style="font-size:2rem; font-weight:900; color:white; margin:0.5rem 0;">1.240 <span style="font-size:1rem; color:#64748b;">/ 2.000</span></div>
            <div class="progress-bar"><div class="fill" style="width:62%; background:var(--neon-green);"></div></div>
        </div>
        <div class="glass-panel" style="padding:1.5rem;">
            <div style="font-size:0.8rem; color:#64748b; font-weight:700; text-transform:uppercase;">Membros da Equipe</div>
            <div style="font-size:2rem; font-weight:900; color:white; margin:0.5rem 0;">3 <span style="font-size:1rem; color:#64748b;">/ 5</span></div>
            <div class="progress-bar"><div class="fill" style="width:60%; background:var(--neon-blue);"></div></div>
        </div>
        <div class="glass-panel" style="padding:1.5rem;">
            <div style="font-size:0.8rem; color:#64748b; font-weight:700; text-transform:uppercase;">Armazenamento</div>
            <div style="font-size:2rem; font-weight:900; color:white; margin:0.5rem 0;">4.2 GB <span style="font-size:1rem; color:#64748b;">/ 10 GB</span></div>
            <div class="progress-bar"><div class="fill" style="width:42%; background:#a78bfa;"></div></div>
        </div>
    </div>

    <style>
        .progress-bar { width: 100%; height: 6px; background: rgba(255,255,255,0.05); border-radius: 3px; overflow: hidden; margin-top: 10px; }
        .fill { height: 100%; border-radius: 3px; }
        .plan-card { position: relative; border: 1px solid rgba(255,255,255,0.05); transition: 0.3s; }
        .plan-card:hover { transform: translateY(-10px); border-color: var(--neon-blue); box-shadow: 0 10px 40px rgba(0,212,255,0.1); }
        .plan-card.active { border-color: var(--neon-green); background: rgba(0,255,157,0.05); }
    </style>

    <!-- Plans -->
    <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:2rem; align-items:flex-start;">
        
        <!-- Starter Plan -->
        <div class="glass-panel plan-card" style="padding:2rem;">
            <h3 style="margin:0; font-size:1.5rem; color:white;">Starter</h3>
            <div style="font-size:2.5rem; font-weight:900; color:white; margin:1rem 0;">R$ 97<span style="font-size:1rem; color:#64748b;">/mês</span></div>
            <ul style="list-style:none; padding:0; color:#94a3b8; line-height:1.8; margin-bottom:2rem;">
                <li>✅ 1 Número WhatsApp</li>
                <li>✅ 1.000 Conversas IA</li>
                <li>✅ 1 Usuário</li>
                <li>❌ Suporte Prioritário</li>
            </ul>
            <button style="width:100%; padding:12px; background:rgba(255,255,255,0.05); color:white; border:none; border-radius:8px; cursor:pointer;">Plano Atual</button>
        </div>

        <!-- Professional Plan -->
        <div class="glass-panel plan-card active" style="padding:2rem; border-color:var(--neon-green);">
            <div style="position:absolute; top:-12px; left:50%; transform:translateX(-50%); background:var(--neon-green); color:black; font-weight:800; padding:4px 12px; border-radius:20px; font-size:0.75rem;">MAIS POPULAR</div>
            <h3 style="margin:0; font-size:1.5rem; color:white;">Professional</h3>
            <div style="font-size:2.5rem; font-weight:900; color:white; margin:1rem 0;">R$ 297<span style="font-size:1rem; color:#64748b;">/mês</span></div>
            <ul style="list-style:none; padding:0; color:#cbd5e1; line-height:1.8; margin-bottom:2rem;">
                <li>✅ <b>3 Números WhatsApp</b></li>
                <li>✅ <b>5.000 Conversas IA</b></li>
                <li>✅ 5 Usuários</li>
                <li>✅ Suporte via Chat</li>
            </ul>
            <button style="width:100%; padding:12px; background:var(--neon-green); color:black; font-weight:800; border:none; border-radius:8px; cursor:pointer;">Fazer Upgrade 🚀</button>
        </div>

        <!-- Enterprise -->
        <div class="glass-panel plan-card" style="padding:2rem;">
            <h3 style="margin:0; font-size:1.5rem; color:white;">Enterprise</h3>
            <div style="font-size:2.5rem; font-weight:900; color:white; margin:1rem 0;">R$ 997<span style="font-size:1rem; color:#64748b;">/mês</span></div>
            <ul style="list-style:none; padding:0; color:#94a3b8; line-height:1.8; margin-bottom:2rem;">
                <li>✅ Ilimitados Números</li>
                <li>✅ IA Ilimitada</li>
                <li>✅ Equipe Ilimitada</li>
                <li>✅ Gerente de Conta Dedicado</li>
            </ul>
            <button style="width:100%; padding:12px; background:var(--neon-blue); color:black; font-weight:800; border:none; border-radius:8px; cursor:pointer;">Falar com Consultor</button>
        </div>
    </div>

    <!-- History -->
    <div style="margin-top:4rem;">
        <h2 style="font-size:1.5rem; font-weight:800; color:white; margin-bottom:1.5rem;">Histórico de Pagamentos</h2>
        <div class="glass-panel" style="padding:0; overflow:hidden;">
            <table style="width:100%; border-collapse:collapse;">
                <tbody style="font-size:0.9rem;">
                    <tr style="border-bottom:1px solid rgba(255,255,255,0.03);">
                        <td style="padding:1.5rem; color:white;">20 Jan 2026</td>
                        <td style="padding:1.5rem; color:white;">Professional (Mensal)</td>
                        <td style="padding:1.5rem; color:white;">Cartão •••• 4242</td>
                        <td style="padding:1.5rem; color:white;">R$ 297,00</td>
                        <td style="padding:1.5rem; text-align:right;"><span style="color:#10b981; background:rgba(16, 185, 129, 0.1); padding:4px 10px; border-radius:20px; font-weight:700;">Pago</span></td>
                    </tr>
                    <tr style="border-bottom:1px solid rgba(255,255,255,0.03);">
                        <td style="padding:1.5rem; color:white;">20 Dez 2025</td>
                        <td style="padding:1.5rem; color:white;">Professional (Mensal)</td>
                        <td style="padding:1.5rem; color:white;">Cartão •••• 4242</td>
                        <td style="padding:1.5rem; color:white;">R$ 297,00</td>
                        <td style="padding:1.5rem; text-align:right;"><span style="color:#10b981; background:rgba(16, 185, 129, 0.1); padding:4px 10px; border-radius:20px; font-weight:700;">Pago</span></td>
                    </tr>
                     <tr style="border-bottom:1px solid rgba(255,255,255,0.03);">
                        <td style="padding:1.5rem; color:white;">20 Nov 2025</td>
                        <td style="padding:1.5rem; color:white;">Starter (Mensal)</td>
                        <td style="padding:1.5rem; color:white;">PIX</td>
                        <td style="padding:1.5rem; color:white;">R$ 97,00</td>
                        <td style="padding:1.5rem; text-align:right;"><span style="color:#10b981; background:rgba(16, 185, 129, 0.1); padding:4px 10px; border-radius:20px; font-weight:700;">Pago</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</DashboardLayout>
