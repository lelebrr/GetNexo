---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Início | OmniNexo">
    <div style="display:flex; flex-direction:column; gap:2rem;">
        
        <!-- Welcome & Upsell Row -->
        <div style="display:grid; grid-template-columns: 2fr 1fr; gap:1.5rem;">
            <div class="glass-panel" style="padding:2rem; background:linear-gradient(90deg, rgba(0,212,255,0.1), rgba(0,255,157,0.05)); display:flex; flex-direction:column; justify-content:center;">
                <h1 style="font-size:1.8rem; font-weight:800; color:white; margin:0 0 0.5rem;">Painel de Comando</h1>
                <p style="color:#94a3b8; margin:0; font-size:1rem;">O sistema está operando com <span style="color:var(--neon-green); font-weight:700;">alta eficiência</span>. Ara monitorando 24 fluxos.</p>
            </div>
            
            <div class="glass-panel" style="padding:1.5rem; border:1px solid rgba(234, 179, 8, 0.3); background:rgba(234, 179, 8, 0.05); display:flex; align-items:center; justify-content:space-between;">
                <div>
                    <div style="font-size:0.75rem; font-weight:800; color:#fbbf24; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">Meta Mensal</div>
                    <div style="font-size:1.4rem; font-weight:900; color:white;">68% Atingida</div>
                    <div style="font-size:0.8rem; color:#fbbf24;">Faltam R$ 5.200,00 🎯</div>
                </div>
                <button style="background:#fbbf24; color:black; font-weight:800; border:none; padding:8px 16px; border-radius:8px; cursor:pointer;" onclick="accelerateGoal()">Acelerar 🚀</button>
            </div>
        </div>

        <!-- Real Metrics Grid -->
        <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:1.5rem;">
            
            <div class="glass-panel" style="padding:1.5rem; border-left:4px solid var(--neon-blue);">
                <div style="color:#64748b; font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:1px;">Vendas (Hoje)</div>
                <div id="stat-sales" style="font-size:2rem; font-weight:900; color:white; margin:0.5rem 0;">R$ 0,00</div>
                <div style="color:var(--neon-blue); font-size:0.8rem; font-weight:700;">Calculando...</div>
            </div>

            <div class="glass-panel" style="padding:1.5rem; border-left:4px solid var(--neon-green);">
                <div style="color:#64748b; font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:1px;">Conversão IA</div>
                <div style="font-size:2rem; font-weight:900; color:white; margin:0.5rem 0;">18.4%</div>
                <div style="color:var(--neon-green); font-size:0.8rem; font-weight:700;">↑ 2.1% vs ontem</div>
            </div>

            <div class="glass-panel" style="padding:1.5rem; border-left:4px solid #a78bfa;">
                <div style="color:#64748b; font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:1px;">Ticket Médio</div>
                <div style="font-size:2rem; font-weight:900; color:white; margin:0.5rem 0;">R$ 142,00</div>
                <div style="color:#a78bfa; font-size:0.8rem; font-weight:700;">Estável</div>
            </div>

            <div class="glass-panel" style="padding:1.5rem; border-left:4px solid #f472b6;">
                <div style="color:#64748b; font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:1px;">Resgates (Carrinho)</div>
                <div style="font-size:2rem; font-weight:900; color:white; margin:0.5rem 0;">R$ 890</div>
                <div style="color:#f472b6; font-size:0.8rem; font-weight:700;">Automatizado</div>
            </div>

        </div>

        <!-- Main Chart & Activity -->
        <div style="display:grid; grid-template-columns: 2fr 1fr; gap:1.5rem;">
            
            <!-- Chart Section -->
            <div class="glass-panel" style="padding:2rem;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
                    <div>
                        <h3 style="margin:0; font-size:1.2rem; font-weight:800; color:white;">Performance de Vendas</h3>
                        <p style="margin:0; font-size:0.8rem; color:#64748b;">Últimos 7 dias</p>
                    </div>
                </div>
                <div style="height:350px;">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>

            <!-- Alerts & Upsell -->
            <div style="display:flex; flex-direction:column; gap:1.5rem;">
                
                <div class="glass-panel" style="padding:1.5rem; background:rgba(0,0,0,0.3);">
                    <h3 style="margin:0 0 1rem; font-size:1rem; font-weight:800; color:white;">Alertas do Sistema</h3>
                    
                    <div style="display:flex; gap:10px; margin-bottom:1rem;">
                        <span style="font-size:1.2rem;">🟢</span>
                        <div>
                            <div style="font-size:0.85rem; font-weight:700; color:white;">WhatsApp API</div>
                            <div style="font-size:0.75rem; color:#64748b;">Conectado e operante</div>
                        </div>
                    </div>

                    <div style="display:flex; gap:10px;">
                        <span style="font-size:1.2rem;">🔵</span>
                        <div>
                            <div style="font-size:0.85rem; font-weight:700; color:white;">Integração Bling</div>
                            <div style="font-size:0.75rem; color:#64748b;">Sincronizado há 5min</div>
                        </div>
                    </div>
                </div>

                <div class="glass-panel" style="padding:1.5rem; text-align:center; background:linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 0, 0, 0)); border-color:var(--neon-blue);">
                    <h3 style="margin:0 0 0.5rem; font-size:1.1rem; font-weight:800; color:white;">🚀 Plano Enterprise</h3>
                    <p style="font-size:0.85rem; color:#94a3b8; margin-bottom:1rem;">Desbloqueie IA ilimitada e suporte prioritário 24/7.</p>
                    <button style="width:100%; padding:10px; background:var(--neon-blue); color:black; font-weight:800; border:none; border-radius:8px; cursor:pointer; transition:0.3s; box-shadow:0 0 15px rgba(0,212,255,0.3);" onclick="upgradePlan()">
                        Fazer Upgrade Agora
                    </button>
                </div>

            </div>
        </div>

    </div>

    <!-- Chart.js -->
    <script>
        import { notificationCount, systemAlerts } from '../../stores/dashboardStore';

        // Worker Initialization
        const worker = new Worker('/workers/analytics.worker.js');

        worker.onmessage = (e) => {
            const { type, data } = e.data;
            if (type === 'METRICS_RESULT') {
                // Update UI with heavy calc results without blocking main thread
                // console.log('Worker Result:', data);
                // Update elements if they exist (mock update for now)
                const salesEl = document.getElementById('stat-sales');
                if(salesEl && data.roi) {
                     // Adding a visual indicator that Worker calculated this
                    salesEl.title = `ROI: ${data.roi}% (Calc via WebWorker)`;
                }
            }
        };

        // Trigger Worker
        worker.postMessage({ 
            type: 'CALC_METRICS', 
            data: { sales: [1200, 1900, 1500, 2500], prevSales: 5000 } 
        });

        // Store Subscriptions for Alerts
        systemAlerts.subscribe(alerts => {
            const el = document.getElementById('card-evolution-status');
            if(el) {
                el.innerText = `STATUS: ${alerts.whatsapp === 'online' ? 'OPERANTE' : 'OFFLINE'}`;
                el.style.color = alerts.whatsapp === 'online' ? 'white' : '#ef4444';
            }
        });

        // Auth Header Helper
        window.getAuthHeader = () => {
            const token = localStorage.getItem('omnichat_token');
            return token ? { 'Authorization': `Bearer ${token}` } : {};
        };
        
        // ... (Chart Code remains similar, simplified for brevity in this update) ...
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script is:inline>
        // Separate inline script for Chart.js init to avoid scope issues with import
        const ctx = document.getElementById('salesChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sab', 'Dom'],
                datasets: [{
                    label: 'Vendas (R$)',
                    data: [1200, 1900, 1500, 2500, 2200, 3100, 2800],
                    borderColor: '#00d4ff',
                    backgroundColor: 'rgba(0, 212, 255, 0.1)',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display:false } }, scales: { x:{display:false}, y:{grid:{color:'rgba(255,255,255,0.05)'}} } }
        });

        // Legacy Fetch logic (kept for compatibility, can be refactored to Store later)
        async function fetchStats() {
            try {
                const API = 'https://api.getnexo.com.br';
                const res = await fetch(`${API}/api/relatorio`, { headers: window.getAuthHeader() }).catch(()=>null);
                if(res && res.ok) {
                   const data = await res.json();
                   if(data && data.totalVendas) {
                       document.getElementById('stat-sales').innerText = 'R$ ' + data.totalVendas.toLocaleString('pt-BR');
                   }
                }
            } catch(e) {}
        }

        // Button Actions
        function accelerateGoal() {
            alert('🚀 Iniciando aceleração da meta! Campanhas automáticas ativadas.');
            // In real implementation: POST to /api/campaigns/boost
        }

        function upgradePlan() {
            window.location.href = '/precos';
        }

        fetchStats();
    </script>
</DashboardLayout>
