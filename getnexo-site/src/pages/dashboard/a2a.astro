---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Protocolo A2A e AP2 | GetNexo">
    <div class="flex flex-col gap-8">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-green-400">
                    Protocolo A2A & Pagamentos AP2
                </h1>
                <p class="text-gray-400 mt-2">Gerencie a interoperabilidade e pagamentos autônomos entre agentes.</p>
            </div>
            <div class="flex gap-4">
                <button class="px-4 py-2 bg-blue-600 rounded-lg hover:bg-blue-700 transition" onclick="refreshData()">
                    Atualizar Dados
                </button>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex gap-4 border-b border-gray-700">
            <button class="tab-btn active px-4 py-2 border-b-2 border-blue-500 text-blue-400" data-tab="identity">Identidade</button>
            <button class="tab-btn px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-white" data-tab="peers">Peers (Agentes)</button>
            <button class="tab-btn px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-white" data-tab="payments">Mandatos & Pagamentos</button>
            <button class="tab-btn px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-white" data-tab="docs">Documentação</button>
        </div>

        <!-- Content: Identity -->
        <div id="tab-identity" class="tab-content block">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="bg-gray-800/50 p-6 rounded-xl border border-gray-700/50">
                    <h2 class="text-xl font-semibold mb-4 text-white">Configuração Pública</h2>
                    <form id="identity-form" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-400 mb-1">Nome do Agente (Agent Card)</label>
                            <input type="text" name="agent_name" class="w-full bg-gray-900 border border-gray-700 rounded-lg p-2 text-white" placeholder="Ex: Meu Agente de Vendas">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-400 mb-1">Descrição</label>
                            <textarea name="agent_description" class="w-full bg-gray-900 border border-gray-700 rounded-lg p-2 text-white" rows="3" placeholder="Descrição pública..."></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-400 mb-1">Capabilidades (Interesses)</label>
                            <input type="text" name="agent_capabilities" class="w-full bg-gray-900 border border-gray-700 rounded-lg p-2 text-white font-mono" value='["chat", "commerce", "support"]'>
                        </div>
                        <div class="pt-4">
                            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg transition w-full">Salvar Configurações</button>
                        </div>
                    </form>
                </div>

                <div class="space-y-6">
                    <div class="bg-gray-800/50 p-6 rounded-xl border border-gray-700/50">
                        <h2 class="text-xl font-semibold mb-4 text-white">Chaves de Identidade (VDC)</h2>
                        <div id="identities-list" class="space-y-3 mb-4">
                            <!-- List of Identities -->
                            <p class="text-gray-500 text-sm">Nenhuma chave gerada.</p>
                        </div>
                        <button onclick="generateIdentity()" class="text-sm bg-blue-600/20 text-blue-400 border border-blue-500/30 px-3 py-1 rounded hover:bg-blue-600/30 transition">
                            Gerar Nova Identidade Cryptográfica
                        </button>
                    </div>

                    <div class="bg-gray-900/80 p-6 rounded-xl border border-blue-900/30">
                        <h3 class="text-lg font-semibold mb-2 text-white">A2A Discovery URL</h3>
                        <p class="text-xs text-gray-400 mb-3">Endpoint padrão para descoberta automática por outros agentes seguindo a especificação IANA.</p>
                        <div class="flex items-center gap-2">
                            <code id="discovery-url" class="bg-black p-2 rounded text-green-400 text-xs flex-1 truncate">
                                Loading...
                            </code>
                            <button class="text-xs bg-gray-700 px-3 py-2 rounded hover:bg-gray-600" onclick="copyDiscoveryUrl()">Copiar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content: Peers -->
        <div id="tab-peers" class="tab-content hidden">
            <div class="bg-gray-800/50 p-6 rounded-xl border border-gray-700/50">
                <div class="flex justify-between mb-4">
                    <h2 class="text-xl font-semibold text-white">Agentes Parceiros (Trusted Peers)</h2>
                    <button onclick="document.getElementById('add-peer-modal').showModal()" class="bg-blue-600 px-4 py-2 rounded-lg text-sm hover:bg-blue-700">Conectar Novo Agente</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-gray-300">
                        <thead class="bg-gray-900/50 text-xs uppercase font-semibold text-gray-500">
                            <tr>
                                <th class="p-3">Nome do Agente</th>
                                <th class="p-3">Endpoint (Message)</th>
                                <th class="p-3">Chave de Identidade</th>
                                <th class="p-3">Status</th>
                                <th class="p-3">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="peers-list" class="text-sm">
                            <tr><td colspan="5" class="p-4 text-center text-gray-500">Carregando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Content: Payments -->
        <div id="tab-payments" class="tab-content hidden">
            <div class="grid grid-cols-1 gap-8">
                <!-- Mandates -->
                <div class="bg-gray-800/50 p-6 rounded-xl border border-gray-700/50">
                    <h2 class="text-xl font-semibold text-white mb-4">Mandatos de Pagamento (VDCs Ativos)</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-gray-300">
                            <thead class="bg-gray-900/50 text-xs uppercase font-semibold text-gray-500">
                                <tr>
                                    <th class="p-3">ID Mandato</th>
                                    <th class="p-3">Tipo</th>
                                    <th class="p-3">Escopo</th>
                                    <th class="p-3">Restrições</th>
                                    <th class="p-3">Status</th>
                                </tr>
                            </thead>
                            <tbody id="mandates-list" class="text-sm">
                                <tr><td colspan="5" class="p-4 text-center text-gray-500">Carregando mandatos...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Transactions -->
                <div class="bg-gray-800/50 p-6 rounded-xl border border-gray-700/50">
                    <h2 class="text-xl font-semibold text-white mb-4">Histórico de Transações AP2</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-gray-300 text-sm">
                            <thead class="bg-gray-900/50 text-xs uppercase font-semibold text-gray-500">
                                <tr>
                                    <th class="p-3">ID Transação</th>
                                    <th class="p-3">Agente / Mandato</th>
                                    <th class="p-3">Valor</th>
                                    <th class="p-3">Status</th>
                                    <th class="p-3">Data</th>
                                </tr>
                            </thead>
                            <tbody id="transactions-list">
                                <tr><td colspan="5" class="p-4 text-center text-gray-500">Carregando transações...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content: Docs -->
        <div id="tab-docs" class="tab-content hidden">
            <div class="bg-gray-800/50 p-8 rounded-xl border border-gray-700/50 prose prose-invert max-w-none text-gray-300">
                <h2 class="text-blue-400">Implementação Completa GetNexo</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-6">
                    <div class="bg-gray-900 p-4 rounded-lg border border-gray-700">
                        <h4 class="text-white mt-0">Standard A2A v1.0</h4>
                        <p class="text-sm">Seu agente agora implementa a descoberta via <code>.well-known/agent-card.json</code> e responde a operações REST de mensagens assíncronas e streaming.</p>
                        <code class="text-xs">POST /api/a2a/message:send</code>
                    </div>
                    <div class="bg-gray-900 p-4 rounded-lg border border-gray-700">
                        <h4 class="text-white mt-0">Standard AP2 (VDC)</h4>
                        <p class="text-sm">Pagamentos são protegidos por Mandatos de Credenciais Digitais Verificáveis. O sistema valida automaticamente assinaturas e limites de gastos.</p>
                        <code class="text-xs">VDC: Cart & Intent Mandates</code>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Peer Modal -->
    <dialog id="add-peer-modal" class="bg-gray-900 p-6 rounded-xl border border-gray-700 text-white backdrop:bg-black/80">
        <h3 class="text-lg font-bold mb-4">Conectar Novo Agente</h3>
        <form id="add-peer-form" class="space-y-4">
            <div>
                <label class="block text-sm mb-1">Nome</label>
                <input name="name" type="text" class="w-full bg-gray-800 border border-gray-600 rounded p-2" placeholder="Ex: SupplyChain Agent" required>
            </div>
            <div>
                <label class="block text-sm mb-1">Discovery or Message URL</label>
                <input name="endpoint" type="url" class="w-full bg-gray-800 border border-gray-600 rounded p-2" placeholder="https://..." required>
            </div>
            <div>
                <label class="block text-sm mb-1">Públic Key (Opcional - extraída do Agent Card)</label>
                <textarea name="identityKey" class="w-full bg-gray-800 border border-gray-600 rounded p-2 text-xs font-mono" rows="2"></textarea>
            </div>
            <div class="flex justify-end gap-2 mt-4">
                <button type="button" onclick="document.getElementById('add-peer-modal').close()" class="px-4 py-2 hover:bg-gray-800 rounded">Cancelar</button>
                <button type="submit" class="bg-blue-600 px-4 py-2 rounded hover:bg-blue-700">Salvar Peer</button>
            </div>
        </form>
    </dialog>
</DashboardLayout>

<script nonce={Astro.locals.nonce} is:inline>
    // Tab Logic
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('active', 'border-blue-500', 'text-blue-400');
                b.classList.add('border-transparent', 'text-gray-400');
            });
            btn.classList.add('active', 'border-blue-500', 'text-blue-400');
            btn.classList.remove('border-transparent', 'text-gray-400');

            document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
            document.getElementById(`tab-${btn.dataset.tab}`).classList.remove('hidden');
        });
    });

    const API_URL = '/api-proxy/api';

    // Discovery URL
    document.getElementById('discovery-url').innerText = window.location.origin + '/.well-known/agent-card.json';
    window.copyDiscoveryUrl = () => {
        navigator.clipboard.writeText(window.location.origin + '/.well-known/agent-card.json');
        alert('Copiado!');
    }

    // Identidades
    async function loadIdentities() {
        const list = document.getElementById('identities-list');
        try {
            const res = await fetch(`${API_URL}/a2a/identities`);
            const data = await res.json();
            list.innerHTML = data.map(id => `
                <div class="bg-gray-900/50 p-3 rounded border border-gray-700 flex justify-between items-center">
                    <div>
                        <div class="text-sm font-medium text-white">${id.name} ${id.is_default ? '<span class="text-[10px] bg-blue-900 border border-blue-700 px-1 rounded ml-1">DEFAULT</span>' : ''}</div>
                        <div class="text-[10px] text-gray-500 font-mono truncate max-w-[200px]">${id.public_key}</div>
                    </div>
                </div>
            `).join('');
            if(data.length === 0) list.innerHTML = '<p class="text-gray-500 text-sm">Nenhuma chave gerada.</p>';
        } catch(e) {}
    }

    async function generateIdentity() {
        const name = prompt('Nome da Identidade:', 'Identity 2026');
        if(!name) return;
        await fetch(`${API_URL}/a2a/identities`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ name })
        });
        loadIdentities();
    }

    // Fetch Config
    async function loadConfig() {
        try {
            const res = await fetch(`${API_URL}/a2a/config`);
            const data = await res.json();
            const form = document.getElementById('identity-form');
            if (data.agent_name) form.agent_name.value = data.agent_name;
            if (data.agent_description) form.agent_description.value = data.agent_description;
            if (data.agent_capabilities) form.agent_capabilities.value = data.agent_capabilities;
        } catch (e) {}
    }

    // Save Config
    document.getElementById('identity-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const updates = [
            { key: 'agent_name', value: fd.get('agent_name') },
            { key: 'agent_description', value: fd.get('agent_description') },
            { key: 'agent_capabilities', value: fd.get('agent_capabilities') }
        ];

        for(const u of updates) {
            await fetch(`${API_URL}/a2a/config`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(u)
            });
        }
        alert('Configurações atualizadas!');
    });

    // Load Peers
    async function loadPeers() {
        const list = document.getElementById('peers-list');
        try {
            const res = await fetch(`${API_URL}/a2a/peers`);
            const peers = await res.json();
            list.innerHTML = peers.map(p => `
                <tr class="border-b border-gray-800 hover:bg-gray-800/30">
                    <td class="p-3 font-medium text-white">${p.name}</td>
                    <td class="p-3 font-mono text-[10px] text-blue-400 max-w-[200px] truncate">${p.endpoint}</td>
                    <td class="p-3 font-mono text-[10px] text-gray-500 truncate max-w-[100px]">${p.identity_key || '(nenhuma)'}</td>
                    <td class="p-3"><span class="bg-green-900/50 text-green-400 text-[10px] px-2 py-0.5 rounded border border-green-900">VERIFIED</span></td>
                    <td class="p-3">
                        <button class="text-red-400 hover:text-red-300 text-xs" onclick="deletePeer('${p.id}')">Excluir</button>
                    </td>
                </tr>
            `).join('');
            if(peers.length === 0) list.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-gray-500">Nenhum agente parceiro.</td></tr>';
        } catch(e) {
            list.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-red-500">Erro ao carregar agentes.</td></tr>';
        }
    }

    // Add Peer
    document.getElementById('add-peer-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        await fetch(`${API_URL}/a2a/peers`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                name: fd.get('name'),
                endpoint: fd.get('endpoint'),
                identityKey: fd.get('identityKey')
            })
        });
        document.getElementById('add-peer-modal').close();
        loadPeers();
    });

    // Load Mandates
    async function loadMandates() {
        const list = document.getElementById('mandates-list');
        try {
            const res = await fetch(`${API_URL}/ap2/mandates`);
            const data = await res.json();
            list.innerHTML = data.map(m => `
                <tr class="border-b border-gray-800">
                    <td class="p-3 font-mono text-[10px] text-blue-400">${m.mandate_id}</td>
                    <td class="p-3 uppercase text-[10px]">${m.type}</td>
                    <td class="p-3 text-[10px]">${m.scope}</td>
                    <td class="p-3 text-[10px] text-gray-400 truncate max-w-[200px]">${m.constraints}</td>
                    <td class="p-3"><span class="bg-blue-900/40 text-blue-300 text-[10px] px-2 py-0.5 rounded">${m.status}</span></td>
                </tr>
            `).join('');
            if(data.length === 0) list.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-gray-500">Nenhum mandato ativo.</td></tr>';
        } catch(e) {}
    }

    // Load Transactions
    async function loadTransactions() {
        const list = document.getElementById('transactions-list');
        try {
            const res = await fetch(`${API_URL}/ap2/transactions`);
            const txs = await res.json();
            list.innerHTML = txs.map(t => `
                <tr class="border-b border-gray-800">
                    <td class="p-3 font-mono text-[10px] text-gray-400">${t.transaction_id}</td>
                    <td class="p-3 text-xs">
                        <div class="text-white">${t.agent_id}</div>
                        <div class="text-[9px] text-gray-600">${t.mandate_id || ''}</div>
                    </td>
                    <td class="p-3 font-bold text-white">${t.amount} ${t.currency}</td>
                    <td class="p-3"><span class="bg-green-900/30 text-green-400 text-[10px] px-2 py-0.5 rounded border border-green-900">SUCESSO</span></td>
                    <td class="p-3 text-[10px] text-gray-500">${new Date(t.created_at).toLocaleString()}</td>
                </tr>
            `).join('');
            if(txs.length === 0) list.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-gray-500">Nenhuma transação.</td></tr>';
        } catch(e) {}
    }

    // Init
    window.refreshData = () => {
        loadConfig();
        loadIdentities();
        loadPeers();
        loadMandates();
        loadTransactions();
    };

    refreshData();
</script>
