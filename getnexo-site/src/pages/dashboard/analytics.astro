        function applyFilters() {
            const period = document.getElementById('period-filter').value;
            const startDate = document.getElementById('start-date').value;
            const endDate = document.getElementById('end-date').value;
            const project = document.getElementById('project-filter').value;
            const service = document.getElementById('service-filter').value;
            const metric = document.getElementById('metric-filter').value;

            console.log('Aplicando filtros:', { period, startDate, endDate, project, service, metric });

            // Reload data with filters
            loadAnalyticsData();
        }

        function updateServiceUsageChart() {
            // Refresh service usage chart with new period
            loadAnalyticsData();
        }

        function updateEngagementChart() {
            // Refresh engagement chart with new period
            loadAnalyticsData();
        }

        function exportChart(chartId) {
            const canvas = document.getElementById(chartId);
            const link = document.createElement('a');
            link.download = `${chartId}-export.png`;
            link.href = canvas.toDataURL();
            link.click();
        }

        function exportMetrics() {
            const data = {
                timestamp: new Date().toISOString(),
                metrics: [],
                filters: {
                    period: document.getElementById('period-filter').value,
                    project: document.getElementById('project-filter').value,
                    service: document.getElementById('service-filter').value,
                    metric: document.getElementById('metric-filter').value
                }
            };

            // Add current metrics data
            const tbody = document.getElementById('metrics-table-body');
            const rows = tbody.querySelectorAll('tr');
            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                data.metrics.push({
                    name: cells[0].textContent,
                    currentValue: cells[1].textContent,
                    change: cells[2].textContent,
                    status: cells[4].textContent
                });
            });

            // Create and download JSON file
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const link = document.createElement('a');
            link.download = `analytics-export-${new Date().toISOString().split('T')[0]}.json`;
            link.href = URL.createObjectURL(blob);
            link.click();
        }

        function saveReport() {
            const reportName = prompt('Nome do relatório:');
            if (reportName) {
                const report = {
                    name: reportName,
                    filters: {
                        period: document.getElementById('period-filter').value,
                        project: document.getElementById('project-filter').value,
                        service: document.getElementById('service-filter').value,
                        metric: document.getElementById('metric-filter').value
                    },
                    createdAt: new Date().toISOString()
                };

                // Save to localStorage (in real app, this would be saved to backend)
                const savedReports = JSON.parse(localStorage.getItem('savedReports') || '[]');
                savedReports.push(report);
                localStorage.setItem('savedReports', JSON.stringify(savedReports));

                alert(`Relatório "${reportName}" salvo com sucesso!`);
            }
        }

        function scheduleReport() {
            const frequency = prompt('Frequência do relatório (diário/semanal/mensal):');
            if (frequency) {
                alert(`Relatório agendado para envio ${frequency}. Você receberá por email.`);
            }
        }

        function configureAlerts() {
            alert('Configuração de alertas: Em breve você poderá personalizar quais métricas monitorar e quando receber notificações.');
        }

        // Initialize
        loadAnalyticsData();
    </script>
