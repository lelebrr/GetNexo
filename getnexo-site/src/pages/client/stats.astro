---
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Estatísticas">
  <div x-data="statsManager()">
    <!-- Header -->
    <div class="stats-header">
      <div>
        <h1 class="text-neon-blue">📊 Estatísticas</h1>
        <p class="text-muted">Visão completa do seu desempenho</p>
      </div>
      <div class="header-actions">
        <div class="status-badge">
          <span class="status-dot"></span>
          <span>Atualizado agora</span>
        </div>
        <button @click="exportStats()" class="btn-secondary">📥 Exportar</button>
      </div>
    </div>

    <!-- Period Filter -->
    <div class="period-filter">
      <button @click="period = 'today'" :class="period === 'today' ? 'active' : ''" class="period-btn">Hoje</button>
      <button @click="period = '7d'" :class="period === '7d' ? 'active' : ''" class="period-btn">7 dias</button>
      <button @click="period = '30d'" :class="period === '30d' ? 'active' : ''" class="period-btn">30 dias</button>
      <button @click="period = '90d'" :class="period === '90d' ? 'active' : ''" class="period-btn">90 dias</button>
    </div>

    <!-- Main Metrics Cards -->
    <div class="metrics-grid">
      <div class="metric-card gradient-green">
        <div class="metric-content">
          <span class="metric-label">Vendas</span>
          <span class="metric-value" x-text="formatCurrency(metrics.sales)">R$ 0</span>
        </div>
        <div class="metric-icon">💰</div>
        <span class="metric-trend positive">↑ 23% vs período anterior</span>
      </div>

      <div class="metric-card gradient-cyan">
        <div class="metric-content">
          <span class="metric-label">Clientes Novos</span>
          <span class="metric-value" x-text="metrics.newCustomers">0</span>
        </div>
        <div class="metric-icon">👥</div>
        <span class="metric-trend positive">↑ 15% vs período anterior</span>
      </div>

      <div class="metric-card gradient-orange">
        <div class="metric-content">
          <span class="metric-label">Taxa de Retenção</span>
          <span class="metric-value" x-text="metrics.retention + '%'">0%</span>
        </div>
        <div class="metric-icon">📈</div>
        <span class="metric-trend positive">↑ 5% vs mês</span>
      </div>

      <div class="metric-card gradient-teal">
        <div class="metric-content">
          <span class="metric-label">PIX Recebido</span>
          <span class="metric-value" x-text="metrics.pixRate + '%'">0%</span>
        </div>
        <div class="metric-icon">💳</div>
        <span class="metric-trend positive">↑ 8% vs semana</span>
      </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-grid">
      <!-- Sales Chart -->
      <div class="chart-card">
        <div class="card-header">
          <h3>💹 Vendas da Semana</h3>
          <span class="badge">Últimos 7 dias</span>
        </div>
        <canvas id="salesChart" height="250"></canvas>
      </div>

      <!-- Traffic Sources Chart -->
      <div class="chart-card">
        <div class="card-header">
          <h3>📊 Fontes de Tráfego</h3>
          <span class="badge">Últimos 30 dias</span>
        </div>
        <canvas id="trafficChart" height="250"></canvas>
      </div>
    </div>

    <!-- Top Products Chart -->
    <div class="chart-card full-width">
      <div class="card-header">
        <h3>🏆 Top Produtos Vendidos</h3>
        <span class="badge">Últimos 30 dias</span>
      </div>
      <canvas id="productsChart" height="200"></canvas>
    </div>

    <!-- Insights Section -->
    <div class="insights-section card">
      <div class="card-header">
        <h3>💡 Insights Inteligentes</h3>
      </div>
      <div class="insights-grid">
        <div class="insight-card tip">
          <span class="insight-icon">💡</span>
          <div class="insight-content">
            <span class="insight-title">Dica do Dia</span>
            <span class="insight-text">Use produtos 3D no WhatsApp e aumente conversão em 30%!</span>
          </div>
        </div>
        <div class="insight-card opportunity">
          <span class="insight-icon">📈</span>
          <div class="insight-content">
            <span class="insight-title">Oportunidade</span>
            <span class="insight-text">Seus clientes preferem PIX (<span x-text="metrics.pixRate + '%'"></span>). Ofereça mais opções.</span>
          </div>
        </div>
        <div class="insight-card action">
          <span class="insight-icon">🎯</span>
          <div class="insight-content">
            <span class="insight-title">Ação Recomendada</span>
            <span class="insight-text">Crie campanha de fidelidade para reter clientes.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Premium Upsell -->
    <div class="premium-banner">
      <div class="premium-content">
        <span class="premium-badge">PREMIUM</span>
        <div class="premium-text">
          <h4>🚀 Desbloqueie Analytics Avançado</h4>
          <p>ROI completo, previsão de vendas, análise preditiva e insights inteligentes para escalar seu negócio.</p>
        </div>
      </div>
      <a href="/client/upgrade" class="btn-upgrade">Desbloquear por R$ 99/mês</a>
    </div>
  </div>
</ClientLayout>

<style>
  .stats-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; }
  .stats-header h1 { font-size: 1.75rem; margin: 0 0 0.25rem 0; }
  .header-actions { display: flex; align-items: center; gap: 1rem; }
  .status-badge { display: flex; align-items: center; gap: 0.5rem; background: rgba(0, 255, 65, 0.1); padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.8rem; color: #00ff41; }
  .status-dot { width: 8px; height: 8px; background: #00ff41; border-radius: 50%; }
  .btn-secondary { background: rgba(0, 243, 255, 0.1); color: #00f3ff; border: 1px solid rgba(0, 243, 255, 0.3); padding: 0.6rem 1.2rem; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.85rem; }

  .period-filter { display: flex; gap: 0.5rem; margin-bottom: 2rem; }
  .period-btn { background: #0a0a0a; border: 1px solid #334155; color: #64748b; padding: 0.6rem 1.2rem; border-radius: 8px; cursor: pointer; font-size: 0.8rem; font-weight: 600; }
  .period-btn.active { background: rgba(0, 243, 255, 0.1); color: #00f3ff; border-color: #00f3ff; }

  .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2rem; }
  .metric-card { position: relative; padding: 1.5rem; border-radius: 16px; overflow: hidden; color: #fff; }
  .metric-card::before { content: ''; position: absolute; inset: 0; opacity: 0.15; }
  .gradient-green { background: linear-gradient(135deg, #059669, #10b981); }
  .gradient-cyan { background: linear-gradient(135deg, #0891b2, #06b6d4); }
  .gradient-orange { background: linear-gradient(135deg, #ea580c, #f97316); }
  .gradient-teal { background: linear-gradient(135deg, #0d9488, #14b8a6); }
  .metric-content { position: relative; z-index: 1; }
  .metric-label { display: block; font-size: 0.85rem; opacity: 0.9; margin-bottom: 0.5rem; }
  .metric-value { display: block; font-size: 2rem; font-weight: 700; }
  .metric-icon { position: absolute; top: 1rem; right: 1rem; font-size: 2.5rem; opacity: 0.3; }
  .metric-trend { display: block; font-size: 0.75rem; margin-top: 0.5rem; opacity: 0.9; }
  .metric-trend.positive { color: #ecfdf5; }

  .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
  .chart-card { background: #0a0a0a; border: 1px solid #334155; border-radius: 16px; padding: 1.5rem; }
  .chart-card.full-width { margin-bottom: 2rem; }
  .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .card-header h3 { font-size: 1rem; color: #fff; margin: 0; }
  .badge { background: rgba(0, 243, 255, 0.1); color: #00f3ff; padding: 0.25rem 0.75rem; border-radius: 12px; font-size: 0.7rem; font-weight: 600; }

  .card { background: #0a0a0a; border: 1px solid #334155; border-radius: 16px; padding: 1.5rem; }
  .insights-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .insight-card { display: flex; align-items: flex-start; gap: 1rem; padding: 1.25rem; background: rgba(255, 255, 255, 0.02); border-radius: 12px; }
  .insight-card.tip { border-left: 3px solid #ffd700; }
  .insight-card.opportunity { border-left: 3px solid #00ff9d; }
  .insight-card.action { border-left: 3px solid #00f3ff; }
  .insight-icon { font-size: 1.5rem; }
  .insight-content { display: flex; flex-direction: column; }
  .insight-title { color: #94a3b8; font-size: 0.75rem; margin-bottom: 0.25rem; }
  .insight-text { color: #fff; font-size: 0.9rem; font-weight: 500; }

  .premium-banner { background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(59, 130, 246, 0.2)); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 16px; padding: 2rem; display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; }
  .premium-content { display: flex; align-items: center; gap: 1.5rem; }
  .premium-badge { background: #8b5cf6; color: #fff; padding: 0.4rem 0.8rem; border-radius: 6px; font-size: 0.7rem; font-weight: 700; }
  .premium-text h4 { color: #fff; margin: 0 0 0.25rem 0; font-size: 1.1rem; }
  .premium-text p { color: #94a3b8; font-size: 0.85rem; margin: 0; max-width: 500px; }
  .btn-upgrade { background: linear-gradient(135deg, #00ff9d, #00d4ff); color: #000; padding: 0.8rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.9rem; }

  @media (max-width: 1200px) {
    .metrics-grid { grid-template-columns: repeat(2, 1fr); }
    .charts-grid { grid-template-columns: 1fr; }
    .insights-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .metrics-grid { grid-template-columns: 1fr; }
    .premium-banner { flex-direction: column; gap: 1.5rem; text-align: center; }
    .premium-content { flex-direction: column; }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script nonce={Astro.locals.nonce} is:inline>
  function statsManager() {
    return {
      period: '30d',
      metrics: { sales: 12450, newCustomers: 47, retention: 68, pixRate: 92 },

      formatCurrency(val) {
        return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val);
      },

      init() {
        this.initCharts();
      },

      initCharts() {
        setTimeout(() => {
          // Sales Chart
          const salesCtx = document.getElementById('salesChart');
          if (salesCtx) {
            new Chart(salesCtx, {
              type: 'line',
              data: {
                labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
                datasets: [{
                  label: 'Vendas (R$)',
                  data: [1850, 2100, 1950, 2450, 2800, 3100, 2450],
                  borderColor: '#00ff9d',
                  backgroundColor: 'rgba(0, 255, 157, 0.1)',
                  fill: true,
                  tension: 0.4,
                  borderWidth: 2
                }]
              },
              options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                  y: { beginAtZero: true, grid: { color: '#1e293b' }, ticks: { color: '#64748b' } },
                  x: { grid: { display: false }, ticks: { color: '#64748b' } }
                }
              }
            });
          }

          // Traffic Chart
          const trafficCtx = document.getElementById('trafficChart');
          if (trafficCtx) {
            new Chart(trafficCtx, {
              type: 'doughnut',
              data: {
                labels: ['WhatsApp', 'Instagram', 'Facebook', 'Google', 'Outros'],
                datasets: [{
                  data: [45, 25, 15, 10, 5],
                  backgroundColor: ['#00ff9d', '#8b5cf6', '#3b82f6', '#f59e0b', '#64748b'],
                  borderWidth: 0
                }]
              },
              options: {
                responsive: true,
                plugins: {
                  legend: { position: 'right', labels: { color: '#94a3b8', padding: 15 } }
                }
              }
            });
          }

          // Products Chart
          const productsCtx = document.getElementById('productsChart');
          if (productsCtx) {
            new Chart(productsCtx, {
              type: 'bar',
              data: {
                labels: ['Camiseta Premium', 'Tênis Sport', 'Jaqueta Couro', 'Calça Jeans', 'Boné Style'],
                datasets: [{
                  label: 'Unidades',
                  data: [156, 124, 98, 87, 65],
                  backgroundColor: '#00f3ff',
                  borderRadius: 4
                }]
              },
              options: {
                responsive: true,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                  x: { beginAtZero: true, grid: { color: '#1e293b' }, ticks: { color: '#64748b' } },
                  y: { grid: { display: false }, ticks: { color: '#94a3b8' } }
                }
              }
            });
          }
        }, 100);
      },

      exportStats() {
        alert('Exportando estatísticas em CSV...');
      }
    };
  }
</script>
</ClientLayout>
