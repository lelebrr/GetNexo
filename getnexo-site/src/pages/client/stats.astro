---
// Página de Estatísticas do Cliente
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Estatísticas">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Estatísticas</h1>
        <p class="text-gray-500">Visão completa do seu desempenho</p>
      </div>
      <div class="flex items-center space-x-2">
        <span class="w-2 h-2 bg-green-500 rounded-full" aria-hidden="true"></span>
        <span class="text-sm text-gray-600">Atualizado agora</span>
      </div>
    </div>

    <!-- Cards de Métricas Principais -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Vendas Hoje -->
      <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-700">Vendas Hoje</p>
            <p class="text-3xl font-bold mt-1">R$ 12.450</p>
          </div>
          <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <p class="text-xs mt-3 text-gray-600">↑ 23% vs ontem</p>
      </div>

      <!-- Clientes Novos -->
      <div class="bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-700">Clientes Novos</p>
            <p class="text-3xl font-bold mt-1">47</p>
          </div>
          <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
        </div>
        <p class="text-xs mt-3 text-gray-600">↑ 15% vs semana</p>
      </div>

      <!-- Taxa de Retenção -->
      <div class="bg-gradient-to-br from-orange-500 to-amber-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-700">Taxa de Retenção</p>
            <p class="text-3xl font-bold mt-1">68%</p>
          </div>
          <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
        </div>
        <p class="text-xs mt-3 text-gray-600">↑ 5% vs mês</p>
      </div>

      <!-- PIX Recebido -->
      <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-700">PIX Recebido</p>
            <p class="text-3xl font-bold mt-1">92%</p>
          </div>
          <div class="w-12 h-12 bg-white/20 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <p class="text-xs mt-3 text-gray-600">↑ 8% vs semana</p>
      </div>
    </div>

    <!-- Teaser Premium -->
    <div class="bg-gradient-to-r from-purple-900 via-indigo-900 to-blue-900 rounded-xl shadow-lg p-6 text-white relative overflow-hidden">
      <div class="absolute top-0 right-0 w-32 h-32 bg-purple-500/20 rounded-full blur-2xl"></div>
      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-3">
          <span class="px-3 py-1 bg-purple-600 rounded-full text-xs font-semibold text-white">PREMIUM</span>
          <span class="text-purple-100 text-sm">Desbloqueie Gráficos Avançados</span>
        </div>
        <h3 class="text-xl font-bold mb-2">ROI Completo + Previsão de Vendas</h3>
        <p class="text-purple-100 text-sm mb-4">Análise preditiva, tendências e insights inteligentes para escalar seu negócio.</p>
        <a href="/client/upgrade" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-green-500 to-emerald-600 rounded-lg font-medium hover:from-green-600 hover:to-emerald-700 transition-all" aria-label="Upgrade para plano premium - R$ 99/mês">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          Desbloquear por R$ 99/mês
        </a>
      </div>
    </div>

    <!-- Gráficos -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Gráfico de Linha: Vendas da Semana -->
      <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-gray-900">Vendas da Semana</h3>
          <span class="text-xs text-gray-600">Últimos 7 dias</span>
        </div>
        <div class="h-64 flex items-center justify-center bg-gray-50 rounded-lg" role="img" aria-label="Gráfico de linha das vendas da semana - disponível na versão Premium">
          <div class="text-center text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <p class="text-sm text-gray-600">Gráfico disponível na versão Premium</p>
            <p class="text-xs mt-1 text-gray-500">Inclui tendências e previsões</p>
          </div>
        </div>
      </div>

      <!-- Gráfico Donut: Fontes de Tráfego -->
      <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-gray-900">Fontes de Tráfego</h3>
          <span class="text-xs text-gray-600">Últimos 30 dias</span>
        </div>
        <div class="h-64 flex items-center justify-center bg-gray-50 rounded-lg" role="img" aria-label="Gráfico donut das fontes de tráfego - disponível na versão Premium">
          <div class="text-center text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
            </svg>
            <p class="text-sm text-gray-600">Gráfico disponível na versão Premium</p>
            <p class="text-xs mt-1 text-gray-500">WhatsApp, Instagram, Facebook</p>
          </div>
        </div>
      </div>

      <!-- Gráfico de Barras: Top Produtos -->
      <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 lg:col-span-2">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-gray-900">Top Produtos Vendidos</h3>
          <span class="text-xs text-gray-600">Últimos 30 dias</span>
        </div>
        <div class="h-64 flex items-center justify-center bg-gray-50 rounded-lg" role="img" aria-label="Gráfico de barras dos top produtos vendidos - disponível na versão Premium">
          <div class="text-center text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <p class="text-sm text-gray-600">Gráfico disponível na versão Premium</p>
            <p class="text-xs mt-1 text-gray-500">Análise de performance por produto</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Seção de Insights Premium -->
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900">Insights Inteligentes</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-700 mb-2">💡 Dica do Dia</p>
          <p class="text-gray-900 font-medium">Use produtos 3D no WhatsApp e aumente conversão em 30%!</p>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-700 mb-2">📈 Oportunidade</p>
          <p class="text-gray-900 font-medium">Seus clientes preferem PIX (92%). Ofereça mais opções.</p>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg">
          <p class="text-sm text-gray-700 mb-2">🎯 Ação Recomendada</p>
          <p class="text-gray-900 font-medium">Crie campanha de fidelidade para reter clientes.</p>
        </div>
      </div>
    </div>
  </div>
</ClientLayout>
