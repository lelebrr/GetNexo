---
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Dashboard">
  <div x-data="dashboardManager()">
    <!-- Header -->
    <div class="dashboard-header">
      <div>
        <h1 class="text-neon-blue">📊 Dashboard</h1>
        <p class="text-muted">Bem-vindo ao seu painel de controle</p>
      </div>
      <div class="status-badge">
        <span class="status-dot"></span>
        <span>Online</span>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
      <div class="stat-card sales">
        <div class="stat-icon">💰</div>
        <div class="stat-content">
          <span class="stat-value" x-text="formatCurrency(stats.salesToday)">R$ 0</span>
          <span class="stat-label">Vendas Hoje</span>
          <span class="stat-trend positive">↑ 12% vs ontem</span>
        </div>
      </div>
      
      <div class="stat-card chats">
        <div class="stat-icon">💬</div>
        <div class="stat-content">
          <span class="stat-value" x-text="stats.activeChats">0</span>
          <span class="stat-label">Conversas Ativas</span>
          <span class="stat-trend positive">↑ 8 novas hoje</span>
        </div>
      </div>
      
      <div class="stat-card leads">
        <div class="stat-icon">👥</div>
        <div class="stat-content">
          <span class="stat-value" x-text="stats.newLeads">0</span>
          <span class="stat-label">Novos Leads</span>
          <span class="stat-trend positive">↑ 25% vs semana</span>
        </div>
      </div>
      
      <div class="stat-card roi">
        <div class="stat-icon">📈</div>
        <div class="stat-content">
          <span class="stat-value" x-text="stats.roi + 'x'">0x</span>
          <span class="stat-label">ROI Médio</span>
          <span class="stat-trend positive">↑ 0.3x vs mês</span>
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="content-grid">
      <!-- Chart Section -->
      <div class="chart-section card">
        <div class="card-header">
          <h3>📈 Vendas da Semana</h3>
          <div class="period-tabs">
            <button @click="chartPeriod = '7d'" :class="chartPeriod === '7d' ? 'active' : ''" class="tab-btn">7 dias</button>
            <button @click="chartPeriod = '30d'" :class="chartPeriod === '30d' ? 'active' : ''" class="tab-btn">30 dias</button>
          </div>
        </div>
        <canvas id="salesChart" height="200"></canvas>
      </div>

      <!-- Recent Activity -->
      <div class="activity-section card">
        <div class="card-header">
          <h3>🕒 Atividade Recente</h3>
          <button @click="refreshActivity()" class="btn-icon">🔄</button>
        </div>
        <div class="activity-list">
          <template x-for="activity in recentActivity" :key="activity.id">
            <div class="activity-item">
              <span class="activity-icon" x-text="activity.icon"></span>
              <div class="activity-content">
                <span class="activity-text" x-text="activity.text"></span>
                <span class="activity-time" x-text="activity.time"></span>
              </div>
            </div>
          </template>
        </div>
      </div>
    </div>

    <!-- Active Modules -->
    <div class="modules-section card">
      <div class="card-header">
        <h3>🔌 Módulos Ativos</h3>
        <a href="/client/settings" class="link-secondary">Gerenciar →</a>
      </div>
      <div class="modules-grid">
        <template x-for="module in activeModules" :key="module.id">
          <div class="module-card">
            <div class="module-icon" x-text="module.icon"></div>
            <div class="module-info">
              <span class="module-name" x-text="module.name"></span>
              <span class="module-desc" x-text="module.description"></span>
            </div>
            <span class="module-status active">Ativo</span>
          </div>
        </template>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="actions-section card">
      <div class="card-header">
        <h3>⚡ Ações Rápidas</h3>
      </div>
      <div class="actions-grid">
        <a href="/client/sales" class="action-card">
          <span class="action-icon">➕</span>
          <span class="action-text">Nova Venda</span>
        </a>
        <a href="/client/contacts" class="action-card">
          <span class="action-icon">👤</span>
          <span class="action-text">Novo Contato</span>
        </a>
        <a href="/client/broadcasts" class="action-card">
          <span class="action-icon">📣</span>
          <span class="action-text">Nova Campanha</span>
        </a>
        <a href="/client/support" class="action-card">
          <span class="action-icon">🎫</span>
          <span class="action-text">Abrir Ticket</span>
        </a>
      </div>
    </div>

    <!-- Alerts Section -->
    <div class="alerts-section" x-show="alerts.length > 0">
      <template x-for="alert in alerts" :key="alert.id">
        <div class="alert-item" :class="'alert-' + alert.type" @click="dismissAlert(alert.id)">
          <span class="alert-icon" x-text="alert.icon"></span>
          <span class="alert-text" x-text="alert.message"></span>
          <button class="alert-close">×</button>
        </div>
      </template>
    </div>
  </div>
</ClientLayout>

<style>
  .dashboard-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; }
  .dashboard-header h1 { font-size: 1.75rem; margin: 0 0 0.25rem 0; }
  .status-badge { display: flex; align-items: center; gap: 0.5rem; background: rgba(0, 255, 65, 0.1); padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.85rem; color: #00ff41; }
  .status-dot { width: 8px; height: 8px; background: #00ff41; border-radius: 50%; box-shadow: 0 0 10px #00ff41; animation: pulse 2s infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
  .stat-card { display: flex; align-items: center; gap: 1rem; padding: 1.25rem; border-radius: 12px; background: #0a0a0a; border: 1px solid #334155; transition: all 0.3s; }
  .stat-card:hover { border-color: #00f3ff; transform: translateY(-2px); }
  .stat-card.sales { border-left: 4px solid #00ff9d; }
  .stat-card.chats { border-left: 4px solid #00f3ff; }
  .stat-card.leads { border-left: 4px solid #8b5cf6; }
  .stat-card.roi { border-left: 4px solid #ffd700; }
  .stat-icon { font-size: 2rem; }
  .stat-content { display: flex; flex-direction: column; }
  .stat-value { font-size: 1.75rem; font-weight: 700; color: #fff; }
  .stat-label { font-size: 0.8rem; color: #64748b; }
  .stat-trend { font-size: 0.7rem; margin-top: 0.25rem; }
  .stat-trend.positive { color: #00ff41; }
  .stat-trend.negative { color: #f43f5e; }

  .content-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
  
  .card { background: #0a0a0a; border: 1px solid #334155; border-radius: 12px; padding: 1.5rem; }
  .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .card-header h3 { font-size: 1rem; color: #fff; margin: 0; }

  .period-tabs { display: flex; gap: 0.5rem; }
  .tab-btn { background: transparent; border: 1px solid #334155; color: #64748b; padding: 0.4rem 0.8rem; border-radius: 6px; cursor: pointer; font-size: 0.75rem; }
  .tab-btn.active { background: rgba(0, 243, 255, 0.1); color: #00f3ff; border-color: #00f3ff; }

  .btn-icon { background: rgba(0, 243, 255, 0.1); border: 1px solid rgba(0, 243, 255, 0.3); color: #00f3ff; padding: 0.4rem 0.6rem; border-radius: 6px; cursor: pointer; }
  .link-secondary { color: #00f3ff; text-decoration: none; font-size: 0.85rem; font-weight: 500; }

  .activity-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .activity-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; background: rgba(255, 255, 255, 0.02); border-radius: 8px; }
  .activity-icon { font-size: 1.25rem; }
  .activity-content { display: flex; flex-direction: column; flex: 1; }
  .activity-text { color: #cbd5e1; font-size: 0.85rem; }
  .activity-time { color: #64748b; font-size: 0.7rem; }

  .modules-section { margin-bottom: 2rem; }
  .modules-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .module-card { display: flex; align-items: center; gap: 1rem; padding: 1rem; background: rgba(255, 255, 255, 0.02); border: 1px solid #334155; border-radius: 10px; }
  .module-icon { font-size: 1.5rem; }
  .module-info { flex: 1; display: flex; flex-direction: column; }
  .module-name { color: #fff; font-weight: 600; font-size: 0.9rem; }
  .module-desc { color: #64748b; font-size: 0.75rem; }
  .module-status { font-size: 0.7rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 12px; }
  .module-status.active { background: rgba(0, 255, 65, 0.1); color: #00ff41; }

  .actions-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .action-card { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; padding: 1.5rem; background: rgba(0, 243, 255, 0.05); border: 1px solid rgba(0, 243, 255, 0.2); border-radius: 12px; text-decoration: none; transition: all 0.3s; }
  .action-card:hover { background: rgba(0, 243, 255, 0.1); border-color: #00f3ff; transform: translateY(-2px); }
  .action-icon { font-size: 1.5rem; }
  .action-text { color: #00f3ff; font-weight: 600; font-size: 0.85rem; }

  .alerts-section { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2rem; }
  .alert-item { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.5rem; border-radius: 10px; cursor: pointer; }
  .alert-item.alert-warning { background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); }
  .alert-item.alert-success { background: rgba(0, 255, 65, 0.1); border: 1px solid rgba(0, 255, 65, 0.3); }
  .alert-item.alert-info { background: rgba(0, 243, 255, 0.1); border: 1px solid rgba(0, 243, 255, 0.3); }
  .alert-icon { font-size: 1.25rem; }
  .alert-text { flex: 1; color: #cbd5e1; font-size: 0.9rem; }
  .alert-close { background: none; border: none; color: #64748b; font-size: 1.25rem; cursor: pointer; }

  @media (max-width: 1200px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .content-grid { grid-template-columns: 1fr; }
    .modules-grid { grid-template-columns: 1fr 1fr; }
    .actions-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: 1fr; }
    .modules-grid { grid-template-columns: 1fr; }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script nonce={Astro.locals.nonce} is:inline>
  function dashboardManager() {
    return {
      chartPeriod: '7d',
      stats: { salesToday: 0, activeChats: 0, newLeads: 0, roi: 0 },
      recentActivity: [],
      activeModules: [],
      alerts: [],

      formatCurrency(val) {
        return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val);
      },

      async init() {
        await this.loadData();
        this.initChart();
      },

      async loadData() {
        try {
          const res = await fetch('/api/client/dashboard');
          if (res.ok) {
            const data = await res.json();
            this.stats = data.stats || this.stats;
            this.recentActivity = data.recentActivity || [];
            this.activeModules = data.modules || [];
            this.alerts = data.alerts || [];
          } else {
            this.setMockData();
          }
        } catch (e) {
          this.setMockData();
        }
      },

      setMockData() {
        // Fallback to empty/zero data if API fails
        this.stats = { salesToday: 0, activeChats: 0, newLeads: 0, roi: 0 };
        this.recentActivity = [];
        this.activeModules = [];
        this.alerts = [{ id: 1, type: 'info', icon: 'ℹ️', message: 'Nenhum dado disponível no momento.' }];
      },

      initChart() {
        setTimeout(() => {
          const ctx = document.getElementById('salesChart');
          if (ctx) {
            new Chart(ctx, {
              type: 'line',
              data: {
                labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
                datasets: [{
                  label: 'Vendas (R$)',
                  data: [0, 0, 0, 0, 0, 0, 0],
                  borderColor: '#00ff9d',
                  backgroundColor: 'rgba(0, 255, 157, 0.1)',
                  fill: true,
                  tension: 0.4,
                  borderWidth: 2
                }]
              },
              options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                  y: { 
                    beginAtZero: true, 
                    grid: { color: '#1e293b' },
                    ticks: { color: '#64748b' }
                  },
                  x: { 
                    grid: { display: false },
                    ticks: { color: '#64748b' }
                  }
                }
              }
            });
          }
        }, 100);
      },

      refreshActivity() {
        this.recentActivity.unshift({
          id: Date.now(),
          icon: '🔄',
          text: 'Dashboard atualizado',
          time: 'agora'
        });
      },

      dismissAlert(id) {
        this.alerts = this.alerts.filter(a => a.id !== id);
      }
    };
  }
</script>
</ClientLayout>
