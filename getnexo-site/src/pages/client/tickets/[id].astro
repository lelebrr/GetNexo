---
// Página de detalhes do ticket com conversa
import ClientLayout from '../../../layouts/ClientLayout.astro';
const { id } = Astro.params;
const nonce = Astro.locals.nonce;
---

<ClientLayout title={`Ticket #${id}`}>
  <div class="max-w-3xl mx-auto space-y-6">
    <!-- Back button -->
    <a href="/client/support" class="inline-flex items-center gap-2 text-gray-500 hover:text-gray-700 transition">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Voltar para Suporte
    </a>

    <!-- Ticket header -->
    <div id="ticket-header" class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <div class="animate-pulse">
        <div class="h-6 bg-gray-200 rounded w-3/4 mb-3"></div>
        <div class="h-4 bg-gray-100 rounded w-1/2"></div>
      </div>
    </div>

    <!-- Mensagens -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Conversa</h2>
      <div id="messages-list" class="space-y-4 max-h-96 overflow-y-auto">
        <div class="text-center py-8 text-gray-400">Carregando mensagens...</div>
      </div>
    </div>

    <!-- Form de resposta -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Responder</h2>
      <form id="reply-form" class="space-y-4">
        <div>
          <textarea 
            id="reply-message" 
            name="message"
            rows="3" 
            placeholder="Digite sua resposta..." 
            class="w-full p-3 bg-gray-50 text-gray-900 rounded-lg border border-gray-200 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 focus:outline-none transition resize-none"
          ></textarea>
        </div>
        <div class="flex items-center justify-between">
          <input 
            type="file" 
            id="reply-attachment" 
            name="attachment"
            accept="image/*,.pdf,.txt" 
            class="text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200"
          />
          <button 
            type="submit" 
            id="submit-reply"
            class="px-6 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg font-medium transition flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            Enviar
          </button>
        </div>
      </form>
    </div>

    <!-- Actions -->
    <div class="flex justify-between">
      <button onclick="exportTicket()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Exportar HTML
      </button>
      <span id="ticket-status-text" class="text-sm text-gray-400"></span>
    </div>
  </div>
</ClientLayout>

<script nonce={nonce} define:vars={{ ticketId: id }}>
  const API_BASE = '/api/support';

  function getToken() {
    return localStorage.getItem('getnexo_token') || localStorage.getItem('jwt_token');
  }

  function getStatusBadge(status) {
    const badges = {
      'open': '<span class="px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">🟡 Aberto</span>',
      'in-progress': '<span class="px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">🔵 Em andamento</span>',
      'closed': '<span class="px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">✅ Fechado</span>'
    };
    return badges[status] || badges['open'];
  }

  function getPriorityText(priority) {
    const texts = ['Baixa', 'Média', 'Alta'];
    return texts[priority] || 'Normal';
  }

  function formatDate(dateStr) {
    const date = new Date(dateStr);
    return date.toLocaleDateString('pt-BR', { 
      day: '2-digit', 
      month: 'short',
      year: 'numeric',
      hour: '2-digit', 
      minute: '2-digit' 
    });
  }

  async function loadTicket() {
    const token = getToken();
    if (!token) {
      window.location.href = '/login';
      return;
    }

    try {
      const res = await fetch(`${API_BASE}/tickets/${ticketId}/messages`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!res.ok) throw new Error('Erro ao carregar');

      const data = await res.json();
      const { ticket, messages } = data;

      // Header
      document.getElementById('ticket-header').innerHTML = `
        <div class="flex items-start justify-between">
          <div>
            <div class="flex items-center gap-3 mb-2">
              ${getStatusBadge(ticket.status)}
              <span class="text-sm text-gray-400">#${ticket.id}</span>
            </div>
            <h1 class="text-xl font-bold text-gray-900">${ticket.title}</h1>
            <p class="text-gray-600 mt-2">${ticket.description}</p>
            ${ticket.attachments ? `<img src="${ticket.attachments}" alt="Anexo" class="mt-3 max-w-xs rounded-lg border">` : ''}
          </div>
          <div class="text-right text-sm text-gray-400">
            <p>Prioridade: ${getPriorityText(ticket.priority)}</p>
            <p class="mt-1">${formatDate(ticket.created_at)}</p>
          </div>
        </div>
      `;

      // Messages
      const messagesList = document.getElementById('messages-list');
      if (messages.length === 0) {
        messagesList.innerHTML = `
          <div class="text-center py-6 text-gray-400">
            <p>Nenhuma resposta ainda</p>
            <p class="text-sm">Use o formulário abaixo para adicionar uma mensagem</p>
          </div>
        `;
      } else {
        messagesList.innerHTML = messages.map(m => {
          const isAdmin = m.sender === 'admin';
          return `
            <div class="flex ${isAdmin ? 'justify-start' : 'justify-end'}">
              <div class="max-w-md ${isAdmin ? 'bg-gray-100' : 'bg-cyan-50'} rounded-lg p-4">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-medium text-sm ${isAdmin ? 'text-gray-700' : 'text-cyan-700'}">
                    ${isAdmin ? '👤 Suporte' : '👤 Você'}
                  </span>
                  <span class="text-xs text-gray-400">${formatDate(m.created_at)}</span>
                </div>
                ${m.message ? `<p class="text-gray-900">${m.message}</p>` : ''}
                ${m.attachment ? `<img src="${m.attachment}" alt="Anexo" class="mt-2 max-w-xs rounded-lg">` : ''}
              </div>
            </div>
          `;
        }).join('');

        // Scroll to bottom
        messagesList.scrollTop = messagesList.scrollHeight;
      }

      // Status text
      document.getElementById('ticket-status-text').textContent = `Atualizado: ${formatDate(ticket.updated_at)}`;

    } catch (err) {
      console.error('Erro:', err);
      document.getElementById('ticket-header').innerHTML = `
        <div class="text-center py-4 text-red-500">
          <p>Erro ao carregar ticket</p>
          <button onclick="loadTicket()" class="text-cyan-600 hover:underline mt-2">Tentar novamente</button>
        </div>
      `;
    }
  }

  async function exportTicket() {
    const token = getToken();
    if (!token) return alert('Faça login primeiro');

    try {
      const res = await fetch(`${API_BASE}/tickets/${ticketId}/export`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!res.ok) throw new Error('Erro ao exportar');

      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `ticket_${ticketId}.html`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.URL.revokeObjectURL(url);
    } catch (err) {
      alert('Erro ao exportar: ' + err.message);
    }
  }

  // Reply form
  document.getElementById('reply-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const token = getToken();
    if (!token) {
      window.location.href = '/login';
      return;
    }

    const form = e.target;
    const submitBtn = document.getElementById('submit-reply');
    const originalText = submitBtn.innerHTML;
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = `<svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>`;

    const formData = new FormData(form);

    try {
      const res = await fetch(`${API_BASE}/tickets/${ticketId}/reply`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: formData
      });

      if (!res.ok) {
        const data = await res.json();
        throw new Error(data.error || 'Erro ao enviar');
      }

      form.reset();
      loadTicket(); // Reload messages
    } catch (err) {
      alert('Erro: ' + err.message);
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    }
  });

  window.exportTicket = exportTicket;
  window.loadTicket = loadTicket;
  document.addEventListener('DOMContentLoaded', loadTicket);
</script>
