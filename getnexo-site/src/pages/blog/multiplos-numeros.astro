      <section id="rotacao">
        <h2>🔄 Sistema de Rotação Inteligente</h2>
        <p>Algoritmos avançados garantem distribuição equilibrada e compliance automática.</p>

        <div class="rotation-strategies">
          <div class="strategy">
            <h3>🎯 Round Robin Simples</h3>
            <p>Distribuição sequencial entre números disponíveis. Ideal para carga equilibrada.</p>
          </div>

          <div class="strategy">
            <h3>📊 Baseado em Capacidade</h3>
            <p>Números com melhor performance recebem mais mensagens. Auto-otimização.</p>
          </div>

          <div class="strategy">
            <h3>🎭 Baseado em Persona</h3>
            <p>Números especializados por tipo de cliente ou produto. Melhor conversão.</p>
          </div>

          <div class="strategy">
            <h3>⏰ Baseado em Horário</h3>
            <p>Rotação considerando fusos horários e horários comerciais regionais.</p>
          </div>
        </div>

        <h3>🧠 Algoritmo de Inteligência:</h3>
        <pre is:raw><code class="language-javascript">// Exemplo de lógica de rotação
function selectWhatsAppInstance(message) {
  const availableInstances = getAvailableInstances();
  const clientHistory = getClientHistory(message.clientId);

  // Prioriza números com histórico positivo
  const preferredInstances = availableInstances.filter(
    instance => clientHistory[instance.id]?.successRate &gt; 0.8
  );

  if (preferredInstances.length > 0) {
    return loadBalance(preferredInstances);
  }

  // Fallback para round-robin
  return roundRobin(availableInstances);
}</code></pre>
