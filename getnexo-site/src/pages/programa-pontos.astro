<script is:inline>
  function verDemoPontos() {
    // Interactive points demo
    const pointsDemo = setInterval(() => {
      const currentPoints = document.querySelector('.total-points');
      if (currentPoints) {
        const currentValue = parseInt(currentPoints.textContent.replace(/\D/g, ''));
        const newValue = Math.min(currentValue + Math.floor(Math.random() * 50) + 10, 5000);
        currentPoints.textContent = newValue.toLocaleString('pt-BR') + ' pontos';

        const progressBar = document.querySelector('.progress-fill');
        const progressPercent = (newValue / 5000) * 100;
        progressBar.style.width = progressPercent + '%';

        if (newValue >= 5000) {
          clearInterval(pointsDemo);
          setTimeout(() => {
            alert('🎉 Parabéns! Você alcançou o Tier Ouro!\n\nNovos benefícios desbloqueados:\n• 15% desconto vitalício\n• Frete sempre grátis\n• Atendimento VIP');
          }, 1000);
        }
      }
    }, 2000);

    setTimeout(() => clearInterval(pointsDemo), 15000);
  }
</script>