---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';

const title = "Programa de Pontos GetNexo - Sistema de Fidelidade WhatsApp Automático";
const description = "Programa de pontos completo no WhatsApp. Fidelidade automática, tiers VIP, recompensas personalizadas. Clientes acumulam pontos por compras, indicações e engajamento.";
const keywords = "programa pontos whatsapp, sistema fidelidade whatsapp, pontos fidelidade automatico, programa vip whatsapp, recompensas whatsapp, tiers beneficios whatsapp, fidelidade whatsapp ia";

const faqData = [
  {
    question: "Como funciona o Programa de Pontos?",
    answer: "Clientes acumulam pontos automaticamente por cada interação: compras, indicações, reviews, participação em missões. Pontos são convertidos em descontos, frete grátis e benefícios exclusivos via WhatsApp."
  },
  {
    question: "Posso personalizar os tiers e benefícios?",
    answer: "Sim! Crie tiers ilimitados com benefícios customizados. Desde 'Bronze: 5% desconto' até 'Diamante: consultoria gratuita + 25% desconto'. Tudo integrado ao WhatsApp automaticamente."
  },
  {
    question: "Quanto tempo leva para ver resultados?",
    answer: "Resultados em 30 dias. Primeiro mês: clientes descobrem o programa. Segundo mês: engajamento aumenta 200%. Terceiro mês: vendas recorrentes crescem 300%."
  }
];

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Produtos", url: "/produtos" },
  { name: "Fidelidade", url: "/fidelidade" },
  { name: "Programa de Pontos", url: "/programa-pontos" }
];
---

<SEO
  title={title}
  description={description}
  keywords={keywords}
  url="/programa-pontos"
  breadcrumbs={breadcrumbs}
  faq={faqData}
/>

<Layout title={title} description={description} keywords={keywords}>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-badge">⭐ Programa VIP</div>
      <h1>Pontos que Vendem Sozinhos</h1>
      <p>Programa de fidelidade automático no WhatsApp. Clientes acumulam pontos por cada interação e resgatam benefícios exclusivos. Fidelidade que gera vendas recorrentes 24/7.</p>
      <div class="hero-features">
        <span>✅ Acúmulo automático</span>
        <span>✅ Resgate instantâneo</span>
        <span>✅ Benefícios personalizados</span>
      </div>
      <div class="hero-ctas">
        <a href="/criar-bot" class="btn-primary">Implementar Programa de Pontos</a>
        <button onclick="verDemoPontos()" class="btn-secondary">Ver Sistema em Ação</button>
      </div>
    </div>
    <div class="hero-visual">
      <div class="points-system">
        <div class="points-display">
          <div class="user-points">João Silva</div>
          <div class="total-points">2.847 pontos</div>
          <div class="progress-bar">
            <div class="progress-fill" style="width: 78%;"></div>
            <div class="progress-text">Próximo tier: Ouro (5.000 pts)</div>
          </div>
          <div class="available-rewards">
            <div class="reward">🎁 15% desconto na próxima compra</div>
            <div class="reward">🚚 Frete grátis</div>
            <div class="reward">🎯 Acesso antecipado a lançamentos</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How Points Work -->
  <section class="points-mechanics">
    <div class="section-header">
      <h2>Como os Pontos São Acumulados</h2>
      <p>Cada interação vale pontos automaticamente</p>
    </div>

    <div class="points-grid">
      <div class="point-action">
        <div class="action-icon">🛒</div>
        <h3>Compras</h3>
        <div class="point-value">1 ponto por R$ 1 gasto</div>
        <p>Compra de R$ 299 = 299 pontos automaticamente creditados</p>
      </div>

      <div class="point-action">
        <div class="action-icon">👥</div>
        <h3>Indicações</h3>
        <div class="point-value">500 pontos por indicação</div>
        <p>Quando amigo indicado faz primeira compra, ambos ganham pontos</p>
      </div>

      <div class="point-action">
        <div class="action-icon">⭐</div>
        <h3>Avaliações</h3>
        <div class="point-value">50 pontos por review</div>
        <p>Reviews positivas geram pontos extras para o cliente</p>
      </div>

      <div class="point-action">
        <div class="action-icon">🎯</div>
        <h3>Missões</h3>
        <div class="point-value">10-200 pontos por missão</div>
        <p>Missões diárias, semanais e especiais com pontuação variável</p>
      </div>

      <div class="point-action">
        <div class="action-icon">📱</div>
        <h3>Engajamento</h3>
        <div class="point-value">5-25 pontos por interação</div>
        <p>Conversas, cliques em produtos, tempo no chat</p>
      </div>

      <div class="point-action">
        <div class="action-icon">🎂</div>
        <h3>Aniversários</h3>
        <div class="point-value">200 pontos bônus</div>
        <p>Pontos extras no mês de aniversário do cliente</p>
      </div>
    </div>
  </section>

  <!-- Tier System -->
  <section class="tier-system">
    <div class="section-header">
      <h2>Sistema de Tiers Inteligente</h2>
      <p>Quanto mais pontos, melhores benefícios</p>
    </div>

    <div class="tiers-showcase">
      <div class="tier-card bronze">
        <div class="tier-header">
          <div class="tier-badge">🥉</div>
          <h3>Bronze</h3>
          <div class="tier-range">0 - 999 pontos</div>
        </div>
        <div class="tier-benefits">
          <div class="benefit">🎁 5% desconto em compras</div>
          <div class="benefit">🚚 Frete grátis acima de R$100</div>
          <div class="benefit">📱 Suporte padrão</div>
        </div>
        <div class="tier-stats">
          <span>70% dos clientes</span>
        </div>
      </div>

      <div class="tier-card silver">
        <div class="tier-header">
          <div class="tier-badge">🥈</div>
          <h3>Prata</h3>
          <div class="tier-range">1.000 - 4.999 pontos</div>
        </div>
        <div class="tier-benefits">
          <div class="benefit">🎁 10% desconto em compras</div>
          <div class="benefit">🚚 Frete grátis acima de R$50</div>
          <div class="benefit">🎯 Acesso antecipado a promoções</div>
          <div class="benefit">📱 Suporte prioritário</div>
        </div>
        <div class="tier-stats">
          <span>25% dos clientes</span>
        </div>
      </div>

      <div class="tier-card gold">
        <div class="tier-header">
          <div class="tier-badge">🥇</div>
          <h3>Ouro</h3>
          <div class="tier-range">5.000 - 14.999 pontos</div>
        </div>
        <div class="tier-benefits">
          <div class="benefit">🎁 15% desconto em compras</div>
          <div class="benefit">🚚 Frete sempre grátis</div>
          <div class="benefit">🎯 Produtos exclusivos</div>
          <div class="benefit">👑 Atendimento VIP 24h</div>
          <div class="benefit">🎉 Brindes de aniversário</div>
        </div>
        <div class="tier-stats">
          <span>4% dos clientes</span>
        </div>
      </div>

      <div class="tier-card diamond">
        <div class="tier-header">
          <div class="tier-badge">💎</div>
          <h3>Diamante</h3>
          <div class="tier-range">15.000+ pontos</div>
        </div>
        <div class="tier-benefits">
          <div class="benefit">🎁 20% desconto vitalício</div>
          <div class="benefit">🚚 Frete express grátis</div>
          <div class="benefit">🎯 Consultoria personalizada</div>
          <div class="benefit">👑 Gerente de conta dedicado</div>
          <div class="benefit">🎉 Experiências exclusivas</div>
          <div class="benefit">🚀 Acesso beta a novos produtos</div>
        </div>
        <div class="tier-stats">
          <span>1% dos clientes</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Redemption System -->
  <section class="redemption-system">
    <div class="section-header">
      <h2>Resgate Fácil e Instantâneo</h2>
      <p>Pontos viram benefícios automaticamente</p>
    </div>

    <div class="redemption-options">
      <div class="redemption-card">
        <div class="redemption-icon">💰</div>
        <h3>Descontos Automáticos</h3>
        <p>Sistema aplica desconto automaticamente no checkout quando cliente tem pontos suficientes.</p>
        <div class="redemption-example">
          <strong>Exemplo:</strong> 500 pontos = R$ 50 desconto<br>
          <em>Aplicado automaticamente na compra</em>
        </div>
      </div>

      <div class="redemption-card">
        <div class="redemption-icon">🎁</div>
        <h3>Recompensas por Níveis</h3>
        <p>Alcance tiers e desbloqueie benefícios automaticamente. Sem necessidade de resgate manual.</p>
        <div class="redemption-example">
          <strong>Tier Ouro desbloqueado:</strong><br>
          <em>Frete grátis em todas as compras</em>
        </div>
      </div>

      <div class="redemption-card">
        <div class="redemption-icon">🎲</div>
        <h3>Caixas Misteriosas</h3>
        <p>Troque pontos por caixas com surpresas: descontos extras, frete grátis, produtos grátis.</p>
        <div class="redemption-example">
          <strong>Caixa Bronze (200 pts):</strong><br>
          <em>5-15% desconto surpresa</em>
        </div>
      </div>
    </div>
  </section>

  <!-- Analytics Dashboard -->
  <section class="analytics-dashboard">
    <div class="section-header">
      <h2>Dashboard de Fidelidade Inteligente</h2>
      <p>Métricas específicas para otimizar seu programa</p>
    </div>

    <div class="dashboard-preview">
      <div class="dashboard-metrics">
        <div class="metric">
          <div class="metric-value">94%</div>
          <div class="metric-label">Taxa de Participação</div>
        </div>
        <div class="metric">
          <div class="metric-value">3.2x</div>
          <div class="metric-label">Compras Recorrentes</div>
        </div>
        <div class="metric">
          <div class="metric-value">R$ 180</div>
          <div class="metric-label">Lifetime Value Médio</div>
        </div>
        <div class="metric">
          <div class="metric-value">67%</div>
          <div class="metric-label">Redução Churn</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Success Cases -->
  <section class="success-cases">
    <div class="section-header">
      <h2>Resultados Reais de Programas de Pontos</h2>
      <p>Empresas que transformaram clientes em fãs</p>
    </div>

    <div class="cases-grid">
      <div class="case-card">
        <div class="case-company">Fashion Store</div>
        <div class="case-results">
          <div class="result">📈 +340% compras recorrentes</div>
          <div class="result">💰 Ticket médio: R$ 285</div>
          <div class="result">⭐ NPS: 78 pontos</div>
        </div>
        <p>"O programa de pontos transformou nossa base de clientes ocasionais em compradores fiéis. Vemos crescimento consistente mês a mês."</p>
      </div>

      <div class="case-card">
        <div class="case-company">Pizzaria Express</div>
        <div class="case-results">
          <div class="result">🔄 Frequência: 4x/mês</div>
          <div class="result">👥 Indicações: +180%</div>
          <div class="result">💵 CAC reduzido: R$ 12</div>
        </div>
        <p>"Clientes disputam para indicar amigos. Nosso programa viralizou sozinho no WhatsApp."</p>
      </div>

      <div class="case-card">
        <div class="case-company">Loja de Eletrônicos</div>
        <div class="case-results">
          <div class="result">🎯 Cross-selling: +420%</div>
          <div class="result">💎 LTV: R$ 2.400</div>
          <div class="result">🏆 Retenção: 89%</div>
        </div>
        <p>"O tier Diamante gera mais receita que nossos outros tiers juntos. Focamos neles agora."</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section">
    <div class="section-header">
      <h2>Programa de Pontos Completo</h2>
      <p>Incluído em todos os planos Business</p>
    </div>

    <div class="pricing-comparison">
      <div class="pricing-plan included">
        <div class="plan-badge">Incluído</div>
        <div class="plan-header">
          <h3>Plano Business</h3>
          <div class="plan-price">R$ 197<span>/mês</span></div>
        </div>
        <ul class="plan-features">
          <li>✅ Programa de pontos completo</li>
          <li>✅ Até 5 tiers personalizáveis</li>
          <li>✅ Sistema de indicações</li>
          <li>✅ Recompensas automáticas</li>
          <li>✅ Dashboard de fidelidade</li>
          <li>✅ Analytics avançado</li>
        </ul>
        <a href="/precos" class="plan-cta">Ver Planos Completos</a>
      </div>

      <div class="pricing-plan enterprise">
        <div class="plan-badge">Avançado</div>
        <div class="plan-header">
          <h3>Enterprise</h3>
          <div class="plan-price">R$ 397<span>/mês</span></div>
        </div>
        <ul class="plan-features">
          <li>✅ Tudo do Business</li>
          <li>✅ Tiers ilimitados</li>
          <li>✅ Recompensas customizadas</li>
          <li>✅ API completa</li>
          <li>✅ White-label</li>
          <li>✅ Consultoria dedicada</li>
        </ul>
        <a href="/contato" class="plan-cta secondary">Falar com Vendas</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="section-header">
      <h2>Perguntas Sobre Programa de Pontos</h2>
    </div>

    <div class="faq-list">
      <details class="faq-item">
        <summary>Os pontos expiram?</summary>
        <div class="faq-answer">
          <p>Sim, mas estrategicamente! Pontos expiram em 12 meses para manter engajamento contínuo. Clientes recebem lembretes automáticos antes da expiração com oportunidades de ganhar pontos extras.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Posso importar pontos de outros sistemas?</summary>
        <div class="faq-answer">
          <p>Sim! API completa permite importação de pontos de sistemas existentes. Clientes mantêm seu saldo histórico e continuam acumulando normalmente no WhatsApp.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>E se cliente não usar os pontos?</summary>
        <div class="faq-answer">
          <p>Sistema envia lembretes automáticos: "Você tem 450 pontos expirando em 7 dias. Que tal resgatar R$ 45 de desconto?" Clientes são lembrados de usar seus benefícios.</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>Como evitar fraudes no sistema?</summary>
        <div class="faq-answer">
          <p>Validação automática de compras reais, limite de pontos por período, análise de padrões suspeitos. 99.9% de transações são legítimas. Relatórios antifraude em tempo real.</p>
        </div>
      </details>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="cta-content">
      <h2>Pontos que Criam Fidelidade Verdadeira</h2>
      <p>Programa VIP automático que transforma clientes em embaixadores. Setup em 15 minutos, resultados em 30 dias.</p>
      <a href="/criar-bot" class="btn-primary-large">Implementar Programa de Pontos →</a>
    </div>
  </section>
</Layout>

<style>
  .hero-section { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; padding: 8rem 5%; max-width: 1400px; margin: 0 auto; align-items: center; }
  .hero-badge { background: rgba(0, 212, 255, 0.1); color: #00d4ff; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.9rem; font-weight: 600; display: inline-block; margin-bottom: 2rem; }
  .hero-content h1 { font-size: 3rem; font-weight: 900; margin-bottom: 1.5rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .hero-content p { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 2rem; line-height: 1.6; }
  .hero-features { display: flex; gap: 1rem; margin-bottom: 3rem; flex-wrap: wrap; }
  .hero-features span { background: rgba(0, 255, 157, 0.1); color: #00ff9d; padding: 0.5rem 1rem; border-radius: 15px; font-size: 0.9rem; font-weight: 600; }
  .hero-ctas { display: flex; gap: 1.5rem; }
  .btn-primary { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1rem 2rem; border-radius: 12px; font-weight: 800; text-decoration: none; transition: 0.3s; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0, 212, 255, 0.3); }
  .btn-secondary { border: 1px solid rgba(255,255,255,0.3); color: white; padding: 1rem 2rem; border-radius: 12px; font-weight: 600; text-decoration: none; transition: 0.3s; cursor: pointer; }
  .btn-secondary:hover { background: rgba(255,255,255,0.1); }

  .points-system { background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2rem; }
  .points-display { text-align: center; }
  .user-points { font-size: 1.2rem; font-weight: 800; color: #00d4ff; margin-bottom: 1rem; }
  .total-points { font-size: 2rem; font-weight: 900; color: #00ff9d; margin-bottom: 2rem; }
  .progress-bar { background: rgba(255,255,255,0.1); border-radius: 10px; height: 12px; margin-bottom: 1rem; overflow: hidden; }
  .progress-fill { background: linear-gradient(90deg, #00d4ff, #00ff9d); height: 100%; border-radius: 10px; transition: 0.3s; }
  .progress-text { font-size: 0.8rem; color: #94a3b8; margin-bottom: 2rem; }
  .available-rewards { display: flex; flex-direction: column; gap: 0.8rem; }
  .reward { background: rgba(0, 255, 157, 0.1); color: #00ff9d; padding: 0.8rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; }

  .points-mechanics { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .points-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .point-action { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2rem; text-align: center; transition: 0.3s; }
  .point-action:hover { transform: translateY(-5px); border-color: rgba(0, 212, 255, 0.3); }
  .action-icon { font-size: 3rem; margin-bottom: 1rem; }
  .point-action h3 { color: white; font-size: 1.3rem; margin-bottom: 0.5rem; }
  .point-value { color: #00ff9d; font-weight: 900; font-size: 1.1rem; margin-bottom: 1rem; }
  .point-action p { color: #e2e8f0; line-height: 1.6; }

  .tier-system { padding: 8rem 5%; background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 255, 157, 0.1)); }
  .tiers-showcase { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .tier-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2rem; text-align: center; position: relative; }
  .tier-card.gold { border-color: #00d4ff; box-shadow: 0 0 30px rgba(0, 212, 255, 0.2); }
  .tier-card.diamond { border-color: #ff69b4; box-shadow: 0 0 30px rgba(255, 105, 180, 0.2); }
  .tier-header { margin-bottom: 1.5rem; }
  .tier-badge { font-size: 2rem; margin-bottom: 0.5rem; }
  .tier-card h3 { color: white; font-size: 1.4rem; margin-bottom: 0.5rem; }
  .tier-range { color: #94a3b8; font-size: 0.9rem; }
  .tier-benefits { display: flex; flex-direction: column; gap: 0.8rem; margin-bottom: 1.5rem; }
  .benefit { color: #e2e8f0; font-size: 0.9rem; background: rgba(255,255,255,0.05); padding: 0.5rem; border-radius: 6px; }
  .tier-stats { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1rem; }
  .tier-stats span { color: #00d4ff; font-weight: 600; font-size: 0.9rem; }

  .redemption-system { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .redemption-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .redemption-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2.5rem; text-align: center; }
  .redemption-icon { font-size: 3rem; margin-bottom: 1rem; }
  .redemption-card h3 { color: white; font-size: 1.4rem; margin-bottom: 1rem; }
  .redemption-card p { color: #e2e8f0; line-height: 1.6; margin-bottom: 1.5rem; }
  .redemption-example { background: rgba(0, 212, 255, 0.1); border-left: 3px solid #00d4ff; padding: 1rem; border-radius: 0 8px 8px 0; font-size: 0.9rem; }

  .analytics-dashboard { padding: 8rem 5%; max-width: 1400px; margin: 0 auto; }
  .dashboard-preview { background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 3rem; }
  .dashboard-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; }
  .metric { text-align: center; padding: 2rem; background: rgba(255,255,255,0.05); border-radius: 15px; }
  .metric-value { font-size: 2.5rem; font-weight: 900; color: #00ff9d; margin-bottom: 0.5rem; }
  .metric-label { color: white; font-weight: 600; }

  .success-cases { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .cases-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .case-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2rem; }
  .case-company { color: #00d4ff; font-weight: 800; font-size: 1.1rem; margin-bottom: 1rem; }
  .case-results { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; }
  .result { background: rgba(0, 255, 157, 0.1); color: #00ff9d; padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; }
