---

<Layout title={title} description={description} keywords={keywords}>

  <!-- SEO Schemas -->
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero Section -->
  <section class="cases-hero" aria-label="Casos de Uso GetNexo">
    <div class="hero-badge">🏆 Casos de Sucesso</div>
    <h1>Casos de <span class="text-gradient">Uso Real</span></h1>
    <p class="hero-desc">
      Veja como diferentes empresas estão usando GetNexo para escalar vendas no WhatsApp. <strong>Resultados reais, empresas reais.</strong>
    </p>

    <!-- Trust Badges -->
    <div class="trust-badges">
      {trustBadges.map(badge => (
        <div class="trust-badge">
          <span class="trust-icon">{badge.icon}</span>
          <div>
            <strong>{badge.title}</strong>
            <span>{badge.desc}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="hero-ctas">
      <a href="/criar-bot" class="btn-primary-glow" aria-label="Começar gratuitamente">
        Começar Grátis Agora
      </a>
      <a href="/contato" class="btn-outline" aria-label="Falar com vendas">
        Falar com Vendas
      </a>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="max-w-6xl mx-auto px-5">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map(stat => (
          <div class="stat-card glass-panel p-6 text-center">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
            <span class="stat-desc">{stat.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Depoimentos de <span class="text-gradient">Clientes</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">O que nossos clientes dizem sobre os resultados</p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map(testimonial => (
          <div class="testimonial-card glass-panel p-8 rounded-3xl">
            <div class="testimonial-header">
              <div class="testimonial-avatar">
                <span class="avatar-placeholder">{testimonial.name.charAt(0)}</span>
              </div>
              <div>
                <h3 class="testimonial-name">{testimonial.name}</h3>
                <p class="testimonial-role">{testimonial.role}</p>
                <p class="testimonial-company">{testimonial.company}</p>
              </div>
            </div>
            <blockquote class="testimonial-quote">"{testimonial.quote}"</blockquote>
            <div class="testimonial-results">
              {testimonial.results.map(result => (
                <div class="result-item">
                  <span class="result-value">{result.value}</span>
                  <span class="result-label">{result.label}</span>
                </div>
              ))}
            </div>
            <div class="testimonial-features">
              {testimonial.features.map(feature => (
                <span class="feature-tag">{feature}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section class="industries-section">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white mb-4">Indústrias que <span class="text-gradient">Transformamos</span></h2>
        <p class="text-slate-400 max-w-2xl mx-auto">Veja como diferentes segmentos estão usando GetNexo</p>
      </div>

      <div class="industries-grid">
        {industries.map(industry => (
          <div class="industry-card glass-panel p-8 rounded-3xl">
            <div class="industry-icon">{industry.icon}</div>
            <h3 class="industry-title">{industry.title}</h3>
            <p class="industry-desc">{industry.desc}</p>
            <ul class="industry-benefits">
              {industry.benefits.map(benefit => (
                <li class="benefit-item">
                  <span class="benefit-check">✓</span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
            <div class="industry-results">
              {industry.results.map(result => (
                <span class="result-tag">{result}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ROI Calculator Section -->
  <section class="roi-section py-20 px-5 max-w-6xl mx-auto">
    <div class="glass-panel p-12 rounded-3xl text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Calcule seu <span class="text-gradient">ROI</span></h2>
      <p class="text-slate-400 text-lg mb-8 max-w-2xl mx-auto">
        Descubra quanto você pode economizar e ganhar com GetNexo
      </p>
      <div class="roi-calculator">
        <div class="roi-inputs">
          <div class="input-group">
            <label>Leads/mês</label>
            <input type="number" id="leads" value="100" min="0" />
          </div>
          <div class="input-group">
            <label>Ticket médio (R$)</label>
            <input type="number" id="ticket" value="500" min="0" />
          </div>
          <div class="input-group">
            <label>Conversão atual (%)</label>
            <input type="number" id="conversion" value="5" min="0" max="100" />
          </div>
        </div>
        <div class="roi-results">
          <div class="result-box">
            <span class="result-label">Economia com GetNexo</span>
            <span class="result-value" id="economy">R$ 0</span>
          </div>
          <div class="result-box">
            <span class="result-label">Faturamento extra</span>
            <span class="result-value" id="revenue">R$ 0</span>
          </div>
          <div class="result-box">
            <span class="result-label">ROI mensal</span>
            <span class="result-value" id="roi">0%</span>
          </div>
        </div>
      </div>
      <p class="mt-6 text-sm text-slate-500">
        *Cálculo baseado em médias de clientes. Resultados reais podem variar.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta py-20 text-center px-4">
    <div class="max-w-4xl mx-auto glass-panel p-12 rounded-3xl">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-6">Pronto para <span class="text-blue-400">escrever seu caso de sucesso</span>?</h2>
      <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto">
        Junte-se a mais de 5.000 empresas que transformaram vendas com GetNexo.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/criar-bot" class="btn-primary-glow bg-blue-600 hover:bg-blue-500" aria-label="Começar gratuitamente">
          Começar Grátis Agora
        </a>
        <a href="/contato" class="px-10 py-5 bg-transparent border border-blue-500 text-blue-400 font-bold rounded-2xl hover:bg-blue-500 hover:text-white transition-colors text-lg" aria-label="Falar com vendas">
          Falar com Vendas
        </a>
      </div>
      <p class="mt-8 text-sm text-slate-500">
        ✅ Sem cartão de crédito • ✅ Cancelamento fácil • ✅ Suporte em português
      </p>
    </div>
  </section>

</Layout>

<script nonce={Astro.locals.nonce}>
  // ROI Calculator
  function calculateROI() {
    const leads = parseFloat(document.getElementById('leads').value) || 0;
    const ticket = parseFloat(document.getElementById('ticket').value) || 0;
    const conversion = parseFloat(document.getElementById('conversion').value) || 0;

    // Assumptions based on GetNexo data
    const getNexoConversion = conversion * 1.5; // 50% increase
    const getNexoCost = 97; // Pro plan
    const manualCost = leads * 5; // R$5 per lead manual

    const currentRevenue = leads * (conversion / 100) * ticket;
    const newRevenue = leads * (getNexoConversion / 100) * ticket;
    const revenueIncrease = newRevenue - currentRevenue;
    const economy = manualCost - getNexoCost;
    const roi = ((revenueIncrease + economy) / getNexoCost) * 100;

    document.getElementById('economy').textContent = `R$ ${economy.toFixed(0)}`;
    document.getElementById('revenue').textContent = `R$ ${revenueIncrease.toFixed(0)}`;
    document.getElementById('roi').textContent = `${roi.toFixed(0)}%`;
  }

  // Add event listeners
  document.addEventListener('DOMContentLoaded', () => {
    const inputs = ['leads', 'ticket', 'conversion'];
    inputs.forEach(id => {
      const element = document.getElementById(id);
      if (element) {
        element.addEventListener('input', calculateROI);
      }
    });
    calculateROI();
  });
</script>

