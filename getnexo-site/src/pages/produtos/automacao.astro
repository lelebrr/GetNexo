---
import Layout from '../../layouts/Layout.astro';

// SEO Meta Tags
const title = "Automação WhatsApp com IA Generativa | Chatbots Inteligentes 24/7 | GetNexo";
const description = "Plataforma completa de automação para WhatsApp com IA Generativa (GPT-4, Claude, Llama). Crie fluxos visuais, recupere carrinhos, atenda 24/7 sem codificação. Teste Grátis!";
const keywords = "automação whatsapp, chatbot ia whatsapp, ia generativa whatsapp, n8n whatsapp, typebot whatsapp, recuperação de carrinho whatsapp, bot atendimento whatsapp, getnexo automação, chatbot inteligente, fluxo visual automação";
const canonical = "https://getnexo.com.br/produtos/automacao";

// Structured Data - Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "logo": "https://getnexo.com.br/logo.png",
  "sameAs": [
    "https://www.linkedin.com/company/getnexo",
    "https://twitter.com/getnexo",
    "https://github.com/getnexo"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+5511999999999",
    "contactType": "customer service",
    "areaServed": "BR",
    "availableLanguage": "pt-BR"
  }
};

// SoftwareApplication Schema with detailed features
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "GetNexo Automação com IA",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, iOS, Android",
  "applicationSuite": "GetNexo Platform",
  "softwareVersion": "3.0",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL",
    "availability": "https://schema.org/InStock",
    "eligibleCustomerType": "https://schema.org/Business",
    "eligibleDuration": "https://schema.org/Unlimited"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.95",
    "ratingCount": "840",
    "bestRating": "5",
    "worstRating": "1"
  },
  "description": "Plataforma de automação para WhatsApp com IA Generativa. Crie chatbots inteligentes, fluxos visuais, recupere carrinhos e atenda clientes 24/7 sem codificação.",
  "featureList": [
    "Construtor de Fluxo Visual (Drag & Drop)",
    "IA Generativa com RAG Local e Privacidade",
    "Integração Nativa n8n/Typebot/Webhooks",
    "Processamento de Voz (Whisper API)",
    "Visão Computacional (Análise de Imagens)",
    "Roteamento Multi-LLM (GPT-4, Claude, Llama)",
    "Disparo Agendado e Automático",
    "Analytics e Métricas em Tempo Real"
  ],
  "author": {
    "@type": "Organization",
    "name": "GetNexo"
  },
  "publisher": {
    "@type": "Organization",
    "name": "GetNexo"
  },
  "datePublished": "2024-01-01",
  "dateModified": "2026-01-23",
  "operatingSystem": "Web, iOS, Android",
  "applicationCategory": "BusinessApplication",
  "genre": "Automação de Marketing e Vendas",
  "keywords": "automação whatsapp, chatbot, ia generativa, n8n, typebot, recuperação de carrinho"
};

// FAQ Schema with comprehensive questions
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "A IA substitui humanos no atendimento?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Não substitui, mas potencializa. A IA tria, qualifica e resolve até 80% das dúvidas repetitivas automaticamente. Casos complexos ou vendas de alto valor são transferidos instantaneamente para sua equipe humana no momento certo, com todo o contexto da conversa."
      }
    },
    {
      "@type": "Question",
      "name": "Preciso saber programar para usar o GetNexo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zero código! Nosso construtor é 100% visual (drag & drop). Você arrasta blocos de ação, conecta setas e cria fluxos complexos em minutos. Para desenvolvedores avançados, oferecemos Low-Code com JavaScript, n8n e API REST completa."
      }
    },
    {
      "@type": "Question",
      "name": "Como funciona o processamento de áudio e voz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Graças à tecnologia Whisper da OpenAI, nosso bot ouve, transcreve e entende áudios recebidos em segundos. Ele analisa o conteúdo, extrai intenção e pode responder em texto ou áudio sintético ultra-realista (TTS), mantendo a naturalidade da conversa."
      }
    },
    {
      "@type": "Question",
      "name": "Posso treinar a IA com os dados da minha empresa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Com certeza! Faça upload de PDFs, DOCs, Excel ou cole URLs do seu site. Nossa tecnologia RAG (Retrieval-Augmented Generation) cria um banco de dados vetorial privado que aprende sobre sua empresa em minutos, garantindo respostas precisas sem alucinações."
      }
    },
    {
      "@type": "Question",
      "name": "Qual a diferença entre GetNexo e outros chatbots?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GetNexo combina automação visual com IA Generativa avançada. Enquanto outros bots usam apenas regras fixas, nossa IA entende contexto, emoção e pode tomar decisões complexas. Além disso, integra nativamente com n8n, Typebot e oferece privacidade total com RAG local."
      }
    },
    {
      "@type": "Question",
      "name": "Funciona com WhatsApp Business oficial?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sim! Utilizamos a API Oficial do WhatsApp Business (Cloud API) da Meta. Isso garante conformidade, alta taxa de entrega, suporte a mídia rica e elimina riscos de bloqueio por uso de ferramentas não autorizadas."
      }
    }
  ]
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Início",
      "item": "https://getnexo.com.br"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Produtos",
      "item": "https://getnexo.com.br/produtos"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Automação com IA",
      "item": "https://getnexo.com.br/produtos/automacao"
    }
  ]
};

// Product Schema for comparison
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "GetNexo Automação com IA",
  "description": "Plataforma de automação para WhatsApp com IA Generativa",
  "brand": {
    "@type": "Brand",
    "name": "GetNexo"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL",
    "availability": "https://schema.org/InStock",
    "url": "https://getnexo.com.br/produtos/automacao"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.95",
    "ratingCount": "840"
  }
};

// Features data with SEO-rich descriptions
const aiFeatures = [
  {
    icon: "🧠",
    title: "RAG Local & Privacidade Total",
    desc: "Seus dados não treinam IAs públicas. Usamos Vector DB privado para garantir que o bot saiba tudo sobre SUA empresa, sem alucinações e com LGPD compliance.",
    seoKeywords: ["RAG local", "privacidade dados", "vector database", "LGPD compliance"]
  },
  {
    icon: "🔄",
    title: "Roteamento Multi-LLM Inteligente",
    desc: "O sistema escolhe automaticamente entre GPT-4o, Claude 3.5 ou Llama 3 dependendo da complexidade da pergunta, otimizando custo e qualidade de resposta.",
    seoKeywords: ["multi-LLM", "GPT-4", "Claude", "Llama", "otimização custo"]
  },
  {
    icon: "🎨",
    title: "Visão Computacional Avançada",
    desc: "O bot 'enxerga' e analisa imagens. Envie fotos de produtos com defeito e ele identifica problemas. Valide comprovantes de PIX e documentos automaticamente.",
    seoKeywords: ["visão computacional", "análise imagem", "validação documentos", "reconhecimento visual"]
  },
  {
    icon: "🗣️",
    title: "Processamento de Voz em Tempo Real",
    desc: "Transcreve áudios recebidos instantaneamente e responde em texto ou áudio sintético ultra-realista (TTS). Mantém a naturalidade da conversa humana.",
    seoKeywords: ["processamento voz", "transcrição áudio", "TTS", "whisper api"]
  },
  {
    icon: "⚡",
    title: "Integração n8n & Webhooks",
    desc: "Conecte com milhares de ferramentas via n8n ou webhooks. Automatize fluxos complexos entre WhatsApp, CRM, ERP e sistemas internos.",
    seoKeywords: ["n8n", "webhooks", "integração", "automação empresarial"]
  },
  {
    icon: "📊",
    title: "Analytics & Métricas",
    desc: "Acompanhe em tempo real: taxa de conversão, tempo de resposta, satisfação do cliente e ROI de cada campanha. Exporte para BI e planilhas.",
    seoKeywords: ["analytics", "métricas", "ROI", "dashboard", "relatórios"]
  }
];

// Integrations data
const integrations = [
  { name: "n8n", icon: "⚡", desc: "Automação infinita open-source", url: "https://n8n.io" },
  { name: "Typebot", icon: "🤖", desc: "Construtor visual de conversas", url: "https://typebot.io" },
  { name: "ChatGPT", icon: "🧠", desc: "Inteligência Generativa Nativa", url: "https://openai.com" },
  { name: "Webhooks", icon: "🔗", desc: "Conecte com qualquer API REST", url: "#" },
  { name: "Google Sheets", icon: "📊", desc: "Banco de dados simples e ágil", url: "https://sheets.google.com" },
  { name: "Stripe", icon: "💳", desc: "Cobranças direto no chat", url: "https://stripe.com" },
  { name: "MercadoPago", icon: "💳", desc: "Pagamentos no Brasil", url: "https://mercadopago.com.br" },
  { name: "Zapier", icon: "🔗", desc: "Automação no-code", url: "https://zapier.com" }
];

// Use cases for SEO
const useCases = [
  { icon: "🛒", title: "E-commerce", desc: "Recupere carrinhos abandonados e venda mais", benefit: "Aumento de 35% em conversões" },
  { icon: "🏥", title: "Clínicas", desc: "Agende consultas e envie lembretes automáticos", benefit: "Redução de 60% em no-shows" },
  { icon: "🏠", title: "Imobiliárias", desc: "Qualifique leads e agende visitas 24h", benefit: "3x mais visitas agendadas" },
  { icon: "📚", title: "Educação", desc: "Engaje alunos e automatize matrículas", benefit: "Aumento de 40% em matrículas" },
  { icon: "🍕", title: "Delivery", desc: "Receba pedidos e confirme pagamentos via PIX", benefit: "Entrega em 2min" },
  { icon: "💼", title: "Consultoria", desc: "Agende reuniões e qualifique prospects", benefit: "Qualificação 24/7" }
];

// Comparison data for SEO
const comparisonData = [
  {
    feature: "IA Generativa",
    getNexo: "✅ GPT-4, Claude, Llama (Multi-LLM)",
    competitors: "❌ Apenas regras fixas",
    oldBots: "⚠️ Limitado a palavras-chave"
  },
  {
    feature: "RAG Local",
    getNexo: "✅ Vector DB privado, sem vazamento",
    competitors: "❌ Treina em dados públicos",
    oldBots: "❌ Não possui"
  },
  {
    feature: "Processamento de Voz",
    getNexo: "✅ Whisper API + TTS ultra-realista",
    competitors: "❌ Apenas texto",
    oldBots: "❌ Não possui"
  },
  {
    feature: "Visão Computacional",
    getNexo: "✅ Analisa imagens e documentos",
    competitors: "❌ Não possui",
    oldBots: "❌ Não possui"
  },
  {
    feature: "Integrações",
    getNexo: "✅ n8n, Webhooks, APIs nativas",
    competitors: "⚠️ Limitado a Zapier (pago)",
    oldBots: "❌ Muito limitado"
  },
  {
    feature: "Preço Escala",
    getNexo: "✅ Fixo (equipe ilimitada)",
    competitors: "❌ Por usuário/contato",
    oldBots: "❌ Caro e complexo"
  }
];

---

<Layout title={title} description={description} keywords={keywords}>

  <!-- SEO Schemas -->
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script nonce={Astro.locals.nonce} type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <!-- Hero Section -->
  <section class="prod-hero relative overflow-hidden text-center" aria-label="Automação WhatsApp com IA Generativa">
    <!-- Background Effects -->
    <div class="absolute top-0 right-1/2 translate-x-1/2 w-[800px] h-[600px] bg-neon-blue/20 blur-[120px] rounded-full -z-10 animate-pulse-slow"></div>

    <div class="hero-badge reveal">⚡ Automação de Próxima Geração</div>
    <h1 class="hero-title reveal leading-tight">
      Automação WhatsApp com <br/><span class="text-gradient-animated">IA Generativa</span>
    </h1>
    <p class="hero-subtitle reveal max-w-3xl mx-auto mb-10">
      Crie chatbots inteligentes que entendem contexto, emocional e vendem 24/7.
      <strong>Zero código, 100% visual.</strong> Teste Grátis!
    </p>

    <div class="hero-ctas reveal">
      <a href="/criar-bot" class="btn-primary-glow group" aria-label="Criar bot gratuito">
        Criar Meu Primeiro Bot Grátis
        <span class="group-hover:translate-x-1 transition-transform inline-block">→</span>
      </a>
      <a href="#como-funciona" class="btn-outline" aria-label="Ver demonstração">
        Ver Demonstração
      </a>
    </div>

    <!-- Trust Badges -->
    <div class="trust-badges reveal">
      <span class="badge">✅ API Oficial Meta</span>
      <span class="badge">🔒 LGPD Compliant</span>
      <span class="badge">⚡ 99.9% Uptime</span>
    </div>
  </section>

  <!-- Visual Flow Builder Mockup -->
  <section class="py-20 px-5 max-w-7xl mx-auto" id="como-funciona" aria-label="Como funciona a automação visual">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-white mb-4">Construa sem <span class="text-gradient">Programar</span></h2>
      <p class="text-slate-400 max-w-2xl mx-auto">Arraste, solte e conecte. Nosso construtor visual permite criar desde auto-atendimentos simples até funis de vendas complexos em minutos. <strong>Zero código necessário.</strong></p>
    </div>

    <div class="glass-panel p-1 rounded-2xl border border-white/10 shadow-2xl relative overflow-hidden group hover:border-neon-blue/30 transition-colors reveal">
      <div class="bg-void-black rounded-xl relative h-[500px] w-full overflow-hidden pattern-grid-lg">
        
        <!-- Nodes (Simulated) -->
        <div class="absolute top-10 left-10 glass-panel p-4 border-neon-green/50 w-64 shadow-lg">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-neon-green uppercase tracking-wider">Gatilho</span>
            <span class="text-text-secondary">⚡</span>
          </div>
          <p class="text-white font-medium text-sm">Mensagem Recebida</p>
          <div class="mt-2 text-xs text-text-secondary">Contém: "preço" ou "orçamento"</div>
          <!-- Output Dot -->
          <div class="absolute top-1/2 -right-3 w-4 h-4 bg-text-secondary rounded-full border-4 border-void-black"></div>
        </div>

        <!-- Connection Line CSS -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none z-0">
          <path d="M 320 60 C 400 60, 400 150, 480 150" fill="none" stroke="var(--text-secondary)" stroke-width="2" stroke-dasharray="5,5" class="animate-dash" />
          <path d="M 730 180 C 800 180, 800 280, 850 280" fill="none" stroke="var(--text-secondary)" stroke-width="2" />
        </svg>

        <div class="absolute top-28 left-[480px] glass-panel p-4 border-cyber-gold/50 w-64 shadow-lg z-10">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-cyber-gold uppercase tracking-wider">Ação IA</span>
            <span class="text-text-secondary">🧠</span>
          </div>
          <p class="text-white font-medium text-sm">Analisar Intenção</p>
          <div class="mt-2 text-xs text-text-secondary">Modelo: GPT-4o Mini</div>
          <!-- Input Dot -->
          <div class="absolute top-1/2 -left-3 w-4 h-4 bg-text-secondary rounded-full border-4 border-void-black"></div>
          <!-- Output Dot -->
          <div class="absolute top-1/2 -right-3 w-4 h-4 bg-text-secondary rounded-full border-4 border-void-black"></div>
        </div>

        <div class="absolute top-60 left-[850px] glass-panel p-4 border-neon-blue/50 w-64 shadow-lg z-10">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-neon-blue uppercase tracking-wider">Resposta</span>
            <span class="text-text-secondary">💬</span>
          </div>
          <p class="text-white font-medium text-sm">Enviar Catálogo PDF</p>
          <div class="mt-2 text-xs text-text-secondary">Delay: 2 segundos</div>
           <!-- Input Dot -->
           <div class="absolute top-1/2 -left-3 w-4 h-4 bg-text-secondary rounded-full border-4 border-void-black"></div>
        </div>

        <!-- Floating UI Elements -->
        <div class="absolute bottom-5 right-5 bg-black/60 backdrop-blur px-4 py-2 rounded-full border border-white/10 text-xs text-text-secondary">
          ● Auto-Saving...
        </div>
      </div>
    </div>
  </section>

  <!-- AI Deep Dive -->
  <section class="py-24 bg-gradient-to-b from-transparent to-black/30">
    <div class="max-w-7xl mx-auto px-5">
      <div class="mb-16 text-center">
        <span class="text-purple-400 font-bold tracking-wider text-sm uppercase mb-2 block">Inteligência Artificial Real</span>
        <h2 class="text-4xl font-black text-white">Mais que um Chatbot. <br/>Uma <span class="text-gradient">Mente Digital.</span></h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {aiFeatures.map(feat => (
          <div class="feature-card glass-panel group reveal">
            <div class="flex items-start gap-4 p-6">
              <span class="text-4xl bg-white/5 p-3 rounded-xl">{feat.icon}</span>
              <div>
                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-neon-blue transition-colors">{feat.title}</h3>
                <p class="text-text-secondary leading-relaxed">{feat.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-5">
      <h2 class="text-center text-3xl font-bold text-white mb-12">Automação: <span class="text-gradient">Passado vs Futuro</span></h2>
      
      <div class="overflow-x-auto rounded-2xl border border-white/10">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-white/5">
              <th class="p-4 text-slate-300 font-medium">Capacidade</th>
              <th class="p-4 text-primary font-black bg-primary/5 border-b-2 border-primary">GetNexo AI 🚀</th>
              <th class="p-4 text-slate-500 font-medium">Chatbots Antigos (ManyChat, etc)</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            {[
              ["Flexibilidade", "✅ fluxos Infinitos + Código Custom", "⚠️ Limitado aos blocos padrões"],
              ["Treinamento IA", "✅ RAG (Lê seus PDFs/Site)", "❌ Apenas palavras-chave"],
              ["Canais", "✅ WhatsApp, Instagram, Web", "⚠️ Focado em um canal"],
              ["Integrações", "✅ Webhooks, HTTP, n8n Nativo", "⚠️ Depende de Zapier (Pago)"],
              ["Preço Escala", "✅ Fixo (Sem surpresas)", "❌ Cobra por contato/lead"]
            ].map(([feature, nexo, old], idx) => (
              <tr class={`border-t border-white/5 ${(idx % 2 === 0) ? 'bg-white/[0.02]' : ''}`}>
                <td class="p-4 text-white font-medium">{feature}</td>
                <td class="p-4 text-green-400 font-bold bg-primary/5">{nexo}</td>
                <td class="p-4 text-slate-500">{old}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Integrations Grid -->
  <section class="py-20 px-5 max-w-6xl mx-auto">
    <h2 class="text-center text-3xl font-bold text-white mb-16">O Bot que fala com <span class="text-gradient">Todo Mundo</span></h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {integrations.map(int => (
        <div class="glass-panel p-6 text-center hover:bg-white/10 transition-all hover:scale-105 cursor-default">
          <span class="text-3xl block mb-3">{int.icon}</span>
          <h4 class="text-white font-bold mb-1">{int.name}</h4>
          <p class="text-xs text-slate-500">{int.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 px-5 max-w-3xl mx-auto">
    <h2 class="text-3xl font-bold text-white text-center mb-10">Dúvidas Frequentes</h2>
    <div class="space-y-4">
      {faqSchema.mainEntity.map(faq => (
        <details class="glass-panel p-4 rounded-xl group cursor-pointer open:bg-white/10 transition-colors">
          <summary class="flex justify-between items-center font-bold text-white list-none">
            {faq.name}
            <span class="text-primary text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-slate-400 leading-relaxed border-t border-white/5 pt-4 animate-fade-in">
            {faq.acceptedAnswer.text}
          </p>
        </details>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 text-center px-5 relative">
    <div class="max-w-4xl mx-auto glass-panel p-12 rounded-3xl relative overflow-hidden">
      <!-- Glow Effect -->
      <div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-transparent pointer-events-none"></div>
      
      <h2 class="text-4xl md:text-5xl font-black text-white mb-6">
        Pare de perder tempo respondendo <br/> <span class="text-purple-400">perguntas repetidas.</span>
      </h2>
      <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto">
        Automatize 80% do seu atendimento hoje e deixe sua equipe focar no que importa: Fechar Vendas.
