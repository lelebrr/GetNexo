---
import Layout from '../../layouts/Layout.astro';

// SEO Meta Tags
const title = "Soluções GetNexo - Automação WhatsApp com IA | Vendas, CRM e Marketing";
const description = "Conheça todas as soluções GetNexo: Automação com IA, PIX nativo, CRM Kanban, Broadcast e Click-to-WhatsApp Ads. Ferramentas completas para escalar vendas no WhatsApp. Teste Grátis!";
const keywords = "automação whatsapp, crm whatsapp, pix whatsapp, broadcast whatsapp, chatbot ia, getnexo produtos, vendas whatsapp, soluções whatsapp";
const canonical = "https://getnexo.com.br/produtos";

// Structured Data - Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "logo": "https://getnexo.com.br/logo.png",
  "sameAs": [
    "https://www.linkedin.com/company/getnexo",
    "https://twitter.com/getnexo",
    "https://github.com/getnexo"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+5511999999999",
    "contactType": "customer service",
    "areaServed": "BR",
    "availableLanguage": "pt-BR"
  }
};

// WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GetNexo",
  "url": "https://getnexo.com.br",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://getnexo.com.br/buscar?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Início",
      "item": "https://getnexo.com.br"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Produtos",
      "item": "https://getnexo.com.br/produtos"
    }
  ]
};

// Products data with SEO-rich descriptions
const products = [
  {
    icon: "🤖",
    title: "Automação com IA",
    description: "Chatbot inteligente com IA generativa que responde, qualifica leads e agenda reuniões automaticamente 24/7. Treinado com dados do seu negócio.",
    href: "/produtos/automacao",
    badge: "Mais Popular",
    features: ["Respostas humanizadas", "Qualificação automática", "Handoff para humano"],
    seoKeywords: ["chatbot ia", "automação whatsapp", "ia generativa", "qualificação leads"]
  },
  {
    icon: "💰",
    title: "Vendas & Checkout PIX",
    description: "Pagamentos via PIX nativo dentro do WhatsApp. Gere cobranças, confirme pagamentos e gerencie pedidos sem sair da conversa.",
    href: "/produtos/vendas",
    badge: null,
    features: ["PIX copia e cola", "QR Code automático", "Webhook de confirmação"],
    seoKeywords: ["checkout whatsapp", "pix automático", "vendas online", "pagamento chat"]
  },
  {
    icon: "📢",
    title: "Marketing & Broadcast",
    description: "Dispare mensagens para milhares de contatos com segmentação avançada. Integre Click-to-WhatsApp Ads e meça seu ROI.",
    href: "/produtos/marketing",
    badge: "Novo",
    features: ["Broadcast ilimitado", "Templates aprovados", "UTM tracking"],
    seoKeywords: ["click to whatsapp", "broadcast oficial", "marketing whatsapp", "anúncios meta"]
  },
  {
    icon: "📊",
    title: "CRM Multi-Agente",
    description: "Organize leads em Kanban, atribua conversas para sua equipe, monitore SLA e nunca perca uma oportunidade de venda.",
    href: "/produtos/crm",
    badge: null,
    features: ["Kanban visual", "Multi-atendentes", "Métricas em tempo real"],
    seoKeywords: ["crm whatsapp", "kanban leads", "gestão equipe", "pipeline vendas"]
  }
];

// Use cases for SEO
const useCases = [
  { icon: "🛒", title: "E-commerce", desc: "Recupere carrinhos abandonados e venda mais", href: "/segmentos/e-commerce", benefit: "Aumento de 35% em conversões" },
  { icon: "🏥", title: "Clínicas", desc: "Agende consultas e envie lembretes automáticos", href: "/segmentos/clinicas", benefit: "Redução de 60% em no-shows" },
  { icon: "🏠", title: "Imobiliárias", desc: "Qualifique leads e agende visitas 24h", href: "/segmentos/imobiliarias", benefit: "3x mais visitas agendadas" },
  { icon: "📚", title: "Educação", desc: "Engaje alunos e automatize matrículas", href: "/segmentos/educacao", benefit: "Aumento de 40% em matrículas" },
  { icon: "🍕", title: "Delivery", desc: "Receba pedidos e confirme pagamentos via PIX", href: "/segmentos/delivery", benefit: "Entrega em 2min" },
  { icon: "💼", title: "Consultoria", desc: "Agende reuniões e qualifique prospects", href: "/segmentos/consultoria", benefit: "Qualificação 24/7" },
  { icon: "💻", title: "Agência Web", desc: "Automatize suporte, captação e relatórios", href: "/segmentos/agencia-web", benefit: "Eficiência operacional" },
  { icon: "➕", title: "Outros Segmentos", desc: "Turismo, Eventos, Varejo e muito mais", href: "/segmentos/outros", benefit: "Solução personalizada" }
];

// Stats data for trust
const stats = [
  { value: "5.000+", label: "empresas", desc: "usando GetNexo" },
  { value: "99.9%", label: "uptime", desc: "garantido" },
  { value: "24/7", label: "suporte", desc: "em português" },
  { value: "Grátis", label: "setup", desc: "sem cartão" }
];
---

<Layout title={title} description={description} keywords={keywords}>
  <section class="products-hero">
    <div class="hero-badge">Ecossistema Completo</div>
    <h1>Soluções <span class="text-gradient">GetNexo</span></h1>
    <p class="hero-desc">
      Ferramentas poderosas para automatizar cada etapa do seu funil de vendas no WhatsApp — do primeiro contato ao pagamento confirmado.
    </p>

    <div class="products-grid">
      {products.map(product => (
        <a href={product.href} class="product-card glass-panel">
          {product.badge && <span class="card-badge">{product.badge}</span>}
          <div class="card-icon">{product.icon}</div>
          <h3>{product.title}</h3>
          <p>{product.description}</p>
          <ul class="feature-list">
            {product.features.map(f => <li>✓ {f}</li>)}
          </ul>
          <span class="learn-more">Explorar solução →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="use-cases">
    <h2>Usado por <span class="text-gradient">milhares de empresas</span></h2>
    <p class="section-desc">Descubra como diferentes segmentos estão transformando suas vendas com GetNexo</p>
    
    <div class="cases-grid">
      {useCases.map(uc => (
        <a href={uc.href} class="case-card glass-panel">
          <span class="case-icon">{uc.icon}</span>
          <h4>{uc.title}</h4>
          <p>{uc.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="products-cta">
    <div class="glass-panel cta-box">
      <h2>Pronto para <span class="text-gradient">automatizar suas vendas</span>?</h2>
      <p>Comece gratuitamente e veja resultados em minutos, não dias.</p>
      <div class="cta-buttons">
        <a href="/criar-bot" class="btn-primary">Criar Meu Bot Grátis</a>
        <a href="/demo" class="btn-outline">Ver Demonstração</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .products-hero {
    padding: 8rem 5% 4rem;
    text-align: center;
    max-width: 1300px;
    margin: 0 auto;
  }
  
  .hero-badge {
    background: rgba(0, 212, 255, 0.1);
    color: #00d4ff;
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    border: 1px solid rgba(0, 212, 255, 0.2);
    display: inline-block;
    margin-bottom: 2rem;
  }
  
  .products-hero h1 {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
    color: white;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  
  .hero-desc {
    font-size: 1.35rem;
    color: #94a3b8;
    max-width: 800px;
    margin: 0 auto 3rem;
    line-height: 1.6;
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .badge {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  .product-card {
    padding: 2.5rem 2rem;
    text-decoration: none;
    text-align: left;
    transition: 0.3s;
    border: 1px solid rgba(255,255,255,0.05);
    position: relative;
    overflow: hidden;
  }
  
  .product-card:hover {
    border-color: #00ff9d;
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 255, 157, 0.1);
  }
  
  .card-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: linear-gradient(135deg, #00d4ff, #00ff9d);
    color: black;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  
  .card-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }
  
  .product-card h3 {
    color: white;
    font-size: 1.4rem;
    margin-bottom: 1rem;
    font-weight: 800;
  }
  
  .product-card p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  
  .feature-list {
    list-style: none;
    padding: 0;
    margin-bottom: 1rem;
  }
  
  .feature-list li {
    color: #64748b;
    font-size: 0.85rem;
    padding: 0.3rem 0;
  }

  .seo-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .keyword-tag {
    background: rgba(0, 212, 255, 0.1);
    color: #00d4ff;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  .learn-more {
    color: #00ff9d;
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* Stats Section */
  .stats-section {
    padding: 4rem 5%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .stat-card {
    padding: 2rem;
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 900;
    color: #00ff9d;
    line-height: 1;
  }

  .stat-label {
    display: block;
    color: white;
    font-weight: 700;
    font-size: 1rem;
    margin-top: 0.3rem;
  }

  .stat-desc {
    display: block;
    color: #64748b;
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }

  /* Use Cases */
  .use-cases {
    padding: 6rem 5%;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  
  .use-cases h2 {
    font-size: 2.5rem;
    color: white;
    margin-bottom: 1rem;
    font-weight: 800;
  }
  
  .section-desc {
    color: #64748b;
    font-size: 1.1rem;
    margin-bottom: 4rem;
  }
  
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
  }
  
  .case-card {
    padding: 2rem 1.5rem;
    text-align: center;
    transition: 0.3s;
    text-decoration: none;
    display: block;
    border: 1px solid rgba(255,255,255,0.05);
    position: relative;
    overflow: hidden;
  }
  
  .case-card:hover {
    transform: translateY(-5px);
    border-color: #00d4ff;
    background: rgba(255,255,255,0.03);
  }
  
  .case-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }
  
  .case-card h4 {
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  
  .case-card p {
    color: #64748b;
    font-size: 0.85rem;
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .case-benefit {
    color: #00d4ff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* CTA Section */
  .products-cta {
    padding: 4rem 5% 8rem;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .cta-box {
    padding: 4rem;
    text-align: center;
    border-radius: 32px;
  }
  
  .cta-box h2 {
    font-size: 2.5rem;
    color: white;
    margin-bottom: 1rem;
    font-weight: 800;
  }
  
  .cta-box p {
    color: #94a3b8;
    font-size: 1.2rem;
    margin-bottom: 2.5rem;
  }
  
  .cta-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, #00d4ff, #00ff9d);
    color: black;
    padding: 1rem 2.5rem;
    border-radius: 12px;
    font-weight: 800;
    text-decoration: none;
    transition: 0.3s;
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 212, 255, 0.3);
  }
  
  .btn-outline {
    border: 1px solid rgba(255,255,255,0.1);
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    background: rgba(255,255,255,0.03);
    transition: 0.3s;
  }
  
  .btn-outline:hover {
    background: rgba(255,255,255,0.08);
    border-color: #00d4ff;
  }

  .cta-note {
    color: #475569;
    font-size: 0.85rem;
    margin-top: 1.5rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .products-hero h1 { font-size: 2.5rem; }
    .hero-desc { font-size: 1.1rem; }
    .trust-badges { flex-direction: column; gap: 0.5rem; }
    .badge { font-size: 0.75rem; }
    .use-cases h2 { font-size: 2rem; }
    .cta-box { padding: 2.5rem; }
    .cta-box h2 { font-size: 2rem; }
  }

  @media (max-width: 1024px) {
    .products-hero h1 { font-size: 3rem; }
  }
</style>
