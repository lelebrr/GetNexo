  { value: "100%", label: "PIX Automático", desc: "confirmação sem humano" }
];

// Steps data
const steps = [
  { num: "01", title: "Interesse", desc: "Cliente pergunta ou clica no catálogo", icon: "👀" },
  { num: "02", title: "Escolha", desc: "IA apresenta produtos e variantes", icon: "🛍️" },
  { num: "03", title: "Checkout", desc: "Carrinho é fechado no próprio chat", icon: "✅" },
  { num: "04", title: "PIX", desc: "QR Code gerado e pago instantaneamente", icon: "💰" }
];

// Trust badges
const trustBadges = [
  { label: "PCI Compliance", icon: "🛡️" },
  { label: "PIX Bacen Ready", icon: "🇧🇷" },
  { label: "SSL Encrypted", icon: "🔒" },
  { label: "Official Meta API", icon: "✅" }
];

// Integrations data
const integrations = [
  { name: "n8n", icon: "⚡", desc: "Automação infinita open-source", url: "https://n8n.io" },
  { name: "Typebot", icon: "🤖", desc: "Construtor visual de conversas", url: "https://typebot.io" },
  { name: "ChatGPT", icon: "🧠", desc: "Inteligência Generativa Nativa", url: "https://openai.com" },
  { name: "Webhooks", icon: "🔗", desc: "Conecte com qualquer API REST", url: "#" },
  { name: "Google Sheets", icon: "📊", desc: "Banco de dados simples e ágil", url: "https://sheets.google.com" },
  { name: "Stripe", icon: "💳", desc: "Cobranças direto no chat", url: "https://stripe.com" },
  { name: "MercadoPago", icon: "💳", desc: "Pagamentos no Brasil", url: "https://mercadopago.com.br" },
  { name: "Zapier", icon: "🔗", desc: "Automação no-code", url: "https://zapier.com" }
];



---

<Layout title={title} description={description} keywords={keywords}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero Section -->
  <section class="prod-hero relative py-20 px-4 text-center overflow-hidden" aria-label="Introdução Vendas WhatsApp">
    <div class="absolute inset-0 bg-gradient-to-b from-neon-blue/10 to-transparent -z-10"></div>
    
    <div class="hero-badge mb-6 reveal">💰 Venda 3x Mais no WhatsApp</div>
    <h1 class="hero-title reveal leading-tight">
      O Checkout que acontece <span class="text-gradient-animated">Dentro da Janela</span>
    </h1>
    <p class="hero-subtitle reveal max-w-3xl mx-auto mb-10">
      Reduza o abandono de carrinho em 67% oferecendo uma experiência de compra fluida via PIX, totalmente integrada ao catálogo da sua loja.
    </p>
    
    <div class="hero-ctas flex flex-col md:flex-row gap-4 justify-center mb-16 reveal">
      <a href="/criar-bot" class="btn-primary-glow">
        Ativar Vendas no Chat
      </a>
      <a href="/demo" class="btn-outline">
        Ver Fluxo PIX →
      </a>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto reveal">
      {stats.map(stat => (
        <div class="glass-panel p-6">
          <span class="block text-3xl font-black text-neon-green">{stat.value}</span>
          <span class="block text-sm font-bold text-white uppercase mt-1">{stat.label}</span>
          <span class="block text-xs text-text-secondary mt-1">{stat.desc}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Checkout Flow Steps -->
  <section class="py-20 bg-slate-900/40 border-y border-white/5" aria-label="Passo a passo da venda">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-white text-center mb-16">O Caminho Mais Curto para o <span class="text-green-400">Pagamento</span></h2>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {steps.map((step, i) => (
          <div class="relative group">
            <div class="text-center p-8 rounded-3xl bg-[#1a1f2e] border border-slate-800 group-hover:border-green-500/30 transition-all h-full">
              <span class="text-5xl mb-6 block group-hover:scale-110 transition-transform">{step.icon}</span>
              <span class="inline-block px-3 py-1 bg-green-900/20 text-green-400 rounded-full text-xs font-bold mb-4">PASSO {step.num}</span>
              <h3 class="text-xl font-bold text-white mb-2">{step.title}</h3>
              <p class="text-slate-400 text-sm">{step.desc}</p>
            </div>
            {i < steps.length - 1 && (
              <div class="hidden md:block absolute top-1/2 -right-4 translate-x-1/2 -translate-y-1/2 text-green-900/30 text-4xl">→</div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PIX Demo Section (Accessible) -->
  <section class="py-20 px-4" aria-label="Demonstração do Checkout PIX">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      
      <div class="reveal">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-6 leading-tight">Pagamento PIX com <span class="text-gradient">Confirmação Instantânea</span></h2>
        <p class="text-text-secondary text-lg mb-8 leading-relaxed">
          Esqueça o envio manual de chaves. O GetNexo gera o QR Code na hora, com o valor exato, e seu cliente paga sem sair da conversa.
        </p>
        
        <ul class="space-y-4 mb-10">
          <li class="flex items-center gap-3 text-slate-300">
            <span class="w-2 h-2 rounded-full bg-green-400"></span>
            Geração de QR Code dinâmico por pedido
          </li>
          <li class="flex items-center gap-3 text-slate-300">
            <span class="w-2 h-2 rounded-full bg-green-400"></span>
            Botão de "Copia e Cola" acessível
          </li>
          <li class="flex items-center gap-3 text-slate-300">
            <span class="w-2 h-2 rounded-full bg-green-400"></span>
            Aviso de pagamento aprovado automático
          </li>
          <li class="flex items-center gap-3 text-slate-300">
            <span class="w-2 h-2 rounded-full bg-green-400"></span>
            Webhook para integração com estoque/ERP
          </li>
        </ul>
        
        <div class="flex flex-wrap gap-4">
          {trustBadges.map(badge => (
            <span class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-xs font-bold text-slate-400 flex items-center gap-2">
              {badge.icon} {badge.label}
            </span>
          ))}
        </div>
      </div>

      <!-- PIX Visual Mockup -->
      <div class="flex justify-center" role="img" aria-label="Mockup de uma tela de celular exibindo o fechamento de um carrinho no WhatsApp com QR Code PIX e valor de R$127,90">
        <div class="pix-visual-container p-4 rounded-[3rem] bg-slate-800 border-4 border-slate-700 shadow-2xl relative">
          <div class="phone-screen bg-[#0a0f1a] rounded-[2.5rem] p-6 overflow-hidden w-[300px] min-h-[500px]">
            <div class="flex items-center gap-3 mb-8 pb-4 border-b border-white/5">
              <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white">GN</div>
              <div>
                <div class="text-white font-bold text-sm">GetNexo Checkout</div>
                <div class="text-green-500 text-[10px]">● Online</div>
              </div>
            </div>

            <div class="chat-bubble bg-slate-800 rounded-2xl rounded-tl-none p-4 text-white text-xs mb-4">
              ✅ Pedido confirmado! <br/> 
              <strong>Items:</strong> Kit Gamer (1x)<br/>
              <strong>Total: R$ 127,90</strong>
            </div>

            <div class="pix-card bg-white rounded-2xl p-6 text-center text-black">
              <div class="text-[10px] font-bold text-slate-500 uppercase mb-3">Escaneie para Pagar</div>
              <div class="qr-code w-32 h-32 mx-auto bg-slate-200 rounded-lg mb-4 flex items-center justify-center overflow-hidden">
                <!-- Simulated QR with grid -->
                <div class="grid grid-cols-8 gap-1 p-2 w-full h-full opacity-80">
                   {Array(64).fill(0).map((_, i) => <div class={`w-full h-full ${i%3==0?'bg-black':'bg-white'}`}></div>)}
                </div>
              </div>
              <div class="text-xl font-black mb-1">R$ 127,90</div>
              <button class="w-full py-2 bg-green-600 text-white rounded-lg text-[10px] font-bold hover:bg-green-700 transition-colors focus:ring-2 focus:ring-green-400 outline-none" aria-label="Copiar código PIX">
                COPIAR CÓDIGO PIX
              </button>
            </div>
            
            <div class="mt-4 text-center text-[10px] text-slate-600 font-medium">
              ⏱ Expira em 14:59s
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {features.map(f => (
          <article class="glass-panel p-8 flex items-start gap-6 group reveal">
            <span class="text-4xl p-4 bg-neon-green/10 rounded-2xl group-hover:grayscale-0 grayscale transition-all">{f.icon}</span>
            <div>
              <h3 class="text-xl font-bold text-white mb-3">{f.title}</h3>
              <p class="text-text-secondary text-sm leading-relaxed mb-6">{f.description}</p>
              <div class="grid grid-cols-2 gap-3">
                {f.details.map(d => (
                  <div class="text-[10px] font-bold text-text-secondary uppercase flex items-center gap-1">
                    <span class="text-neon-green">✓</span> {d}
                  </div>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Integrations logos -->
  <section class="py-16 border-t border-white/5 bg-slate-950/50">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p class="text-xs font-bold text-slate-600 uppercase tracking-widest mb-10">Integração nativa com os maiores do mercado</p>
      <div class="flex flex-wrap justify-center gap-10 opacity-40 grayscale hover:grayscale-0 transition-all">
        <span class="text-white font-black text-xl">SHOPIFY</span>
        <span class="text-white font-black text-xl">WOOCOMMERCE</span>
        <span class="text-white font-black text-xl">NUVEMSHOP</span>
        <span class="text-white font-black text-xl">MERCADOPAGO</span>
        <span class="text-white font-black text-xl">PAGSEGURO</span>
        <span class="text-white font-black text-xl">BLING</span>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 px-4 max-w-4xl mx-auto" aria-label="Perguntas Frequentes">
    <h2 class="text-3xl font-bold text-white text-center mb-12">Perguntas Frequentes</h2>
    <div class="space-y-4">
      <details class="group bg-[#161b22] rounded-2xl border border-white/5 open:bg-[#1c2128] transition-all">
        <summary class="flex justify-between items-center cursor-pointer p-6 font-semibold text-white list-none focus:outline-none focus:ring-2 focus:ring-green-400 rounded-2xl">
          <span>O GetNexo cobra comissão sobre as vendas?</span>
          <span class="transition-transform group-open:rotate-180">▼</span>
        </summary>
        <div class="px-6 pb-6 text-slate-400 text-sm leading-relaxed">
          NÃO cobramos comissão por venda efetuada. Você paga apenas a mensalidade do seu plano. Todas as taxas de intermediação são pagas diretamente ao seu provedor de pagamento (Mercado Pago, PagSeguro, etc.).
        </div>
      </details>

      <details class="group bg-[#161b22] rounded-2xl border border-white/5 open:bg-[#1c2128] transition-all">
        <summary class="flex justify-between items-center cursor-pointer p-6 font-semibold text-white list-none focus:outline-none focus:ring-2 focus:ring-green-400 rounded-2xl">
          <span>É seguro receber via PIX pelo WhatsApp?</span>
          <span class="transition-transform group-open:rotate-180">▼</span>
        </summary>
        <div class="px-6 pb-6 text-slate-400 text-sm leading-relaxed">
          Extremamente seguro. O GetNexo não armazena seu dinheiro. Nós apenas conectamos seu WhatsApp à API oficial do seu banco ou gateway de pagamento. O dinheiro cai direto na sua conta e a confirmação é feita via protocolo SSL criptografado.
        </div>
      </details>

      <details class="group bg-[#161b22] rounded-2xl border border-white/5 open:bg-[#1c2128] transition-all">
        <summary class="flex justify-between items-center cursor-pointer p-6 font-semibold text-white list-none focus:outline-none focus:ring-2 focus:ring-green-400 rounded-2xl">
          <span>Como funciona a sincronização de estoque?</span>
          <span class="transition-transform group-open:rotate-180">▼</span>
        </summary>
        <div class="px-6 pb-6 text-slate-400 text-sm leading-relaxed">
          Se você integrar com Shopify, Nuvemshop ou WooCommerce, o GetNexo consulta seu estoque em tempo real. Se um produto acaba na sua loja, a IA avisa automaticamente o cliente no WhatsApp que aquele item está indisponível, evitando vendas sem produto.
        </div>
      </details>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 px-4 text-center">
