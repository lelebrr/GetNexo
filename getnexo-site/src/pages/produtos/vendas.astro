const description = "Checkout nativo no WhatsApp com pagamento PIX automático. Reduza abandono em 67%, venda 3x mais com experiência fluida no chat. Teste Grátis!";
const keywords = "checkout whatsapp, pix automático, vendas whatsapp, carrinho whatsapp, pagamento pix chat, api oficial whatsapp, getnexo vendas, checkout pix, vendas online";
const canonical = "https://getnexo.com.br/produtos/vendas";

// Structured Data - Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GetNexo",
