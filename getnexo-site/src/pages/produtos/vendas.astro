    ]
  },
  {
    icon: "💎",
    title: "PIX Express Automático",
    description: "Gere cobranças dinâmicas com QR Code. O sistema monitora o banco e avisa o cliente sobre a aprovação em milisegundos.",
    seoKeywords: ["pix automático", "qr code dinâmico", "confirmação instantânea"],
    details: [
      "QR Code dinâmico por pedido",
      "Copia e Cola in-chat",
      "Confirmação real-time",
      "Conciliação bancária direta"
    ]
  },
  {
    icon: "📈",
    title: "Recuperação de Carrinho com IA",
    description: "A IA persegue os abandonos de carrinho com ofertas irresistíveis enviadas no momento certo.",
    seoKeywords: ["recuperação carrinho", "abandono checkout", "ia vendas"],
    details: [
      "Lembretes 2h/24h depois",
      "Gatilhos de escassez",
      "Link de checkout pronto",
      "Tracking de recuperação"
    ]
  },
  {
    icon: "🔌",
    title: "Eco-Sistema Integrado",
    description: "Sincronize pedidos e estoque com suas ferramentas favoritas de e-commerce e ERP.",
    seoKeywords: ["integração shopify", "woocommerce sync", "erp integração"],
    details: [
      "Sync Shopify & WooCommerce",
      "Integração Bling/Tiny",
      "Webhooks personalizados",
      "API para desenvolvedores"
    ]
  }
];

// Use cases for SEO
const useCases = [
  { icon: "🛒", title: "E-commerce", desc: "Checkout direto no WhatsApp", benefit: "Aumento de 3x em conversões" },
  { icon: "🍕", title: "Delivery", desc: "Pedidos e pagamentos via PIX", benefit: "Entrega em 2min" },
  { icon: "🏠", title: "Imobiliárias", desc: "Vendas de imóveis no chat", benefit: "Fechamento 24/7" },
  { icon: "📚", title: "Educação", desc: "Matrículas e pagamentos", benefit: "Redução de 50% em burocracia" }
];

// Comparison data for comparison
const comparisonData = [
