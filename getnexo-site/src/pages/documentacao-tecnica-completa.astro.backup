            </div>
          </div>
          <div class="feature">
            <span class="feature-icon">🔍</span>
            <div class="feature-content">
              <h4>Compliance Auditing</h4>
              <p>Auditorias automatizadas de compliance e conformidade</p>
            </div>
          </div>
        </div>
      </div>
    </div>

