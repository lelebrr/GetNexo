  <!-- Security & Compliance -->
  <section id="security" class="security-section">
    <div class="section-header">
      <h2>🔒 Segurança & Compliance Enterprise</h2>
      <p>Segurança de nível bancário com compliance completo LGPD, GDPR e SOC 2</p>
    </div>

    <div class="security-framework">
      <div class="security-layer">
        <h3>🔐 Autenticação & Autorização</h3>
        <div class="security-features">
          <div class="feature">
            <span class="feature-icon">🔑</span>
            <div class="feature-content">
              <h4>JWT + OAuth 2.0</h4>
              <p>Tokens JWT com refresh automático e integração OAuth 2.0 completa</p>
            </div>
          </div>
          <div class="feature">
            <span class="feature-icon">👥</span>
            <div class="feature-content">
              <h4>Role-Based Access Control</h4>
              <p>RBAC granular com permissões específicas por usuário e departamento</p>
            </div>
          </div>
          <div class="feature">
            <span class="feature-icon">🔢</span>
            <div class="feature-content">
              <h4>Multi-Factor Authentication</h4>
              <p>MFA obrigatório com TOTP, SMS e autenticação por push</p>
            </div>
          </div>
        </div>
      </div>

      <div class="security-layer">
        <h3>🔒 Criptografia & Dados</h3>
        <div class="security-features">
          <div class="feature">
            <span class="feature-icon">🛡️</span>
            <div class="feature-content">
              <h4>AES-256 End-to-End</h4>
              <p>Criptografia AES-256 para dados em trânsito e em repouso</p>
            </div>
          </div>
          <div class="feature">
            <span class="feature-icon">🔐</span>
            <div class="feature-content">
              <h4>Hashing Seguro</h4>
              <p>Bcrypt para senhas, SHA-256 para integridade de dados</p>
            </div>
          </div>
          <div class="feature">
            <span class="feature-icon">🗝️</span>
            <div class="feature-content">
              <h4>Key Management</h4>
              <p>HSM dedicado para gerenciamento de chaves criptográficas</p>
            </div>
          </div>
        </div>
      </div>

      <div class="security-layer">
        <h3>📊 Monitoramento & Auditoria</h3>
        <div class="security-features">
          <div class="feature">
            <span class="feature-icon">📋</span>
            <div class="feature-content">
