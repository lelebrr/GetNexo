---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import GameContainer from '../../components/games/GameContainer.jsx';

const { gameType } = Astro.params;
const userId = Astro.url.searchParams.get('userId');
const conversationId = Astro.url.searchParams.get('conversationId');

// Disable header/footer for iframe embedding
const isIframe = true;
---

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minigame - {gameType}</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: transparent;
            font-family: 'Inter', sans-serif;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        #game-root {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div id="game-root">
        <GameContainer 
            client:load 
            gameType={gameType} 
            userId={userId} 
            conversationId={conversationId}
            onClose={() => {
                // Post message to parent window to close iframe
                window.parent.postMessage({ action: 'closeGame' }, '*');
            }}
            onPointsEarned={(points) => {
                window.parent.postMessage({ action: 'pointsEarned', points }, '*');
            }}
        />
    </div>
</body>
</html>
