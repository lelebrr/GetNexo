---
import Layout from '../layouts/Layout.astro';
import DemoChatComTudozinho from '../components/DemoChatComTudozinho.jsx';

const title = "Demo Completo GetNexo - IA, Voz, AR e Tour Guiado";
const description = "Teste tudo: síntese de voz brasileira, geração de imagens IA, Realidade Aumentada 3D, tour interativo e chat inteligente. Experiência completa da tecnologia GetNexo.";
---

<Layout title={title} description={description} isLanding={false}>
  <section class="py-20 px-4 max-w-6xl mx-auto min-h-[80vh] flex flex-col items-center justify-center">
    <div class="text-center mb-12 reveal">
      <h1 class="text-4xl md:text-6xl font-black text-white mb-4">
        <span class="text-gradient">Demo Completo</span> GetNexo
      </h1>
      <p class="text-gray-400 text-xl max-w-2xl mx-auto">
        IA conversacional, voz brasileira, Realidade Aumentada 3D, geração de imagens e tour guiado. Tudo integrado em uma experiência única.
      </p>
    </div>

    <div class="w-full max-w-2xl reveal">
      <DemoChatComTudozinho client:load />
    </div>

    <div class="mt-16 text-center reveal">
      <p class="text-gray-500 mb-6">Pronto para implementar no seu negócio?</p>
      <a href="/criar-conta" class="btn-primary-glow">Começar Agora Grátis</a>
    </div>
  </section>
</Layout>

<style>
  .reveal { opacity: 0; transform: translateY(20px); transition: 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .reveal.active { opacity: 1; transform: translateY(0); }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const reveals = document.querySelectorAll('.reveal');
    reveals.forEach(el => el.classList.add('active'));
  });
</script>
