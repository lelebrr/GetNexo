---
import Layout from '../../layouts/Layout.astro';

// Configurações atuais (pode vir de API ou Supabase depois)
const config = {
  iaResposta: 'grok-code-fast-1',
  iaImagem: 'flux-schnell',
  vozAtiva: true,
  arLogo: true,
  tourAutomatico: true,
  delayResposta: 1500,
  maxMensagens: 50,
  logAtivo: true,
  notificacoes: true,
  tema: 'escuro',
  idioma: 'pt-BR',
  produtosReais: [
    'tenis branco', 'tenis preto', 'bota marrom', 'chinelo simples', 'salto bege',
    'camiseta branca', 'camiseta preta', 'calca jeans', 'jaqueta verde', 'vestido preto',
    'oculos sol', 'relógio prata', 'bolsa crossbody', 'chapeu fedora', 'pulseira prata',
    'celular preto', 'fone ouvido', 'smartwatch', 'teclado gamer', 'carregador wireless',
    'vasinho planta', 'mesa centro', 'cadeira gamer', 'abajur minimal', 'quadro 3d'
  ]
}
---

<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <title>GetNexo - Painel Admin Demo</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Inter', sans-serif; background: #0f172a; color: #e2e8f0; }
    .admin-container { max-width: 800px; margin: 2rem auto; padding: 2rem; background: #1e293b; border-radius: 1rem; border: 1px solid #334155; }
    input, select { background: #334155; border: 1px solid #475569; color: white; padding: 0.5rem; border-radius: 0.5rem; width: 100%; }
    button { background: linear-gradient(to right, #06b6d4, #22c55e); border: none; padding: 0.75rem 1.5rem; color: black; font-weight: 600; border-radius: 0.5rem; cursor: pointer; margin: 0.25rem; }
    button:hover { opacity: 0.9; transform: translateY(-1px); }
    ul { list-style: none; padding: 0; }
    li { background: #334155; margin: 0.5rem 0; padding: 0.75rem; border-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; }
    .delete-btn { background: #dc2626; color: white; border: none; padding: 0.25rem 0.5rem; border-radius: 0.25rem; cursor: pointer; }
    .delete-btn:hover { background: #b91c1c; }
    pre { background: #0f172a; border: 1px solid #334155; padding: 1rem; border-radius: 0.5rem; overflow: auto; font-size: 0.875rem; }
    h1 { color: #06b6d4; margin-bottom: 2rem; }
    h2 { color: #22c55e; margin: 1.5rem 0 0.5rem 0; }
  </style>
</head>
<body>
  <div class="admin-container">
    <h1>🎛️ Configuração Demo GetNexo</h1>
    <p style="color: #94a3b8; margin-bottom: 2rem;">Configure todas as funcionalidades do demo interativo</p>

    <form id="config-form">
      <h2>🤖 IA para Respostas</h2>
      <select id="iaResposta" value={config.iaResposta}>
        <option value="grok-code-fast-1">Grok Code Fast-1 (Recomendado)</option>
        <option value="gpt-4">GPT-4</option>
        <option value="claude-3">Claude-3</option>
      </select>

      <h2>🎨 IA para Imagens</h2>
      <select id="iaImagem" value={config.iaImagem}>
        <option value="flux-schnell">Flux Schnell (Recomendado)</option>
        <option value="dalle-3">DALL-E 3</option>
        <option value="midjourney">Midjourney</option>
      </select>

      <h2>🎤 Voz Ativa</h2>
      <label style="display: flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="vozAtiva" checked={config.vozAtiva} />
        <span>Ativar síntese de voz brasileira</span>
      </label>

      <h2>🏷️ Logo AR Pulsante</h2>
      <label style="display: flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="arLogo" checked={config.arLogo} />
        <span>Mostrar logo pulsante no AR</span>
      </label>

      <h2>🎯 Tour Automático</h2>
      <label style="display: flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="tourAutomatico" checked={config.tourAutomatico} />
        <span>Iniciar tour automaticamente</span>
      </label>

      <h2>⏱️ Delay de Resposta (ms)</h2>
      <input type="number" id="delayResposta" value={config.delayResposta} min="500" max="5000" step="100" />

      <h2>📊 Máximo de Mensagens</h2>
      <input type="number" id="maxMensagens" value={config.maxMensagens} min="10" max="200" />

      <h2>📝 Logs Ativos</h2>
      <label style="display: flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="logAtivo" checked={config.logAtivo} />
        <span>Registrar atividades no console</span>
      </label>

      <h2>🔔 Notificações</h2>
      <label style="display: flex; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="notificacoes" checked={config.notificacoes} />
        <span>Ativar notificações do sistema</span>
      </label>

      <h2>🎨 Tema</h2>
      <select id="tema" value={config.tema}>
        <option value="escuro">Escuro (Recomendado)</option>
        <option value="claro">Claro</option>
        <option value="auto">Automático</option>
      </select>

      <h2>🌍 Idioma</h2>
      <select id="idioma" value={config.idioma}>
        <option value="pt-BR">Português (Brasil)</option>
        <option value="en-US">English</option>
        <option value="es-ES">Español</option>
      </select>

      <h2>📦 Produtos Reais (sem IA imagem)</h2>
      <p style="color: #94a3b8; font-size: 0.875rem; margin-bottom: 1rem;">
        Estes produtos existem no estoque e não geram imagens por IA
      </p>
      <ul id="produtos-list">
        {config.produtosReais.map((produto, index) => (
          <li key={index}>
            <span>{produto}</span>
            <button type="button" class="delete-btn" onclick={`removerProduto(${index})`}>❌</button>
          </li>
        ))}
      </ul>
      <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
        <input id="novo-produto" placeholder="ex: notebook dell" style="flex: 1;" />
        <button type="button" onclick="adicionarProduto()">➕ Adicionar</button>
      </div>
    </form>

    <div style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #334155;">
      <h2>💾 Ações</h2>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button onclick="salvarConfig()">💾 Salvar Configuração</button>
        <button onclick="carregarConfig()">📂 Carregar Salva</button>
        <button onclick="resetarConfig()">🔄 Resetar Padrão</button>
        <button onclick="irParaDemo()">🎪 Ver Demo</button>
      </div>
    </div>

    <div style="margin-top: 2rem;">
      <h2>📋 Configuração Atual (JSON)</h2>
      <pre id="config-preview">{JSON.stringify(config, null, 2)}</pre>
    </div>
  </div>

  <script nonce={Astro.locals.nonce}>
    let configAtual = { ...config }

    function atualizarPreview() {
      document.getElementById('config-preview').textContent = JSON.stringify(configAtual, null, 2)
    }

    function salvarConfig() {
      // Salva no localStorage (pode ser API depois)
      localStorage.setItem('getnexo-demo-config', JSON.stringify(configAtual))
      alert('✅ Configuração salva com sucesso!')
      atualizarPreview()
    }

    function carregarConfig() {
      const salva = localStorage.getItem('getnexo-demo-config')
      if (salva) {
        configAtual = JSON.parse(salva)
        alert('✅ Configuração carregada!')
        location.reload() // Recarrega para aplicar
      } else {
        alert('❌ Nenhuma configuração salva encontrada')
      }
    }

    function resetarConfig() {
      if (confirm('Tem certeza que quer resetar para as configurações padrão?')) {
        localStorage.removeItem('getnexo-demo-config')
        location.reload()
      }
    }

    function adicionarProduto() {
      const input = document.getElementById('novo-produto')
      const produto = input.value.trim().toLowerCase()
      if (produto && !configAtual.produtosReais.includes(produto)) {
        configAtual.produtosReais.push(produto)
        input.value = ''
        atualizarListaProdutos()
        atualizarPreview()
      } else {
        alert('Produto já existe ou campo vazio!')
      }
    }

    function removerProduto(index) {
      if (confirm('Remover este produto da lista?')) {
        configAtual.produtosReais.splice(index, 1)
        atualizarListaProdutos()
        atualizarPreview()
      }
    }

    function atualizarListaProdutos() {
      const lista = document.getElementById('produtos-list')
      lista.innerHTML = configAtual.produtosReais.map((produto, index) =>
        `<li>
          <span>${produto}</span>
          <button type="button" class="delete-btn" onclick="removerProduto(${index})">❌</button>
        </li>`
      ).join('')
    }

    function irParaDemo() {
      window.open('/demo', '_blank')
    }

    // Atualiza configAtual quando inputs mudam
    document.getElementById('iaResposta').addEventListener('change', (e) => {
      configAtual.iaResposta = e.target.value
      atualizarPreview()
    })

    document.getElementById('iaImagem').addEventListener('change', (e) => {
      configAtual.iaImagem = e.target.value
      atualizarPreview()
    })

    document.getElementById('vozAtiva').addEventListener('change', (e) => {
      configAtual.vozAtiva = e.target.checked
      atualizarPreview()
    })

    document.getElementById('arLogo').addEventListener('change', (e) => {
      configAtual.arLogo = e.target.checked
      atualizarPreview()
    })

    document.getElementById('tourAutomatico').addEventListener('change', (e) => {
      configAtual.tourAutomatico = e.target.checked
      atualizarPreview()
    })

    document.getElementById('delayResposta').addEventListener('input', (e) => {
      configAtual.delayResposta = parseInt(e.target.value)
      atualizarPreview()
    })

    document.getElementById('maxMensagens').addEventListener('input', (e) => {
      configAtual.maxMensagens = parseInt(e.target.value)
      atualizarPreview()
    })

    document.getElementById('logAtivo').addEventListener('change', (e) => {
      configAtual.logAtivo = e.target.checked
      atualizarPreview()
    })

    document.getElementById('notificacoes').addEventListener('change', (e) => {
      configAtual.notificacoes = e.target.checked
      atualizarPreview()
    })

    document.getElementById('tema').addEventListener('change', (e) => {
      configAtual.tema = e.target.value
      atualizarPreview()
    })

    document.getElementById('idioma').addEventListener('change', (e) => {
      configAtual.idioma = e.target.value
      atualizarPreview()
    })

    // Carrega config salva na inicialização
    const configSalva = localStorage.getItem('getnexo-demo-config')
    if (configSalva) {
      configAtual = { ...configAtual, ...JSON.parse(configSalva) }
      atualizarPreview()
    }
  </script>
</body>
</html>