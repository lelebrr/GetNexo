---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Configurações Gerais" activeTab="config">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-gray-500 to-slate-500 rounded-2xl flex items-center justify-center shadow-lg shadow-gray-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Configurações Gerais
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Gerencie usuários, permissões, notificações e templates.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/config/users" class="px-6 py-3 bg-gray-600/20 hover:bg-gray-600/40 text-gray-400 rounded-lg border border-gray-500/30 transition-all">Usuários & Permissões</a>
      <a href="/admin/config/roles" class="px-6 py-3 bg-slate-600/20 hover:bg-slate-600/40 text-slate-400 rounded-lg border border-slate-500/30 transition-all">Roles & Acessos</a>
      <a href="/admin/config/notifications" class="px-6 py-3 bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 rounded-lg border border-purple-500/30 transition-all">Notificações</a>
    </div>
  </div>
</AdminLayout>
