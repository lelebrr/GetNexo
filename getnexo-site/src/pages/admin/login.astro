---
import LoginLayout from '../../layouts/LoginLayout.astro';
---
<LoginLayout title="Admin Login | GetNexo">
    <div class="login-box cyber-card">
        <div class="logo">NEXUS<span class="dot">.</span></div>
        <h2>Access Terminal</h2>
        <p class="subtitle">Enter credentials to initialize session</p>
        
        <form id="login-form">
            <div class="input-group">
                <label>Identifier</label>
                <input type="text" id="username" placeholder="Username" autocomplete="username" required />
            </div>
            <div class="input-group">
                <label>Security Key</label>
                <input type="password" id="password" placeholder="••••••••" autocomplete="current-password" required />
            </div>
            
            <button type="submit" class="glow-btn">Initialize Connection</button>
            <p id="error-msg" class="error-msg"></p>
        </form>
    </div>

    <script nonce={Astro.locals.nonce}>
        import { login } from './auth.js?v=cachebust1';
        // Force HMR check

        const form = document.getElementById('login-form');
        const errorMsg = document.getElementById('error-msg');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const user = document.getElementById('username').value;
            const pass = document.getElementById('password').value;

            const result = await login(user, pass);
            if (result.success) {
                window.location.href = '/admin';
            } else {
                errorMsg.innerText = result.error;
                errorMsg.classList.add('show');
            }
        });
    </script>
</LoginLayout>

<style>
    .login-box {
        width: 100%;
        max-width: 400px;
        padding: 3rem;
        background: rgba(5, 5, 5, 0.9);
        border: 1px solid #1a1a1a;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 0 50px rgba(0, 0, 0, 0.8);
    }

    .logo {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 800;
        font-size: 2rem;
        margin-bottom: 2rem;
        color: #ffc400;
    }
    .dot { color: #00f7ff; }

    h2 { font-size: 1.2rem; color: #fff; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 2px; }
    .subtitle { font-size: 0.8rem; color: #666; margin-bottom: 2rem; }

    .input-group { text-align: left; margin-bottom: 1.5rem; }
    .input-group label { display: block; font-size: 0.7rem; color: #00f7ff; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 1px; }
    .input-group input {
        width: 100%;
        background: #080808;
        border: 1px solid #222;
        padding: 0.8rem 1rem;
        border-radius: 4px;
        color: #fff;
        font-family: 'JetBrains Mono', monospace;
        transition: 0.3s;
    }
    .input-group input:focus { border-color: #00f7ff; outline: none; box-shadow: 0 0 10px rgba(0, 247, 255, 0.2); }

    .glow-btn {
        width: 100%;
        background: transparent;
        border: 1px solid #00f7ff;
        color: #00f7ff;
        padding: 1rem;
        border-radius: 4px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: 0.3s;
        margin-top: 1rem;
    }
    .glow-btn:hover {
        background: #00f7ff;
        color: #000;
        box-shadow: 0 0 20px rgba(0, 247, 255, 0.4);
    }

    .error-msg { font-size: 0.8rem; color: #ff3333; margin-top: 1rem; display: none; }
    .error-msg.show { display: block; }

    .cyber-card {
        position: relative;
        overflow: hidden;
    }
    .cyber-card::after {
        content: '';
        position: absolute;
        top: 0; right: 0; width: 40px; height: 40px;
        background: linear-gradient(45deg, transparent 50%, #ffc400 50%);
    }
</style>
