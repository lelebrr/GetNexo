---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Resultados & ROI" activeTab="broadcasts">
  <div class="space-y-8">
     <h1 class="text-3xl font-bold text-white">Resultados Consolidados</h1>

      <!-- Chart Big -->
      <div class="w-full bg-gray-900 border border-gray-800 rounded-xl p-8 h-96 relative flex items-end justify-between px-10 pb-10">
         <div class="absolute inset-0 flex items-center justify-center opacity-10">
            <span class="text-6xl font-black text-gray-700">CHART AREA</span>
         </div>
          {Array.from({ length: 12 }).map((_, i) => (
            <div class="w-12 bg-purple-600/50 hover:bg-purple-500 rounded-t-lg transition-all" style={`height: ${Math.random() * 80 + 20}%`}></div>
          ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
         <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl">
            <h3 class="text-lg font-bold text-white mb-4">Canais Mais Rentáveis</h3>
            <div class="space-y-4">
               <div>
                  <div class="flex justify-between text-sm mb-1 text-gray-400"><span>WhatsApp</span> <span>R$ 45.200</span></div>
                  <div class="h-2 bg-gray-800 rounded-full"><div class="h-full bg-green-500 w-[85%] rounded-full"></div></div>
               </div>
               <div>
                  <div class="flex justify-between text-sm mb-1 text-gray-400"><span>Email</span> <span>R$ 12.800</span></div>
                  <div class="h-2 bg-gray-800 rounded-full"><div class="h-full bg-blue-500 w-[35%] rounded-full"></div></div>
               </div>
               <div>
                  <div class="flex justify-between text-sm mb-1 text-gray-400"><span>Instagram</span> <span>R$ 8.400</span></div>
                  <div class="h-2 bg-gray-800 rounded-full"><div class="h-full bg-pink-500 w-[20%] rounded-full"></div></div>
               </div>
            </div>
         </div>

         <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl">
             <h3 class="text-lg font-bold text-white mb-4">Custo por Aquisição (CPA)</h3>
             <div class="flex items-center justify-center h-full pb-10">
                <div class="text-center">
                   <p class="text-5xl font-black text-white">R$ 4,50</p>
                   <p class="text-emerald-400 text-sm mt-2 font-bold">-15% comparado ao mês anterior</p>
                </div>
             </div>
         </div>
      </div>
  </div>
</AdminLayout>
