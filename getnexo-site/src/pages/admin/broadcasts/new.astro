---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Criar Nova Campanha" activeTab="broadcasts">
  <div class="space-y-8">
     <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-white mb-2">Nova Campanha</h1>
        <p class="text-gray-400 mb-8">Configure e dispare mensagens em massa</p>

        <!-- Stepper -->
        <div class="flex items-center justify-between mb-10 relative">
           <div class="absolute left-0 top-1/2 w-full h-1 bg-gray-800 -z-10"></div>
           
           <div class="flex flex-col items-center">
              <div class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center text-white font-bold mb-2 ring-4 ring-gray-900 z-10">1</div>
              <span class="text-xs font-semibold text-purple-400">Canal e Nome</span>
           </div>
           
           <div class="flex flex-col items-center">
              <div class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center text-gray-500 font-bold mb-2 ring-4 ring-gray-900 border-2 border-gray-700 z-10">2</div>
              <span class="text-xs text-gray-500">Público Alvo</span>
           </div>

           <div class="flex flex-col items-center">
              <div class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center text-gray-500 font-bold mb-2 ring-4 ring-gray-900 border-2 border-gray-700 z-10">3</div>
              <span class="text-xs text-gray-500">Mensagem</span>
           </div>

            <div class="flex flex-col items-center">
              <div class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center text-gray-500 font-bold mb-2 ring-4 ring-gray-900 border-2 border-gray-700 z-10">4</div>
              <span class="text-xs text-gray-500">Revisão</span>
           </div>
        </div>

        <!-- Form Content (Step 1) -->
        <div class="bg-gray-900/50 border border-gray-800 p-8 rounded-xl">
           <div class="space-y-6">
              
              <div>
                 <label class="block text-sm font-medium text-gray-300 mb-2">Nome da Campanha</label>
                 <input type="text" class="w-full bg-gray-950 border border-gray-700 rounded-lg p-3 text-white focus:border-purple-500 outline-none" placeholder="Ex: Promoção Dia das Mães 2026">
              </div>

              <div>
                 <label class="block text-sm font-medium text-gray-300 mb-2">Canal de Envio</label>
                 <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <label class="border border-purple-500 bg-purple-500/10 p-4 rounded-xl cursor-pointer flex items-center justify-center space-x-2 transition-all">
                       <input type="radio" name="channel" checked class="hidden">
                       <span class="text-2xl">🟢</span>
                       <span class="font-bold text-white">WhatsApp</span>
                    </label>
                     <label class="border border-gray-700 bg-gray-800/50 p-4 rounded-xl cursor-pointer flex items-center justify-center space-x-2 hover:border-gray-500 transition-all">
                       <input type="radio" name="channel" class="hidden">
                       <span class="text-2xl">📧</span>
                       <span class="font-bold text-gray-300">Email Marketing</span>
                    </label>
                     <label class="border border-gray-700 bg-gray-800/50 p-4 rounded-xl cursor-pointer flex items-center justify-center space-x-2 hover:border-gray-500 transition-all">
                       <input type="radio" name="channel" class="hidden">
                       <span class="text-2xl">📸</span>
                       <span class="font-bold text-gray-300">Instagram DM</span>
                    </label>
                 </div>
              </div>

           </div>

           <div class="mt-8 flex justify-end">
              <button class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-8 rounded-lg transition-colors">
                 Próximo Passo &rarr;
              </button>
           </div>
        </div>

     </div>
  </div>
</AdminLayout>
