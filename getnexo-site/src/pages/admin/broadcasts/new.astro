---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Criar Nova Campanha" activeTab="broadcasts">
  <div class="space-y-8" x-data="campaignWizard()">
     <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-white mb-2">Nova Campanha</h1>
        <p class="text-gray-400 mb-8">Configure e dispare mensagens em massa</p>

        <!-- Stepper -->
        <div class="flex items-center justify-between mb-10 relative">
           <div class="absolute left-0 top-1/2 w-full h-1 bg-gray-800 -z-10"></div>
           <div class="absolute left-0 top-1/2 h-1 bg-purple-600 -z-10 transition-all duration-500" :style="`width: ${((step - 1) / 3) * 100}%`"></div>
           
           <template x-for="(label, index) in ['Canal e Nome', 'Público Alvo', 'Mensagem', 'Revisão']" :key="index">
             <div class="flex flex-col items-center">
                <div 
                  class="w-10 h-10 rounded-full flex items-center justify-center font-bold mb-2 ring-4 ring-gray-900 z-10 transition-all duration-300"
                  :class="step > index + 1 ? 'bg-emerald-500 text-white' : step === index + 1 ? 'bg-purple-600 text-white' : 'bg-gray-800 text-gray-500 border-2 border-gray-700'"
                  x-text="step > index + 1 ? '✓' : index + 1"
                ></div>
                <span 
                  class="text-xs font-semibold transition-colors"
                  :class="step >= index + 1 ? 'text-purple-400' : 'text-gray-500'"
                  x-text="label"
                ></span>
             </div>
           </template>
        </div>

        <!-- Form Content -->
        <div class="bg-gray-900/50 border border-gray-800 p-8 rounded-xl">
           
           <!-- Step 1: Canal e Nome -->
           <div x-show="step === 1" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
              <div class="space-y-6">
                 <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Nome da Campanha *</label>
                    <input type="text" x-model="form.name" class="w-full bg-gray-950 border border-gray-700 rounded-lg p-3 text-white focus:border-purple-500 outline-none" placeholder="Ex: Promoção Dia das Mães 2026">
                    <p x-show="errors.name" class="text-red-400 text-xs mt-1" x-text="errors.name"></p>
                 </div>

                 <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Canal de Envio</label>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                       <label @click="form.channel = 'whatsapp'" :class="form.channel === 'whatsapp' ? 'border-purple-500 bg-purple-500/10' : 'border-gray-700 bg-gray-800/50 hover:border-gray-500'" class="border p-4 rounded-xl cursor-pointer flex items-center justify-center space-x-2 transition-all">
                          <span class="text-2xl">🟢</span>
                          <span class="font-bold" :class="form.channel === 'whatsapp' ? 'text-white' : 'text-gray-300'">WhatsApp</span>
                       </label>
                       <label @click="form.channel = 'email'" :class="form.channel === 'email' ? 'border-purple-500 bg-purple-500/10' : 'border-gray-700 bg-gray-800/50 hover:border-gray-500'" class="border p-4 rounded-xl cursor-pointer flex items-center justify-center space-x-2 transition-all">
                          <span class="text-2xl">📧</span>
                          <span class="font-bold" :class="form.channel === 'email' ? 'text-white' : 'text-gray-300'">Email Marketing</span>
                       </label>
                       <label @click="form.channel = 'instagram'" :class="form.channel === 'instagram' ? 'border-purple-500 bg-purple-500/10' : 'border-gray-700 bg-gray-800/50 hover:border-gray-500'" class="border p-4 rounded-xl cursor-pointer flex items-center justify-center space-x-2 transition-all">
                          <span class="text-2xl">📸</span>
                          <span class="font-bold" :class="form.channel === 'instagram' ? 'text-white' : 'text-gray-300'">Instagram DM</span>
                       </label>
                    </div>
                 </div>
              </div>
           </div>

           <!-- Step 2: Público Alvo -->
           <div x-show="step === 2" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
              <div class="space-y-6">
                 <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Segmento de Clientes</label>
                    <select x-model="form.segment" class="w-full bg-gray-950 border border-gray-700 rounded-lg p-3 text-white focus:border-purple-500 outline-none">
                       <option value="all">Todos os Clientes</option>
                       <option value="vip">Clientes VIP</option>
                       <option value="new">Novos Clientes (últimos 30 dias)</option>
                       <option value="inactive">Clientes Inativos (+90 dias)</option>
                       <option value="cart_abandoned">Carrinho Abandonado</option>
                    </select>
                 </div>

                 <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Filtrar por Tags</label>
                    <div class="flex flex-wrap gap-2">
                       <template x-for="tag in availableTags" :key="tag">
                         <button type="button" 
                           @click="toggleTag(tag)"
                           :class="form.tags.includes(tag) ? 'bg-purple-600 text-white' : 'bg-gray-800 text-gray-400 hover:bg-gray-700'"
                           class="px-3 py-1 rounded-full text-sm transition-all"
                           x-text="tag"
                         ></button>
                       </template>
                    </div>
                 </div>

                 <div class="bg-gray-800/50 p-4 rounded-lg border border-gray-700">
                    <div class="flex items-center justify-between">
                       <span class="text-gray-400">Destinatários estimados:</span>
                       <span class="text-2xl font-bold text-white" x-text="estimatedRecipients.toLocaleString()"></span>
                    </div>
                 </div>
              </div>
           </div>

           <!-- Step 3: Mensagem -->
           <div x-show="step === 3" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
              <div class="space-y-6">
                 <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Mensagem *</label>
                    <textarea x-model="form.message" rows="6" class="w-full bg-gray-950 border border-gray-700 rounded-lg p-3 text-white focus:border-purple-500 outline-none resize-none" placeholder="Digite sua mensagem aqui...

Use {{nome}} para personalizar com o nome do cliente."></textarea>
                    <p x-show="errors.message" class="text-red-400 text-xs mt-1" x-text="errors.message"></p>
                    <p class="text-gray-500 text-xs mt-1"><span x-text="form.message.length"></span>/1000 caracteres</p>
                 </div>

                 <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Imagem/Mídia (opcional)</label>
                    <div class="border-2 border-dashed border-gray-700 rounded-lg p-8 text-center hover:border-purple-500 transition-colors cursor-pointer">
                       <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-600 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                       </svg>
                       <p class="text-gray-500 text-sm">Clique para fazer upload ou arraste uma imagem</p>
                    </div>
                 </div>

                 <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Agendamento</label>
                    <div class="grid grid-cols-2 gap-4">
                       <label @click="form.schedule = 'now'" :class="form.schedule === 'now' ? 'border-purple-500 bg-purple-500/10' : 'border-gray-700 bg-gray-800/50'" class="border p-4 rounded-lg cursor-pointer flex items-center space-x-3 transition-all">
                          <span class="text-xl">⚡</span>
                          <span class="font-medium text-white">Enviar Agora</span>
                       </label>
                       <label @click="form.schedule = 'scheduled'" :class="form.schedule === 'scheduled' ? 'border-purple-500 bg-purple-500/10' : 'border-gray-700 bg-gray-800/50'" class="border p-4 rounded-lg cursor-pointer flex items-center space-x-3 transition-all">
                          <span class="text-xl">📅</span>
                          <span class="font-medium text-white">Agendar</span>
                       </label>
                    </div>
                    <div x-show="form.schedule === 'scheduled'" class="mt-4">
                       <input type="datetime-local" x-model="form.scheduledDate" class="w-full bg-gray-950 border border-gray-700 rounded-lg p-3 text-white focus:border-purple-500 outline-none">
                    </div>
                 </div>
              </div>
           </div>

           <!-- Step 4: Revisão -->
           <div x-show="step === 4" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-x-4" x-transition:enter-end="opacity-100 translate-x-0">
              <div class="space-y-6">
                 <h3 class="text-lg font-bold text-white mb-4">Revise sua Campanha</h3>
                 
                 <div class="grid grid-cols-2 gap-4">
                    <div class="bg-gray-800/50 p-4 rounded-lg">
                       <p class="text-xs text-gray-500 uppercase mb-1">Nome</p>
                       <p class="text-white font-medium" x-text="form.name || '-'"></p>
                    </div>
                    <div class="bg-gray-800/50 p-4 rounded-lg">
                       <p class="text-xs text-gray-500 uppercase mb-1">Canal</p>
                       <p class="text-white font-medium capitalize" x-text="form.channel"></p>
                    </div>
                    <div class="bg-gray-800/50 p-4 rounded-lg">
                       <p class="text-xs text-gray-500 uppercase mb-1">Segmento</p>
                       <p class="text-white font-medium" x-text="getSegmentLabel(form.segment)"></p>
                    </div>
                    <div class="bg-gray-800/50 p-4 rounded-lg">
                       <p class="text-xs text-gray-500 uppercase mb-1">Destinatários</p>
                       <p class="text-white font-medium" x-text="estimatedRecipients.toLocaleString()"></p>
                    </div>
                 </div>

                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-2">Mensagem</p>
                    <p class="text-white whitespace-pre-wrap" x-text="form.message || '-'"></p>
                 </div>

                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">Envio</p>
                    <p class="text-white font-medium" x-text="form.schedule === 'now' ? 'Imediato' : 'Agendado para ' + formatDate(form.scheduledDate)"></p>
                 </div>

                 <div class="bg-amber-500/10 border border-amber-500/30 p-4 rounded-lg flex items-start space-x-3">
                    <span class="text-xl">⚠️</span>
                    <div>
                       <p class="text-amber-400 font-medium">Atenção</p>
                       <p class="text-amber-300/70 text-sm">Esta ação enviará mensagens para <strong x-text="estimatedRecipients.toLocaleString()"></strong> pessoas. Esta ação não pode ser desfeita.</p>
                    </div>
                 </div>
              </div>
           </div>

           <!-- Navigation Buttons -->
           <div class="mt-8 flex justify-between">
              <button 
                x-show="step > 1" 
                @click="prevStep()" 
                class="bg-gray-800 hover:bg-gray-700 text-white font-bold py-3 px-8 rounded-lg transition-colors flex items-center space-x-2"
              >
                 <span>&larr;</span>
                 <span>Voltar</span>
              </button>
              <div x-show="step === 1"></div>

              <button 
                x-show="step < 4" 
                @click="nextStep()" 
                :disabled="!canProceed()"
                :class="canProceed() ? 'bg-purple-600 hover:bg-purple-700' : 'bg-gray-700 cursor-not-allowed'"
                class="text-white font-bold py-3 px-8 rounded-lg transition-colors flex items-center space-x-2"
              >
                 <span>Próximo Passo</span>
                 <span>&rarr;</span>
              </button>

              <button 
                x-show="step === 4" 
                @click="submitCampaign()" 
                :disabled="submitting"
                class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-8 rounded-lg transition-colors flex items-center space-x-2 disabled:opacity-50"
              >
                 <span x-text="submitting ? 'Enviando...' : '🚀 Iniciar Campanha'"></span>
              </button>
           </div>
        </div>

     </div>
  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function campaignWizard() {
    return {
      step: 1,
      submitting: false,
      form: {
        name: '',
        channel: 'whatsapp',
        segment: 'all',
        tags: [],
        message: '',
        schedule: 'now',
        scheduledDate: ''
      },
      errors: {},
      availableTags: ['VIP', 'Promoção', 'B2B', 'Fiel', 'Novo', 'Checkout', 'Abandono'],
      
      get estimatedRecipients() {
        const baseCount = {
          all: 15420,
          vip: 1250,
          new: 3200,
          inactive: 4100,
          cart_abandoned: 890
        };
        let count = baseCount[this.form.segment] || 15420;
        // Reduce by 10% for each tag filter
        count = Math.round(count * Math.pow(0.9, this.form.tags.length));
        return count;
      },

      toggleTag(tag) {
        const index = this.form.tags.indexOf(tag);
        if (index === -1) {
          this.form.tags.push(tag);
        } else {
          this.form.tags.splice(index, 1);
        }
      },

      canProceed() {
        if (this.step === 1) {
          return this.form.name.trim().length >= 3;
        }
        if (this.step === 3) {
          return this.form.message.trim().length >= 10;
        }
        return true;
      },

      validateStep() {
        this.errors = {};
        
        if (this.step === 1) {
          if (!this.form.name.trim()) {
            this.errors.name = 'O nome da campanha é obrigatório';
            return false;
          }
          if (this.form.name.trim().length < 3) {
            this.errors.name = 'O nome deve ter pelo menos 3 caracteres';
            return false;
          }
        }

        if (this.step === 3) {
          if (!this.form.message.trim()) {
            this.errors.message = 'A mensagem é obrigatória';
            return false;
          }
          if (this.form.message.trim().length < 10) {
            this.errors.message = 'A mensagem deve ter pelo menos 10 caracteres';
            return false;
          }
        }

        return true;
      },

      nextStep() {
        if (this.validateStep()) {
          this.step++;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      },

      prevStep() {
        if (this.step > 1) {
          this.step--;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      },

      getSegmentLabel(segment) {
        const labels = {
          all: 'Todos os Clientes',
          vip: 'Clientes VIP',
          new: 'Novos Clientes (últimos 30 dias)',
          inactive: 'Clientes Inativos (+90 dias)',
          cart_abandoned: 'Carrinho Abandonado'
        };
        return labels[segment] || segment;
      },

      formatDate(dateStr) {
        if (!dateStr) return '-';
        const date = new Date(dateStr);
        return date.toLocaleDateString('pt-BR', { 
          day: '2-digit', 
          month: '2-digit', 
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      },

      async submitCampaign() {
        this.submitting = true;
        
        try {
          const payload = {
            name: this.form.name,
            channel: this.form.channel,
            segment: this.form.segment,
            tags: this.form.tags,
            message: this.form.message,
            schedule: this.form.schedule,
            scheduled_at: this.form.schedule === 'scheduled' ? this.form.scheduledDate : null,
            estimated_recipients: this.estimatedRecipients
          };

          const res = await fetch('/api/campaigns', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            alert('🚀 Campanha criada com sucesso!');
            window.location.href = '/admin/broadcasts/active';
          } else {
            const error = await res.json();
            alert('Erro: ' + (error.error || 'Falha ao criar campanha'));
          }
        } catch (e) {
          console.error('Erro ao criar campanha:', e);
          alert('Erro de conexão com o servidor');
        } finally {
          this.submitting = false;
        }
      }
    };
  }
</script>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
