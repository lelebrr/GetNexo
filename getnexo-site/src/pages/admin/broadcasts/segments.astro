---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Segmentação por Tags" activeTab="broadcasts">
  <div class="flex flex-col md:flex-row h-[80vh] gap-6">
    
    <!-- Sidebar Tags -->
    <div class="w-full md:w-1/3 bg-gray-900/50 border border-gray-800 rounded-xl p-6 overflow-y-auto">
      <h2 class="text-xl font-bold text-white mb-4">Minhas Tags</h2>
      <div class="space-y-2">
        <label class="flex items-center space-x-3 p-3 bg-gray-800/50 rounded-lg cursor-pointer hover:bg-gray-800 transition-colors">
          <input type="checkbox" class="form-checkbox text-purple-600 rounded bg-gray-700 border-gray-600" checked>
          <span class="text-gray-200">💎 Clientes VIP</span>
          <span class="ml-auto text-xs text-gray-500">1.2k</span>
        </label>
         <label class="flex items-center space-x-3 p-3 bg-gray-800/50 rounded-lg cursor-pointer hover:bg-gray-800 transition-colors">
          <input type="checkbox" class="form-checkbox text-purple-600 rounded bg-gray-700 border-gray-600">
          <span class="text-gray-200">🛒 Carrinho Abandonado</span>
          <span class="ml-auto text-xs text-gray-500">450</span>
        </label>
        <label class="flex items-center space-x-3 p-3 bg-gray-800/50 rounded-lg cursor-pointer hover:bg-gray-800 transition-colors">
          <input type="checkbox" class="form-checkbox text-purple-600 rounded bg-gray-700 border-gray-600">
          <span class="text-gray-200">📅 Comprou há 30 dias</span>
          <span class="ml-auto text-xs text-gray-500">3.8k</span>
        </label>
         <label class="flex items-center space-x-3 p-3 bg-gray-800/50 rounded-lg cursor-pointer hover:bg-gray-800 transition-colors">
          <input type="checkbox" class="form-checkbox text-purple-600 rounded bg-gray-700 border-gray-600">
          <span class="text-gray-200">📱 Leads Instagram</span>
          <span class="ml-auto text-xs text-gray-500">12k</span>
        </label>
      </div>
      <button class="mt-4 text-purple-400 text-sm hover:underline">+ Criar Nova Tag</button>
    </div>

    <!-- Preview Lista -->
    <div class="flex-1 bg-gray-900/50 border border-gray-800 rounded-xl p-6 flex flex-col">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h2 class="text-xl font-bold text-white">Preview de Segmento</h2>
          <p class="text-gray-400">Total estimado: <span class="text-emerald-400 font-bold">1.245 leads</span></p>
        </div>
        <button class="bg-white text-black font-bold px-6 py-2 rounded-lg hover:bg-gray-200 transition-colors">
          Criar Campanha para Este Grupo
        </button>
      </div>

      <div class="flex-1 overflow-hidden bg-gray-950 rounded-lg border border-gray-800 relative">
         <div class="absolute inset-0 flex items-center justify-center text-gray-600">
            <div class="text-center">
               <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
               <p>Lista de contatos será carregada aqui...</p>
            </div>
         </div>
      </div>
    </div>

  </div>
</AdminLayout>
