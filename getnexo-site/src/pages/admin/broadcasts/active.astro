---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Campanhas em Andamento" activeTab="broadcasts">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-pink-500 to-rose-500 rounded-2xl flex items-center justify-center shadow-lg shadow-pink-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Campanhas em Andamento
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Gerencie campanhas ativas e monitore seu desempenho.
    </p>
  </div>
</AdminLayout>
