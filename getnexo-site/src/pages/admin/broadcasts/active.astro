---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Campanhas em Andamento" activeTab="broadcasts">
  <div class="space-y-8" x-data="activeCampaigns()">
     <div class="flex items-center justify-between">
        <div>
           <h1 class="text-3xl font-bold text-white">Campanhas Ativas</h1>
           <p class="text-gray-400 mt-1">Monitore e gerencie suas campanhas em tempo real</p>
        </div>
        <a href="/admin/broadcasts/new" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2.5 px-6 rounded-lg transition-colors flex items-center space-x-2">
           <span>+</span>
           <span>Nova Campanha</span>
        </a>
     </div>

     <!-- Loading State -->
     <div x-show="loading" class="flex items-center justify-center py-20">
        <div class="w-10 h-10 border-4 border-purple-500 border-t-transparent rounded-full animate-spin"></div>
     </div>

     <!-- Empty State -->
     <div x-show="!loading && campaigns.length === 0" class="text-center py-20">
        <div class="text-6xl mb-4">📭</div>
        <h3 class="text-xl font-bold text-white mb-2">Nenhuma campanha ativa</h3>
        <p class="text-gray-400 mb-6">Crie sua primeira campanha para começar a enviar mensagens em massa.</p>
        <a href="/admin/broadcasts/new" class="inline-block bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-8 rounded-lg transition-colors">
           Criar Campanha
        </a>
     </div>

     <!-- Campaigns List -->
     <div x-show="!loading && campaigns.length > 0" class="grid grid-cols-1 gap-6">
        <template x-for="campaign in campaigns" :key="campaign.id">
           <div :class="campaign.status === 'paused' ? 'opacity-80' : ''" class="bg-gray-900/50 border p-6 rounded-xl relative overflow-hidden transition-all"
                :class="campaign.status === 'sending' ? 'border-purple-500/30' : 'border-gray-800'">
              
              <!-- Status Badge -->
              <div class="absolute top-0 right-0 p-2">
                 <span x-show="campaign.status === 'sending'" class="flex items-center space-x-2 bg-green-500/10 text-green-400 px-3 py-1 rounded-full text-xs font-bold border border-green-500/20">
                    <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                    <span>Enviando Agora</span>
                 </span>
                 <span x-show="campaign.status === 'paused'" class="flex items-center space-x-2 bg-yellow-500/10 text-yellow-400 px-3 py-1 rounded-full text-xs font-bold border border-yellow-500/20">
                    <span class="text-lg">⏸️</span>
                    <span>Pausada</span>
                 </span>
                 <span x-show="campaign.status === 'scheduled'" class="flex items-center space-x-2 bg-blue-500/10 text-blue-400 px-3 py-1 rounded-full text-xs font-bold border border-blue-500/20">
                    <span class="text-lg">📅</span>
                    <span>Agendada</span>
                 </span>
              </div>

              <!-- Campaign Info -->
              <div class="flex items-start space-x-4 mb-6">
                 <div class="p-3 bg-gray-800 rounded-lg text-3xl" x-text="getChannelEmoji(campaign.channel)">🚀</div>
                 <div>
                    <h2 class="text-xl font-bold text-white" x-text="campaign.name"></h2>
                    <p class="text-gray-400 text-sm">
                       Lista: <span x-text="campaign.segment"></span> • Canal: <span class="capitalize" x-text="campaign.channel"></span>
                    </p>
                 </div>
              </div>

              <!-- Progress Bar -->
              <div class="space-y-2 mb-6">
                 <div class="flex justify-between text-sm text-gray-300">
                    <span>Progresso</span>
                    <span x-text="`${campaign.progress}% (${campaign.sent.toLocaleString()}/${campaign.total.toLocaleString()})`"></span>
                 </div>
                 <div class="w-full h-3 bg-gray-800 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-purple-500 to-pink-500 relative overflow-hidden transition-all duration-500"
                         :style="`width: ${campaign.progress}%`">
                       <div x-show="campaign.status === 'sending'" class="absolute inset-0 bg-white/20 animate-[shimmer_2s_infinite]"></div>
                    </div>
                 </div>
              </div>

              <!-- Stats -->
              <div class="grid grid-cols-3 gap-4 border-t border-gray-800 pt-4">
                 <div class="text-center">
                    <p class="text-xs text-gray-500">Entregues</p>
                    <p class="font-bold text-white" x-text="campaign.delivered.toLocaleString()"></p>
                 </div>
                 <div class="text-center">
                    <p class="text-xs text-gray-500">Lidos</p>
                    <p class="font-bold text-emerald-400" x-text="`${campaign.read.toLocaleString()} (${Math.round(campaign.read / campaign.delivered * 100) || 0}%)`"></p>
                 </div>
                 <div class="text-center">
                    <p class="text-xs text-gray-500">Respostas</p>
                    <p class="font-bold text-cyan-400" x-text="campaign.replies"></p>
                 </div>
              </div>
              
              <!-- Action Buttons -->
              <div class="mt-6 flex space-x-3">
                 <!-- Sending Campaign Actions -->
                 <template x-if="campaign.status === 'sending'">
                    <button @click="pauseCampaign(campaign.id)" 
                            :disabled="actionLoading === campaign.id"
                            class="flex-1 bg-gray-800 hover:bg-gray-700 text-white py-2 rounded-lg text-sm transition-colors flex items-center justify-center space-x-2 disabled:opacity-50">
                       <span x-show="actionLoading !== campaign.id">⏸️</span>
                       <span x-text="actionLoading === campaign.id ? 'Pausando...' : 'Pausar'"></span>
                    </button>
                 </template>
                 <template x-if="campaign.status === 'sending'">
                    <button @click="viewDetails(campaign.id)" class="flex-1 bg-gray-800 hover:bg-gray-700 text-white py-2 rounded-lg text-sm transition-colors">
                       Ver Detalhes
                    </button>
                 </template>
                 
                 <!-- Paused Campaign Actions -->
                 <template x-if="campaign.status === 'paused'">
                    <button @click="resumeCampaign(campaign.id)" 
                            :disabled="actionLoading === campaign.id"
                            class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg text-sm transition-colors disabled:opacity-50">
                       <span x-text="actionLoading === campaign.id ? 'Retomando...' : '▶️ Retomar'"></span>
                    </button>
                 </template>
                 <template x-if="campaign.status === 'paused'">
                    <button @click="cancelCampaign(campaign.id)" 
                            :disabled="actionLoading === campaign.id"
                            class="flex-1 bg-red-600/20 hover:bg-red-600/40 text-red-400 py-2 rounded-lg text-sm transition-colors disabled:opacity-50">
                       <span x-text="actionLoading === campaign.id ? 'Cancelando...' : '✕ Cancelar'"></span>
                    </button>
                 </template>

                 <!-- Scheduled Campaign Actions -->
                 <template x-if="campaign.status === 'scheduled'">
                    <button @click="sendNow(campaign.id)" 
                            :disabled="actionLoading === campaign.id"
                            class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-2 rounded-lg text-sm transition-colors disabled:opacity-50">
                       <span x-text="actionLoading === campaign.id ? 'Iniciando...' : '🚀 Enviar Agora'"></span>
                    </button>
                 </template>
                 <template x-if="campaign.status === 'scheduled'">
                    <button @click="cancelCampaign(campaign.id)" 
                            :disabled="actionLoading === campaign.id"
                            class="flex-1 bg-red-600/20 hover:bg-red-600/40 text-red-400 py-2 rounded-lg text-sm transition-colors disabled:opacity-50">
                       <span>✕ Cancelar</span>
                    </button>
                 </template>
              </div>
           </div>
        </template>
     </div>

     <!-- Details Modal -->
     <div x-show="detailsModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4" @keydown.escape.window="detailsModal = false">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @click="detailsModal = false"></div>
        <div class="relative w-full max-w-2xl bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl overflow-hidden" @click.stop>
           <div class="bg-gradient-to-r from-purple-600/20 to-cyan-600/20 p-6 border-b border-gray-800">
              <div class="flex items-center justify-between">
                 <h2 class="text-xl font-bold text-white" x-text="selectedCampaign?.name"></h2>
                 <button @click="detailsModal = false" class="p-2 text-gray-500 hover:text-white hover:bg-gray-800 rounded-lg transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                 </button>
              </div>
           </div>
           <div class="p-6 space-y-6 max-h-[70vh] overflow-y-auto">
              <div class="grid grid-cols-2 gap-4">
                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">Canal</p>
                    <p class="text-white font-medium capitalize" x-text="selectedCampaign?.channel"></p>
                 </div>
                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">Segmento</p>
                    <p class="text-white font-medium" x-text="selectedCampaign?.segment"></p>
                 </div>
                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">Total Destinatários</p>
                    <p class="text-white font-medium" x-text="selectedCampaign?.total.toLocaleString()"></p>
                 </div>
                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">Taxa de Abertura</p>
                    <p class="text-emerald-400 font-medium" x-text="selectedCampaign ? Math.round(selectedCampaign.read / selectedCampaign.delivered * 100) + '%' : '-'"></p>
                 </div>
              </div>
              <div class="bg-gray-800/50 p-4 rounded-lg">
                 <p class="text-xs text-gray-500 uppercase mb-2">Mensagem</p>
                 <p class="text-white whitespace-pre-wrap" x-text="selectedCampaign?.message || 'Mensagem não disponível'"></p>
              </div>
           </div>
           <div class="p-6 border-t border-gray-800 flex justify-end">
              <button @click="detailsModal = false" class="px-6 py-2.5 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-xl transition-all">
                 Fechar
              </button>
           </div>
        </div>
     </div>

     <!-- Confirm Modal -->
     <div x-show="confirmModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4" @keydown.escape.window="confirmModal = false">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @click="confirmModal = false"></div>
        <div class="relative w-full max-w-md bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl p-6" @click.stop>
           <h3 class="text-lg font-bold text-white mb-2" x-text="confirmTitle"></h3>
           <p class="text-gray-400 mb-6" x-text="confirmMessage"></p>
           <div class="flex space-x-3">
              <button @click="confirmModal = false" class="flex-1 py-2.5 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-xl transition-all">
                 Cancelar
              </button>
              <button @click="confirmAction()" :class="confirmDanger ? 'bg-red-600 hover:bg-red-700' : 'bg-purple-600 hover:bg-purple-700'" class="flex-1 py-2.5 text-white font-medium rounded-xl transition-all">
                 Confirmar
              </button>
           </div>
        </div>
     </div>
  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function activeCampaigns() {
    return {
      campaigns: [],
      loading: true,
      actionLoading: null,
      detailsModal: false,
      confirmModal: false,
      confirmTitle: '',
      confirmMessage: '',
      confirmDanger: false,
      confirmCallback: null,
      selectedCampaign: null,

      async init() {
        await this.fetchCampaigns();
        // Auto-refresh every 10 seconds
        setInterval(() => this.fetchCampaigns(), 10000);
      },

      async fetchCampaigns() {
        try {
          const res = await fetch('/api/campaigns?status=active,paused,scheduled');
          if (res.ok) {
            const data = await res.json();
            this.campaigns = data.campaigns || [];
          } else {
            // Use mock data if API fails
            this.campaigns = this.getMockCampaigns();
          }
        } catch (e) {
          console.error('Erro ao carregar campanhas:', e);
          this.campaigns = this.getMockCampaigns();
        } finally {
          this.loading = false;
        }
      },

      getMockCampaigns() {
        return [
          {
            id: 1,
            name: 'Lançamento Cyber Monday',
            channel: 'whatsapp',
            segment: 'Clientes VIP',
            status: 'sending',
            progress: 45,
            sent: 1500,
            total: 3300,
            delivered: 1480,
            read: 980,
            replies: 42,
            message: 'Olá {{nome}}! 🎉\n\nExclusivo para você: 50% OFF em toda a loja!\n\nAproveite agora: https://loja.com/cyber'
          },
          {
            id: 2,
            name: 'Newsletter Semanal #42',
            channel: 'email',
            segment: 'Geral',
            status: 'paused',
            progress: 12,
            sent: 12000,
            total: 100000,
            delivered: 11800,
            read: 3200,
            replies: 15,
            message: 'Confira as novidades da semana!'
          },
          {
            id: 3,
            name: 'Promoção Dia das Mães',
            channel: 'whatsapp',
            segment: 'Compradores Frequentes',
            status: 'scheduled',
            progress: 0,
            sent: 0,
            total: 5000,
            delivered: 0,
            read: 0,
            replies: 0,
            message: '💐 Surpreenda sua mãe com presentes especiais!'
          }
        ];
      },

      getChannelEmoji(channel) {
        const emojis = { whatsapp: '🟢', email: '📧', instagram: '📸', telegram: '📱' };
        return emojis[channel] || '🚀';
      },

      viewDetails(id) {
        this.selectedCampaign = this.campaigns.find(c => c.id === id);
        this.detailsModal = true;
      },

      showConfirm(title, message, callback, danger = false) {
        this.confirmTitle = title;
        this.confirmMessage = message;
        this.confirmCallback = callback;
        this.confirmDanger = danger;
        this.confirmModal = true;
      },

      async confirmAction() {
        this.confirmModal = false;
        if (this.confirmCallback) {
          await this.confirmCallback();
        }
      },

      async pauseCampaign(id) {
        this.showConfirm(
          'Pausar Campanha',
          'Tem certeza que deseja pausar esta campanha? Você poderá retomá-la depois.',
          async () => {
            this.actionLoading = id;
            try {
              const res = await fetch(`/api/campaigns/${id}/pause`, { method: 'POST' });
              if (res.ok) {
                const campaign = this.campaigns.find(c => c.id === id);
                if (campaign) campaign.status = 'paused';
              } else {
                // Mock: Update locally
                const campaign = this.campaigns.find(c => c.id === id);
                if (campaign) campaign.status = 'paused';
              }
            } catch (e) {
              const campaign = this.campaigns.find(c => c.id === id);
              if (campaign) campaign.status = 'paused';
            } finally {
              this.actionLoading = null;
            }
          }
        );
      },

      async resumeCampaign(id) {
        this.actionLoading = id;
        try {
          const res = await fetch(`/api/campaigns/${id}/resume`, { method: 'POST' });
          if (res.ok) {
            const campaign = this.campaigns.find(c => c.id === id);
            if (campaign) campaign.status = 'sending';
          } else {
            const campaign = this.campaigns.find(c => c.id === id);
            if (campaign) campaign.status = 'sending';
          }
        } catch (e) {
          const campaign = this.campaigns.find(c => c.id === id);
          if (campaign) campaign.status = 'sending';
        } finally {
          this.actionLoading = null;
        }
      },

      async cancelCampaign(id) {
        this.showConfirm(
          'Cancelar Campanha',
          'Tem certeza que deseja cancelar esta campanha? Esta ação não pode ser desfeita.',
          async () => {
            this.actionLoading = id;
            try {
              const res = await fetch(`/api/campaigns/${id}`, { method: 'DELETE' });
              this.campaigns = this.campaigns.filter(c => c.id !== id);
            } catch (e) {
              this.campaigns = this.campaigns.filter(c => c.id !== id);
            } finally {
              this.actionLoading = null;
            }
          },
          true
        );
      },

      async sendNow(id) {
        this.showConfirm(
          'Enviar Agora',
          'Deseja iniciar o envio desta campanha imediatamente?',
          async () => {
            this.actionLoading = id;
            try {
              const res = await fetch(`/api/campaigns/${id}/send`, { method: 'POST' });
              const campaign = this.campaigns.find(c => c.id === id);
              if (campaign) campaign.status = 'sending';
            } catch (e) {
              const campaign = this.campaigns.find(c => c.id === id);
              if (campaign) campaign.status = 'sending';
            } finally {
              this.actionLoading = null;
            }
          }
        );
      }
    };
  }
</script>

<style>
  [x-cloak] { display: none !important; }
  
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
</style>
