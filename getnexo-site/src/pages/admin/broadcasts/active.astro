---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Campanhas em Andamento" activeTab="broadcasts">
  <div class="space-y-8">
     <h1 class="text-3xl font-bold text-white">Campanhas Ativas</h1>
     
     <div class="grid grid-cols-1 gap-6">
        
        <!-- Active Card 1 -->
        <div class="bg-gray-900/50 border border-purple-500/30 p-6 rounded-xl relative overflow-hidden">
           <div class="absolute top-0 right-0 p-2">
              <span class="flex items-center space-x-2 bg-green-500/10 text-green-400 px-3 py-1 rounded-full text-xs font-bold border border-green-500/20">
                 <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                 <span>Enviando Agora</span>
              </span>
           </div>

           <div class="flex items-start space-x-4 mb-6">
              <div class="p-3 bg-gray-800 rounded-lg text-3xl">🚀</div>
              <div>
                 <h2 class="text-xl font-bold text-white">Lançamento Cyber Monday</h2>
                 <p class="text-gray-400 text-sm">Lista: Clientes VIP • Canal: WhatsApp</p>
              </div>
           </div>

           <div class="space-y-2 mb-6">
              <div class="flex justify-between text-sm text-gray-300">
                 <span>Progresso</span>
                 <span>45% (1.500/3.300)</span>
              </div>
              <div class="w-full h-3 bg-gray-800 rounded-full overflow-hidden">
                 <div class="h-full bg-gradient-to-r from-purple-500 to-pink-500 w-[45%] relative overflow-hidden">
                    <div class="absolute inset-0 bg-white/20 animate-[shimmer_2s_infinite]"></div>
                 </div>
              </div>
           </div>

           <div class="grid grid-cols-3 gap-4 border-t border-gray-800 pt-4">
              <div class="text-center">
                 <p class="text-xs text-gray-500">Entregues</p>
                 <p class="font-bold text-white">1.480</p>
              </div>
              <div class="text-center">
                 <p class="text-xs text-gray-500">Lidos</p>
                 <p class="font-bold text-emerald-400">980 (66%)</p>
              </div>
              <div class="text-center">
                 <p class="text-xs text-gray-500">Respostas</p>
                 <p class="font-bold text-cyan-400">42</p>
              </div>
           </div>
           
           <div class="mt-6 flex space-x-3">
              <button class="flex-1 bg-gray-800 hover:bg-gray-700 text-white py-2 rounded-lg text-sm transition-colors">Pausar</button>
              <button class="flex-1 bg-gray-800 hover:bg-gray-700 text-white py-2 rounded-lg text-sm transition-colors">Ver Detalhes</button>
           </div>
        </div>

        <!-- Active Card 2 -->
        <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl relative overflow-hidden opacity-80">
           <div class="absolute top-0 right-0 p-2">
              <span class="flex items-center space-x-2 bg-yellow-500/10 text-yellow-400 px-3 py-1 rounded-full text-xs font-bold border border-yellow-500/20">
                 <span class="text-lg">⏸️</span>
                 <span>Pausada</span>
              </span>
           </div>

           <div class="flex items-start space-x-4 mb-6">
              <div class="p-3 bg-gray-800 rounded-lg text-3xl">📧</div>
              <div>
                 <h2 class="text-xl font-bold text-white">Newsletter Semanal #42</h2>
                 <p class="text-gray-400 text-sm">Lista: Geral • Canal: Email</p>
              </div>
           </div>

           <div class="space-y-2 mb-6">
              <div class="flex justify-between text-sm text-gray-300">
                 <span>Progresso</span>
                 <span>12% (12.000/100.000)</span>
              </div>
              <div class="w-full h-3 bg-gray-800 rounded-full overflow-hidden">
                 <div class="h-full bg-blue-500 w-[12%]"></div>
              </div>
           </div>

            <div class="mt-6 flex space-x-3">
              <button class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg text-sm transition-colors">Retomar</button>
              <button class="flex-1 bg-red-600/20 hover:bg-red-600/40 text-red-400 py-2 rounded-lg text-sm transition-colors">Cancelar</button>
           </div>
        </div>

     </div>
  </div>
</AdminLayout>
