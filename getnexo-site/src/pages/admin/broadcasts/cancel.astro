---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Cancelar Envios" activeTab="broadcasts">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center max-w-2xl mx-auto" x-data="emergencyStop()">
    
    <div class="w-24 h-24 bg-red-600/20 rounded-full flex items-center justify-center mb-8 border border-red-600/50 shadow-lg shadow-red-600/20" :class="hasActive ? 'animate-pulse' : ''">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    </div>

    <h1 class="text-4xl font-bold text-white mb-4">Zona de Perigo</h1>
    <p class="text-gray-400 text-lg mb-8">Esta ação irá <strong class="text-white">interromper imediatamente</strong> todos os disparos de campanhas em andamento. Use apenas em casos de emergência (erro no copy, link quebrado, etc).</p>

    <!-- Loading -->
    <div x-show="loading" class="mb-8">
       <div class="w-10 h-10 border-4 border-red-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
       <p class="text-gray-500 mt-2">Carregando campanhas ativas...</p>
    </div>

    <!-- Active Campaigns -->
    <div x-show="!loading && activeCampaigns.length > 0" class="bg-red-950/30 border border-red-900/50 p-6 rounded-xl w-full mb-8 text-left">
       <h3 class="text-red-400 font-bold mb-2">Campanhas Ativas neste momento:</h3>
       <ul class="space-y-2 text-gray-300">
          <template x-for="campaign in activeCampaigns" :key="campaign.id">
             <li class="flex items-center justify-between">
                <div class="flex items-center">
                   <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"></span>
                   <span x-text="campaign.name"></span>
                   <span class="text-gray-500 ml-2" x-text="'(' + campaign.channel + ')'"></span>
                </div>
                <span class="text-sm text-gray-400" x-text="campaign.progress + '% completo'"></span>
             </li>
          </template>
       </ul>
    </div>

    <!-- No Active Campaigns -->
    <div x-show="!loading && activeCampaigns.length === 0" class="bg-gray-900/30 border border-gray-800 p-6 rounded-xl w-full mb-8">
       <p class="text-gray-400">✅ Nenhuma campanha em andamento no momento.</p>
    </div>

    <!-- Stop Button -->
    <button @click="stopAllCampaigns()" 
            :disabled="!hasActive || stopping" 
            class="w-full bg-red-600 hover:bg-red-700 text-white font-black text-xl py-6 rounded-xl shadow-xl shadow-red-600/30 transition-all active:scale-95 border-2 border-red-500/50 disabled:opacity-50 disabled:cursor-not-allowed disabled:active:scale-100">
       <span x-show="!stopping">PARAR TUDO AGORA 🛑</span>
       <span x-show="stopping">PARANDO... ⏳</span>
    </button>
    
    <!-- Confirmation -->
    <p class="mt-4 text-xs text-gray-600">Esta ação será logada e notificada aos administradores.</p>

    <!-- Success Message -->
    <div x-show="stopped" x-cloak class="mt-6 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-emerald-400">
       <p class="font-bold">✅ Todas as campanhas foram interrompidas com sucesso!</p>
       <p class="text-sm mt-1">As campanhas pausadas podem ser retomadas na página de Campanhas Ativas.</p>
    </div>
  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function emergencyStop() {
    return {
      activeCampaigns: [],
      loading: true,
      stopping: false,
      stopped: false,

      get hasActive() {
        return this.activeCampaigns.length > 0;
      },

      async init() {
        await this.fetchActiveCampaigns();
      },

      async fetchActiveCampaigns() {
        this.loading = true;
        try {
          const res = await fetch('/api/campaigns?status=sending');
          if (res.ok) {
            const data = await res.json();
            this.activeCampaigns = data.campaigns || [];
          } else {
            this.activeCampaigns = this.getMockCampaigns();
          }
        } catch(e) {
          console.error(e);
          this.activeCampaigns = this.getMockCampaigns();
        } finally {
          this.loading = false;
        }
      },

      getMockCampaigns() {
        return [
          { id: 1, name: 'Promoção Relâmpago', channel: 'WhatsApp', progress: 45 },
          { id: 2, name: 'Newsletter Semanal', channel: 'Email', progress: 12 }
        ];
      },

      async stopAllCampaigns() {
        if (!confirm('ATENÇÃO: Esta ação vai pausar TODAS as campanhas ativas. Deseja continuar?')) return;

        this.stopping = true;
        this.stopped = false;

        try {
          const res = await fetch('/api/campaigns/stop-all', { method: 'POST' });
          
          // Mock stop locally regardless of API result
          this.activeCampaigns = [];
          this.stopped = true;
        } catch(e) {
          console.error(e);
          this.activeCampaigns = [];
          this.stopped = true;
        } finally {
          this.stopping = false;
        }
      }
    };
  }
</script>

<style>
  [x-cloak] { display: none !important; }
</style>
