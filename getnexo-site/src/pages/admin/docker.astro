---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gerenciamento Docker">
    <div id="docker-root" class="min-h-screen bg-gray-50">
        <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
            <!-- Loading state -->
            <div id="loading-state" class="flex items-center justify-center min-h-[400px]">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"></div>
                    <p class="mt-4 text-gray-600">Carregando containers...</p>
                </div>
            </div>

            <!-- Main content -->
            <div id="main-content" class="hidden">
                <!-- Content will be rendered here by React -->
            </div>
        </div>
    </div>

    <script>
        import React from 'react';
        import { createRoot } from 'react-dom/client';
        import DockerManagement from '../../components/docker/DockerManagement.jsx';

        const container = document.getElementById('docker-root');
        const loadingState = document.getElementById('loading-state');
        const mainContent = document.getElementById('main-content');

        // Check authentication
        const token = localStorage.getItem('token');
        if (!token) {
            window.location.href = '/admin/login';
        } else {
            // Hide loading and show main content
            loadingState.style.display = 'none';
            mainContent.style.display = 'block';

            // Render React component
            const root = createRoot(mainContent);
            root.render(React.createElement(DockerManagement));
        }
    </script>
</AdminLayout>