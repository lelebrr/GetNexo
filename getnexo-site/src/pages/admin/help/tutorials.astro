---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { PlayCircle, Search, Filter, Clock, Star, Play, ChevronRight, Video, Plus } from 'lucide-react';

const tutorials = [
  { id: 1, title: "Configurando sua primeira automação", time: "4 min", level: "Iniciante", views: "1.2k" },
  { id: 2, title: "Domando o CRM: Tags e Segmentação", time: "12 min", level: "Intermediário", views: "850" },
  { id: 3, title: "Sincronia Total: Shopify + WhatsApp", time: "8 min", level: "Avançado", views: "2.4k" },
];
---

<AdminLayout title="Tutoriais em Vídeo" activeTab="suporte">
  <div class="max-w-6xl mx-auto space-y-10 animate-fade-in py-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-rose-500/10 rounded-2xl flex items-center justify-center text-rose-500 border border-rose-500/20 shadow-xl shadow-rose-500/10">
          <Video className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter italic">Nexo Academy</h1>
          <p class="text-sm text-gray-500 font-medium">Aprenda a dominar todas as ferramentas da plataforma com guias visuai rápidos.</p>
        </div>
      </div>
      <div class="flex items-center space-x-3">
         <span class="px-4 py-2 bg-rose-500/10 border border-rose-500/20 text-rose-500 text-[10px] font-black uppercase rounded-xl tracking-widest">Semanas Nexo: Ao vivo 20h</span>
      </div>
    </div>

    <!-- Search / Filter -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
       <div class="md:col-span-2 relative">
          <Search className="absolute left-6 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" />
          <input type="text" placeholder="Buscar tutorial por tema ou ferramenta..." class="w-full bg-gray-900 border border-gray-800 rounded-2xl py-4 pl-14 pr-4 text-xs text-white focus:border-rose-500 outline-none transition-all placeholder:text-gray-700 font-bold uppercase tracking-widest" />
       </div>
       <button class="bg-gray-800 hover:bg-gray-700 text-white font-black text-[10px] uppercase tracking-widest rounded-2xl flex items-center justify-center space-x-2 transition-all">
          <Filter className="w-4 h-4" />
          <span>Por Nível</span>
       </button>
    </div>

    <!-- Tutorials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
       {tutorials.map(tut => (
          <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden group cursor-pointer hover:border-rose-500/30 transition-all">
             <div class="aspect-video bg-gray-800 relative flex items-center justify-center">
                <div class="w-16 h-16 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white border border-white/20 group-hover:scale-110 group-hover:bg-rose-600 group-hover:border-rose-500 transition-all shadow-2xl">
                   <Play className="w-6 h-6 fill-current ml-1" />
                </div>
                <div class="absolute bottom-4 right-4 px-2 py-1 bg-black/80 backdrop-blur-md rounded-md text-[9px] font-black text-white uppercase tracking-widest">{tut.time}</div>
             </div>
             <div class="p-8 space-y-4">
                <div class="flex items-center justify-between">
                   <span class="text-[8px] font-black text-rose-500 uppercase tracking-widest">{tut.level}</span>
                   <div class="flex items-center space-x-1 text-gray-600">
                      <Star className="w-3 h-3 fill-current text-amber-500" />
                      <span class="text-[9px] font-black uppercase tracking-widest">4.9 ({tut.views})</span>
                   </div>
                </div>
                <h3 class="text-sm font-bold text-white uppercase tracking-tight italic leading-tight group-hover:text-rose-400 transition-colors">{tut.title}</h3>
                <div class="flex items-center text-gray-500 text-[10px] font-black uppercase tracking-widest group-hover:translate-x-1 transition-transform">
                   <span>Assistir agora</span>
                   <ChevronRight className="w-3.5 h-3.5 ml-1" />
                </div>
             </div>
          </div>
       ))}
    </div>

    <!-- Request Topic CTA -->
    <div class="p-10 border-2 border-dashed border-gray-800 rounded-[3rem] flex flex-col items-center justify-center text-center space-y-4 group hover:border-rose-500/20 transition-all cursor-pointer">
       <div class="w-12 h-12 bg-gray-900 rounded-2xl flex items-center justify-center text-gray-700 group-hover:bg-rose-500 group-hover:text-white transition-all shadow-xl">
          <Plus className="w-6 h-6" />
       </div>
       <div>
          <h4 class="text-lg font-bold text-white uppercase tracking-tight">Sugerir Conteúdo</h4>
          <p class="text-[10px] text-gray-600 font-medium uppercase tracking-widest">Sentiu falta de algum guia? Peça para o nosso time produzir.</p>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
