---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Mail, MessageCircle, Phone, Globe, MapPin, Send, MessageSquare, Clock } from 'lucide-react';
---

<AdminLayout title="Canais de Atendimento" activeTab="suporte">
  <div class="max-w-5xl mx-auto space-y-10 animate-fade-in py-4">
    <div class="flex items-center justify-between border-b border-gray-800 pb-10">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-white/5 rounded-2xl flex items-center justify-center text-white border border-white/10 shadow-xl">
          <Mail className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter italic">Fale Conosco</h1>
          <p class="text-sm text-gray-500 font-medium">Escolha o melhor canal para suas necessidades comerciais ou suporte crítico.</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
       <!-- WhatsApp Card -->
       <div class="bg-[#25D366]/5 border border-[#25D366]/20 p-8 rounded-[2.5rem] flex flex-col items-center text-center space-y-6 group hover:bg-[#25D366]/10 transition-all cursor-pointer">
          <div class="w-16 h-16 bg-[#25D366] rounded-2xl flex items-center justify-center text-white shadow-xl shadow-[#25D366]/20 group-hover:scale-110 transition-transform">
             <MessageCircle className="w-8 h-8 fill-current" />
          </div>
          <div class="space-y-1">
             <h3 class="text-lg font-bold text-white uppercase tracking-tight">WhatsApp</h3>
             <p class="text-[9px] font-black text-emerald-500 uppercase tracking-widest">Atendimento Comercial</p>
          </div>
          <p class="text-[10px] text-gray-500 leading-relaxed font-medium">Ideal para onboarding, parcerias e novas contratações.</p>
       </div>

       <!-- Email Card -->
       <div class="bg-blue-600/5 border border-blue-500/20 p-8 rounded-[2.5rem] flex flex-col items-center text-center space-y-6 group hover:bg-blue-600/10 transition-all cursor-pointer">
          <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-white shadow-xl shadow-blue-600/20 group-hover:scale-110 transition-transform">
             <Mail className="w-8 h-8" />
          </div>
          <div class="space-y-1">
             <h3 class="text-lg font-bold text-white uppercase tracking-tight italic">Email Direto</h3>
             <p class="text-[9px] font-black text-blue-400 uppercase tracking-widest">Suporte & Financeiro</p>
          </div>
          <p class="text-[10px] text-gray-500 leading-relaxed font-medium">Envie comprovantes ou abra chamados de baixa prioridade.</p>
       </div>

       <!-- Discord/Chat Card -->
       <div class="bg-gray-900 border border-gray-800 p-8 rounded-[2.5rem] flex flex-col items-center text-center space-y-6 group hover:border-white/20 transition-all cursor-pointer">
          <div class="w-16 h-16 bg-gray-800 rounded-2xl flex items-center justify-center text-white shadow-xl group-hover:bg-white group-hover:text-black transition-all">
             <MessageSquare className="w-8 h-8" />
          </div>
          <div class="space-y-1">
             <h3 class="text-lg font-bold text-white uppercase tracking-tight">Chat ao Vivo</h3>
             <p class="text-[9px] font-black text-gray-500 uppercase tracking-widest">Suporte em Tempo Real</p>
          </div>
          <p class="text-[10px] text-gray-500 leading-relaxed font-medium">Disponível de segunda a sexta, das 09:00 às 18:00 BRT.</p>
       </div>
    </div>

    <!-- Quick Message Form Mockup -->
    <div class="bg-gray-900/40 border border-gray-800 p-10 rounded-[3rem] space-y-8 shadow-2xl">
       <div class="flex items-center space-x-4 italic">
          <Send className="w-5 h-5 text-gray-500" />
          <h3 class="text-[10px] font-black uppercase text-gray-400 tracking-widest">Mensagem Rápida</h3>
       </div>

       <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
             <label class="text-[8px] font-black text-gray-600 uppercase tracking-widest ml-4">Nome Completo</label>
             <input type="text" placeholder="Ex: Lucas Fernandes" class="w-full bg-black/40 border border-gray-800 rounded-2xl py-4 px-6 text-[10px] text-white outline-none focus:border-white/20 transition-all font-bold uppercase tracking-widest" />
          </div>
          <div class="space-y-2">
             <label class="text-[8px] font-black text-gray-600 uppercase tracking-widest ml-4">Email de Contato</label>
             <input type="email" placeholder="Ex: lucas@getnexo.com.br" class="w-full bg-black/40 border border-gray-800 rounded-2xl py-4 px-6 text-[10px] text-white outline-none focus:border-white/20 transition-all font-bold uppercase tracking-widest" />
          </div>
       </div>
       <div class="space-y-2">
          <label class="text-[8px] font-black text-gray-600 uppercase tracking-widest ml-4">Mensagem</label>
          <textarea rows="4" placeholder="Descreva brevemente como podemos ajudar..." class="w-full bg-black/40 border border-gray-800 rounded-3xl py-4 px-6 text-[11px] text-white outline-none focus:border-white/20 transition-all font-medium leading-relaxed"></textarea>
       </div>
       
       <button class="w-full py-5 bg-white text-black font-black rounded-2xl hover:bg-gray-200 transition-all shadow-xl uppercase text-xs tracking-[0.2em] italic flex items-center justify-center space-x-3">
          <span>Enviar Agora</span>
          <Send className="w-4 h-4" />
       </button>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
