---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Marketing" activeTab="broadcasts">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-lg shadow-purple-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Marketing
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Crie e gerencie campanhas de marketing, broadcasts e segmentação por tags.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/broadcasts/new" class="px-6 py-3 bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 rounded-lg border border-purple-500/30 transition-all">Criar Nova Campanha</a>
      <a href="/admin/broadcasts/active" class="px-6 py-3 bg-pink-600/20 hover:bg-pink-600/40 text-pink-400 rounded-lg border border-pink-500/30 transition-all">Campanhas em Andamento</a>
      <a href="/admin/broadcasts/abtest" class="px-6 py-3 bg-cyan-600/20 hover:bg-cyan-600/40 text-cyan-400 rounded-lg border border-cyan-500/30 transition-all">A/B Testing</a>
    </div>
  </div>
</AdminLayout>
