---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Abandonos de Carrinho" activeTab="crm">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-yellow-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-yellow-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Abandonos de Carrinho
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Recupere carrinhos abandonados e aumente suas vendas.
    </p>
  </div>
</AdminLayout>
