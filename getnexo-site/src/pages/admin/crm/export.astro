---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Download, FileSpreadsheet, RefreshCw, CheckCircle } from 'lucide-react';
---

<AdminLayout title="Exportar CRM" activeTab="crm">
  <div class="max-w-4xl mx-auto space-y-12 animate-fade-in py-8">
    <div class="text-center space-y-4">
       <div class="w-20 h-20 bg-emerald-500/10 rounded-3xl flex items-center justify-center mx-auto mb-6">
          <Download className="w-10 h-10 text-emerald-500" />
       </div>
       <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Exportar Dados do CRM</h1>
       <p class="text-sm text-gray-500 max-w-lg mx-auto">Selecione o formato e o período para baixar o histórico completo de leads e interações.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" 
         x-data="{ 
           exporting: false, 
           done: false,
           async downloadCSV() {
             this.exporting = true;
             try {
               const token = localStorage.getItem('token');
               const response = await fetch('/api/crm/export', {
                   headers: { 'Authorization': token ? `Bearer ${token}` : '' }
               });
               if (!response.ok) throw new Error('Falha no download');

               const blob = await response.blob();
               const url = window.URL.createObjectURL(blob);
               const a = document.createElement('a');
               a.href = url;
               a.download = 'crm_export.csv';
               document.body.appendChild(a);
               a.click();
               a.remove();
               window.URL.revokeObjectURL(url);

               this.done = true;
               setTimeout(() => { this.done = false }, 5000);
             } catch (e) {
               alert('Erro ao exportar');
             } finally {
               this.exporting = false;
             }
           }
         }">
       <!-- CSV Option -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] hover:border-emerald-500/30 transition-all group cursor-pointer relative overflow-hidden"
            @click="downloadCSV()">
          <div class="absolute inset-0 bg-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          
          <FileSpreadsheet className="w-10 h-10 text-gray-600 group-hover:text-emerald-400 mb-6 transition-colors" />
          <h3 class="text-xl font-bold text-white mb-2">Exportar CSV</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Compatível com Excel, Google Sheets e ferramentas de BI externa. Inclui todos os campos personalizados.</p>
          
          <div class="mt-8 flex items-center text-xs font-bold text-emerald-500 uppercase tracking-widest opacity-50 group-hover:opacity-100 transition-opacity">
             <span x-show="!exporting && !done">Clique para Baixar</span>
             <span x-show="exporting" class="flex items-center"><RefreshCw className="w-3.5 h-3.5 mr-2 animate-spin" /> Gerando Arquivo...</span>
             <span x-show="done" class="flex items-center text-emerald-400"><CheckCircle className="w-3.5 h-3.5 mr-2" /> Download Pronto</span>
          </div>
       </div>

       <!-- JSON API Option -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] opacity-50 cursor-not-allowed">
          <div class="w-10 h-10 border border-gray-700 rounded-xl flex items-center justify-center mb-6">
             <span class="text-[10px] font-black text-gray-500">API</span>
          </div>
          <h3 class="text-xl font-bold text-gray-500 mb-2">Sync via API</h3>
          <p class="text-xs text-gray-600 leading-relaxed">Conexão direta com SalesForce, HubSpot ou Pipedrive. Requer plano Enterprise.</p>
          <div class="mt-8 text-xs font-bold text-gray-700 uppercase tracking-widest">Indisponível no Plano Atual</div>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
