---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Calendar, Clock, RefreshCw, Send, AlertCircle, CheckCircle } from 'lucide-react';

const upcomingFollowups = [
  { id: 1, lead: "Marcos Paulo", type: "WhatsApp", time: "Hoje, 14:00", subject: "Dúvida sobre Preços", priority: "High" },
  { id: 2, lead: "Juliana Mendes", type: "Email", time: "Amanhã, 10:00", subject: "Apresentação Nexus", priority: "Medium" },
  { id: 3, lead: "Tech Solutions", type: "Call", time: "28 Jan, 16:30", subject: "Demo do Produto", priority: "High" },
];
---

<AdminLayout title="Follow-up Automático" activeTab="crm">
  <div class="space-y-8 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center">
          <RefreshCw className="w-8 h-8 text-cyan-400 mr-3 animate-spin-slow" />
          Automação de Follow-up
        </h1>
        <p class="text-gray-400 mt-1">Nunca deixe um lead esfriar. O sistema agenda e dispara lembretes automaticamente.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Próximas Ações -->
      <div class="bg-gray-900/40 border border-gray-800 rounded-3xl p-8">
        <h3 class="text-lg font-bold text-white mb-6 flex items-center">
          <Calendar className="w-5 h-5 mr-3 text-cyan-400" />
          Agenda de Seguimento
        </h3>
        <div class="space-y-4">
          {upcomingFollowups.map(f => (
            <div class="bg-black/40 border border-gray-800 p-4 rounded-2xl flex items-center justify-between hover:border-cyan-500/30 transition-all group">
              <div class="flex items-center space-x-4">
                 <div class:list={["w-2 h-10 rounded-full", f.priority === 'High' ? 'bg-orange-500' : 'bg-blue-500']}></div>
                 <div>
                    <h4 class="text-sm font-bold text-white">{f.lead}</h4>
                    <p class="text-[10px] text-gray-500">{f.subject}</p>
                 </div>
              </div>
              <div class="text-right">
                 <p class="text-[10px] font-black text-cyan-400 uppercase">{f.time}</p>
                 <span class="text-[8px] text-gray-600 font-bold uppercase">{f.type}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Configuração Rápida -->
      <div class="bg-gradient-to-br from-cyan-900/20 to-transparent border border-cyan-500/20 rounded-3xl p-8">
        <h3 class="text-lg font-bold text-white mb-4">Gatilho de Reativação</h3>
        <p class="text-sm text-gray-400 leading-relaxed mb-6">
          Se um lead não interagir por mais de **48 horas**, qual ação o sistema deve tomar?
        </p>
        <div class="space-y-3">
           <button class="w-full py-4 bg-gray-900 hover:bg-gray-800 border border-gray-800 rounded-2xl flex items-center justify-between px-6 transition-all text-xs font-bold text-white">
              <span>Enviar Template WhatsApp "Olha o Carrinho"</span>
              <CheckCircle className="w-4 h-4 text-emerald-500" />
           </button>
           <button class="w-full py-4 bg-gray-900/50 hover:bg-gray-800 border border-gray-800 rounded-2xl flex items-center justify-between px-6 transition-all text-xs font-bold text-gray-500">
              <span>Notificar Vendedor Responsável</span>
              <div class="w-4 h-4 rounded-full border border-gray-700"></div>
           </button>
        </div>
        <div class="mt-8 flex items-center space-x-2 text-[10px] text-orange-400 bg-orange-500/10 p-3 rounded-xl border border-orange-500/20">
           <AlertCircle className="w-4 h-4" />
           <span>Atenção: 42 leads aguardam follow-up manual hoje.</span>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  @keyframes spin-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  .animate-spin-slow { animation: spin-slow 8s linear infinite; }
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
