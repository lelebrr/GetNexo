---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Users, Search, Filter, Plus, Mail, Phone, Tag, MoreHorizontal } from 'lucide-react';

const leads = [
  { id: 1, name: "Ana Silva", email: "ana@exemplo.com", phone: "(11) 98877-6655", status: "Novo", tags: ["WhatsApp", "Promoção"] },
  { id: 2, name: "Bruno Oliveira", email: "bruno@exemplo.com", phone: "(21) 97766-5544", status: "Quente", tags: ["Instagram", "B2B"] },
  { id: 3, name: "Carla Santos", email: "carla@exemplo.com", phone: "(31) 96655-4433", status: "Convertido", tags: ["Fiel"] },
  { id: 4, name: "Diego Souza", email: "diego@exemplo.com", phone: "(41) 95544-3322", status: "Inativo", tags: ["Churn"] },
  { id: 5, name: "Elena Lima", email: "elena@exemplo.com", phone: "(51) 94433-2211", status: "Novo", tags: ["Checkout"] },
];
---

<AdminLayout title="Lista Total de Leads" activeTab="crm">
  <div class="space-y-6 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-white uppercase tracking-tight">Gerenciamento de Leads</h1>
        <p class="text-sm text-gray-400">Total de 4.250 leads capturados no último mês.</p>
      </div>
      <button class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-5 py-2.5 rounded-xl flex items-center space-x-2 transition-all">
        <Plus className="w-4 h-4" />
        <span>Importar Leads</span>
      </button>
    </div>

    <!-- Barra de Filtros -->
    <div class="flex flex-col md:flex-row gap-4 bg-gray-900/40 p-4 border border-gray-800 rounded-2xl">
      <div class="relative flex-1">
        <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" />
        <input type="text" placeholder="Buscar por nome, email ou telefone..." class="w-full bg-black/60 border border-gray-800 rounded-xl py-2 pl-10 pr-4 text-sm text-white focus:border-indigo-500 outline-none" />
      </div>
      <div class="flex space-x-2">
        <button class="px-4 py-2 bg-gray-800 border border-gray-700 rounded-xl text-xs font-bold text-gray-400 hover:text-white flex items-center">
            <Filter className="w-3 h-3 mr-2" /> Filtros
        </button>
      </div>
    </div>

    <!-- Tabela -->
    <div class="bg-gray-900/20 border border-gray-800 rounded-2xl overflow-hidden backdrop-blur-md">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-black/40 border-b border-gray-800">
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500">Nome / Contato</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500">Status</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500">Segmentação</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/50">
          {leads.map(lead => (
            <tr class="hover:bg-indigo-500/5 transition-colors group">
              <td class="px-6 py-4">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 bg-indigo-500/10 rounded-full flex items-center justify-center text-indigo-400 font-bold">
                    {lead.name[0]}
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-white">{lead.name}</h4>
                    <p class="text-[10px] text-gray-500 flex items-center">
                      <Mail className="w-2.5 h-2.5 mr-1" /> {lead.email}
                    </p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <span class:list={[
                  "text-[9px] font-black uppercase px-2 py-0.5 rounded",
                  lead.status === 'Novo' ? 'bg-cyan-500/10 text-cyan-400' : 
                  lead.status === 'Quente' ? 'bg-orange-500/10 text-orange-400' :
                  lead.status === 'Convertido' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-gray-800 text-gray-500'
                ]}>
                  {lead.status}
                </span>
              </td>
              <td class="px-6 py-4">
                <div class="flex flex-wrap gap-1">
                  {lead.tags.map(tag => (
                    <span class="text-[8px] bg-white/5 text-gray-400 border border-white/10 px-1.5 py-0.5 rounded flex items-center">
                      <Tag className="w-2 h-2 mr-1 opacity-50" /> {tag}
                    </span>
                  ))}
                </div>
              </td>
              <td class="px-6 py-4 text-right">
                <button class="p-2 text-gray-500 hover:text-white transition-colors">
                  <MoreHorizontal className="w-4 h-4" />
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
