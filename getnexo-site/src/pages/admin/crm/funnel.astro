---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { LayoutGrid, Filter, ArrowRight, User, MoreVertical } from 'lucide-react';

const columns = [
  { id: 'leads', title: 'Novos Leads', count: 12, color: 'blue', items: [
    { id: 101, name: "Roberto Junior", value: "R$ 4.500", time: "2h atrás" },
    { id: 102, name: "Maria Clara", value: "R$ 12.000", time: "4h atrás" },
    { id: 103, name: "Agência Digital X", value: "R$ 0", time: "5h atrás" },
  ]},
  { id: 'discovery', title: 'Descoberta', count: 5, color: 'cyan', items: [
    { id: 104, name: "Lucas Ferreira", value: "R$ 800", time: "1d atrás" },
    { id: 105, name: "Fernanda Lima", value: "R$ 2.500", time: "1d atrás" },
  ]},
  { id: 'negotiation', title: 'Negociação', count: 8, color: 'purple', items: [
    { id: 106, name: "Supermercado Real", value: "R$ 25.000", time: "2d atrás" },
  ]},
  { id: 'closed', title: 'Ganhos', count: 42, color: 'emerald', items: [
    { id: 107, name: "Loja de Conveniência", value: "R$ 1.200", time: "3d atrás" },
  ]},
];
---

<AdminLayout title="Funil 360º Visual" activeTab="crm">
  <div class="h-full flex flex-col space-y-6 animate-fade-in overflow-hidden">
    <div class="flex items-center justify-between shrink-0">
      <div>
        <h1 class="text-2xl font-bold text-white flex items-center uppercase tracking-tight">
          <LayoutGrid className="w-6 h-6 mr-3 text-indigo-400" />
          Pipeline de Vendas
        </h1>
        <p class="text-xs text-gray-500 font-medium">Visualize e arraste leads através dos estágios de venda.</p>
      </div>
    </div>

    <!-- Funil Estilo Kanban -->
    <div class="flex-1 flex space-x-6 overflow-x-auto pb-6 scrollbar-hide">
      {columns.map(col => (
        <div class="w-80 shrink-0 flex flex-col space-y-4">
          <div class="flex items-center justify-between px-3">
             <div class="flex items-center space-x-2">
                <div class:list={["w-2 h-2 rounded-full", `bg-${col.color}-500 shadow-[0_0_8px_rgba(var(--${col.color}-500-rgb),_0.5)]`]}></div>
                <h3 class="text-[10px] font-black uppercase text-gray-400 tracking-widest">{col.title}</h3>
                <span class="text-[10px] bg-gray-900 border border-gray-800 text-gray-500 px-1.5 py-0.5 rounded-md">{col.count}</span>
             </div>
             <button class="text-gray-700 hover:text-white"><MoreVertical className="w-3 h-3" /></button>
          </div>
          
          <div class="flex-1 space-y-3 p-1">
            {col.items.map(item => (
              <div class="bg-gray-900/40 border border-gray-800 p-4 rounded-2xl hover:border-gray-700 transition-all cursor-move group relative overflow-hidden">
                <div class:list={["absolute left-0 top-0 bottom-0 w-1", `bg-${col.color}-500/50`]}></div>
                <div class="flex justify-between items-start mb-3">
                   <h4 class="text-sm font-bold text-white group-hover:text-indigo-400 transition-colors uppercase tracking-tight">{item.name}</h4>
                </div>
                <div class="flex items-center justify-between">
                   <span class="text-[10px] font-mono font-bold text-emerald-400">{item.value}</span>
                   <span class="text-[9px] text-gray-600 font-medium">{item.time}</span>
                </div>
                <div class="mt-4 pt-3 border-t border-gray-800 flex justify-end">
                   <div class="w-6 h-6 bg-gray-800 rounded-full border border-gray-700 flex items-center justify-center text-[10px] text-gray-500">
                      <User className="w-3 h-3" />
                   </div>
                </div>
              </div>
            ))}
            
            <button class="w-full py-3 border border-dashed border-gray-800 rounded-2xl text-[9px] font-black uppercase text-gray-600 hover:text-gray-400 hover:border-gray-700 transition-all">
                + Novo Lead neste Estágio
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

