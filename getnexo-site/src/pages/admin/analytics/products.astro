---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ShoppingCart, Star, TrendingUp, Package, ExternalLink, ArrowRight } from 'lucide-react';

const topProducts = [
  { id: 1, name: "Sneaker Premium X1", sales: 480, revenue: "R$ 143k", conversion: "8.2%", color: "indigo" },
  { id: 2, name: "Watch Ultra Edition", sales: 320, revenue: "R$ 96k", conversion: "6.5%", color: "cyan" },
  { id: 3, name: "Fusion Earbuds Pro", sales: 215, revenue: "R$ 42k", conversion: "12.4%", color: "purple" },
  { id: 4, name: "Smart Lamp Lite", sales: 180, revenue: "R$ 18k", conversion: "15.1%", color: "orange" },
];
---

<AdminLayout title="Vendas por Produto" activeTab="analytics">
  <div class="space-y-12 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center">
          <Package className="w-8 h-8 text-orange-500 mr-3" />
          Desempenho de Produtos
        </h1>
        <p class="text-gray-400 mt-1">Descubra quais produtos estão sendo o motor do seu faturamento.</p>
      </div>
    </div>

    <!-- Grilla de Cards Impactantes -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 text-white">
      {topProducts.map((p, i) => (
        <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] p-10 flex flex-col md:flex-row gap-8 items-center group hover:bg-gray-900/60 transition-all border-b-4 border-b-transparent" style={`border-bottom-color: var(--${p.color}-500)`}>
          <div class:list={["w-32 h-32 rounded-3xl shrink-0 flex items-center justify-center text-3xl font-black shadow-2xl transition-transform group-hover:scale-110", `bg-${p.color}-600/20 text-${p.color}-400`]}>
            #{i+1}
          </div>
          <div class="flex-1 space-y-4 text-center md:text-left">
            <div>
              <h3 class="text-2xl font-bold tracking-tight mb-1">{p.name}</h3>
              <div class="flex items-center justify-center md:justify-start space-x-2">
                <span class="text-xs font-black uppercase text-gray-500 tracking-widest">{p.sales} Vendas efetuadas</span>
              </div>
            </div>
            <div class="flex items-baseline space-x-4">
               <div>
                 <p class="text-[10px] uppercase text-gray-600 font-black mb-0.5">Receita Total</p>
                 <p class="text-lg font-mono font-bold text-emerald-400">{p.revenue}</p>
               </div>
               <div class="w-px h-8 bg-gray-800"></div>
               <div>
                 <p class="text-[10px] uppercase text-gray-600 font-black mb-0.5">Conversão</p>
                 <p class="text-lg font-mono font-bold text-white">{p.conversion}</p>
               </div>
            </div>
            <div class="pt-2">
               <button class="flex items-center text-xs font-bold hover:underline transition-all" style={`color: var(--${p.color}-400)`}>
                  Análise Detalhada <ArrowRight className="ml-2 w-3 h-3" />
               </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Seção de Curiosidades/Insights -->
    <div class="bg-black/50 border border-gray-800 rounded-3xl p-10 flex items-center justify-between">
      <div class="space-y-2">
        <h4 class="text-xl font-bold text-white">Otimização IA Ativa</h4>
        <p class="text-gray-400 max-w-2xl text-sm leading-relaxed">
          Nossa inteligência artificial identificou que o produto **Sneaker Premium X1** tem uma busca 40% maior nas quartas-feiras. Considere disparar uma campanha específica neste horário para maximizar ROI.
        </p>
      </div>
      <button class="hidden lg:flex p-4 bg-gray-800 rounded-2xl hover:bg-gray-700 transition-colors">
        <TrendingUp className="w-6 h-6 text-emerald-500" />
      </button>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
