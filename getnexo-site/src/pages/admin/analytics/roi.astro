---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { DollarSign, BarChart2, PieChart, ArrowUpRight, ArrowDownRight, Briefcase } from 'lucide-react';

const campaigns = [
  { name: "Venda Flash Carnaval", spend: "R$ 5,000", revenue: "R$ 45,000", roi: "9.0x", status: "Excelente" },
  { name: "Retargeting Abandonados", spend: "R$ 1,200", revenue: "R$ 8,400", roi: "7.0x", status: "Bom" },
  { name: "Google Ads Institucional", spend: "R$ 3,500", revenue: "R$ 4,200", roi: "1.2x", status: "Atenção" },
  { name: "Influencers Verão", spend: "R$ 10,000", revenue: "R$ 120,000", roi: "12.0x", status: "Elite" },
];
---

<AdminLayout title="ROI por Campanha" activeTab="analytics">
  <div class="space-y-8 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center">
          <DollarSign className="w-8 h-8 text-indigo-500 mr-3" />
          Retorno sobre Investimento
        </h1>
        <p class="text-gray-400 mt-1">Veja quanto cada real investido está trazendo de volta para o seu bolso.</p>
      </div>
    </div>

    <!-- Cards de Topo -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-indigo-600/10 border border-indigo-500/20 p-8 rounded-3xl relative overflow-hidden group">
        <div class="absolute right-0 top-0 p-4 opacity-10 group-hover:scale-110 transition-transform">
          <BarChart2 className="w-16 h-16 text-indigo-500" />
        </div>
        <p class="text-xs font-bold text-indigo-400 uppercase tracking-widest mb-1">ROI Médio Geral</p>
        <h3 class="text-4xl font-black text-white">7.4x</h3>
        <p class="text-xs text-emerald-400 mt-2 flex items-center"><ArrowUpRight className="w-3 h-3 mr-1" /> +14% vs mês anterior</p>
      </div>
      
      <div class="bg-gray-900/50 border border-gray-800 p-8 rounded-3xl">
        <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Investimento Total</p>
        <h3 class="text-4xl font-black text-white">R$ 19.7k</h3>
        <p class="text-xs text-gray-500 mt-2">Período: 30 dias</p>
      </div>

      <div class="bg-gray-900/50 border border-gray-800 p-8 rounded-3xl">
        <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Receita Gerada</p>
        <h3 class="text-4xl font-black text-white">R$ 177.6k</h3>
        <p class="text-xs text-indigo-400 mt-2">Eficiência máxima atingida</p>
      </div>
    </div>

    <!-- Tabela de Campanhas -->
    <div class="bg-gray-900/30 border border-gray-800 rounded-3xl overflow-hidden backdrop-blur-sm">
      <div class="p-6 border-b border-gray-800 bg-black/20 flex items-center justify-between">
        <h3 class="text-sm font-bold text-white flex items-center">
          <Briefcase className="w-4 h-4 mr-2" />
          Ranking de Campanhas
        </h3>
        <button class="text-xs font-bold text-indigo-400 hover:text-indigo-300">Explorar Tudo</button>
      </div>
      <table class="w-full text-left">
        <thead>
          <tr class="bg-black/10">
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Campanha</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Gasto</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Retorno</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">ROI</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/50">
          {campaigns.map((c) => (
            <tr class="hover:bg-white/5 transition-colors group">
              <td class="px-6 py-5 font-bold text-white tracking-tight">{c.name}</td>
              <td class="px-6 py-5 text-sm text-gray-400">{c.spend}</td>
              <td class="px-6 py-5 text-sm text-emerald-400 font-mono">{c.revenue}</td>
              <td class="px-6 py-5">
                <span class="px-2 py-1 bg-white/5 rounded-lg text-xs font-black text-white border border-white/10 group-hover:border-indigo-500/50 transition-colors">{c.roi}</span>
              </td>
              <td class="px-6 py-5">
                <span class:list={[
                  "text-[9px] font-black uppercase px-2 py-1 rounded",
                  c.status === 'Elite' || c.status === 'Excelente' ? 'bg-indigo-500/10 text-indigo-400' : (c.status === 'Atenção' ? 'bg-rose-500/10 text-rose-400' : 'bg-gray-800 text-gray-400')
                ]}>
                  {c.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
