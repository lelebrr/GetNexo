---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Globe, MapPin, Users, TrendingUp, Compass, Navigation } from 'lucide-react';

const regions = [
  { name: "São Paulo", sales: "R$ 84k", count: 1205, growth: "+22%", color: "indigo" },
  { name: "Rio de Janeiro", sales: "R$ 52k", count: 840, growth: "+15%", color: "cyan" },
  { name: "Minas Gerais", sales: "R$ 38k", count: 620, growth: "-4%", color: "purple" },
  { name: "Santa Catarina", sales: "R$ 31k", count: 480, growth: "+35%", color: "emerald" },
  { name: "Bahia", sales: "R$ 18k", count: 310, growth: "+8%", color: "orange" },
];
---

<AdminLayout title="Mapa Geográfico" activeTab="analytics">
  <div class="space-y-8 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center">
          <Globe className="w-8 h-8 text-cyan-500 mr-3" />
          Análise Geográfica de Vendas
        </h1>
        <p class="text-gray-400 mt-1">Identifique onde seus clientes mais valiosos estão localizados.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Mapa Mockup -->
      <div class="lg:col-span-2 bg-gray-900 border border-gray-800 rounded-[2.5rem] p-1 overflow-hidden relative group">
        <div class="absolute inset-0 bg-gradient-to-br from-black to-gray-900 z-0"></div>
        <!-- Simulação de pontos no mapa -->
        <div class="absolute inset-0 z-10 opacity-30 bg-[radial-gradient(#333_1px,transparent_1px)] [background-size:20px_20px]"></div>
        
        <div class="relative z-20 h-[500px] flex items-center justify-center">
            <div class="text-center space-y-4">
               <Navigation className="w-20 h-20 text-gray-800 mx-auto animate-bounce" />
               <p class="text-xs font-black uppercase text-gray-600 tracking-[0.3em]">Map Engine Running (Brasil)</p>
            </div>
            
            <!-- Pontos flutuantes (Mock) -->
            <div class="absolute top-1/4 left-1/2 w-4 h-4 bg-indigo-500 rounded-full animate-ping opacity-75"></div>
            <div class="absolute top-1/3 left-[55%] w-3 h-3 bg-cyan-500 rounded-full animate-ping opacity-50"></div>
            <div class="absolute top-[60%] left-[48%] w-5 h-5 bg-purple-500 rounded-full animate-ping"></div>
        </div>

        <div class="absolute bottom-6 left-6 z-30 p-4 bg-black/60 backdrop-blur-xl border border-white/5 rounded-2xl">
           <div class="flex items-center space-x-3 text-[10px] font-black uppercase tracking-widest text-gray-400">
              <span class="w-2 h-2 bg-indigo-500 rounded-full"></span> <span>Alta Densidade</span>
              <span class="w-2 h-2 bg-purple-500 rounded-full ml-2"></span> <span>Emergente</span>
           </div>
        </div>
      </div>

      <!-- Lista de Regiões -->
      <div class="space-y-4">
        <h3 class="text-sm font-black text-gray-500 uppercase tracking-widest ml-1 mb-6">Top Estados</h3>
        {regions.map((r) => (
          <div class="bg-gray-900/50 border border-gray-800 p-5 rounded-2xl hover:bg-gray-900 transition-all flex items-center justify-between group">
            <div class="flex items-center space-x-4">
               <div class:list={["w-10 h-10 rounded-xl flex items-center justify-center shrink-0", `bg-${r.color}-500/10 text-${r.color}-400`]}>
                  <MapPin className="w-5 h-5" />
               </div>
               <div>
                  <h4 class="text-sm font-bold text-white">{r.name}</h4>
                  <p class="text-[10px] text-gray-500 font-mono">{r.count} clientes</p>
               </div>
            </div>
            <div class="text-right">
               <p class="text-sm font-mono font-bold text-white">{r.sales}</p>
               <span class:list={["text-[10px] font-black", r.growth.startsWith('+') ? 'text-emerald-500' : 'text-rose-500']}>{r.growth}</span>
            </div>
          </div>
        ))}
        
        <button class="w-full py-4 border border-gray-800 rounded-2xl text-xs font-bold text-gray-500 hover:text-white hover:border-white/10 transition-all uppercase tracking-widest">
           Exportar Dados Geográficos
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
