---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Mapa Geográfico" activeTab="analytics">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-lg shadow-purple-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Mapa Geográfico
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Visualize vendas e leads por região geográfica.
    </p>
  </div>
</AdminLayout>
