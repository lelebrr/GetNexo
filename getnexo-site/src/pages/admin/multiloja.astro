---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Multi-Loja" activeTab="multiloja">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-amber-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Multi-Loja
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Gerencie múltiplas lojas, configurações e relatórios consolidados.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/multiloja/stores" class="px-6 py-3 bg-amber-600/20 hover:bg-amber-600/40 text-amber-400 rounded-lg border border-amber-500/30 transition-all">Todas as Lojas</a>
      <a href="/admin/multiloja/new" class="px-6 py-3 bg-orange-600/20 hover:bg-orange-600/40 text-orange-400 rounded-lg border border-orange-500/30 transition-all">Criar Nova Loja</a>
      <a href="/admin/multiloja/config" class="px-6 py-3 bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 rounded-lg border border-purple-500/30 transition-all">Configurações</a>
    </div>
  </div>
</AdminLayout>
