---
// src/pages/admin/tonalidade/[dominio].astro
import Layout from '../../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const { dominio = 'geral' } = Astro.params;

// No backend real, o caminho seria relativo ao root do projeto
const SESSIONS_DIR = path.join(process.cwd(), '..', 'sessions');
const caminho = path.join(SESSIONS_DIR, `${dominio}.json`);

let ton = 'amigo'; // padrão
let dadosSessao = {};

if (fs.existsSync(caminho)) {
    try {
        const fileContent = fs.readFileSync(caminho, 'utf-8');
        dadosSessao = JSON.parse(fileContent);
        ton = dadosSessao.tom || 'amigo';
    } catch (e) {
        console.error('Erro ao ler sessão:', e);
    }
}

// Handle POST request to save tone
if (Astro.request.method === 'POST') {
    try {
        const formData = await Astro.request.formData();
        const novoTom = formData.get('tom');
        
        if (novoTom) {
            ton = novoTom.toString();
            dadosSessao.tom = ton;
            
            if (!fs.existsSync(SESSIONS_DIR)) {
                fs.mkdirSync(SESSIONS_DIR, { recursive: true });
            }
            
            fs.writeFileSync(caminho, JSON.stringify(dadosSessao, null, 2));
            return Astro.redirect(Astro.url.pathname + '?saved=true');
        }
    } catch (e) {
        console.error('Erro ao salvar tom:', e);
    }
}

const isSaved = Astro.url.searchParams.get('saved') === 'true';
---

<Layout title={`Tonalidade - ${dominio}`}>
    <main class="min-h-screen bg-void p-8 font-sans">
        <header class="text-neon-blue text-3xl font-bold mb-8 flex items-center gap-4">
            <div class="h-10 w-2 bg-neon-blue shadow-[0_0_15px_#00f7ff]"></div>
            Tonalidade do Bot – <span class="text-white">{dominio}</span>
        </header>

        <div class="bg-black border-2 border-cyan-500 rounded-xl p-8 max-w-lg shadow-[0_0_30px_rgba(0,247,255,0.1)] relative overflow-hidden">
            <!-- Glassmorphism effect -->
            <div class="absolute top-0 right-0 -mt-10 -mr-10 h-40 w-40 bg-cyan-500/10 blur-3xl rounded-full"></div>
            
            <h2 class="text-gold text-xl font-semibold mb-6 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
                Como ele fala?
            </h2>

            <form method="POST" class="space-y-6 relative z-10">
                <!-- Toggle Tom -->
                <div class="flex justify-between items-center bg-gray-900/50 p-4 rounded-lg border border-cyan-900/50">
                    <label class="text-cyan-400 font-medium">Estilo de Voz</label>
                    <select 
                        name="tom"
                        class="bg-black text-cyan-300 border border-cyan-500 rounded-md px-4 py-2 focus:ring-2 focus:ring-neon-blue outline-none transition-all cursor-pointer"
                        onchange="this.form.submit()"
                    >
                        <option value="amigo" selected={ton === 'amigo'}>Amigo</option>
                        <option value="certinho" selected={ton === 'certinho'}>Certinho</option>
                        <option value="empresarial" selected={ton === 'empresarial'}>Empresarial</option>
                    </select>
                </div>

                {isSaved && (
                    <div class="bg-green-500/20 border border-green-500 text-green-400 px-4 py-2 rounded-lg text-sm animate-pulse">
                        Configuração salva com sucesso!
                    </div>
                )}

                <!-- Preview -->
                <div class="pt-6 border-t border-cyan-900/50">
                    <h3 class="text-gray-500 text-xs uppercase tracking-widest font-bold mb-4">Preview em Tempo Real</h3>
                    
                    <div class="bg-gray-900 rounded-lg p-4 space-y-4">
                        <div class="flex gap-3">
                            <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-xs text-gray-400 font-bold">U</div>
                            <div class="bg-gray-800 rounded-2xl rounded-tl-none px-4 py-2 text-sm text-gray-300">
                                tem bermuda azul?
                            </div>
                        </div>

                        <div class="flex gap-3 justify-end">
                            <div class="bg-cyan-900/30 border border-cyan-500/30 rounded-2xl rounded-tr-none px-4 py-2 text-sm text-cyan-100 max-w-[80%]">
                                <span class="text-gold text-[10px] block mb-1 uppercase font-bold">Bot Nexo</span>
                                {ton === 'amigo' ? "E aí, Leandro? Tem sim, R$89!" :
                                 ton === 'certinho' ? "Olá, Leandro. Sim, temos a bermuda azul, R$89." :
                                 "Sr. Leandro, disponível a bermuda azul ao valor de R$89,00."}
                            </div>
                            <div class="w-8 h-8 rounded-full bg-cyan-600 flex items-center justify-center text-xs text-white font-bold">AI</div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </main>
</Layout>

<style>
    :root {
        --void: #0a0a0c;
        --neon-blue: #00f7ff;
        --gold: #ffd500;
    }
    .bg-void { background: var(--void); }
    .text-neon-blue { color: var(--neon-blue); }
    .text-gold { color: var(--gold); }
    
    @keyframes glow {
        0% { filter: drop-shadow(0 0 5px var(--neon-blue)); }
        50% { filter: drop-shadow(0 0 15px var(--neon-blue)); }
        100% { filter: drop-shadow(0 0 5px var(--neon-blue)); }
    }
</style>
