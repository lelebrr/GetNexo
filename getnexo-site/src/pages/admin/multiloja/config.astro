---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Settings, Save, RefreshCw, Layers, Sliders, CheckCircle2, AlertCircle } from 'lucide-react';
---

<AdminLayout title="Configuração Global" activeTab="multiloja">
  <div class="max-w-4xl mx-auto space-y-10 animate-fade-in py-4"
       x-data="{ 
         syncStock: true,
         syncPrices: false,
         autoImport: true,
         saving: false,
         save() {
           this.saving = true;
           setTimeout(() => { this.saving = false; alert('Configurações salvas!'); }, 1000);
         }
       }">
    
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-amber-500/10 rounded-2xl flex items-center justify-center text-amber-500 border border-amber-500/20 shadow-xl shadow-amber-500/10">
          <Settings className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Sincronização</h1>
          <p class="text-sm text-gray-500 font-medium">Defina como os dados devem fluir entre todas as suas lojas conectadas.</p>
        </div>
      </div>
      <button @click="save()" class="px-8 py-4 bg-amber-600 text-white font-black rounded-2xl flex items-center space-x-3 transition-all hover:bg-amber-500 shadow-xl shadow-amber-600/20 uppercase text-xs tracking-widest">
         <Save className="w-5 h-5" :class="saving ? 'animate-spin' : ''" />
         <span x-text="saving ? 'Salvando...' : 'Salvar Alterações'"></span>
      </button>
    </div>

    <div class="grid grid-cols-1 gap-6">
       <!-- Stock Sync -->
       <div class="bg-gray-900/40 border border-gray-800 p-10 rounded-[2.5rem] flex items-center justify-between group">
          <div class="flex items-center space-x-6">
             <div class="w-12 h-12 bg-gray-800 rounded-xl flex items-center justify-center text-gray-500 group-hover:bg-amber-500/10 group-hover:text-amber-500 transition-all">
                <Layers className="w-6 h-6" />
             </div>
             <div>
                <h4 class="text-lg font-bold text-white uppercase tracking-tight">Vincular Estoque Real</h4>
                <p class="text-[10px] text-gray-500 font-medium">Se o estoque baixar em uma loja, atualiza em todas automaticamente.</p>
             </div>
          </div>
          <button @click="syncStock = !syncStock" class="w-14 h-7 rounded-full bg-gray-800 relative transition-colors" :class="syncStock ? 'bg-amber-600' : 'bg-gray-700'">
             <div class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full transition-all shadow-sm" :class="syncStock ? 'translate-x-7' : ''"></div>
          </button>
       </div>

       <!-- Price Sync -->
       <div class="bg-gray-900/40 border border-gray-800 p-10 rounded-[2.5rem] flex items-center justify-between group">
          <div class="flex items-center space-x-6">
             <div class="w-12 h-12 bg-gray-800 rounded-xl flex items-center justify-center text-gray-500 group-hover:bg-amber-500/10 group-hover:text-amber-500 transition-all">
                <RefreshCw className="w-6 h-6" />
             </div>
             <div>
                <h4 class="text-lg font-bold text-white uppercase tracking-tight">Vincular Tabela de Preços</h4>
                <p class="text-[10px] text-gray-500 font-medium">Manter preços unificados em todo o ecossistema multi-loja.</p>
             </div>
          </div>
          <button @click="syncPrices = !syncPrices" class="w-14 h-7 rounded-full bg-gray-800 relative transition-colors" :class="syncPrices ? 'bg-amber-600' : 'bg-gray-700'">
             <div class="absolute top-1 left-1 w-5 h-5 bg-white rounded-full transition-all shadow-sm" :class="syncPrices ? 'translate-x-7' : ''"></div>
          </button>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
