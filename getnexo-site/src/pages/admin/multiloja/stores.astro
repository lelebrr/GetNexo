---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Store, Plus, Power, Settings, Globe, ShieldCheck, ArrowRight } from 'lucide-react';
---

<AdminLayout title="Minhas Lojas" activeTab="multiloja">
  <div class="max-w-6xl mx-auto space-y-10 animate-fade-in py-4"
       x-data="{ 
         stores: [
           { id: 1, name: 'Loja Principal', domain: 'loja.getnexo.com.br', status: 'Ativa', type: 'Shopify', color: 'bg-emerald-500' },
           { id: 2, name: 'Outlet Nexo', domain: 'outlet.site.com', status: 'Ativa', type: 'WooCommerce', color: 'bg-emerald-500' },
           { id: 3, name: 'Drop Nacional', domain: 'drop.nexo.test', status: 'Manutenção', type: 'Custom', color: 'bg-amber-500' }
         ],
         toggle(id) {
           this.stores = this.stores.map(s => s.id === id ? { ...s, status: s.status === 'Ativa' ? 'Inativa' : 'Ativa', color: s.status === 'Ativa' ? 'bg-gray-700' : 'bg-emerald-500' } : s);
         }
       }">
    
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-amber-500/10 rounded-2xl flex items-center justify-center text-amber-500 border border-amber-500/20 shadow-xl shadow-amber-500/10">
          <Store className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Multi-Loja</h1>
          <p class="text-sm text-gray-500 font-medium">Controle todas as suas operações a partir de uma única interface centralizada.</p>
        </div>
      </div>
      <button class="px-6 py-3 bg-amber-600 hover:bg-amber-500 text-white font-black rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-amber-600/20 uppercase text-xs tracking-widest">
         <Plus className="w-5 h-5" />
         <span>Nova Unidade</span>
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
       <template x-for="store in stores" :key="store.id">
          <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] hover:border-amber-500/20 transition-all group flex flex-col justify-between h-[320px]">
             <div>
                <div class="flex justify-between items-start mb-6">
                   <div class="w-12 h-12 bg-gray-800 rounded-2xl flex items-center justify-center text-amber-500 group-hover:scale-110 transition-transform">
                      <Globe className="w-6 h-6" />
                   </div>
                   <div class:list={["w-3 h-3 rounded-full shadow-[0_0_10px_rgba(var(--tw-color-opacity))]"]} :class="store.color"></div>
                </div>
                <h3 class="text-xl font-bold text-white uppercase tracking-tight leading-tight" x-text="store.name"></h3>
                <p class="text-[10px] text-gray-500 font-medium italic mt-1" x-text="store.domain"></p>
                <div class="mt-4 inline-flex items-center space-x-2 px-3 py-1 bg-gray-800/50 rounded-lg">
                   <ShieldCheck className="w-3 h-3 text-emerald-400" />
                   <span class="text-[8px] font-black text-gray-400 uppercase tracking-widest" x-text="store.type"></span>
                </div>
             </div>

             <div class="flex items-center justify-between pt-8 border-t border-gray-800/50">
                <button @click="toggle(store.id)" class="text-[10px] font-black uppercase tracking-widest hover:text-white transition-colors" :class="store.status === 'Ativa' ? 'text-emerald-500' : 'text-gray-500'">
                   <span x-text="store.status"></span>
                </button>
                <div class="flex items-center space-x-2">
                   <button class="p-2.5 bg-gray-800 hover:bg-white/10 text-gray-400 hover:text-white rounded-xl transition-all"><Settings className="w-4 h-4" /></button>
                   <button class="p-2.5 bg-amber-600 hover:bg-amber-500 text-white rounded-xl transition-all shadow-lg shadow-amber-600/10"><ArrowRight className="w-4 h-4" /></button>
                </div>
             </div>
          </div>
       </template>

       <!-- Add New Card -->
       <div class="bg-black/40 border-2 border-dashed border-gray-800 p-8 rounded-[2.5rem] hover:border-amber-500/20 transition-all group cursor-pointer flex flex-col items-center justify-center text-center space-y-4">
          <div class="w-16 h-16 bg-gray-900 rounded-2xl flex items-center justify-center text-gray-600 group-hover:bg-amber-500 group-hover:text-white transition-all">
             <Plus className="w-8 h-8" />
          </div>
          <h4 class="text-lg font-bold text-white uppercase tracking-tight">Expandir Rede</h4>
          <p class="text-[10px] text-gray-600 font-medium">Conecte um novo domínio ou plataforma.</p>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
