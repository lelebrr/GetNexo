---
import AdminLayout from '../../layouts/AdminLayout.astro';
import fs from 'fs';
import path from 'path';

// Função para extrair informações do post do arquivo .astro
function extractPostInfo(filePath) {
    try {
        const content = fs.readFileSync(filePath, 'utf-8');
        
        // Extrair título
        const titleMatch = content.match(/const title = ["']([^"']+)["']/);
        const title = titleMatch ? titleMatch[1] : path.basename(filePath, '.astro');
        
        // Extrair slug do nome do arquivo
        const slug = path.basename(filePath, '.astro');
        
        // Extrair data de publicação
        const dateMatch = content.match(/datePublished["']?:\s*["']([^"']+)["']/);
        const date = dateMatch ? dateMatch[1] : '2026-01-01';
        
        // Extrair idioma do caminho
        const langMatch = filePath.match(/\/(pt|en|es|fr)\//);
        const lang = langMatch ? langMatch[1] : 'pt';
        
        // Extrair status (se tem dataPublished é publicado)
        const status = dateMatch ? 'published' : 'draft';
        
        // Extrair categoria
        const categoryMatch = content.match(/articleSection["']?:\s*["']([^"']+)["']/);
        const category = categoryMatch ? categoryMatch[1] : 'Geral';
        
        return {
            slug,
            title,
            lang,
            status,
            date,
            category,
            path: filePath
        };
    } catch (error) {
        console.error(`Erro ao processar ${filePath}:`, error);
        return null;
    }
}

// Função para listar todos os posts de todos os idiomas
function getAllPosts() {
    const posts = [];
    const languages = ['pt', 'en', 'es', 'fr'];
    
    languages.forEach(lang => {
        const blogDir = path.join(process.cwd(), 'src', 'pages', lang, 'blog');
        
        if (fs.existsSync(blogDir)) {
            const files = fs.readdirSync(blogDir);
            
            files.forEach(file => {
                if (file.endsWith('.astro') && file !== 'index.astro') {
                    const filePath = path.join(blogDir, file);
                    const postInfo = extractPostInfo(filePath);
                    
                    if (postInfo) {
                        posts.push(postInfo);
                    }
                }
            });
        }
    });
    
    // Também verificar o diretório principal (pt-BR)
    const mainBlogDir = path.join(process.cwd(), 'src', 'pages', 'blog');
    if (fs.existsSync(mainBlogDir)) {
        const files = fs.readdirSync(mainBlogDir);
        
        files.forEach(file => {
            if (file.endsWith('.astro') && file !== 'index.astro') {
                const filePath = path.join(mainBlogDir, file);
                const postInfo = extractPostInfo(filePath);
                
                if (postInfo) {
                    posts.push(postInfo);
                }
            }
        });
    }
    
    // Ordenar por data (mais recente primeiro)
    return posts.sort((a, b) => new Date(b.date) - new Date(a.date));
}

// Função para agrupar posts por idioma
function groupPostsByLanguage(posts) {
    const grouped = {
        'pt': { name: 'Português', flag: '🇧🇷', posts: [] },
        'en': { name: 'English', flag: '🇺🇸', posts: [] },
        'es': { name: 'Español', flag: '🇪🇸', posts: [] },
        'fr': { name: 'Français', flag: '🇫🇷', posts: [] }
    };
    
    posts.forEach(post => {
        if (grouped[post.lang]) {
            grouped[post.lang].posts.push(post);
        }
    });
    
    return grouped;
}

// Buscar todos os posts
const allPosts = getAllPosts();
const postsByLanguage = groupPostsByLanguage(allPosts);
const totalPosts = allPosts.length;
---

<AdminLayout title="Blog Management">
    <div class="blog-header">
        <div class="search-bar">
            <input type="text" placeholder="Buscar posts..." id="searchInput" />
        </div>
        <div class="header-actions">
            <span class="post-count">Total: {totalPosts} posts</span>
            <a href="/admin/blog/edit" class="btn-glow">Criar Novo Post</a>
        </div>
    </div>

    {Object.entries(postsByLanguage).map(([langCode, langData]) => (
        <div class="language-section" data-lang={langCode}>
            <div class="language-header">
                <span class="flag">{langData.flag}</span>
                <h3>{langData.name}</h3>
                <span class="count">({langData.posts.length} posts)</span>
            </div>
            
            {langData.posts.length > 0 ? (
                <div class="cyber-card blog-list">
                    <table>
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Categoria</th>
                                <th>Status</th>
                                <th>Data</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            {langData.posts.map(post => (
                                <tr data-title={post.title.toLowerCase()} data-category={post.category.toLowerCase()}>
                                    <td class="primary">{post.title}</td>
                                    <td><span class="category">{post.category}</span></td>
                                    <td>
                                        <span class={`status ${post.status}`}>
                                            {post.status === 'published' ? 'Publicado' : 'Rascunho'}
                                        </span>
                                    </td>
                                    <td>{new Date(post.date).toLocaleDateString('pt-BR')}</td>
                                    <td>
                                        <div class="actions">
                                            <a href={`/admin/blog/edit?slug=${post.slug}&lang=${post.lang}`} title="Editar" style="text-decoration:none;">✏️</a>
                                            <button title="Excluir" class="delete" data-slug={post.slug} data-lang={post.lang}>🗑️</button>
                                        </div>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            ) : (
                <div class="empty-state">
                    <p>Nenhum post encontrado em {langData.name}</p>
                </div>
            )}
        </div>
    ))}

    {totalPosts === 0 && (
        <div class="empty-state">
            <p>Nenhum post encontrado. Crie seu primeiro post!</p>
        </div>
    )}
</AdminLayout>

<script>
    // Busca em tempo real
    const searchInput = document.getElementById('searchInput');
    
    searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('tbody tr');
        
        rows.forEach(row => {
            const title = row.getAttribute('data-title');
            const category = row.getAttribute('data-category');
            
            if (title.includes(query) || category.includes(query)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
        
        // Mostrar/esconder seções vazias
        const sections = document.querySelectorAll('.language-section');
        sections.forEach(section => {
            const visibleRows = section.querySelectorAll('tbody tr:not([style*="display: none"])');
            const sectionHeader = section.querySelector('.language-header');
            
            if (visibleRows.length === 0 && query) {
                section.style.display = 'none';
            } else {
                section.style.display = '';
            }
        });
    });

    // Excluir post
    document.querySelectorAll('.delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            const slug = e.target.getAttribute('data-slug');
            const lang = e.target.getAttribute('data-lang');
            
            if (confirm(`Tem certeza que deseja excluir o post "${slug}"?`)) {
                try {
                    const response = await fetch('/api/admin/blog/delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ slug, lang })
                    });
                    
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Erro ao excluir post');
                    }
                } catch (error) {
                    console.error('Erro:', error);
                    alert('Erro ao excluir post');
                }
            }
        });
    });
</script>

<style>
