---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Magic Replies IA" activeTab="magic">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-pink-500 to-rose-500 rounded-2xl flex items-center justify-center shadow-lg shadow-pink-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Magic Replies IA
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Crie e treine respostas inteligentes com IA para seus atendimentos.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/magic-replies/editor" class="px-6 py-3 bg-pink-600/20 hover:bg-pink-600/40 text-pink-400 rounded-lg border border-pink-500/30 transition-all">Editor de Fluxos</a>
      <a href="/admin/magic-replies/train" class="px-6 py-3 bg-rose-600/20 hover:bg-rose-600/40 text-rose-400 rounded-lg border border-rose-500/30 transition-all">Treinar IA</a>
      <a href="/admin/magic-replies/library" class="px-6 py-3 bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 rounded-lg border border-purple-500/30 transition-all">Biblioteca</a>
    </div>
  </div>
</AdminLayout>
