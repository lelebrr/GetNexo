---
import AdminLayout from '../../layouts/AdminLayout.astro';
import MagicRepliesManagement from '../../components/admin/MagicRepliesManagement.jsx';
---

<AdminLayout title="Magic Replies - Configuração">
  <div class="magic-replies-page">
    <div class="page-header">
      <h1>Magic Replies</h1>
      <p class="page-description">
        Configure respostas automáticas inteligentes baseadas em contexto e dados do ERP
      </p>
    </div>

    <MagicRepliesManagement client:load />
  </div>
</AdminLayout>

<style>
  .magic-replies-page {
    padding: var(--spacing-lg);
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }

  .page-header h1 {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-sm);
  }

  .page-description {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }
</style>