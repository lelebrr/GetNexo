---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Send, Tag, UserPlus, Server, Code, Filter, CheckCircle2 } from 'lucide-react';

const actions = [
  { id: 1, name: "Enviar WhatsApp API", icon: Send, type: "Communication", desc: "Dispara uma mensagem HSM ou texto livre via API Oficial." },
  { id: 2, name: "Adicionar/Remover Tag", icon: Tag, type: "CRM", desc: "Segmenta o lead automaticamente baseado no comportamento." },
  { id: 3, name: "Distribuir para Agente", icon: UserPlus, type: "Support", desc: "Usa lógica de Round Robin para distribuir conversas." },
  { id: 4, name: "Requisição HTTP (Webhook)", icon: Code, type: "Tech", desc: "Envia dados JSON para qualquer URL via POST/GET." },
  { id: 5, name: "Filtro de Condição IF/ELSE", icon: Filter, type: "Logic", desc: "Verifica variáveis antes de prosseguir no fluxo." },
  { id: 6, name: "Notificação Interna", icon: Server, type: "System", desc: "Alerta o administrador via Desktop ou Email." }
];
---

<AdminLayout title="Actions & Condições" activeTab="automations">
  <div class="space-y-8 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center">
          <CheckCircle2 className="w-8 h-8 text-purple-500 mr-3" />
          Ações & Condições
        </h1>
        <p class="text-gray-400 mt-1">Defina o que o sistema deve fazer quando um gatilho é disparado.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {actions.map((a) => (
        <div class="bg-gray-900/30 backdrop-blur-sm border border-gray-800 p-6 rounded-3xl hover:border-purple-500/30 transition-all flex space-x-6 items-start">
          <div class="p-4 bg-purple-500/10 rounded-2xl shrink-0">
            <a.icon className="w-8 h-8 text-purple-400" />
          </div>
          <div class="space-y-2">
            <div class="flex items-center space-x-3">
              <h3 class="text-lg font-bold text-white">{a.name}</h3>
              <span class="text-[9px] font-black uppercase text-purple-400/50 tracking-tighter border border-purple-400/20 px-1.5 py-0.5 rounded">{a.type}</span>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed">{a.desc}</p>
            <div class="pt-2">
              <button class="text-xs font-bold text-purple-400 hover:text-purple-300 transition-colors flex items-center">
                Explorar Documentação
                <Code className="w-3 h-3 ml-1" />
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner Informativo -->
    <div class="bg-gradient-to-r from-purple-600/10 to-transparent border-l-4 border-purple-500 p-6 rounded-r-2xl">
      <h4 class="text-sm font-bold text-white mb-1">Dica de Power User</h4>
      <p class="text-sm text-gray-400">Você pode encadear múltiplas ações em um único gatilho para criar fluxos complexos de onboarding e vendas.</p>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.6s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
