---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Zap, Link as LinkIcon, ShieldCheck, Copy, ExternalLink, RefreshCw } from 'lucide-react';
---

<AdminLayout title="Integração com n8n" activeTab="automations">
  <div class="max-w-4xl mx-auto space-y-10 animate-fade-in py-4"
       x-data="{ 
         connected: true,
         webhook: 'https://n8n.getnexo.com.br/webhook/a582-4f11-92b1',
         copied: false,
         copy() {
           navigator.clipboard.writeText(this.webhook);
           this.copied = true;
           setTimeout(() => { this.copied = false }, 2000);
         }
       }">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-orange-500/10 rounded-2xl flex items-center justify-center text-orange-500 border border-orange-500/20 shadow-xl shadow-orange-500/10">
          <Zap className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Workflow n8n</h1>
          <p class="text-sm text-gray-500">Conecte o Nexus ao seu servidor n8n para automações complexas sem limites.</p>
        </div>
      </div>
      <div class="flex items-center space-x-3">
         <template x-if="connected">
            <div class="flex items-center space-x-2 px-4 py-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full">
               <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
               <span class="text-[10px] font-black text-emerald-500 uppercase tracking-widest">Servidor Online</span>
            </div>
         </template>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-8">
       <!-- Webhook Setup -->
       <div class="bg-gray-900/40 border border-gray-800 p-10 rounded-[2.5rem] space-y-8">
          <div class="flex items-center space-x-3">
             <LinkIcon className="w-5 h-5 text-orange-400" />
             <h3 class="text-sm font-bold text-white uppercase tracking-tight">Endpoint de Recebimento</h3>
          </div>
          
          <div class="space-y-4">
             <p class="text-xs text-gray-500 leading-relaxed font-medium">Use este URL no seu nó de Webhook do n8n para receber eventos do WhatsApp, Vendas e Leads em tempo real.</p>
             <div class="flex items-center space-x-2">
                <input type="text" readonly :value="webhook" class="flex-1 bg-black/60 border border-gray-800 rounded-2xl px-6 py-4 text-sm font-mono text-orange-400 outline-none" />
                <button @click="copy()" class="p-4 bg-gray-800 hover:bg-orange-600 hover:text-white rounded-2xl transition-all text-gray-400 relative">
                   <Copy x-show="!copied" className="w-5 h-5" />
                   <span x-show="copied" class="text-[10px] font-black uppercase">Copiado!</span>
                </button>
             </div>
          </div>
       </div>

       <!-- Security & Auth -->
       <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-gray-900/20 border border-gray-800 p-8 rounded-[2.5rem] space-y-6">
             <div class="flex items-center space-x-3 text-cyan-400">
                <ShieldCheck className="w-5 h-5" />
                <h3 class="text-[10px] font-black uppercase tracking-widest">API Key de Acesso</h3>
             </div>
             <div class="space-y-4">
                <div class="w-full h-12 bg-black/40 border border-gray-800 rounded-xl flex items-center px-4 justify-between">
                   <span class="text-xs font-mono text-gray-600">••••••••••••••••••••••••</span>
                   <RefreshCw className="w-4 h-4 text-gray-500 hover:text-white cursor-pointer transition-colors" />
                </div>
                <p class="text-[10px] text-gray-600 font-medium italic">Necessário para que o n8n envie mensagens de volta para o Nexus.</p>
             </div>
          </div>

          <div class="bg-orange-600/10 border border-orange-500/20 p-8 rounded-[2.5rem] flex flex-col justify-between group cursor-pointer hover:bg-orange-600/20 transition-all">
             <div class="space-y-2">
                <h4 class="text-lg font-black text-white italic">Precisa de Ajuda?</h4>
                <p class="text-xs text-gray-500 font-medium">Baixe nossos templates prontos de fluxos (JSON) para importar direto no seu n8n.</p>
             </div>
             <div class="flex items-center text-[10px] font-black text-orange-500 uppercase tracking-widest pt-6">
                <span>Acessar Documentação</span>
                <ExternalLink className="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" />
             </div>
          </div>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
