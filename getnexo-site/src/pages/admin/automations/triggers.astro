---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Zap, Clock, Smartphone, UserCheck, ShoppingBag, Globe, Plus } from 'lucide-react';

const triggers = [
  { id: 1, name: "Novo Lead via Web", icon: Globe, status: "active", desc: "Dispara quando um visitante preenche o formulário de contato." },
  { id: 2, name: "Mensagem Recebida", icon: Smartphone, status: "active", desc: "Dispara ao receber qualquer mensagem no WhatsApp ou Instagram." },
  { id: 3, name: "Carrinho Abandonado", icon: ShoppingBag, status: "inactive", desc: "Dispara 1h após o abandono do carrinho na loja." },
  { id: 4, name: "Ticket Sendo Atendido", icon: UserCheck, status: "active", desc: "Dispara quando um agente humano assume a conversa." },
  { id: 5, name: "Inatividade de Ticket", icon: Clock, status: "active", desc: "Dispara se o cliente não responder por mais de 30 minutos." },
  { id: 6, name: "Agendamento Efetuado", icon: Clock, status: "inactive", desc: "Dispara ao confirmar um horário no calendário IA." },
];
---

<AdminLayout title="Triggers por Evento" activeTab="automations">
  <div class="space-y-8 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center">
          <Zap className="w-8 h-8 text-yellow-500 mr-3" />
          Gatilhos (Triggers)
        </h1>
        <p class="text-gray-400 mt-1">Gerencie os eventos que iniciam suas automações.</p>
      </div>
      <a href="/admin/automations/new" class="px-6 py-3 bg-yellow-500 text-black font-bold rounded-xl flex items-center space-x-2 hover:bg-yellow-400 transition-all shadow-lg shadow-yellow-500/10">
        <Plus className="w-5 h-5" />
        <span>Novo Gatilho</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {triggers.map((t) => (
        <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-2xl hover:border-yellow-500/30 transition-all group">
          <div class="flex items-start justify-between mb-4">
            <div class="p-3 bg-gray-800 rounded-xl group-hover:bg-yellow-500/10 transition-colors">
              <t.icon className="w-6 h-6 text-yellow-500" />
            </div>
            <span class:list={[
              "text-[10px] uppercase font-bold px-2 py-1 rounded-md",
              t.status === 'active' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-red-500/10 text-red-500'
            ]}>
              {t.status === 'active' ? 'Ativado' : 'Inativo'}
            </span>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">{t.name}</h3>
          <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed mb-6">{t.desc}</p>
          <div class="flex items-center space-x-3">
            <button class="text-xs font-bold text-yellow-500 hover:underline">Configurar</button>
            <span class="text-gray-700">|</span>
            <button class="text-xs font-bold text-gray-500 hover:text-white transition-colors">Ver Log</button>
          </div>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.6s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
