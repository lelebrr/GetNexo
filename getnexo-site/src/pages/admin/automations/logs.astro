---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { History, CheckCircle2, XCircle, AlertCircle, Search, Filter, ArrowRight } from 'lucide-react';
---

<AdminLayout title="Log de Execuções" activeTab="automations">
  <div class="max-w-6xl mx-auto space-y-8 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-cyan-500/10 rounded-2xl flex items-center justify-center text-cyan-500 border border-cyan-500/20 shadow-xl shadow-cyan-500/10">
          <History className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Histórico de Fluxos</h1>
          <p class="text-sm text-gray-500 font-medium">Auditoria completa de cada gatilho disparado pelo sistema.</p>
        </div>
      </div>
    </div>

    <!-- Filtros -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 bg-gray-900/40 p-4 border border-gray-800 rounded-2xl">
      <div class="relative col-span-1 md:col-span-2">
        <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" />
        <input type="text" placeholder="Buscar por ID ou Nome do Fluxo..." class="w-full bg-black/60 border border-gray-800 rounded-xl py-2.5 pl-10 pr-4 text-sm text-white focus:border-cyan-500 outline-none" />
      </div>
      <button class="bg-gray-800 text-gray-400 text-[10px] font-black uppercase tracking-widest py-2 rounded-xl border border-gray-700 hover:text-white">Status: Todos</button>
      <button class="bg-gray-800 text-gray-400 text-[10px] font-black uppercase tracking-widest py-2 rounded-xl border border-gray-700 hover:text-white">Período: 24h</button>
    </div>

    <!-- Tabela de Logs -->
    <div class="bg-gray-900/20 border border-gray-800 rounded-[2.5rem] overflow-hidden shadow-2xl" 
         x-data="{ 
           logs: [
             { id: 'LOG-8821', flow: 'Recuperação de Carrinho', target: 'Fabio Henrique', status: 'Sucesso', time: 'Há 5 min' },
             { id: 'LOG-8820', flow: 'Boas-vindas', target: 'Gisele B.', status: 'Sucesso', time: 'Há 12 min' },
             { id: 'LOG-8819', flow: 'Upsell Pós-Compra', target: 'Marcos G.', status: 'Falha', error: 'WhatsApp Inativo', time: 'Há 45 min' },
             { id: 'LOG-8818', flow: 'Lembrete de Boleto', target: 'Juliana Mendes', status: 'Processando', time: 'Há 1h' },
             { id: 'LOG-8817', flow: 'Recuperação de Carrinho', target: 'Roberto Silva', status: 'Sucesso', time: 'Hoje, 09:12' }
           ]
         }">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-black/40 border-b border-gray-800">
             <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-500 tracking-widest">ID Log</th>
             <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-500 tracking-widest">Automação</th>
             <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-500 tracking-widest">Destinatário</th>
             <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-500 tracking-widest">Status</th>
             <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-500 tracking-widest text-right">Horário</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/50">
          <template x-for="log in logs" :key="log.id">
             <tr class="hover:bg-cyan-500/5 transition-colors group cursor-pointer">
                <td class="px-8 py-6">
                   <span class="text-xs font-mono font-bold text-gray-600 group-hover:text-cyan-400 transition-colors" x-text="log.id"></span>
                </td>
                <td class="px-8 py-6">
                   <p class="text-sm font-bold text-white uppercase tracking-tight" x-text="log.flow"></p>
                </td>
                <td class="px-8 py-6">
                   <p class="text-xs text-gray-400 font-medium" x-text="log.target"></p>
                </td>
                <td class="px-8 py-6">
                   <div class="flex items-center space-x-2">
                      <template x-if="log.status === 'Sucesso'">
                         <div class="flex items-center space-x-1.5 text-emerald-500">
                            <CheckCircle2 className="w-3.5 h-3.5" />
                            <span class="text-[9px] font-black uppercase tracking-widest">Executado</span>
                         </div>
                      </template>
                      <template x-if="log.status === 'Falha'">
                         <div class="flex items-center space-x-1.5 text-rose-500">
                            <XCircle className="w-3.5 h-3.5" />
                            <span class="text-[9px] font-black uppercase tracking-widest" x-text="'Erro: ' + log.error"></span>
                         </div>
                      </template>
                      <template x-if="log.status === 'Processando'">
                         <div class="flex items-center space-x-1.5 text-amber-500">
                            <div class="w-3.5 h-3.5 border-2 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div>
                            <span class="text-[9px] font-black uppercase tracking-widest">Na Fila</span>
                         </div>
                      </template>
                   </div>
                </td>
                <td class="px-8 py-6 text-right">
                   <div class="flex items-center justify-end space-x-4">
                      <span class="text-[10px] font-bold text-gray-600" x-text="log.time"></span>
                      <ArrowRight className="w-4 h-4 text-gray-800 group-hover:translate-x-1 group-hover:text-cyan-500 transition-all" />
                   </div>
                </td>
             </tr>
          </template>
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
