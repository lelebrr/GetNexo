---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Settings, Zap, Play, CheckCircle, ArrowRight, Save } from 'lucide-react';
---

<AdminLayout title="Criar Fluxo Novo" activeTab="automations">
  <div x-data="{ step: 1, flowName: '', trigger: '', action: '' }" class="max-w-4xl mx-auto space-y-8 py-8 animate-fade-in">
    <!-- Header Decorativo -->
    <div class="flex items-center space-x-4 mb-12">
      <div class="w-16 h-16 bg-gradient-to-br from-yellow-500 to-orange-600 rounded-2xl flex items-center justify-center shadow-lg shadow-yellow-500/20">
        <Play className="w-8 h-8 text-white" strokeWidth={2.5} />
      </div>
      <div>
        <h1 class="text-3xl font-bold text-white">Novo Fluxo de Automação</h1>
        <p class="text-gray-400">Configure regras automáticas para seus atendimentos.</p>
      </div>
    </div>

    <!-- Stepper Visual -->
    <div class="relative flex justify-between items-center mb-12">
      <div class="absolute inset-0 top-1/2 -translate-y-1/2 h-0.5 bg-gray-800 w-full z-0"></div>
      
      <template x-for="i in [1, 2, 3]">
        <div class="relative z-10 flex flex-col items-center">
          <div 
            :class="step >= i ? 'bg-yellow-500 text-black' : 'bg-gray-900 text-gray-500 border border-gray-800'"
            class="w-10 h-10 rounded-full flex items-center justify-center font-bold transition-all duration-500"
            x-text="step > i ? '✓' : i"
          ></div>
          <span class="text-[10px] uppercase tracking-widest mt-2 font-bold" :class="step >= i ? 'text-yellow-500' : 'text-gray-600'" x-text="i == 1 ? 'Setup' : (i == 2 ? 'Trigger' : 'Action')"></span>
        </div>
      </template>
    </div>

    <!-- Card Principal -->
    <div class="bg-gray-900/40 backdrop-blur-xl border border-gray-800 rounded-3xl p-8 shadow-2xl transition-all duration-300">
      
      <!-- Passo 1: Setup Inicial -->
      <div x-show="step === 1" x-transition.opacity.duration.300ms class="space-y-6">
        <div class="space-y-2">
          <label class="text-sm font-semibold text-gray-300 ml-1">Nome do Fluxo</label>
          <input 
            type="text" 
            x-model="flowName"
            placeholder="Ex: Alerta de Abandono de Carrinho" 
            class="w-full bg-black/50 border border-gray-800 focus:border-yellow-500 text-white px-6 py-4 rounded-2xl outline-none transition-all placeholder:text-gray-700"
          />
        </div>
        <div class="p-4 bg-yellow-500/5 border border-yellow-500/10 rounded-2xl flex items-start space-x-4">
          <div class="mt-1 translate-y-0.5"><Settings className="w-5 h-5 text-yellow-500" /></div>
          <p class="text-sm text-gray-400 leading-relaxed">
            Dê um nome claro para identificar esta automação no log. Você poderá alterar isso depois.
          </p>
        </div>
        <div class="pt-4 flex justify-end">
          <button 
            @click="if(flowName) step = 2"
            :disabled="!flowName"
            class="px-8 py-4 bg-yellow-500 hover:bg-yellow-400 disabled:opacity-50 disabled:hover:bg-yellow-500 text-black font-bold rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-yellow-500/20"
          >
            <span>Continuar</span>
            <ArrowRight className="w-5 h-5" />
          </button>
        </div>
      </div>

      <!-- Passo 2: Seleção de Gatilho -->
      <div x-show="step === 2" x-transition.opacity.duration.300ms class="space-y-6">
        <h3 class="text-xl font-bold text-white mb-4">Escolha o Gatilho (Trigger)</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <template x-for="t in [
            { id: 'msg', title: 'Mensagem Recebida', desc: 'Quando o cliente envia qualquer mensagem.' },
            { id: 'tag', title: 'Tag Adicionada', desc: 'Quando uma tag específica é associada.' },
            { id: 'cart', title: 'Carrinho Abandonado', desc: 'Após 2h sem finalização de compra.' },
            { id: 'close', title: 'Atendimento Encerrado', desc: 'Após o fechamento do ticket.' }
          ]">
            <button 
              @click="trigger = t.id"
              :class="trigger === t.id ? 'border-yellow-500 bg-yellow-500/10' : 'border-gray-800 bg-black/20 hover:border-gray-700'"
              class="text-left p-6 rounded-2xl border transition-all group"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold" :class="trigger === t.id ? 'text-yellow-500' : 'text-white'" x-text="t.title"></span>
                <div :class="trigger === t.id ? 'bg-yellow-500 visible' : 'bg-gray-800 invisible group-hover:visible'" class="w-4 h-4 rounded-full flex items-center justify-center">
                  <span class="text-[8px] text-black" x-show="trigger === t.id">✓</span>
                </div>
              </div>
              <p class="text-sm text-gray-500" x-text="t.desc"></p>
            </button>
          </template>
        </div>
        <div class="pt-6 flex justify-between">
          <button @click="step = 1" class="px-8 py-4 text-gray-400 hover:text-white transition-colors">Voltar</button>
          <button 
            @click="if(trigger) step = 3"
            :disabled="!trigger"
            class="px-8 py-4 bg-yellow-500 hover:bg-yellow-400 disabled:opacity-50 text-black font-bold rounded-2xl flex items-center space-x-2 transition-all"
          >
            <span>Continuar</span>
            <ArrowRight className="w-5 h-5" />
          </button>
        </div>
      </div>

      <!-- Passo 3: Definição de Ação -->
      <div x-show="step === 3" x-transition.opacity.duration.300ms class="space-y-6">
        <h3 class="text-xl font-bold text-white mb-4">O que deve acontecer? (Action)</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <template x-for="a in [
            { id: 'wa', title: 'Enviar WhatsApp', desc: 'Envia template ou mensagem direta.' },
            { id: 'tag', title: 'Atribuir Tag', desc: 'Organiza automaticamente o lead.' },
            { id: 'agent', title: 'Transf. para Agente', desc: 'Move para a fila humana.' },
            { id: 'webhook', title: 'Disparar Webhook', desc: 'Integra com sistemas externos.' }
          ]">
            <button 
              @click="action = a.id"
              :class="action === a.id ? 'border-yellow-500 bg-yellow-500/10' : 'border-gray-800 bg-black/20 hover:border-gray-700'"
              class="text-left p-6 rounded-2xl border transition-all group"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="font-bold" :class="action === a.id ? 'text-yellow-500' : 'text-white'" x-text="a.title"></span>
                <div :class="action === a.id ? 'bg-yellow-500' : 'bg-gray-800'" class="w-4 h-4 rounded-full flex items-center justify-center">
                  <span class="text-[8px] text-black" x-show="action === a.id">✓</span>
                </div>
              </div>
              <p class="text-sm text-gray-500" x-text="a.desc"></p>
            </button>
          </template>
        </div>
        <div class="pt-6 flex justify-between">
          <button @click="step = 2" class="px-8 py-4 text-gray-400 hover:text-white transition-colors">Voltar</button>
          <button 
            @click="if(action) { alert('Fluxo salvo com sucesso!'); window.location.href='/admin/automations/list'; }"
            :disabled="!action"
            class="px-8 py-4 bg-emerald-500 hover:bg-emerald-400 disabled:opacity-50 text-black font-bold rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-emerald-500/20"
          >
            <span>Finalizar e Salvar</span>
            <Save className="w-5 h-5" />
          </button>
        </div>
      </div>

    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.6s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
