---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Fidelidade & Retenção" activeTab="fidelidade">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-red-500 to-pink-500 rounded-2xl flex items-center justify-center shadow-lg shadow-red-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Fidelidade & Retenção
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Sistema de pontos, recompensas, aniversariantes e notificações.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/loyalty/points" class="px-6 py-3 bg-red-600/20 hover:bg-red-600/40 text-red-400 rounded-lg border border-red-500/30 transition-all">Sistema de Pontos</a>
      <a href="/admin/loyalty/rewards" class="px-6 py-3 bg-pink-600/20 hover:bg-pink-600/40 text-pink-400 rounded-lg border border-pink-500/30 transition-all">Recompensas</a>
      <a href="/admin/loyalty/top" class="px-6 py-3 bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 rounded-lg border border-purple-500/30 transition-all">Top 100 Clientes</a>
    </div>
  </div>
</AdminLayout>
