---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="PIX & Pagamentos" activeTab="pagamentos">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center shadow-lg shadow-green-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      PIX & Pagamentos
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Gerencie chaves PIX, recebimentos, reembolsos e gateways de pagamento.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/payments/keys" class="px-6 py-3 bg-green-600/20 hover:bg-green-600/40 text-green-400 rounded-lg border border-green-500/30 transition-all">Chaves PIX</a>
      <a href="/admin/payments/today" class="px-6 py-3 bg-emerald-600/20 hover:bg-emerald-600/40 text-emerald-400 rounded-lg border border-emerald-500/30 transition-all">Recebimentos Hoje</a>
      <a href="/admin/payments/gateways" class="px-6 py-3 bg-cyan-600/20 hover:bg-cyan-600/40 text-cyan-400 rounded-lg border border-cyan-500/30 transition-all">Gateways</a>
    </div>
  </div>
</AdminLayout>
