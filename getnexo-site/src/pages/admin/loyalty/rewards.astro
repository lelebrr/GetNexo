```
---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Gift, Plus, ShoppingBag, CreditCard, ExternalLink, MoreVertical } from 'lucide-react';

const rewards = [
  { id: 1, name: "Cupom R$ 50 OFF", cost: "500 Pontos", type: "Voucher", stock: "Ilimitado", active: true },
  { id: 2, name: "Brinde: Chaveiro Fusion", cost: "250 Pontos", type: "Produto", stock: "42 un", active: true },
  { id: 3, name: "Frete Grátis Vitalício", cost: "5.000 Pontos", type: "Status", stock: "4 un restantes", active: false },
];
---

<AdminLayout title="Catálogo de Recompensas" activeTab="loyalty">
  <div class="space-y-10 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Vitrine de Prêmios</h1>
        <p class="text-sm text-gray-500 mt-1">Gerencie os benefícios que seus clientes podem resgatar com pontos.</p>
      </div>
      <button class="bg-indigo-600 hover:bg-indigo-500 text-white font-black px-6 py-3 rounded-2xl flex items-center space-x-3 transition-all shadow-xl shadow-indigo-500/10 uppercase text-[10px] tracking-widest">
        <Plus className="w-5 h-5" />
        <span>Novo Prêmio</span>
      </button>
    </div>

    <!-- Grid de Recompensas -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
       {rewards.map(reward => (
         <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] p-8 hover:border-indigo-500/20 transition-all group relative overflow-hidden flex flex-col justify-between h-[300px]">
            <div class="absolute right-0 top-0 p-6">
               <div class:list={["w-2 h-2 rounded-full", reward.active ? 'bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]' : 'bg-gray-700']}></div>
            </div>
            
            <div>
               <div class="w-12 h-12 bg-black/40 rounded-2xl flex items-center justify-center text-indigo-400 mb-6 group-hover:scale-110 transition-transform">
                  {reward.type === 'Voucher' ? <CreditCard className="w-6 h-6" /> : <ShoppingBag className="w-6 h-6" />}
               </div>
               <h3 class="text-xl font-bold text-white uppercase tracking-tight leading-tight">{reward.name}</h3>
               <p class="text-[10px] text-gray-500 mt-2 font-black uppercase tracking-widest">{reward.type} • Estoque: {reward.stock}</p>
            </div>

            <div class="flex items-center justify-between pt-8 mt-auto">
               <div class="flex flex-col">
                  <span class="text-[8px] font-black text-gray-600 uppercase tracking-widest mb-1">Custo de Resgate</span>
                  <span class="text-sm font-black text-yellow-500 font-mono">{reward.cost}</span>
               </div>
               <div class="flex items-center space-x-2">
                  <button class="p-3 bg-gray-800/50 rounded-xl text-gray-400 hover:text-white transition-all"><MoreVertical className="w-4 h-4" /></button>
               </div>
            </div>
         </div>
       ))}
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
```
