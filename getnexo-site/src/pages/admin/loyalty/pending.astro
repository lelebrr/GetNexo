---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Timer, Check, X, Eye, User, ShoppingBag, AlertCircle } from 'lucide-react';

const pendingRedemptions = [
  { id: 'RES-99', user: 'Roberto Silva', reward: 'Brinde: Chaveiro Fusion', points: '250', time: 'Há 12 min', email: 'roberto@email.com' },
  { id: 'RES-98', user: 'Maria Oliveira', reward: 'Frete Grátis Vitalício', points: '5.000', time: 'Há 45 min', email: 'maria.o@email.com' },
];
---

<AdminLayout title="Resgates Pendentes" activeTab="fidelidade">
  <div class="max-w-6xl mx-auto space-y-8 animate-fade-in py-4"
       x-data="{ 
         pending: [
           { id: 'RES-99', user: 'Roberto Silva', reward: 'Brinde: Chaveiro Fusion', points: '250', time: 'Há 12 min', email: 'roberto@email.com' },
           { id: 'RES-98', user: 'Maria Oliveira', reward: 'Frete Grátis Vitalício', points: '5.000', time: 'Há 45 min', email: 'maria.o@email.com' }
         ],
         action(id) {
           this.pending = this.pending.filter(p => p.id !== id);
         }
       }">
    
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Aprovações de Resgate</h1>
        <p class="text-sm text-gray-500 font-medium">Verifique e valide os pedidos de resgate de prêmios físicos ou status.</p>
      </div>
      <div class="px-4 py-2 bg-amber-500/10 border border-amber-500/20 rounded-xl">
         <span class="text-[10px] font-black text-amber-500 uppercase tracking-widest" x-text="pending.length + ' Pendentes'"></span>
      </div>
    </div>

    <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <div class="p-8 border-b border-gray-800 bg-black/20 flex items-center justify-between">
          <div class="flex items-center space-x-3">
             <Timer className="w-5 h-5 text-gray-500" />
             <h3 class="text-xs font-black uppercase text-gray-400 tracking-widest">Fila de Resgate</h3>
          </div>
       </div>

       <div class="divide-y divide-gray-800/50" x-show="pending.length > 0">
          <template x-for="item in pending" :key="item.id">
             <div class="p-8 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                <div class="flex items-center space-x-8">
                   <div class="w-14 h-14 bg-gray-800 rounded-2xl flex items-center justify-center text-gray-600 group-hover:bg-amber-500/10 group-hover:text-amber-500 transition-all">
                      <ShoppingBag className="w-7 h-7" />
                   </div>
                   <div>
                      <h4 class="text-sm font-bold text-white uppercase tracking-tight" x-text="item.reward"></h4>
                      <p class="text-[10px] text-gray-600 font-medium" x-text="item.user + ' (' + item.email + ')'"></p>
                   </div>
                </div>

                <div class="flex items-center space-x-12">
                   <div class="text-center">
                      <p class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Custo</p>
                      <p class="text-sm font-mono font-bold text-yellow-500" x-text="item.points + ' pts'"></p>
                   </div>
                   <div class="text-center">
                      <p class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Solicitado</p>
                      <p class="text-[10px] font-bold text-gray-400" x-text="item.time"></p>
                   </div>
                </div>

                <div class="flex items-center space-x-3">
                   <button class="p-3 bg-gray-800 hover:bg-white/10 text-gray-500 hover:text-white rounded-xl transition-all"><Eye className="w-4 h-4" /></button>
                   <div class="flex items-center space-x-1">
                      <button @click="action(item.id)" class="p-3 bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500 hover:text-white rounded-xl transition-all"><Check className="w-5 h-5" /></button>
                      <button @click="action(item.id)" class="p-3 bg-rose-500/10 text-rose-500 hover:bg-rose-500 hover:text-white rounded-xl transition-all"><X className="w-5 h-5" /></button>
                   </div>
                </div>
             </div>
          </template>
       </div>

       <div x-show="pending.length === 0" class="p-20 text-center space-y-4">
          <div class="w-16 h-16 bg-emerald-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
             <Check className="w-8 h-8 text-emerald-500" />
          </div>
          <h4 class="text-lg font-bold text-white uppercase italic tracking-tighter">Nenhum Pendente</h4>
          <p class="text-xs text-gray-600">Todos os resgates foram processados com sucesso.</p>
       </div>
    </div>

    <!-- Alerta -->
    <div class="p-6 bg-indigo-500/5 border border-indigo-500/20 rounded-3xl flex items-start space-x-4">
       <AlertCircle className="w-5 h-5 text-indigo-500 shrink-0" />
       <div class="space-y-1">
          <p class="text-xs font-bold text-indigo-500 uppercase tracking-tight">Processamento Logístico</p>
          <p class="text-[10px] text-gray-500 leading-relaxed font-medium font-medium">Ao aprovar um brinde físico, o pedido será enviado automaticamente para sua integração de logística (Melhor Envio/Bling).</p>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
