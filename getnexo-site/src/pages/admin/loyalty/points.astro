---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Coins, Settings, TrendingUp, Users, ArrowUpRight, ShieldCheck } from 'lucide-react';

const pointRules = [
  { id: 1, action: "Compra Realizada", ratio: "R$ 1.00 = 1 Ponto", status: "Ativo" },
  { id: 2, action: "Cadastro Completo", ratio: "Ganhe 50 Pontos", status: "Ativo" },
  { id: 3, action: "Primeira Compra", ratio: "Ganhe 100 Pontos", status: "Pausado" },
];
---

<AdminLayout title="Configuração de Pontos" activeTab="fidelidade">
  <div class="space-y-10 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-16 h-16 bg-yellow-500/10 rounded-3xl flex items-center justify-center border border-yellow-500/20 shadow-2xl shadow-yellow-500/10">
          <Coins className="w-8 h-8 text-yellow-500" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Economia de Fidelidade</h1>
          <p class="text-sm text-gray-400">Defina como seus clientes ganham e acumulam pontos na sua loja.</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
       <!-- Regras de Ganho -->
       <div class="lg:col-span-2 space-y-6">
          <h3 class="text-xs font-black text-gray-600 uppercase tracking-widest ml-1">Regras de Acúmulo Ativas</h3>
          <div class="grid grid-cols-1 gap-4">
             {pointRules.map(rule => (
                <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] flex items-center justify-between hover:border-yellow-500/20 transition-all group">
                   <div class="flex items-center space-x-6">
                      <div class="w-12 h-12 bg-black/40 rounded-2xl flex items-center justify-center text-gray-500 group-hover:text-yellow-500 transition-colors">
                         <Settings className="w-5 h-5" />
                      </div>
                      <div>
                         <h4 class="text-sm font-bold text-white uppercase tracking-tight">{rule.action}</h4>
                         <p class="text-xs text-gray-500 mt-1 font-mono">{rule.ratio}</p>
                      </div>
                   </div>
                   <div class="flex items-center space-x-4">
                      <span class:list={["text-[8px] font-black uppercase px-2 py-1 rounded", rule.status === 'Ativo' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-gray-800 text-gray-500']}>{rule.status}</span>
                      <button class="p-2 text-gray-700 hover:text-white transition-colors"><ArrowUpRight className="w-4 h-4" /></button>
                   </div>
                </div>
             ))}
          </div>
          
          <button class="w-full py-6 border border-dashed border-gray-800 rounded-[2rem] text-[10px] font-black uppercase text-gray-600 hover:text-white hover:border-gray-600 transition-all">
             + Adicionar Novo Gatilho de Pontuação
          </button>
       </div>

       <!-- Summary Sidebar -->
       <div class="space-y-6">
          <div class="p-8 bg-gradient-to-br from-yellow-900/20 to-transparent border border-yellow-500/20 rounded-[2.5rem] space-y-6">
             <TrendingUp className="w-6 h-6 text-yellow-500" />
             <div>
                <p class="text-[10px] font-black uppercase text-gray-500 tracking-widest">Pontos em Circulação</p>
                <p class="text-4xl font-black text-white mt-1">1.250.400</p>
             </div>
             <div class="space-y-2 pt-4 border-t border-white/5">
                <div class="flex justify-between text-[10px] font-bold text-gray-400">
                   <span>Taxa de Resgate</span>
                   <span class="text-yellow-500">22%</span>
                </div>
                <div class="w-full h-1 bg-gray-800 rounded-full overflow-hidden">
                   <div class="w-[22%] h-full bg-yellow-500"></div>
                </div>
             </div>
          </div>

          <div class="p-6 bg-black/40 border border-gray-800 rounded-3xl flex items-center space-x-4">
             <ShieldCheck className="w-5 h-5 text-emerald-500" />
             <p class="text-[9px] text-gray-500 leading-relaxed font-medium">Prevenção de fraude ativa: Limite de acúmulo por CPF definido em **5.000 pts/mês**.</p>
          </div>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
