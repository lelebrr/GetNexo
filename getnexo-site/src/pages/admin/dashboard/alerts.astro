---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Alertas Pendentes" activeTab="dashboard">
  <div x-data="alertsDashboard" class="space-y-6 animate-fade-in">
    <div class="flex justify-between items-center">
      <h1 class="text-3xl font-bold text-white">Centro de Alertas</h1>
      <button @click="resolveAll()" class="text-sm text-gray-400 hover:text-white transition-colors">Marcar todos como lidos</button>
    </div>

    <!-- Alert List -->
    <div class="grid gap-4">

      <template x-for="alert in alerts" :key="alert.id">
        <div class="p-5 rounded-xl flex flex-col md:flex-row items-start md:items-center justify-between group transition-all border"
             :class="{
                'bg-red-900/10 border-red-900/40 hover:border-red-500/40': alert.type === 'critical',
                'bg-amber-900/10 border-amber-900/40 hover:border-amber-500/40': alert.type === 'warning',
                'bg-blue-900/10 border-blue-900/40 hover:border-blue-500/40': alert.type === 'info'
             }">
          <div class="flex items-start">
            <div class="p-3 rounded-lg mr-4"
                 :class="{
                    'bg-red-500/20 text-red-500': alert.type === 'critical',
                    'bg-amber-500/20 text-amber-500': alert.type === 'warning',
                    'bg-blue-500/20 text-blue-500': alert.type === 'info'
                 }">
               <!-- Icons -->
               <svg x-show="alert.type === 'critical'" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
               <svg x-show="alert.type === 'warning'" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
               <svg x-show="alert.type === 'info'" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <div>
              <h3 class="font-bold mb-1"
                  :class="{
                    'text-red-400': alert.type === 'critical',
                    'text-amber-400': alert.type === 'warning',
                    'text-blue-400': alert.type === 'info'
                  }" x-text="alert.title"></h3>
              <p class="text-gray-300 text-sm" x-text="alert.message"></p>
              <p class="text-xs mt-2 font-mono opacity-70" 
                 :class="{
                    'text-red-500': alert.type === 'critical',
                    'text-amber-500': alert.type === 'warning',
                    'text-blue-500': alert.type === 'info'
                 }">
                 <span x-text="alert.details"></span>
                 <span x-show="alert.details && alert.created_at"> • </span>
                 <span x-text="formatTimeAgo(alert.created_at)"></span>
              </p>
            </div>
          </div>
          
          <div class="mt-4 md:mt-0 flex space-x-3 items-center">
             <!-- Product Actions -->
             <button x-show="alert.link" 
                     @click="window.location.href = alert.link"
                     class="text-gray-400 hover:text-white text-sm underline">
               Ver Produto
             </button>

             <!-- Security/General Actions -->
            <div x-show="!alert.link" class="flex space-x-3">
                <button @click="resolve(alert.id)" 
                        class="px-4 py-2 text-white text-sm rounded-lg font-medium transition-colors"
                        :class="{
                            'bg-red-600 hover:bg-red-700': alert.type === 'critical',
                            'bg-blue-600 hover:bg-blue-700': alert.type === 'info',
                            'bg-amber-600 hover:bg-amber-700': alert.type === 'warning'
                        }">
                    Resolver
                </button>
                <button @click="resolve(alert.id)" class="px-4 py-2 bg-transparent border border-gray-700 text-gray-400 hover:text-white text-sm rounded-lg transition-colors">Ignorar</button>
            </div>
          </div>
        </div>
      </template>
      
      <div x-show="alerts.length === 0 && !loading" class="text-center p-8 text-gray-500">
        Nenhum alerta pendente. Você está seguro!
      </div>

    </div>
  </div>

<script nonce={Astro.locals.nonce}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('alertsDashboard', () => ({
      alerts: [],
      loading: true,

      init() {
        this.fetchAlerts();
      },
      
      formatTimeAgo(dateString) {
          if(!dateString) return '';
          const date = new Date(dateString);
          const now = new Date();
          const diffMs = now - date;
          const diffMins = Math.floor(diffMs / 60000);
          
          if (diffMins < 1) return 'Agora';
          if (diffMins < 60) return `há ${diffMins} min`;
          const diffHours = Math.floor(diffMins / 60);
          if (diffHours < 24) return `há ${diffHours} h`;
          return date.toLocaleDateString();
      },

      async fetchAlerts() {
        try {
          const res = await fetch('/api/alert');
          const data = await res.json();
          this.alerts = data.alerts || [];
        } catch (e) {
          console.error('Erro ao buscar alertas:', e);
        } finally {
            this.loading = false;
        }
      },

      async resolve(id) {
          try {
              // Ensure we are sending the correct ID format
              const res = await fetch(`/api/alert?action=resolve&id=${id}`, { method: 'POST' });
              if (res.ok) {
                  this.alerts = this.alerts.filter(a => a.id !== id);
              }
          } catch (e) {
              console.error('Erro ao resolver:', e);
          }
      },

      async resolveAll() {
          if (!confirm('Marcar tudo como resolvido?')) return;
          try {
              const res = await fetch('/api/alert?action=resolve-all', { method: 'POST' });
              if (res.ok) {
                  this.fetchAlerts();
              }
          } catch(e) {
               console.error('Erro ao resolver tudo:', e);
          }
      }
    }));
  });
</script>
</AdminLayout>

