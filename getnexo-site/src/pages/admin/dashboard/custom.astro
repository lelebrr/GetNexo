---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gráficos Customizados" activeTab="dashboard">
  <div class="space-y-8">
     <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
        <div>
          <h1 class="text-3xl font-bold text-white">Meu Dashboard</h1>
          <p class="text-gray-400">Personalize a visualização dos seus dados</p>
        </div>
        <div class="flex space-x-3 mt-4 md:mt-0">
           <button class="flex items-center space-x-2 px-4 py-2 bg-gray-800 hover:bg-gray-700 text-white rounded-lg transition-colors">
              <span>+ Adicionar Widget</span>
           </button>
           <button class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg shadow-lg shadow-indigo-600/20 font-medium transition-all">
              Salvar Layout
           </button>
        </div>
     </div>

     <!-- Grid Layout (Simulated Drag & Drop) -->
     <div class="grid grid-cols-1 md:grid-cols-3 gap-6 min-h-[500px]">
        
        <!-- Big Area (2 cols) -->
        <div class="md:col-span-2 bg-gray-900/30 border-2 border-dashed border-gray-700 rounded-xl flex items-center justify-center p-8 group hover:border-indigo-500/50 hover:bg-gray-900/50 transition-all cursor-move">
           <div class="text-center">
              <div class="w-16 h-16 bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-500 group-hover:text-indigo-400 transition-colors">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" /></svg>
              </div>
              <h3 class="text-white font-semibold">Gráfico Principal</h3>
              <p class="text-sm text-gray-500">Arraste um gráfico para cá</p>
           </div>
        </div>

        <!-- Small Area 1 -->
        <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl">
           <div class="flex justify-between items-center mb-4">
              <h3 class="text-gray-300 font-medium">Ticket Médio</h3>
              <button class="text-gray-600 hover:text-white">...</button>
           </div>
           <div class="text-3xl font-bold text-white mb-2">R$ 180</div>
           <div class="h-32 bg-gradient-to-t from-emerald-500/20 to-transparent rounded-lg border-b-2 border-emerald-500 relative">
              <!-- Fake little chart line -->
              <svg class="absolute bottom-0 left-0 w-full h-full text-emerald-500" preserveAspectRatio="none" viewBox="0 0 100 100">
                 <path d="M0 100 L20 80 L40 60 L60 85 L80 40 L100 20 V100 H0 Z" fill="currentColor" opacity="0.2" />
                 <path d="M0 100 L20 80 L40 60 L60 85 L80 40 L100 20" stroke="currentColor" stroke-width="2" fill="none"/>
              </svg>
           </div>
        </div>

        <!-- Small Area 2 -->
        <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-gray-300 font-medium">Visitantes Online</h3>
              <button class="text-gray-600 hover:text-white">...</button>
           </div>
           <div class="text-center py-8">
              <span class="text-5xl font-black text-white">42</span>
              <p class="text-emerald-400 text-sm mt-2 animate-pulse">● Ao vivo agora</p>
           </div>
        </div>

        <!-- Medium Area (2 cols) -->
        <div class="md:col-span-2 bg-gray-900/50 border border-gray-800 p-6 rounded-xl">
           <h3 class="text-gray-300 font-medium mb-4">Mapa de Calor (Cliques)</h3>
           <div class="w-full h-48 bg-gray-800/50 rounded-lg flex items-center justify-center relative overflow-hidden">
               <!-- Heatmap Simulation -->
               <div class="absolute top-1/4 left-1/4 w-24 h-24 bg-red-500/30 blur-xl rounded-full"></div>
               <div class="absolute bottom-1/3 right-1/3 w-32 h-32 bg-orange-500/20 blur-xl rounded-full"></div>
               <div class="absolute top-1/2 left-1/2 w-16 h-16 bg-yellow-500/30 blur-xl rounded-full"></div>
               <span class="relative z-10 text-gray-500 text-xs">Visualização do Site</span>
           </div>
        </div>

     </div>
  </div>
</AdminLayout>
