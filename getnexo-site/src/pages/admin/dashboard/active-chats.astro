---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Conversas Abertas Hoje" activeTab="dashboard">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-cyan-500 to-blue-500 rounded-2xl flex items-center justify-center shadow-lg shadow-cyan-500/30 animate-pulse">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Conversas Abertas Hoje
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Monitore as conversas ativas no momento.
    </p>
  </div>
</AdminLayout>
