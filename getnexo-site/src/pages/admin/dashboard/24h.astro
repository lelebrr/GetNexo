---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Visão Geral 24h" activeTab="dashboard">
  <div x-data="dashboard24h" class="space-y-8 animate-fade-in">
    <!-- Header com Date Picker simulado -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white">Visão Geral 24h</h1>
        <p class="text-gray-400">Atividade do sistema em tempo real</p>
      </div>
      <div class="flex items-center space-x-3 bg-gray-900/50 p-2 rounded-lg border border-gray-800">
        <span class="text-sm text-gray-400 px-2" x-text="'Últimas 24h: ' + lastUpdate"></span>
        <button @click="refreshData()" class="px-3 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs text-white transition-colors flex items-center gap-2">
           <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" :class="loading ? 'animate-spin' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
           Atualizar
        </button>
      </div>
    </div>

    <!-- KPIs Principais -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <!-- KPI 1 -->
      <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl hover:border-indigo-500/30 transition-all group">
        <div class="flex justify-between items-start mb-4">
          <div class="p-2 bg-indigo-500/10 rounded-lg text-indigo-400 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-emerald-400 text-xs font-bold">+12.5%</span>
        </div>
        <h3 class="text-gray-400 text-sm">Vendas Totais</h3>
        <p class="text-2xl font-bold text-white mt-1" x-text="formatCurrency(stats.sales)"></p>
      </div>

      <!-- KPI 2 -->
      <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl hover:border-purple-500/30 transition-all group">
         <div class="flex justify-between items-start mb-4">
          <div class="p-2 bg-purple-500/10 rounded-lg text-purple-400 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <span class="text-emerald-400 text-xs font-bold">+5.2%</span>
        </div>
        <h3 class="text-gray-400 text-sm">Novos Clientes</h3>
        <p class="text-2xl font-bold text-white mt-1" x-text="stats.clients"></p>
      </div>

      <!-- KPI 3 -->
      <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl hover:border-cyan-500/30 transition-all group">
         <div class="flex justify-between items-start mb-4">
          <div class="p-2 bg-cyan-500/10 rounded-lg text-cyan-400 group-hover:scale-110 transition-transform">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <span class="text-red-400 text-xs font-bold">-2.1%</span>
        </div>
        <h3 class="text-gray-400 text-sm">Conversas Ativas</h3>
        <p class="text-2xl font-bold text-white mt-1" x-text="stats.chats"></p>
      </div>

       <!-- KPI 4 -->
      <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl hover:border-orange-500/30 transition-all group">
         <div class="flex justify-between items-start mb-4">
          <div class="p-2 bg-orange-500/10 rounded-lg text-orange-400 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-emerald-400 text-xs font-bold">+8.4%</span>
        </div>
        <h3 class="text-gray-400 text-sm">Taxa de Conversão</h3>
        <p class="text-2xl font-bold text-white mt-1" x-text="stats.conversion + '%'"></p>
      </div>
    </div>

    <!-- Gráfico Principal (Simulado Visualmente) -->
    <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl">
      <h3 class="text-lg font-semibold text-white mb-6">Tráfego x Vendas (Hora a Hora)</h3>
      <div class="h-64 flex items-end justify-between space-x-2 px-4 pb-4 border-b border-gray-700 relative">
        <!-- Barras Simuladas -->
          <template x-for="(bar, index) in chartData" :key="index">
            <div class="group relative w-full h-full flex flex-col justify-end">
               <div 
                class="w-full bg-indigo-500/50 rounded-t hover:bg-indigo-400 transition-all cursor-pointer"
                :style="`height: ${bar.height}%`"
               ></div>
               <!-- Tooltip -->
               <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block bg-black text-xs text-white p-2 rounded whitespace-nowrap z-10">
                 <span x-text="`${index}:00h - ${bar.visits} visits`"></span>
               </div>
            </div>
          </template>
      </div>
      <div class="flex justify-between text-xs text-gray-500 mt-2 px-2">
        <span>00:00</span>
        <span>06:00</span>
        <span>12:00</span>
        <span>18:00</span>
        <span>23:59</span>
      </div>
    </div>

    <!-- Timeline Recente -->
    <div class="bg-gray-900/50 border border-gray-800 p-6 rounded-xl">
      <h3 class="text-lg font-semibold text-white mb-6">Atividades Recentes</h3>
      <div class="space-y-6">
        
        <div class="flex items-start space-x-4">
          <div class="w-8 h-8 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center shrink-0 border border-green-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <div>
            <p class="text-gray-200">Nova venda aprovada <span class="text-green-400 font-mono">R$ 249,90</span></p>
            <p class="text-xs text-gray-500">João Silva • há 2 minutos</p>
          </div>
        </div>

        <div class="flex items-start space-x-4">
          <div class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 border border-blue-500/30">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
          </div>
          <div>
            <p class="text-gray-200">Novo lead cadastrado via LP</p>
            <p class="text-xs text-gray-500">Campanha Instagram • há 15 minutos</p>
          </div>
        </div>

        <div class="flex items-start space-x-4">
           <div class="w-8 h-8 rounded-full bg-orange-500/20 text-orange-400 flex items-center justify-center shrink-0 border border-orange-500/30">
             <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
          </div>
          <div>
            <p class="text-gray-200">Alerta de estoque baixo: <span class="text-white">Fone Bluetooth XYZ</span></p>
            <p class="text-xs text-gray-500">Sistema • há 45 minutos</p>
          </div>
        </div>

      </div>
      </div>
    </div>
  </div>

<script nonce={Astro.locals.nonce}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('dashboard24h', () => ({
      loading: false,
      lastUpdate: new Date().toLocaleTimeString(),
      stats: {
        sales: 14230.50,
        clients: 128,
        chats: 42,
        conversion: 3.2
      },
      chartData: [],

      init() {
        this.generateChartData();
        // Auto refresh every 30s
        setInterval(() => this.refreshData(), 30000);
      },

      formatCurrency(value) {
        return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value);
      },

      generateChartData() {
        this.chartData = Array.from({ length: 24 }).map(() => ({
          height: Math.random() * 80 + 10,
          visits: Math.floor(Math.random() * 150)
        }));
      },

      async refreshData() {
        this.loading = true;
        try {
          const res = await fetch('/api/analytics/dashboard-stats');
          const data = await res.json();
          
          this.stats = {
            sales: data.revenue24h,
            clients: data.activeCustomers,
            chats: 42, // TODO: Connect to active chats count
            conversion: data.conversionRate
          };
          
          this.generateChartData();
          this.lastUpdate = new Date().toLocaleTimeString();
        } catch (e) {
          console.error('Erro ao atualizar dashboard:', e);
        } finally {
          this.loading = false;
        }
      }
    }));
  });
</script>
</AdminLayout>
