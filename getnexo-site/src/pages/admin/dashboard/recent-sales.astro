---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Últimas 50 Vendas" activeTab="dashboard">
  <div class="space-y-6">
    <!-- Header e Filtros -->
     <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white">Últimas 50 Vendas</h1>
        <p class="text-gray-400">Transações recentes em tempo real</p>
      </div>
      <div class="flex items-center space-x-2">
        <input type="text" placeholder="Buscar ID ou Cliente..." class="bg-gray-900 border border-gray-800 text-gray-300 px-4 py-2 rounded-lg focus:outline-none focus:border-emerald-500 text-sm">
        <button class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg shadow-lg shadow-emerald-600/20 text-sm font-medium transition-all">
          Exportar CSV
        </button>
      </div>
    </div>

    <!-- Tabela de Vendas -->
    <div class="bg-gray-900/50 border border-gray-800 rounded-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-900 text-gray-400 text-xs uppercase tracking-wider border-b border-gray-800">
              <th class="p-4 font-semibold">Status</th>
              <th class="p-4 font-semibold">Cliente</th>
              <th class="p-4 font-semibold">Produtos</th>
              <th class="p-4 font-semibold">Data</th>
              <th class="p-4 font-semibold text-right">Valor Total</th>
              <th class="p-4 font-semibold text-center">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800 text-sm">
            
            {/* Linha 1 */}
            <tr class="hover:bg-gray-800/50 transition-colors group">
              <td class="p-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-1.5"></span>
                  Aprovado
                </span>
              </td>
              <td class="p-4">
                <div class="flex items-center">
                  <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold text-xs mr-3">
                    AL
                  </div>
                  <div>
                    <div class="font-medium text-white">Ana Lúcia</div>
                    <div class="text-gray-500 text-xs">ana.lucia@email.com</div>
                  </div>
                </div>
              </td>
              <td class="p-4 text-gray-300">
                1x Smartwatch Series 8 <span class="text-gray-500 text-xs ml-1">+1 outro</span>
              </td>
              <td class="p-4 text-gray-400">
                Hoje, 14:32
              </td>
              <td class="p-4 text-right font-medium text-emerald-400">
                R$ 1.250,00
              </td>
              <td class="p-4 text-center">
                <button class="text-gray-500 hover:text-white transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                </button>
              </td>
            </tr>

             {/* Linha 2 */}
            <tr class="hover:bg-gray-800/50 transition-colors group">
              <td class="p-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">
                  <span class="w-1.5 h-1.5 bg-yellow-500 rounded-full mr-1.5 animate-pulse"></span>
                  Pendente
                </span>
              </td>
              <td class="p-4">
                <div class="flex items-center">
                  <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-blue-500 to-cyan-500 flex items-center justify-center text-white font-bold text-xs mr-3">
                    CR
                  </div>
                  <div>
                    <div class="font-medium text-white">Carlos Roberto</div>
                    <div class="text-gray-500 text-xs">carlos.r@email.com</div>
                  </div>
                </div>
              </td>
              <td class="p-4 text-gray-300">
                2x Capa Protetora iPhone 14
              </td>
              <td class="p-4 text-gray-400">
                Hoje, 14:15
              </td>
              <td class="p-4 text-right font-medium text-white">
                R$ 198,00
              </td>
              <td class="p-4 text-center">
                <button class="text-gray-500 hover:text-white transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                </button>
              </td>
            </tr>

             {/* Linha 3 */}
            <tr class="hover:bg-gray-800/50 transition-colors group">
              <td class="p-4">
                 <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20">
                  <span class="w-1.5 h-1.5 bg-red-500 rounded-full mr-1.5"></span>
                  Cancelado
                </span>
              </td>
              <td class="p-4">
                <div class="flex items-center">
                   <div class="h-8 w-8 rounded-full bg-gray-700 flex items-center justify-center text-gray-300 font-bold text-xs mr-3">
                    MR
                  </div>
                  <div>
                    <div class="font-medium text-white">Mariana Rita</div>
                    <div class="text-gray-500 text-xs">mari.rita@email.com</div>
                  </div>
                </div>
              </td>
              <td class="p-4 text-gray-300">
                1x Fonte Carregadora 20W
              </td>
              <td class="p-4 text-gray-400">
                Hoje, 13:50
              </td>
              <td class="p-4 text-right font-medium text-gray-400 line-through">
                R$ 149,90
              </td>
              <td class="p-4 text-center">
                <button class="text-gray-500 hover:text-white transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                </button>
              </td>
            </tr>

             {/* Linha 4 */}
            <tr class="hover:bg-gray-800/50 transition-colors group">
              <td class="p-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-1.5"></span>
                  Aprovado
                </span>
              </td>
              <td class="p-4">
                <div class="flex items-center">
                  <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-amber-500 to-orange-500 flex items-center justify-center text-white font-bold text-xs mr-3">
                    PJ
                  </div>
                  <div>
                    <div class="font-medium text-white">Pedro Joaquim</div>
                    <div class="text-gray-500 text-xs">pedro.j@email.com</div>
                  </div>
                </div>
              </td>
              <td class="p-4 text-gray-300">
                1x Monitor UltraWide 29"
              </td>
              <td class="p-4 text-gray-400">
                Hoje, 13:42
              </td>
              <td class="p-4 text-right font-medium text-emerald-400">
                R$ 1.890,00
              </td>
              <td class="p-4 text-center">
                 <button class="text-gray-500 hover:text-white transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                </button>
              </td>
            </tr>

          </tbody>
        </table>
      </div>
      <div class="p-4 border-t border-gray-800 bg-gray-900/30 flex justify-center">
          <button class="text-gray-400 hover:text-white text-sm font-medium transition-colors">Carregar mais...</button>
      </div>
    </div>
  </div>
</AdminLayout>
