---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Ticket, Plus, Trash2, Edit3, CheckCircle, XCircle } from 'lucide-react';
---

<AdminLayout title="Cupons de Desconto" activeTab="cupons">
  <div class="space-y-6 animate-fade-in" 
       x-data="{ 
         coupons: [], 
         loading: true,
         modalOpen: false,
         editingCoupon: { id: '', code: '', discount_type: 'percentage', discount_value: '', min_order_value: 0, max_uses: 0, expires_at: '', active: true },
         
         async fetchCoupons() {
           this.loading = true;
           try {
             const res = await fetch('/api/coupons');
             this.coupons = await res.json();
           } catch (e) {
             console.error('Erro ao carregar cupons:', e);
           } finally {
             this.loading = false;
           }
         },
         
         openModal(coupon = null) {
           if (coupon) {
             this.editingCoupon = { ...coupon, expires_at: coupon.expires_at ? coupon.expires_at.split('T')[0] : '' };
           } else {
             this.editingCoupon = { id: '', code: '', discount_type: 'percentage', discount_value: '', min_order_value: 0, max_uses: 0, expires_at: '', active: true };
           }
           this.modalOpen = true;
         },
         
         async saveCoupon() {
           try {
             const method = this.editingCoupon.id ? 'PUT' : 'POST';
             const url = this.editingCoupon.id 
               ? `/api/coupons/${this.editingCoupon.id}`
               : '/api/coupons';
             
             const res = await fetch(url, {
               method,
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify(this.editingCoupon)
             });
             
             if (res.ok) {
               this.modalOpen = false;
               this.fetchCoupons();
             } else {
               const err = await res.json();
               alert(err.error || 'Erro ao salvar cupom');
             }
           } catch (e) {
             alert('Erro na requisição');
           }
         },
         
         async deleteCoupon(id) {
           if (!confirm('Excluir este cupom permanentemente?')) return;
           try {
             await fetch(`/api/coupons/${id}`, { method: 'DELETE' });
             this.fetchCoupons();
           } catch (e) {
             alert('Erro ao excluir');
           }
         }
       }" 
       x-init="fetchCoupons()">
    
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-white uppercase tracking-tight">Cupons de Desconto</h1>
        <p class="text-sm text-gray-400">Gerencie códigos promocionais e descontos fixos ou percentuais.</p>
      </div>
      <button @click="openModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-5 py-2.5 rounded-xl flex items-center space-x-2 transition-all">
        <Plus className="w-4 h-4" />
        <span>Novo Cupom</span>
      </button>
    </div>

    <!-- Tabela -->
    <div class="bg-gray-900/20 border border-gray-800 rounded-2xl overflow-hidden backdrop-blur-md">
      <div x-show="loading" class="p-20 flex flex-col items-center justify-center space-y-4">
         <div class="w-8 h-8 border-2 border-indigo-500 border-t-transparent rounded-full animate-spin"></div>
         <p class="text-xs text-gray-500 uppercase font-black tracking-widest">Carregando Cupons...</p>
      </div>

      <table x-show="!loading" class="w-full text-left">
        <thead>
          <tr class="bg-black/40 border-b border-gray-800">
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500">Código</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500">Desconto</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500">Mínimo</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500">Usos</th>
            <th class="px-6 py-4 text-[10px] font-black uppercase text-gray-500 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/50">
          <template x-for="coupon in coupons" :key="coupon.id">
            <tr class="hover:bg-indigo-500/5 transition-colors group">
              <td class="px-6 py-4">
                <div class="flex items-center space-x-3">
                  <div class="w-8 h-8 bg-indigo-500/10 rounded-lg flex items-center justify-center text-indigo-400">
                    <Ticket className="w-4 h-4" />
                  </div>
                  <span class="text-sm font-black text-white uppercase tracking-widest font-mono" x-text="coupon.code"></span>
                </div>
              </td>
              <td class="px-6 py-4">
                <span class="text-sm font-bold text-emerald-400" x-text="coupon.discount_type === 'percentage' ? coupon.discount_value + '%' : 'R$ ' + parseFloat(coupon.discount_value).toFixed(2)"></span>
              </td>
              <td class="px-6 py-4">
                <span class="text-xs text-gray-500" x-text="'R$ ' + parseFloat(coupon.min_order_value).toFixed(2)"></span>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center space-x-2">
                   <span class="text-xs text-white font-bold" x-text="coupon.uses_count"></span>
                   <span class="text-[10px] text-gray-600 uppercase" x-text="coupon.max_uses > 0 ? '/ ' + coupon.max_uses : '(Ilimitado)'"></span>
                </div>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end space-x-2">
                   <button @click="openModal(coupon)" class="p-2 text-gray-500 hover:text-indigo-400 transition-colors">
                     <Edit3 className="w-4 h-4" />
                   </button>
                   <button @click="deleteCoupon(coupon.id)" class="p-2 text-gray-500 hover:text-red-500 transition-colors">
                     <Trash2 className="w-4 h-4" />
                   </button>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      
      <div x-show="!loading && coupons.length === 0" class="p-20 text-center">
        <p class="text-gray-500 text-sm">Nenhum cupom cadastrado ainda.</p>
      </div>
    </div>

    <!-- Modal Form -->
    <div x-show="modalOpen" 
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         style="display: none;" x-cloak>
      <div class="bg-gray-900 border border-gray-800 w-full max-w-lg rounded-[2.5rem] p-8 space-y-6 shadow-2xl" @click.away="modalOpen = false">
        <h3 class="text-xl font-bold text-white uppercase tracking-tight" x-text="editingCoupon.id ? 'Editar Cupom' : 'Novo Cupom'"></h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="col-span-2 space-y-1">
            <label class="text-[10px] font-black uppercase text-gray-500 tracking-widest">Código do Cupom</label>
            <input type="text" x-model="editingCoupon.code" placeholder="Ex: VERAO2026" class="w-full bg-black/40 border border-gray-800 rounded-xl py-3 px-4 text-white focus:border-indigo-500 outline-none uppercase font-mono" />
          </div>
          
          <div class="space-y-1">
            <label class="text-[10px] font-black uppercase text-gray-500 tracking-widest">Tipo</label>
            <select x-model="editingCoupon.discount_type" class="w-full bg-black/40 border border-gray-800 rounded-xl py-3 px-4 text-white focus:border-indigo-500 outline-none">
              <option value="percentage">Porcentagem (%)</option>
              <option value="fixed">Valor Fixo (R$)</option>
            </select>
          </div>
          
          <div class="space-y-1">
            <label class="text-[10px] font-black uppercase text-gray-500 tracking-widest">Valor do Desconto</label>
            <input type="number" x-model="editingCoupon.discount_value" step="0.01" class="w-full bg-black/40 border border-gray-800 rounded-xl py-3 px-4 text-white focus:border-indigo-500 outline-none" />
          </div>

          <div class="space-y-1">
            <label class="text-[10px] font-black uppercase text-gray-500 tracking-widest">Pedido Mínimo (R$)</label>
            <input type="number" x-model="editingCoupon.min_order_value" step="0.01" class="w-full bg-black/40 border border-gray-800 rounded-xl py-3 px-4 text-white focus:border-indigo-500 outline-none" />
          </div>
          
          <div class="space-y-1">
            <label class="text-[10px] font-black uppercase text-gray-500 tracking-widest">Limite de Usos</label>
            <input type="number" x-model="editingCoupon.max_uses" class="w-full bg-black/40 border border-gray-800 rounded-xl py-3 px-4 text-white focus:border-indigo-500 outline-none" />
          </div>

          <div class="col-span-2 space-y-1">
            <label class="text-[10px] font-black uppercase text-gray-500 tracking-widest">Data de Expiração</label>
            <input type="date" x-model="editingCoupon.expires_at" class="w-full bg-black/40 border border-gray-800 rounded-xl py-3 px-4 text-white focus:border-indigo-500 outline-none" />
          </div>
          
          <div class="col-span-2 flex items-center space-x-3 pt-2">
            <input type="checkbox" x-model="editingCoupon.active" id="active" class="w-5 h-5 rounded border-gray-800 bg-black/40 text-indigo-600 focus:ring-indigo-500" />
            <label for="active" class="text-sm text-gray-400 font-bold uppercase tracking-tight">Cupom Ativo e Visível</label>
          </div>
        </div>

        <div class="flex space-x-3 pt-4">
          <button @click="modalOpen = false" class="flex-1 py-3 bg-gray-800 hover:bg-gray-700 text-gray-400 font-bold rounded-2xl transition-all uppercase text-[10px] tracking-widest">Cancelar</button>
          <button @click="saveCoupon()" class="flex-1 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl transition-all uppercase text-[10px] tracking-widest">Salvar Cupom</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  [x-cloak] { display: none !important; }
</style>
