          return;
      }
      
      try {
          await fetch(`${API_URL}/api/admin/profile`, {
              method: 'POST',
              headers: {'Content-Type': 'application/json'},
              body: JSON.stringify({ password: pass })
          });
          showToast('Perfil atualizado!', 'success');
          closeModal('profile');
      } catch(e) { showToast('Erro ao atualizar', 'error'); }
  };
  
