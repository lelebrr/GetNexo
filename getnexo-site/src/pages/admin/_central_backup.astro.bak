---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Central de Controle | GetNexo Admin">

<style is:global>
  /* ADMIN PAGE: Hide ALL external elements */
  .global-header, 
  .global-footer,
  .floating-whatsapp,
  #live-pulse,
  #command-palette,
  nav.navbar,
  footer,
  /* Chat widgets */
  .chatwoot-widget,
  #cw-widget,
  .chatwoot-bubble,
  [class*="chatwoot"],
  [id*="chatwoot"],
  .woot-widget-holder,
  .chat-widget,
  .chat-bubble,
  /* Accessibility button */
  .accessibility-btn,
  .accessibility-controls,
  .accessibility-menu,
  [class*="accessibility"],
  #accessibility-controls,
  /* Any fixed bottom elements */
  .fixed-bottom-right,
  .floating-widget,
  .fab-button,
  /* Tawk.to, Intercom, Drift, etc */
  #tawk-container,
  .intercom-launcher,
  .drift-widget { 
    display: none !important; 
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
  
  /* Override Layout main element */
  body > main,
  main:not(.main-content) { 
    padding: 0 !important; 
    margin: 0 !important;
    min-height: 100vh !important; 
    max-width: none !important;
    width: 100% !important;
  }
  
  /* Ensure admin-central fills viewport */
  .admin-central {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    z-index: 9999 !important;
    display: flex !important;
    background: #030712 !important;
  }
</style>

<script is:inline>
  // Force hide chat widgets and accessibility buttons on admin page
  document.addEventListener('DOMContentLoaded', function() {
    const hideElements = [
      '.chatwoot-widget', '#cw-widget', '.chatwoot-bubble', 
      '.accessibility-btn', '.accessibility-controls', '#accessibility-controls',
      '.floating-whatsapp', '.chat-widget', '.chat-bubble',
      '[class*="chatwoot"]', '[class*="accessibility"]'
    ];
    
    hideElements.forEach(selector => {
      document.querySelectorAll(selector).forEach(el => {
        el.style.display = 'none';
        el.style.visibility = 'hidden';
        el.remove();
      });
    });
    
    // Also observe for dynamically added widgets
    const observer = new MutationObserver(mutations => {
      hideElements.forEach(selector => {
        document.querySelectorAll(selector).forEach(el => {
          el.style.display = 'none';
          el.remove();
        });
      });
    });
    
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>

<div class="admin-central">
  
  <!-- Sidebar -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <div class="logo">
        <span class="logo-icon">N</span>
        <span class="logo-text">Get<span class="accent">Nexo</span></span>
      </div>
      <button class="toggle-btn" id="toggle-sidebar">☰</button>
    </div>

    <div class="search-box">
      <input type="text" id="global-search" placeholder="Buscar... (Ctrl+K)" />
    </div>

    <nav class="sidebar-nav">
      
      <!-- Dashboard -->
      <div class="nav-section">
        <a href="/admin" class="nav-item active">
          <span class="nav-icon">📊</span>
          <span class="nav-text">Dashboard</span>
        </a>
      </div>

      <!-- E-commerce -->
      <div class="nav-section">
        <button class="nav-group-btn" data-target="ecommerce-menu">
          <span class="nav-icon">🛍️</span>
          <span class="nav-text">E-commerce</span>
          <span class="nav-arrow">▾</span>
        </button>
        <div class="nav-submenu" id="ecommerce-menu">
          <a href="#produtos" class="nav-subitem" data-section="produtos">Produtos</a>
          <a href="#pedidos" class="nav-subitem" data-section="pedidos">Pedidos</a>
          <a href="#cupons" class="nav-subitem" data-section="cupons">Cupons</a>
          <a href="#categorias" class="nav-subitem" data-section="categorias">Categorias</a>
          <a href="#estoque" class="nav-subitem" data-section="estoque">Estoque</a>
        </div>
      </div>

      <!-- Atendimento -->
      <div class="nav-section">
        <button class="nav-group-btn" data-target="atendimento-menu">
          <span class="nav-icon">💬</span>
          <span class="nav-text">Atendimento</span>
          <span class="nav-arrow">▾</span>
        </button>
        <div class="nav-submenu" id="atendimento-menu">
          <a href="#campanhas" class="nav-subitem" data-section="campanhas">Campanhas</a>
          <a href="#macros" class="nav-subitem" data-section="macros">Macros</a>
          <a href="#bot-config" class="nav-subitem" data-section="bot-config">Config do Bot</a>
          <a href="#horarios" class="nav-subitem" data-section="horarios">Horários</a>
          <a href="#filas" class="nav-subitem" data-section="filas">Filas de Atendimento</a>
        </div>
      </div>

      <!-- IA -->
      <div class="nav-section">
        <button class="nav-group-btn" data-target="ia-menu">
          <span class="nav-icon">🤖</span>
          <span class="nav-text">Inteligência Artificial</span>
          <span class="nav-arrow">▾</span>
        </button>
        <div class="nav-submenu" id="ia-menu">
          <a href="#ia-provedores" class="nav-subitem" data-section="ia-provedores">Provedores</a>
          <a href="#ia-frases-nexusia" class="nav-subitem" data-section="ia-frases-nexusia">Frases Nexus IA</a>
          <a href="#ia-frases-nexuswork" class="nav-subitem" data-section="ia-frases-nexuswork">Frases Nexus Work</a>
          <a href="#ia-prompts" class="nav-subitem" data-section="ia-prompts">Prompts</a>
          <a href="#ia-playground" class="nav-subitem" data-section="ia-playground">Playground</a>
          <a href="#ia-historico" class="nav-subitem" data-section="ia-historico">Histórico</a>
        </div>
      </div>

      <!-- Integrações -->
      <div class="nav-section">
        <button class="nav-group-btn" data-target="integracoes-menu">
          <span class="nav-icon">🔗</span>
          <span class="nav-text">Integrações</span>
          <span class="nav-arrow">▾</span>
        </button>
        <div class="nav-submenu" id="integracoes-menu">
          <a href="#int-whatsapp" class="nav-subitem" data-section="int-whatsapp">WhatsApp</a>
          <a href="#int-crm" class="nav-subitem" data-section="int-crm">CRMs</a>
          <a href="#int-mailchimp" class="nav-subitem" data-section="int-mailchimp">Mailchimp</a>
          <a href="#int-pagamentos" class="nav-subitem" data-section="int-pagamentos">Pagamentos</a>
          <a href="#int-ecommerce" class="nav-subitem" data-section="int-ecommerce">E-commerce</a>
          <a href="#int-automacao" class="nav-subitem" data-section="int-automacao">Automação</a>
          <a href="#int-webhooks" class="nav-subitem" data-section="int-webhooks">Webhooks</a>
          <a href="#int-whatsapp-manage" class="nav-subitem" data-section="int-whatsapp-manage">Gerenciar WhatsApp</a>
        </div>
      </div>

      <!-- Relatórios -->
      <div class="nav-section">
        <button class="nav-group-btn" data-target="relatorios-menu">
          <span class="nav-icon">📈</span>
          <span class="nav-text">Relatórios</span>
          <span class="nav-arrow">▾</span>
        </button>
        <div class="nav-submenu" id="relatorios-menu">
          <a href="#rel-vendas" class="nav-subitem" data-section="rel-vendas">Vendas</a>
          <a href="#rel-leads" class="nav-subitem" data-section="rel-leads">Leads</a>
          <a href="#rel-atendimento" class="nav-subitem" data-section="rel-atendimento">Atendimento</a>
          <a href="#rel-performance" class="nav-subitem" data-section="rel-performance">Performance</a>
          <a href="#rel-exportar" class="nav-subitem" data-section="rel-exportar">Exportar</a>
        </div>
      </div>

      <!-- Segurança -->
      <div class="nav-section">
        <button class="nav-group-btn" data-target="seguranca-menu">
          <span class="nav-icon">🛡️</span>
          <span class="nav-text">Segurança</span>
          <span class="nav-arrow">▾</span>
        </button>
        <div class="nav-submenu" id="seguranca-menu">
          <a href="/admin/usuarios" class="nav-subitem">Usuários</a>
          <a href="/admin/roles" class="nav-subitem">Roles</a>
          <a href="/admin/auditoria" class="nav-subitem">Auditoria</a>
          <a href="#seg-sessoes" class="nav-subitem" data-section="seg-sessoes">Sessões</a>
          <a href="#seg-ips" class="nav-subitem" data-section="seg-ips">Bloqueio de IPs</a>
        </div>
      </div>

      <!-- Configurações -->
      <div class="nav-section">
        <button class="nav-group-btn" data-target="config-menu">
          <span class="nav-icon">⚙️</span>
          <span class="nav-text">Configurações</span>
          <span class="nav-arrow">▾</span>
        </button>
        <div class="nav-submenu" id="config-menu">
          <a href="#cfg-empresa" class="nav-subitem" data-section="cfg-empresa">Empresa</a>
          <a href="#cfg-email" class="nav-subitem" data-section="cfg-email">Email/SMTP</a>
          <a href="#cfg-notificacoes" class="nav-subitem" data-section="cfg-notificacoes">Notificações</a>
          <a href="#cfg-api" class="nav-subitem" data-section="cfg-api">API/Tokens</a>
          <a href="#cfg-backup" class="nav-subitem" data-section="cfg-backup">Backup</a>
        </div>
      </div>

    </nav>

    <div class="sidebar-footer">
      <a href="/" target="_blank" class="nav-item">
        <span class="nav-icon">↗</span>
        <span class="nav-text">Ver Site</span>
      </a>
      <button class="nav-item logout" onclick="logout()">
        <span class="nav-icon">🚪</span>
        <span class="nav-text">Sair</span>
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    
    <!-- Header -->
    <header class="content-header">
      <div class="header-left">
        <h1 id="section-title">Dashboard</h1>
        <span class="breadcrumb" id="breadcrumb">Central de Controle</span>
      </div>
      <div class="header-right">
        <!-- Search Trigger -->
        <button class="header-icon-btn" title="Buscar (Ctrl+K)" onclick="document.getElementById('global-search').focus()">
             🔍
        </button>

        <!-- Notification Center -->
        <div class="notification-wrapper" style="position:relative;">
            <button class="header-icon-btn relative" onclick="toggleNotifications()">
              🔔
              <span class="notification-badge" id="notif-badge" style="display:none;">0</span>
            </button>
            <div id="notification-dropdown" class="notification-dropdown" style="display:none; position:absolute; top:40px; right:0; width:300px; background:#1f2937; border:1px solid #374151; border-radius:8px; z-index:50;">
                <div class="dropdown-header" style="padding:10px; border-bottom:1px solid #374151; display:flex; justify-content:space-between;">
                    <strong style="color:white;">Notificações</strong>
                </div>
                <div id="notif-list" class="dropdown-content" style="max-height:300px; overflow-y:auto; padding:10px;">
                    <div class="text-center text-gray-500" style="padding:10px;">Carregando...</div>
                </div>
            </div>
        </div>
        <span class="time" id="clock">00:00</span>
        <div class="user-avatar" id="user-avatar" onclick="openProfileModal()" style="cursor:pointer;">A</div>

        <div class="user-profile glow-on-hover" onclick="openModal('profile')" style="cursor:pointer; display:flex; align-items:center; gap:0.5rem;">
          <div class="user-avatar" id="user-avatar" style="background: linear-gradient(135deg, #3b82f6, #8b5cf6);">A</div>
          <span class="user-name">Admin</span>
        </div>
      </div>
    </header>

    <!-- Dynamic Content Area -->
  <!-- Modal Profile -->
<div class="modal-overlay" id="modal-profile" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2>👤 Perfil do Administrador</h2>
      <button class="close-modal" onclick="closeModal('profile')">&times;</button>
    </div>
    <div class="config-form">
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="profile-email" value="admin@getnexo.com.br" readonly style="background:#334155; cursor:not-allowed;" />
      </div>
      <div class="form-group">
        <label>Nova Senha</label>
        <input type="password" id="profile-password" placeholder="Deixe em branco para manter" />
      </div>
      <div class="form-group">
         <label>Confirmar Senha</label>
         <input type="password" id="profile-password-confirm" />
      </div>
      
      <div class="modal-actions">
        <button class="btn-secondary" onclick="closeModal('profile')">Cancelar</button>
        <button class="btn-primary" onclick="saveProfile()">Salvar Alterações</button>
      </div>
        <!-- AI Insights Card (New) -->
        <div class="glass-panel" style="margin-top:1.5rem; padding:1.5rem; border: 1px solid rgba(139, 92, 246, 0.3); background: rgba(139, 92, 246, 0.05);">
            <div style="display:flex; justify-content:space-between; margin-bottom:1rem;">
                <h3 style="color:#a78bfa;">🧠 AI Insights & Oportunidades</h3>
                <button class="btn-sm" onclick="loadInsights()">Atualizar</button>
            </div>
            <div id="ai-insights-list" style="display:grid; gap:0.5rem;">
                <div class="loading">Analisando dados...</div>
            </div>
        </div> 

    </div>
  </div>
</div>

  <div class="content-area" id="content-area">
      
      <!-- Dashboard Section (Default) -->
      <section class="section-panel" id="section-dashboard" style="display:block;">

<!-- Modal Webhook -->
<div class="modal-overlay" id="modal-webhook" style="display:none;">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Configurar Webhook</h2>
            <button class="close-modal" onclick="closeModal('webhook')">&times;</button>
        </div>
        <form id="form-webhook" onsubmit="saveWebhook(event)">
            <input type="hidden" id="webhook-id" />
            <div class="form-group">
                <label>Nome da Integração</label>
                <input type="text" id="webhook-nome" required placeholder="Ex: N8N Pedidos" />
            </div>
            <div class="form-group">
                <label>Endpoint URL (POST)</label>
                <input type="url" id="webhook-url" required placeholder="https://..." />
                <button type="button" class="btn-xs" style="margin-top:5px;" onclick="testWebhook()">Testar Disparo</button>
            </div>
            <div class="form-group">
                <label>Eventos Gatilho</label>
                <div class="checkbox-grid" style="display:grid; grid-template-columns: 1fr 1fr; gap:0.5rem;">
                    <label class="checkbox-item"><input type="checkbox" value="order.created" checked> Novo Pedido</label>
                    <label class="checkbox-item"><input type="checkbox" value="order.paid"> Pagamento Aprovado</label>
                    <label class="checkbox-item"><input type="checkbox" value="chat.new"> Nova Mensagem</label>
                    <label class="checkbox-item"><input type="checkbox" value="lead.created"> Novo Lead</label>
                </div>
            </div>
            <div class="form-group">
                <label>Headers Adicionais (JSON opcional)</label>
                <input type="text" id="webhook-headers" placeholder='{"Authorization": "Bearer..."}' />
            </div>
            <div class="form-group" style="display:flex; align-items:center; gap:1rem;">
                <label class="toggle-switch">
                    <input type="checkbox" id="webhook-ativo" checked>
                    <span class="toggle-slider"></span>
                </label>
                <span>Ativo</span>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeModal('webhook')">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar Webhook</button>
            </div>
        </form>
    </div>
</div>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon">💰</span>
            <div class="stat-info">
              <span class="stat-value" id="stat-vendas">R$ 0</span>
              <span class="stat-label">Vendas Hoje</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">📦</span>
            <div class="stat-info">
              <span class="stat-value" id="stat-pedidos">0</span>
              <span class="stat-label">Pedidos</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">💬</span>
            <div class="stat-info">
              <span class="stat-value" id="stat-conversas">0</span>
              <span class="stat-label">Conversas</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">👥</span>
            <div class="stat-info">
              <span class="stat-value" id="stat-leads">0</span>
              <span class="stat-label">Leads</span>
            </div>
          </div>
        </div>

        <div class="quick-actions">
          <h3>⚡ Ações Rápidas</h3>
          <div class="actions-grid">
            <button class="action-btn" onclick="showSection('produtos')">🛍️ Novo Produto</button>
            <button class="action-btn" onclick="showSection('cupons')">🎟️ Criar Cupom</button>
            <button class="action-btn" onclick="showSection('campanhas')">📢 Nova Campanha</button>
            <button class="action-btn" onclick="showSection('ia-prompts')">🤖 Config IA</button>
          </div>
        </div>

        <div class="modules-overview">
          <h3>📦 Módulos do Sistema</h3>
          <div class="modules-grid" id="modules-grid">
            <!-- Modules will be loaded here -->
          </div>
        </div>
      </section>

      <!-- Produtos Section -->
      <section class="section-panel" id="section-produtos">
        <div class="section-header">
          <h2>🛍️ Gerenciar Produtos</h2>
          <button class="btn-primary" onclick="openModal('produto')">+ Novo Produto</button>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Produto</th><th>Preço</th><th>Estoque</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody id="produtos-tbody">
              <tr><td colspan="5" class="loading">Carregando produtos...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Cupons Section -->
      <section class="section-panel" id="section-cupons">
        <div class="section-header">
          <h2>🎟️ Cupons de Desconto</h2>
          <button class="btn-primary" onclick="openModal('cupom')">+ Novo Cupom</button>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Código</th><th>Desconto</th><th>Validade</th><th>Usos</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody id="cupons-tbody">
              <tr><td colspan="6" class="loading">Carregando cupons...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Campanhas Section -->
      <section class="section-panel" id="section-campanhas">
        <div class="section-header">
          <h2>📢 Campanhas de Broadcast</h2>
          <button class="btn-primary" onclick="openModal('campanha')">+ Nova Campanha</button>
        </div>
        <div class="campaigns-grid" id="campaigns-grid">
          <div class="loading">Carregando campanhas...</div>
        </div>
      </section>

      <!-- IA Provedores Section -->
      <section class="section-panel" id="section-ia-provedores">
        <div class="section-header">
          <h2>🤖 Provedores de IA</h2>
        </div>
        <div class="providers-grid" id="providers-grid">
          <!-- Providers will be loaded here -->
        </div>
      </section>

      <!-- IA Frases Nexus IA Section -->
      <section class="section-panel" id="section-ia-frases-nexusia">
        <div class="section-header">
          <h2>💬 Frases Nexus IA</h2>
          <button class="btn-primary" onclick="openModal('frase-nexusia')">+ Adicionar Frase</button>
        </div>
        <p style="color:#94a3b8; margin-bottom:1.5rem;">Gerencie frases aleatórias utilizadas pelo assistente de IA Nexus IA.</p>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Frase</th><th>Tipo</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody id="nexusia-frases-tbody">
              <tr><td colspan="4" class="loading">Carregando frases...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- IA Frases Nexus Work Section -->
      <section class="section-panel" id="section-ia-frases-nexuswork">
        <div class="section-header">
          <h2>💼 Frases Nexus Work</h2>
          <button class="btn-primary" onclick="openModal('frase-nexuswork')">+ Adicionar Frase</button>
        </div>
        <p style="color:#94a3b8; margin-bottom:1.5rem;">Gerencie frases aleatórias utilizadas pelo assistente de trabalho Nexus Work.</p>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Frase</th><th>Tipo</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody id="nexuswork-frases-tbody">
              <tr><td colspan="4" class="loading">Carregando frases...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Integrações WhatsApp Section -->
      <section class="section-panel" id="section-int-whatsapp">
        <div class="section-header">
          <h2>📱 Integração WhatsApp</h2>
        </div>
        <div class="integration-card">
          <div class="integration-header">
            <span class="integration-icon" style="background:#25D366;">W</span>
            <div>
              <h3>Evolution API</h3>
              <span class="integration-status" id="whatsapp-status">Verificando...</span>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" id="whatsapp-toggle" checked />
              <span class="toggle-slider"></span>
            </label>
          </div>
          <div class="integration-config">
            <div class="form-group">
              <label>URL da API</label>
              <input type="text" id="evolution-url" value="https://api.getnexo.com.br" />
            </div>
            <div class="form-group">
              <label>API Key</label>
              <input type="password" id="evolution-key" placeholder="Sua API Key" />
            </div>
            <div class="form-group">
              <label>Nome da Instância</label>
              <input type="text" id="evolution-instance" value="getnexo" />
            </div>
            <button class="btn-primary" onclick="saveIntegration('whatsapp')">Salvar Configuração</button>
          </div>
        </div>
      </section>



      <!-- Integrações CRM Section -->
      <section class="section-panel" id="section-int-crm">
        <div class="section-header">
          <h2>🏢 Integrações CRM</h2>
        </div>
        <div class="integrations-list" id="crm-integrations">
          <!-- CRM integrations will be loaded -->
        </div>
      </section>

      <!-- Integrações Webhooks Section -->
      <section class="section-panel" id="section-int-webhooks">
        <div class="section-header">
          <h2>🪝 Webhooks & API Events</h2>
          <button class="btn-primary" onclick="openModal('webhook')">+ Novo Webhook</button>
        </div>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>URL</th>
                        <th>Eventos</th>
                        <th>Status</th>
