        </div>

        <div class="wa-container" style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.5rem;">
          <div class="wa-info-panel" style="background: rgba(255,255,255,0.05); padding: 2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1);">
            <h3 style="margin-top: 0; color: white;">Status da Conexão</h3>
            <p id="wa-status-text" style="color: #94a3b8; line-height: 1.6;">Aguarde, verificando status do Evolution API...</p>
            
            <div id="wa-actions" style="margin-top: 2rem; display: flex; gap: 1rem;">
              <button class="btn-secondary" onclick="checkWhatsAppStatus()">🔄 Atualizar Status</button>
              <button id="btn-wa-logout" class="btn-danger" style="display: none;" onclick="logoutWhatsApp()">🚪 Desconectar</button>
            </div>
          </div>

          <div class="wa-qr-panel" id="wa-qr-container" style="background: white; padding: 2rem; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 300px;">
            <div id="wa-qr-code" style="width: 200px; height: 200px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; border-radius: 8px;">
               <span style="color: #64748b; text-align: center; font-size: 0.8rem;">Carregando QR Code...</span>
            </div>
            <p id="wa-qr-hint" style="color: #475569; font-size: 0.8rem; margin-top: 1rem; text-align: center; font-weight: 600;">
              Abra o WhatsApp no seu celular e escaneie o código acima.
            </p>
          </div>
        </div>
      </section>

      <!-- Pedidos Section -->
      <section class="section-panel" id="section-pedidos">
        <div class="section-header">
          <h2>📦 Gerenciar Pedidos</h2>
          <div style="display:flex; gap:1rem;">
            <select id="pedido-status-filter" class="filter-select" onchange="filterPedidos()">
              <option value="">Todos os Status</option>
              <option value="pending">Pendente</option>
              <option value="paid">Pago</option>
              <option value="shipped">Enviado</option>
              <option value="delivered">Entregue</option>
              <option value="cancelled">Cancelado</option>
            </select>
            <button class="btn-secondary" onclick="exportPedidos()">📥 Exportar</button>
          </div>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Pedido</th>
                <th>Cliente</th>
                <th>Produtos</th>
                <th>Total</th>
                <th>Status</th>
                <th>Data</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody id="pedidos-tbody">
              <tr><td colspan="7" class="loading">Carregando pedidos...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Categorias Section -->
      <section class="section-panel" id="section-categorias">
        <div class="section-header">
          <h2>📂 Categorias</h2>
          <button class="btn-primary" onclick="openModal('categoria')">+ Nova Categoria</button>
        </div>
        <div class="categories-grid" id="categories-grid">
          <div class="loading">Carregando categorias...</div>
        </div>
      </section>

      <!-- Estoque Section -->
      <section class="section-panel" id="section-estoque">
        <div class="section-header">
          <h2>📊 Controle de Estoque</h2>
          <button class="btn-secondary" onclick="exportEstoque()">📥 Exportar</button>
        </div>
        <div class="stats-grid" style="margin-bottom:1.5rem;">
          <div class="stat-card">
            <span class="stat-icon">📦</span>
            <div class="stat-info">
              <span class="stat-value" id="estoque-total">0</span>
              <span class="stat-label">Itens em Estoque</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">⚠️</span>
            <div class="stat-info">
              <span class="stat-value" id="estoque-baixo">0</span>
              <span class="stat-label">Estoque Baixo</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">❌</span>
            <div class="stat-info">
              <span class="stat-value" id="estoque-zerado">0</span>
              <span class="stat-label">Sem Estoque</span>
            </div>
          </div>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Produto</th><th>SKU</th><th>Estoque Atual</th><th>Estoque Mínimo</th><th>Status</th><th>Ações</th></tr>
            </thead>
            <tbody id="estoque-tbody">
              <tr><td colspan="6" class="loading">Carregando estoque...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Bot Config Section -->
      <section class="section-panel" id="section-bot-config">
        <div class="section-header">
          <h2>🤖 Configuração do Bot</h2>
        </div>
        <div class="config-form">
          <div class="form-row">
            <div class="form-group">
              <label>Nome do Bot</label>
              <input type="text" id="bot-name" value="Nexo" placeholder="Nome exibido ao cliente" />
            </div>
            <div class="form-group">
              <label>Idioma Principal</label>
              <select id="bot-lang">
                <option value="pt-BR" selected>Português (Brasil)</option>
                <option value="en">English</option>
                <option value="es">Español</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>Saudação Inicial</label>
            <textarea id="bot-greeting" rows="3">Olá! 👋 Sou o assistente virtual do GetNexo. Como posso ajudar você hoje?</textarea>
          </div>
          <div class="form-group">
            <label>Mensagem de Despedida</label>
            <textarea id="bot-farewell" rows="2">Foi um prazer ajudar! 😊 Volte sempre!</textarea>
          </div>
          <div class="form-row">
            <div class="form-group" style="display:flex; align-items:center; gap:1rem;">
              <label class="toggle-switch">
                <input type="checkbox" id="bot-auto-reply" checked />
                <span class="toggle-slider"></span>
              </label>
              <span style="color:white;">Resposta Automática</span>
            </div>
            <div class="form-group" style="display:flex; align-items:center; gap:1rem;">
              <label class="toggle-switch">
                <input type="checkbox" id="bot-typing" checked />
                <span class="toggle-slider"></span>
              </label>
              <span style="color:white;">Simular Digitação</span>
            </div>
          </div>
          <div class="form-group">
            <label>Tempo de Espera (segundos)</label>
            <input type="number" id="bot-delay" value="2" min="0" max="10" style="width:100px;" />
          </div>
          <button class="btn-primary" onclick="saveBotConfig()">Salvar Configurações</button>
        </div>
      </section>

      <!-- Filas Section -->
      <section class="section-panel" id="section-filas">
        <div class="section-header">
          <h2>📋 Filas de Atendimento</h2>
          <button class="btn-primary" onclick="openModal('fila')">+ Nova Fila</button>
        </div>
        <div class="queues-grid" id="queues-grid">
           <!-- Loaded via JS -->
        </div>
      </section>

      <!-- Sessões Section -->
      <section class="section-panel" id="section-seg-sessoes">
        <div class="section-header">
          <h2>🔐 Sessões Ativas</h2>
          <button class="btn-danger" onclick="revokeAllSessions()">🚫 Encerrar Todas</button>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Usuário</th><th>IP</th><th>Dispositivo</th><th>Localização</th><th>Iniciada em</th><th>Ações</th></tr>
            </thead>
            <tbody id="sessions-tbody">
              <tr>
                <td>Admin User</td>
                <td><code>177.45.xxx.xxx</code></td>
                <td>Chrome / Linux</td>
                <td>São Paulo, BR</td>
                <td>Há 2 horas</td>
                <td>
                  <span class="status-badge online" style="font-size:0.75rem;">Sessão Atual</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>



      <!-- Notificações Config Section -->
      <section class="section-panel" id="section-cfg-notificacoes">
        <div class="section-header">
          <h2>🔔 Configuração de Notificações</h2>
        </div>
        <div class="config-form">
          <h4 style="color:white; margin-bottom:1rem;">📧 Notificações por Email</h4>
          <div class="notifications-grid">
            <div class="notification-item">
              <label class="toggle-switch">
                <input type="checkbox" checked data-notif="new_order" />
                <span class="toggle-slider"></span>
              </label>
              <span>Novo pedido recebido</span>
            </div>
            <div class="notification-item">
              <label class="toggle-switch">
                <input type="checkbox" checked data-notif="new_lead" />
                <span class="toggle-slider"></span>
              </label>
              <span>Novo lead capturado</span>
            </div>
            <div class="notification-item">
              <label class="toggle-switch">
                <input type="checkbox" data-notif="low_stock" />
                <span class="toggle-slider"></span>
              </label>
              <span>Estoque baixo</span>
            </div>
            <div class="notification-item">
              <label class="toggle-switch">
                <input type="checkbox" data-notif="new_message" />
                <span class="toggle-slider"></span>
              </label>
              <span>Nova mensagem (quando offline)</span>
            </div>
          </div>
          
          <h4 style="color:white; margin:2rem 0 1rem;">📱 Notificações Push</h4>
          <div class="notifications-grid">
            <div class="notification-item">
              <label class="toggle-switch">
                <input type="checkbox" checked data-push="order" />
                <span class="toggle-slider"></span>
              </label>
              <span>Push no navegador</span>
            </div>
            <div class="notification-item">
              <label class="toggle-switch">
                <input type="checkbox" data-push="sound" />
                <span class="toggle-slider"></span>
              </label>
              <span>Som de notificação</span>
            </div>
          </div>
          
          <button class="btn-primary" style="margin-top:1.5rem;" onclick="saveNotifications()">Salvar Preferências</button>
        </div>
      </section>

      <!-- Relatório Vendas Section -->
      <section class="section-panel" id="section-rel-vendas">
        <div class="section-header">
          <h2>📊 Relatório de Vendas</h2>
          <div style="display:flex; gap:1rem;">
            <select id="rel-vendas-periodo" class="filter-select">
              <option value="7d">Últimos 7 dias</option>
              <option value="30d" selected>Últimos 30 dias</option>
              <option value="90d">Últimos 90 dias</option>
              <option value="1y">Último ano</option>
            </select>
            <button class="btn-secondary" onclick="exportRelVendas()">📥 Exportar</button>
          </div>
        </div>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon">💰</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-total-vendas">R$ 0</span>
              <span class="stat-label">Faturamento Total</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">🛒</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-qtd-pedidos">0</span>
              <span class="stat-label">Pedidos</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">📈</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-ticket-medio">R$ 0</span>
              <span class="stat-label">Ticket Médio</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">🔄</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-taxa-conversao">0%</span>
              <span class="stat-label">Taxa de Conversão</span>
            </div>
          </div>
        </div>
        <div class="chart-container" style="margin-top:1.5rem; background:rgba(20,30,50,0.6); border:1px solid #1f2937; border-radius:16px; padding:1.5rem;">
          <canvas id="chart-vendas" height="300"></canvas>
        </div>
      </section>

      <!-- Relatório Leads Section -->
      <section class="section-panel" id="section-rel-leads">
        <div class="section-header">
          <h2>👥 Relatório de Leads</h2>
          <button class="btn-secondary" onclick="exportRelLeads()">📥 Exportar</button>
        </div>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon">👥</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-total-leads">0</span>
              <span class="stat-label">Total de Leads</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">🆕</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-novos-leads">0</span>
              <span class="stat-label">Novos (30 dias)</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">✅</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-convertidos">0</span>
              <span class="stat-label">Convertidos</span>
            </div>
          </div>
        </div>
        <div class="table-container" style="margin-top:1.5rem;">
          <table>
            <thead>
              <tr><th>Fonte</th><th>Leads</th><th>Conversões</th><th>Taxa</th></tr>
            </thead>
            <tbody id="leads-source-tbody">
              <tr><td>WhatsApp</td><td>245</td><td>89</td><td><span class="status-badge online">36.3%</span></td></tr>
              <tr><td>Site</td><td>128</td><td>34</td><td><span class="status-badge">26.6%</span></td></tr>
              <tr><td>Instagram</td><td>67</td><td>12</td><td><span class="status-badge">17.9%</span></td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Relatório Atendimento Section -->
      <section class="section-panel" id="section-rel-atendimento">
        <div class="section-header">
          <h2>💬 Relatório de Atendimento</h2>
          <button class="btn-secondary" onclick="exportRelAtendimento()">📥 Exportar</button>
        </div>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon">💬</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-total-conversas">0</span>
              <span class="stat-label">Conversas</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">⏱️</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-tempo-resposta">0s</span>
              <span class="stat-label">Tempo Médio Resposta</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">⭐</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-csat">0%</span>
              <span class="stat-label">Satisfação (CSAT)</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">🤖</span>
            <div class="stat-info">
              <span class="stat-value" id="rel-bot-taxa">0%</span>
              <span class="stat-label">Resolvido pelo Bot</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Relatório Performance Section -->
      <section class="section-panel" id="section-rel-performance">
        <div class="section-header">
          <h2>⚡ Performance do Sistema</h2>
        </div>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-icon">🚀</span>
            <div class="stat-info">
              <span class="stat-value" id="perf-uptime">99.9%</span>
              <span class="stat-label">Uptime</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">⏱️</span>
            <div class="stat-info">
              <span class="stat-value" id="perf-latencia">42ms</span>
              <span class="stat-label">Latência Média</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">🔌</span>
            <div class="stat-info">
              <span class="stat-value" id="perf-conexoes">1.2k</span>
              <span class="stat-label">Conexões Ativas</span>
            </div>
          </div>
          <div class="stat-card">
            <span class="stat-icon">📤</span>
            <div class="stat-info">
              <span class="stat-value" id="perf-mensagens">45k</span>
              <span class="stat-label">Mensagens/dia</span>
            </div>
          </div>
        </div>
        <div class="services-status" style="margin-top:1.5rem;">
          <h4 style="color:white; margin-bottom:1rem;">Status dos Serviços</h4>
          <div class="services-grid">
            <div class="service-item"><span class="status-badge online">●</span> WhatsApp API</div>
            <div class="service-item"><span class="status-badge online">●</span> Backend API</div>
            <div class="service-item"><span class="status-badge online">●</span> Database</div>
            <div class="service-item"><span class="status-badge online">●</span> AI Service</div>
            <div class="service-item"><span class="status-badge online">●</span> Email Service</div>
            <div class="service-item"><span class="status-badge online">●</span> Storage</div>
          </div>
        </div>
      </section>

      <!-- Exportar Section -->
      <section class="section-panel" id="section-rel-exportar">
        <div class="section-header">
          <h2>📥 Exportar Dados</h2>
        </div>
        <div class="export-cards">
          <div class="export-card" onclick="exportData('vendas')">
            <span class="export-icon">💰</span>
            <h3>Vendas</h3>
            <p>Pedidos, transações, faturamento</p>
          </div>
          <div class="export-card" onclick="exportData('leads')">
            <span class="export-icon">👥</span>
            <h3>Leads</h3>
            <p>Contatos, origem, conversões</p>
          </div>
          <div class="export-card" onclick="exportData('produtos')">
            <span class="export-icon">📦</span>
            <h3>Produtos</h3>
            <p>Catálogo, preços, estoque</p>
          </div>
          <div class="export-card" onclick="exportData('conversas')">
            <span class="export-icon">💬</span>
            <h3>Conversas</h3>
            <p>Histórico de mensagens</p>
          </div>
          <div class="export-card" onclick="exportData('clientes')">
            <span class="export-icon">🏢</span>
            <h3>Clientes</h3>
            <p>Dados de clientes</p>
          </div>
          <div class="export-card" onclick="exportData('auditoria')">
            <span class="export-icon">📋</span>
            <h3>Logs</h3>
            <p>Auditoria e atividades</p>
          </div>
        </div>
      </section>

      <!-- IA Histórico Section -->
      <section class="section-panel" id="section-ia-historico">
        <div class="section-header">
          <h2>📜 Histórico de IA</h2>
          <button class="btn-secondary" onclick="clearIAHistory()">🗑️ Limpar Histórico</button>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Data</th><th>Usuário</th><th>Pergunta</th><th>Resposta</th><th>Modelo</th></tr>
            </thead>
            <tbody id="ia-history-tbody">
              <tr><td colspan="5" class="loading">Carregando histórico...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </main>
</div>

<!-- Command Palette Modal -->
<div class="command-palette" id="command-palette" style="display:none;">
  <div class="command-content">
    <input type="text" id="command-input" placeholder="Digite um comando ou busque..." autofocus />
    <div class="command-results" id="command-results">
      <div class="command-group">
        <span class="command-group-title">Ações Rápidas</span>
        <button class="command-item" data-action="produtos">🛍️ Ir para Produtos</button>
        <button class="command-item" data-action="cupons">🎟️ Ir para Cupons</button>
        <button class="command-item" data-action="campanhas">📢 Ir para Campanhas</button>
        <button class="command-item" data-action="ia-provedores">🤖 Configurar IA</button>
        <button class="command-item" data-action="macros">⚡ Macros</button>
        <button class="command-item" data-action="horarios">🕐 Horários</button>
        <button class="command-item" data-action="int-webhooks">🔗 Webhooks</button>
        <button class="command-item" data-action="cfg-backup">💾 Backup</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Produto -->
<div class="modal-overlay" id="modal-produto" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modal-produto-title">Novo Produto</h2>
      <button class="modal-close" onclick="closeModal('produto')">&times;</button>
    </div>
    <form id="form-produto" onsubmit="saveProduto(event)">
      <input type="hidden" id="produto-id" />
      <div class="form-row">
        <div class="form-group">
          <label>Nome do Produto *</label>
          <input type="text" id="produto-nome" required placeholder="Ex: Camiseta Premium" />
        </div>
        <div class="form-group">
          <label>SKU</label>
          <input type="text" id="produto-sku" placeholder="SKU-001" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Preço *</label>
          <input type="number" id="produto-preco" required step="0.01" min="0" placeholder="99.90" />
        </div>
        <div class="form-group">
          <label>Preço Promocional</label>
          <input type="number" id="produto-preco-promo" step="0.01" min="0" placeholder="79.90" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Estoque</label>
          <input type="number" id="produto-estoque" min="0" placeholder="100" />
        </div>
        <div class="form-group">
          <label>Categoria</label>
          <select id="produto-categoria">
            <option value="">Selecione...</option>
            <option value="roupas">Roupas</option>
            <option value="eletronicos">Eletrônicos</option>
            <option value="acessorios">Acessórios</option>
            <option value="outros">Outros</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Descrição</label>
        <textarea id="produto-descricao" rows="3" placeholder="Descreva o produto..."></textarea>
      </div>
      <div class="form-group">
        <label>URL da Imagem</label>
        <input type="url" id="produto-imagem" placeholder="https://..." />
      </div>
      <div class="form-group" style="display:flex; align-items:center; gap:1rem;">
        <label class="toggle-switch">
          <input type="checkbox" id="produto-ativo" checked />
          <span class="toggle-slider"></span>
        </label>
        <span style="color:white;">Produto Ativo</span>
      </div>
      <div class="modal-actions">
