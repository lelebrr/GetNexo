  window.triggerExport = async function(type) {
      const start = document.getElementById('export-start').value;
      const end = document.getElementById('export-end').value;
      
      showToast(`Gerando relatório de ${type}...`, 'info');
      
      // Simulation of delay and download
      setTimeout(() => {
          showToast('Download iniciado!', 'success');
          // In real app: window.location.href = `/api/export/${type}?start=${start}&end=${end}`;
          
          // Create dummy CSV
          let csvContent = "data:text/csv;charset=utf-8,";
          if(type === 'sales') csvContent += "ID,Data,Valor,Status\n1,2023-10-01,150.00,Pago\n2,2023-10-02,200.00,Pendente";
          else if(type === 'leads') csvContent += "Nome,Email,Telefone\nMaria,maria@email.com,1199999999";
          else csvContent += "ChatID,Cliente,Data\n101,Joao,2023-10-01";
          
          const encodedUri = encodeURI(csvContent);
          const link = document.createElement("a");
          link.setAttribute("href", encodedUri);
          link.setAttribute("download", `relatorio_${type}_${new Date().toISOString().slice(0,10)}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
      }, 1500);
  };

