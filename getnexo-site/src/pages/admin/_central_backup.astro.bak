<!-- Modal Cupom -->
<div class="modal-overlay" id="modal-cupom" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modal-cupom-title">Novo Cupom</h2>
      <button class="modal-close" onclick="closeModal('cupom')">&times;</button>
    </div>
    <form id="form-cupom" onsubmit="saveCupom(event)">
      <input type="hidden" id="cupom-id" />
      <div class="form-row">
        <div class="form-group">
          <label>Código do Cupom *</label>
          <input type="text" id="cupom-codigo" required placeholder="PROMO20" style="text-transform:uppercase;" />
        </div>
        <div class="form-group">
          <label>Tipo de Desconto *</label>
          <select id="cupom-tipo" required>
            <option value="percent">Porcentagem (%)</option>
            <option value="fixed">Valor Fixo (R$)</option>
            <option value="frete">Frete Grátis</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Valor do Desconto *</label>
          <input type="number" id="cupom-valor" required min="0" step="0.01" placeholder="20" />
        </div>
        <div class="form-group">
          <label>Valor Mínimo do Pedido</label>
          <input type="number" id="cupom-minimo" min="0" step="0.01" placeholder="100" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Data de Expiração</label>
          <input type="date" id="cupom-expira" />
        </div>
        <div class="form-group">
          <label>Limite de Usos</label>
          <input type="number" id="cupom-limite" min="0" placeholder="Ilimitado" />
        </div>
      </div>
      <div class="form-group">
        <label>Descrição</label>
        <input type="text" id="cupom-descricao" placeholder="Descrição interna do cupom" />
      </div>
      <div class="form-group" style="display:flex; align-items:center; gap:1rem;">
        <label class="toggle-switch">
          <input type="checkbox" id="cupom-ativo" checked />
          <span class="toggle-slider"></span>
        </label>
        <span style="color:white;">Cupom Ativo</span>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" onclick="closeModal('cupom')">Cancelar</button>
        <button type="submit" class="btn-primary">Salvar Cupom</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Macro -->
<div class="modal-overlay" id="modal-macro" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modal-macro-title">Nova Macro</h2>

<!-- Modal Mailchimp -->
<div class="modal-overlay" id="modal-mailchimp" style="display:none;">
  <div class="modal-content">
    <div class="modal-header">
      <h2>🐒 Configurar Mailchimp</h2>
      <button class="close-modal" onclick="closeModal('mailchimp')">&times;</button>
    </div>
    <div class="config-form">
      <div class="form-group">
        <label>API Key</label>
        <input type="password" id="mc-apikey" placeholder="Ex: md-..." />
      </div>
      <div class="form-row">
        <div class="form-group">
            <label>Server Prefix (ex: us17)</label>
            <input type="text" id="mc-prefix" placeholder="us17" />
        </div>
        <div class="form-group">
            <label>Audience ID (Opcional)</label>
            <input type="text" id="mc-audience" placeholder="Auto-detectar" />
        </div>
      </div>
      <!-- Transactional Email Extension -->
      <div style="margin-top:1rem; padding-top:1rem; border-top:1px solid #334155;">
          <h4 style="color:#fbbf24; margin-bottom:0.5rem; font-size:0.9rem;">Transactional API (Mandrill) - Opcional</h4>
          <div class="form-group">
            <label>Mandrill API Key</label>
            <input type="password" id="mc-mandrill" placeholder="md-..." />
          </div>
          <div class="form-group">
            <label>Email do Remetente</label>
            <input type="email" id="mc-sender" placeholder="noreply@suaempresa.com" />
          </div>
      </div>
      <div class="form-group" style="display:flex; align-items:center; gap:1rem; margin-top:1rem;">
        <label class="toggle-switch">
          <input type="checkbox" id="mc-active" />
          <span class="toggle-slider"></span>
        </label>
        <span style="color:white;">Ativar Integração</span>
      </div>
      
      <div style="margin-top:2rem; padding-top:1rem; border-top:1px solid #334155;">
          <button class="btn-secondary" onclick="triggerMailchimpSync()" style="width:100%; margin-bottom:1rem;">🔄 Forçar Sincronização Agora</button>
      </div>

      <div class="modal-actions">
        <button class="btn-secondary" onclick="closeModal('mailchimp')">Cancelar</button>
        <button class="btn-primary" onclick="saveMailchimpConfig()">Salvar Configuração</button>
      </div>
    </div>
  </div>
</div>

