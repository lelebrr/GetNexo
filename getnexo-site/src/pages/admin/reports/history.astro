---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { History, Search, Filter, Download, Trash2, FileSpreadsheet, Eye } from 'lucide-react';

const reportHistory = [
  { id: 1, name: "Vendas_Janeiro_Consolidado.xlsx", date: "Hoje, 09:45", size: "2.4 MB", status: "Pronto" },
  { id: 2, name: "CRM_Leads_Funnel.csv", date: "Hoje, 11:20", size: "840 KB", status: "Pronto" },
  { id: 3, name: "Auditoria_Estoque_Geral_Full.pdf", date: "Ontem, 23:58", size: "12.8 MB", status: "Pronto" },
];
---

<AdminLayout title="Histórico de Relatórios" activeTab="relatorios">
  <div class="max-w-6xl mx-auto space-y-10 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-blue-500/10 rounded-2xl flex items-center justify-center text-blue-500 border border-blue-500/20 shadow-xl shadow-blue-500/10">
          <History className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Arquivo de Saída</h1>
          <p class="text-sm text-gray-500 font-medium">Acesse o histórico de arquivos gerados e exportados pelo sistema.</p>
        </div>
      </div>
    </div>

    <!-- Search/Filter -->
    <div class="bg-gray-900/40 border border-gray-800 p-4 rounded-[2rem] flex flex-col md:flex-row gap-4 items-center">
       <div class="flex-1 relative w-full">
          <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" />
          <input type="text" placeholder="Filtrar por nome do arquivo..." class="w-full bg-black/40 border border-gray-800 rounded-2xl py-3 pl-12 pr-4 text-xs text-white focus:border-blue-500 outline-none" />
       </div>
       <button class="px-6 py-3 bg-gray-800 text-gray-400 hover:text-white rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all flex items-center space-x-2">
          <Filter className="w-4 h-4" />
          <span>Filtros Avançados</span>
       </button>
    </div>

    <!-- History list -->
    <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <div class="divide-y divide-gray-800/50">
          {reportHistory.map(item => (
             <div class="p-8 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                <div class="flex items-center space-x-6">
                   <div class="w-12 h-12 bg-gray-800 rounded-xl flex items-center justify-center text-gray-600 group-hover:bg-blue-600 group-hover:text-white transition-all">
                      <FileSpreadsheet className="w-6 h-6" />
                   </div>
                   <div>
                      <h4 class="text-sm font-bold text-white uppercase tracking-tight">{item.name}</h4>
                      <p class="text-[10px] text-gray-500 font-medium">Gerado em {item.date} • {item.size}</p>
                   </div>
                </div>

                <div class="flex items-center space-x-3">
                   <button class="p-3 bg-gray-800/50 text-gray-500 hover:bg-white/10 hover:text-white rounded-xl transition-all shadow-sm"><Eye className="w-4 h-4" /></button>
                   <button class="p-3 bg-blue-600 text-white rounded-xl transition-all hover:bg-blue-500 shadow-lg shadow-blue-600/20"><Download className="w-4 h-4" /></button>
                   <button class="p-3 bg-gray-800/50 text-gray-500 hover:bg-rose-600/20 hover:text-rose-400 rounded-xl transition-all shadow-sm"><Trash2 className="w-4 h-4" /></button>
                </div>
             </div>
          ))}
       </div>
    </div>

    <!-- Storage Usage -->
    <div class="p-6 bg-blue-600/10 border border-blue-500/20 rounded-[2rem] flex items-center justify-between">
       <p class="text-[10px] font-black text-blue-500 uppercase tracking-widest italic">Uso de Armazenamento: 4.2 GB de 10 GB</p>
       <div class="w-48 h-1.5 bg-gray-800 rounded-full overflow-hidden">
          <div class="w-[42%] h-full bg-blue-500"></div>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
