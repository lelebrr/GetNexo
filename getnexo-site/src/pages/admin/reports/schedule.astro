---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Calendar, Plus, Clock, FileText, Trash2, Edit3, CheckCircle2 } from 'lucide-react';

const schedules = [
  { id: 1, name: "Diário de Caixa", time: "07:30", freq: "Diariamente", dest: "Financeiro (Slack)" },
  { id: 2, name: "Status Logístico", time: "23:00", freq: "Segunda a Sexta", dest: "Diretoria (Email)" },
];
---

<AdminLayout title="Agendamento" activeTab="relatorios">
  <div class="max-w-4xl mx-auto space-y-10 animate-fade-in py-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-blue-500/10 rounded-2xl flex items-center justify-center text-blue-500 border border-blue-500/20 shadow-xl shadow-blue-500/10">
          <Calendar className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Entregas Auto</h1>
          <p class="text-sm text-gray-500 font-medium">Automatize o envio de relatórios para seu time via Email, Slack ou WhatsApp.</p>
        </div>
      </div>
      <button class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-black rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-blue-600/20 uppercase text-xs tracking-widest">
         <Plus className="w-5 h-5" />
         <span>Novo Agendamento</span>
      </button>
    </div>

    <!-- Active Schedules -->
    <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <div class="p-8 border-b border-gray-800 bg-black/20 italic">
          <h3 class="text-[10px] font-black uppercase text-gray-500 tracking-widest">Fila de Automação de Dados</h3>
       </div>

       <div class="divide-y divide-gray-800/50">
          {schedules.map(sch => (
             <div class="p-8 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                <div class="flex items-center space-x-6">
                   <div class="w-12 h-12 bg-gray-800 rounded-xl flex items-center justify-center text-gray-500 group-hover:bg-blue-600 group-hover:text-white transition-all">
                      <Clock className="w-6 h-6" />
                   </div>
                   <div>
                      <h4 class="text-sm font-bold text-white uppercase tracking-tight">{sch.name}</h4>
                      <p class="text-[10px] text-gray-500 font-medium uppercase tracking-widest">{sch.dest}</p>
                   </div>
                </div>

                <div class="flex items-center space-x-12">
                   <div class="text-right">
                      <p class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Frequência</p>
                      <p class="text-xs font-bold text-white">{sch.freq} às {sch.time}</p>
                   </div>
                   <div class="flex items-center space-x-2">
                      <button class="p-2.5 bg-gray-800/50 text-gray-500 hover:text-white rounded-xl transition-all"><Edit3 className="w-4 h-4" /></button>
                      <button class="p-2.5 bg-gray-800/50 text-gray-500 hover:text-rose-400 rounded-xl transition-all"><Trash2 className="w-4 h-4" /></button>
                   </div>
                </div>
             </div>
          ))}
       </div>
    </div>

    <div class="p-6 bg-emerald-500/10 border border-emerald-500/20 rounded-[2rem] flex items-center justify-between">
       <div class="flex items-center space-x-3">
          <CheckCircle2 className="w-5 h-5 text-emerald-500" />
          <p class="text-[10px] text-gray-400 font-medium uppercase tracking-widest italic">Todas as tarefas de agendamento estão operando normalmente.</p>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
