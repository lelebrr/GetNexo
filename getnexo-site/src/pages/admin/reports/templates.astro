---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Layout, Plus, FileText, Search, Settings, ArrowRight, Download } from 'lucide-react';

const reportTemplates = [
  { id: 1, name: "Fechamento Mensal de Vendas", desc: "Análise completa de faturamento, impostos e margem.", category: "Financeiro" },
  { id: 2, name: "Fluxo de CRM por Tag", desc: "Monitoramento de conversão em cada etapa do funil.", category: "Vendas" },
  { id: 3, name: "Auditoria de Estoque Global", desc: "Lista de discrepâncias entre lojas físicas e virtuais.", category: "Logística" },
];
---

<AdminLayout title="Templates de Relatório" activeTab="relatorios">
  <div class="max-w-6xl mx-auto space-y-10 animate-fade-in py-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-blue-500/10 rounded-2xl flex items-center justify-center text-blue-500 border border-blue-500/20 shadow-xl shadow-blue-500/10">
          <Layout className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Modelos de Análise</h1>
          <p class="text-sm text-gray-500 font-medium">Crie layouts de dados personalizados para exportação recorrente.</p>
        </div>
      </div>
      <button class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-black rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-blue-600/20 uppercase text-xs tracking-widest">
         <Plus className="w-5 h-5" />
         <span>Novo Template</span>
      </button>
    </div>

    <!-- Templates Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
       {reportTemplates.map(tpl => (
          <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] hover:border-blue-500/40 transition-all group relative overflow-hidden flex flex-col justify-between h-[300px]">
             <div class="absolute -right-4 -top-4 w-24 h-24 bg-blue-500/10 blur-3xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
             
             <div>
                <div class="flex justify-between items-start mb-6">
                   <div class="w-12 h-12 bg-gray-800 rounded-xl flex items-center justify-center text-gray-500 group-hover:bg-blue-600 group-hover:text-white transition-all">
                      <FileText className="w-6 h-6" />
                   </div>
                   <span class="text-[8px] font-black text-gray-500 uppercase tracking-widest bg-black/40 px-2 py-1 rounded-md">{tpl.category}</span>
                </div>
                <h3 class="text-lg font-bold text-white uppercase tracking-tight leading-tight">{tpl.name}</h3>
                <p class="text-[10px] text-gray-600 font-medium mt-2 leading-relaxed">{tpl.desc}</p>
             </div>

             <div class="flex items-center justify-between pt-6 border-t border-gray-800/50">
                <button class="p-2.5 bg-gray-800 hover:bg-white/10 text-gray-400 hover:text-white rounded-xl transition-all"><Settings className="w-4 h-4" /></button>
                <button class="flex items-center space-x-2 px-4 py-2 bg-blue-600/10 text-blue-500 text-[10px] font-black uppercase rounded-xl hover:bg-blue-600 hover:text-white transition-all tracking-widest">
                   <span>Gerar Agora</span>
                   <ArrowRight className="w-3.5 h-3.5" />
                </button>
             </div>
          </div>
       ))}

       <!-- Custom / New -->
       <div class="bg-black/40 border-2 border-dashed border-gray-800 p-8 rounded-[2.5rem] hover:border-blue-500/20 transition-all group cursor-pointer flex flex-col items-center justify-center text-center space-y-4">
          <div class="w-16 h-16 bg-gray-900 rounded-full flex items-center justify-center text-gray-700 group-hover:bg-blue-600 group-hover:text-white transition-all shadow-xl">
             <Plus className="w-8 h-8" />
          </div>
          <h4 class="text-lg font-bold text-white uppercase tracking-tight">Análise Livre</h4>
          <p class="text-[10px] text-gray-600 font-medium whitespace-pre-line">Selecione colunas e filtros
          em tempo real.</p>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
