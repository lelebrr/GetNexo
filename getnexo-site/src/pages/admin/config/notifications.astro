---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Bell, Smartphone, Mail, Smartphone as WhatsApp, CheckCircle2, AlertCircle, Save } from 'lucide-react';

const channels = [
  { id: 1, name: "Venda Realizada", email: true, sms: false, push: true, wa: true },
  { id: 2, name: "Carrinho Abandonado", email: true, sms: true, push: false, wa: true },
  { id: 3, name: "Login Suspeito", email: true, sms: true, push: true, wa: false },
  { id: 4, name: "Estoque Baixo", email: true, sms: false, push: true, wa: false },
];
---

<AdminLayout title="Central de Alertas" activeTab="config">
  <div class="max-w-5xl mx-auto space-y-10 animate-fade-in py-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-gray-500/10 rounded-2xl flex items-center justify-center text-white border border-gray-500/20 shadow-xl shadow-gray-500/10">
          <Bell className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Alertas do Sistema</h1>
          <p class="text-sm text-gray-500 font-medium">Configure onde e quando você (e seus clientes) devem receber notificações.</p>
        </div>
      </div>
      <button class="px-8 py-4 bg-white text-black font-black rounded-2xl flex items-center space-x-3 transition-all hover:bg-gray-200 shadow-xl uppercase text-xs tracking-widest">
         <Save className="w-5 h-5" />
         <span>Salvar Matriz</span>
      </button>
    </div>

    <!-- Notification Matrix -->
    <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <table class="w-full text-left">
          <thead>
             <tr class="bg-black/40 border-b border-gray-800">
                <th class="px-8 py-6 text-[10px] font-black uppercase text-gray-500 tracking-widest">Gatilho / Evento</th>
                <th class="px-8 py-6 text-center text-[10px] font-black uppercase text-gray-500 tracking-widest">Email</th>
                <th class="px-8 py-6 text-center text-[10px] font-black uppercase text-gray-500 tracking-widest">SMS</th>
                <th class="px-8 py-6 text-center text-[10px] font-black uppercase text-gray-500 tracking-widest">Push</th>
                <th class="px-8 py-6 text-center text-[10px] font-black uppercase text-gray-500 tracking-widest">WhatsApp</th>
             </tr>
          </thead>
          <tbody class="divide-y divide-gray-800/50">
             {channels.map(ch => (
                <tr class="hover:bg-white/[0.02] transition-colors">
                   <td class="px-8 py-6">
                      <h4 class="text-sm font-bold text-white uppercase tracking-tight italic">{ch.name}</h4>
                   </td>
                   <td class="px-8 py-6 text-center">
                      <button class:list={["w-5 h-5 rounded-md mx-auto border flex items-center justify-center transition-all", ch.email ? 'bg-emerald-500 border-emerald-400 text-white' : 'bg-gray-800 border-gray-700 text-transparent']}>
                         <CheckCircle2 className="w-3 h-3" />
                      </button>
                   </td>
                   <td class="px-8 py-6 text-center">
                      <button class:list={["w-5 h-5 rounded-md mx-auto border flex items-center justify-center transition-all", ch.sms ? 'bg-emerald-500 border-emerald-400 text-white' : 'bg-gray-800 border-gray-700 text-transparent']}>
                         <CheckCircle2 className="w-3 h-3" />
                      </button>
                   </td>
                   <td class="px-8 py-6 text-center">
                      <button class:list={["w-5 h-5 rounded-md mx-auto border flex items-center justify-center transition-all", ch.push ? 'bg-emerald-500 border-emerald-400 text-white' : 'bg-gray-800 border-gray-700 text-transparent']}>
                         <CheckCircle2 className="w-3 h-3" />
                      </button>
                   </td>
                   <td class="px-8 py-6 text-center">
                      <button class:list={["w-5 h-5 rounded-md mx-auto border flex items-center justify-center transition-all", ch.wa ? 'bg-emerald-500 border-emerald-400 text-white' : 'bg-gray-800 border-gray-700 text-transparent']}>
                         <CheckCircle2 className="w-3 h-3" />
                      </button>
                   </td>
                </tr>
             ))}
          </tbody>
       </table>
    </div>

    <div class="bg-indigo-600/5 border border-indigo-500/20 p-8 rounded-[2.5rem] flex items-center justify-between">
       <div class="flex items-center space-x-4">
          <AlertCircle className="w-6 h-6 text-indigo-400 shrink-0" />
          <p class="text-[10px] text-gray-400 font-medium uppercase tracking-widest leading-relaxed">Cuidado: O excesso de notificações pode aumentar consideravelmente seus custos de SMS e WhatsApp API.</p>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
