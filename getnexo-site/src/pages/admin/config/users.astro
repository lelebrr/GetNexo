---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Users, Plus, Shield, Mail, Phone, MoreVertical, Search, Edit3, Trash2 } from 'lucide-react';

const admins = [
  { id: 1, name: "Lucas Fernandes", email: "lucas@getnexo.com.br", role: "Super Admin", status: "Online" },
  { id: 2, name: "Mariana Costa", email: "mari@nexo.com.br", role: "Vendedor", status: "Offline" },
  { id: 3, name: "Roberto Silva", email: "beto@beto.io", role: "Auditor", status: "Offline" },
];
---

<AdminLayout title="Usuários & Acessos" activeTab="config">
  <div class="max-w-6xl mx-auto space-y-10 animate-fade-in py-4">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-gray-500/10 rounded-2xl flex items-center justify-center text-white border border-gray-500/20 shadow-xl shadow-gray-500/10">
          <Users className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Equipe Admin</h1>
          <p class="text-sm text-gray-500 font-medium">Gerencie quem tem acesso ao painel e seus respectivos níveis de permissão.</p>
        </div>
      </div>
      <button class="px-6 py-3 bg-white text-black font-black rounded-2xl flex items-center space-x-2 transition-all hover:bg-gray-200 uppercase text-xs tracking-widest">
         <Plus className="w-5 h-5" />
         <span>Convidar Membro</span>
      </button>
    </div>

    <!-- User Table -->
    <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <div class="p-8 border-b border-gray-800 bg-black/20 flex items-center justify-between">
          <div class="relative max-w-xs w-full">
             <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" />
             <input type="text" placeholder="Buscar por nome ou email..." class="w-full bg-black/40 border border-gray-800 rounded-xl py-2.5 pl-11 pr-4 text-[10px] text-white outline-none focus:border-white/20 transition-all font-medium" />
          </div>
       </div>

       <div class="divide-y divide-gray-800/50">
          {admins.map(admin => (
             <div class="p-8 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                <div class="flex items-center space-x-6">
                   <div class="relative">
                      <div class="w-12 h-12 bg-gray-800 rounded-xl flex items-center justify-center text-gray-600 font-bold group-hover:bg-white group-hover:text-black transition-all">
                         {admin.name[0]}
                      </div>
                      <div class:list={["absolute -right-1 -bottom-1 w-3.5 h-3.5 border-2 border-black rounded-full", admin.status === 'Online' ? 'bg-emerald-500' : 'bg-gray-700']}></div>
                   </div>
                   <div>
                      <h4 class="text-sm font-bold text-white uppercase tracking-tight">{admin.name}</h4>
                      <p class="text-[10px] text-gray-500 font-medium italic">{admin.email}</p>
                   </div>
                </div>

                <div class="flex items-center space-x-12">
                   <div class="text-right">
                      <p class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Permissão</p>
                      <div class="flex items-center justify-end space-x-2 text-white">
                         <Shield className="w-3 h-3 text-gray-500" />
                         <span class="text-[10px] font-bold uppercase">{admin.role}</span>
                      </div>
                   </div>
                   <div class="flex items-center space-x-2">
                      <button class="p-2.5 bg-gray-800/50 text-gray-500 hover:text-white rounded-xl transition-all"><Edit3 className="w-4 h-4" /></button>
                      <button class="p-2.5 bg-gray-800/50 text-gray-500 hover:text-rose-400 rounded-xl transition-all"><Trash2 className="w-4 h-4" /></button>
                   </div>
                </div>
             </div>
          ))}
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
