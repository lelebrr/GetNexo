---
import AdminLayout from '../../layouts/AdminLayout.astro';
import LiveConversations from '../../components/admin/LiveConversations';
---

<AdminLayout title="Operations Hub">
    <div class="hub-grid">
        <!-- Left: Stats and Commands -->
        <div class="sidebar-stats">
            <div class="stats-grid">
                <div class="cyber-card stat-item">
                    <div class="stat-header">
                        <span class="icon">💬</span>
                        <span class="label">Conversas</span>
                    </div>
                    <div class="value">1,242</div>
                    <div class="trend up">+15%</div>
                </div>
                <div class="cyber-card stat-item">
                    <div class="stat-header">
                        <span class="icon">💰</span>
                        <span class="label">Vendas</span>
                    </div>
                    <div class="value">R$ 12k</div>
                    <div class="trend up">+5%</div>
                </div>
            </div>

            <div class="cyber-card commands-box">
                <h3>Global Commands</h3>
                <div class="cmd-list">
                    <button class="btn-cmd">
                        <span class="ico">🔄</span>
                        <span class="tit">Atualizar Padrões</span>
                    </button>
                    <button class="btn-cmd">
                        <span class="ico">💾</span>
                        <span class="tit">Ver Backups</span>
                    </button>
                    <button class="btn-cmd">
                        <span class="ico">🧹</span>
                        <span class="tit">Limpar Logs</span>
                    </button>
                    <button class="btn-cmd danger">
                        <span class="ico">🚨</span>
                        <span class="tit">Emergency Reset</span>
                    </button>
                </div>
            </div>

            <div class="cyber-card system-health">
                <h3>System Health</h3>
                <div class="health-item">
                    <span>API Core</span>
                    <span class="status online">STABLE</span>
                </div>
                <div class="health-item">
                    <span>Database</span>
                    <span class="status online">CONNECTED</span>
                </div>
                <div class="health-item">
                    <span>Evolution API</span>
                    <span class="status online">ACTIVE</span>
                </div>
            </div>
        </div>

        <!-- Right: Live Conversations -->
        <div class="live-area">
            <div class="cyber-card">
                <LiveConversations client:load />
            </div>
        </div>
    </div>
</AdminLayout>

<style>
    .hub-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 2rem;
    }

    .sidebar-stats {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .stat-item { padding: 1.2rem !important; }
    .stat-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
    .stat-header .label { font-size: 0.6rem; color: #666; text-transform: uppercase; font-weight: 800; }
    .stat-item .value { font-size: 1.2rem; font-weight: 900; color: #fff; font-family: 'JetBrains Mono', monospace; }
    .trend { font-size: 0.6rem; color: #00ff9d; font-weight: 800; margin-top: 0.3rem; }

    .commands-box h3, .system-health h3 {
        font-size: 0.75rem;
        color: #ffc400;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 1.2rem;
        font-weight: 800;
    }

    .cmd-list { display: flex; flex-direction: column; gap: 0.6rem; }
    .btn-cmd {
        background: #080808;
        border: 1px solid #1a1a1a;
        padding: 0.8rem;
        border-radius: 6px;
        color: #888;
        display: flex;
        align-items: center;
        gap: 1rem;
        cursor: pointer;
        transition: 0.3s;
        text-align: left;
    }
    .btn-cmd:hover { background: rgba(0, 247, 255, 0.05); border-color: #00f7ff; color: #fff; }
    .btn-cmd.danger:hover { background: rgba(255, 51, 51, 0.05); border-color: #ff3333; color: #ff3333; }
    .btn-cmd .ico { font-size: 1.1rem; }
    .btn-cmd .tit { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }

    .health-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid #1a1a1a;
        color: #ccc;
    }
    .health-item:last-child { border-bottom: none; }
    .status.online { color: #00ff9d; font-weight: 800; font-size: 0.65rem; }

    .live-area { min-height: 600px; }
</style>

<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .stat-item { padding: 2rem; position: relative; }
    .stat-header { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; }
    .stat-header .label { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 1px; font-weight: 800; }
    .stat-item .value { font-size: 2rem; font-weight: 900; color: #fff; font-family: 'JetBrains Mono', monospace; }
    .trend { font-size: 0.7rem; margin-top: 0.5rem; color: #666; font-weight: 700; }
    .trend.up { color: #00ff9d; }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 1.5rem;
    }

    .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .card-header h3 { font-size: 1rem; color: #ffc400; text-transform: uppercase; letter-spacing: 1px; }

    .btn-sm {
        background: rgba(0, 247, 255, 0.1);
        border: 1px solid #00f7ff;
        color: #00f7ff;
        padding: 0.4rem 1rem;
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 800;
        transition: 0.3s;
    }
    .btn-sm:hover { background: #00f7ff; color: #000; }

    .list-container { display: flex; flex-direction: column; gap: 0.8rem; }
    .list-item {
        background: rgba(255,255,255,0.02);
        padding: 1rem;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1px solid #1a1a1a;
    }
    .list-item:hover { background: rgba(255,255,255,0.05); }
    .list-item .title { font-size: 0.85rem; color: #ccc; }
    
    .status { font-size: 0.6rem; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; font-weight: 800; }
    .status.published { background: rgba(0, 255, 157, 0.1); color: #00ff9d; }
    .status.draft { background: rgba(255, 255, 255, 0.1); color: #888; }
    .status.online { background: rgba(0, 247, 255, 0.1); color: #00f7ff; }

    .actions { display: flex; gap: 0.5rem; }
    .actions button {
        background: none;
        border: 1px solid #333;
        color: #888;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.7rem;
    }
    .actions button:hover { border-color: #00f7ff; color: #00f7ff; }
    .actions button.delete:hover { border-color: #ff3333; color: #ff3333; }

    .view-all { display: block; text-align: center; margin-top: 1.5rem; color: #666; text-decoration: none; font-size: 0.8rem; }
    .view-all:hover { color: #00f7ff; }

    .cmd-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 1.5rem;
    }
    .cmd-btn {
        background: #080808;
        border: 1px solid #222;
        padding: 1rem;
        border-radius: 8px;
        color: #fff;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        transition: 0.3s;
    }
    .cmd-btn:hover { border-color: #00f7ff; background: rgba(0, 247, 255, 0.05); }
    .cmd-btn.warning:hover { border-color: #ff3333; background: rgba(255, 51, 51, 0.05); }
    .cmd-btn .icon { font-size: 1.5rem; }
    .cmd-btn .txt { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 800; color: #888; }
</style>
