  <script is:inline src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
  <script is:inline>
    // Check authentication first
    const adminToken = localStorage.getItem('adminToken');
    const omnichatToken = localStorage.getItem('omnichat_token');

    if (!adminToken && !omnichatToken) {
      window.location.href = '/admin/login';
    }

    const API_URL = window.location.hostname === 'localhost'
      ? 'http://localhost:8080'
      : 'https://api.getnexo.com.br';

    const SOCKET_URL = window.location.hostname === 'localhost'
      ? 'http://localhost:8080'
      : 'https://api.getnexo.com.br';
    
    // Load Statistics
    async function loadStats() {
      try {
        const res = await fetch(`${API_URL}/api/relatorio`);
        const data = await res.json();
        
        document.getElementById('stat-vendas').textContent = 
          'R$ ' + (data.totalVendas || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 });
        document.getElementById('stat-pedidos').textContent = data.pedidos || 0;
        document.getElementById('stat-conversas').textContent = data.conversas || 0;
      } catch (e) {
        console.error('Error loading stats:', e);
        document.getElementById('stat-vendas').textContent = 'Erro';
      }
      
      // Load coupons count
      try {
        const cRes = await fetch(`${API_URL}/api/coupons`);
        const coupons = await cRes.json();
        const active = coupons.filter(c => c.active).length;
        document.getElementById('stat-cupons').textContent = active;
      } catch (e) {
        document.getElementById('stat-cupons').textContent = '0';
      }
    }
    
    // Load Contacts
    async function loadContacts() {
      try {
        const res = await fetch(`${API_URL}/contacts`);
        const contacts = await res.json();
        const list = document.getElementById('contacts-list');
        
        if (contacts.length === 0) {
          list.innerHTML = '<li style="color:#64748b; text-align:center; padding:2rem;">Nenhum contato ainda</li>';
        } else {
          list.innerHTML = contacts.slice(0, 10).map(c => `
            <li style="padding:8px 0; border-bottom:1px solid #1e293b; display:flex; justify-content:space-between; align-items:center;">
              <span style="color:white;">${c.name || c.phone}</span>
              <span style="font-size:0.8rem; color:#64748b;">${c.phone}</span>
            </li>
          `).join('');
        }
        
        document.getElementById('total-contacts').textContent = contacts.length;
      } catch (e) {
        console.error('Error loading contacts:', e);
      }
    }
    
    // Load Products
    async function loadProducts() {
      try {
        const res = await fetch(`${API_URL}/api/products`);
        const products = await res.json();
        const list = document.getElementById('products-list');

        if (products.length === 0) {
          list.innerHTML = '<li style="color:#64748b; text-align:center; padding:2rem;">Nenhum produto cadastrado</li>';
        } else {
          list.innerHTML = products.map(p => `
            <li style="padding:8px 0; border-bottom:1px solid #1e293b; display:flex; justify-content:space-between; align-items:center;">
              <span style="color:white;">${p.name}</span>
              <span style="color:#00ff9d; font-weight:600;">R$ ${p.price.toFixed(2)}</span>
            </li>
          `).join('');
        }

        document.getElementById('total-products').textContent = products.length;
      } catch (e) {
        console.error('Error loading products:', e);
      }
    }

    // Load Configs
    async function loadConfigs() {
      try {
        const token = localStorage.getItem('adminToken');
        const res = await fetch(`${API_URL}/api/config?type=global`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const data = await res.json();
        const list = document.getElementById('configs-list');

        if (!data.configs || !data.configs.global || Object.keys(data.configs.global).length === 0) {
          list.innerHTML = '<p style="color:#64748b; text-align:center;">Nenhuma configuração global encontrada</p>';
        } else {
          list.innerHTML = Object.entries(data.configs.global).map(([key, config]) => `
            <div style="padding:8px 0; border-bottom:1px solid #1e293b; display:flex; justify-content:space-between; align-items:center;">
              <div>
                <span style="color:white; font-weight:600;">${key}</span>
                <div style="color:#64748b; font-size:0.8rem;">${config.description || 'Sem descrição'}</div>
              </div>
              <div>
                <span style="color:#00ff9d; font-size:0.9rem;">${JSON.stringify(config.value)}</span>
                <button style="margin-left:0.5rem; background:#374151; color:white; border:none; padding:2px 6px; border-radius:4px; cursor:pointer;" onclick="editConfig('${key}')">Editar</button>
                <button style="margin-left:0.5rem; background:#dc2626; color:white; border:none; padding:2px 6px; border-radius:4px; cursor:pointer;" onclick="deleteConfig('${key}')">Deletar</button>
              </div>
            </div>
          `).join('');
        }
      } catch (e) {
        console.error('Error loading configs:', e);
        document.getElementById('configs-list').innerHTML = '<p style="color:#f87171; text-align:center;">Erro ao carregar configurações</p>';
      }
    }

    // Show Add Config Modal (simple prompt)
    window.showAddConfigModal = function() {
      const key = prompt('Digite a chave da configuração:');
      if (!key) return;
      const valueStr = prompt('Digite o valor (JSON válido):');
      if (!valueStr) return;
      let value;
      try {
        value = JSON.parse(valueStr);
      } catch (e) {
        alert('Valor inválido. Deve ser JSON válido.');
        return;
      }
      const description = prompt('Digite a descrição (opcional):') || '';

      addConfig(key, value, description);
    };

    // Add Config
    async function addConfig(key, value, description) {
      try {
        const token = localStorage.getItem('adminToken');
        const res = await fetch(`${API_URL}/api/config`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({ key, value, type: 'global', description })
        });
        if (res.ok) {
          loadConfigs();
        } else {
          const error = await res.json();
          alert('Erro: ' + error.error);
        }
      } catch (e) {
        console.error('Error adding config:', e);
        alert('Erro ao adicionar configuração');
      }
    }

    // Edit Config
    window.editConfig = function(key) {
      const valueStr = prompt('Digite o novo valor (JSON válido):');
      if (!valueStr) return;
      let value;
      try {
        value = JSON.parse(valueStr);
      } catch (e) {
        alert('Valor inválido. Deve ser JSON válido.');
        return;
      }
      const description = prompt('Digite a nova descrição:') || '';

      updateConfig(key, value, description);
    };

    // Update Config
    async function updateConfig(key, value, description) {
      try {
        const token = localStorage.getItem('adminToken');
        const res = await fetch(`${API_URL}/api/config`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({ key, value, type: 'global', description })
        });
        if (res.ok) {
          loadConfigs();
        } else {
          const error = await res.json();
          alert('Erro: ' + error.error);
        }
      } catch (e) {
        console.error('Error updating config:', e);
        alert('Erro ao atualizar configuração');
      }
    }

    // Delete Config
    window.deleteConfig = function(key) {
      if (!confirm(`Tem certeza que deseja deletar a configuração "${key}"?`)) return;

      deleteConfigAPI(key);
    };

    // Delete Config API
    async function deleteConfigAPI(key) {
      try {
        const token = localStorage.getItem('adminToken');
        const res = await fetch(`${API_URL}/api/config?type=global&key=${key}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
          loadConfigs();
        } else {
          const error = await res.json();
          alert('Erro: ' + error.error);
        }
      } catch (e) {
        console.error('Error deleting config:', e);
        alert('Erro ao deletar configuração');
      }
    }
    
    // Socket.io Connection
    const socket = io(SOCKET_URL, { 
      transports: ['websocket', 'polling'],
      reconnectionAttempts: 5
    });
    
    const chatDiv = document.getElementById('conversas');
    const statusSpan = document.getElementById('socket-status');
    let messages = [];
    
    socket.on('connect', () => {
      console.log('[Admin] Conectado ao socket');
      statusSpan.style.background = '#00ff9d22';
      statusSpan.style.color = '#00ff9d';
      statusSpan.textContent = '● Online';
      chatDiv.innerHTML = '<p style="color:#00ff9d; text-align:center; margin-top:150px;">● Conectado! Monitorando mensagens...</p>';
    });
    
    socket.on('disconnect', () => {
      statusSpan.style.background = '#f8717122';
      statusSpan.style.color = '#f87171';
      statusSpan.textContent = '● Desconectado';
    });
    
    socket.on('new-message', (msg) => {
      messages.push(msg);
      if (messages.length > 50) messages.shift();
      
      const msgClass = msg.from_me ? 'msg-bot' : 'msg-user';
      const sender = msg.from_me ? '🤖 Bot' : `👤 ${msg.phone}`;
      
      chatDiv.innerHTML = messages.map(m => `
        <div style="margin-bottom:0.8rem; padding:0.5rem; border-radius:8px; background:${m.from_me ? '#00ff9d11' : '#00d4ff11'};">
          <span style="font-size:0.75rem; color:${m.from_me ? '#00ff9d' : '#00d4ff'};">${m.from_me ? '🤖 Bot' : '👤 ' + m.phone}</span>
          <p style="margin:0.3rem 0 0 0; color:white;">${m.body}</p>
        </div>
      `).join('');
      
      chatDiv.scrollTop = chatDiv.scrollHeight;
    });
    
    socket.on('contact:new', (contact) => {
      console.log('[Admin] New contact:', contact);
      loadContacts();
    });
    
    // Logout function
    window.logout = function() {
      localStorage.removeItem('adminToken');
      window.location.href = '/admin/login';
    };
    
    // Check login and load user
    function checkAuth() {
      const token = localStorage.getItem('adminToken');
      if (token) {
        try {
          // Decode JWT Payload (Header.Payload.Signature)
          const base64Url = token.split('.')[1];
          const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
          const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
              return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
          }).join(''));

          const payload = JSON.parse(jsonPayload);
          // Try to get email or name or sub
          const displayName = payload.email || payload.name || payload.sub || 'Admin';
          
          document.getElementById('user-info').innerHTML = `Bem-vindo, <strong style="color:white;">${displayName}</strong>`;
        } catch (e) {
          console.error('Token decode error:', e);
          document.getElementById('user-info').textContent = 'Admin';
        }
      } else {
        document.getElementById('user-info').textContent = 'Convidado';
      }
    }
    
