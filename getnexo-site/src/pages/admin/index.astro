              <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
                <span class="status-dot offline">●</span>
                <span style="font-weight:600; color:white;">Uptime Kuma</span>
              </div>
              <div style="font-size:0.8rem; color:#64748b;">Monitoramento</div>
              <div style="font-size:0.7rem; color:#64748b; margin-top:0.2rem;">Offline</div>
            </div>

            <div class="service-status" id="socket-status-admin" style="background:#1e293b; padding:1rem; border-radius:8px; border:1px solid #374151;">
              <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
                <span class="status-dot offline">●</span>
                <span style="font-weight:600; color:white;">WebSocket</span>
              </div>
              <div style="font-size:0.8rem; color:#64748b;">Tempo Real</div>
              <div style="font-size:0.7rem; color:#64748b; margin-top:0.2rem;">Desconectado</div>
            </div>
          </div>
        </div>
      `;

      nav.parentNode.insertBefore(statusPanel, nav.nextSibling);
    }

    // Initial Load
    checkAuth();
    addServiceStatusPanel();
    loadStats();
    loadContacts();
    loadProducts();
    loadConfigs();

    // Auto refresh every 30 seconds
    setInterval(() => {
      loadStats();
      loadContacts();
    }, 30000);
  </script>
</Layout>

