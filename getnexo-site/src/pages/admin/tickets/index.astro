---
// Painel administrativo de tickets
import AdminLayout from '../../../layouts/AdminLayout.astro';
const nonce = Astro.locals.nonce;
---

<AdminLayout title="Gerenciar Tickets">
  <div class="space-y-6">
    <!-- Header com stats -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-white">Central de Tickets</h1>
        <p class="text-gray-400">Gerenciar todos os tickets de suporte</p>
      </div>
      <button onclick="loadTickets()" class="px-4 py-2 bg-cyan-600 text-white rounded-lg hover:bg-cyan-700 transition">
        🔄 Atualizar
      </button>
    </div>

    <!-- Stats Cards -->
    <div id="stats-cards" class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <div class="bg-gray-800 rounded-xl p-4">
        <div class="text-2xl font-bold text-white" id="stat-total">-</div>
        <div class="text-sm text-gray-400">Total</div>
      </div>
      <div class="bg-yellow-900/30 border border-yellow-600/30 rounded-xl p-4">
        <div class="text-2xl font-bold text-yellow-400" id="stat-open">-</div>
        <div class="text-sm text-yellow-400/70">Abertos</div>
      </div>
      <div class="bg-blue-900/30 border border-blue-600/30 rounded-xl p-4">
        <div class="text-2xl font-bold text-blue-400" id="stat-progress">-</div>
        <div class="text-sm text-blue-400/70">Em Andamento</div>
      </div>
      <div class="bg-green-900/30 border border-green-600/30 rounded-xl p-4">
        <div class="text-2xl font-bold text-green-400" id="stat-closed">-</div>
        <div class="text-sm text-green-400/70">Fechados</div>
      </div>
      <div class="bg-red-900/30 border border-red-600/30 rounded-xl p-4">
        <div class="text-2xl font-bold text-red-400" id="stat-high">-</div>
        <div class="text-sm text-red-400/70">Prioridade Alta</div>
      </div>
    </div>

    <!-- Filtros -->
    <div class="flex gap-4 flex-wrap">
      <select id="filter-status" onchange="filterTickets()" class="px-4 py-2 bg-gray-800 text-white rounded-lg border border-gray-700">
        <option value="">Todos os status</option>
        <option value="open">🟡 Abertos</option>
        <option value="in-progress">🔵 Em Andamento</option>
        <option value="closed">✅ Fechados</option>
      </select>
      <select id="filter-priority" onchange="filterTickets()" class="px-4 py-2 bg-gray-800 text-white rounded-lg border border-gray-700">
        <option value="">Todas prioridades</option>
        <option value="2">🔴 Alta</option>
        <option value="1">🟡 Média</option>
        <option value="0">🟢 Baixa</option>
      </select>
      <input type="text" id="filter-search" placeholder="Buscar..." oninput="filterTickets()" class="px-4 py-2 bg-gray-800 text-white rounded-lg border border-gray-700 flex-1 min-w-[200px]">
    </div>

    <!-- Tickets Table -->
    <div class="bg-gray-800 rounded-xl overflow-hidden">
      <table class="w-full">
        <thead class="bg-gray-700">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">#</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Ticket</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Cliente</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Status</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Prioridade</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Data</th>
            <th class="px-4 py-3 text-left text-sm font-medium text-gray-300">Ações</th>
          </tr>
        </thead>
        <tbody id="tickets-tbody" class="divide-y divide-gray-700">
          <tr><td colspan="7" class="px-4 py-8 text-center text-gray-400">Carregando...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal de Ticket -->
  <div id="ticket-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="closeModal()"></div>
      
      <div class="relative bg-gray-800 rounded-2xl shadow-2xl w-full max-w-3xl max-h-[90vh] flex flex-col border border-gray-700">
        <!-- Header -->
        <div class="flex items-center justify-between p-6 border-b border-gray-700">
          <div>
            <h2 id="modal-title" class="text-xl font-bold text-white"></h2>
            <p id="modal-meta" class="text-sm text-gray-400 mt-1"></p>
          </div>
          <div class="flex items-center gap-2">
            <select id="modal-status" onchange="updateTicketStatus()" class="px-3 py-1.5 bg-gray-700 text-white rounded-lg border border-gray-600 text-sm">
              <option value="open">🟡 Aberto</option>
              <option value="in-progress">🔵 Em Andamento</option>
              <option value="closed">✅ Fechado</option>
            </select>
            <button onclick="closeModal()" class="p-2 hover:bg-gray-700 rounded-lg transition">
              <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Descrição -->
        <div id="modal-description" class="px-6 py-4 bg-gray-700/50 border-b border-gray-700 text-sm text-gray-300"></div>

        <!-- Mensagens -->
        <div id="modal-messages" class="flex-1 overflow-y-auto p-6 space-y-4 max-h-64"></div>

        <!-- Form Admin Reply -->
        <div class="p-6 border-t border-gray-700 bg-gray-700/30">
          <form id="admin-reply-form" class="space-y-3">
            <textarea 
              id="admin-reply-message" 
              name="message"
              placeholder="Responder como admin..." 
              rows="3"
              class="w-full p-3 bg-gray-700 text-white rounded-lg border border-gray-600 focus:border-cyan-500 focus:outline-none resize-none"
            ></textarea>
            <div class="flex items-center justify-between">
              <input type="file" name="attachments" multiple accept="image/*,.pdf,.mp3,.wav" class="text-sm text-gray-400 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-gray-600 file:text-gray-200">
              <button type="submit" id="admin-submit-btn" class="px-6 py-2 bg-cyan-600 text-white rounded-lg hover:bg-cyan-700 transition font-medium">
                Responder
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script nonce={nonce}>
  const API_BASE = '/api/support';
  let cachedToken = null;
  let allTickets = [];
  let currentTicketId = null;

  function getToken() {
    if (cachedToken) return cachedToken;
    cachedToken = localStorage.getItem('getnexo_token') || localStorage.getItem('jwt_token');
    return cachedToken;
  }

  function getStatusBadge(status) {
    const badges = {
      'open': '<span class="px-2 py-1 rounded-full text-xs font-medium bg-yellow-900/50 text-yellow-400 border border-yellow-600/30">🟡 Aberto</span>',
      'in-progress': '<span class="px-2 py-1 rounded-full text-xs font-medium bg-blue-900/50 text-blue-400 border border-blue-600/30">🔵 Em Andamento</span>',
      'closed': '<span class="px-2 py-1 rounded-full text-xs font-medium bg-green-900/50 text-green-400 border border-green-600/30">✅ Fechado</span>'
    };
    return badges[status] || badges['open'];
  }

  function getPriorityBadge(priority) {
    const badges = {
      0: '<span class="px-2 py-0.5 rounded text-xs bg-gray-700 text-gray-300">Baixa</span>',
      1: '<span class="px-2 py-0.5 rounded text-xs bg-yellow-900/50 text-yellow-400">Média</span>',
      2: '<span class="px-2 py-0.5 rounded text-xs bg-red-900/50 text-red-400">Alta</span>'
    };
    return badges[priority] || badges[0];
  }

  function formatDate(dateStr) {
    const date = new Date(dateStr);
    return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  }

  function renderAttachment(url) {
    if (!url) return '';
    if (url.match(/\.(mp3|wav|ogg|webm)$/i)) {
      return `<audio controls class="mt-2 w-full max-w-xs" src="${url}"></audio>`;
    } else if (url.match(/\.(jpg|jpeg|png|gif|webp)$/i)) {
      return `<img src="${url}" alt="Anexo" class="mt-2 max-w-xs rounded-lg border border-gray-600">`;
    }
    return `<a href="${url}" target="_blank" class="text-cyan-400 hover:underline">📎 Ver anexo</a>`;
  }

  async function loadStats() {
    const token = getToken();
    if (!token) return;

    try {
      const res = await fetch(`${API_BASE}/admin/stats`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const stats = await res.json();
      
      document.getElementById('stat-total').textContent = stats.total || 0;
      document.getElementById('stat-open').textContent = stats.open || 0;
      document.getElementById('stat-progress').textContent = stats.inProgress || 0;
      document.getElementById('stat-closed').textContent = stats.closed || 0;
      document.getElementById('stat-high').textContent = stats.highPriority || 0;
    } catch (err) {
      console.error('Erro stats:', err);
    }
  }

  async function loadTickets() {
    const token = getToken();
    const tbody = document.getElementById('tickets-tbody');
    
    if (!token) {
      tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center text-red-400">Token não encontrado</td></tr>';
      return;
    }

    try {
      const res = await fetch(`${API_BASE}/admin/tickets`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      if (!res.ok) throw new Error('Erro');

      allTickets = await res.json();
      filterTickets();
      loadStats();
    } catch (err) {
      console.error('Erro:', err);
      tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center text-red-400">Erro ao carregar</td></tr>';
    }
  }

  function filterTickets() {
    const status = document.getElementById('filter-status').value;
    const priority = document.getElementById('filter-priority').value;
    const search = document.getElementById('filter-search').value.toLowerCase();

    const filtered = allTickets.filter(t => {
      if (status && t.status !== status) return false;
      if (priority && t.priority !== parseInt(priority)) return false;
      if (search && !t.title.toLowerCase().includes(search) && !t.client_id.toLowerCase().includes(search)) return false;
      return true;
    });

    renderTickets(filtered);
  }

  function renderTickets(tickets) {
    const tbody = document.getElementById('tickets-tbody');
    
    if (tickets.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-400">Nenhum ticket encontrado</td></tr>';
      return;
    }

    tbody.innerHTML = tickets.map(t => `
      <tr class="hover:bg-gray-700/50 transition cursor-pointer" onclick="openTicketModal(${t.id})">
        <td class="px-4 py-3 text-gray-400">#${t.id}</td>
        <td class="px-4 py-3">
          <div class="font-medium text-white">${t.title.substring(0, 40)}${t.title.length > 40 ? '...' : ''}</div>
          <div class="text-xs text-gray-400">${t.description.substring(0, 50)}...</div>
        </td>
        <td class="px-4 py-3 text-gray-300">${t.client_id}</td>
        <td class="px-4 py-3">${getStatusBadge(t.status)}</td>
        <td class="px-4 py-3">${getPriorityBadge(t.priority)}</td>
        <td class="px-4 py-3 text-gray-400 text-sm">${formatDate(t.created_at)}</td>
        <td class="px-4 py-3">
          <button class="text-cyan-400 hover:text-cyan-300 text-sm" onclick="event.stopPropagation(); openTicketModal(${t.id})">Ver</button>
        </td>
      </tr>
    `).join('');
  }

  async function openTicketModal(ticketId) {
    currentTicketId = ticketId;
    const token = getToken();
    if (!token) return;

    document.getElementById('ticket-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    try {
      const res = await fetch(`${API_BASE}/tickets/${ticketId}/messages`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });

      const data = await res.json();
      const { ticket, messages } = data;

      document.getElementById('modal-title').textContent = `#${ticket.id} - ${ticket.title}`;
      document.getElementById('modal-meta').innerHTML = `Cliente: <strong>${ticket.client_id}</strong> • ${formatDate(ticket.created_at)}`;
      document.getElementById('modal-status').value = ticket.status;

      let descHtml = `<p>${ticket.description}</p>`;
      if (ticket.attachments?.length > 0) {
        ticket.attachments.forEach(att => { descHtml += renderAttachment(att); });
      }
      document.getElementById('modal-description').innerHTML = descHtml;

      const msgContainer = document.getElementById('modal-messages');
      if (messages.length === 0) {
        msgContainer.innerHTML = '<div class="text-center text-gray-400 py-4">Nenhuma resposta</div>';
      } else {
        msgContainer.innerHTML = messages.map(m => {
          const isAdmin = m.sender === 'admin';
          let attachmentsHtml = '';
          if (m.attachment && Array.isArray(m.attachment)) {
            m.attachment.forEach(att => { attachmentsHtml += renderAttachment(att); });
          }
          return `
            <div class="flex ${isAdmin ? 'justify-end' : 'justify-start'}">
              <div class="max-w-md ${isAdmin ? 'bg-cyan-900/30 border-cyan-600/30' : 'bg-gray-700'} rounded-lg p-3 border">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-medium text-xs ${isAdmin ? 'text-cyan-400' : 'text-gray-400'}">
                    ${isAdmin ? '👤 Admin' : '👤 Cliente'}
                  </span>
                  <span class="text-xs text-gray-500">${formatDate(m.created_at)}</span>
                </div>
                ${m.message ? `<p class="text-gray-200 text-sm">${m.message}</p>` : ''}
                ${attachmentsHtml}
              </div>
            </div>
          `;
        }).join('');
        msgContainer.scrollTop = msgContainer.scrollHeight;
      }
    } catch (err) {
      console.error('Erro:', err);
    }
  }

  function closeModal() {
    document.getElementById('ticket-modal').classList.add('hidden');
    document.body.style.overflow = '';
    currentTicketId = null;
  }

  async function updateTicketStatus() {
    if (!currentTicketId) return;
    const token = getToken();
    const status = document.getElementById('modal-status').value;

    try {
      await fetch(`${API_BASE}/tickets/${currentTicketId}/status`, {
        method: 'PATCH',
        headers: { 
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ status })
      });
      loadTickets();
    } catch (err) {
      alert('Erro ao atualizar status');
    }
  }

  // Admin reply form
  document.getElementById('admin-reply-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentTicketId) return;

    const token = getToken();
    const form = e.target;
    const submitBtn = document.getElementById('admin-submit-btn');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';

    const formData = new FormData(form);

    try {
      const res = await fetch(`${API_BASE}/tickets/${currentTicketId}/reply`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: formData
      });

      if (!res.ok) throw new Error('Erro');

      form.reset();
      openTicketModal(currentTicketId);
      loadTickets();
    } catch (err) {
      alert('Erro ao enviar');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Responder';
    }
  });

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  window.openTicketModal = openTicketModal;
  window.closeModal = closeModal;
  window.loadTickets = loadTickets;
  window.filterTickets = filterTickets;
  window.updateTicketStatus = updateTicketStatus;

  document.addEventListener('DOMContentLoaded', loadTickets);
</script>
