---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Automations" activeTab="automations">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-yellow-500 to-amber-500 rounded-2xl flex items-center justify-center shadow-lg shadow-yellow-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Automations
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Crie fluxos de automação com triggers, actions e integração com n8n.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/automations/new" class="px-6 py-3 bg-yellow-600/20 hover:bg-yellow-600/40 text-yellow-400 rounded-lg border border-yellow-500/30 transition-all">Criar Fluxo</a>
      <a href="/admin/automations/list" class="px-6 py-3 bg-amber-600/20 hover:bg-amber-600/40 text-amber-400 rounded-lg border border-amber-500/30 transition-all">Meus Fluxos</a>
      <a href="/admin/automations/n8n" class="px-6 py-3 bg-orange-600/20 hover:bg-orange-600/40 text-orange-400 rounded-lg border border-orange-500/30 transition-all">Integração n8n</a>
    </div>
  </div>
</AdminLayout>
