---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { BarChart3, PieChart, TrendingUp, Users, Tag, ChevronRight } from 'lucide-react';

const tagPerformance = [
  { name: 'VIP Gold', customers: 124, revenue: 'R$ 45.000', conversion: '12.4%' },
  { name: 'Lead Frio', customers: 850, revenue: 'R$ 2.100', conversion: '0.8%' },
  { name: 'Boleto Pendente', customers: 42, revenue: 'R$ 0', conversion: '--' },
  { name: 'Cliente Recorrente', customers: 210, revenue: 'R$ 89.400', conversion: '24.2%' },
];
---

<AdminLayout title="Relatórios de Tags" activeTab="tags">
  <div class="max-w-6xl mx-auto space-y-10 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-cyan-500/10 rounded-2xl flex items-center justify-center text-cyan-500 border border-cyan-500/20 shadow-xl shadow-cyan-500/10">
          <BarChart3 className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Insights por Tag</h1>
          <p class="text-sm text-gray-500 font-medium">Entenda o comportamento e o valor de cada segmento de clientes.</p>
        </div>
      </div>
    </div>

    <!-- Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] space-y-4">
          <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Tags Ativas</p>
          <h3 class="text-3xl font-black text-white">42</h3>
       </div>
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] space-y-4 text-emerald-500">
          <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Melhor Segmento</p>
          <h3 class="text-3xl font-black italic tracking-tighter uppercase">Recorrente</h3>
       </div>
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] space-y-4">
          <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Novos Segmentos</p>
          <h3 class="text-3xl font-black text-white">+5 este mês</h3>
       </div>
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] space-y-4">
          <p class="text-[10px] font-black text-gray-500 uppercase tracking-widest">Precisão da IA</p>
          <h3 class="text-3xl font-black text-white font-mono">98%</h3>
       </div>
    </div>

    <!-- Table -->
    <div class="bg-gray-900/20 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <div class="p-8 border-b border-gray-800 bg-black/20 flex items-center justify-between">
          <div class="flex items-center space-x-3">
             <PieChart className="w-5 h-5 text-gray-500" />
             <h3 class="text-xs font-black uppercase text-gray-400 tracking-widest">Performance por Segmentação</h3>
          </div>
       </div>

       <div class="divide-y divide-gray-800/50">
          {tagPerformance.map(tag => (
             <div class="p-8 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                <div class="flex items-center space-x-8">
                   <div class="w-12 h-12 bg-gray-800 rounded-xl flex items-center justify-center text-gray-600 group-hover:bg-cyan-500/10 group-hover:text-cyan-500 transition-all">
                      <Tag className="w-6 h-6" />
                   </div>
                   <div>
                      <h4 class="text-sm font-bold text-white uppercase tracking-tight">{tag.name}</h4>
                      <p class="text-[10px] text-gray-600 font-medium">{tag.customers} clientes impactados</p>
                   </div>
                </div>

                <div class="flex items-center space-x-12">
                   <div class="text-right">
                      <p class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Receita Gerada</p>
                      <p class="text-sm font-mono font-bold text-white">{tag.revenue}</p>
                   </div>
                   <div class="text-right w-24">
                      <p class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Conversão</p>
                      <div class="flex items-center justify-end text-emerald-500 font-bold text-xs font-mono">
                         <TrendingUp className="w-3 h-3 mr-1" />
                         <span>{tag.conversion}</span>
                      </div>
                   </div>
                </div>

                <button class="p-3 bg-gray-800/50 text-gray-500 hover:text-white rounded-xl transition-all">
                   <ChevronRight className="w-5 h-5" />
                </button>
             </div>
          ))}
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
