---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Users, Target, Zap, TrendingUp, MoreHorizontal, MousePointerClick } from 'lucide-react';

const segments = [
  { id: 1, name: "Baleia (High LTV)", count: "1,250", growth: "+4.2%", color: "indigo", desc: "Clientes que gastaram mais de R$ 5.000,00 nos últimos 6 meses." },
  { id: 2, name: "Leads Frios", count: "45.000", growth: "-1.5%", color: "blue", desc: "Cadastrados há mais de 30 dias sem nenhuma interação ou compra." },
  { id: 3, name: "Abandono de Carrinho (24h)", count: "840", growth: "+12%", color: "orange", desc: "Usuários que deixaram itens no checkout nas últimas 24 horas." },
];
---

<AdminLayout title="Segmentação de Audiência" activeTab="tags">
  <div class="space-y-10 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter flex items-center">
          <Target className="w-8 h-8 text-indigo-400 mr-4" />
          Clustering Inteligente
        </h1>
        <p class="text-sm text-gray-500 font-medium mt-1">Sua audiência dividida em clusters comportamentais para marketing de precisão.</p>
      </div>
      <button class="bg-indigo-600 hover:bg-indigo-500 text-white font-black px-6 py-3 rounded-2xl flex items-center space-x-3 transition-all shadow-xl shadow-indigo-500/10 uppercase text-[10px] tracking-widest">
        <span>Novo Segmento IA</span>
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
       {segments.map(s => (
         <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] p-10 hover:border-indigo-500/30 transition-all group flex flex-col justify-between h-[400px] relative overflow-hidden">
            <div class:list={["absolute right-0 top-0 w-32 h-32 blur-[100px] opacity-20", `bg-${s.color}-500`]}></div>
            
            <div class="space-y-6 relative z-10">
               <div class:list={["w-14 h-14 rounded-2xl flex items-center justify-center", `bg-${s.color}-500/10 text-${s.color}-400`]}>
                  <Users className="w-7 h-7" />
               </div>
               <div>
                  <h3 class="text-2xl font-black text-white uppercase tracking-tighter">{s.name}</h3>
                  <p class="text-[10px] text-gray-500 mt-2 leading-relaxed font-medium">{s.desc}</p>
               </div>
            </div>

            <div class="pt-8 relative z-10">
               <div class="flex items-end justify-between mb-8">
                  <div>
                     <p class="text-[10px] font-black uppercase text-gray-600 tracking-widest">Tamanho Estimado</p>
                     <p class="text-3xl font-black text-white font-mono">{s.count}</p>
                  </div>
                  <div class="text-right">
                     <p class="text-[10px] font-black uppercase text-gray-600 tracking-widest">Crescimento</p>
                     <p class:list={["text-sm font-black font-mono", s.growth.includes('+') ? 'text-emerald-500' : 'text-rose-500']}>{s.growth}</p>
                  </div>
               </div>
               
               <div class="flex items-center space-x-2">
                  <button class="flex-1 py-4 bg-gray-800 hover:bg-indigo-600 hover:text-white text-gray-400 font-black text-[10px] uppercase tracking-widest rounded-xl transition-all flex items-center justify-center">
                     <MousePointerClick className="w-3 h-3 mr-2" /> Ativar Campanha
                  </button>
                  <button class="p-4 bg-gray-800/50 rounded-xl text-gray-600 hover:text-white transition-all"><MoreHorizontal className="w-4 h-4" /></button>
               </div>
            </div>
         </div>
       ))}
    </div>

    <!-- Optimization Alert -->
    <div class="bg-indigo-600/5 border border-indigo-500/10 p-8 rounded-[2rem] flex items-center justify-between">
       <div class="flex items-center space-x-6">
          <Zap className="w-8 h-8 text-indigo-400" />
          <div>
             <h4 class="text-white font-bold uppercase tracking-tight">Otimização de ROAS sugerida</h4>
             <p class="text-xs text-gray-500 font-medium mt-1">Seus segmentos de Re-marketing estão com alta sobreposição. Deseja realizar um merge preventivo?</p>
          </div>
       </div>
       <button class="text-[10px] font-black uppercase text-indigo-400 hover:text-white transition-colors">Executar Merge IA —&gt;</button>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
