```
---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Tag, Search, Plus, MoreVertical, Filter, Hash, UserCheck } from 'lucide-react';

const tags = [
  { id: 1, name: "VIP", color: "yellow", count: 42, automated: true, rule: "Orders > 5" },
  { id: 2, name: "Churn_Risk", color: "rose", count: 128, automated: true, rule: "No active > 30d" },
  { id: 3, name: "Wholesale", color: "blue", count: 12, automated: false, rule: "Manual" },
  { id: 4, name: "Nexus_Alpha", color: "indigo", count: 5, automated: true, rule: "Total Spend > 10k" },
];
---

<AdminLayout title="Gestão de Tags" activeTab="tags">
  <div class="space-y-8 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Taxonomia de Audiência</h1>
        <p class="text-sm text-gray-500 font-medium mt-1">Classifique e segmente seus leads e clientes com tags inteligentes.</p>
      </div>
      <button class="bg-indigo-600 hover:bg-indigo-500 text-white font-black px-6 py-3 rounded-2xl flex items-center space-x-3 transition-all shadow-xl shadow-indigo-500/10 uppercase text-[10px] tracking-widest">
        <Plus className="w-5 h-5" />
        <span>Nova Tag</span>
      </button>
    </div>

    <!-- Barra de busca e filtros -->
    <div class="flex flex-col md:flex-row gap-4 bg-gray-900/40 p-4 border border-gray-800 rounded-2xl">
      <div class="relative flex-1">
        <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" />
        <input type="text" placeholder="Pesquisar tags..." class="w-full bg-black/40 border border-gray-800 rounded-xl py-3 pl-12 pr-4 text-sm text-white focus:border-indigo-500 outline-none transition-all" />
      </div>
      <button class="px-6 py-3 bg-gray-800 border border-gray-700 rounded-xl text-xs font-black text-gray-500 hover:text-white uppercase tracking-widest transition-all">
        <Filter className="w-4 h-4 mr-2 inline" /> Filtrar
      </button>
    </div>

    <!-- Lista de Tags -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
       {tags.map(t => (
         <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] group hover:border-white/10 transition-all flex flex-col justify-between h-[250px] relative overflow-hidden">
            <div class:list={["absolute right-0 top-0 w-20 h-20 blur-3xl opacity-10", `bg-${t.color}-500`]}></div>
            
            <div class="flex items-start justify-between">
               <div class:list={["w-10 h-10 rounded-xl flex items-center justify-center", `bg-${t.color}-500/10 text-${t.color}-400`]}>
                  <Hash className="w-5 h-5" />
               </div>
               {t.automated && <div class="text-[8px] font-black uppercase text-indigo-400 bg-indigo-500/10 px-2 py-0.5 rounded flex items-center"><UserCheck className="w-2 h-2 mr-1" /> Automática</div>}
            </div>

            <div>
               <h3 class="text-xl font-bold text-white uppercase tracking-tighter mt-4">{t.name}</h3>
               <p class="text-[10px] text-gray-500 font-medium mt-1">Gatilho: <span class="text-gray-400 italic">{t.rule}</span></p>
            </div>

            <div class="pt-6 mt-6 border-t border-gray-800/50 flex items-center justify-between">
               <span class="text-[10px] font-black text-white uppercase tracking-widest">{t.count} Usuários</span>
               <button class="text-gray-700 hover:text-white transition-colors"><MoreVertical className="w-4 h-4" /></button>
            </div>
         </div>
       ))}
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
```
