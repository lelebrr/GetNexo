---
import AdminLayout from '../../layouts/AdminLayout.astro';
import MasterControl from '../../components/admin/MasterControl.jsx';
---

<AdminLayout title="Master Control - GetNexo">
  <div class="master-control-page">
    <div class="page-header">
      <h1>🎛️ Master Control Center</h1>
      <p>Controle total de todos os sistemas GetNexo</p>
    </div>

    <MasterControl client:load />
  </div>
</AdminLayout>

<style>
  .master-control-page {
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: #6b7280;
    font-size: 1.2rem;
  }
</style>