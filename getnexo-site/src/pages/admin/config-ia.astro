---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Configuração de IA - GetNexo Admin">

  <h1 style="color:#00ff9d; font-size:2.8rem;">Configuração de IA</h1>
  <p style="color:#e5e7eb; margin-bottom:2rem;">Escolha qual IA o chat usa na demo e em produção. Cole as chaves API aqui.</p>

  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(400px,1fr)); gap:2rem;">

    <!-- GLOBAL ACTIVE AI SELECTOR -->
    <div class="card" style="background:rgba(0, 255, 157, 0.1); padding:2rem; border-radius:16px; border:1px solid #00ff9d; grid-column: 1 / -1;">
      <h3 style="color:#00ff9d; display:flex; align-items:center; gap:10px;">
        <span style="font-size:1.5em;">🤖</span> IA Ativa (Provider Principal)
      </h3>
      <p style="color:#94a3b8; margin-bottom:1rem;">Escolha qual inteligência responderá aos clientes no widget e WhatsApp.</p>
      
      <div style="display:flex; gap:1rem; flex-wrap:wrap;">
        <label class="provider-option">
          <input type="radio" name="activeAI" value="gemini" checked onchange="saveConfig('active')"> 
          <span class="label-text">Google Gemini</span>
        </label>
        <label class="provider-option">
          <input type="radio" name="activeAI" value="openrouter" onchange="saveConfig('active')"> 
          <span class="label-text">OpenRouter (GPT/Claude)</span>
        </label>
        <label class="provider-option">
          <input type="radio" name="activeAI" value="grok" onchange="saveConfig('active')"> 
          <span class="label-text">Grok (xAI)</span>
        </label>
        <label class="provider-option">
          <input type="radio" name="activeAI" value="deepseek" onchange="saveConfig('active')"> 
          <span class="label-text">DeepSeek</span>
        </label>
      </div>
    </div>

    <!-- Gemini -->
    <div class="card" style="background:rgba(30,41,59,0.8); padding:2rem; border-radius:16px; border:1px solid #00d4ff55;">
      <h3 style="color:#00d4ff;">Google Gemini</h3>
      <select id="gemini-model-select" style="width:100%; padding:0.8rem; margin:0.8rem 0; background:#1e293b; color:white; border:1px solid #00d4ff55;">
        <option value="gemini-2.0-flash" selected>Gemini 2.0 Flash (Mais novo)</option>
        <option value="gemini-2.0-flash-lite-preview-02-05">Gemini 2.0 Flash Lite (Preview)</option>
        <option value="gemini-1.5-pro">Gemini 1.5 Pro (Mais inteligente)</option>
        <option value="gemini-1.5-flash">Gemini 1.5 Flash (Rápido)</option>
      </select>
      <input id="gemini-key" type="text" placeholder="Cole sua API Key Gemini aqui" style="width:100%; padding:0.8rem; background:#1e293b; color:white; border:1px solid #00d4ff55;" />
      <button onclick="saveConfig('gemini')" class="btn-cta" style="margin-top:1rem; width:100%;">Salvar Gemini</button>
    </div>

    <!-- OpenRouter -->
    <div class="card" style="background:rgba(30,41,59,0.8); padding:2rem; border-radius:16px; border:1px solid #7c3aed55;">
      <h3 style="color:#a78bfa;">OpenRouter (Lista Atualizada Automaticamente)</h3>
      <p style="color:#94a3b8; font-size:0.8rem; margin-bottom:0.5rem;">Carregando modelos do OpenRouter...</p>
      
      <select id="openrouter-model-select" style="width:100%; padding:0.8rem; margin:0.8rem 0; background:#1e293b; color:white; border:1px solid #7c3aed55;">
        <option value="z-ai/glm-4.5-air:free" selected>GLM-4 (Free) (Padrão)</option>
        <option value="openai/gpt-4o">GPT-4o</option>
      </select>
      
      <input id="openrouter-key" type="text" placeholder="Cole sua API Key OpenRouter aqui" style="width:100%; padding:0.8rem; background:#1e293b; color:white; border:1px solid #7c3aed55;" />
      <button onclick="saveConfig('openrouter')" class="btn-cta" style="margin-top:1rem; width:100%; background: linear-gradient(90deg, #7c3aed, #c084fc);">Salvar OpenRouter</button>
    </div>

    <!-- Grok (xAI) -->
    <div class="card" style="background:rgba(30,41,59,0.8); padding:2rem; border-radius:16px; border:1px solid #00d4ff55;">
      <h3 style="color:#00d4ff;">Grok (xAI)</h3>
      <input id="grok-key" type="text" placeholder="Cole sua API Key Grok aqui" style="width:100%; padding:0.8rem; background:#1e293b; color:white; border:1px solid #00d4ff55;" />
      <button onclick="saveConfig('grok')" class="btn-cta" style="margin-top:1rem; width:100%;">Salvar Grok</button>
    </div>

    <!-- DeepSeek -->
    <div class="card" style="background:rgba(30,41,59,0.8); padding:2rem; border-radius:16px; border:1px solid #00d4ff55;">
      <h3 style="color:#00d4ff;">DeepSeek</h3>
      
      <div id="deepseek-balance-display" style="background:rgba(0, 255, 157, 0.1); padding:0.8rem; border-radius:8px; margin-bottom:1rem; display:none; border:1px solid #00ff9d55;">
        <span style="color:#00ff9d; font-weight:bold;">Saldo:</span> <span id="ds-balance-value" style="color:white;">Carregando...</span>
      </div>

      <select id="deepseek-model-select" style="width:100%; padding:0.8rem; margin:0.8rem 0; background:#1e293b; color:white; border:1px solid #00d4ff55;" onchange="updateDeepSeekPricing()">
        <option value="deepseek-chat" selected>DeepSeek V3 (Chat)</option>
        <option value="deepseek-reasoner">DeepSeek R1 (Reasoner)</option>
      </select>

      <div id="deepseek-pricing" style="font-size:0.8rem; color:#94a3b8; margin-bottom:1rem; padding-left:0.5rem; border-left:3px solid #00ff9d;">
        Preço aproximado: $0.14 / 1M tokens
      </div>

      <input id="deepseek-key" type="text" placeholder="Cole sua API Key DeepSeek aqui" style="width:100%; padding:0.8rem; background:#1e293b; color:white; border:1px solid #00d4ff55;" />
      
      <div style="display:flex; gap:0.5rem; margin-top:1rem;">
        <button onclick="saveConfig('deepseek')" class="btn-cta" style="flex:2;">Salvar DeepSeek</button>
        <button onclick="checkDeepSeekBalance()" class="btn-cta" style="flex:1; background:rgba(30,41,59,1); color:#00ff9d; border:1px solid #00ff9d;">Saldo</button>
      </div>
    </div>

  </div>

  <div style="margin-top:3rem; text-align:center;">
    <button class="btn-cta" style="font-size:1.3rem; padding:1rem 3rem;" onclick="window.location.href='/demo'">Aplicar Configuração e Testar Demo</button>
  </div>

</Layout>

<script nonce={Astro.locals.nonce} is:inline>
  const API_URL = '';

  function updateDeepSeekPricing() {
    const model = document.getElementById('deepseek-model-select').value;
    const pricingDiv = document.getElementById('deepseek-pricing');
    if (model === 'deepseek-chat') {
      pricingDiv.innerText = 'Preço (Prompt/Compl): $0.14 / $0.28 per 1M tokens';
    } else {
      pricingDiv.innerText = 'Preço (Prompt/Compl): $0.55 / $2.19 per 1M tokens';
    }
  }

  async function checkDeepSeekBalance() {
    const display = document.getElementById('deepseek-balance-display');
    const valueSpan = document.getElementById('ds-balance-value');
    display.style.display = 'block';
    valueSpan.innerText = 'Carregando...';

    try {
      const res = await fetch(`${API_URL}/api/ai/balance/deepseek`);
      const data = await res.json();
      if (data.success && data.balance.balance_infos) {
          const info = data.balance.balance_infos[0];
          valueSpan.innerText = `${info.total_balance} ${info.currency}`;
      } else {
          valueSpan.innerText = 'Erro ao buscar saldo.';
      }
    } catch (e) {
      valueSpan.innerText = 'Erro de conexão.';
    }
  }

  async function saveConfig(type) {
      const geminiKey = document.getElementById('gemini-key')?.value;
      const openRouterKey = document.getElementById('openrouter-key')?.value;
      const grokKey = document.getElementById('grok-key')?.value;
      const deepseekKey = document.getElementById('deepseek-key')?.value;
      const deepseekModel = document.getElementById('deepseek-model-select')?.value;
      
      const payload = {};
      if (type === 'gemini') payload.geminiKey = geminiKey;
      if (type === 'openrouter') payload.openRouterKey = openRouterKey;
      if (type === 'grok') payload.grokKey = grokKey;
      if (type === 'deepseek') {
          payload.deepseekKey = deepseekKey;
          payload.deepseekModel = deepseekModel;
      }
      if (type === 'active') {
          const selected = document.querySelector('input[name="activeAI"]:checked');
          if (selected) payload.activeAI = selected.value;
      }

      try {
          const res = await fetch(`${API_URL}/api/admin/config`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
              alert('✅ Configuração salva com sucesso!');
              if (type === 'deepseek') checkDeepSeekBalance();
          } else {
              alert('❌ Erro ao salvar configuração.');
          }
      } catch (e) {
          console.error(e);
          alert('❌ Erro de conexão com o servidor.');
      }
  }

  // Auto-update OpenRouter Models
  async function fetchOpenRouterModels() {
    const select = document.getElementById('openrouter-model-select');
    try {
      const response = await fetch('https://openrouter.ai/api/v1/models');
      const data = await response.json();
      
      if (data && data.data) {
        // Sort models by name
        const models = data.data.sort((a, b) => a.name.localeCompare(b.name));
        
        // Keep existing options but add separator
        const initialOptions = select.innerHTML;
        let newOptions = '<optgroup label="Recomendados">' + initialOptions + '</optgroup>';
        newOptions += '<optgroup label="Todos os Modelos">';
        
        models.forEach(model => {
             // Avoid duplicates
             if (!initialOptions.includes(model.id)) {
                 newOptions += `<option value="${model.id}">${model.name} (${model.pricing?.prompt === '0' ? 'Free' : '$'})</option>`;
             }
        });
        
        newOptions += '</optgroup>';
        select.innerHTML = newOptions;
        select.previousElementSibling.innerText = `Total de ${models.length} modelos carregados em tempo real.`;
      }
    } catch (e) {
      console.error('Failed to fetch OpenRouter models', e);
      select.previousElementSibling.innerText = 'Erro ao carregar lista. Usando modelos padrão.';
    }
  }

  // Run on load
  fetchOpenRouterModels();
  
  // Load current config
  async function loadCurrentConfig() {
      try {
          const res = await fetch(`${API_URL}/api/config/ai`);
          const data = await res.json();
          const config = data.config || {};
          
          if (config.activeAI) {
              const radio = document.querySelector(`input[name="activeAI"][value="${config.activeAI}"]`);
              if (radio) radio.checked = true;
          }
          if (config.geminiKey) document.getElementById('gemini-key').value = config.geminiKey;
          if (config.openRouterKey) document.getElementById('openrouter-key').value = config.openRouterKey;
          if (config.grokKey) document.getElementById('grok-key').value = config.grokKey;
          if (config.deepseekKey) {
            document.getElementById('deepseek-key').value = config.deepseekKey;
            checkDeepSeekBalance();
          }
          if (config.deepseekModel) {
            document.getElementById('deepseek-model-select').value = config.deepseekModel;
            updateDeepSeekPricing();
          }
          
      } catch(e) {
          console.error("Error loading config", e);
      }
  }
  loadCurrentConfig();
</script>

<style>
  .btn-cta {
    background: linear-gradient(90deg, #00d4ff, #00ff9d);
    color: black;
    border: none;
    padding: 0.8rem 1.5rem;
    border-radius: 50px;
    font-weight: bold;
    cursor: pointer;
  }
  
  .provider-option {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    background: #1e293b;
    padding: 10px 16px;
    border-radius: 8px;
    border: 1px solid #334155;
    transition: all 0.2s;
  }
  .provider-option:hover {
    border-color: #00ff9d;
    background: #0f172a;
  }
  .provider-option input:checked + .label-text {
    color: #00ff9d;
    font-weight: bold;
  }
</style>
