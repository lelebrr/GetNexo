---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Encerradas Hoje" activeTab="live">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white">Encerradas Hoje</h1>
        <p class="text-gray-400 mt-1">Conversas fechadas no dia de hoje</p>
      </div>
      <div class="flex gap-2">
        <button onclick="refreshTickets()" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition-colors flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Atualizar
        </button>
      </div>
    </div>

    <!-- Search and Filters -->
    <div class="bg-gray-800/50 rounded-xl p-4 border border-gray-700">
      <div class="flex flex-col md:flex-row gap-4">
        <div class="flex-1">
          <input
            type="text"
            id="searchInput"
            placeholder="Buscar por nome, telefone ou ID..."
            class="w-full px-4 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 transition-colors"
            oninput="filterTickets()"
          >
        </div>
        <div class="flex gap-2">
          <select id="sentimentFilter" onchange="filterTickets()" class="px-4 py-2 bg-gray-900 border border-gray-700 rounded-lg text-white focus:outline-none focus:border-emerald-500 transition-colors">
            <option value="">Todos os Sentimentos</option>
            <option value="positive">Positivo</option>
            <option value="neutral">Neutro</option>
            <option value="negative">Negativo</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="bg-gradient-to-br from-emerald-500/20 to-green-500/20 border border-emerald-500/30 rounded-xl p-4">
        <div class="text-2xl font-bold text-white" id="totalClosed">0</div>
        <div class="text-sm text-gray-400">Total Encerradas</div>
      </div>
      <div class="bg-gradient-to-br from-green-500/20 to-emerald-500/20 border border-green-500/30 rounded-xl p-4">
        <div class="text-2xl font-bold text-white" id="positiveClosed">0</div>
        <div class="text-sm text-gray-400">Positivas</div>
      </div>
      <div class="bg-gradient-to-br from-yellow-500/20 to-orange-500/20 border border-yellow-500/30 rounded-xl p-4">
        <div class="text-2xl font-bold text-white" id="neutralClosed">0</div>
        <div class="text-sm text-gray-400">Neutras</div>
      </div>
      <div class="bg-gradient-to-br from-red-500/20 to-orange-500/20 border border-red-500/30 rounded-xl p-4">
        <div class="text-2xl font-bold text-white" id="negativeClosed">0</div>
        <div class="text-sm text-gray-400">Negativas</div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="hidden flex flex-col items-center justify-center min-h-[40vh]">
      <div class="w-12 h-12 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin mb-4"></div>
      <p class="text-gray-400">Carregando conversas encerradas...</p>
    </div>

    <!-- Error State -->
    <div id="errorState" class="hidden flex flex-col items-center justify-center min-h-[40vh] text-center space-y-4">
      <div class="w-16 h-16 bg-red-500/20 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-white">Erro ao carregar</h3>
      <p class="text-gray-400" id="errorMessage">Não foi possível carregar as conversas encerradas.</p>
      <button onclick="refreshTickets()" class="px-6 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition-colors">
        Tentar novamente
      </button>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden flex flex-col items-center justify-center min-h-[40vh] text-center space-y-4">
      <div class="w-16 h-16 bg-gray-700/50 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-white">Nenhuma conversa encerrada</h3>
      <p class="text-gray-400">Não há conversas encerradas hoje.</p>
    </div>

    <!-- Tickets List -->
    <div id="ticketsList" class="hidden space-y-4">
      <!-- Tickets will be rendered here -->
    </div>
  </div>

  <script nonce={Astro.locals.nonce}>
    let allTickets = [];
    let filteredTickets = [];

    async function loadTickets() {
      const loadingState = document.getElementById('loadingState');
      const errorState = document.getElementById('errorState');
      const emptyState = document.getElementById('emptyState');
      const ticketsList = document.getElementById('ticketsList');

      // Show loading
      loadingState.classList.remove('hidden');
      errorState.classList.add('hidden');
      emptyState.classList.add('hidden');
      ticketsList.classList.add('hidden');

      try {
        const today = new Date().toISOString().split('T')[0];
        const response = await fetch(`/api/tickets?status=closed&date=${today}`);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();
        
        if (!data.success) {
          throw new Error(data.message || 'Erro ao carregar tickets');
        }

        allTickets = data.tickets || [];
        filteredTickets = [...allTickets];

        // Update stats
        updateStats();

        // Render tickets
        renderTickets();

        // Show/hide states
        loadingState.classList.add('hidden');
        
        if (allTickets.length === 0) {
          emptyState.classList.remove('hidden');
          ticketsList.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          ticketsList.classList.remove('hidden');
        }

      } catch (error) {
        console.error('Error loading tickets:', error);
        loadingState.classList.add('hidden');
        errorState.classList.remove('hidden');
        document.getElementById('errorMessage').textContent = error.message;
      }
    }

    function updateStats() {
      const total = allTickets.length;
      const positive = allTickets.filter(t => t.sentiment === 'positive').length;
      const neutral = allTickets.filter(t => t.sentiment === 'neutral').length;
      const negative = allTickets.filter(t => t.sentiment === 'negative').length;

      document.getElementById('totalClosed').textContent = total;
      document.getElementById('positiveClosed').textContent = positive;
      document.getElementById('neutralClosed').textContent = neutral;
      document.getElementById('negativeClosed').textContent = negative;
    }

    function renderTickets() {
      const container = document.getElementById('ticketsList');
      
      if (filteredTickets.length === 0) {
        container.innerHTML = `
          <div class="flex flex-col items-center justify-center min-h-[30vh] text-center space-y-4">
            <div class="w-16 h-16 bg-gray-700/50 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-white">Nenhum resultado</h3>
            <p class="text-gray-400">Nenhuma conversa encontrada com os filtros selecionados.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filteredTickets.map(ticket => {
        const sentimentColors = {
          positive: 'bg-green-500/20 text-green-400 border-green-500/30',
          neutral: 'bg-gray-500/20 text-gray-400 border-gray-500/30',
          negative: 'bg-red-500/20 text-red-400 border-red-500/30'
        };

        const priorityBadge = ticket.priority > 0
          ? `<span class="px-2 py-1 bg-red-500/20 text-red-400 border border-red-500/30 rounded text-xs font-medium">Prioridade ${ticket.priority}</span>`
          : '';

        const closedTime = ticket.closed_at
          ? new Date(ticket.closed_at).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
          : 'Sem registro';

        const duration = ticket.created_at && ticket.closed_at
          ? Math.round((new Date(ticket.closed_at) - new Date(ticket.created_at)) / 60000)
          : 0;

        return `
          <div class="bg-gray-800/50 border border-gray-700 rounded-xl p-4 hover:border-emerald-500/50 transition-colors">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-green-500 rounded-full flex items-center justify-center text-white font-bold">
                    ${ticket.customer_name ? ticket.customer_name.charAt(0).toUpperCase() : '?'}
                  </div>
                  <div>
                    <div class="font-semibold text-white">${ticket.customer_name || 'Cliente'}</div>
                    <div class="text-sm text-gray-400">${ticket.customer_phone || 'Sem telefone'}</div>
                  </div>
                  ${priorityBadge}
                </div>
                <div class="text-sm text-gray-400 line-clamp-2">
                  ${ticket.last_message || 'Sem mensagem registrada'}
                </div>
              </div>
              <div class="flex flex-col items-end gap-2">
                <div class="flex gap-2">
                  ${ticket.sentiment ? `<span class="px-2 py-1 ${sentimentColors[ticket.sentiment] || sentimentColors.neutral} rounded text-xs font-medium border">
                    ${ticket.sentiment === 'positive' ? 'Positivo' : ticket.sentiment === 'negative' ? 'Negativo' : 'Neutro'}
                  </span>` : ''}
                  <span class="px-2 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded text-xs font-medium">
                    Encerrado
                  </span>
                </div>
                <div class="text-xs text-gray-500">
                  ${closedTime}
                </div>
                ${duration > 0 ? `<div class="text-xs text-gray-500">
                  Duração: ${duration} min
                </div>` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function filterTickets() {
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();
      const sentimentFilter = document.getElementById('sentimentFilter').value;

      filteredTickets = allTickets.filter(ticket => {
        const matchesSearch = !searchTerm ||
          (ticket.customer_name && ticket.customer_name.toLowerCase().includes(searchTerm)) ||
          (ticket.customer_phone && ticket.customer_phone.toLowerCase().includes(searchTerm)) ||
          (ticket.id && ticket.id.toLowerCase().includes(searchTerm));

        const matchesSentiment = !sentimentFilter || ticket.sentiment === sentimentFilter;

        return matchesSearch && matchesSentiment;
      });

      renderTickets();
    }

    function refreshTickets() {
      loadTickets();
    }

    // Load tickets on page load
    document.addEventListener('DOMContentLoaded', loadTickets);
  </script>
</AdminLayout>
