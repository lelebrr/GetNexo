---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Exportar Conversa" activeTab="live">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white">Exportar Conversa</h1>
        <p class="text-gray-400 mt-1">Exporte conversas para análise e relatórios</p>
      </div>
    </div>

    <!-- Export Options -->
    <div class="bg-gray-800/50 rounded-xl p-6 border border-gray-700">
      <h2 class="text-xl font-semibold text-white mb-4">Opções de Exportação</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Export by Date Range -->
        <div class="bg-gray-900/50 rounded-lg p-4 border border-gray-700">
          <h3 class="font-semibold text-white mb-3">Por Período</h3>
          <div class="space-y-3">
            <div>
              <label class="text-sm text-gray-400">Data Inicial</label>
              <input type="date" id="startDate" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:border-cyan-500 transition-colors">
            </div>
            <div>
              <label class="text-sm text-gray-400">Data Final</label>
              <input type="date" id="endDate" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:border-cyan-500 transition-colors">
            </div>
            <button onclick="exportByDate()" class="w-full px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg transition-colors flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Exportar CSV
            </button>
          </div>
        </div>

        <!-- Export by Status -->
        <div class="bg-gray-900/50 rounded-lg p-4 border border-gray-700">
          <h3 class="font-semibold text-white mb-3">Por Status</h3>
          <div class="space-y-3">
            <div>
              <label class="text-sm text-gray-400">Status</label>
              <select id="statusExport" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:border-cyan-500 transition-colors">
                <option value="">Todos os Status</option>
                <option value="open">Aberto</option>
                <option value="waiting">Aguardando</option>
                <option value="closed">Fechado</option>
              </select>
            </div>
            <button onclick="exportByStatus()" class="w-full px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg transition-colors flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Exportar CSV
            </button>
          </div>
        </div>

        <!-- Export by Sentiment -->
        <div class="bg-gray-900/50 rounded-lg p-4 border border-gray-700">
          <h3 class="font-semibold text-white mb-3">Por Sentimento</h3>
          <div class="space-y-3">
            <div>
              <label class="text-sm text-gray-400">Sentimento</label>
              <select id="sentimentExport" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white focus:outline-none focus:border-cyan-500 transition-colors">
                <option value="">Todos os Sentimentos</option>
                <option value="positive">Positivo</option>
                <option value="neutral">Neutro</option>
                <option value="negative">Negativo</option>
              </select>
            </div>
            <button onclick="exportBySentiment()" class="w-full px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg transition-colors flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Exportar CSV
            </button>
          </div>
        </div>

        <!-- Export All -->
        <div class="bg-gray-900/50 rounded-lg p-4 border border-gray-700">
          <h3 class="font-semibold text-white mb-3">Exportar Tudo</h3>
          <div class="space-y-3">
            <p class="text-sm text-gray-400">Exporte todas as conversas do sistema</p>
            <button onclick="exportAll()" class="w-full px-4 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white rounded-lg transition-colors flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Exportar Tudo (CSV)
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Export History -->
    <div class="bg-gray-800/50 rounded-xl p-6 border border-gray-700">
      <h2 class="text-xl font-semibold text-white mb-4">Histórico de Exportações</h2>
      <div id="exportHistory" class="space-y-3">
        <!-- Export history will be rendered here -->
      </div>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="hidden flex flex-col items-center justify-center min-h-[30vh]">
      <div class="w-12 h-12 border-4 border-cyan-500 border-t-transparent rounded-full animate-spin mb-4"></div>
      <p class="text-gray-400">Exportando dados...</p>
    </div>

    <!-- Success State -->
    <div id="successState" class="hidden flex flex-col items-center justify-center min-h-[30vh] text-center space-y-4">
      <div class="w-16 h-16 bg-green-500/20 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-white">Exportação Concluída</h3>
      <p class="text-gray-400" id="successMessage">O arquivo foi gerado com sucesso.</p>
      <button onclick="downloadFile()" class="px-6 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg transition-colors">
        Baixar Arquivo
      </button>
    </div>

    <!-- Error State -->
    <div id="errorState" class="hidden flex flex-col items-center justify-center min-h-[30vh] text-center space-y-4">
      <div class="w-16 h-16 bg-red-500/20 rounded-full flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-white">Erro na Exportação</h3>
      <p class="text-gray-400" id="errorMessage">Não foi possível exportar os dados.</p>
    </div>
  </div>

  <script nonce={Astro.locals.nonce}>
    let exportHistory = [];
    let lastExportFile = null;

    async function exportByDate() {
      const startDate = document.getElementById('startDate').value;
      const endDate = document.getElementById('endDate').value;

      if (!startDate || !endDate) {
        alert('Por favor, selecione um período.');
        return;
      }

      await performExport(`date=${startDate}&date=${endDate}`, 'Por Período');
    }

    async function exportByStatus() {
      const status = document.getElementById('statusExport').value;
      
      if (!status) {
        alert('Por favor, selecione um status.');
        return;
      }

      await performExport(`status=${status}`, `Por Status: ${status}`);
    }

    async function exportBySentiment() {
      const sentiment = document.getElementById('sentimentExport').value;
      
      if (!sentiment) {
        alert('Por favor, selecione um sentimento.');
        return;
      }

      await performExport(`sentiment=${sentiment}`, `Por Sentimento: ${sentiment}`);
    }

    async function exportAll() {
      await performExport('', 'Todas as Conversas');
    }

    async function performExport(queryParams, description) {
      const loadingState = document.getElementById('loadingState');
      const successState = document.getElementById('successState');
      const errorState = document.getElementById('errorState');

      // Show loading
      loadingState.classList.remove('hidden');
      successState.classList.add('hidden');
      errorState.classList.add('hidden');

      try {
        const response = await fetch(`/api/tickets/export?${queryParams}`);
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();
        
        if (!data.success) {
          throw new Error(data.message || 'Erro ao exportar dados');
        }

        // Store file for download
        lastExportFile = {
          filename: data.filename,
          content: data.content,
          description: description
        };

        // Add to history
        exportHistory.unshift({
          date: new Date().toLocaleString('pt-BR'),
          description: description,
          filename: data.filename
        });

        // Update history display
        updateHistoryDisplay();

        // Show success
        loadingState.classList.add('hidden');
        successState.classList.remove('hidden');
        document.getElementById('successMessage').textContent = `Arquivo ${data.filename} gerado com sucesso.`;

      } catch (error) {
        console.error('Error exporting:', error);
        loadingState.classList.add('hidden');
        errorState.classList.remove('hidden');
        document.getElementById('errorMessage').textContent = error.message;
      }
    }

    function updateHistoryDisplay() {
      const container = document.getElementById('exportHistory');
      
      if (exportHistory.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 text-gray-500">
            <p>Nenhum histórico de exportação</p>
          </div>
        `;
        return;
      }

      container.innerHTML = exportHistory.map((item, index) => `
        <div class="flex items-center justify-between bg-gray-900/50 rounded-lg p-3 border border-gray-700">
          <div class="flex-1">
            <div class="font-medium text-white">${item.description}</div>
            <div class="text-sm text-gray-400">${item.date}</div>
          </div>
          <div class="text-sm text-cyan-400 font-mono">${item.filename}</div>
        </div>
      `).join('');
    }

    function downloadFile() {
      if (!lastExportFile) return;

      const blob = new Blob([lastExportFile.content], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = lastExportFile.filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      updateHistoryDisplay();
    });
  </script>
</AdminLayout>
