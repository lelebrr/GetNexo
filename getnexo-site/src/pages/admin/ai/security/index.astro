---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { ShieldAlert, ShieldCheck, Activity, Lock, Eye, Terminal, Zap, Shield, Fingerprint } from 'lucide-react';

const title = "Segurança IA – Monitoramento Autônomo";
---

<AdminLayout title={title} activeTab="security-ia">
  <div class="security-dashboard" x-data="securityIA()">
    
    <!-- Hero Status -->
    <header class="mb-10 p-8 lg:p-12 rounded-3xl bg-black border border-red-500/20 shadow-[0_0_50px_rgba(239,68,68,0.05)] relative overflow-hidden">
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
        <div>
          <div class="flex items-center space-x-3 mb-6">
            <div class="flex -space-x-2">
               <div class="w-8 h-8 rounded-full bg-red-500/20 border border-red-500/30 flex items-center justify-center">
                  <Fingerprint className="w-4 h-4 text-red-400" />
               </div>
               <div class="w-8 h-8 rounded-full bg-rose-500/20 border border-rose-500/30 flex items-center justify-center">
                  <ShieldCheck className="w-4 h-4 text-rose-400" />
               </div>
            </div>
            <span class="text-[10px] font-black text-rose-400 tracking-widest uppercase bg-rose-500/10 px-2 py-1 rounded">Protocolo de Defesa GetNexo</span>
          </div>
          <h1 class="text-4xl lg:text-5xl font-black text-white mb-4">
            Sistema <span class="text-rose-500" x-text="audit.system_status">--</span>
          </h1>
          <p class="text-gray-400 max-w-xl text-lg">
            Nossa IA está monitorando cada request. Nível de ameaça atual: <span class="text-rose-400 font-bold uppercase tracking-tighter" x-text="audit.threat_level">--</span>. 
            Nenhuma ação humana necessária no momento.
          </p>
        </div>

        <!-- Pulse Scan Overlay -->
        <div class="relative">
          <div class="w-32 h-32 rounded-full border-2 border-rose-500/30 flex items-center justify-center">
             <Shield className="w-12 h-12 text-rose-500 animate-pulse" />
             <div class="absolute inset-0 rounded-full border border-rose-500/50 animate-ping"></div>
          </div>
          <div class="mt-4 text-center">
            <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">IA Scanning...</span>
          </div>
        </div>
      </div>
      
      <!-- Scan Line Effect -->
      <div class="absolute top-0 left-0 w-full h-[1px] bg-rose-500/50 shadow-[0_0_15px_rgba(239,68,68,0.8)] animate-scan"></div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- 1. Deep Insights & Audit -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Proteções Ativas Chips -->
        <div class="flex flex-wrap gap-3">
          <template x-for="prot in audit.active_protections" :key="prot">
            <div class="px-4 py-2 rounded-xl bg-gray-900/60 border border-gray-700 text-xs font-bold text-gray-300 flex items-center">
              <ShieldCheck className="w-3 h-3 text-emerald-400 mr-2" />
              <span x-text="prot">--</span>
            </div>
          </template>
        </div>

        <section class="bg-gray-950 border border-gray-800 rounded-3xl overflow-hidden">
          <div class="p-6 border-b border-gray-800 bg-gray-900/20 flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <Terminal className="w-5 h-5 text-rose-400" />
              <h3 class="text-sm font-bold text-white uppercase tracking-widest">Log de Eventos Detectados</h3>
            </div>
            <span class="text-[10px] text-rose-500 font-bold animate-pulse">LIVE UPDATE</span>
          </div>
          
          <div class="p-2 space-y-1 font-mono text-xs">
            <template x-for="event in audit.recent_events" :key="event.time + event.event">
              <div class="p-3 flex items-start space-x-4 hover:bg-white/5 transition-all rounded-lg">
                <span class="text-gray-600" x-text="'['+event.time+']'">--</span>
                <span class="font-bold px-1.5 rounded" :class="event.type === 'Critical' ? 'bg-red-500/20 text-red-400' : 'bg-rose-500/10 text-rose-300'" x-text="event.type">--</span>
                <span class="text-gray-400" x-text="event.event">--</span>
              </div>
            </template>
          </div>
        </section>

        <!-- Threat Map Placeholder -->
        <div class="grid grid-cols-2 gap-4">
           <div class="bg-gray-900/40 p-6 rounded-3xl border border-gray-800 flex flex-col items-center justify-center">
              <Activity className="w-8 h-8 text-rose-500 mb-2 opacity-50" />
              <span class="text-2xl font-black text-white">47</span>
              <span class="text-[10px] text-gray-500 uppercase font-bold tracking-widest">Bot Scans Bloqueados</span>
           </div>
           <div class="bg-gray-900/40 p-6 rounded-3xl border border-gray-800 flex flex-col items-center justify-center">
              <Lock className="w-8 h-8 text-rose-500 mb-2 opacity-50" />
              <span class="text-2xl font-black text-white">0</span>
              <span class="text-[10px] text-gray-500 uppercase font-bold tracking-widest">Vazamentos Detectados</span>
           </div>
        </div>
      </div>

      <!-- 2. IA Security Expert Side -->
      <aside class="space-y-6">
        <section class="bg-rose-950/20 border border-rose-500/20 rounded-3xl p-8 relative overflow-hidden group">
           <div class="relative z-10">
              <div class="flex items-center space-x-2 mb-4">
                 <Zap className="w-5 h-5 text-rose-400" />
                 <h4 class="text-sm font-black text-white uppercase tracking-widest">Insight do Guardião IA</h4>
              </div>
              <p class="text-rose-100/80 leading-relaxed italic text-sm mb-6" x-text="'&quot;' + audit.ai_insights + '&quot;'">
                --
              </p>
              <button class="w-full py-4 bg-rose-600 hover:bg-rose-500 text-white font-black rounded-2xl transition-all shadow-lg shadow-rose-900/40" @click="fetchAudit()">
                 Executar Varredura Profunda
              </button>
           </div>
           <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-rose-500/10 blur-3xl group-hover:bg-rose-500/20 transition-all"></div>
        </section>

        <!-- Quick Access -->
        <div class="bg-gray-900/40 rounded-3xl border border-gray-800 p-6">
           <h4 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">Perímetro de Defesa</h4>
           <div class="space-y-3">
              <a href="/admin/security/firewall" class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-all group">
                 <span class="text-sm text-gray-300">Configurar Firewall</span>
                 <Shield className="w-4 h-4 text-gray-600 group-hover:text-rose-500" />
              </a>
              <a href="/admin/security/audit" class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-all group">
                 <span class="text-sm text-gray-300">Auditoria Completa</span>
                 <Eye className="w-4 h-4 text-gray-600 group-hover:text-rose-500" />
              </a>
              <a href="/admin/security/backups" class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-all group">
                 <span class="text-sm text-gray-300">Snapshot de Backup</span>
                 <Zap className="w-4 h-4 text-gray-600 group-hover:text-rose-500" />
              </a>
           </div>
        </div>
      </aside>

    </div>
  </div>
</AdminLayout>

<script is:inline>
  function securityIA() {
    return {
      audit: {
        threat_level: 'Calculando...',
        system_status: 'Scanning...',
        active_protections: [],
        recent_events: [],
        ai_insights: 'Aguardando análise da IA...',
        failed_transactions_24h: 0,
        new_contacts_1h: 0
      },
      async fetchAudit() {
        try {
          const res = await fetch('/api/ai/security/audit');
          if (res.ok) {
            const data = await res.json();
            this.audit = data;
          }
        } catch (e) {
          console.error('Erro ao buscar auditoria de segurança:', e);
          this.audit.ai_insights = 'Falha na conexão com o sistema de monitoramento.';
        }
      },
      init() {
        this.fetchAudit();
      }
    }
  }
</script>

<style>
  .security-dashboard {
    animation: fadeIn 0.5s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes scan {
    from { top: 0; }
    to { top: 100%; }
  }
  .animate-scan {
    animation: scan 4s linear infinite;
  }
</style>
