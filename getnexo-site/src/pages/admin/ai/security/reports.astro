---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { FileText, Download, Calendar, Filter } from 'lucide-react';

const title = "Relatórios de Segurança IA";
---

<AdminLayout title={title} activeTab="security-ia">
  <div class="max-w-4xl mx-auto space-y-6 animate-fade-in">
    
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-white flex items-center gap-2">
        <FileText className="w-6 h-6 text-gray-400" />
        Arquivos & Relatórios
      </h1>
      <button class="bg-white text-black hover:bg-gray-200 px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wide transition-all">
        Gerar Novo Relatório
      </button>
    </header>

    <div class="grid gap-4">
      
      <!-- Report Item -->
      <div class="bg-gray-900/40 border border-gray-800 rounded-2xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:border-gray-600 transition-all group">
         <div class="flex items-start gap-4">
           <div class="p-3 bg-red-500/10 rounded-xl">
             <FileText className="w-6 h-6 text-red-400" />
           </div>
           <div>
             <h3 class="font-bold text-white">Relatório Mensal de Ameaças</h3>
             <div class="flex items-center gap-3 mt-1">
               <span class="text-gray-500 text-xs flex items-center gap-1">
                 <Calendar className="w-3 h-3" /> Jan 2026
               </span>
               <span class="text-gray-600 text-xs">•</span>
               <span class="text-gray-500 text-xs uppercase font-bold">PDF, 2.4 MB</span>
             </div>
           </div>
         </div>
         <button class="px-4 py-2 bg-gray-800 border border-gray-700 hover:bg-gray-700 rounded-xl text-gray-300 hover:text-white text-xs font-bold transition-all flex items-center justify-center gap-2 group-hover:border-gray-500">
           <Download className="w-4 h-4" /> Download
         </button>
      </div>

       <!-- Report Item -->
      <div class="bg-gray-900/40 border border-gray-800 rounded-2xl p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:border-gray-600 transition-all group">
         <div class="flex items-start gap-4">
           <div class="p-3 bg-blue-500/10 rounded-xl">
             <FileText className="w-6 h-6 text-blue-400" />
           </div>
           <div>
             <h3 class="font-bold text-white">Auditoria de Acesso (Login Logs)</h3>
             <div class="flex items-center gap-3 mt-1">
               <span class="text-gray-500 text-xs flex items-center gap-1">
                 <Calendar className="w-3 h-3" /> Semana 4, Jan
               </span>
               <span class="text-gray-600 text-xs">•</span>
               <span class="text-gray-500 text-xs uppercase font-bold">CSV, 156 KB</span>
             </div>
           </div>
         </div>
         <button class="px-4 py-2 bg-gray-800 border border-gray-700 hover:bg-gray-700 rounded-xl text-gray-300 hover:text-white text-xs font-bold transition-all flex items-center justify-center gap-2 group-hover:border-gray-500">
           <Download className="w-4 h-4" /> Download
         </button>
      </div>

    </div>

  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.4s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
