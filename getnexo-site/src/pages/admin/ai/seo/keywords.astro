---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { Search, TrendingUp, Sparkles, Brain, ArrowUpRight, BarChart2, Filter } from 'lucide-react';

const title = "Pesquisa de Keywords IA";
---

<AdminLayout title={title} activeTab="seo">
  <div class="max-w-7xl mx-auto space-y-6 animate-fade-in" x-data="keywordsIA()">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-white flex items-center gap-2">
          <Brain className="w-6 h-6 text-cyan-400" />
          Explorer de Keywords
        </h1>
        <p class="text-gray-400 text-sm mt-1">Descubra oportunidades de tráfego orgânico com análise preditiva.</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="relative">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" />
          <input 
            type="text" 
            placeholder="Buscar termo..." 
            class="pl-9 pr-4 py-2 bg-gray-900 border border-gray-800 rounded-xl text-sm text-white focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/50 outline-none w-64 md:w-80 transition-all"
            x-model="search"
          >
        </div>
        <button class="p-2 bg-gray-900 border border-gray-800 rounded-xl text-gray-400 hover:text-white transition-all">
          <Filter className="w-4 h-4" />
        </button>
      </div>
    </div>

    <!-- Main Card -->
    <div class="bg-gray-900/40 border border-gray-800 rounded-3xl overflow-hidden backdrop-blur-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-gray-800 text-xs text-gray-400 uppercase tracking-wider">
              <th class="p-6 font-medium">Termo / Keyword</th>
              <th class="p-6 font-medium text-center">Volume</th>
              <th class="p-6 font-medium text-center">Dificuldade</th>
              <th class="p-6 font-medium text-center">Tendência</th>
              <th class="p-6 font-medium text-right">Ação</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800/50">
            <template x-for="kw in filteredKeywords" :key="kw.term">
              <tr class="group hover:bg-white/5 transition-colors">
                <td class="p-6">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-gray-800 flex items-center justify-center text-gray-400 group-hover:text-cyan-400 transition-colors">
                      <Search className="w-4 h-4" />
                    </div>
                    <div>
                      <p class="text-white font-medium text-sm" x-text="kw.term">--</p>
                      <p class="text-xs text-gray-500">Intenção: <span class="text-gray-400">Transacional</span></p>
                    </div>
                  </div>
                </td>
                <td class="p-6 text-center">
                  <span class="text-sm font-bold text-gray-300" x-text="kw.volume">--</span>
                </td>
                <td class="p-6 text-center">
                  <span 
                    class="px-2.5 py-1 rounded-full text-[10px] font-bold border border-current"
                    :class="{
                      'bg-emerald-500/10 text-emerald-400 border-emerald-500/20': kw.difficulty === 'Baixa',
                      'bg-yellow-500/10 text-yellow-400 border-yellow-500/20': kw.difficulty === 'Média',
                      'bg-red-500/10 text-red-400 border-red-500/20': kw.difficulty === 'Alta'
                    }"
                    x-text="kw.difficulty"
                  >--</span>
                </td>
                <td class="p-6">
                  <div class="flex items-center justify-center gap-1.5" :class="kw.trend === 'up' ? 'text-emerald-400' : 'text-gray-500'">
                    <TrendingUp x-show="kw.trend === 'up'" className="w-4 h-4" />
                    <BarChart2 x-show="kw.trend !== 'up'" className="w-4 h-4" />
                    <span class="text-xs font-bold" x-text="kw.trend === 'up' ? '+15%' : '0%'">--</span>
                  </div>
                </td>
                <td class="p-6 text-right">
                  <button class="px-3 py-1.5 bg-cyan-600/10 hover:bg-cyan-600/20 text-cyan-400 hover:text-cyan-300 text-xs font-bold rounded-lg transition-all flex items-center gap-2 ml-auto">
                    Gerar Conteúdo
                    <Sparkles className="w-3 h-3" />
                  </button>
                </td>
              </tr>
            </template>
            <!-- Empty State -->
            <tr x-show="filteredKeywords.length === 0">
              <td colspan="5" class="p-12 text-center text-gray-500">
                <p class="mb-2">Nenhuma keyword encontrada.</p>
                <button @click="fetchData()" class="text-cyan-400 hover:underline text-xs">Recarregar dados</button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function keywordsIA() {
    return {
      search: '',
      keywords: [],
      async fetchData() {
        try {
          // Reusing existing stats endpoint which contains keywords data
          const res = await fetch('/api/ai/seo/stats');
          const data = await res.json();
          this.keywords = data.keywords || [];
        } catch (e) {
          console.error('Erro ao buscar keywords:', e);
        }
      },
      get filteredKeywords() {
        if (!this.search) return this.keywords;
        return this.keywords.filter(k => k.term.toLowerCase().includes(this.search.toLowerCase()));
      },
      init() {
        this.fetchData();
      }
    }
  }
</script>

<style>
  .animate-fade-in { animation: fadeIn 0.4s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
