---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { Sparkles, FileText, Zap, Check, AlertCircle, RefreshCw } from 'lucide-react';

const title = "Otimizador de Conteúdo IA";
---

<AdminLayout title={title} activeTab="seo">
  <div class="max-w-5xl mx-auto space-y-6 animate-fade-in" x-data="optimizer()">
    
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-white flex items-center gap-2">
        <Sparkles className="w-6 h-6 text-purple-400" />
        Content Optimizer
      </h1>
      <button class="px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-2" @click="analyze()">
        <Zap className="w-4 h-4" />
        Analisar Agora
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Editor -->
      <div class="lg:col-span-2 space-y-4">
        <div class="bg-gray-900/40 border border-gray-800 rounded-3xl p-6 backdrop-blur-sm">
           <textarea 
             x-model="content"
             rows="15" 
             placeholder="Cole seu texto aqui para a IA analisar..."
             class="w-full bg-transparent border-none text-gray-300 placeholder-gray-600 focus:ring-0 resize-none text-base leading-relaxed"
           ></textarea>
           <div class="flex justify-between text-xs text-gray-500 mt-4 border-t border-gray-800 pt-4">
             <span x-text="wordCount + ' palavras'">0 palavras</span>
             <span x-text="readabilityScore + ' legibilidade'">--</span>
           </div>
        </div>
      </div>

      <!-- Sidebar Metrics -->
      <div class="space-y-4">
        <!-- Score Card -->
        <div class="bg-gradient-to-br from-purple-900/20 to-indigo-900/10 border border-purple-500/20 rounded-3xl p-6 text-center">
          <div class="relative w-24 h-24 mx-auto mb-4 flex items-center justify-center">
            <svg class="w-full h-full transform -rotate-90">
               <circle class="text-gray-800" stroke-width="6" stroke="currentColor" fill="transparent" r="42" cx="48" cy="48"></circle>
               <circle class="text-purple-500 transition-all duration-1000" stroke-width="6" :stroke-dasharray="2 * Math.PI * 42" :stroke-dashoffset="2 * Math.PI * 42 * (1 - score/100)" stroke-linecap="round" stroke="currentColor" fill="transparent" r="42" cx="48" cy="48"></circle>
            </svg>
            <div class="absolute inset-0 flex items-center justify-center text-3xl font-black text-white" x-text="score">
              0
            </div>
          </div>
          <p class="text-purple-400 font-bold uppercase tracking-widest text-xs">SEO Score</p>
        </div>

        <!-- Checklist -->
        <div class="bg-gray-900/40 border border-gray-800 rounded-3xl p-6">
          <h3 class="font-bold text-white mb-4 text-sm">Sugestões de IA</h3>
          <div class="space-y-3">
            <template x-for="item in suggestions" :key="item.id">
              <div class="flex items-start gap-3 p-3 rounded-xl bg-black/20" :class="item.done ? 'opacity-50' : ''">
                <div class="mt-0.5">
                   <Check x-show="item.done" className="w-4 h-4 text-emerald-500" />
                   <AlertCircle x-show="!item.done" className="w-4 h-4 text-yellow-500" />
                </div>
                <p class="text-xs text-gray-300 leading-snug" x-text="item.text">--</p>
              </div>
            </template>
          </div>
        </div>

      </div>

    </div>
  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function optimizer() {
    return {
      content: 'A automação de WhatsApp transformou a maneira como empresas interagem com clientes. Utilizando IA, é possível responder instantaneamente.',
      score: 85,
      suggestions: [
        { id: 1, text: 'Adicione a keyword "API Oficial" no primeiro parágrafo.', done: false },
        { id: 2, text: 'Use parágrafos mais curtos para melhorar a leitura mobile.', done: true },
        { id: 3, text: 'Inclua pelo menos 1 subtítulo H2.', done: false }
      ],
      get wordCount() {
        return this.content.trim().split(/\s+/).length;
      },
      get readabilityScore() {
        return this.wordCount > 10 ? 'Fácil de ler' : 'N/A';
      },
      analyze() {
        // Mock analysis
        this.score = Math.floor(Math.random() * 20) + 80;
        this.suggestions.push({ id: Date.now(), text: 'Ótimo uso de voz ativa!', done: true });
      }
    }
  }
</script>

<style>
  .animate-fade-in { animation: fadeIn 0.4s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
