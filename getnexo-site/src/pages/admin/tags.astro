---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Tags & Segmentos" activeTab="tags">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-teal-500 to-cyan-500 rounded-2xl flex items-center justify-center shadow-lg shadow-teal-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Tags & Segmentos
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Gerencie tags, segmentos dinâmicos e relatórios por tag.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/tags/list" class="px-6 py-3 bg-teal-600/20 hover:bg-teal-600/40 text-teal-400 rounded-lg border border-teal-500/30 transition-all">Lista de Tags</a>
      <a href="/admin/tags/new" class="px-6 py-3 bg-cyan-600/20 hover:bg-cyan-600/40 text-cyan-400 rounded-lg border border-cyan-500/30 transition-all">Criar Nova Tag</a>
      <a href="/admin/tags/segments" class="px-6 py-3 bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 rounded-lg border border-purple-500/30 transition-all">Segmentos</a>
    </div>
  </div>
</AdminLayout>
