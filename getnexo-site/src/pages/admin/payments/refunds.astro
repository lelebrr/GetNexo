---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { RefreshCcw, Search, Filter, AlertTriangle, ArrowRight, User } from 'lucide-react';

const refunds = [
  { id: "REF-102", lead: "Marcos G.", value: "R$ 1.200,00", reason: "Arrependimento", status: "Processando", date: "Há 2h" },
  { id: "REF-101", lead: "Loja Silva", value: "R$ 450,00", reason: "Produto Defeituoso", status: "Completo", date: "Há 1d" },
];
---

<AdminLayout title="Gestão de Reembolsos" activeTab="payments">
  <div class="space-y-8 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center uppercase tracking-tighter">
          <RefreshCcw className="w-8 h-8 text-rose-500 mr-3 animate-spin-reverse" />
          Reembolsos & Estornos
        </h1>
        <p class="text-sm text-gray-400 mt-1">Gerencie solicitações de devolução de valores com agilidade.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
       <!-- Lista de Reembolsos -->
       <div class="lg:col-span-2 bg-gray-900/30 border border-gray-800 rounded-[2.5rem] overflow-hidden">
          <div class="p-6 bg-black/40 border-b border-gray-800 flex items-center justify-between">
             <h3 class="text-xs font-black uppercase text-gray-500 tracking-widest">Solicitações Recentes</h3>
             <div class="flex items-center space-x-2">
                <Search className="w-4 h-4 text-gray-700 mr-4" />
                <Filter className="w-4 h-4 text-gray-700" />
             </div>
          </div>
          <div class="divide-y divide-gray-800/50">
             {refunds.map(r => (
               <div class="p-8 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                  <div class="flex items-center space-x-6">
                     <div class="w-12 h-12 bg-gray-800 rounded-2xl flex items-center justify-center text-gray-500 group-hover:bg-rose-500/10 group-hover:text-rose-500 transition-all">
                        <User className="w-6 h-6" />
                     </div>
                     <div>
                        <h4 class="text-sm font-bold text-white uppercase tracking-tight">{r.lead}</h4>
                        <p class="text-[10px] text-gray-600 font-medium">{r.id} • {r.reason}</p>
                     </div>
                  </div>
                  <div class="text-right flex items-center space-x-8">
                     <div>
                        <p class="text-xs font-mono font-bold text-white">{r.value}</p>
                        <span class:list={["text-[8px] font-black uppercase", r.status === 'Processando' ? 'text-orange-500' : 'text-emerald-500']}>{r.status}</span>
                     </div>
                     <button class="p-3 bg-gray-800 rounded-2xl hover:bg-rose-600 hover:text-white transition-all text-gray-600">
                        <ArrowRight className="w-4 h-4" />
                     </button>
                  </div>
               </div>
             ))}
          </div>
       </div>

       <!-- Stats Sidebar -->
       <div class="space-y-6">
          <div class="bg-gradient-to-br from-rose-900/20 to-transparent border border-rose-500/20 rounded-[2rem] p-8">
             <AlertTriangle className="w-8 h-8 text-rose-500 mb-4" />
             <h4 class="text-lg font-bold text-white mb-2 tracking-tight uppercase">Taxa de Refund</h4>
             <p class="text-4xl font-black text-rose-500">1.2%</p>
             <p class="text-xs text-gray-500 mt-2 font-medium">Sua taxa está abaixo da média do mercado (3.5%). Parabéns!</p>
          </div>
          
          <div class="bg-gray-900 border border-gray-800 rounded-[2rem] p-8 space-y-4">
             <h4 class="text-xs font-black uppercase text-gray-600 tracking-[0.2em] mb-4">Ação Rápida</h4>
             <button class="w-full py-4 bg-gray-800 hover:bg-gray-700 rounded-2xl text-[10px] font-black uppercase text-white transition-all">
                Novo Reembolso Manual
             </button>
             <p class="text-[10px] text-center text-gray-500">Clique para iniciar um estorno forçado.</p>
          </div>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  @keyframes spin-reverse { from { transform: rotate(360deg); } to { transform: rotate(0deg); } }
  .animate-spin-reverse { animation: spin-reverse 10s linear infinite; }
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

