---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { FileSearch, Check, X, Eye, User, Clock, AlertCircle } from 'lucide-react';
---

<AdminLayout title="Comprovantes Pendentes" activeTab="payments">
  <div class="max-w-6xl mx-auto space-y-8 animate-fade-in py-4"
       x-data="{ 
         pending: [
           { id: 'CX-102', user: 'Roberto Silva', value: 'R$ 899,00', method: 'PIX', time: 'Há 12 min', bank: 'Nubank' },
           { id: 'CX-101', user: 'Maria Oliveira', value: 'R$ 2.450,00', method: 'Transferência', time: 'Há 45 min', bank: 'Itaú' },
           { id: 'CX-100', user: 'Tech Ltda', value: 'R$ 15.000,00', method: 'Boleto (Anexo)', time: 'Há 2h', bank: 'Bradesco' }
         ],
         remove(id) {
           this.pending = this.pending.filter(p => p.id !== id);
         }
       }">
    
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Validação de Comprovantes</h1>
        <p class="text-sm text-gray-500">Aprove ou rejeite pagamentos manuais que exigem conferência humana.</p>
      </div>
      <div class="px-4 py-2 bg-amber-500/10 border border-amber-500/20 rounded-xl">
         <span class="text-[10px] font-black text-amber-500 uppercase tracking-widest" x-text="pending.length + ' Pendentes'"></span>
      </div>
    </div>

    <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <div class="p-8 border-b border-gray-800 bg-black/20 flex items-center justify-between">
          <div class="flex items-center space-x-3">
             <FileSearch className="w-5 h-5 text-gray-500" />
             <h3 class="text-xs font-black uppercase text-gray-400 tracking-widest">Fila de Conferência</h3>
          </div>
       </div>

       <div class="divide-y divide-gray-800/50" x-show="pending.length > 0">
          <template x-for="item in pending" :key="item.id">
             <div class="p-8 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                <div class="flex items-center space-x-8">
                   <div class="w-14 h-14 bg-gray-800 rounded-2xl flex items-center justify-center text-gray-600 group-hover:bg-amber-500/10 group-hover:text-amber-500 transition-all">
                      <User className="w-7 h-7" />
                   </div>
                   <div>
                      <h4 class="text-sm font-bold text-white uppercase tracking-tight" x-text="item.user"></h4>
                      <p class="text-[10px] text-gray-600 font-medium" x-text="item.id + ' • ' + item.bank"></p>
                   </div>
                </div>

                <div class="flex items-center space-x-12">
                   <div class="text-center">
                      <p class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Valor</p>
                      <p class="text-sm font-mono font-bold text-white" x-text="item.value"></p>
                   </div>
                   <div class="text-center">
                      <p class="text-[9px] font-black text-gray-600 uppercase tracking-widest mb-1">Espera</p>
                      <div class="flex items-center text-amber-500/60 font-bold text-[10px]">
                         <Clock className="w-3 h-3 mr-1" />
                         <span x-text="item.time"></span>
                      </div>
                   </div>
                </div>

                <div class="flex items-center space-x-3">
                   <button class="flex items-center space-x-2 px-4 py-2 bg-gray-800 hover:bg-white/10 text-gray-400 hover:text-white rounded-xl text-[10px] font-black uppercase transition-all">
                      <Eye className="w-4 h-4" />
                      <span>Ver Anexo</span>
                   </button>
                   <div class="flex items-center space-x-1">
                      <button @click="remove(item.id)" class="p-3 bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500 hover:text-white rounded-xl transition-all"><Check className="w-5 h-5" /></button>
                      <button @click="remove(item.id)" class="p-3 bg-rose-500/10 text-rose-500 hover:bg-rose-500 hover:text-white rounded-xl transition-all"><X className="w-5 h-5" /></button>
                   </div>
                </div>
             </div>
          </template>
       </div>

       <div x-show="pending.length === 0" class="p-20 text-center space-y-4">
          <div class="w-16 h-16 bg-emerald-500/10 rounded-full flex items-center justify-center mx-auto mb-6">
             <Check className="w-8 h-8 text-emerald-500" />
          </div>
          <h4 class="text-lg font-bold text-white uppercase italic tracking-tighter">Fila Vazia</h4>
          <p class="text-xs text-gray-600">Não há comprovantes aguardando validação no momento.</p>
       </div>
    </div>

    <!-- Alerta de Segurança -->
    <div class="p-6 bg-amber-500/5 border border-amber-500/20 rounded-3xl flex items-start space-x-4">
       <AlertCircle className="w-5 h-5 text-amber-500 shrink-0" />
       <div class="space-y-1">
          <p class="text-xs font-bold text-amber-500 uppercase tracking-tight">Aviso de Fraude</p>
          <p class="text-[10px] text-gray-500 leading-relaxed font-medium">Sempre verifique o extrato bancário oficial antes de aprovar comprovantes PDF, pois estes podem ser facilmente forjados.</p>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
