---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Percent, CreditCard, Landmark, Zap, Save, RefreshCw } from 'lucide-react';
---

<AdminLayout title="Configurar Taxas" activeTab="payments">
  <div class="max-w-4xl mx-auto space-y-10 animate-fade-in py-4"
       x-data="{ 
         saving: false,
         rates: {
           pix: 0.99,
           credit_1x: 3.49,
           credit_parcelado: 4.89,
           boleto: 2.50
         },
         save() {
           this.saving = true;
           setTimeout(() => { this.saving = false }, 1500);
         }
       }">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-emerald-500/10 rounded-2xl flex items-center justify-center text-emerald-500 border border-emerald-500/20 shadow-xl shadow-emerald-500/10">
          <Percent className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Taxas & Comissões</h1>
          <p class="text-sm text-gray-500">Configure as taxas de processamento para cada meio de pagamento.</p>
        </div>
      </div>
      <button @click="save()" class="px-8 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-black rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-emerald-600/20 uppercase text-xs tracking-widest min-w-[160px] justify-center">
         <template x-if="!saving">
            <div class="flex items-center space-x-2">
               <Save className="w-4 h-4" />
               <span>Salvar Alterações</span>
            </div>
         </template>
         <template x-if="saving">
            <div class="flex items-center space-x-2">
               <RefreshCw className="w-4 h-4 animate-spin" />
               <span>Processando...</span>
            </div>
         </template>
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
       <!-- PIX -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] space-y-6">
          <div class="flex items-center space-x-3 text-emerald-400">
             <Landmark className="w-5 h-5" />
             <h3 class="text-[10px] font-black uppercase tracking-[0.2em]">Pagamento via PIX</h3>
          </div>
          <div class="space-y-1">
             <label class="text-[9px] font-black uppercase text-gray-600 tracking-widest ml-1">Taxa Percentual (%)</label>
             <div class="relative">
                <input type="number" x-model="rates.pix" step="0.01" class="w-full bg-black/40 border border-gray-800 rounded-xl px-4 py-3 text-lg font-mono font-bold text-white focus:border-emerald-500 outline-none" />
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-600 font-bold">%</span>
             </div>
          </div>
          <p class="text-[10px] text-gray-500 leading-relaxed italic">"Liquidação instantânea. Recomendamos manter abaixo de 1% para incentivar o uso."</p>
       </div>

       <!-- Cartão -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] space-y-6">
          <div class="flex items-center space-x-3 text-blue-400">
             <CreditCard className="w-5 h-5" />
             <h3 class="text-[10px] font-black uppercase tracking-[0.2em]">Cartão de Crédito (1x)</h3>
          </div>
          <div class="space-y-1">
             <label class="text-[9px] font-black uppercase text-gray-600 tracking-widest ml-1">Taxa Percentual (%)</label>
             <div class="relative">
                <input type="number" x-model="rates.credit_1x" step="0.01" class="w-full bg-black/40 border border-gray-800 rounded-xl px-4 py-3 text-lg font-mono font-bold text-white focus:border-blue-500 outline-none" />
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-600 font-bold">%</span>
             </div>
          </div>
          <p class="text-[10px] text-gray-500 leading-relaxed italic">"Taxa padrão para recebimento em 30 dias. Para antecipação, consulte o Gateway."</p>
       </div>

       <!-- Parcelado -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] space-y-6">
          <div class="flex items-center space-x-3 text-purple-400">
             <Zap className="w-5 h-5" />
             <h3 class="text-[10px] font-black uppercase tracking-[0.2em]">Crédito Parcelado</h3>
          </div>
          <div class="space-y-1">
             <label class="text-[9px] font-black uppercase text-gray-600 tracking-widest ml-1">Taxa Base (%)</label>
             <div class="relative">
                <input type="number" x-model="rates.credit_parcelado" step="0.01" class="w-full bg-black/40 border border-gray-800 rounded-xl px-4 py-3 text-lg font-mono font-bold text-white focus:border-purple-500 outline-none" />
                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-600 font-bold">%</span>
             </div>
          </div>
          <p class="text-[10px] text-gray-500 leading-relaxed italic">"Aplicado em compras de 2x a 12x. O custo financeiro do parcelamento é somado aqui."</p>
       </div>

       <!-- Boleto -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] space-y-6">
          <div class="flex items-center space-x-3 text-gray-400">
             <Landmark className="w-5 h-5 text-gray-500" />
             <h3 class="text-[10px] font-black uppercase tracking-[0.2em]">Boleto Bancário (Fixo)</h3>
          </div>
          <div class="space-y-1">
             <label class="text-[9px] font-black uppercase text-gray-600 tracking-widest ml-1">Valor por Boleto (R$)</label>
             <div class="relative">
                <input type="number" x-model="rates.boleto" step="0.10" class="w-full bg-black/40 border border-gray-800 rounded-xl px-4 py-3 text-lg font-mono font-bold text-white focus:border-gray-500 outline-none" />
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-600 font-bold">R$</span>
             </div>
          </div>
          <p class="text-[10px] text-gray-500 leading-relaxed italic">"Custo fixo por boleto liquidado. A emissão é gratuita na maioria dos parceiros."</p>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
