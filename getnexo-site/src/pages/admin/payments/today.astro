---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { DollarSign, TrendingUp, Users, ArrowUpRight, Zap, Target } from 'lucide-react';
---

<AdminLayout title="Recebimentos Hoje" activeTab="payments">
  <div class="max-w-6xl mx-auto space-y-10 animate-fade-in py-4"
       x-data="{ 
         stats: {
           total: 12450.00,
           count: 42,
           leads: 156,
           conversion: 8.4
         }
       }">
    
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Performance de Hoje</h1>
        <p class="text-sm text-gray-500">Métricas financeiras capturadas em tempo real.</p>
      </div>
      <div class="flex items-center space-x-2 bg-emerald-500/10 border border-emerald-500/20 px-4 py-2 rounded-full">
         <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
         <span class="text-[10px] font-black text-emerald-500 uppercase tracking-widest">Live: Atualizado agora</span>
      </div>
    </div>

    <!-- Cards de Métricas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
       <!-- Card 1 -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] space-y-4 hover:border-emerald-500/30 transition-all group">
          <div class="flex justify-between items-start">
             <div class="p-3 bg-emerald-500/10 rounded-xl text-emerald-500">
                <DollarSign className="w-6 h-6" />
             </div>
             <span class="text-[10px] font-black text-emerald-500">+12% vs ontem</span>
          </div>
          <div>
             <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Volume de Vendas</p>
             <h3 class="text-2xl font-black text-white" x-text="'R$ ' + stats.total.toLocaleString('pt-BR', {minimumFractionDigits: 2})"></h3>
          </div>
       </div>

       <!-- Card 2 -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] space-y-4 hover:border-blue-500/30 transition-all group">
          <div class="flex justify-between items-start">
             <div class="p-3 bg-blue-500/10 rounded-xl text-blue-500">
                <TrendingUp className="w-6 h-6" />
             </div>
             <span class="text-[10px] font-black text-blue-500">+5 agora</span>
          </div>
          <div>
             <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Transações</p>
             <h3 class="text-2xl font-black text-white" x-text="stats.count + ' aprovadas'"></h3>
          </div>
       </div>

       <!-- Card 3 -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] space-y-4 hover:border-purple-500/30 transition-all group">
          <div class="flex justify-between items-start">
             <div class="p-3 bg-purple-500/10 rounded-xl text-purple-500">
                <Users className="w-6 h-6" />
             </div>
             <span class="text-[10px] font-black text-purple-500">Recorde Mensal</span>
          </div>
          <div>
             <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Sessões Ativas</p>
             <h3 class="text-2xl font-black text-white" x-text="stats.leads + ' visitantes'"></h3>
          </div>
       </div>

       <!-- Card 4 -->
       <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2rem] space-y-4 hover:border-orange-500/30 transition-all group">
          <div class="flex justify-between items-start">
             <div class="p-3 bg-orange-500/10 rounded-xl text-orange-500">
                <Target className="w-6 h-6" />
             </div>
             <span class="text-[10px] font-black text-orange-500">Meta: 8.0%</span>
          </div>
          <div>
             <p class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em]">Conversão</p>
             <h3 class="text-2xl font-black text-white" x-text="stats.conversion + '% global'"></h3>
          </div>
       </div>
    </div>

    <!-- Insights Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
       <div class="lg:col-span-2 bg-gradient-to-br from-indigo-900/20 to-transparent border border-indigo-500/20 p-8 rounded-[2.5rem] flex items-center justify-between">
          <div class="space-y-4">
             <div class="flex items-center space-x-2 text-indigo-400">
                <Zap className="w-5 h-5" />
                <span class="text-[10px] font-black uppercase tracking-widest">Predição Nexus IA</span>
             </div>
             <h3 class="text-2xl font-black text-white max-w-md">Baseado no fluxo atual, você deve fechar o dia com <span class="text-emerald-400">R$ 18.200</span>.</h3>
             <button class="px-6 py-2 bg-indigo-600 text-white font-black text-[10px] rounded-xl uppercase tracking-widest">Ver Detalhes</button>
          </div>
          <ArrowUpRight className="w-16 h-16 text-indigo-500/20 hidden md:block" />
       </div>

       <div class="bg-gray-900/20 border border-gray-800 p-8 rounded-[2.5rem] space-y-6">
          <h4 class="text-xs font-black uppercase text-gray-600 tracking-widest">Top Canais Hoje</h4>
          <div class="space-y-4">
             <div class="flex items-center justify-between">
                <span class="text-xs text-white">WhatsApp Direct</span>
                <span class="text-xs font-mono font-bold text-gray-400">R$ 6.200</span>
             </div>
             <div class="w-full h-1 bg-gray-800 rounded-full overflow-hidden">
                <div class="w-[60%] h-full bg-emerald-500"></div>
             </div>
             
             <div class="flex items-center justify-between">
                <span class="text-xs text-white">Instagram Bio</span>
                <span class="text-xs font-mono font-bold text-gray-400">R$ 4.100</span>
             </div>
             <div class="w-full h-1 bg-gray-800 rounded-full overflow-hidden">
                <div class="w-[40%] h-full bg-blue-500"></div>
             </div>
          </div>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
