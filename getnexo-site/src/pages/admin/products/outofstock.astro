---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { PackageX, AlertCircle, RefreshCcw, Search, MoreHorizontal, Package, Send, Edit, Trash2, X } from 'lucide-react';
---

<AdminLayout title="Produtos Esgotados" activeTab="products">
  <div class="space-y-8 animate-fade-in" x-data="outOfStockManager()">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center uppercase tracking-tight">
          <PackageX className="w-8 h-8 text-rose-500 mr-3 animate-pulse" />
          Ruptura de Estoque
        </h1>
        <p class="text-sm text-gray-400 mt-1">Estes produtos estão indisponíveis e podem estar custando vendas.</p>
      </div>
      <div class="flex space-x-3">
         <button @click="exportReport()" class="bg-gray-900 border border-gray-800 text-white font-bold px-6 py-3 rounded-2xl flex items-center space-x-2 hover:bg-gray-800 transition-all">
            <Send className="w-4 h-4" />
            <span>Enviar Relatório</span>
         </button>
         <button @click="syncERP()" :disabled="syncing" class="bg-gray-900 border border-gray-800 text-white font-bold px-6 py-3 rounded-2xl flex items-center space-x-2 hover:bg-gray-800 transition-all disabled:opacity-50">
            <RefreshCcw className="w-4 h-4" :class="syncing ? 'animate-spin' : ''" />
            <span x-text="syncing ? 'Sincronizando...' : 'Atualizar ERP'"></span>
         </button>
      </div>
    </div>

    <!-- Inventory Alerts -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
       <div class="p-10 bg-rose-500/5 border border-rose-500/20 rounded-[2.5rem] flex items-center space-x-8">
          <div class="w-16 h-16 bg-rose-500/10 rounded-full flex items-center justify-center text-rose-500 shrink-0">
             <AlertCircle className="w-8 h-8" />
          </div>
          <div class="space-y-2">
             <h4 class="text-lg font-bold text-white uppercase tracking-tight">Perda de Receita Est.</h4>
             <p class="text-4xl font-black text-rose-500 font-mono" x-text="formatCurrency(lostRevenue)"></p>
             <p class="text-xs text-gray-600">Considerando a média de vendas diária destes itens.</p>
          </div>
       </div>
       
       <div class="p-10 bg-black/40 border border-gray-800 rounded-[2.5rem] flex items-center space-x-8">
          <div class="w-16 h-16 bg-gray-800 rounded-full flex items-center justify-center text-gray-400 shrink-0 font-black text-2xl" x-text="products.length">
          </div>
          <div>
             <h4 class="text-lg font-bold text-white uppercase tracking-tight">SKUs em Alerta</h4>
             <p class="text-sm text-gray-500 leading-relaxed">Produtos com menos de 5 unidades em estoque no momento.</p>
          </div>
       </div>
    </div>

    <!-- Loading -->
    <div x-show="loading" class="flex items-center justify-center py-10">
       <div class="w-10 h-10 border-4 border-rose-500 border-t-transparent rounded-full animate-spin"></div>
    </div>

    <!-- Tabela de Produtos -->
    <div x-show="!loading" class="bg-gray-900/30 border border-gray-800 rounded-3xl overflow-hidden backdrop-blur-md shadow-2xl">
      <div class="p-6 bg-black/40 border-b border-gray-800 flex items-center justify-between">
         <h3 class="text-xs font-black uppercase text-gray-500 tracking-widest">Lista de Reposição Urgente</h3>
         <div class="relative w-64">
             <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-700" />
             <input type="text" x-model="search" placeholder="Filtrar por SKU ou Nome..." class="w-full bg-black/40 border border-gray-800 rounded-xl py-1.5 pl-9 pr-4 text-[10px] text-white focus:border-rose-500 outline-none" />
         </div>
      </div>
      <table class="w-full text-left">
        <thead>
          <tr class="bg-black/10">
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Produto / SKU</th>
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Última Venda</th>
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Estoque Atual</th>
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Prioridade</th>
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/50">
          <template x-for="product in filteredProducts" :key="product.id">
            <tr class="hover:bg-rose-500/5 transition-colors group">
              <td class="px-8 py-6">
                <div class="space-y-1">
                   <h4 class="text-sm font-bold text-white uppercase tracking-tight group-hover:text-rose-400 transition-colors" x-text="product.name"></h4>
                   <p class="text-[9px] text-gray-600 font-mono" x-text="product.sku"></p>
                </div>
              </td>
              <td class="px-8 py-6 text-xs text-gray-500" x-text="product.lastSale"></td>
              <td class="px-8 py-6">
                 <span :class="product.stock === 0 ? 'bg-rose-500/20 text-rose-500' : 'bg-orange-500/20 text-orange-400'" 
                       class="text-xs font-black font-mono px-2 py-1 rounded"
                       x-text="product.stock + ' UN'">
                 </span>
              </td>
              <td class="px-8 py-6">
                 <div class="flex items-center space-x-2">
                    <div :class="product.priority === 'Crítico' ? 'bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.5)]' : 'bg-orange-500 shadow-[0_0_8px_rgba(249,115,22,0.5)]'" 
                         class="w-2 h-2 rounded-full"></div>
                    <span class="text-[10px] font-black uppercase text-gray-400" x-text="product.priority"></span>
                 </div>
              </td>
              <td class="px-8 py-6 text-right">
                <div class="flex items-center justify-end space-x-2 opacity-0 group-hover:opacity-100 transition-opacity">
                   <button @click="replenishStock(product)" class="p-2 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500 hover:text-white rounded-lg transition-colors" title="Repor Estoque">
                      <Package className="w-4 h-4" />
                   </button>
                   <button @click="editProduct(product.id)" class="p-2 bg-gray-800 text-gray-400 hover:text-white rounded-lg transition-colors" title="Editar">
                      <Edit className="w-4 h-4" />
                   </button>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      
      <div x-show="filteredProducts.length === 0" class="text-center py-10 text-gray-500">
         Nenhum produto encontrado.
      </div>
    </div>

    <!-- Replenish Modal -->
    <div x-show="replenishModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4" @keydown.escape.window="replenishModal = false">
       <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @click="replenishModal = false"></div>
       <div class="relative w-full max-w-md bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl overflow-hidden" @click.stop>
          <div class="bg-emerald-900/20 p-6 border-b border-gray-800">
             <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-emerald-400">Repor Estoque</h2>
                <button @click="replenishModal = false" class="p-2 text-gray-500 hover:text-white hover:bg-gray-800 rounded-lg transition-all">
                   <X className="w-5 h-5" />
                </button>
             </div>
          </div>
          <div class="p-6 space-y-5">
             <div class="bg-gray-800/50 p-4 rounded-lg">
                <p class="text-xs text-gray-500 uppercase mb-1">Produto</p>
                <p class="text-white font-medium" x-text="selectedProduct?.name"></p>
                <p class="text-xs text-gray-500 font-mono" x-text="selectedProduct?.sku"></p>
             </div>
             <div>
                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Quantidade a Adicionar *</label>
                <input type="number" x-model="replenishQty" min="1" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white text-center text-2xl font-bold focus:outline-none focus:border-emerald-500 transition-all" placeholder="0">
             </div>
             <div>
                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Observação (opcional)</label>
                <input type="text" x-model="replenishNote" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 transition-all" placeholder="Ex: Pedido #12345">
             </div>
          </div>
          <div class="p-6 border-t border-gray-800 flex justify-end space-x-3">
             <button @click="replenishModal = false" class="px-6 py-2.5 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-xl transition-all">Cancelar</button>
             <button @click="confirmReplenish()" :disabled="!replenishQty || replenishQty < 1" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-medium rounded-xl transition-all disabled:opacity-50">Confirmar</button>
          </div>
       </div>
    </div>
  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function outOfStockManager() {
    return {
      products: [],
      loading: true,
      search: '',
      syncing: false,
      replenishModal: false,
      selectedProduct: null,
      replenishQty: '',
      replenishNote: '',
      lostRevenue: 0,

      get filteredProducts() {
        if (!this.search) return this.products;
        return this.products.filter(p => 
          p.name.toLowerCase().includes(this.search.toLowerCase()) ||
          p.sku.toLowerCase().includes(this.search.toLowerCase())
        );
      },

      async init() {
        await this.fetchProducts();
      },

      async fetchProducts() {
        this.loading = true;
        try {
          const res = await fetch('/api/products?outofstock=true');
          if (res.ok) {
            const data = await res.json();
            this.products = data.products || [];
            this.lostRevenue = data.estimatedLoss || 0;
          } else {
            this.setMockData();
          }
        } catch(e) {
          console.error(e);
          this.setMockData();
        } finally {
          this.loading = false;
        }
      },

      setMockData() {
        this.products = [
          { id: 101, name: 'Sneaker Premium X1', sku: 'SKU-SNK-001', stock: 0, lastSale: 'há 2 dias', priority: 'Crítico' },
          { id: 102, name: 'Watch Ultra Edition', sku: 'SKU-WCH-042', stock: 0, lastSale: 'hoje, 10:30', priority: 'Crítico' },
          { id: 103, name: 'Fusion Earbuds Pro', sku: 'SKU-EAR-099', stock: 2, lastSale: 'há 5 min', priority: 'Baixo' },
          { id: 104, name: 'Gaming Keyboard RGB', sku: 'SKU-KEY-015', stock: 1, lastSale: 'há 1 hora', priority: 'Baixo' },
        ];
        this.lostRevenue = 18250;
      },

      formatCurrency(value) {
        return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value);
      },

      async syncERP() {
        this.syncing = true;
        try {
          await fetch('/api/erp/sync', { method: 'POST' });
          await this.fetchProducts();
        } catch(e) { console.error(e); }
        
        setTimeout(() => {
          this.syncing = false;
          alert('Sincronização concluída!');
        }, 2000);
      },

      replenishStock(product) {
        this.selectedProduct = product;
        this.replenishQty = '';
        this.replenishNote = '';
        this.replenishModal = true;
      },

      async confirmReplenish() {
        if (!this.replenishQty || this.replenishQty < 1) return;
        
        try {
          await fetch(`/api/products/${this.selectedProduct.id}/stock`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quantity: parseInt(this.replenishQty), note: this.replenishNote })
          });
        } catch(e) { console.error(e); }
        
        const product = this.products.find(p => p.id === this.selectedProduct.id);
        if (product) {
          product.stock += parseInt(this.replenishQty);
          if (product.stock > 5) {
            this.products = this.products.filter(p => p.id !== product.id);
          }
        }
        
        this.replenishModal = false;
        alert('Estoque atualizado com sucesso!');
      },

      editProduct(id) {
        window.location.href = `/admin/products/edit?id=${id}`;
      },

      exportReport() {
        window.location.href = '/api/products/outofstock/export';
      }
    };
  }
</script>

<style>
  [x-cloak] { display: none !important; }
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
</AdminLayout>
