---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { PackageX, AlertCircle, ShoppingCart, RefreshCcw, Search, MoreHorizontal } from 'lucide-react';

const products = [
  { id: 101, name: "Sneaker Premium X1", sku: "SKU-SNK-001", stock: 0, lastSale: "há 2 dias", status: "Crítico" },
  { id: 102, name: "Watch Ultra Edition", sku: "SKU-WCH-042", stock: 0, lastSale: "hoje, 10:30", status: "Crítico" },
  { id: 103, name: "Fusion Earbuds Pro", sku: "SKU-EAR-099", stock: 2, lastSale: "há 5 min", status: "Baixo" },
];
---

<AdminLayout title="Produtos Esgotados" activeTab="products">
  <div class="space-y-8 animate-fade-in">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center uppercase tracking-tight">
          <PackageX className="w-8 h-8 text-rose-500 mr-3 animate-pulse" />
          Ruptura de Estoque
        </h1>
        <p class="text-sm text-gray-400 mt-1">Estes produtos estão indisponíveis e podem estar custando vendas.</p>
      </div>
      <button class="bg-gray-900 border border-gray-800 text-white font-bold px-6 py-3 rounded-2xl flex items-center space-x-2 hover:bg-gray-800 transition-all">
         <RefreshCcw className="w-4 h-4 mr-2" />
         <span>Atualizar Sincronização ERP</span>
      </button>
    </div>

    <!-- Inventory Alerts -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
       <div class="p-10 bg-rose-500/5 border border-rose-500/20 rounded-[2.5rem] flex items-center space-x-8">
          <div class="w-16 h-16 bg-rose-500/10 rounded-full flex items-center justify-center text-rose-500 shrink-0">
             <AlertCircle className="w-8 h-8" />
          </div>
          <div class="space-y-2">
             <h4 class="text-lg font-bold text-white uppercase tracking-tight">Perda de Receita Est.</h4>
             <p class="text-4xl font-black text-rose-500 font-mono">R$ 18.250,00</p>
             <p class="text-xs text-gray-600">Considerando a média de vendas diária destes itens.</p>
          </div>
       </div>
       
       <div class="p-10 bg-black/40 border border-gray-800 rounded-[2.5rem] flex items-center space-x-8">
          <div class="w-16 h-16 bg-gray-800 rounded-full flex items-center justify-center text-gray-400 shrink-0 font-black">
             42
          </div>
          <div>
             <h4 class="text-lg font-bold text-white uppercase tracking-tight">SKUs em Alerta</h4>
             <p class="text-sm text-gray-500 leading-relaxed">Produtos com menos de 5 unidades em estoque no momento.</p>
          </div>
       </div>
    </div>

    <!-- Tabela de Produtos -->
    <div class="bg-gray-900/30 border border-gray-800 rounded-3xl overflow-hidden backdrop-blur-md shadow-2xl">
      <div class="p-6 bg-black/40 border-b border-gray-800 flex items-center justify-between">
         <h3 class="text-xs font-black uppercase text-gray-500 tracking-widest">Lista de Reposição Urgente</h3>
         <div class="relative w-64">
             <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-700" />
             <input type="text" placeholder="Filtrar por SKU ou Nome..." class="w-full bg-black/40 border border-gray-800 rounded-xl py-1.5 pl-9 pr-4 text-[10px] text-white focus:border-rose-500 outline-none" />
         </div>
      </div>
      <table class="w-full text-left">
        <thead>
          <tr class="bg-black/10">
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Produto / SKU</th>
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Última Venda</th>
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Estoque Atual</th>
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider">Prioridade</th>
            <th class="px-8 py-4 text-[10px] font-black uppercase text-gray-500 tracking-wider text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800/50">
          {products.map(p => (
            <tr class="hover:bg-rose-500/5 transition-colors group">
              <td class="px-8 py-6">
                <div class="space-y-1">
                   <h4 class="text-sm font-bold text-white uppercase tracking-tight group-hover:text-rose-400 transition-colors">{p.name}</h4>
                   <p class="text-[9px] text-gray-600 font-mono">{p.sku}</p>
                </div>
              </td>
              <td class="px-8 py-6 text-xs text-gray-500">{p.lastSale}</td>
              <td class="px-8 py-6">
                 <span class:list={["text-xs font-black font-mono px-2 py-1 rounded", p.stock === 0 ? 'bg-rose-500/20 text-rose-500' : 'bg-orange-500/20 text-orange-400']}>
                    {p.stock} UN
                 </span>
              </td>
              <td class="px-8 py-6">
                 <div class="flex items-center space-x-2">
                    <div class:list={["w-2 h-2 rounded-full", p.status === 'Crítico' ? 'bg-rose-500 shadow-[0_0_8px_rgba(244,63,94,0.5)]' : 'bg-orange-500 shadow-[0_0_8px_rgba(249,115,22,0.5)]']}></div>
                    <span class="text-[10px] font-black uppercase text-gray-400">{p.status}</span>
                 </div>
              </td>
              <td class="px-8 py-6 text-right">
                <button class="p-2 text-gray-700 hover:text-white transition-colors cursor-pointer">
                  <MoreHorizontal className="w-4 h-4" />
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
