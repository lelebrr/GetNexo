---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Package, Search, Save, Edit3, Trash2, Tag, Truck } from 'lucide-react';

const title = "Editar Preço & Estoque";
---

<AdminLayout title={title} activeTab="produtos">
  <div class="max-w-6xl mx-auto space-y-8 animate-fade-in" x-data="productEditor()">
    
    <!-- Header with Search -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter italic">Gestão de Inventário</h1>
        <p class="text-sm text-gray-400 font-medium">Ajuste rápido de preços e níveis de estoque por loja.</p>
      </div>
      <div class="relative w-full md:w-96">
        <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" />
        <input type="text" placeholder="Buscar por SKU ou Nome..." x-model="searchQuery" class="w-full bg-gray-900 border border-gray-800 rounded-2xl py-3 pl-12 pr-4 text-xs text-white outline-none focus:border-orange-500 transition-all" />
      </div>
    </header>

    <!-- Product List Table -->
    <div class="bg-gray-950 border border-gray-800 rounded-[2.5rem] overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead class="bg-gray-900/50 text-gray-500 text-[10px] font-black uppercase tracking-widest border-b border-gray-800">
          <tr>
            <th class="px-8 py-5">Produto</th>
            <th class="px-4 py-5">SKU</th>
            <th class="px-4 py-5">Preço (R$)</th>
            <th class="px-4 py-5">Estoque</th>
            <th class="px-4 py-5 text-right pr-8">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-900">
          <template x-for="product in filteredProducts()" :key="product.id">
            <tr class="hover:bg-gray-900/30 transition-all group">
              <td class="px-8 py-6">
                <div class="flex items-center space-x-4">
                  <div class="w-12 h-12 bg-gray-900 rounded-xl overflow-hidden border border-gray-800 flex items-center justify-center">
                    <template x-if="product.image_url">
                        <img :src="product.image_url" class="w-full h-full object-cover">
                    </template>
                    <template x-if="!product.image_url">
                        <Package className="w-6 h-6 text-gray-700" />
                    </template>
                  </div>
                  <span class="text-sm font-bold text-gray-200" x-text="product.name">--</span>
                </div>
              </td>
              <td class="px-4 py-6 text-xs text-gray-500 font-mono" x-text="product.sku || 'N/A'">--</td>
              <td class="px-4 py-6">
                <div class="relative group/price w-32">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-600 text-[10px] font-bold">R$</span>
                  <input type="number" step="0.01" x-model.number="product.price" class="w-full bg-black/50 border border-gray-800 rounded-lg py-1.5 pl-8 pr-2 text-sm text-emerald-400 font-black outline-none focus:border-emerald-500 transition-all" />
                </div>
              </td>
              <td class="px-4 py-6">
                <div class="w-24">
                  <input type="number" x-model.number="product.stock" class="w-full bg-black/50 border border-gray-800 rounded-lg py-1.5 px-3 text-sm text-amber-500 font-black outline-none focus:border-amber-500 transition-all" />
                </div>
              </td>
              <td class="px-4 py-6 text-right pr-8">
                <button @click="saveProduct(product)" class="p-2.5 bg-gray-900 hover:bg-emerald-500/20 text-gray-500 hover:text-emerald-400 border border-gray-800 hover:border-emerald-500/50 rounded-xl transition-all" title="Salvar Alterações">
                  <Save className="w-4 h-4" />
                </button>
              </td>
            </tr>
          </template>
        </tbody>
      </table>
      
      <!-- Empty State -->
      <template x-if="filteredProducts().length === 0">
        <div class="p-20 text-center space-y-4">
           <Package className="w-12 h-12 text-gray-800 mx-auto" />
           <p class="text-xs text-gray-600 font-black uppercase tracking-widest">Nenhum produto encontrado</p>
        </div>
      </template>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  function productEditor() {
    return {
      products: [],
      searchQuery: '',
      async fetchProducts() {
        try {
          const res = await fetch('/api/products');
          this.products = await res.json();
        } catch (e) {
          console.error('Erro ao buscar produtos:', e);
        }
      },
      filteredProducts() {
        if (!this.searchQuery) return this.products;
        const q = this.searchQuery.toLowerCase();
        return this.products.filter(p => 
          p.name.toLowerCase().includes(q) || (p.sku && p.sku.toLowerCase().includes(q))
        );
      },
      async saveProduct(product) {
        try {
          const res = await fetch(`/api/products/${product.id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              price: product.price,
              stock: product.stock
            })
          });
          if (res.ok) {
            alert('Produto atualizado com sucesso!');
          }
        } catch (e) {
          alert('Erro ao salvar alterações.');
        }
      },
      init() {
        this.fetchProducts();
      }
    }
  }
</script>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  
  /* Remove arrows from input number */
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>
