---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Sparkles, Wand2, Image as ImageIcon, Download, RefreshCw, Send, Zap } from 'lucide-react';

const recentGens = [
  { id: 1, prompt: "Sneaker in a cyberpunk neon city, cinematic lighting", url: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=300&q=80" },
  { id: 2, prompt: "Premium watch on a marble table with soft shadows", url: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=300&q=80" },
];
---

<AdminLayout title="Gerador de Fotos IA" activeTab="products">
  <div class="max-w-6xl mx-auto space-y-12 py-4 animate-fade-in">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-3xl flex items-center justify-center shadow-xl shadow-indigo-500/20">
          <Sparkles className="w-8 h-8 text-white animate-pulse" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Nexus Studio IA</h1>
          <p class="text-sm text-gray-500">Transforme fotos simples de produtos em campanhas de alta qualidade.</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
      <!-- Editor/Prompt Section -->
      <div class="lg:col-span-3 space-y-8">
        <div class="bg-gray-900/50 border border-gray-800 rounded-[2.5rem] p-8 space-y-6">
           <div class="space-y-2">
              <label class="text-[10px] font-black uppercase text-gray-500 tracking-widest ml-1">Descrição do Cenário (Prompt)</label>
              <textarea 
                placeholder="Ex: Tênis esportivo vindo de uma explosão de cores, ambiente futurista, 8k, ultra detalhado..."
                class="w-full bg-black/40 border border-gray-800 rounded-2xl p-6 text-sm text-white focus:border-indigo-500 outline-none min-h-[150px] resize-none transition-all placeholder:text-gray-700"
              ></textarea>
           </div>
           
           <div class="grid grid-cols-2 gap-4">
              <button class="py-4 bg-gray-800/50 border border-gray-800 rounded-2xl flex items-center justify-center space-x-3 text-xs font-bold text-gray-400 hover:text-white hover:border-gray-600 transition-all">
                 <ImageIcon className="w-4 h-4" />
                 <span>Subir Foto Base</span>
              </button>
              <button class="py-4 bg-gray-800/50 border border-gray-800 rounded-2xl flex items-center justify-center space-x-3 text-xs font-bold text-gray-400 hover:text-white hover:border-gray-600 transition-all">
                 <Zap className="w-4 h-4" />
                 <span>Estilos Rápidos</span>
              </button>
           </div>

           <button class="w-full py-5 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-black rounded-2xl flex items-center justify-center space-x-3 shadow-xl shadow-indigo-500/10 hover:shadow-indigo-500/30 hover:scale-[1.01] active:scale-95 transition-all text-sm uppercase tracking-widest">
              <Wand2 className="w-5 h-5" />
              <span>Gerar Fotografia</span>
           </button>
        </div>
      </div>

      <!-- Preview/Recent Section -->
      <div class="lg:col-span-2 space-y-8">
         <h4 class="text-xs font-black uppercase text-gray-600 tracking-[0.2em] ml-2">Gerações Recentes</h4>
         <div class="grid grid-cols-1 gap-6">
            {recentGens.map(gen => (
              <div class="bg-gray-900/30 border border-gray-800 rounded-3xl overflow-hidden group">
                 <div class="aspect-video relative overflow-hidden">
                    <img src={gen.url} class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity duration-500" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent p-6 flex flex-col justify-end">
                       <p class="text-[10px] text-gray-300 font-medium line-clamp-2 italic">{`"${gen.prompt}"`}</p>
                    </div>
                 </div>
                 <div class="p-4 flex items-center justify-between bg-black/40">
                    <button class="text-[9px] font-black uppercase text-indigo-400 hover:text-white transition-colors flex items-center">
                       Refazer Variação <RefreshCw className="w-3 h-3 ml-2" />
                    </button>
                    <button class="text-gray-600 hover:text-white"><Download className="w-4 h-4" /></button>
                 </div>
              </div>
            ))}
         </div>
         
         <div class="p-6 bg-indigo-500/5 border border-indigo-500/10 rounded-3xl text-center">
            <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Créditos Disponíveis</p>
            <p class="text-2xl font-black text-white mt-1">128</p>
         </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

