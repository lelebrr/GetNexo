---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Image as ImageIcon, Upload, Search, MoreVertical, Filter, Grid, List } from 'lucide-react';

const assets = [
  { id: 1, name: "Banner Primavera.jpg", type: "Image", size: "1.2 MB", date: "Há 2h", preview: "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=150&q=80" },
  { id: 2, name: "Icon Pack.svg", type: "Vector", size: "45 KB", date: "Há 5h", preview: "" },
  { id: 3, name: "Product Video.mp4", type: "Video", size: "12.5 MB", date: "Ontem", preview: "" },
  { id: 4, name: "Sneaker Blue Front.png", type: "Image", size: "850 KB", date: "24 Jan", preview: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=150&q=80" },
];
---

<AdminLayout title="Biblioteca de Mídia" activeTab="products">
  <div class="space-y-8 animate-fade-in">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white uppercase tracking-tighter">Gestão de Assets</h1>
        <p class="text-sm text-gray-500 font-medium">Centralize todas as imagens, vídeos e modelos do seu catálogo.</p>
      </div>
      <div class="flex items-center space-x-3">
         <button class="p-3 bg-gray-900 border border-gray-800 rounded-xl text-gray-400 hover:text-white transition-all"><Grid className="w-5 h-4" /></button>
         <button class="p-3 bg-gray-900 border border-gray-800 rounded-xl text-gray-400 hover:text-white transition-all"><List className="w-5 h-4" /></button>
         <button class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-6 py-3 rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-indigo-500/10">
            <Upload className="w-5 h-5" />
            <span>Upload de Arquivos</span>
         </button>
      </div>
    </div>

    <!-- Barra de busca e filtros -->
    <div class="flex items-center space-x-4 bg-gray-900/40 p-3 border border-gray-800 rounded-2xl">
       <div class="relative flex-1">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" />
          <input type="text" placeholder="Pesquisar na biblioteca..." class="w-full bg-black/40 border border-gray-800 rounded-xl py-2 pl-10 pr-4 text-sm text-white focus:border-indigo-500 outline-none" />
       </div>
       <button class="px-4 py-2 text-xs font-bold text-gray-500 hover:text-white flex items-center">
          <Filter className="w-3.5 h-3.5 mr-2" /> Categorias
       </button>
    </div>

    <!-- Grid de Assets -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
       {assets.map(asset => (
         <div class="bg-gray-900/30 border border-gray-800 rounded-3xl overflow-hidden group hover:border-indigo-500/40 transition-all cursor-pointer">
            <div class="aspect-square bg-black flex items-center justify-center relative">
               {asset.preview ? (
                 <img src={asset.preview} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 opacity-80 group-hover:opacity-100" />
               ) : (
                 <ImageIcon className="w-10 h-10 text-gray-800 group-hover:text-indigo-500 transition-colors" />
               )}
               <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-4">
                  <div class="flex items-center justify-between">
                     <span class="text-[8px] font-black uppercase text-white bg-indigo-600 px-1.5 py-0.5 rounded">{asset.type}</span>
                     <MoreVertical className="w-4 h-4 text-white" />
                  </div>
               </div>
            </div>
            <div class="p-4 bg-black/20">
               <h4 class="text-[10px] font-bold text-gray-400 truncate uppercase mt-1">{asset.name}</h4>
               <p class="text-[8px] text-gray-600 mt-1">{asset.size} • {asset.date}</p>
            </div>
         </div>
       ))}
       
       <!-- Empty placeholder for empty space / Adding new -->
       <div class="aspect-square border-2 border-dashed border-gray-800 rounded-3xl flex flex-col items-center justify-center space-y-3 hover:border-gray-700 transition-all text-gray-700 hover:text-gray-500 group">
          <Upload className="w-8 h-8 group-hover:animate-bounce" />
          <span class="text-[10px] font-black uppercase tracking-widest">Soltar Arquivo</span>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
