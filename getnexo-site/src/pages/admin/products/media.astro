---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Image as ImageIcon, Upload, Search, MoreVertical, Filter, Grid, List, Trash2, X, Download, Eye, Copy, Video, FileText } from 'lucide-react';
---

<AdminLayout title="Biblioteca de Mídia" activeTab="products">
  <div class="space-y-8 animate-fade-in" x-data="mediaLibrary()">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white uppercase tracking-tighter">Gestão de Assets</h1>
        <p class="text-sm text-gray-500 font-medium">Centralize todas as imagens, vídeos e modelos do seu catálogo.</p>
      </div>
      <div class="flex items-center space-x-3">
         <button @click="viewMode = 'grid'" :class="viewMode === 'grid' ? 'text-white border-indigo-500' : 'text-gray-400 border-gray-800'" class="p-3 bg-gray-900 border rounded-xl hover:text-white transition-all">
            <Grid className="w-5 h-4" />
         </button>
         <button @click="viewMode = 'list'" :class="viewMode === 'list' ? 'text-white border-indigo-500' : 'text-gray-400 border-gray-800'" class="p-3 bg-gray-900 border rounded-xl hover:text-white transition-all">
            <List className="w-5 h-4" />
         </button>
         <button @click="openUploadModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-6 py-3 rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-indigo-500/10">
            <Upload className="w-5 h-5" />
            <span>Upload de Arquivos</span>
         </button>
      </div>
    </div>

    <!-- Barra de busca e filtros -->
    <div class="flex items-center space-x-4 bg-gray-900/40 p-3 border border-gray-800 rounded-2xl">
       <div class="relative flex-1">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" />
          <input type="text" x-model="search" placeholder="Pesquisar na biblioteca..." class="w-full bg-black/40 border border-gray-800 rounded-xl py-2 pl-10 pr-4 text-sm text-white focus:border-indigo-500 outline-none" />
       </div>
       <select x-model="filterType" class="bg-gray-800 border border-gray-700 text-gray-300 rounded-xl px-4 py-2 text-xs focus:border-indigo-500 outline-none">
          <option value="">Todos os Tipos</option>
          <option value="Image">Imagens</option>
          <option value="Video">Vídeos</option>
          <option value="Vector">Vetores</option>
          <option value="Document">Documentos</option>
       </select>
    </div>

    <!-- Selected Actions Bar -->
    <div x-show="selectedAssets.length > 0" class="flex items-center justify-between bg-indigo-600/10 border border-indigo-500/20 p-4 rounded-xl">
       <span class="text-sm text-indigo-400" x-text="selectedAssets.length + ' arquivo(s) selecionado(s)'"></span>
       <div class="flex space-x-3">
          <button @click="downloadSelected()" class="px-4 py-2 bg-gray-800 text-white text-xs font-bold rounded-lg hover:bg-gray-700 flex items-center space-x-2">
             <Download className="w-4 h-4" />
             <span>Baixar</span>
          </button>
          <button @click="deleteSelected()" class="px-4 py-2 bg-rose-600/20 text-rose-400 text-xs font-bold rounded-lg hover:bg-rose-600 hover:text-white flex items-center space-x-2">
             <Trash2 className="w-4 h-4" />
             <span>Excluir</span>
          </button>
       </div>
    </div>

    <!-- Loading -->
    <div x-show="loading" class="flex items-center justify-center py-10">
       <div class="w-10 h-10 border-4 border-indigo-500 border-t-transparent rounded-full animate-spin"></div>
    </div>

    <!-- Grid de Assets -->
    <div x-show="!loading && viewMode === 'grid'" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
       <template x-for="asset in filteredAssets" :key="asset.id">
         <div @click="selectAsset(asset.id, $event)" 
              :class="selectedAssets.includes(asset.id) ? 'border-indigo-500 ring-2 ring-indigo-500/20' : 'border-gray-800 hover:border-indigo-500/40'"
              class="bg-gray-900/30 border rounded-3xl overflow-hidden group transition-all cursor-pointer">
            <div class="aspect-square bg-black flex items-center justify-center relative">
               <template x-if="asset.preview">
                 <img :src="asset.preview" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 opacity-80 group-hover:opacity-100" />
               </template>
               <template x-if="!asset.preview && asset.type === 'Video'">
                 <Video className="w-10 h-10 text-gray-800 group-hover:text-indigo-500 transition-colors" />
               </template>
               <template x-if="!asset.preview && asset.type === 'Vector'">
                 <FileText className="w-10 h-10 text-gray-800 group-hover:text-indigo-500 transition-colors" />
               </template>
               <template x-if="!asset.preview && asset.type === 'Image'">
                 <ImageIcon className="w-10 h-10 text-gray-800 group-hover:text-indigo-500 transition-colors" />
               </template>
               <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-4">
                  <div class="flex items-center justify-between">
                     <span class="text-[8px] font-black uppercase text-white bg-indigo-600 px-1.5 py-0.5 rounded" x-text="asset.type"></span>
                     <div class="flex space-x-1">
                        <button @click.stop="previewAsset(asset)" class="p-1 bg-white/10 rounded text-white hover:bg-white/20"><Eye className="w-3 h-3" /></button>
                        <button @click.stop="copyUrl(asset)" class="p-1 bg-white/10 rounded text-white hover:bg-white/20"><Copy className="w-3 h-3" /></button>
                        <button @click.stop="deleteAsset(asset.id)" class="p-1 bg-rose-500/20 rounded text-rose-400 hover:bg-rose-500 hover:text-white"><Trash2 className="w-3 h-3" /></button>
                     </div>
                  </div>
               </div>
            </div>
            <div class="p-4 bg-black/20">
               <h4 class="text-[10px] font-bold text-gray-400 truncate uppercase mt-1" x-text="asset.name"></h4>
               <p class="text-[8px] text-gray-600 mt-1" x-text="asset.size + ' • ' + asset.date"></p>
            </div>
         </div>
       </template>
       
       <!-- Empty placeholder for drag and drop -->
       <div @click="openUploadModal()" class="aspect-square border-2 border-dashed border-gray-800 rounded-3xl flex flex-col items-center justify-center space-y-3 hover:border-gray-700 transition-all text-gray-700 hover:text-gray-500 group cursor-pointer">
          <Upload className="w-8 h-8 group-hover:animate-bounce" />
          <span class="text-[10px] font-black uppercase tracking-widest">Soltar Arquivo</span>
       </div>
    </div>

    <!-- List View -->
    <div x-show="!loading && viewMode === 'list'" class="bg-gray-900/40 border border-gray-800 rounded-2xl overflow-hidden">
       <table class="w-full">
          <thead>
             <tr class="border-b border-gray-800">
                <th class="p-4 text-left text-xs font-bold text-gray-500 uppercase">Nome</th>
                <th class="p-4 text-left text-xs font-bold text-gray-500 uppercase">Tipo</th>
                <th class="p-4 text-left text-xs font-bold text-gray-500 uppercase">Tamanho</th>
                <th class="p-4 text-left text-xs font-bold text-gray-500 uppercase">Data</th>
                <th class="p-4 text-right text-xs font-bold text-gray-500 uppercase">Ações</th>
             </tr>
          </thead>
          <tbody class="divide-y divide-gray-800/50">
             <template x-for="asset in filteredAssets" :key="asset.id">
                <tr class="hover:bg-gray-800/30 transition-colors">
                   <td class="p-4">
                      <div class="flex items-center space-x-3">
                         <div class="w-10 h-10 bg-gray-800 rounded-lg flex items-center justify-center overflow-hidden">
                            <template x-if="asset.preview"><img :src="asset.preview" class="w-full h-full object-cover"></template>
                            <template x-if="!asset.preview"><ImageIcon className="w-5 h-5 text-gray-600" /></template>
                         </div>
                         <span class="text-sm text-white font-medium" x-text="asset.name"></span>
                      </div>
                   </td>
                   <td class="p-4 text-xs text-gray-500" x-text="asset.type"></td>
                   <td class="p-4 text-xs text-gray-500" x-text="asset.size"></td>
                   <td class="p-4 text-xs text-gray-500" x-text="asset.date"></td>
                   <td class="p-4 text-right">
                      <div class="flex items-center justify-end space-x-2">
                         <button @click="copyUrl(asset)" class="p-2 text-gray-500 hover:text-white"><Copy className="w-4 h-4" /></button>
                         <button @click="deleteAsset(asset.id)" class="p-2 text-gray-500 hover:text-rose-400"><Trash2 className="w-4 h-4" /></button>
                      </div>
                   </td>
                </tr>
             </template>
          </tbody>
       </table>
    </div>

    <!-- Empty State -->
    <div x-show="!loading && filteredAssets.length === 0" class="text-center py-16">
       <ImageIcon className="w-16 h-16 text-gray-600 mx-auto mb-4" />
       <h3 class="text-xl font-bold text-white mb-2">Nenhum arquivo encontrado</h3>
       <p class="text-gray-500 mb-6">Faça upload de arquivos para começar.</p>
    </div>

    <!-- Upload Modal -->
    <div x-show="uploadModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4" @keydown.escape.window="uploadModal = false">
       <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @click="uploadModal = false"></div>
       <div class="relative w-full max-w-lg bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl overflow-hidden" @click.stop>
          <div class="bg-gradient-to-r from-indigo-600/20 to-purple-600/20 p-6 border-b border-gray-800">
             <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-white">Upload de Arquivos</h2>
                <button @click="uploadModal = false" class="p-2 text-gray-500 hover:text-white hover:bg-gray-800 rounded-lg transition-all">
                   <X className="w-5 h-5" />
                </button>
             </div>
          </div>
          <div class="p-6">
             <div class="border-2 border-dashed border-gray-700 rounded-xl p-10 text-center hover:border-indigo-500 transition-colors">
                <Upload className="w-12 h-12 text-gray-600 mx-auto mb-4" />
                <p class="text-white font-medium mb-2">Arraste arquivos aqui</p>
                <p class="text-gray-500 text-sm mb-4">ou</p>
                <label class="px-6 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg cursor-pointer font-medium">
                   Selecionar Arquivos
                   <input type="file" multiple class="hidden" @change="handleFileUpload($event)">
                </label>
             </div>
             <p class="text-xs text-gray-500 mt-4 text-center">Formatos aceitos: JPG, PNG, SVG, MP4, WEBM (máx. 50MB)</p>
          </div>
       </div>
    </div>

    <!-- Preview Modal -->
    <div x-show="previewModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4" @keydown.escape.window="previewModal = false">
       <div class="absolute inset-0 bg-black/90" @click="previewModal = false"></div>
       <div class="relative max-w-4xl" @click.stop>
          <button @click="previewModal = false" class="absolute -top-10 right-0 text-white">
             <X className="w-8 h-8" />
          </button>
          <template x-if="previewAssetData?.preview">
             <img :src="previewAssetData.preview" class="max-h-[80vh] rounded-xl">
          </template>
       </div>
    </div>
  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function mediaLibrary() {
    return {
      assets: [],
      loading: true,
      search: '',
      filterType: '',
      viewMode: 'grid',
      selectedAssets: [],
      uploadModal: false,
      previewModal: false,
      previewAssetData: null,

      get filteredAssets() {
        return this.assets.filter(a => {
          const matchSearch = !this.search || a.name.toLowerCase().includes(this.search.toLowerCase());
          const matchType = !this.filterType || a.type === this.filterType;
          return matchSearch && matchType;
        });
      },

      async init() {
        await this.fetchAssets();
      },

      async fetchAssets() {
        this.loading = true;
        try {
          const res = await fetch('/api/media');
          if (res.ok) {
            const data = await res.json();
            this.assets = data.assets || [];
          } else {
            this.assets = this.getMockAssets();
          }
        } catch(e) {
          console.error(e);
          this.assets = this.getMockAssets();
        } finally {
          this.loading = false;
        }
      },

      getMockAssets() {
        return [
          { id: 1, name: 'Banner Primavera.jpg', type: 'Image', size: '1.2 MB', date: 'Há 2h', preview: 'https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=300&q=80', url: 'https://example.com/banner.jpg' },
          { id: 2, name: 'Icon Pack.svg', type: 'Vector', size: '45 KB', date: 'Há 5h', preview: '', url: 'https://example.com/icons.svg' },
          { id: 3, name: 'Product Video.mp4', type: 'Video', size: '12.5 MB', date: 'Ontem', preview: '', url: 'https://example.com/video.mp4' },
          { id: 4, name: 'Sneaker Blue Front.png', type: 'Image', size: '850 KB', date: '24 Jan', preview: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=300&q=80', url: 'https://example.com/sneaker.png' },
          { id: 5, name: 'Logo Dark.png', type: 'Image', size: '120 KB', date: '20 Jan', preview: '', url: 'https://example.com/logo.png' },
        ];
      },

      selectAsset(id, event) {
        if (event.ctrlKey || event.metaKey) {
          if (this.selectedAssets.includes(id)) {
            this.selectedAssets = this.selectedAssets.filter(a => a !== id);
          } else {
            this.selectedAssets.push(id);
          }
        } else {
          this.selectedAssets = this.selectedAssets.includes(id) ? [] : [id];
        }
      },

      openUploadModal() {
        this.uploadModal = true;
      },

      async handleFileUpload(event) {
        const files = event.target.files;
        for (const file of files) {
          this.assets.unshift({
            id: Date.now() + Math.random(),
            name: file.name,
            type: file.type.startsWith('video/') ? 'Video' : 'Image',
            size: (file.size / 1024 / 1024).toFixed(2) + ' MB',
            date: 'Agora',
            preview: file.type.startsWith('image/') ? URL.createObjectURL(file) : '',
            url: '#'
          });
        }
        this.uploadModal = false;
      },

      previewAsset(asset) {
        this.previewAssetData = asset;
        this.previewModal = true;
      },

      async copyUrl(asset) {
        await navigator.clipboard.writeText(asset.url || asset.preview);
        alert('URL copiada!');
      },

      async deleteAsset(id) {
        if (!confirm('Excluir este arquivo?')) return;
        
        try {
          await fetch(`/api/media/${id}`, { method: 'DELETE' });
        } catch(e) { console.error(e); }
        
        this.assets = this.assets.filter(a => a.id !== id);
        this.selectedAssets = this.selectedAssets.filter(a => a !== id);
      },

      async deleteSelected() {
        if (!confirm(`Excluir ${this.selectedAssets.length} arquivo(s)?`)) return;
        
        for (const id of this.selectedAssets) {
          await this.deleteAsset(id);
        }
        this.selectedAssets = [];
      },

      downloadSelected() {
        alert('Iniciando download de ' + this.selectedAssets.length + ' arquivo(s)...');
      }
    };
  }
</script>

<style>
  [x-cloak] { display: none !important; }
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
</AdminLayout>
