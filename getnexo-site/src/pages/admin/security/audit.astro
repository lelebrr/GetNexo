---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Shield, Eye, ShieldAlert, History, User, Globe, MoreHorizontal, Search, Filter } from 'lucide-react';

const auditLogs = [
  { id: 1, action: "Alteração de SKU", user: "Admin (Lele)", resource: "Produto #1024", ip: "192.168.1.1", date: "Há 5 min", severity: "Low" },
  { id: 2, action: "Login efetuado", user: "Manager (Ana)", resource: "Sessão Dashboard", ip: "201.12.45.88", date: "Há 12 min", severity: "Info" },
  { id: 3, action: "Exclusão de Cupom", user: "Admin (Lele)", resource: "CUPOM_NATAL_2023", ip: "192.168.1.1", date: "Há 2h", severity: "High" },
  { id: 4, action: "Falha de Login", user: "Desconhecido", resource: "Página Login", ip: "45.18.99.102", date: "Há 4h", severity: "Critical" },
];
---

<AdminLayout title="Trilha de Auditoria" activeTab="security">
  <div class="space-y-8 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter flex items-center">
          <History className="w-8 h-8 text-indigo-400 mr-4" />
          Audit Trail
        </h1>
        <p class="text-sm text-gray-500 font-medium mt-1">Registro cronológico e imutável de todas as ações administrativas no sistema.</p>
      </div>
      <button class="bg-gray-800 border border-gray-700 text-gray-400 font-black px-6 py-3 rounded-2xl flex items-center space-x-3 hover:text-white transition-all text-[10px] uppercase tracking-widest">
        <span>Exportar Log Completo</span>
      </button>
    </div>

    <!-- Barra de busca e filtros -->
    <div class="flex flex-col md:flex-row gap-4 bg-gray-900/40 p-4 border border-gray-800 rounded-2xl">
      <div class="relative flex-1">
        <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-700" />
        <input type="text" placeholder="Filtrar por usuário, recurso ou ação..." class="w-full bg-black/40 border border-gray-800 rounded-xl py-3 pl-12 pr-4 text-sm text-white focus:border-indigo-500 outline-none transition-all" />
      </div>
      <div class="flex space-x-2">
         <button class="px-6 py-3 bg-gray-800 border border-gray-700 rounded-xl text-xs font-black text-gray-500 hover:text-white uppercase tracking-widest">
            <Filter className="w-4 h-4 mr-2 inline" /> Gravidade
         </button>
      </div>
    </div>

    <!-- Tabela de Auditoria -->
    <div class="bg-gray-900/20 border border-gray-800 rounded-3xl overflow-hidden backdrop-blur-md">
       <table class="w-full text-left">
          <thead>
             <tr class="bg-black/40">
                <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-600 tracking-widest">Ação / Evento</th>
                <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-600 tracking-widest">Autor</th>
                <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-600 tracking-widest">Impacto</th>
                <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-600 tracking-widest">IP / Origem</th>
                <th class="px-8 py-5 text-[10px] font-black uppercase text-gray-600 tracking-widest text-right">Data</th>
             </tr>
          </thead>
          <tbody class="divide-y divide-gray-800/50">
             {auditLogs.map(log => (
               <tr class="hover:bg-white/[0.02] transition-colors group">
                  <td class="px-8 py-6">
                     <div class="flex items-center space-x-4">
                        <div class:list={["w-2 h-2 rounded-full", log.severity === 'Critical' ? 'bg-rose-500 animate-pulse' : (log.severity === 'High' ? 'bg-orange-500' : 'bg-emerald-500')]}></div>
                        <div>
                           <p class="text-sm font-bold text-white uppercase tracking-tight">{log.action}</p>
                           <p class="text-[9px] text-gray-600 font-mono">{log.resource}</p>
                        </div>
                     </div>
                  </td>
                  <td class="px-8 py-6">
                     <div class="flex items-center space-x-2">
                        <User className="w-3 h-3 text-gray-700" />
                        <span class="text-xs text-gray-400 font-bold">{log.user}</span>
                     </div>
                  </td>
                  <td class="px-8 py-6">
                     <span class:list={["text-[8px] font-black uppercase px-2 py-1 rounded", log.severity === 'Critical' ? 'bg-rose-500/10 text-rose-500' : (log.severity === 'High' ? 'bg-orange-500/10 text-orange-500' : 'bg-gray-800 text-gray-500')]}>
                        {log.severity}
                     </span>
                  </td>
                  <td class="px-8 py-6">
                     <div class="flex items-center space-x-2">
                        <Globe className="w-3 h-3 text-gray-800" />
                        <span class="text-[9px] text-gray-600 font-mono tracking-tighter">{log.ip}</span>
                     </div>
                  </td>
                  <td class="px-8 py-6 text-right">
                     <span class="text-[10px] font-black text-gray-700 uppercase">{log.date}</span>
                  </td>
               </tr>
             ))}
          </tbody>
       </table>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
