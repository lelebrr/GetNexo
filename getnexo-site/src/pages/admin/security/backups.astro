---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Database, Download, RefreshCcw, HardDrive, ShieldCheck, Clock, MoreHorizontal } from 'lucide-react';

const backups = [
  { id: 1, name: "Nexus_Full_Sync_20240125.tar.gz", size: "1.2 GB", date: "Hoje, 04:00 (Auto)", type: "Completo", status: "Integridade OK" },
  { id: 2, name: "Incremental_Media_V4.zip", size: "450 MB", date: "Ontem, 04:00 (Auto)", type: "Incremental", status: "Integridade OK" },
  { id: 3, name: "Database_Structure_Only.sql", size: "85 KB", date: "23 Jan, 14:20 (Manual)", type: "Schema", status: "Expurgado" },
];
---

<AdminLayout title="Backups do Sistema" activeTab="security">
  <div class="space-y-10 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-16 h-16 bg-indigo-500/10 rounded-3xl flex items-center justify-center border border-indigo-500/20 shadow-2xl shadow-indigo-500/10">
          <Database className="w-8 h-8 text-indigo-400" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Retenção de Dados</h1>
          <p class="text-sm text-gray-500 font-medium">Recuperação de desastres e gestão de pontos de restauração.</p>
        </div>
      </div>
      <button class="bg-indigo-600 hover:bg-indigo-500 text-white font-black px-6 py-3 rounded-2xl flex items-center space-x-3 transition-all shadow-xl shadow-indigo-500/10 uppercase text-[10px] tracking-widest">
         <RefreshCcw className="w-4 h-4" />
         <span>Criar Backup Agora</span>
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
       <!-- Backup List -->
       <div class="lg:col-span-2 space-y-6">
          <h3 class="text-xs font-black text-gray-600 uppercase tracking-widest ml-1">Arquivos Disponíveis</h3>
          <div class="space-y-4">
             {backups.map(b => (
               <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] hover:border-white/10 transition-all group flex items-center justify-between">
                  <div class="flex items-center space-x-6">
                     <div class="w-12 h-12 bg-black/60 rounded-2xl flex items-center justify-center text-gray-600 group-hover:text-indigo-400 transition-colors">
                        <HardDrive className="w-6 h-6" />
                     </div>
                     <div>
                        <h4 class="text-sm font-bold text-white uppercase tracking-tight truncate w-48">{b.name}</h4>
                        <p class="text-[9px] text-gray-500 font-black uppercase mt-1">{b.type} • {b.size} • {b.date}</p>
                     </div>
                  </div>
                  <div class="flex items-center space-x-4">
                     <span class:list={["text-[8px] font-black uppercase px-2 py-1 rounded", b.status === 'Integridade OK' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-gray-800 text-gray-600']}>{b.status}</span>
                     <button class="p-3 bg-gray-800 hover:bg-white hover:text-black rounded-xl text-gray-600 transition-all"><Download className="w-4 h-4" /></button>
                  </div>
               </div>
             ))}
          </div>
       </div>

       <!-- Retention Settings -->
       <div class="space-y-6">
          <div class="p-8 bg-indigo-900/20 border border-indigo-500/20 rounded-[2.5rem] space-y-6">
             <ShieldCheck className="w-6 h-6 text-indigo-400" />
             <div>
                <h4 class="text-sm font-bold text-white uppercase tracking-tight">Política de Retenção</h4>
                <p class="text-[10px] text-gray-500 leading-relaxed mt-2 uppercase font-black">Ciclo: 30 dias</p>
             </div>
             <p class="text-[10px] text-gray-400 leading-relaxed italic">"Backups automáticos ocorrem diariamente às 04:00 AM. Arquivos com mais de 30 dias são expurgados para economia de storage."</p>
             <button class="w-full py-4 border border-indigo-500/30 text-indigo-400 font-black text-[10px] uppercase tracking-widest rounded-xl hover:bg-indigo-500 hover:text-white transition-all">Alterar Política</button>
          </div>

          <div class="p-6 bg-black/40 border border-gray-800 rounded-2xl flex items-center space-x-4">
             <Clock className="w-5 h-5 text-gray-700" />
             <p class="text-[9px] text-gray-600 font-bold uppercase tracking-tight leading-tight">Próximo backup agendado em: **6 horas e 12 minutos**.</p>
          </div>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
