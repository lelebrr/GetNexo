---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Logs de Acesso" activeTab="seguranca">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-rose-500 to-red-500 rounded-2xl flex items-center justify-center shadow-lg shadow-rose-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Logs de Acesso
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Visualize logs de acesso e atividades do sistema.
    </p>
  </div>
</AdminLayout>
