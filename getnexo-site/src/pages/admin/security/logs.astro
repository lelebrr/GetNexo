---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ShieldCheck, ShieldAlert, Terminal, Lock, Unlock, AlertTriangle, MoreVertical } from 'lucide-react';
---

<AdminLayout title="Logs de Segurança" activeTab="seguranca">
  <div class="space-y-8 animate-fade-in py-4" x-data="securityLogs()">
     <div class="flex items-center justify-between">
       <div>
         <h1 class="text-3xl font-black text-white uppercase tracking-tighter flex items-center">
           <Terminal className="w-8 h-8 text-rose-500 mr-4" />
           Security Sentinel Logs
         </h1>
         <p class="text-sm text-gray-400 mt-1">Monitoramento em tempo real de tentativas de intrusão e integridade do sistema.</p>
       </div>
       <div class="flex space-x-3">
          <button @click="exportLogs()" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-white rounded-xl text-sm font-medium transition-all flex items-center space-x-2">
             <span>📥</span>
             <span>Exportar</span>
          </button>
          <button @click="fetchLogs()" :disabled="loading" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-medium transition-all flex items-center space-x-2 disabled:opacity-50">
             <span :class="loading ? 'animate-spin' : ''">🔄</span>
             <span>Atualizar</span>
          </button>
       </div>
     </div>

     <!-- Stats Headers -->
     <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Active Shields -->
        <div class="bg-emerald-600/5 border border-emerald-500/20 p-8 rounded-[2.5rem] flex flex-col items-center justify-center text-center space-y-4">
           <ShieldCheck className="w-12 h-12 text-emerald-500" />
           <div>
              <h4 class="text-sm font-black text-white uppercase tracking-tight">Status Global</h4>
              <p class="text-[10px] text-emerald-400 font-bold uppercase tracking-widest mt-1">Ambiente Protegido</p>
           </div>
        </div>

        <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-6">
           <div class="bg-gray-900 border border-gray-800 p-8 rounded-[2rem] space-y-2">
              <Lock className="w-6 h-6 text-gray-600" />
              <p class="text-2xl font-black text-white">2FA Ativo</p>
              <p class="text-[8px] text-gray-500 font-black uppercase">Obrigatório para Admin</p>
           </div>
           <div class="bg-gray-900 border border-gray-800 p-8 rounded-[2rem] space-y-2">
              <AlertTriangle className="w-6 h-6 text-orange-500 animate-pulse" />
              <p class="text-2xl font-black text-white" x-text="pendingCount + ' Alertas'">--</p>
              <p class="text-[8px] text-gray-500 font-black uppercase">Aguardando Revisão</p>
           </div>
           <div class="bg-gray-900 border border-gray-800 p-8 rounded-[2rem] space-y-2">
              <Unlock className="w-6 h-6 text-gray-600" />
              <p class="text-2xl font-black text-white" x-text="stats.whitelistCount">15</p>
              <p class="text-[8px] text-gray-500 font-black uppercase">Endereços de IP</p>
           </div>
        </div>
     </div>

     <!-- Filters -->
     <div class="bg-gray-900/50 border border-gray-800 rounded-xl p-4 flex flex-wrap gap-4 items-center">
        <div class="flex-1 min-w-[200px]">
           <input type="text" x-model="search" @input.debounce.300ms="filterLogs()" placeholder="Buscar logs..." 
                  class="w-full bg-gray-950 border border-gray-700 rounded-lg p-3 text-white focus:border-rose-500 outline-none">
        </div>
        <select x-model="typeFilter" @change="filterLogs()" class="bg-gray-950 border border-gray-700 rounded-lg p-3 text-white focus:border-rose-500 outline-none">
           <option value="">Todos os Tipos</option>
           <option value="critical">Crítico</option>
           <option value="warning">Aviso</option>
           <option value="info">Info</option>
        </select>
        <select x-model="statusFilter" @change="filterLogs()" class="bg-gray-950 border border-gray-700 rounded-lg p-3 text-white focus:border-rose-500 outline-none">
           <option value="">Todos os Status</option>
           <option value="pending">Pendente</option>
           <option value="resolved">Resolvido</option>
           <option value="ignored">Ignorado</option>
        </select>
     </div>

     <!-- Lista de Logs -->
     <div class="space-y-4">
        <div class="flex items-center justify-between">
           <h3 class="text-xs font-black text-gray-500 uppercase tracking-widest ml-1">Eventos de Segurança (Últimas 24h)</h3>
           <button @click="resolveAllPending()" x-show="pendingCount > 0" class="text-xs text-rose-400 hover:text-rose-300 font-medium transition-colors">
              Resolver Todos Pendentes
           </button>
        </div>
        
        <!-- Loading -->
        <div x-show="loading" class="flex items-center justify-center py-10">
           <div class="w-10 h-10 border-4 border-rose-500 border-t-transparent rounded-full animate-spin"></div>
        </div>

        <!-- Logs List -->
        <template x-for="log in filteredLogs" :key="log.id">
          <div class="bg-gray-900/40 border border-gray-800 p-6 rounded-2xl flex items-center justify-between hover:bg-black/60 transition-all group overflow-hidden relative">
             <div x-show="log.type === 'critical'" class="absolute left-0 top-0 bottom-0 w-1 bg-rose-600"></div>
             <div x-show="log.type === 'warning'" class="absolute left-0 top-0 bottom-0 w-1 bg-orange-500"></div>
             
             <div class="flex items-center space-x-6">
                <div :class="{
                   'bg-rose-500/10 text-rose-500': log.type === 'critical',
                   'bg-orange-500/10 text-orange-500': log.type === 'warning',
                   'bg-gray-800 text-gray-500': log.type === 'info'
                }" class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0">
                   <ShieldAlert className="w-6 h-6" />
                </div>
                <div>
                   <h4 class="text-base font-bold text-white" x-text="log.title"></h4>
                   <p class="text-xs text-gray-500 mt-1" x-text="log.message + ' • ' + formatTime(log.created_at)"></p>
                   <div class="flex items-center space-x-2 mt-2">
                      <span x-show="log.ip" class="text-[10px] bg-gray-800 px-2 py-0.5 rounded text-gray-400 font-mono" x-text="'IP: ' + log.ip"></span>
                      <span x-show="log.count > 1" class="text-[10px] bg-rose-500/10 px-2 py-0.5 rounded text-rose-400 font-bold" x-text="log.count + 'x'"></span>
                   </div>
                </div>
             </div>

             <div class="flex items-center space-x-4">
                <span :class="{
                   'bg-emerald-500/10 text-emerald-400': log.status === 'resolved',
                   'bg-orange-500/10 text-orange-400': log.status === 'pending',
                   'bg-gray-700/50 text-gray-500': log.status === 'ignored'
                }" class="text-[10px] font-black uppercase px-3 py-1 rounded-full" x-text="getStatusLabel(log.status)"></span>
                
                <div class="flex space-x-2">
                   <button @click="openDetails(log)" class="px-4 py-2 bg-gray-800 hover:bg-white hover:text-black rounded-xl text-xs font-bold uppercase tracking-wide transition-all">
                      Detalhes
                   </button>
                   <button x-show="log.status === 'pending'" @click="resolveLog(log.id)" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold uppercase tracking-wide transition-all">
                      Resolver
                   </button>
                </div>
             </div>
          </div>
        </template>
        
        <div x-show="filteredLogs.length === 0 && !loading" class="text-center py-10 text-gray-600">
           <p>Nenhum evento de segurança encontrado.</p>
        </div>
     </div>

     <!-- Details Modal -->
     <div x-show="detailsModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4" @keydown.escape.window="detailsModal = false">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @click="detailsModal = false"></div>
        <div class="relative w-full max-w-2xl bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl overflow-hidden" @click.stop>
           <div class="bg-gradient-to-r from-rose-600/20 to-orange-600/20 p-6 border-b border-gray-800">
              <div class="flex items-center justify-between">
                 <div class="flex items-center space-x-4">
                    <div :class="{
                       'bg-rose-500/20 text-rose-500': selectedLog?.type === 'critical',
                       'bg-orange-500/20 text-orange-500': selectedLog?.type === 'warning',
                       'bg-gray-700 text-gray-400': selectedLog?.type === 'info'
                    }" class="w-12 h-12 rounded-xl flex items-center justify-center">
                       <ShieldAlert className="w-6 h-6" />
                    </div>
                    <div>
                       <h2 class="text-xl font-bold text-white" x-text="selectedLog?.title"></h2>
                       <p class="text-xs text-gray-400" x-text="formatTime(selectedLog?.created_at)"></p>
                    </div>
                 </div>
                 <button @click="detailsModal = false" class="p-2 text-gray-500 hover:text-white hover:bg-gray-800 rounded-lg transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                 </button>
              </div>
           </div>
           <div class="p-6 space-y-6 max-h-[60vh] overflow-y-auto">
              <div class="grid grid-cols-2 gap-4">
                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">Tipo</p>
                    <p class="text-white font-medium capitalize" x-text="selectedLog?.type"></p>
                 </div>
                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">Status</p>
                    <p class="text-white font-medium" x-text="getStatusLabel(selectedLog?.status)"></p>
                 </div>
                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">IP de Origem</p>
                    <p class="text-white font-mono" x-text="selectedLog?.ip || 'N/A'"></p>
                 </div>
                 <div class="bg-gray-800/50 p-4 rounded-lg">
                    <p class="text-xs text-gray-500 uppercase mb-1">Ocorrências</p>
                    <p class="text-white font-medium" x-text="(selectedLog?.count || 1) + 'x'"></p>
                 </div>
              </div>
              <div class="bg-gray-800/50 p-4 rounded-lg">
                 <p class="text-xs text-gray-500 uppercase mb-2">Descrição</p>
                 <p class="text-white" x-text="selectedLog?.message"></p>
              </div>
              <div x-show="selectedLog?.user_agent" class="bg-gray-800/50 p-4 rounded-lg">
                 <p class="text-xs text-gray-500 uppercase mb-2">User Agent</p>
                 <p class="text-gray-400 text-sm font-mono break-all" x-text="selectedLog?.user_agent"></p>
              </div>
              <div x-show="selectedLog?.action_taken" class="bg-emerald-500/10 border border-emerald-500/20 p-4 rounded-lg">
                 <p class="text-xs text-emerald-400 uppercase mb-2">Ação Tomada</p>
                 <p class="text-emerald-300" x-text="selectedLog?.action_taken"></p>
              </div>
           </div>
           <div class="p-6 border-t border-gray-800 flex justify-between">
              <div class="flex space-x-3">
                 <button x-show="selectedLog?.status === 'pending'" @click="resolveLog(selectedLog?.id); detailsModal = false" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-xl transition-all">
                    ✓ Marcar como Resolvido
                 </button>
                 <button x-show="selectedLog?.status === 'pending'" @click="ignoreLog(selectedLog?.id); detailsModal = false" class="px-6 py-2.5 bg-gray-800 hover:bg-gray-700 text-gray-400 font-medium rounded-xl transition-all">
                    Ignorar
                 </button>
              </div>
              <button @click="detailsModal = false" class="px-6 py-2.5 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-xl transition-all">
                 Fechar
              </button>
           </div>
        </div>
     </div>
  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function securityLogs() {
    return {
      logs: [],
      filteredLogs: [],
      loading: true,
      detailsModal: false,
      selectedLog: null,
      search: '',
      typeFilter: '',
      statusFilter: '',
      stats: { whitelistCount: 15 },

      get pendingCount() {
        return this.logs.filter(l => l.status === 'pending').length;
      },

      async init() {
        await this.fetchLogs();
        setInterval(() => this.fetchLogs(), 15000);
      },

      async fetchLogs() {
        this.loading = true;
        try {
          const res = await fetch('/api/alert');
          if (res.ok) {
            const data = await res.json();
            this.logs = (data.alerts || []).filter(a => a.source === 'security');
          } else {
            this.logs = this.getMockLogs();
          }
        } catch(e) { 
          console.error(e);
          this.logs = this.getMockLogs();
        } finally {
          this.filterLogs();
          this.loading = false;
        }
      },

      getMockLogs() {
        return [
          { id: 1, title: 'Tentativas de Força Bruta', type: 'critical', status: 'pending', message: '42 tentativas de login falhadas do mesmo IP', ip: '192.168.1.100', count: 42, created_at: new Date(Date.now() - 300000).toISOString(), user_agent: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36', action_taken: null },
          { id: 2, title: 'Certificado SSL Renovado', type: 'info', status: 'resolved', message: 'Certificado SSL renovado automaticamente', ip: null, count: 1, created_at: new Date(Date.now() - 3600000).toISOString(), action_taken: 'Certificado atualizado com sucesso' },
          { id: 3, title: 'IP Bloqueado pelo Firewall', type: 'warning', status: 'pending', message: 'IP suspeito tentou acessar área restrita', ip: '45.227.100.55', count: 5, created_at: new Date(Date.now() - 1800000).toISOString(), user_agent: 'curl/7.68.0', action_taken: null },
          { id: 4, title: 'Nova Sessão Admin', type: 'info', status: 'resolved', message: 'Login administrativo realizado com sucesso', ip: '201.17.45.123', count: 1, created_at: new Date(Date.now() - 7200000).toISOString(), action_taken: '2FA verificado' },
          { id: 5, title: 'Injeção SQL Detectada', type: 'critical', status: 'pending', message: 'Tentativa de SQL injection bloqueada', ip: '103.45.67.89', count: 3, created_at: new Date(Date.now() - 600000).toISOString(), user_agent: 'sqlmap/1.4.7', action_taken: null },
        ];
      },

      filterLogs() {
        this.filteredLogs = this.logs.filter(l => {
          const matchesSearch = !this.search || 
            l.title.toLowerCase().includes(this.search.toLowerCase()) ||
            (l.ip && l.ip.includes(this.search)) ||
            l.message.toLowerCase().includes(this.search.toLowerCase());
          const matchesType = !this.typeFilter || l.type === this.typeFilter;
          const matchesStatus = !this.statusFilter || l.status === this.statusFilter;
          return matchesSearch && matchesType && matchesStatus;
        });
      },

      formatTime(dateStr) {
        if (!dateStr) return '';
        const date = new Date(dateStr);
        const now = new Date();
        const diff = now - date;
        
        if (diff < 60000) return 'Agora';
        if (diff < 3600000) return `${Math.floor(diff / 60000)}min atrás`;
        if (diff < 86400000) return `${Math.floor(diff / 3600000)}h atrás`;
        return date.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
      },

      getStatusLabel(status) {
        const labels = { pending: 'Pendente', resolved: 'Resolvido', ignored: 'Ignorado' };
        return labels[status] || status;
      },

      openDetails(log) {
        this.selectedLog = log;
        this.detailsModal = true;
      },

      async resolveLog(id) {
        try {
          await fetch(`/api/alert/${id}/resolve`, { method: 'POST' });
        } catch(e) { console.error(e); }
        
        const log = this.logs.find(l => l.id === id);
        if (log) {
          log.status = 'resolved';
          log.action_taken = 'Resolvido manualmente pelo administrador';
        }
        this.filterLogs();
      },

      async ignoreLog(id) {
        try {
          await fetch(`/api/alert/${id}/ignore`, { method: 'POST' });
        } catch(e) { console.error(e); }
        
        const log = this.logs.find(l => l.id === id);
        if (log) log.status = 'ignored';
        this.filterLogs();
      },

      async resolveAllPending() {
        if (!confirm('Tem certeza que deseja resolver todos os alertas pendentes?')) return;
        
        const pendingIds = this.logs.filter(l => l.status === 'pending').map(l => l.id);
        for (const id of pendingIds) {
          await this.resolveLog(id);
        }
      },

      exportLogs() {
        const csv = ['ID,Título,Tipo,Status,IP,Data'].concat(
          this.filteredLogs.map(l => `${l.id},"${l.title}",${l.type},${l.status},${l.ip || ''},${l.created_at}`)
        ).join('\n');
        
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = `security-logs-${new Date().toISOString().slice(0,10)}.csv`;
        link.click();
      }
    };
  }
</script>

<style>
  [x-cloak] { display: none !important; }
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
