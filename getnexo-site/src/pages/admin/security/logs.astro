---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ShieldCheck, ShieldAlert, Terminal, Lock, Unlock, AlertTriangle, MoreVertical } from 'lucide-react';

const securityLogs = [
  { id: 1, event: "Tentativas de Força Bruta Detectadas", type: "Security Alert", count: 42, severity: "Critical", status: "Bloqueado" },
  { id: 2, event: "Certificado SSL Renovado", type: "System Event", count: 1, severity: "Info", status: "Sucesso" },
  { id: 3, event: "Acesso de IP não autorizado", type: "Firewall Block", count: 5, severity: "High", status: "Em Quarentena" },
];
---

<AdminLayout title="Logs de Segurança" activeTab="seguranca">
  <div class="space-y-8 animate-fade-in py-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter flex items-center">
          <Terminal className="w-8 h-8 text-rose-500 mr-4" />
          Security Sentinel Logs
        </h1>
        <p class="text-sm text-gray-400 mt-1">Monitoramento em tempo real de tentativas de intrusão e integridade do sistema.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
       <!-- Active Shields -->
       <div class="bg-emerald-600/5 border border-emerald-500/20 p-8 rounded-[2.5rem] flex flex-col items-center justify-center text-center space-y-4">
          <ShieldCheck className="w-12 h-12 text-emerald-500" />
          <div>
             <h4 class="text-sm font-black text-white uppercase tracking-tight">Status Global</h4>
             <p class="text-[10px] text-emerald-400 font-bold uppercase tracking-widest mt-1">Ambiente Protegido</p>
          </div>
       </div>

       <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-gray-900 border border-gray-800 p-8 rounded-[2rem] space-y-2">
             <Lock className="w-6 h-6 text-gray-600" />
             <p class="text-24l font-black text-white">2FA Ativo</p>
             <p class="text-[8px] text-gray-500 font-black uppercase">Obrigatório para Admin</p>
          </div>
          <div class="bg-gray-900 border border-gray-800 p-8 rounded-[2rem] space-y-2">
             <AlertTriangle className="w-6 h-6 text-orange-500 animate-pulse" />
             <p class="text-2xl font-black text-white">03 Alertas</p>
             <p class="text-[8px] text-gray-500 font-black uppercase">Aguardando Revisão</p>
          </div>
          <div class="bg-gray-900 border border-gray-800 p-8 rounded-[2rem] space-y-2">
             <Unlock className="w-6 h-6 text-gray-600" />
             <p class="text-2xl font-black text-white">Whitelist</p>
             <p class="text-[8px] text-gray-500 font-black uppercase">15 Endereços de IP</p>
          </div>
       </div>
    </div>

    <!-- Lista de Logs -->
    <div class="space-y-4">
       <h3 class="text-xs font-black text-gray-500 uppercase tracking-widest ml-1 mb-6">Eventos de Segurança (Últimas 24h)</h3>
       {securityLogs.map(log => (
         <div class="bg-gray-900/40 border border-gray-800 p-8 rounded-[2.5rem] flex items-center justify-between hover:bg-black/60 transition-all group overflow-hidden relative">
            {log.severity === 'Critical' && <div class="absolute left-0 top-0 bottom-0 w-1 bg-rose-600"></div>}
            
            <div class="flex items-center space-x-6">
               <div class:list={["w-14 h-14 rounded-2xl flex items-center justify-center text-gray-600", log.severity === 'Critical' ? 'bg-rose-500/10 text-rose-500' : 'bg-gray-800']}>
                  <ShieldAlert className="w-7 h-7" />
               </div>
               <div>
                  <h4 class="text-lg font-bold text-white uppercase tracking-tight">{log.event}</h4>
                  <p class="text-[10px] text-gray-500 font-black uppercase tracking-widest">{log.type} • {log.count} Ocorrências</p>
               </div>
            </div>

            <div class="flex items-center space-x-6">
               <span class:list={["text-[8px] font-black uppercase px-2 py-1 rounded", log.status === 'Bloqueado' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-orange-500/10 text-orange-400']}>{log.status}</span>
               <button class="px-5 py-2.5 bg-gray-800 hover:bg-white hover:text-black rounded-xl text-[10px] font-black uppercase tracking-widest transition-all">Detalhes</button>
            </div>
         </div>
       ))}
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

