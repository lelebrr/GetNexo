---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Monitor, Smartphone, Globe, X, Clock, MapPin, Tablet, RefreshCw, AlertTriangle } from 'lucide-react';
---

<AdminLayout title="Sessões Ativas" activeTab="seguranca">
  <div class="max-w-4xl mx-auto space-y-10 animate-fade-in py-4" x-data="sessionsManager()">
    
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-gray-500/10 rounded-2xl flex items-center justify-center text-white border border-gray-500/20 shadow-xl shadow-gray-500/10">
          <Monitor className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Gerenciar Sessões</h1>
          <p class="text-sm text-gray-500 font-medium">Controle todos os dispositivos que possuem acesso à sua conta admin.</p>
        </div>
      </div>
      <div class="flex space-x-3">
         <button @click="refreshSessions()" :disabled="loading" class="p-3 bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-white rounded-xl transition-all">
            <RefreshCw className="w-5 h-5" :class="loading ? 'animate-spin' : ''" />
         </button>
         <button @click="terminateOthers()" :disabled="sessions.filter(s => !s.current).length === 0" class="px-6 py-3 bg-rose-600/10 border border-rose-500/20 text-rose-500 font-black rounded-2xl hover:bg-rose-600 hover:text-white transition-all uppercase text-xs tracking-widest disabled:opacity-50">
            Encerrar Outras
         </button>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
       <div class="bg-gray-900/40 border border-gray-800 p-6 rounded-2xl">
          <p class="text-xs text-gray-500 uppercase mb-1">Sessões Ativas</p>
          <p class="text-2xl font-bold text-white" x-text="sessions.length"></p>
       </div>
       <div class="bg-gray-900/40 border border-gray-800 p-6 rounded-2xl">
          <p class="text-xs text-gray-500 uppercase mb-1">Dispositivos Únicos</p>
          <p class="text-2xl font-bold text-white" x-text="new Set(sessions.map(s => s.device.split('/')[1]?.trim())).size"></p>
       </div>
       <div class="bg-gray-900/40 border border-gray-800 p-6 rounded-2xl">
          <p class="text-xs text-gray-500 uppercase mb-1">Último Login</p>
          <p class="text-lg font-bold text-white" x-text="lastLogin"></p>
       </div>
    </div>

    <!-- Loading -->
    <div x-show="loading" class="flex items-center justify-center py-10">
       <div class="w-10 h-10 border-4 border-white border-t-transparent rounded-full animate-spin"></div>
    </div>

    <!-- Active Sessions List -->
    <div x-show="!loading" class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <div class="divide-y divide-gray-800/50">
          <template x-for="session in sessions" :key="session.id">
             <div class="p-10 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                <div class="flex items-center space-x-8">
                   <div class="w-16 h-16 bg-gray-800 rounded-2xl flex items-center justify-center text-gray-500 group-hover:bg-white group-hover:text-black transition-all">
                      <template x-if="session.device.toLowerCase().includes('iphone') || session.device.toLowerCase().includes('android')">
                         <Smartphone className="w-8 h-8" />
                      </template>
                      <template x-if="session.device.toLowerCase().includes('windows') || session.device.toLowerCase().includes('mac')">
                         <Monitor className="w-8 h-8" />
                      </template>
                      <template x-if="session.device.toLowerCase().includes('api') || session.device.toLowerCase().includes('postman')">
                         <Globe className="w-8 h-8" />
                      </template>
                   </div>
                   <div class="space-y-1">
                      <div class="flex items-center space-x-3">
                         <h4 class="text-lg font-bold text-white uppercase tracking-tight" x-text="session.device"></h4>
                         <template x-if="session.current">
                            <span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-500 text-[8px] font-black uppercase rounded-md">Esta Sessão</span>
                         </template>
                         <template x-if="session.suspicious">
                            <span class="px-2 py-0.5 bg-amber-500/10 text-amber-500 text-[8px] font-black uppercase rounded-md flex items-center">
                               <AlertTriangle className="w-3 h-3 mr-1" /> Suspeito
                            </span>
                         </template>
                      </div>
                      <div class="flex items-center space-x-4 text-gray-600">
                         <div class="flex items-center space-x-1"><MapPin className="w-3.5 h-3.5" /><span class="text-[10px] font-bold" x-text="session.location"></span></div>
                         <div class="flex items-center space-x-1"><Clock className="w-3.5 h-3.5" /><span class="text-[10px] font-bold" x-text="formatTime(session.lastActive)"></span></div>
                      </div>
                      <p class="text-[9px] text-gray-700 font-mono" x-text="session.ip"></p>
                   </div>
                </div>

                <template x-if="!session.current">
                   <button @click="terminateSession(session.id)" class="p-4 bg-gray-800 hover:bg-rose-600/20 text-gray-500 hover:text-rose-400 rounded-2xl transition-all">
                      <X className="w-5 h-5" />
                   </button>
                </template>
             </div>
          </template>
       </div>
       
       <div x-show="sessions.length === 0" class="text-center py-10 text-gray-500">
          Nenhuma sessão ativa.
       </div>
    </div>
  </div>
</AdminLayout>

<script nonce={Astro.locals.nonce} is:inline>
  function sessionsManager() {
    return {
      sessions: [],
      loading: true,

      get lastLogin() {
        if (this.sessions.length === 0) return '-';
        const latest = this.sessions.reduce((a, b) => new Date(a.lastActive) > new Date(b.lastActive) ? a : b);
        return this.formatTime(latest.lastActive);
      },

      async init() {
        await this.refreshSessions();
      },

      async refreshSessions() {
        this.loading = true;
        try {
          const res = await fetch('/api/sessions');
          if (res.ok) {
            const data = await res.json();
            this.sessions = data.sessions || [];
          } else {
            this.sessions = this.getMockSessions();
          }
        } catch(e) {
          console.error(e);
          this.sessions = this.getMockSessions();
        } finally {
          this.loading = false;
        }
      },

      getMockSessions() {
        return [
          { id: 1, device: 'Chrome / Windows 11', location: 'São Paulo, BR', lastActive: new Date().toISOString(), current: true, ip: '192.168.1.1' },
          { id: 2, device: 'Safari / iPhone', location: 'Rio de Janeiro, BR', lastActive: new Date(Date.now() - 720000).toISOString(), current: false, ip: '201.12.45.88' },
          { id: 3, device: 'Postman API Client', location: 'Cloud Server', lastActive: new Date(Date.now() - 7200000).toISOString(), current: false, ip: '10.0.0.1' },
          { id: 4, device: 'Firefox / Unknown', location: 'Russia', lastActive: new Date(Date.now() - 86400000).toISOString(), current: false, ip: '45.33.22.11', suspicious: true },
        ];
      },

      formatTime(dateStr) {
        if (!dateStr) return '-';
        const date = new Date(dateStr);
        const now = new Date();
        const diff = now - date;
        
        if (diff < 60000) return 'Ativa Agora';
        if (diff < 3600000) return `Há ${Math.floor(diff / 60000)} min`;
        if (diff < 86400000) return `Há ${Math.floor(diff / 3600000)}h`;
        return date.toLocaleDateString('pt-BR');
      },

      async terminateSession(id) {
        if (!confirm('Encerrar esta sessão?')) return;
        
        try {
          await fetch(`/api/sessions/${id}`, { method: 'DELETE' });
        } catch(e) { console.error(e); }
        
        this.sessions = this.sessions.filter(s => s.id !== id);
      },

      async terminateOthers() {
        if (!confirm('Encerrar todas as outras sessões?')) return;
        
        try {
          await fetch('/api/sessions/terminate-others', { method: 'POST' });
        } catch(e) { console.error(e); }
        
        this.sessions = this.sessions.filter(s => s.current);
      }
    };
  }
</script>

<style>
  [x-cloak] { display: none !important; }
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
</AdminLayout>
