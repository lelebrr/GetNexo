---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { Monitor, Smartphone, Globe, X, Clock, MapPin, Tablet } from 'lucide-react';

const activeSessions = [
  { id: 1, device: "Chrome / Windows 11", location: "São Paulo, BR", time: "Ativa Agora", current: true, icon: Monitor },
  { id: 2, device: "Safári / iPhone", location: "Rio de Janeiro, BR", time: "Há 12 min", current: false, icon: Smartphone },
  { id: 3, device: "Postman API Client", location: "Cloud Server", time: "Há 2h", current: false, icon: Tablet },
];
---

<AdminLayout title="Sessões Ativas" activeTab="seguranca">
  <div class="max-w-4xl mx-auto space-y-10 animate-fade-in py-4"
       x-data="{ 
         sessions: [
           { id: 1, device: 'Chrome / Windows 11', location: 'São Paulo, BR', time: 'Ativa Agora', current: true },
           { id: 2, device: 'Safári / iPhone', location: 'Rio de Janeiro, BR', time: 'Há 12 min', current: false },
           { id: 3, device: 'Postman API Client', location: 'Cloud Server', time: 'Há 2h', current: false }
         ],
         terminate(id) {
           this.sessions = this.sessions.filter(s => s.id !== id);
         }
       }">
    
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-gray-500/10 rounded-2xl flex items-center justify-center text-white border border-gray-500/20 shadow-xl shadow-gray-500/10">
          <Monitor className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Gerenciar Sessões</h1>
          <p class="text-sm text-gray-500 font-medium">Controle todos os dispositivos que possuem acesso à sua conta admin.</p>
        </div>
      </div>
      <button @click="sessions = sessions.filter(s => s.current)" class="px-6 py-3 bg-rose-600/10 border border-rose-500/20 text-rose-500 font-black rounded-2xl hover:bg-rose-600 hover:text-white transition-all uppercase text-xs tracking-widest">
         Encerrar Outras
      </button>
    </div>

    <!-- Active Sessions List -->
    <div class="bg-gray-900/40 border border-gray-800 rounded-[2.5rem] overflow-hidden">
       <div class="divide-y divide-gray-800/50">
          <template x-for="session in sessions" :key="session.id">
             <div class="p-10 flex items-center justify-between hover:bg-white/[0.02] transition-colors group">
                <div class="flex items-center space-x-8">
                   <div class="w-16 h-16 bg-gray-800 rounded-2xl flex items-center justify-center text-gray-500 group-hover:bg-white group-hover:text-black transition-all">
                      <template x-if="session.device.includes('iPhone')"><Smartphone className="w-8 h-8" /></template>
                      <template x-if="session.device.includes('Windows')"><Monitor className="w-8 h-8" /></template>
                      <template x-if="!session.device.includes('iPhone') && !session.device.includes('Windows')"><Globe className="w-8 h-8" /></template>
                   </div>
                   <div class="space-y-1">
                      <div class="flex items-center space-x-3">
                         <h4 class="text-lg font-bold text-white uppercase tracking-tight" x-text="session.device"></h4>
                         <template x-if="session.current">
                            <span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-500 text-[8px] font-black uppercase rounded-md">Esta Sessão</span>
                         </template>
                      </div>
                      <div class="flex items-center space-x-4 text-gray-600">
                         <div class="flex items-center space-x-1"><MapPin className="w-3.5 h-3.5" /><span class="text-[10px] font-bold" x-text="session.location"></span></div>
                         <div class="flex items-center space-x-1"><Clock className="w-3.5 h-3.5" /><span class="text-[10px] font-bold" x-text="session.time"></span></div>
                      </div>
                   </div>
                </div>

                <template x-if="!session.current">
                   <button @click="terminate(session.id)" class="p-4 bg-gray-800 hover:bg-rose-600/20 text-gray-500 hover:text-rose-400 rounded-2xl transition-all"><X className="w-5 h-5" /></button>
                </template>
             </div>
          </template>
       </div>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
