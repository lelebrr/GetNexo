---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { MessageSquare, Plus, Trash2, Save, Search, Sparkles } from 'lucide-react';
---

<AdminLayout title="Respostas Personalizadas" activeTab="magic-replies">
  <div class="max-w-5xl mx-auto space-y-10 animate-fade-in py-4" 
       x-data="{ 
         search: '',
         replies: [
           { id: 1, trigger: 'Quero saber o preço', response: 'Nossos planos começam em R$ 99/mês. Qual seu segmento?', active: true },
           { id: 2, trigger: 'Qual o prazo de entrega?', response: 'Entregamos em todo o Brasil em até 7 dias úteis.', active: true },
           { id: 3, trigger: 'Vocês têm suporte 24h?', response: 'Sim! Nosso time está disponível 24/7 via WhatsApp.', active: false }
         ],
         add() {
           const id = Date.now();
           this.replies.push({ id, trigger: '', response: '', active: true });
         },
         remove(id) {
           this.replies = this.replies.filter(r => r.id !== id);
         }
       }">
    
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center space-x-4">
        <div class="w-14 h-14 bg-fuchsia-500/10 rounded-2xl flex items-center justify-center text-fuchsia-500 border border-fuchsia-500/20 shadow-xl shadow-fuchsia-500/10">
          <Sparkles className="w-7 h-7" />
        </div>
        <div>
          <h1 class="text-3xl font-black text-white uppercase tracking-tighter">Overrides de Resposta</h1>
          <p class="text-sm text-gray-500">Defina respostas específicas que ignoram a IA quando certos gatilhos são detectados.</p>
        </div>
      </div>
      <button @click="add()" class="px-6 py-3 bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-black rounded-2xl flex items-center space-x-2 transition-all shadow-lg shadow-fuchsia-600/20 uppercase text-xs tracking-widest">
         <Plus className="w-5 h-5" />
         <span>Novo Gatilho</span>
      </button>
    </div>

    <!-- Filtro -->
    <div class="relative max-w-md">
       <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-600" />
       <input type="text" x-model="search" placeholder="Filtrar gatilhos..." class="w-full bg-gray-900 border border-gray-800 rounded-2xl py-3 pl-12 pr-4 text-sm text-white focus:border-fuchsia-500 outline-none transition-all" />
    </div>

    <!-- Lista de Respostas -->
    <div class="grid grid-cols-1 gap-4">
       <template x-for="reply in replies.filter(r => r.trigger.toLowerCase().includes(search.toLowerCase()))" :key="reply.id">
          <div class="bg-gray-900/40 border border-gray-800 p-6 rounded-[2rem] hover:border-fuchsia-500/30 transition-all group">
             <div class="flex flex-col lg:flex-row gap-6">
                <div class="flex-1 space-y-4">
                   <div class="space-y-1">
                      <label class="text-[9px] font-black uppercase text-gray-600 tracking-widest ml-1">Pergunta do Cliente (Gatilho)</label>
                      <input type="text" x-model="reply.trigger" class="w-full bg-black/40 border border-gray-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 outline-none" />
                   </div>
                   <div class="space-y-1">
                      <label class="text-[9px] font-black uppercase text-gray-600 tracking-widest ml-1">Resposta Automática</label>
                      <textarea x-model="reply.response" class="w-full bg-black/40 border border-gray-800 rounded-xl px-4 py-2.5 text-sm text-white focus:border-fuchsia-500 outline-none min-h-[80px] resize-none"></textarea>
                   </div>
                </div>
                
                <div class="lg:w-48 flex flex-row lg:flex-col justify-between items-center lg:items-end gap-4 shrink-0">
                   <div class="flex items-center space-x-3">
                      <span class="text-[9px] font-black uppercase text-gray-500 tracking-widest" x-text="reply.active ? 'Ativo' : 'Pausado'"></span>
                      <button @click="reply.active = !reply.active" 
                              class="w-10 h-5 rounded-full relative transition-colors duration-300"
                              :class="reply.active ? 'bg-fuchsia-500' : 'bg-gray-800'">
                         <div class="absolute top-1 left-1 w-3 h-3 bg-white rounded-full transition-transform duration-300"
                              :class="reply.active ? 'translate-x-5' : 'translate-x-0'"></div>
                      </button>
                   </div>
                   
                   <div class="flex items-center space-x-2">
                      <button class="p-3 bg-gray-800 hover:bg-emerald-600/20 text-gray-500 hover:text-emerald-400 rounded-xl transition-all"><Save className="w-4 h-4" /></button>
                      <button @click="remove(reply.id)" class="p-3 bg-gray-800 hover:bg-rose-600/20 text-gray-500 hover:text-rose-400 rounded-xl transition-all"><Trash2 className="w-4 h-4" /></button>
                   </div>
                </div>
             </div>
          </div>
       </template>
    </div>
  </div>
</AdminLayout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
