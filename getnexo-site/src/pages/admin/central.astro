<Layout title="Central de Controle | GetNexo Admin">

<style is:global>
  /* ADMIN PAGE: Hide ALL external elements */
  .global-header, 
  .global-footer,
  .floating-whatsapp,
  #live-pulse,
  #command-palette,
  nav.navbar,
  footer,
  /* Chat widgets */
  .chatwoot-widget,
  #cw-widget,
  .chatwoot-bubble,
  [class*="chatwoot"],
  [id*="chatwoot"],
  .woot-widget-holder,
  .chat-widget,
  .chat-bubble,
  /* Accessibility button */
  .accessibility-btn,
  .accessibility-controls,
  .accessibility-menu,
  [class*="accessibility"],
  #accessibility-controls,
  /* Any fixed bottom elements */
  .fixed-bottom-right,
  .floating-widget,
  .fab-button,
  /* Tawk.to, Intercom, Drift, etc */
  #tawk-container,
  .intercom-launcher,
  .drift-widget { 
    display: none !important; 
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
  
  /* Override Layout main element */
  body > main,
  main:not(.main-content) { 
    padding: 0 !important; 
    margin: 0 !important;
    min-height: 100vh !important; 
    max-width: none !important;
    width: 100% !important;
  }
  
  /* Ensure admin-central fills viewport */
  .admin-central {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    z-index: 9999 !important;
    display: flex !important;
    background: #030712 !important;
  }
</style>

<script is:inline>
  // Force hide chat widgets and accessibility buttons on admin page
  document.addEventListener('DOMContentLoaded', function() {
    const hideElements = [
      '.chatwoot-widget', '#cw-widget', '.chatwoot-bubble', 
      '.accessibility-btn', '.accessibility-controls', '#accessibility-controls',
      '.floating-whatsapp', '.chat-widget', '.chat-bubble',
      '[class*="chatwoot"]', '[class*="accessibility"]'
    ];
    
    hideElements.forEach(selector => {
      document.querySelectorAll(selector).forEach(el => {
        el.style.display = 'none';
        el.style.visibility = 'hidden';
        el.remove();
      });
    });
    
    // Also observe for dynamically added widgets
    const observer = new MutationObserver(mutations => {
      hideElements.forEach(selector => {
        document.querySelectorAll(selector).forEach(el => {
          el.style.display = 'none';
          el.remove();
        });
      });
    });
    
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>

