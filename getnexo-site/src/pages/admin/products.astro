---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Produtos & Catálogo" activeTab="produtos">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-gradient-to-br from-orange-500 to-yellow-500 rounded-2xl flex items-center justify-center shadow-lg shadow-orange-500/30 animate-pulse">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-400">
      Produtos & Catálogo
    </h1>
    <p class="text-xl text-gray-400 max-w-lg">
      Gerencie todos os seus produtos, categorias, preços e estoque em um único lugar.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="/admin/products/new" class="px-6 py-3 bg-orange-600/20 hover:bg-orange-600/40 text-orange-400 rounded-lg border border-orange-500/30 transition-all">Criar Novo Produto</a>
      <a href="/admin/products/edit" class="px-6 py-3 bg-yellow-600/20 hover:bg-yellow-600/40 text-yellow-400 rounded-lg border border-yellow-500/30 transition-all">Editar Preços</a>
      <a href="/admin/products/media" class="px-6 py-3 bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 rounded-lg border border-purple-500/30 transition-all">Upload Mídia</a>
    </div>
  </div>
</AdminLayout>
