---
import PanelLayout from '../../layouts/PanelLayout.astro';
---

<PanelLayout title="Meu Painel">
    <div class="dashboard-grid">
        <div class="stat-card">
            <h3>Vendas Hoje</h3>
            <div class="value">R$ 1.540,50</div>
            <div class="trend positive">+12% vs ontem</div>
        </div>
        <div class="stat-card">
            <h3>Conversão</h3>
            <div class="value">3.2%</div>
            <div class="trend positive">+0.4%</div>
        </div>
        <div class="stat-card">
            <h3>Ticket Médio</h3>
            <div class="value">R$ 145,00</div>
        </div>
        <div class="stat-card">
            <h3>ROI Estimado</h3>
            <div class="value">450%</div>
            <div class="trend">Investimento: R$ 0</div>
        </div>
    </div>

    <div class="recent-activity-section">
        <h2>Atividade Recente</h2>
        <div class="activity-list">
            <div class="activity-item">
                <span class="dot"></span>
                <span class="text">Pedido #1024 recuperado via WhatsApp</span>
                <span class="time">10 min atrás</span>
            </div>
            <div class="activity-item">
                <span class="dot"></span>
                <span class="text">Novo lead capturado: Maria Silva</span>
                <span class="time">32 min atrás</span>
            </div>
        </div>
    </div>
</PanelLayout>

<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: #1e293b;
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.05);
    }
    .stat-card h3 { color: #94a3b8; font-size: 0.9rem; margin: 0 0 0.5rem 0; }
    .stat-card .value { font-size: 1.8rem; font-weight: 700; color: #fff; }
    .stat-card .trend { font-size: 0.8rem; margin-top: 0.5rem; color: #64748b; }
    .stat-card .trend.positive { color: #10b981; }

    .recent-activity-section h2 { margin-bottom: 1rem; color: #fff; font-size: 1.2rem; }
    .activity-list { background: #1e293b; border-radius: 12px; padding: 1rem; border: 1px solid rgba(255,255,255,0.05); }
    .activity-item { display: flex; align-items: center; padding: 0.8rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .activity-item:last-child { border-bottom: none; }
    .dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; margin-right: 1rem; }
    .text { flex: 1; color: #cbd5e1; }
    .time { font-size: 0.8rem; color: #64748b; }
</style>
