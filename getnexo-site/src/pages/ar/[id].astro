---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  // Apenas produtos que realmente têm modelos 3D disponíveis
  const products = [
    'demo-sofa'
  ];

  return products.map(product => ({
    params: { id: product }
  }));
}

const { id } = Astro.params;

// Verifica se o arquivo 3D existe
const has3DModel = id === 'demo-sofa';
const modelSrc = has3DModel ? `/modelos/${id}.glb` : null;
const iosSrc = has3DModel ? `/modelos/${id}.usdz` : null;

const nonce = Astro.locals.nonce;
---

<Layout title={`AR - ${id} | GetNexo`}>
  <div style="width:100vw; height:100vh; position:relative; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <!-- Se tiver modelo 3D, mostra o model-viewer -->
    {has3DModel ? (
      <>
        <model-viewer
          src={modelSrc}
          ar
          ios-src={iosSrc}
          camera-orbit="-45deg 55deg 2m"
          auto-rotate
          shadow-intensity="1"
          style="width:100%; height:100%;"
        ></model-viewer>
        <div style="position:absolute; top:20px; left:20px; background:rgba(0,0,0,0.7); color:white; padding:10px 15px; border-radius:8px; font-size:14px;">
          🛍️ Visualizando: {id.replace('-', ' ')}
        </div>
      </>
    ) : (
      <!-- Alternativa visual para produtos sem modelo 3D -->
      <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; color:white; text-align:center; padding:20px;">
        <div style="font-size:4rem; margin-bottom:20px;">📱</div>
        <h1 style="font-size:2.5rem; margin-bottom:15px; font-weight:300;">{id.replace('-', ' ').toUpperCase()}</h1>
        <p style="font-size:1.2rem; margin-bottom:30px; opacity:0.9;">Visualização 3D em breve</p>
        
        <!-- Placeholder visual com animação -->
        <div style="width:200px; height:200px; background:rgba(255,255,255,0.1); border:2px dashed rgba(255,255,255,0.3); border-radius:15px; display:flex; align-items:center; justify-content-center; margin-bottom:30px; animation: pulse 2s infinite;">
          <div style="font-size:3rem;">📦</div>
        </div>
        
        <div style="background:rgba(255,255,255,0.1); padding:15px 25px; border-radius:25px; margin-bottom:20px;">
          <strong>Este produto não possui modelo 3D disponível no momento.</strong>
        </div>
        
        <div style="display:flex; gap:15px; flex-wrap:wrap; justify-content:center;">
          <button class="ar-action-btn">
            Ver fotos
          </button>
          <button class="ar-action-btn">
            Especificações
          </button>
        </div>
      </div>
    )}
  </div>

  <!-- Lazy loading do model-viewer - carregado apenas quando necessário -->
  <script defer nonce={nonce}>
    // Carregar model-viewer apenas quando o elemento for visível
    function loadModelViewerWhenVisible() {
      if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
        const modelViewer = document.querySelector('model-viewer');
        if (modelViewer) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                // Carregar o script do model-viewer
                const script = document.createElement('script');
                script.type = 'module';
                script.src = 'https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js';
                script.nonce = nonce;
                script.onload = () => {
                  observer.unobserve(modelViewer);
                  console.log('Model-viewer carregado com sucesso');
                };
                script.onerror = () => {
                  console.warn('Falha ao carregar model-viewer');
                  observer.unobserve(modelViewer);
                };
                document.head.appendChild(script);
              }
            });
          }, { rootMargin: '100px 0px' });
          
          observer.observe(modelViewer);
        }
      }
    }

    // Iniciar quando o DOM estiver pronto
    if (document.readyState === 'complete') {
      loadModelViewerWhenVisible();
    } else {
      window.addEventListener('load', loadModelViewerWhenVisible);
    }
  </script>
  
  <style>
    @keyframes pulse {
      0% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.05); opacity: 0.8; }
      100% { transform: scale(1); opacity: 1; }
    }
    .ar-action-btn {
      background: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: white;
      padding: 10px 20px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.3s;
    }
    .ar-action-btn:hover {
      background: rgba(255, 255, 255, 0.3);
    }
  </style>
</Layout>