---
import Layout from '../../layouts/Layout.astro';
import { verifyMagicLink, generateToken } from '../../lib/auth.js';

const token = Astro.url.searchParams.get('token');
let user = null;
let error = null;

if (token) {
    user = verifyMagicLink(token);
    if (!user) {
        error = 'Link inválido ou expirado';
    }
}

if (user && !error) {
    // Generate JWT and redirect to dashboard
    const jwtToken = generateToken(user);
    // In real app, set cookie or redirect with token
    // For demo, redirect to hub
    return Astro.redirect('/cliente/hub');
}
---

<Layout title="Login - Portal do Cliente">
    <div class="login-container">
        <div class="login-card">
            <h1>Portal do Cliente</h1>
            <p>Acesse seu hub unificado sem senha</p>

            {error && <div class="error">{error}</div>}

            <div class="login-methods">
                <form action="/api/auth/magic-link" method="POST" class="login-form">
                    <input type="email" name="email" placeholder="Seu email" required />
                    <button type="submit">Receber Link Mágico</button>
                </form>

                <form action="/api/auth/whatsapp-link" method="POST" class="login-form">
                    <input type="tel" name="phone" placeholder="Seu WhatsApp" required />
                    <button type="submit">Receber via WhatsApp</button>
                </form>

                <div class="qr-section">
                    <p>Ou escaneie o QR Code:</p>
                    <div id="qr-code"></div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 2rem;
    }

    .login-card {
        background: white;
        border-radius: 12px;
        padding: 3rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        max-width: 400px;
        width: 100%;
        text-align: center;
    }

    .login-card h1 {
        color: #1e293b;
        margin-bottom: 0.5rem;
    }

    .login-card p {
        color: #64748b;
        margin-bottom: 2rem;
    }

    .login-methods {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .login-form input {
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        font-size: 1rem;
    }

    .login-form button {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 0.75rem;
        border-radius: 6px;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .login-form button:hover {
        background: #2563eb;
    }

    .qr-section {
        margin-top: 1rem;
    }

    .qr-section p {
        margin-bottom: 1rem;
        color: #64748b;
    }

    #qr-code {
        width: 150px;
        height: 150px;
        margin: 0 auto;
        border: 2px solid #e2e8f0;
        border-radius: 6px;
    }

    .error {
        background: #fee2e2;
        color: #dc2626;
        padding: 0.75rem;
        border-radius: 6px;
        margin-bottom: 1rem;
    }
</style>

<script>
    // Generate QR Code for demo email
    import QRCode from 'qrcode';

    const qrContainer = document.getElementById('qr-code');
    if (qrContainer) {
        const demoEmail = 'cliente@exemplo.com';
        QRCode.toCanvas(qrContainer, `https://getnexo.com/cliente/login?email=${demoEmail}`, {
            width: 150,
            margin: 1
        });
    }
</script>