---
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Gerenciar Conversas - GetNexo">
    <div class="mb-8">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Gerenciar Conversas</h1>
                <p class="text-gray-600 mt-2">Visualize e controle todas as conversas do seu WhatsApp Business</p>
            </div>
            <a href="/cliente/atendentes" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium">
                + Nova Conversa
            </a>
        </div>
    </div>

    <!-- Filtros e Busca -->
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <div class="flex flex-col lg:flex-row gap-4">
            <div class="flex-1">
                <input type="text" placeholder="Buscar conversas..." class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
            </div>
            <div class="flex gap-2">
                <select class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="">Status</option>
                    <option value="ativa">Ativa</option>
                    <option value="aguardando">Aguardando</option>
                    <option value="resolvida">Resolvida</option>
                    <option value="transferida">Transferida</option>
                </select>
                <select class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="">Atendente</option>
                    <option value="bot">Bot</option>
                    <option value="humano">Humano</option>
                    <option value="todos">Todos</option>
                </select>
                <select class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="recentes">Mais Recentes</option>
                    <option value="antigas">Mais Antigas</option>
                    <option value="prioridade">Prioridade</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Stats Rápidos -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-blue-100">
                    <span class="text-2xl">💬</span>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Conversas Ativas</p>
                    <p class="text-2xl font-bold text-gray-900">12</p>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-yellow-100">
                    <span class="text-2xl">⏳</span>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Aguardando Resposta</p>
                    <p class="text-2xl font-bold text-gray-900">3</p>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-green-100">
                    <span class="text-2xl">✅</span>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Resolvidas Hoje</p>
                    <p class="text-2xl font-bold text-gray-900">28</p>
                </div>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-purple-100">
                    <span class="text-2xl">⭐</span>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Satisfação Média</p>
                    <p class="text-2xl font-bold text-gray-900">4.7</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Conversas -->
    <div class="bg-white rounded-lg shadow">
        <div class="p-6 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-900">Conversas Ativas</h2>
        </div>

        <div class="divide-y divide-gray-200">
            <!-- Conversa 1 -->
            <div class="p-6 hover:bg-gray-50 transition-colors cursor-pointer">
                <div class="flex items-center justify-between">
                    <div class="flex items-center flex-1">
                        <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mr-4">
                            <span class="text-sm font-medium">MC</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center mb-1">
                                <h3 class="font-medium text-gray-900">Maria Clara Santos</h3>
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Ativa
                                </span>
                                <span class="ml-2 text-xs text-gray-500">🤖 Bot</span>
                            </div>
                            <p class="text-sm text-gray-600">"Olá! Gostaria de saber sobre os planos disponíveis..."</p>
                            <div class="flex items-center mt-2 text-xs text-gray-500">
                                <span>2 mensagens não lidas</span>
                                <span class="mx-2">•</span>
                                <span>Produto: Plano Premium</span>
                                <span class="mx-2">•</span>
                                <span>há 3 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button class="bg-blue-100 text-blue-700 px-3 py-1 rounded text-sm hover:bg-blue-200 transition-colors">
                            Responder
                        </button>
                        <button class="bg-gray-100 text-gray-700 px-3 py-1 rounded text-sm hover:bg-gray-200 transition-colors">
                            Transferir
                        </button>
                    </div>
                </div>
            </div>

            <!-- Conversa 2 -->
            <div class="p-6 hover:bg-gray-50 transition-colors cursor-pointer">
                <div class="flex items-center justify-between">
                    <div class="flex items-center flex-1">
                        <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mr-4">
                            <span class="text-sm font-medium">JS</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center mb-1">
                                <h3 class="font-medium text-gray-900">João Silva</h3>
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                    Aguardando
                                </span>
                                <span class="ml-2 text-xs text-gray-500">👤 Humano</span>
                            </div>
                            <p class="text-sm text-gray-600">"Obrigado pela informação. Vou pensar e entro em contato..."</p>
                            <div class="flex items-center mt-2 text-xs text-gray-500">
                                <span>Todas lidas</span>
                                <span class="mx-2">•</span>
                                <span>Produto: Suporte Técnico</span>
                                <span class="mx-2">•</span>
                                <span>há 12 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button class="bg-blue-100 text-blue-700 px-3 py-1 rounded text-sm hover:bg-blue-200 transition-colors">
                            Responder
                        </button>
                        <button class="bg-green-100 text-green-700 px-3 py-1 rounded text-sm hover:bg-green-200 transition-colors">
                            Resolver
                        </button>
                    </div>
                </div>
            </div>

            <!-- Conversa 3 -->
            <div class="p-6 hover:bg-gray-50 transition-colors cursor-pointer">
                <div class="flex items-center justify-between">
                    <div class="flex items-center flex-1">
                        <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mr-4">
                            <span class="text-sm font-medium">AS</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center mb-1">
                                <h3 class="font-medium text-gray-900">Ana Santos</h3>
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    Prioridade Alta
                                </span>
                                <span class="ml-2 text-xs text-gray-500">🤖 Bot</span>
                            </div>
                            <p class="text-sm text-gray-600">"Recebi o produto com defeito. Preciso resolver isso urgentemente!"</p>
                            <div class="flex items-center mt-2 text-xs text-gray-500">
                                <span>1 mensagem não lida</span>
                                <span class="mx-2">•</span>
                                <span>Produto: iPhone 15 Pro</span>
                                <span class="mx-2">•</span>
                                <span>há 8 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button class="bg-red-100 text-red-700 px-3 py-1 rounded text-sm hover:bg-red-200 transition-colors">
                            Assumir
                        </button>
                        <button class="bg-gray-100 text-gray-700 px-3 py-1 rounded text-sm hover:bg-gray-200 transition-colors">
                            Transferir
                        </button>
                    </div>
                </div>
            </div>

            <!-- Conversa 4 -->
            <div class="p-6 hover:bg-gray-50 transition-colors cursor-pointer">
                <div class="flex items-center justify-between">
                    <div class="flex items-center flex-1">
                        <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mr-4">
                            <span class="text-sm font-medium">RL</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center mb-1">
                                <h3 class="font-medium text-gray-900">Roberto Lima</h3>
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Ativa
                                </span>
                                <span class="ml-2 text-xs text-gray-500">🤖 Bot</span>
                            </div>
                            <p class="text-sm text-gray-600">"Olá! Tenho interesse no plano empresarial. Quais são os benefícios?"</p>
                            <div class="flex items-center mt-2 text-xs text-gray-500">
                                <span>Todas lidas</span>
                                <span class="mx-2">•</span>
                                <span>Produto: Plano Empresarial</span>
                                <span class="mx-2">•</span>
                                <span>há 15 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button class="bg-blue-100 text-blue-700 px-3 py-1 rounded text-sm hover:bg-blue-200 transition-colors">
                            Responder
                        </button>
                        <button class="bg-gray-100 text-gray-700 px-3 py-1 rounded text-sm hover:bg-gray-200 transition-colors">
                            Transferir
                        </button>
                    </div>
                </div>
            </div>

            <!-- Conversa 5 -->
            <div class="p-6 hover:bg-gray-50 transition-colors cursor-pointer">
                <div class="flex items-center justify-between">
                    <div class="flex items-center flex-1">
                        <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mr-4">
                            <span class="text-sm font-medium">CF</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center mb-1">
                                <h3 class="font-medium text-gray-900">Carla Fernandes</h3>
                                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                    Nova
                                </span>
                                <span class="ml-2 text-xs text-gray-500">🤖 Bot</span>
                            </div>
                            <p class="text-sm text-gray-600">"Oi! Vi seu anúncio no Instagram e gostaria de saber mais sobre o serviço."</p>
                            <div class="flex items-center mt-2 text-xs text-gray-500">
                                <span>3 mensagens não lidas</span>
                                <span class="mx-2">•</span>
                                <span>Origem: Instagram Ads</span>
                                <span class="mx-2">•</span>
                                <span>há 2 min</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button class="bg-blue-100 text-blue-700 px-3 py-1 rounded text-sm hover:bg-blue-200 transition-colors">
                            Responder
                        </button>
                        <button class="bg-gray-100 text-gray-700 px-3 py-1 rounded text-sm hover:bg-gray-200 transition-colors">
                            Transferir
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Paginação -->
        <div class="p-6 border-t border-gray-200">
            <div class="flex items-center justify-between">
                <p class="text-sm text-gray-700">
                    Mostrando <span class="font-medium">1</span> a <span class="font-medium">5</span> de <span class="font-medium">24</span> conversas
                </p>
                <div class="flex space-x-2">
                    <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                        Anterior
                    </button>
                    <button class="px-3 py-1 bg-blue-600 text-white border border-blue-600 rounded text-sm hover:bg-blue-700">
                        1
                    </button>
                    <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                        2
                    </button>
                    <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                        3
                    </button>
                    <button class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">
                        Próximo
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Chat (placeholder) -->
    <div id="chatModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
        <div class="relative top-20 mx-auto p-5 border w-11/12 md:w-3/4 lg:w-1/2 shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-medium text-gray-900">Conversa com Maria Clara Santos</h3>
                    <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
                        <span class="text-2xl">&times;</span>
                    </button>
                </div>
                <div class="chat-messages h-96 overflow-y-auto border rounded p-4 mb-4">
                    <!-- Mensagens seriam carregadas aqui -->
                    <div class="text-center text-gray-500">
                        Chat em tempo real seria implementado aqui
                    </div>
                </div>
                <div class="flex">
                    <input type="text" placeholder="Digite sua mensagem..." class="flex-1 px-3 py-2 border border-gray-300 rounded-l-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <button class="bg-blue-600 text-white px-4 py-2 rounded-r-lg hover:bg-blue-700">
                        Enviar
                    </button>
                </div>
            </div>
        </div>
    </div>
</ClientLayout>

<style>
    #chatModal {
        z-index: 50;
    }
</style>