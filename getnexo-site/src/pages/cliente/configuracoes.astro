---
import ClientLayout from '../../layouts/ClientLayout.astro';
---

<ClientLayout title="Configurações - GetNexo">
    <div class="mb-8">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Configurações</h1>
                <p class="text-gray-600 mt-2">Gerencie suas preferências e configurações da conta</p>
            </div>
            <button class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium">
                Salvar Alterações
            </button>
        </div>
    </div>

    <!-- Abas de Configuração -->
    <div class="mb-6">
        <nav class="flex space-x-8 overflow-x-auto" aria-label="Tabs">
            <button class="tab-button border-b-2 border-blue-500 text-blue-600 font-medium py-2 px-1 whitespace-nowrap" data-tab="perfil">
                Perfil
            </button>
            <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium py-2 px-1 whitespace-nowrap" data-tab="notificacoes">
                Notificações
            </button>
            <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium py-2 px-1 whitespace-nowrap" data-tab="seguranca">
                Segurança
            </button>
            <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium py-2 px-1 whitespace-nowrap" data-tab="chat">
                Chat
            </button>
            <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium py-2 px-1 whitespace-nowrap" data-tab="integracoes">
                Integrações
            </button>
            <button class="tab-button border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium py-2 px-1 whitespace-nowrap" data-tab="faturamento">
                Faturamento
            </button>
        </nav>
    </div>

    <!-- Conteúdo das Abas -->
    <div class="space-y-8">

        <!-- Aba Perfil -->
        <div id="tab-perfil" class="tab-content">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-6">Informações do Perfil</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Nome da Empresa *</label>
                        <input type="text" value="Minha Empresa Ltda" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Nome do Responsável</label>
                        <input type="text" value="João Silva" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
                        <input type="email" value="joao@minhaempresa.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Telefone</label>
                        <input type="tel" value="+55 11 99999-9999" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-2">Website</label>
                        <input type="url" value="https://minhaempresa.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Setor</label>
                        <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="tecnologia">Tecnologia</option>
                            <option value="varejo">Varejo</option>
                            <option value="servicos">Serviços</option>
                            <option value="saude">Saúde</option>
                            <option value="educacao">Educação</option>
                            <option value="outros" selected>Outros</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Porte da Empresa</label>
                        <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="pequeno">Pequena (1-10 funcionários)</option>
                            <option value="medio" selected>Média (11-50 funcionários)</option>
                            <option value="grande">Grande (51+ funcionários)</option>
                        </select>
                    </div>
                </div>

                <div class="mt-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Sobre a Empresa</label>
                    <textarea rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Conte um pouco sobre seu negócio...">Somos uma empresa especializada em soluções de atendimento ao cliente, oferecendo serviços de alta qualidade para melhorar a experiência dos consumidores.</textarea>
                </div>

                <!-- Avatar -->
                <div class="mt-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Logo da Empresa</label>
                    <div class="flex items-center space-x-4">
                        <div class="w-20 h-20 bg-gray-200 rounded-lg flex items-center justify-center">
                            <span class="text-2xl text-gray-500">🏢</span>
                        </div>
                        <div>
                            <button class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition-colors">
                                Alterar Logo
                            </button>
                            <p class="text-xs text-gray-500 mt-1">PNG, JPG até 2MB</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aba Notificações -->
        <div id="tab-notificacoes" class="tab-content hidden">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-6">Preferências de Notificação</h2>

                <div class="space-y-6">
                    <!-- Notificações por Email -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Notificações por Email</h3>
                        <div class="space-y-3">
                            <label class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900">Novas conversas</span>
                                    <p class="text-sm text-gray-600">Receba alertas quando novos clientes iniciarem conversas</p>
                                </div>
                                <input type="checkbox" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            </label>

                            <label class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900">Conversas prioritárias</span>
                                    <p class="text-sm text-gray-600">Alertas para conversas marcadas como urgentes</p>
                                </div>
                                <input type="checkbox" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            </label>

                            <label class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900">Relatórios semanais</span>
                                    <p class="text-sm text-gray-600">Resumo semanal do desempenho do seu negócio</p>
                                </div>
                                <input type="checkbox" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            </label>

                            <label class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900">Atualizações do sistema</span>
                                    <p class="text-sm text-gray-600">Novidades e manutenções programadas</p>
                                </div>
                                <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            </label>
                        </div>
                    </div>

                    <!-- Notificações Push -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Notificações Push no Navegador</h3>
                        <div class="space-y-3">
                            <label class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900">Mensagens não lidas</span>
                                    <p class="text-sm text-gray-600">Notificações quando há mensagens aguardando resposta</p>
                                </div>
                                <input type="checkbox" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            </label>

                            <label class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900">Vendas realizadas</span>
                                    <p class="text-sm text-gray-600">Alertas instantâneos de novas vendas</p>
                                </div>
                                <input type="checkbox" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            </label>
                        </div>
                    </div>

                    <!-- Notificações por WhatsApp -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Notificações por WhatsApp</h3>
                        <div class="space-y-3">
                            <label class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900">Resumo diário</span>
                                    <p class="text-sm text-gray-600">Relatório diário enviado no seu WhatsApp</p>
                                </div>
                                <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            </label>

                            <label class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div>
                                    <span class="font-medium text-gray-900">Alertas críticos</span>
                                    <p class="text-sm text-gray-600">Apenas notificações de alta prioridade</p>
                                </div>
                                <input type="checkbox" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aba Segurança -->
        <div id="tab-seguranca" class="tab-content hidden">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-6">Configurações de Segurança</h2>

                <div class="space-y-6">
                    <!-- Alterar Senha -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Alterar Senha</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Senha Atual</label>
                                <input type="password" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            </div>
                            <div></div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Nova Senha</label>
                                <input type="password" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Confirmar Nova Senha</label>
                                <input type="password" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            </div>
                        </div>
                        <button class="mt-4 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                            Alterar Senha
                        </button>
                    </div>

                    <!-- Autenticação de Dois Fatores -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Autenticação de Dois Fatores (2FA)</h3>
                        <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                            <div>
                                <span class="font-medium text-gray-900">2FA por SMS</span>
                                <p class="text-sm text-gray-600">Receba códigos de verificação por SMS</p>
                            </div>
                            <div class="flex items-center">
                                <span class="text-sm text-green-600 font-medium mr-2">Ativado</span>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" checked class="sr-only peer">
                                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Sessões Ativas -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Sessões Ativas</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                                        <span class="text-lg">💻</span>
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900">Chrome no Windows</p>
                                        <p class="text-sm text-gray-600">São Paulo, Brasil • Agora mesmo</p>
                                    </div>
                                </div>
                                <span class="text-sm text-green-600 font-medium">Sessão Atual</span>
                            </div>

                            <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center mr-3">
                                        <span class="text-lg">📱</span>
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900">iPhone 15 Pro</p>
                                        <p class="text-sm text-gray-600">São Paulo, Brasil • 2 horas atrás</p>
                                    </div>
                                </div>
                                <button class="text-red-600 hover:text-red-800 text-sm font-medium">
                                    Encerrar Sessão
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aba Chat -->
        <div id="tab-chat" class="tab-content hidden">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-6">Personalização do Botão do Chat</h2>

                <div class="space-y-8">
                    <!-- Preview do Chat -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Preview do Chat</h3>
                        <div class="relative bg-gray-100 rounded-lg h-96 border-2 border-dashed border-gray-300 overflow-hidden">
                            <!-- Simulação de página do cliente -->
                            <div class="p-8 h-full">
                                <div class="max-w-4xl mx-auto">
                                    <h1 class="text-3xl font-bold text-gray-900 mb-4">Sua Página</h1>
                                    <p class="text-gray-600 mb-8">Este é um preview da sua página com o botão do chat personalizado.</p>

                                    <!-- Botão do chat preview (será controlado pelo JavaScript) -->
                                    <div id="chat-preview-button" class="fixed bottom-6 right-6 w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center text-white text-2xl shadow-lg cursor-pointer transition-all duration-300 hover:scale-110 z-50">
                                        💬
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="text-sm text-gray-500 mt-2">* Este é um preview interativo. As mudanças são aplicadas em tempo real.</p>
                    </div>

                    <!-- Posição do Botão -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Posição do Botão</h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <label class="relative">
                                <input type="radio" name="chat-position" value="bottom-right" class="sr-only" checked>
                                <div class="border-2 border-gray-200 rounded-lg p-4 cursor-pointer hover:border-blue-300 transition-colors text-center chat-position-option" data-position="bottom-right">
                                    <div class="text-2xl mb-2">↘️</div>
                                    <span class="text-sm font-medium">Inferior Direito</span>
                                </div>
                            </label>
                            <label class="relative">
                                <input type="radio" name="chat-position" value="bottom-left" class="sr-only">
                                <div class="border-2 border-gray-200 rounded-lg p-4 cursor-pointer hover:border-blue-300 transition-colors text-center chat-position-option" data-position="bottom-left">
                                    <div class="text-2xl mb-2">↙️</div>
                                    <span class="text-sm font-medium">Inferior Esquerdo</span>
                                </div>
                            </label>
                            <label class="relative">
                                <input type="radio" name="chat-position" value="top-right" class="sr-only">
                                <div class="border-2 border-gray-200 rounded-lg p-4 cursor-pointer hover:border-blue-300 transition-colors text-center chat-position-option" data-position="top-right">
                                    <div class="text-2xl mb-2">↗️</div>
                                    <span class="text-sm font-medium">Superior Direito</span>
                                </div>
                            </label>
                            <label class="relative">
                                <input type="radio" name="chat-position" value="top-left" class="sr-only">
                                <div class="border-2 border-gray-200 rounded-lg p-4 cursor-pointer hover:border-blue-300 transition-colors text-center chat-position-option" data-position="top-left">
                                    <div class="text-2xl mb-2">↖️</div>
                                    <span class="text-sm font-medium">Superior Esquerdo</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Estilos de Botão -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Escolha o Estilo do Botão</h3>
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
                            <!-- Botão 1 - Clássico HD -->
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="chat-style" value="classic" class="sr-only" checked>
                                <div class="border-2 border-blue-500 rounded-xl p-4 text-center chat-style-option selected bg-gradient-to-br from-blue-50 to-blue-100 shadow-lg transform transition-all duration-300 hover:scale-105">
                                    <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white text-2xl mx-auto mb-3 shadow-lg relative overflow-hidden">
                                        <div class="absolute inset-0 bg-white opacity-20 rounded-full"></div>
                                        <svg class="w-7 h-7 relative z-10" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2C6.48 2 2 6.48 2 12c0 1.54.36 3.05 1.05 4.42L2 22l5.58-1.05C9.95 21.64 11.46 22 13 22h7c1.1 0 2-.9 2-2V12c0-5.52-4.48-10-10-10z"/>
                                        </svg>
                                    </div>
                                    <span class="text-sm font-semibold text-gray-700">Clássico</span>
                                </div>
                            </label>

                            <!-- Botão 2 - Modern Gradient -->
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="chat-style" value="modern" class="sr-only">
                                <div class="border-2 border-gray-200 rounded-xl p-4 text-center chat-style-option bg-gradient-to-br from-gray-50 to-gray-100 shadow-md transform transition-all duration-300 hover:scale-105 hover:shadow-lg">
                                    <div class="w-14 h-14 bg-gradient-to-br from-purple-500 via-pink-500 to-rose-500 rounded-full flex items-center justify-center text-white text-2xl mx-auto mb-3 shadow-lg relative overflow-hidden">
                                        <div class="absolute inset-0 bg-white opacity-20 rounded-full animate-pulse"></div>
                                        <svg class="w-7 h-7 relative z-10" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                        </svg>
                                    </div>
                                    <span class="text-sm font-semibold text-gray-700">Moderno</span>
                                </div>
                            </label>

                            <!-- Botão 3 - Neural AI -->
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="chat-style" value="neural" class="sr-only">
                                <div class="border-2 border-gray-200 rounded-xl p-4 text-center chat-style-option bg-gradient-to-br from-gray-50 to-gray-100 shadow-md transform transition-all duration-300 hover:scale-105 hover:shadow-lg">
                                    <div class="w-14 h-14 bg-gradient-to-br from-cyan-400 via-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white text-2xl mx-auto mb-3 shadow-lg relative overflow-hidden">
                                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white to-transparent opacity-30 animate-pulse"></div>
                                        <svg class="w-7 h-7 relative z-10" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                        </svg>
                                    </div>
                                    <span class="text-sm font-semibold text-gray-700">IA Neural</span>
                                </div>
                            </label>

                            <!-- Botão 4 - Glass Morphism -->
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="chat-style" value="glass" class="sr-only">
                                <div class="border-2 border-gray-200 rounded-xl p-4 text-center chat-style-option bg-gradient-to-br from-gray-50 to-gray-100 shadow-md transform transition-all duration-300 hover:scale-105 hover:shadow-lg">
                                    <div class="w-14 h-14 bg-gradient-to-br from-white to-gray-100 rounded-full flex items-center justify-center text-gray-700 text-2xl mx-auto mb-3 shadow-lg backdrop-blur-sm border border-white/50 relative overflow-hidden">
                                        <div class="absolute inset-0 bg-gradient-to-br from-blue-400/20 to-purple-600/20 rounded-full"></div>
                                        <svg class="w-7 h-7 relative z-10" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                                        </svg>
                                    </div>
                                    <span class="text-sm font-semibold text-gray-700">Vidro</span>
                                </div>
                            </label>

                            <!-- Botão 5 - Neon Glow -->
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="chat-style" value="neon" class="sr-only">
                                <div class="border-2 border-gray-200 rounded-xl p-4 text-center chat-style-option bg-gradient-to-br from-gray-50 to-gray-100 shadow-md transform transition-all duration-300 hover:scale-105 hover:shadow-lg">
                                    <div class="w-14 h-14 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full flex items-center justify-center text-white text-2xl mx-auto mb-3 shadow-lg relative overflow-hidden">
                                        <div class="absolute inset-0 bg-gradient-to-r from-cyan-400 via-pink-500 to-purple-600 rounded-full animate-pulse opacity-75"></div>
                                        <div class="absolute inset-1 bg-black/20 rounded-full backdrop-blur-sm"></div>
                                        <svg class="w-7 h-7 relative z-10" fill="currentColor" viewBox="0 0 24 24">
