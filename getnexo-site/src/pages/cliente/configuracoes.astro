        // Função para atualizar seleção visual
        function updateSelectionVisual() {
            // Atualizar posições
            document.querySelectorAll('.chat-position-option').forEach(option => {
                option.classList.remove('border-blue-500', 'bg-blue-50');
                option.classList.add('border-gray-200');
            });

            const selectedPosition = document.querySelector('input[name="chat-position"]:checked');
            if (selectedPosition) {
                const positionOption = document.querySelector(`[data-position="${selectedPosition.value}"]`);
                if (positionOption) {
                    positionOption.classList.remove('border-gray-200');
                    positionOption.classList.add('border-blue-500', 'bg-blue-50');
                }
            }

            // Atualizar estilos
            document.querySelectorAll('.chat-style-option').forEach(option => {
                option.classList.remove('border-blue-500', 'bg-blue-50');
                option.classList.add('border-gray-200');
            });

            const selectedStyle = document.querySelector('input[name="chat-style"]:checked');
            if (selectedStyle) {
                const styleOption = document.querySelector(`[data-style="${selectedStyle.value}"]`);
                if (styleOption) {
                    styleOption.classList.remove('border-gray-200');
                    styleOption.classList.add('border-blue-500', 'bg-blue-50');
                }
            }
        }

        // Inicializar quando a página carrega
        document.addEventListener('DOMContentLoaded', function() {
            // Vincular eventos de mudança para posição
            document.querySelectorAll('input[name="chat-position"]').forEach(radio => {
                radio.addEventListener('change', () => {
                    updateSelectionVisual();
                    updateChatPreview();
                });
            });

            // Vincular eventos de mudança para estilo
            document.querySelectorAll('input[name="chat-style"]').forEach(radio => {
                radio.addEventListener('change', () => {
                    updateSelectionVisual();
                    updateChatPreview();
                });
            });

            // Vincular eventos dos controles adicionais
            ['chat-button-text', 'chat-primary-color', 'chat-button-size', 'chat-animation'].forEach(id => {
                const element = document.getElementById(id);
                if (element) {
                    element.addEventListener('input', updateChatPreview);
                    element.addEventListener('change', updateChatPreview);
                }
            });

            // Vincular mudança de cor para o input de texto
            const colorInput = document.getElementById('chat-primary-color');
            const colorTextInput = document.getElementById('chat-primary-color-text');

            if (colorInput && colorTextInput) {
                colorInput.addEventListener('input', function() {
                    colorTextInput.value = this.value;
                    updateChatPreview();
                });

                colorTextInput.addEventListener('input', function() {
                    if (/^#[0-9A-F]{6}$/i.test(this.value)) {
                        colorInput.value = this.value;
                        updateChatPreview();
                    }
                });
            }

            // Inicializar visual
            updateSelectionVisual();
            updateChatPreview();
        });
    </script>

<script nonce={Astro.locals.nonce}>
    // JavaScript para alternar entre as abas
    document.addEventListener('DOMContentLoaded', function() {
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabContents = document.querySelectorAll('.tab-content');

        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Remove active classes
                tabButtons.forEach(btn => {
                    btn.classList.remove('border-blue-500', 'text-blue-600');
                    btn.classList.add('border-transparent', 'text-gray-500');
                });
                tabContents.forEach(content => content.classList.add('hidden'));

                // Add active class to clicked button
                button.classList.remove('border-transparent', 'text-gray-500');
                button.classList.add('border-blue-500', 'text-blue-600');

                // Show corresponding content
                const tabId = button.getAttribute('data-tab');
                document.getElementById('tab-' + tabId).classList.remove('hidden');
            });
        });
    });
</script>