---
import ClientLayout from '../../../layouts/ClientLayout.astro';
---

<ClientLayout title="Criar Novo Atendente Virtual - GetNexo">
    <div class="mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Criar Novo Atendente Virtual</h1>
                <p class="text-gray-600 mt-2">Configure um assistente de IA personalizado para seu negócio</p>
            </div>
            <a href="/cliente/atendentes" class="text-gray-600 hover:text-gray-800 font-medium">
                ← Voltar para Atendentes
            </a>
        </div>
    </div>

    <form class="space-y-8">
        <!-- Etapa 1: Informações Básicas -->
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-6">1. Informações Básicas</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nome do Atendente *</label>
                    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Ex: Atendente de Vendas">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Especialidade</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">Selecione uma especialidade</option>
                        <option value="geral">Atendimento Geral</option>
                        <option value="vendas">Especialista de Vendas</option>
                        <option value="suporte">Suporte Técnico</option>
                        <option value="agendamento">Agendamentos</option>
                        <option value="posvenda">Pós-Venda</option>
                        <option value="customizado">Personalizado</option>
                    </select>
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Descrição *</label>
                    <textarea rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Descreva o que este atendente fará e qual seu objetivo principal..."></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Idioma Principal</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="pt-BR">Português (Brasil)</option>
                        <option value="en">English</option>
                        <option value="es">Español</option>
                        <option value="fr">Français</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Tom de Voz</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="profissional">Profissional</option>
                        <option value="amigavel">Amigável</option>
                        <option value="formal">Formal</option>
                        <option value="divertido">Divertido</option>
                        <option value="empatico">Empático</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Etapa 2: Conhecimento e Base de Dados -->
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-6">2. Conhecimento e Base de Dados</h2>

            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Contexto sobre seu negócio *</label>
                    <textarea rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Descreva seu negócio, produtos, serviços, público-alvo, diferenciais, etc. Quanto mais detalhado, melhor será o atendimento."></textarea>
                    <p class="text-xs text-gray-500 mt-1">Este contexto será usado para treinar o atendente e torná-lo mais preciso.</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Produtos/Serviços Principais</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Produto/Serviço 1">
                        </div>
                        <div>
                            <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Produto/Serviço 2">
                        </div>
                        <div>
                            <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Produto/Serviço 3">
                        </div>
                        <div class="flex items-center">
                            <button type="button" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                                + Adicionar mais produtos
                            </button>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Perguntas Frequentes</label>
                    <div class="space-y-3">
                        <div class="flex gap-3">
                            <input type="text" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Pergunta frequente">
                            <input type="text" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Resposta">
                        </div>
                        <div class="flex gap-3">
                            <input type="text" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Pergunta frequente">
                            <input type="text" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Resposta">
                        </div>
                        <button type="button" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                            + Adicionar mais perguntas
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Etapa 3: Comportamento e Regras -->
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-6">3. Comportamento e Regras</h2>

            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Objetivos Principais *</label>
                    <div class="space-y-2">
                        <label class="flex items-center">
                            <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-2 text-sm">Fornecer informações sobre produtos/serviços</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-2 text-sm">Realizar vendas e conversões</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-2 text-sm">Resolver problemas e reclamações</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-2 text-sm">Agendar consultas/reuniões</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-2 text-sm">Coletar leads e informações de contato</span>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Regras de Conversação</label>
                    <textarea rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Ex: Sempre pergunte o nome do cliente no início, não faça pressão de venda, seja educado, etc."></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Limites e Restrições</label>
                    <textarea rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Ex: Não discutir preços confidenciais, não aceitar trocas sem aprovação, etc."></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Quando Transferir para Humano</label>
                        <select multiple class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="complexo">Situações complexas</option>
                            <option value="reclamacao">Reclamações sérias</option>
                            <option value="tecnico">Problemas técnicos</option>
                            <option value="financeiro">Questões financeiras</option>
                            <option value="manual">Cliente solicita</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Horário de Funcionamento</label>
                        <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="24h">24 horas por dia</option>
                            <option value="comercial">Horário comercial</option>
                            <option value="customizado">Personalizado</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Etapa 4: Integrações -->
        <div class="bg-white rounded-lg shadow p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-6">4. Integrações (Opcional)</h2>

            <div class="space-y-4">
                <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-3">
                            <span class="text-lg">🛒</span>
                        </div>
                        <div>
                            <h3 class="font-medium text-gray-900">E-commerce</h3>
                            <p class="text-sm text-gray-600">Integre com sua loja virtual para informações de produtos e pedidos</p>
                        </div>
                    </div>
                    <label class="flex items-center">
                        <input type="checkbox" class="rounded border-gray-300 text-green-600 focus:ring-green-500">
                        <span class="ml-2 text-sm font-medium text-gray-700">Conectar</span>
                    </label>
                </div>

                <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-3">
                            <span class="text-lg">📅</span>
                        </div>
                        <div>
                            <h3 class="font-medium text-gray-900">Sistema de Agendamento</h3>
                            <p class="text-sm text-gray-600">Permita agendamentos diretos através do WhatsApp</p>
                        </div>
                    </div>
                    <label class="flex items-center">
                        <input type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                        <span class="ml-2 text-sm font-medium text-gray-700">Conectar</span>
                    </label>
                </div>

                <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                    <div class="flex items-center">
                        <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center mr-3">
                            <span class="text-lg">💳</span>
                        </div>
                        <div>
                            <h3 class="font-medium text-gray-900">Gateway de Pagamento</h3>
                            <p class="text-sm text-gray-600">Processamento de pagamentos diretamente no chat</p>
                        </div>
                    </div>
                    <label class="flex items-center">
                        <input type="checkbox" class="rounded border-gray-300 text-purple-600 focus:ring-purple-500">
                        <span class="ml-2 text-sm font-medium text-gray-700">Conectar</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Ações -->
        <div class="flex justify-between items-center bg-white rounded-lg shadow p-6">
            <button type="button" class="text-gray-600 hover:text-gray-800 font-medium">
                Salvar como Rascunho
            </button>
            <div class="flex space-x-4">
                <button type="button" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors font-medium">
                    Testar Atendente
                </button>
                <button type="submit" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
                    Criar Atendente
                </button>
            </div>
        </div>
    </form>
</ClientLayout>