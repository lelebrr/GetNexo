---
import Layout from '../layouts/Layout.astro';

import ROICalculator from '../components/ROICalculator.astro';
import Testimonials from '../components/Testimonials.astro';
import TourGuided from '../components/TourGuided.astro';
import { verificaDataVariavel } from '../lib/feriados.js';
import '../styles/index-premium.css';

// New Components
import HomeHero from '../components/home/HomeHero.astro';
import HomeFeatures from '../components/home/HomeFeatures.astro';
import HomeMetrics from '../components/home/HomeMetrics.astro';
import HomeGiantFeatures from '../components/home/HomeGiantFeatures.astro';
import HomeSecurity from '../components/home/HomeSecurity.astro';
import HomeSchema from '../components/seo/HomeSchema.astro';

// Modals
import DemoModal from '../components/modals/DemoModal.astro';
import ChatModal from '../components/modals/ChatModal.astro';
import InteractiveModal from '../components/modals/InteractiveModal.astro';

const title = "Chatbot WhatsApp IA para Vendas 24h | API Oficial Meta | GetNexo";
const description = "Automatize suas vendas no WhatsApp com Inteligência Artificial Generativa. API Oficial Meta, PIX nativo, CRM inteligente e Analytics. Aumente sua conversão em até 10x sem mensalidades fixas.";
const keywords = "chatbot whatsapp vendas, ia para whatsapp, automação whatsapp vendas, api oficial whatsapp business, chatbot com pix, crm para whatsapp, inteligência artificial vendedora, chatbot whatsapp grátis, recuperar carrinho abandonado whatsapp, chatbot auto-hospedado";

const lang = 'pt';
const { default: t } = await import(`../i18n/pt.json`);

// Sistema de Feriados Festivos
const feriadosData = await fetch('/data/feriados.json').then(r => r.json()).catch(() => ({ feriados: [] }));
const hoje = new Date().toISOString().slice(0,10);
const idiomaNavegador = typeof navigator !== 'undefined' ? (navigator.language || 'pt-BR') : 'pt-BR';
const idiomaCurto = idiomaNavegador.split('-')[0];

const feriadoHoje = feriadosData.feriados.find(f => {
  if (f.data === hoje) return true;
  const anoAtual = new Date().getFullYear();
  const dataCalculada = verificaDataVariavel(f.data, anoAtual);
  return dataCalculada === hoje;
});

const nonce = Astro.locals.nonce;
---

<Layout title={title} description={description} keywords={keywords} isLanding={true}>
  
  <!-- Importar CSS de efeitos festivos se houver feriado hoje -->
  {feriadoHoje && (
    <link rel="stylesheet" href="/custom/css/holiday-effects.css" is:inline />
  )}
  
  <!-- Aplicar efeito visual ao body se houver feriado hoje -->
  {feriadoHoje && (
    <script is:inline nonce={nonce} define:vars={{ efeito: feriadoHoje.efeito }}>
      document.body.classList.add(efeito);
    </script>
  )}
  
  <HomeSchema />
  
  <HomeHero feriadoHoje={feriadoHoje} lang={lang} idiomaCurto={idiomaCurto} />

  <!-- Tour Guided Component -->
  <TourGuided slot="dock-left" targetPage="home" mobileOptimized={true} nonce={nonce} />

  <HomeFeatures />

  <HomeMetrics />

  <!-- Testimonials Section -->
  <Testimonials />

  <!-- ROI Calculator Section -->
  <ROICalculator />

  <HomeGiantFeatures t={t} />

  <HomeSecurity lang={lang} />

  <!-- CTA Final (antes do footer) -->
  <section class="py-20 bg-gradient-to-b from-gray-950 to-black">
    <div class="text-center">
      <h2 class="text-4xl font-black mb-6 text-white">
        Pronto pra <span class="text-cyan-400">multiplicar suas vendas no WhatsApp</span>?
      </h2>
      <a href="/ativar" class="inline-block px-12 py-6 text-black font-bold text-2xl rounded-full 
        bg-gradient-to-r from-green-400 to-cyan-500 
        hover:from-green-300 hover:to-cyan-400 
        shadow-2xl shadow-cyan-500/50 transform hover:scale-105 transition-all duration-300">
        Liberar Meu Bot GRÁTIS (7 Dias Sem Cartão)
      </a>
    </div>
  </section>

  <!-- Modals -->
  <DemoModal />
  <ChatModal />
  <InteractiveModal />

  <!-- Modals & Scripts -->
  <script is:inline nonce={nonce} src="/custom/js/hero-animations.js"></script>
  <script is:inline nonce={nonce} src="/custom/js/mega-chat-sim.js"></script>
  <script is:inline nonce={nonce} src="/custom/js/modals-demo.js"></script>
  <script is:inline nonce={nonce} src="/custom/js/click-fireworks.js"></script>

</Layout>
