---
import Layout from '../layouts/Layout.astro';
import VideoDemo from '../components/VideoDemo.astro';
import ROICalculator from '../components/ROICalculator.astro';
import Testimonials from '../components/Testimonials.astro';
import TourGuided from '../components/TourGuided.astro';
const title = "Chatbot WhatsApp IA Self-Hosted – Fecha Venda Sozinho | GetNexo";
const description = "Automação 24h no seu domínio. Sem taxa por mensagem. Integra estoque, frete, PIX. Teste grátis 7 dias. API Oficial Meta + AR + 360°.";
const keywords = "chatbot whatsapp, ia vendas, automação self hosted, pix no zap, ar produto, giro 360, whatsapp business api oficial, ia para vendas whatsapp, chatbot whatsapp grátis, automação whatsapp vendas, recuperar carrinho abandonado whatsapp, pix no whatsapp automatico";

const lang = 'pt';
const { default: t } = await import(`../i18n/pt.json`);

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://getnexo.com.br/#organization",
      "name": "GetNexo",
      "url": "https://getnexo.com.br",
      "logo": "https://getnexo.com.br/logo.svg",
      "description": "Plataforma de IA para vendas no WhatsApp 24h por dia. API Oficial Meta, PIX automático, CRM integrado.",
      "foundingDate": "2024",
      "sameAs": [
        "https://linkedin.com/company/getnexo",
        "https://instagram.com/getnexo",
        "https://github.com/lelebrr",
        "https://youtube.com/@getnexo",
        "https://tiktok.com/@getnexo"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+55-11-4003-XXXX",
        "contactType": "customer service",
        "availableLanguage": ["Portuguese", "English", "Spanish", "French"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://getnexo.com.br/#website",
      "url": "https://getnexo.com.br",
      "name": "GetNexo - IA para Vendas WhatsApp",
      "description": "IA que fecha vendas no WhatsApp 24h. Plataforma completa com API Oficial Meta, PIX, CRM, fidelidade e analytics.",
      "publisher": { "@id": "https://getnexo.com.br/#organization" },
      "inLanguage": "pt-BR",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://getnexo.com.br/buscar?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://getnexo.com.br/#software",
      "name": "GetNexo",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, WhatsApp",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "BRL",
        "priceValidUntil": "2026-12-31",
        "description": "Plano gratuito com funcionalidades avançadas"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "500",
        "bestRating": "5",
        "worstRating": "1"
      },
      "author": { "@id": "https://getnexo.com.br/#organization" }
    },
    {
      "@type": "Service",
      "@id": "https://getnexo.com.br/#service",
      "name": "Automação de Vendas WhatsApp com IA",
      "description": "Serviço completo de automação de vendas via WhatsApp com inteligência artificial avançada",
      "provider": { "@id": "https://getnexo.com.br/#organization" },
      "serviceType": "Business Automation",
      "areaServed": "Worldwide",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Planos GetNexo",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Plano Gratuito",
              "description": "Acesso completo às funcionalidades básicas"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Plano Pro",
              "description": "Recursos avançados e suporte prioritário"
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que é o GetNexo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GetNexo é uma plataforma de IA que automatiza vendas no WhatsApp 24 horas por dia. Usa API Oficial Meta, PIX automático, CRM integrado e muito mais."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona a IA para vendas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nossa IA é treinada com seu catálogo de produtos e histórico de vendas. Ela conversa naturalmente com clientes, tira dúvidas, sugere produtos e fecha vendas automaticamente."
          }
        },
        {
          "@type": "Question",
          "name": "O GetNexo tem PIX integrado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! Temos PIX nativo. O bot gera QR Code ou código copia e cola automaticamente e confirma pagamentos em tempo real na conversa."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto custa usar o GetNexo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O plano básico é 100% GRÁTIS! Você só paga uma pequena taxa por transação realizada. Sem mensalidades fixas ou contratos longos."
          }
        },
        {
          "@type": "Question",
          "name": "Quais integrações estão disponíveis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Integramos com Shopify, WooCommerce, VTEX, Bling, Tiny, PagSeguro, Mercado Pago, Correios, Melhor Envio e muito mais. API REST completa disponível."
          }
        },
        {
          "@type": "Question",
          "name": "O GetNexo funciona com API Oficial do WhatsApp?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! Somos 100% compatíveis com a API Oficial da Meta via Evolution API. Zero risco de banimento, máxima segurança e conformidade."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto tempo leva para configurar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Setup completo em até 12 minutos! Nossa plataforma é self-hosted, você instala em seu servidor e começa a vender imediatamente."
          }
        },
        {
          "@type": "Question",
          "name": "Tem sistema de fidelidade integrado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! Sistema completo de pontos, tiers, recompensas e gamificação. Seus clientes acumulam pontos automaticamente e resgatam prêmios via WhatsApp."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "Como configurar GetNexo em 5 passos",
      "description": "Guia passo a passo para configurar sua IA de vendas no WhatsApp",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Instalação",
          "text": "Instale a plataforma em seu servidor (Docker ou manual)"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Conectar WhatsApp",
          "text": "Configure a API Oficial do WhatsApp Business"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Configurar Catálogo",
          "text": "Importe seus produtos e configure preços"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Treinar IA",
          "text": "Configure as respostas e comportamento da IA"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Ativar Vendas",
          "text": "Configure PIX, CRM e analytics. Pronto para vender!"
        }
      ]
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords} isLanding={true}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(homeSchema)}></script>
  
  <!-- Modern Hero with 3D Phone Simulation -->
  <section class="hero-split">
    <div class="hero-content">
      <div class="hero-badge reveal">🚀 TRANSFORME SEU WHATSAPP EM UMA MÁQUINA DE VENDAS AUTOMATIZADA</div>
      <h1 class="hero-title reveal" set:html={'<span class="text-gradient">IA INTELIGENTE</span> VENDE 24H/DIA SEM PRECISAR DE ATENDENTES'}</h1>
      <p class="hero-subtitle reveal">
        ⚡ API Oficial Meta + PIX Nativo + CRM IA + Analytics Avançado<br>
        ✅ Setup em 12 minutos | ✅ Zero Mensalidades | ✅ Suporte Técnico Especializado
      </p>
      <div class="hero-ctas reveal">
        <a href={`/${lang}/criar-bot`} class="btn-primary-glow">COMEÇAR AGORA GRÁTIS</a>
        <button onclick="abrirModalDemo()" class="btn-outline">VER DEMONSTRAÇÃO IA →</button>
      </div>
      <div class="hero-trust reveal">
        <span>✅ API Oficial Meta</span>
        <span>✅ Setup em 12min</span>
        <span>✅ Zero Mensalidade</span>
      </div>
    </div>

    <div class="hero-visual reveal">
        <div class="hologram-container">
            <div class="hologram-core">
                <div class="hologram-ring ring-1"></div>
                <div class="hologram-ring ring-2"></div>
                <div class="hologram-ring ring-3"></div>
                <div class="ara-avatar">✨</div>
                <div class="hologram-shards">
                    <span></span><span></span><span></span><span></span>
                </div>
            </div>
            <div class="hologram-base"></div>
            <div class="hologram-glow"></div>

            <!-- Floating Mini Chat UI next to Hologram -->
            <div class="floating-chat glass-panel">
                <div class="chat-header-mini">Nexus IA</div>
                <div class="chat-body-mini" id="hero-chat"></div>
            </div>
        </div>
    </div>
  </section>

  <!-- Tour Guided Component -->
  <TourGuided targetPage="home" mobileOptimized={true} client:load />

  <!-- Value Propositions Grid -->
    <div class="section-header reveal">
        <h2 class="text-gradient">A Infraestrutura Definitiva para Escalar suas Vendas</h2>
        <p>A única plataforma que combina IA Generativa, PIX Nativo e Automação Oficial Meta para transformar seu Chat em uma máquina de lucro 24h por dia.</p>
    </div>
    
    <div class="grid-cards">
      <div class="glass-panel p-card reveal">
        <div class="p-icon">🤖</div>
        <h3>IA Generativa de Vendas</h3>
        <p>Agente virtual treinado com seu catálogo que converte leads em lucro 24/7 de forma humanizada.</p>
        <a href="/produtos/automacao" class="p-link">Explorar IA →</a>
      </div>
      <div class="glass-panel p-card reveal">
        <div class="p-icon">💰</div>
        <h3>Checkout & PIX Nativo</h3>
        <p>Experiência de compra fluida com geração de PIX e confirmação automática sem sair do chat.</p>
        <a href="/produtos/vendas" class="p-link">Ver Checkout →</a>
      </div>
      <div class="glass-panel p-card reveal">
        <div class="p-icon">🚀</div>
        <h3>Broadcast & Ads de Alta Performance</h3>
        <p>Envios em massa inteligentes e Click-to-WhatsApp Ads com mensuração de ROI em tempo real.</p>
        <a href="/produtos/marketing" class="p-link">Ativar Ads →</a>
      </div>
      <div class="glass-panel p-card reveal">
        <div class="p-icon">👥</div>
        <h3>Pipeline & CRM Estratégico</h3>
        <p>Visão 360º do seu funil com gestão multi-agente e automação inteligente de follow-up.</p>
        <a href="/produtos/crm" class="p-link">Gerir Leads →</a>
      </div>
    </div>
  </section>

  <!-- Performance Metrics -->
  <section class="metrics-section glass-panel reveal">
    <div class="metric-item">
        <span class="m-val">10x</span>
        <span class="m-label">Mais Conversão</span>
    </div>
    <div class="metric-divider"></div>
    <div class="metric-item">
        <span class="m-val">24/7</span>
        <span class="m-label">Disponibilidade</span>
    </div>
    <div class="metric-divider"></div>
    <div class="metric-item">
        <span class="m-val">R$ 0</span>
        <span class="m-label">Mensalidade Fixa</span>
    </div>
  </section>
  
  <!-- Giant Features Showcase -->
  <section class="giant-features">
    <!-- Magic Replies -->
    <div class="giant-feature-row reveal">
        <div class="giant-feature-visual">
            <img src="/assets/features/magic-replies.png" alt="Magic Replies AI" class="premium-visual" />
        </div>
        <div class="giant-feature-info">
            <div class="feature-tag">Exclusivo</div>
            <h2 class="text-gradient">{t.features_giant.magic_replies.title}</h2>
            <p>{t.features_giant.magic_replies.description}</p>
            <ul class="feature-bullets">
                <li><span>✨</span> {t.features_giant.magic_replies.f1}</li>
                <li><span>🧠</span> {t.features_giant.magic_replies.f2}</li>
                <li><span>📈</span> {t.features_giant.magic_replies.f3}</li>
            </ul>
            <a href="/produtos/automacao" class="btn-outline-glow">Conhecer Magic Replies</a>
        </div>
    </div>

    <!-- Loyalty System -->
    <div class="giant-feature-row reverse reveal">
        <div class="giant-feature-info">
            <div class="feature-tag gold">Retenção</div>
            <h2 class="text-gradient">{t.features_giant.loyalty.title}</h2>
            <p>{t.features_giant.loyalty.description}</p>
            <ul class="feature-bullets">
                <li><span>🏆</span> {t.features_giant.loyalty.f1}</li>
                <li><span>🎁</span> {t.features_giant.loyalty.f2}</li>
                <li><span>❤️</span> {t.features_giant.loyalty.f3}</li>
            </ul>
            <a href="/produtos/fidelidade" class="btn-outline-glow">Ver Fidelidade</a>
        </div>
        <div class="giant-feature-visual">
            <img src="/assets/features/loyalty.png" alt="Loyalty System" class="premium-visual" />
        </div>
    </div>

    <!-- Analytics -->
    <div class="giant-feature-row reveal">
        <div class="giant-feature-visual">
            <img src="/assets/features/analytics.png" alt="Advanced Analytics" class="premium-visual" />
        </div>
        <div class="giant-feature-info">
            <div class="feature-tag blue">Inteligência</div>
            <h2 class="text-gradient">{t.features_giant.analytics.title}</h2>
            <p>{t.features_giant.analytics.description}</p>
            <ul class="feature-bullets">
                <li><span>📊</span> {t.features_giant.analytics.f1}</li>
                <li><span>📝</span> {t.features_giant.analytics.f2}</li>
                <li><span>🌍</span> {t.features_giant.analytics.f3}</li>
            </ul>
            <a href="/produtos/analytics" class="btn-outline-glow">Explorar Dados</a>
        </div>
    </div>

    <!-- Integrations -->
    <div class="giant-feature-row reverse reveal">
        <div class="giant-feature-info">
            <div class="feature-tag green">Ecossistema</div>
            <h2 class="text-gradient">{t.features_giant.integrations.title}</h2>
            <p>{t.features_giant.integrations.description}</p>
            <ul class="feature-bullets">
                <li><span>🔗</span> {t.features_giant.integrations.f1}</li>
                <li><span>⚙️</span> {t.features_giant.integrations.f2}</li>
                <li><span>📡</span> {t.features_giant.integrations.f3}</li>
            </ul>
            <a href="/integracoes" class="btn-outline-glow">Ver Todas as Integrações</a>
        </div>
        <div class="giant-feature-visual">
            <img src="/assets/features/integrations.png" alt="Integrations Map" class="premium-visual" />
        </div>
    </div>
  </section>

  <!-- Security Section -->
  <section class="security-section">
    <div class="section-header reveal">
        <h2 class="text-gradient">🛡️ Segurança Máxima no GetNexo</h2>
        <p>Proteja Sua Loja e Seus Clientes com Confiança Total</p>
    </div>

    <div class="security-grid reveal">
      <div class="security-card glass-panel">
        <div class="security-icon">🛡️</div>
        <h3>Cloudflare Shield</h3>
        <p>Proteção contra DDoS, Firewall Avançado (WAF) e Gerenciamento de Bots. Sua loja protegida como as maiores do mundo.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">🔐</div>
        <h3>AES Encryption</h3>
        <p>Criptografia LGPD-compliant com AES-256. Conformidade 100% LGPD. Zero armazenamento desnecessário.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">🚪</div>
        <h3>Zero Trust Network</h3>
        <p>Cloudflare Tunnel com Zero Trust. Nenhuma porta aberta no servidor. Conexão outbound apenas.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">⏰</div>
        <h3>24h Monitoring</h3>
        <p>Rate Limiting inteligente, detecção de ameaças em tempo real e backups seguros automatizados.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">💳</div>
        <h3>Secure PIX</h3>
        <p>Integração direta com gateways confiáveis. QR Code validado e criptografado em tempo real.</p>
      </div>

      <div class="security-card glass-panel">
        <div class="security-icon">✅</div>
        <h3>99.99% Uptime</h3>
        <p>Sua loja nunca fica offline. Sem histórico de breaches. Atualizações automáticas.</p>
      </div>
    </div>

    <div class="security-cta reveal">
        <p class="security-notice">💡 Segurança WhatsApp Business não é luxo — é necessidade.</p>
        <p class="security-benefit">Com o GetNexo, você tem proteção de nível enterprise sem complicação ou custo absurdo.</p>
        <div class="security-actions">
            <a href="/criar-bot" class="btn-primary-glow security-btn">Teste Grátis Agora →</a>
            <button onclick="abrirModalDemo()" class="btn-outline security-btn">Ver Certificações</button>
        </div>
        <p class="security-footer">© 2026 GetNexo. Todos os direitos reservados. | GetNexo: A vanguarda em Automação WhatsApp e IA para Negócios.</p>
    </div>
  </section>

  <!-- Final Squeeze -->
  <section class="final-cta reveal">
    <div class="glass-panel cta-box">
        <h2 class="text-gradient">Pronto para transformar seu Chat em uma Máquina de Vendas?</h2>
        <p>Domine o WhatsApp com a infraestrutura mais robusta do mercado. Ative sua IA em menos de 10 minutos.</p>
        <div class="cta-actions">
            <a href="/criar-bot" class="btn-primary-glow">Criar Conta Grátis</a>
            <a href="/precos" class="btn-outline">Ver Planos Pro</a>
        </div>
    </div>
  </section>



<!-- Modal Demo IA -->
<div id="demo-modal" class="fixed inset-0 hidden z-[9999]" style="background: rgba(0,0,0,0.9); backdrop-filter: blur(8px);">
  <div class="modal-wrapper flex items-center justify-center min-h-screen p-4">
    <div class="bg-void-black border-2 border-neon-blue rounded-3xl p-8 w-full max-w-2xl shadow-[0_0_50px_rgba(0,247,255,0.3)] relative">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h3 class="text-2xl text-cyber-gold font-jetbrains mb-2">Escolha sua Demo IA</h3>
        <p class="text-gray-300">Veja como o GetNexo funciona em diferentes plataformas</p>
      </div>
      <button onclick="fecharModalDemo()" class="text-neon-blue hover:text-white transition-colors p-2" style="font-size: 2.5rem; line-height: 1;">&times;</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Chat Completo -->
      <div class="demo-option bg-matrix-black/50 border border-matrix-green/30 rounded-xl p-6 hover:bg-matrix-green/10 transition-all cursor-pointer"
           onclick="abrirModalChat()">
        <div class="flex items-center space-x-4 mb-4">
          <div class="w-12 h-12 bg-matrix-green/20 rounded-full flex items-center justify-center">
            <span class="text-2xl">💬</span>
          </div>
          <div>
            <h4 class="text-xl text-matrix-green font-medium">Chat Completo</h4>
            <p class="text-gray-400 text-sm">IA responde e fala sozinha</p>
          </div>
        </div>
        <div class="space-y-2 text-xs text-gray-400">
          <div class="flex items-center">
            <span class="text-matrix-green mr-2">✓</span>
            <span>IA responde automaticamente</span>
          </div>
          <div class="flex items-center">
            <span class="text-matrix-green mr-2">✓</span>
            <span>Voz e síntese de fala</span>
          </div>
          <div class="flex items-center">
            <span class="text-matrix-green mr-2">✓</span>
            <span>Cards interativos dinâmicos</span>
          </div>
        </div>
      </div>

      <!-- Demo IA Interativa -->
      <div class="demo-option bg-matrix-black/50 border border-cyber-gold/30 rounded-xl p-6 hover:bg-cyber-gold/10 transition-all cursor-pointer"
           onclick="abrirModalIA()">
        <div class="flex items-center space-x-4 mb-4">
          <div class="w-12 h-12 bg-cyber-gold/20 rounded-full flex items-center justify-center">
            <span class="text-2xl">🤖</span>
          </div>
          <div>
            <h4 class="text-xl text-cyber-gold font-medium">Demo IA Interativa</h4>
            <p class="text-gray-400 text-sm">Busca inteligente + multimídia</p>
          </div>
        </div>
        <div class="space-y-2 text-xs text-gray-400">
          <div class="flex items-center">
            <span class="text-cyber-gold mr-2">✓</span>
            <span>Busca inteligente por voz</span>
          </div>
          <div class="flex items-center">
            <span class="text-cyber-gold mr-2">✓</span>
            <span>Vídeos, áudios e 360°</span>
          </div>
          <div class="flex items-center">
            <span class="text-cyber-gold mr-2">✓</span>
            <span>Catalogo JSON integrado</span>
          </div>
        </div>
      </div>

      <!-- Demo WhatsApp -->
      <div class="demo-option bg-matrix-black/50 border border-cyber-gold/30 rounded-xl p-6 hover:bg-cyber-gold/10 transition-all cursor-pointer"
           onclick="window.open('https://wa.me/5511999999999?text=Oi%2C+quero+ver+a+demo+IA+do+GetNexo', '_blank')">
        <div class="flex items-center space-x-4 mb-4">
          <div class="w-12 h-12 bg-cyber-gold/20 rounded-full flex items-center justify-center">
            <span class="text-2xl">💬</span>
          </div>
          <div>
            <h4 class="text-xl text-cyber-gold font-medium">Demo no WhatsApp</h4>
            <p class="text-gray-400 text-sm">Experiência real no WhatsApp</p>
          </div>
        </div>
        <div class="space-y-2 text-xs text-gray-400">
          <div class="flex items-center">
