---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';

const title = "Depoimentos Reais – Quem já lucrou com GetNexo";
const description = "Descubra como empresas de diversos nichos estão economizando milhares de reais e escalando suas vendas com o GetNexo.";

// We'll use the Testimonials component but in a page layout
---

<Layout title={title} description={description}>
  <div class="depoimentos-page">
    <section class="page-hero">
      <div class="content-container">
        <span class="badge">Cases de Sucesso</span>
        <h1 class="text-gradient">Quem Ganha com GetNexo</h1>
        <p>Resultados reais de empresas que automatizaram suas vendas e escalaram seus lucros usando nossa tecnologia.</p>
      </div>
    </section>

    <!-- We use the component here with showTitle=false to avoid duplication -->
    <Testimonials showTitle={false} maxItems={20} />

    <section class="trust-cta">
      <div class="cta-inner glass-panel">
        <h2>Seu resultado é o nosso próximo case.</h2>
        <p>Junte-se a centenas de empresas que já estão dominando as vendas no WhatsApp.</p>
        <div class="cta-buttons">
          <a href="/começar" class="btn-primary">Escalar Meu Negócio Agora</a>
          <a href="/contato" class="btn-secondary">Falar com Especialista</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .depoimentos-page {
    background: #020617;
    min-height: 100vh;
    padding-top: 80px;
  }

  .page-hero {
    padding: 8rem 5% 4rem;
    text-align: center;
    position: relative;
  }

  .content-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.2);
    color: #22d3ee;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 100px;
    margin-bottom: 2rem;
  }

  .page-hero h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 950;
    line-height: 0.9;
    letter-spacing: -3px;
    margin-bottom: 2rem;
  }

  .page-hero p {
    font-size: 1.25rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .trust-cta {
    padding: 8rem 5%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .cta-inner {
    padding: 6rem 4rem;
    text-align: center;
    border-radius: 4rem;
    background: radial-gradient(circle at top right, rgba(34, 211, 238, 0.1), transparent);
  }

  .cta-inner h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    color: white;
    margin-bottom: 1.5rem;
    letter-spacing: -1px;
  }

  .cta-inner p {
    font-size: 1.25rem;
    color: #94a3b8;
    margin-bottom: 3rem;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: linear-gradient(135deg, #22d3ee, #10b981);
    color: #020617;
    padding: 1.25rem 2.5rem;
    border-radius: 1rem;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(34, 211, 238, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(34, 211, 238, 0.5);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: white;
    padding: 1.25rem 2.5rem;
    border-radius: 1rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
  }

  @media (max-width: 768px) {
    .page-hero { padding: 4rem 5% 2rem; }
    .cta-inner { padding: 4rem 2rem; border-radius: 2.5rem; }
    .btn-primary, .btn-secondary { width: 100%; text-align: center; }
  }
</style>
