---
import Layout from '../layouts/Layout.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

const relatedArticles = [
  {
    slug: "analise-sentimento-retencao",
    title: "Análise de Sentimento: O Coração da Retenção",
    category: "Customer Experience",
    excerpt: "Entenda como o cliente se sente em tempo real e antecipe o churn com precisão."
  },
  {
    slug: "guia-ia-atendimento-2026",
    title: "IA no Atendimento: O Guia Definitivo 2026",
    category: "Inteligência Artificial",
    excerpt: "Como a IA Generativa está redefinindo a lealdade do cliente."
  },
  {
    slug: "crm-futuro-gpt4",
    title: "O CRM Inteligente: A Era do GPT-4",
    category: "CRM & IA",
    excerpt: "Qualificação automática de leads e insights preditivos integrados."
  }
];

<Layout title={title} description={description} keywords={keywords}>
  <!-- Schema.org Rich Snippets para Análise de Sentimento -->
  <script type="application/ld+json" >
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Análise de Sentimento em Tempo Real GetNexo",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Sistema avançado de análise de sentimento com IA que detecta emoções, satisfação e intenção em tempo real durante conversas, classificando automaticamente humor, tom de voz e urgência.",
      "offers": {
        "@type": "Offer",
        "price": "187",
        "priceCurrency": "BRL",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "GetNexo"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "1,647"
      },
      "featureList": [
        "Análise de Sentimento em Tempo Real",
        "Detecção de Emoções Avançada",
        "Classificação Automática de Humor",
        "Tom de Voz e Urgência",
        "Integração Enterprise",
        "Precisão 94% de Acurácia"
      ]
    }
  </script>

  <!-- Hero Section Análise de Sentimento -->
  <section class="hero-sentiment-analysis">
    <div class="hero-content">
      <div class="hero-badges">
        <span class="hero-badge realtime">⚡ Tempo Real</span>
        <span class="hero-badge emotion">😊 Detecção Emoções</span>
        <span class="hero-badge accuracy">🎯 94% Precisão</span>
        <span class="hero-badge context">🧠 Contexto-aware</span>
      </div>

      <h1>Análise de Sentimento em Tempo Real: IA que Entende como Seus Clientes se Sentem</h1>

      <h2>Sistema inteligente que detecta emoções, satisfação e intenção em tempo real durante conversas, classificando automaticamente humor, tom de voz e urgência</h2>

      <p>Enquanto o cliente digita, nossa IA analisa cada palavra, emoji, pontuação e contexto para entender exatamente como ele se sente. Não é só positivo/neutro/negativo - é uma análise profunda de emoções que guia suas respostas e decisões de negócio em tempo real.</p>

      <div class="hero-metrics">
        <div class="metric">
          <div class="metric-number">94<span>%</span></div>
          <div class="metric-label">Precisão Detecção</div>
          <div class="metric-subtext">Emoções complexas</div>
        </div>
        <div class="metric">
          <div class="metric-number">0.3<span>s</span></div>
          <div class="metric-label">Tempo Análise</div>
          <div class="metric-subtext">Por mensagem</div>
        </div>
        <div class="metric">
          <div class="metric-number">12</div>
          <div class="metric-label">Emoções Detectadas</div>
          <div class="metric-subtext">Alegría, raiva, frustração, urgência...</div>
        </div>
        <div class="metric">
          <div class="metric-number">ROI 380<span>%</span></div>
          <div class="metric-label">Retorno Investimento</div>
          <div class="metric-subtext">Payback em 30 dias</div>
        </div>
      </div>

      <div class="hero-emotion-showcase">
        <div class="emotion-card">
          <div class="emotion-icon">😠</div>
          <h4>Frustração Detectada</h4>
          <p>"Já liguei 3 vezes e ninguém resolve! Isso é um absurdo!" → IA identifica raiva + urgência crítica</p>
        </div>
        <div class="emotion-card">
          <div class="emotion-icon">😊</div>
          <h4>Satisfação Reconhecida</h4>
          <p>"Obrigado pelo atendimento excelente! Muito satisfeito 😊" → IA confirma satisfação + indicação positiva</p>
        </div>
        <div class="emotion-card">
          <div class="emotion-icon">🤔</div>
          <h4>Dúvida Identificada</h4>
          <p>"Será que vale a pena comprar agora ou espero promoção?" → IA detecta indecisão + oportunidade de venda</p>
        </div>
        <div class="emotion-card">
          <div class="emotion-icon">🚨</div>
          <h4>Urgência Crítica</h4>
          <p>"PRECISO do produto HOJE! É uma emergência!" → IA prioriza resposta imediata + escalation</p>
        </div>
      </div>

      <div class="hero-ctas">
        <a href="/criar-analise-sentimento" class="btn-primary-giant">
          <span class="btn-icon">🧠</span>
          Análise de Sentimento IA - 15 Dias Grátis
        </a>
        <a href="#demo-sentiment" class="btn-secondary-giant">
          <span class="btn-icon">👁️</span>
          Ver Detecção em Tempo Real
        </a>
        <a href="#comparativo" class="btn-outline-giant">
          <span class="btn-icon">⚖️</span>
          Vs Análises Básicas
        </a>
      </div>

      <div class="hero-trust-indicators">
        <div class="trust-logos">
          <img src="/assets/trust/nlp-certified.svg" alt="Natural Language Processing Certified" loading="lazy" />
          <img src="/assets/trust/emotion-ai.svg" alt="Emotion AI Technology" loading="lazy" />
          <img src="/assets/trust/context-aware.svg" alt="Context-Aware Analysis" loading="lazy" />
          <img src="/assets/trust/realtime-processing.svg" alt="Real-time Processing" loading="lazy" />
        </div>
        <p class="trust-text">NLP Avançado • IA Emocional • Processamento Context-Aware • Análise em Tempo Real</p>
      </div>
    </div>

    <div class="hero-demo-sentiment">
      <div class="sentiment-demo-container">
        <div class="demo-header">
          <h3>🧠 Detecção de Sentimento em Tempo Real</h3>
          <p>Acompanhe como a IA analisa emoções enquanto o cliente digita</p>
        </div>

        <div class="sentiment-live-analysis">
          <div class="analysis-interface">
            <div class="customer-message">
              <div class="message-header">
                <span class="customer-name">Maria Silva</span>
                <span class="message-time">Agora</span>
              </div>
              <div class="message-content">
                <p>Olá! Comprei o produto X ontem e já estou tendo problemas. Muito frustrada com essa situação! 😠</p>
              </div>
            </div>

            <div class="sentiment-analysis-results">
              <div class="analysis-header">
                <h4>🤖 Análise de Sentimento IA - Tempo Real</h4>
                <div class="analysis-confidence">Confiança: 97%</div>
              </div>

              <div class="primary-emotion">
                <div class="emotion-indicator frustrated">
                  <div class="emotion-icon">😠</div>
                  <div class="emotion-details">
                    <div class="emotion-name">Frustração Alta</div>
                    <div class="emotion-intensity">Intensidade: 8.7/10</div>
                    <div class="emotion-description">Cliente extremamente insatisfeita</div>
                  </div>
                </div>
              </div>

              <div class="secondary-emotions">
                <div class="emotion-breakdown">
                  <div class="emotion-item">
                    <span class="emotion-label">Raiva:</span>
                    <span class="emotion-value">7.2/10</span>
                    <div class="emotion-bar">
                      <div class="emotion-fill" style="width: 72%"></div>
                    </div>
                  </div>
                  <div class="emotion-item">
                    <span class="emotion-label">Decepção:</span>
                    <span class="emotion-value">6.8/10</span>
                    <div class="emotion-bar">
                      <div class="emotion-fill" style="width: 68%"></div>
                    </div>
                  </div>
                  <div class="emotion-item">
                    <span class="emotion-label">Urgência:</span>
                    <span class="emotion-value">8.1/10</span>
                    <div class="emotion-bar">
                      <div class="emotion-fill" style="width: 81%"></div>
                    </div>
                  </div>
                  <div class="emotion-item">
                    <span class="emotion-label">Insatisfação:</span>
                    <span class="emotion-value">9.2/10</span>
                    <div class="emotion-bar">
                      <div class="emotion-fill" style="width: 92%"></div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="contextual-insights">
                <h4>💡 Insights Contextuais</h4>
                <div class="insights-list">
                  <div class="insight">🎯 Problema recente: Compra ontem, problema já apareceu</div>
                  <div class="insight">⚠️ Risco de churn: Cliente pode cancelar pedido</div>
                  <div class="insight">🚨 Prioridade alta: Necessita resposta urgente</div>
                  <div class="insight">💰 Oportunidade: Resolver pode virar review positiva</div>
                  <div class="insight">📞 Canal ideal: Ligação para resolução emocional</div>
                </div>
              </div>

              <div class="recommended-actions">
                <h4>🎯 Ações Recomendadas</h4>
                <div class="actions-list">
                  <div class="action critical">
                    <span class="action-icon">🚨</span>
                    <span>Escalar para supervisor sênior</span>
                  </div>
                  <div class="action urgent">
                    <span class="action-icon">📞</span>
                    <span>Ligar em até 5 minutos</span>
                  </div>
                  <div class="action recovery">
                    <span class="action-icon">🎁</span>
                    <span>Oferecer compensação imediata</span>
                  </div>
                  <div class="action follow">
                    <span class="action-icon">📝</span>
                    <span>Follow-up em 24h após resolução</span>
                  </div>
                </div>
              </div>

              <div class="sentiment-prediction">
                <h4>🔮 Predição de Evolução</h4>
                <div class="prediction-timeline">
                  <div class="prediction-step immediate">
                    <span class="time">Agora</span>
                    <span class="prediction">Frustração alta - Ação imediata necessária</span>
                  </div>
                  <div class="prediction-step short">
                    <span class="time">5 min</span>
                    <span class="prediction">Se resolver: Pode virar satisfação</span>
                  </div>
                  <div class="prediction-step medium">
                    <span class="time">1h</span>
                    <span class="prediction">Se ignorar: Churn provável (78%)</span>
                  </div>
                  <div class="prediction-step long">
                    <span class="time">24h</span>
                    <span class="prediction">Resolvido: Pode gerar 3 indicações</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="demo-analytics">
          <div class="analytics-metrics">
            <div class="metric-item">
              <div class="metric-icon">🎯</div>
              <div class="metric-data">
                <div class="metric-number">94%</div>
                <div class="metric-label">Precisão Detecção</div>
              </div>
            </div>
            <div class="metric-item">
              <div class="metric-icon">⚡</div>
              <div class="metric-data">
                <div class="metric-number">0.3s</div>
                <div class="metric-label">Tempo Resposta</div>
              </div>
            </div>
            <div class="metric-item">
              <div class="metric-icon">😊</div>
              <div class="metric-data">
                <div class="metric-number">12</div>
                <div class="metric-label">Emoções Detectadas</div>
              </div>
            </div>
            <div class="metric-item">
              <div class="metric-icon">📈</div>
              <div class="metric-data">
                <div class="metric-number">380%</div>
                <div class="metric-label">ROI Médio</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sistema vs Básico Comparison -->
  <section id="comparativo" class="sentiment-vs-basic">
    <div class="section-header">
      <h2>Análise de Sentimento Avançada vs Sistemas Básicos</h2>
      <p>Veja por que análise emocional profunda supera classificações simples</p>
    </div>

    <div class="comparison-showcase">
      <div class="comparison-scenario">
        <h3>📊 Cenário Real: Cliente frustrado com produto</h3>
        <p><strong>Sistema Básico:</strong> Detecta "negativo" mas não entende urgência ou oportunidade</p>
        <p><strong>Sistema Avançado:</strong> Identifica frustração crítica, prediz churn, recomenda ações específicas</p>
      </div>

      <div class="comparison-systems">
        <div class="system-card basic">
          <div class="system-header">
            <h4>📊 Sistema Básico</h4>
            <div class="system-badges">
              <span class="badge simple">Simples</span>
              <span class="badge limited">Limitado</span>
              <span class="badge static">Estático</span>
            </div>
          </div>

          <div class="system-analysis">
            <div class="analysis-result basic-result">
              <h4>Resultado da Análise:</h4>
              <div class="sentiment-basic">
                <div class="sentiment-label">Sentimento: NEGATIVO</div>
                <div class="sentiment-score">Score: -0.7</div>
              </div>
            </div>

            <div class="limitations">
              <h4>❌ Limitações:</h4>
              <ul>
                <li>• Só identifica positivo/neutro/negativo</li>
                <li>• Não detecta emoções complexas</li>
                <li>• Ignora contexto e urgência</li>
                <li>• Não prediz comportamentos</li>
                <li>• Mesmas ações para todos os negativos</li>
              </ul>
            </div>

            <div class="basic-actions">
              <h4>🎯 Ações Possíveis:</h4>
              <div class="actions-limited">
                <span class="action">Responder normalmente</span>
                <span class="action">Marcar como urgente</span>
                <span class="action">Encaminhar supervisor</span>
              </div>
            </div>
          </div>

          <div class="system-results">
            <h5>❌ Resultados Típicos:</h5>
            <div class="result-metrics">
              <div class="result-item">🎯 <strong>65%</strong> precisão detecção</div>
              <div class="result-item">⚡ <strong>2s</strong> tempo análise</div>
              <div class="result-item">😠 <strong>45%</strong> clientes perdidos</div>
              <div class="result-item">💰 <strong>R$ 2.50</strong> custo por análise</div>
              <div class="result-item">📈 <strong>120%</strong> ROI médio</div>
            </div>
          </div>
        </div>

        <div class="system-card advanced">
          <div class="system-header">
            <h4>🧠 Sistema Avançado GetNexo</h4>
            <div class="system-badges">
              <span class="badge advanced">Avançado</span>
              <span class="badge emotional">Emocional</span>
              <span class="badge predictive">Preditivo</span>
            </div>
          </div>

          <div class="system-analysis">
            <div class="analysis-result advanced-result">
              <h4>Análise Completa de Sentimento:</h4>
              <div class="sentiment-advanced">
                <div class="primary-emotion">Frustração: 8.7/10</div>
                <div class="secondary-emotions">
                  <span>Raiva: 7.2</span>
                  <span>Urgência: 8.1</span>
                  <span>Decepção: 6.8</span>
                </div>
                <div class="context-insights">
                  <span>Risco churn: 78%</span>
                  <span>Oportunidade recuperação: Alta</span>
                </div>
              </div>
            </div>

            <div class="advantages">
              <h4>✅ Vantagens:</h4>
              <ul>
                <li>• 12 emoções diferentes detectadas</li>
                <li>• Intensidade e contexto analisados</li>
                <li>• Predições comportamentais</li>
                <li>• Ações específicas por perfil</li>
                <li>• Aprendizado contínuo</li>
              </ul>
            </div>

            <div class="advanced-actions">
              <h4>🎯 Ações Inteligentes:</h4>
              <div class="actions-smart">
                <span class="action critical">Escalar supervisor</span>
                <span class="action urgent">Ligar em 5 min</span>
                <span class="action recovery">Oferecer compensação</span>
                <span class="action predictive">Prevenir churn</span>
              </div>
            </div>
          </div>

          <div class="system-results">
            <h5>✅ Resultados GetNexo:</h5>
            <div class="result-metrics">
              <div class="result-item">🎯 <strong>94%</strong> precisão detecção</div>
              <div class="result-item">⚡ <strong>0.3s</strong> tempo análise</div>
              <div class="result-item">😊 <strong>15%</strong> clientes retidos</div>
              <div class="result-item">💰 <strong>R$ 0.80</strong> custo por análise</div>
              <div class="result-item">📈 <strong>380%</strong> ROI médio</div>
            </div>
          </div>
        </div>
      </div>

      <div class="comparison-results">
        <div class="roi-breakdown">
          <h3>💰 ROI da Análise Emocional Avançada</h3>
          <div class="roi-metrics">
            <div class="roi-metric">
              <span class="roi-label">Redução churn</span>
              <span class="roi-value">67%</span>
            </div>
            <div class="roi-metric">
              <span class="roi-label">Aumento satisfação</span>
              <span class="roi-value">240%</span>
            </div>
            <div class="roi-metric">
              <span class="roi-label">Redução custo atendimento</span>
              <span class="roi-value">-62%</span>
            </div>
            <div class="roi-metric">
              <span class="roi-label">ROI investimento</span>
              <span class="roi-value">380%</span>
            </div>
            <div class="roi-metric">
              <span class="roi-label">Payback</span>
              <span class="roi-value">30 dias</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Emotion Detection Engine -->
  <section class="emotion-detection-engine">
    <div class="section-header">
      <h2>🧠 Motor de Detecção Emocional: Como Entendemos 12 Emoções Diferentes</h2>
      <p>IA treinada em milhões de conversas para identificar emoções complexas com precisão cirúrgica</p>
    </div>

    <div class="emotions-detected">
      <div class="emotions-grid">
        <div class="emotion-detailed">
          <div class="emotion-visual">
            <div class="emotion-icon-large">😊</div>
            <div class="emotion-intensity">1-10</div>
          </div>
          <div class="emotion-info">
            <h3>Alegria</h3>
            <p>Satisfação, contentamento, entusiasmo positivo</p>
            <div class="emotion-indicators">
              <span>"Adorei o produto!"</span>
              <span>"Excelente atendimento"</span>
              <span>"Muito obrigado 😊"</span>
            </div>
            <div class="emotion-action">Ação: Manter padrão, upselling suave</div>
          </div>
        </div>

        <div class="emotion-detailed">
          <div class="emotion-visual">
            <div class="emotion-icon-large">😠</div>
            <div class="emotion-intensity">1-10</div>
          </div>
          <div class="emotion-info">
            <h3>Raiva</h3>
            <p>Ira, indignação, frustração extrema</p>
            <div class="emotion-indicators">
              <span>"Isso é inaceitável!"</span>
              <span>"Estou furioso!"</span>
              <span>"Vou cancelar tudo!"</span>
            </div>
            <div class="emotion-action">Ação: Escalação imediata, compensação</div>
          </div>
        </div>

        <div class="emotion-detailed">
          <div class="emotion-visual">
            <div class="emotion-icon-large">😢</div>
            <div class="emotion-intensity">1-10</div>
          </div>
          <div class="emotion-info">
            <h3>Tristeza</h3>
            <p>Decepção, desânimo, insatisfação profunda</p>
            <div class="emotion-indicators">
              <span>"Estou muito triste"</span>
              <span>"Não esperava isso"</span>
              <span>"Que pena 😢"</span>
            </div>
            <div class="emotion-action">Ação: Empatia, solução alternativa</div>
          </div>
        </div>

        <div class="emotion-detailed">
          <div class="emotion-visual">
            <div class="emotion-icon-large">😨</div>
            <div class="emotion-intensity">1-10</div>
          </div>
          <div class="emotion-info">
            <h3>Medo</h3>
            <p>Ansiedade, preocupação, insegurança</p>
            <div class="emotion-indicators">
              <span>"Tenho medo que..."</span>
              <span>"E se der errado?"</span>
              <span>"Estou preocupado"</span>
            </div>
            <div class="emotion-action">Ação: Tranquilização, garantias</div>
          </div>
        </div>

        <div class="emotion-detailed">
          <div class="emotion-visual">
            <div class="emotion-icon-large">🤔</div>
            <div class="emotion-intensity">1-10</div>
          </div>
          <div class="emotion-info">
            <h3>Dúvida</h3>
            <p>Incerteza, hesitação, indecisão</p>
            <div class="emotion-indicators">
              <span>"Será que vale?"</span>
              <span>"Não sei se..."</span>
              <span>"Estou em dúvida"</span>
            </div>
            <div class="emotion-action">Ação: Educação, benefícios claros</div>
          </div>
        </div>

        <div class="emotion-detailed">
          <div class="emotion-visual">
            <div class="emotion-icon-large">🚨</div>
            <div class="emotion-intensity">1-10</div>
          </div>
          <div class="emotion-info">
            <h3>Urgência</h3>
            <p>Pressa, emergência, necessidade imediata</p>
            <div class="emotion-indicators">
              <span>"PRECISO AGORA!"</span>
              <span>"É urgente!"</span>
              <span>"Não posso esperar"</span>
            </div>
            <div class="emotion-action">Ação: Priorização máxima, resolução rápida</div>
          </div>
        </div>

        <div class="emotion-detailed">
          <div class="emotion-visual">
            <div class="emotion-icon-large">😏</div>
            <div class="emotion-intensity">1-10</div>
          </div>
          <div class="emotion-info">
            <h3>Sarcasmo</h3>
            <p>Ironia, cinismo, crítica velada</p>
            <div class="emotion-indicators">
              <span>"Ah, que ótimo..."</span>
              <span>"Que atendimento 'maravilhoso'"</span>
              <span>"Perfeito, né?"</span>
            </div>
            <div class="emotion-action">Ação: Leitura entre linhas, resposta cuidadosa</div>
          </div>
        </div>

        <div class="emotion-detailed">
          <div class="emotion-visual">
            <div class="emotion-icon-large">🤝</div>
            <div class="emotion-intensity">1-10</div>
          </div>
          <div class="emotion-info">
            <h3>Confiança</h3>
