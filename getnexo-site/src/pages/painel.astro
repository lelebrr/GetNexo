    // Funções de navegação
    window.toggleSidebar = () => {
      const sidebar = document.getElementById('sidebar');
      sidebar.classList.toggle('-translate-x-full');
    };

    window.showScreen = (screenName) => {
      state.currentScreen = screenName;

      // Atualizar navegação ativa
      document.querySelectorAll('.nav-link').forEach(link => {
        link.classList.remove('active', 'bg-gray-800');
      });
      event.target.closest('.nav-link').classList.add('active', 'bg-gray-800');

      // Atualizar título da página
      document.getElementById('page-title').textContent = screenName;
      document.getElementById('page-subtitle').textContent = getScreenSubtitle(screenName);

      // Esconder dashboard e mostrar conteúdo dinâmico
      document.getElementById('dashboard-content').classList.add('hidden');
      document.getElementById('dynamic-content').classList.remove('hidden');

      // Renderizar tela específica
      renderScreen(screenName);
    };

    function getScreenSubtitle(screenName) {
      const subtitles = {
        'Dashboard': 'Visão geral do seu negócio',
