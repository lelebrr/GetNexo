        'Financeiro': 'Pagamentos e faturas',
        'Personalizar': 'Configure seu bot',
        'Notificacoes': 'Alertas e mensagens'
      };
      return subtitles[screenName] || '';
    }

    function renderScreen(screenName) {
      const content = document.getElementById('dynamic-content');

      switch (screenName) {
        case 'Lojas':
          content.innerHTML = renderLojas();
          break;
        case 'Adicionais':
          content.innerHTML = renderAdicionais();
          break;
        case 'Suporte':
          content.innerHTML = renderSuporte();
          break;
        case 'Financeiro':
          content.innerHTML = renderFinanceiro();
          break;
        case 'Personalizar':
          content.innerHTML = renderPersonalizar();
          break;
        case 'Notificacoes':
          content.innerHTML = renderNotificacoes();
          break;
        case 'Leads':
          content.innerHTML = renderLeads();
          break;
        case 'Leads':
          content.innerHTML = renderLeads();
          break;
