---
const { title } = Astro.props;
const nonce = Astro.locals.nonce;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | GetNexo Partner</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style is:global>
        :root {
            --void-black: #050505;
            --neon-blue: #00f3ff;
            --cyber-gold: #ffd700;
            --matrix-green: #00ff41;
            --urgency-red: #ff003c;
            --muted: #64748b;
        }

        body {
            background-color: var(--void-black);
            color: #fff;
            font-family: 'JetBrains Mono', monospace;
            margin: 0;
            display: flex;
            height: 100vh;
        }

        .sidebar {
            width: 250px;
            border-right: 1px solid var(--cyber-gold);
            padding: 2rem 1rem;
            display: flex;
            flex-direction: column;
        }

        .brand {
            font-size: 1.2rem;
            color: var(--cyber-gold);
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
            margin-bottom: 3rem;
            text-transform: uppercase;
            font-weight: bold;
        }

        .nav-item {
            display: block;
            padding: 1rem;
            color: var(--muted);
            text-decoration: none;
            border: 1px solid transparent;
            margin-bottom: 0.5rem;
            transition: 0.3s;
        }

        .nav-item:hover, .nav-item.active {
            color: var(--void-black);
            background: var(--cyber-gold);
            box-shadow: 0 0 15px var(--cyber-gold);
            border-color: var(--cyber-gold);
            font-weight: bold;
        }

        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .header {
            height: 80px;
            border-bottom: 1px solid var(--neon-blue);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            background: rgba(0, 243, 255, 0.02);
        }

        .balance-badge {
            border: 1px solid var(--matrix-green);
            color: var(--matrix-green);
            padding: 0.5rem 1rem;
            box-shadow: 0 0 10px rgba(0,255,65,0.2);
            font-weight: bold;
        }

        .content {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
        }

        /* Utils */
        .text-cyber-gold { color: var(--cyber-gold); }
        .text-neon-blue { color: var(--neon-blue); }
        .bg-void-black { background: var(--void-black); }
        .border-neon-blue { border-color: var(--neon-blue); }
        .border-matrix-green { border-color: var(--matrix-green); }
        .text-muted { color: var(--muted); }
        .text-urgency-red { color: var(--urgency-red); }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="brand">GETNEXO // PARTNER</div>
        <nav>
            <a href="/revenda/dash" class="nav-item">DASHBOARD</a>
            <a href="/revenda/clientes" class="nav-item">CLIENTES</a>
            <a href="/revenda/equipe" class="nav-item">EQUIPE</a>
            <a href="/revenda/codigos" class="nav-item">CÓDIGOS</a>
            <a href="/revenda/gerar" class="nav-item">GERAR PLUGIN [+]</a>
            <a href="/revenda/comissoes" class="nav-item">COMISSÕES</a>
            <a href="/revenda/material" class="nav-item">MATERIAL</a>
        </nav>
    </aside>

    <div class="main">
        <header class="header">
            <div>
                <span class="text-cyber-gold">STATUS: ELITE REVENDEDOR</span>
            </div>
            <div style="display:flex; gap:1rem; align-items:center;">
                <div class="balance-badge">SALDO: R$ 1.247,00</div>
                <button onclick="logout()" style="background:none; border:1px solid #333; color:#666; padding:0.5rem; cursor:pointer;">SAIR</button>
            </div>
        </header>
        <div class="content">
            <slot />
        </div>
    </div>

<script is:inline nonce={nonce}>
    const path = window.location.pathname;
    document.querySelectorAll('.nav-item').forEach(el => {
        if(el.getAttribute('href') === path) el.classList.add('active');
    });

    function logout() {
        if(confirm('Encerrar sessão??')) {
            localStorage.removeItem('token');
            window.location.href = '/login';
        }
    }

    // Auth Guard
    if (!localStorage.getItem('token')) {
        window.location.href = '/login';
    }
</script>

</body>
</html>
