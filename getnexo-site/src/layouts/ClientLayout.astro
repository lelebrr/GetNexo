---
export interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="bg-gray-50 text-gray-900">
        <header class="bg-white shadow-sm border-b">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center py-4">
                    <div class="flex items-center">
                        <h1 class="text-2xl font-bold text-gray-900">Portal do Cliente</h1>
                    </div>
                    <nav class="flex space-x-4">
                        <a href="/cliente/hub" class="text-gray-600 hover:text-gray-900">Hub</a>
                        <a href="/cliente/chamados" class="text-gray-600 hover:text-gray-900">Chamados</a>
                        <a href="/cliente/compras" class="text-gray-600 hover:text-gray-900">Compras</a>
                        <a href="/cliente/pontos" class="text-gray-600 hover:text-gray-900">Pontos</a>
                        <button class="text-gray-600 hover:text-gray-900">Sair</button>
                    </nav>
                </div>
            </div>
        </header>

        <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
            <slot />
        </main>

        <!-- Ghost Mode Button -->
        <button id="ghost-support" class="fixed bottom-4 right-4 w-6 h-6 bg-gray-400 rounded opacity-0 transition-opacity duration-300"
                title="Suporte">
            ?
        </button>

        <style>
            #ghost-support:hover {
                opacity: 1 !important;
            }
        </style>

        <script>
            // Ghost mode: show button briefly then hide
            const ghostBtn = document.getElementById('ghost-support');
            if (ghostBtn) {
                setTimeout(() => {
                    ghostBtn.style.opacity = '1';
                    setTimeout(() => {
                        ghostBtn.style.opacity = '0';
                    }, 3000);
                }, 2000);
            }
        </script>
    </body>
</html>