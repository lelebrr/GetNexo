<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <script nonce={nonce} is:inline>
      // Global Fetch Interceptor for Authentication
      const originalFetch = window.fetch;
      window.fetch = async function(url, options = {}) {
        const token = localStorage.getItem('token');
        // Only attach token if the request is to our own origin (relative or absolute same-origin)
        const isRelative = typeof url === 'string' && url.startsWith('/');
        const isSameOrigin = typeof url === 'string' && url.startsWith(window.location.origin);

        if (token && (isRelative || isSameOrigin)) {
          // Ensure options.headers is initialized
          if (!options.headers) {
            options.headers = {};
          }

          // Handle both Headers object and plain object
          if (options.headers instanceof Headers) {
             if (!options.headers.has('Authorization')) {
               options.headers.append('Authorization', `Bearer ${token}`);
             }
          } else if (Array.isArray(options.headers)) {
             // Array of arrays format
             const hasAuth = options.headers.some(h => h[0] === 'Authorization');
             if (!hasAuth) {
               options.headers.push(['Authorization', `Bearer ${token}`]);
             }
          } else {
             // Plain object
             if (!options.headers['Authorization']) {
               options.headers['Authorization'] = `Bearer ${token}`;
             }
          }
        }
        return originalFetch(url, options);
      };
    </script>
    <script nonce={nonce} defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.csp.min.js"></script>
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Admin GetNexo</title>
  </head>
  <body class="bg-gray-950">
    <script nonce={nonce} define:vars={{ trustedTypesPolicy }}>
      (function() {
        if (window.trustedTypes && window.trustedTypes.createPolicy) {
          if (!window.trustedTypes.defaultPolicy) {
            try {
              window.trustedTypes.createPolicy('default', {
                createHTML: function(s) { return s; },
                createScript: function(s) { return s; },
                createScriptURL: function(s) { return s; }
              });
            } catch (e) {
              console.warn('Trusted Types default policy failed:', e);
            }
          }
          if (!window.GETNEXO_POLICY) {
            try {
              window.GETNEXO_POLICY = window.trustedTypes.createPolicy(trustedTypesPolicy, {
                createHTML: function(s) { return s; },
                createScript: function(s) { return s; },
                createScriptURL: function(s) { return s; }
              });
            } catch (e) {
              console.warn('Trusted Types getnexo policy failed:', e);
            }
          }
        }
      })();
    </script>

    <script nonce={nonce} define:vars={{ submenus, activeCategory }}>
      document.addEventListener("alpine:init", () => {
        Alpine.data("sidebar", () => ({
          active: activeCategory,
          submenus: submenus,
          categoryToTabMap: {
            dashboard: 'dashboard', live: 'live', broadcasts: 'marketing',
            crm: 'crm', produtos: 'produtos', seo: 'seo', "security-ia": 'security-ia', magic: 'strategy',
            pagamentos: 'pagamentos', automations: 'automations',
            analytics: 'analytics', fidelidade: 'loyalty', tags: 'tags',
            integracoes: 'integrations', multiloja: 'multiloja', 
            config: 'config', seguranca: 'security', relatorios: 'relatorios', ajuda: 'support', docker: 'docker', nexus: 'nexus',
            reseller: 'reseller', a2a: 'a2a', ap2: 'ap2'
          },
          
          // Account Modal State
          accountModalOpen: false,
          savingProfile: false,
          profile: {
            name: '',
            email: '',
            newPassword: '',
            preferences: {
              theme: 'dark',
              notifications: true,
              language: 'pt-BR'
            }
          },
          
          toggle(event) {
            event.preventDefault();
            const cat = event.currentTarget.dataset.id;
            this.active = cat;
            const menuItems = this.submenus[cat];
            const baseUrl = menuItems && menuItems.length > 0 ? menuItems[0].href : (cat === 'dashboard' ? '/admin' : `/admin/${cat}`);
            const tabParam = this.categoryToTabMap[cat];
            window.location.href = baseUrl + (tabParam ? `?tab=${tabParam}` : '');
          },
          
          async loadProfile() {
            try {
              const res = await fetch('/api/profile', { credentials: 'include' });
              if (res.ok) {
                const data = await res.json();
                this.profile = { ...this.profile, ...data, newPassword: '' };
              }
            } catch (e) {
              console.error('Erro ao carregar perfil:', e);
            }
          },
          
          async saveProfile() {
            this.savingProfile = true;
            try {
              const payload = {
                name: this.profile.name,
                email: this.profile.email,
                preferences: this.profile.preferences
              };
              if (this.profile.newPassword) {
                payload.password = this.profile.newPassword;
              }
              
              const res = await fetch('/api/profile', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify(payload)
              });
              
              if (res.ok) {
                this.profile.newPassword = '';
                this.accountModalOpen = false;
                // Show success notification
                if (window.showNotification) {
                  window.showNotification('Perfil atualizado com sucesso!', 'success');
                } else {
                  alert('Perfil atualizado com sucesso!');
                }
              } else {
                throw new Error('Falha ao salvar');
              }
            } catch (e) {
              console.error('Erro ao salvar perfil:', e);
              alert('Erro ao salvar perfil. Tente novamente.');
            } finally {
              this.savingProfile = false;
            }
          },
          
          init() {
            this.loadProfile();
          }
        }));
      });
    </script>

    <div x-data="sidebar" class="flex h-screen bg-gray-950 text-white overflow-hidden">
      <!-- 1. BARRA LATERAL DE CATEGORIAS (Rail) -->
