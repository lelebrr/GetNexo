---
interface Props {
	title: string;
}

const { title } = Astro.props;
const nonce = Astro.locals.nonce;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Admin Nexus</title>
	</head>
	<body class="admin-body">
		<div class="sidebar">
			<div class="logo">
				NEXUS<span class="dot">.</span>
			</div>
			
			<nav class="menu">
				<div class="category">MAIN</div>
				<a href="/admin" class="active"><span class="icon">📊</span> Dashboard</a>
				<a href="/admin/blog"><span class="icon">📝</span> Blog / Conteúdo</a>
				<a href="/admin/domains"><span class="icon">🌐</span> Domínios</a>
				<a href="/ara"><span class="icon">🤖</span> IA (Ara)</a>
				
				<div class="category">GROWTH</div>
				<a href="/admin?tab=strategy"><span class="icon">⚔️</span> Estratégia</a>
				<a href="/admin?tab=marketing"><span class="icon">📢</span> Marketing</a>
				<a href="/admin?tab=ab"><span class="icon">⚖️</span> A/B Tests</a>
				
				<div class="category">TECHNICAL</div>
				<a href="/admin?tab=security"><span class="icon">🛡️</span> Segurança</a>
				<a href="/admin?tab=performance"><span class="icon">⚡</span> Performance</a>
				<a href="/admin?tab=logs"><span class="icon">📋</span> Logs</a>
				<a href="/admin?tab=backup"><span class="icon">💾</span> Backup</a>
				
				<div class="category">CONFIG</div>
				<a href="/admin?tab=users"><span class="icon">👥</span> Usuários</a>
				<a href="/admin?tab=integrations"><span class="icon">🔌</span> Integrações</a>
				<a href="/admin?tab=config"><span class="icon">⚙️</span> Configs</a>
				<a href="/admin?tab=downloads"><span class="icon">📥</span> Downloads</a>
				<a href="/admin?tab=notifications"><span class="icon">🔔</span> Notificações</a>

				<div class="category">SYSTEM</div>
				<a href="/" target="_blank"><span class="icon">↗</span> Ver Site</a>
				<a href="#" class="logout"><span class="icon">🚪</span> Logout</a>
			</nav>

			<!-- Global Admin Scripts -->
			<script src="/custom/js/command_palette.js" is:inline nonce={nonce}></script>
			<script src="/custom/js/admin_sounds.js" is:inline nonce={nonce}></script>
			<script src="/custom/js/holo_agent.js" is:inline nonce={nonce}></script>

			<div class="user-profile">
				<div class="avatar">L</div>
				<div class="info">
					<span class="name">Leandro</span>
					<span class="role">Supreme Admin</span>
				</div>
			</div>
		</div>

		<main class="content">
			<header>
				<h1>{title}</h1>
				<div class="header-actions">
					<span class="status-indicator online">SYSTEM ONLINE</span>
					<span class="time" id="clock">00:00</span>
				</div>
			</header>
			
			<div class="scroll-area">
				<slot />
			</div>
		</main>

		<script nonce={nonce}>
			function updateClock() {
				const now = new Date();
				const time = now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
				const el = document.getElementById('clock');
				if (el) el.innerText = time;
			}
			setInterval(updateClock, 1000);
			updateClock();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #030303;
		--sidebar: #080808;
		--border: #1a1a1a;
		--accent: #00f7ff; /* Neon Blue */
		--gold: #ffc400; /* Cyber Gold */
		--void: #050505;
		--text: #e0e0e0;
		--text-muted: #666;
		--neon-glow: 0 0 10px rgba(0, 247, 255, 0.3);
	}

	* { box-sizing: border-box; margin: 0; padding: 0; }

	body {
		font-family: 'Inter', sans-serif;
		background: var(--bg);
		color: var(--text);
		height: 100vh;
		display: flex;
		overflow: hidden;
	}

	/* Sidebar Customization */
	.sidebar {
		width: 260px;
		background: var(--sidebar);
		border-right: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		box-shadow: 5px 0 30px rgba(0,0,0,0.5);
		z-index: 100;
	}

	.logo {
		font-family: 'JetBrains Mono', monospace;
		font-weight: 800;
		font-size: 1.6rem;
		margin-bottom: 3rem;
		letter-spacing: -1px;
		color: var(--gold);
		text-shadow: 0 0 15px rgba(255, 196, 0, 0.2);
	}
	
	.dot { color: var(--accent); text-shadow: 0 0 15px var(--accent); }

	.menu {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		flex: 1;
		overflow-y: auto;
	}

	.category {
		font-size: 0.65rem;
		color: var(--gold);
		font-weight: 800;
		margin-top: 1.8rem;
		margin-bottom: 0.5rem;
		letter-spacing: 2px;
		opacity: 0.6;
	}

	.menu a {
		color: #888;
		text-decoration: none;
		padding: 0.8rem 1rem;
		border-radius: 4px;
		font-size: 0.85rem;
		transition: 0.3s;
		display: flex;
		align-items: center;
		border-left: 2px solid transparent;
		font-family: 'JetBrains Mono', monospace;
	}

	.menu a:hover, .menu a.active {
		background: rgba(0, 247, 255, 0.05);
		color: white;
		border-left: 2px solid var(--accent);
		text-shadow: 0 0 10px rgba(255,255,255,0.3);
	}

	.logout { 
		color: #555 !important; 
		margin-top: 2rem;
		border-top: 1px solid var(--border);
		padding-top: 1rem !important;
	}
	.logout:hover { color: #ff3333 !important; border-left-color: #ff3333 !important; }

	.user-profile {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem;
		margin-top: 1rem;
		background: rgba(255,255,255,0.02);
		border-radius: 12px;
		border: 1px solid var(--border);
	}

	.avatar {
		width: 32px;
		height: 32px;
		background: linear-gradient(135deg, var(--accent), var(--gold));
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: bold;
		color: black;
		font-size: 0.8rem;
	}

	.info { display: flex; flex-direction: column; }
	.name { font-size: 0.85rem; font-weight: 700; color: white; }
	.role { font-size: 0.65rem; color: var(--accent); text-transform: uppercase; letter-spacing: 1px; }

	/* Main Content */
	.content {
		flex: 1;
		display: flex;
		flex-direction: column;
		background: radial-gradient(circle at 50% 50%, #050505 0%, #000 100%);
	}

	header {
		height: 70px;
		border-bottom: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 2.5rem;
		background: rgba(5,5,5,0.8);
		backdrop-filter: blur(10px);
	}

	header h1 { 
		font-size: 1.1rem; 
		font-family: 'JetBrains Mono', monospace;
		color: var(--gold);
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 2rem;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
	}

	.status-indicator {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--accent);
		font-weight: bold;
	}
	
	.status-indicator::before {
		content: '';
		width: 6px;
		height: 6px;
		background: var(--accent);
		border-radius: 50%;
		box-shadow: 0 0 10px var(--accent);
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(1.2); }
		100% { opacity: 1; transform: scale(1); }
	}

	.scroll-area {
		flex: 1;
		overflow-y: auto;
		padding: 2.5rem;
		scrollbar-width: thin;
		scrollbar-color: var(--border) transparent;
	}

	.scroll-area::-webkit-scrollbar { width: 6px; }
	.scroll-area::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }

	/* Cyberpunk Card Component Utility */
	.cyber-card {
		background: rgba(10, 10, 10, 0.6);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1.5rem;
		position: relative;
		overflow: hidden;
		transition: 0.3s;
	}
	.cyber-card:hover {
		border-color: var(--accent);
		box-shadow: 0 0 20px rgba(0, 247, 255, 0.1);
	}
	.cyber-card::before {
		content: '';
		position: absolute;
		top: 0; left: 0; width: 100%; height: 2px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
		transform: translateX(-100%);
		transition: 0.5s;
	}
	.cyber-card:hover::before { transform: translateX(100%); }
</style>
