---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <script nonce={Astro.locals.nonce} defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Admin GetNexo</title>
  </head>
  <body>
    <script nonce={nonce} define:vars={{ submenus, mainCategories, activeCategory }}>
      document.addEventListener("alpine:init", () => {
        Alpine.data("sidebar", () => ({
          active: activeCategory,
          submenus: submenus,
          mainCategories: mainCategories,
          categoryToTabMap: {
            dashboard: 'dashboard', live: 'live', broadcasts: 'marketing',
            crm: 'crm', produtos: 'produtos', magic: 'strategy',
            pagamentos: 'pagamentos', automations: 'automations',
            analytics: 'analytics', fidelidade: 'loyalty', tags: 'tags',
            integracoes: 'integrations', multiloja: 'multiloja',
            config: 'config', seguranca: 'security', relatorios: 'relatorios', ajuda: 'support'
          },
          toggle(event, cat) {
            event.preventDefault();
            this.active = cat;
            const menuItems = this.submenus[cat];
            const baseUrl = menuItems && menuItems.length > 0 ? menuItems[0].href : (cat === 'dashboard' ? '/admin' : `/admin/${cat}`);
            const tabParam = this.categoryToTabMap[cat];
            window.location.href = baseUrl + (tabParam ? `?tab=${tabParam}` : '');
          }
        }));
      });
    </script>

    <div x-data="sidebar" class="flex h-screen bg-gray-950 text-white overflow-hidden">
      <!-- 1. BARRA LATERAL DE CATEGORIAS (Rail) -->
      <aside class="w-20 lg:w-24 flex-shrink-0 bg-black border-r border-gray-800 flex flex-col items-center py-6 overflow-y-auto scrollbar-hide">
        <!-- Logo -->
        <div class="mb-8">
          <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center shadow-lg shadow-purple-500/30">
            <span class="text-white font-bold text-lg">G</span>
          </div>
        </div>

        <nav class="flex flex-col space-y-4 w-full px-2">
          {mainCategories.map((cat) => (
            <button
              @click={`toggle($event, '${cat.id}')`}
              class:list={[
                "flex flex-col items-center justify-center p-2 rounded-xl transition-all duration-300 group relative",
                activeCategory === cat.id 
                  ? `bg-${cat.color}-600/20 text-${cat.color}-400 ring-1 ring-${cat.color}-500/50` 
                  : "text-gray-500 hover:bg-gray-800 hover:text-gray-300"
              ]}
              title={cat.name}
            >
              <cat.icon className="w-6 h-6 mb-1" />
              <span class="text-[10px] font-medium text-center line-clamp-1">{cat.name}</span>
              {cat.count && (
                <span class="absolute -top-1 -right-1 bg-red-600 text-white text-[9px] px-1 rounded-full">{cat.count}</span>
              )}
              {activeCategory === cat.id && (
                <div class:list={["absolute left-0 w-1 h-8 rounded-r-full", `bg-${cat.color}-500 shadow-[0_0_10px_rgba(var(--${cat.color}-500-rgb),_0.5)]`]}></div>
              )}
            </button>
          ))}
        </nav>
      </aside>

      <!-- 2. BARRA LATERAL DE SUBMENUS (Pane) -->
      <aside class="w-64 flex-shrink-0 bg-gray-900/50 border-r border-gray-800 flex flex-col hidden md:flex">
        <div class="p-6 border-b border-gray-800">
          <h2 class="text-lg font-bold text-white capitalize">{activeCategory}</h2>
          <div class="h-1 w-12 bg-gradient-to-r from-purple-500 to-cyan-500 rounded-full mt-1"></div>
        </div>
        
        <nav class="flex-1 overflow-y-auto p-4 space-y-1 scrollbar-hide">
          {(submenus[activeCategory] || []).map((sub) => (
            <a href={sub.href} class="flex items-center px-4 py-3 rounded-lg text-gray-400 hover:bg-gray-800 hover:text-white transition-all group">
              <span class="w-1.5 h-1.5 bg-gray-700 rounded-full mr-3 group-hover:bg-purple-500 transition-colors"></span>
              <span class="text-sm font-medium">{sub.title}</span>
            </a>
          ))}
        </nav>

        <!-- Status -->
        <div class="p-4 border-t border-gray-800">
          <div class="flex items-center justify-between text-[10px] text-gray-500">
            <span>GetNexo v2.0</span>
            <span class="flex items-center text-emerald-400">
              <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full mr-1.5 animate-pulse"></span>
              Online
            </span>
          </div>
        </div>
      </aside>

      <!-- 3. ÁREA PRINCIPAL -->
      <div class="flex-1 flex flex-col min-w-0 bg-black">
        <!-- Header Superior -->
        <header class="h-16 flex-shrink-0 bg-black/50 backdrop-blur-md border-b border-gray-800 px-8 flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <h1 class="text-xl font-bold text-white line-clamp-1">{title}</h1>
          </div>

          <div class="flex items-center space-x-6">
            <div class="hidden lg:flex items-center space-x-4 text-xs">
               <div class="flex items-center space-x-1.5 text-cyan-400">
                 <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full"></span>
                 <span>8 Conversas</span>
               </div>
               <div class="flex items-center space-x-1.5 text-emerald-400">
                 <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                 <span>3 Vendas</span>
               </div>
            </div>

            <div class="flex items-center space-x-3 border-l border-gray-800 pl-6">
              <div class="text-right">
                <p class="text-xs font-bold text-white">Leandro</p>
                <p class="text-[10px] text-purple-400">Master Admin</p>
              </div>
              <a href="/logout" class="p-2 bg-red-600/10 hover:bg-red-600/20 text-red-500 rounded-lg transition-colors border border-red-500/20">
                <Settings className="w-4 h-4" />
              </a>
            </div>
          </div>
        </header>

        <!-- Conteúdo -->
        <main class="flex-1 overflow-y-auto p-8 scroll-smooth">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');
  
  :root {
    --bg: #000000;
  }

  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: #555; }

  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  body {
    background-color: var(--bg);
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }
</style>
