interface Props {
  title: string;
}

const { title, activeTab } = Astro.props;
const nonce = Astro.locals.nonce;

const urlActive = Astro.url.searchParams.get('tab');

// Map URL tab names back to internal Category IDs to ensure submenus load correctly
const tabToCategoryMap = {
  'marketing': 'broadcasts',
  'strategy': 'magic',
  'security': 'seguranca',
  'loyalty': 'fidelidade',
  'integrations': 'integracoes'
};

// Resolve active category: explicit prop > reverse mapped URL tab > direct URL tab > dashboard
let resolvedActive = activeTab || (urlActive ? (tabToCategoryMap[urlActive] || urlActive) : 'dashboard');
// Override the activeCategory variable that gets passed to the script
let activeCategory = resolvedActive;
const active = resolvedActive;

import '../styles/global.css';
import { Home, MessageCircle, Megaphone, Users, ShoppingCart, Brain, BarChart, Heart, DollarSign, Zap, Plug, Settings, ShieldCheck, CircleHelp, Tag, Layers, FileText } from 'lucide-react';

const mainCategories = [
  { name: "Dashboard", id: "dashboard", icon: Home, color: "indigo" },
  { name: "Conversas Ao Vivo", id: "live", icon: MessageCircle, color: "cyan", count: 8 },
  { name: "Marketing", id: "broadcasts", icon: Megaphone, color: "purple" },
  { name: "CRM & Leads", id: "crm", icon: Users, color: "emerald" },
  { name: "Produtos & Catálogo", id: "produtos", icon: ShoppingCart, color: "orange" },
  { name: "Magic Replies IA", id: "magic", icon: Brain, color: "pink" },
  { name: "PIX & Pagamentos", id: "pagamentos", icon: DollarSign, color: "green" },
  { name: "Automations", id: "automations", icon: Zap, color: "yellow" },
  { name: "Analytics & BI", id: "analytics", icon: BarChart, color: "blue" },
  { name: "Fidelidade & Retenção", id: "fidelidade", icon: Heart, color: "red" },
  { name: "Tags & Segmentos", id: "tags", icon: Tag, color: "teal" },
  { name: "Integrações", id: "integracoes", icon: Plug, color: "violet" },
  { name: "Multi-Loja", id: "multiloja", icon: Layers, color: "amber" },
  { name: "Configurações Gerais", id: "config", icon: Settings, color: "gray" },
