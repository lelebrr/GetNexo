          </div>
          <p class="text-[8px] text-gray-500 mt-2">V:2.1-{mainCategories.length}</p>
        </div>

        <nav class="flex flex-col space-y-4 w-full px-2">
          {mainCategories.map((cat) => {
            const menuItems = submenus[cat.id];
            // Calculate HREF server-side for robustness
            const groupHref = menuItems && menuItems.length > 0 
              ? menuItems[0].href 
              : (cat.id === 'dashboard' ? '/admin' : `/admin/${cat.id}`);
            
            // Append tab param if alias exists (optional, but keeps existing logic)
            // Actually, we should stick to clean URLs if possible, but let's keep the tab param for now if it was relied upon
            // tabToCategoryMap is reverse. We need categoryToTab.
            // But since the pages set activeTab explicitly, we might not strictly need the ?tab param for the destination page to work, 
            // unless the destination page relies solely on URL param.
            // Verified: pages use <AdminLayout activeTab="..."> so clean URL is fine.
            
            return (
              <a
                href={groupHref}
                data-id={cat.id}
                class:list={[
                  "flex flex-col items-center justify-center p-2 rounded-xl transition-all duration-300 group relative",
                  activeCategory === cat.id 
                    ? `bg-${cat.color}-600/20 text-${cat.color}-400 ring-1 ring-${cat.color}-500/50` 
                    : "text-gray-500 hover:bg-gray-800 hover:text-gray-300"
                ]}
                title={cat.name}
              >
                <cat.icon className="w-6 h-6 mb-1 pointer-events-none" />
                <span class="text-[10px] font-medium text-center line-clamp-1 pointer-events-none">{cat.name}</span>
                {cat.count && (
                  <span class="absolute -top-1 -right-1 bg-red-600 text-white text-[9px] px-1 rounded-full pointer-events-none">{cat.count}</span>
                )}
                {activeCategory === cat.id && (
                  <div class:list={["absolute left-0 w-1 h-8 rounded-r-full pointer-events-none top-1/2 -translate-y-1/2", `bg-${cat.color}-500 shadow-[0_0_10px_rgba(var(--${cat.color}-500-rgb),_0.5)]`]}></div>
                )}
              </a>
            );
          })}
        </nav>
      </aside>

      <!-- 2. BARRA LATERAL DE SUBMENUS (Pane) -->
      <aside class="w-64 flex-shrink-0 bg-gray-900/50 border-r border-gray-800 flex flex-col hidden md:flex">
        <div class="p-6 border-b border-gray-800">
          <h2 class="text-lg font-bold text-white capitalize">{activeCategory}</h2>
          <div class="h-1 w-12 bg-gradient-to-r from-purple-500 to-cyan-500 rounded-full mt-1"></div>
        </div>
        
        <nav class="flex-1 overflow-y-auto p-4 space-y-1 scrollbar-hide">
          {(submenus[activeCategory] || []).map((sub) => {
            const isActive = Astro.url.pathname === sub.href;
            return (
              <a href={sub.href} class:list={[
                "flex items-center px-4 py-3 rounded-lg transition-all group",
                isActive ? "bg-emerald-500/10 text-white" : "text-gray-400 hover:bg-gray-800 hover:text-white"
              ]}>
                <span class:list={[
                  "w-1.5 h-1.5 rounded-full mr-3 transition-all",
                  isActive ? "bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]" : "bg-gray-700 group-hover:bg-purple-500"
                ]}></span>
                <span class:list={["text-sm font-medium", isActive ? "font-bold" : ""]}>{sub.title}</span>
              </a>
            );
          })}
        </nav>

        <!-- Status -->
        <div class="p-4 border-t border-gray-800">
          <div class="flex items-center justify-between text-[10px] text-gray-500">
            <span>GetNexo v2.0</span>
            <span class="flex items-center text-emerald-400">
              <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full mr-1.5 animate-pulse"></span>
              Online
            </span>
          </div>
        </div>
      </aside>

      <!-- 3. ÁREA PRINCIPAL -->
      <div class="flex-1 flex flex-col min-w-0 bg-black">
        <!-- Header Superior -->
        <header class="h-16 flex-shrink-0 bg-black/80 backdrop-blur-xl border-b border-gray-800 px-8 flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <h1 class="text-xl font-bold text-white line-clamp-1">{title}</h1>
          </div>

          <div class="flex items-center space-x-6">
            <div class="hidden lg:flex items-center space-x-4 text-xs">
               <div class="flex items-center space-x-1.5 text-cyan-400">
                 <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full"></span>
                 <span>8 Conversas</span>
               </div>
               <div class="flex items-center space-x-1.5 text-emerald-400">
                 <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                 <span>3 Vendas</span>
               </div>
            </div>

            <div class="flex items-center space-x-3 border-l border-gray-800 pl-6">
              <div class="text-right">
                <p class="text-xs font-bold text-white uppercase tracking-tight" x-text="profile.name || 'Usuário'">Leandro</p>
                <p class="text-[9px] text-purple-400 font-black uppercase tracking-widest">Master Admin</p>
              </div>
              <div class="flex items-center space-x-2">
                <button @click="accountModalOpen = true" class="p-2.5 bg-gray-900 border border-gray-800 text-gray-500 hover:text-white hover:border-gray-700 rounded-xl transition-all" title="Configurações da Conta">
                  <Settings className="w-4 h-4" />
                </button>
                <a href="/logout" class="p-2.5 bg-red-500/10 border border-red-500/20 text-red-500 hover:bg-red-500/20 rounded-xl transition-all" title="Sair do Sistema">
                  <LogOut className="w-4 h-4" />
                </a>
              </div>
            </div>
          </div>
        </header>

        <!-- Account Settings Modal -->
        <div x-show="accountModalOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4" @keydown.escape.window="accountModalOpen = false">
          <!-- Backdrop -->
          <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" @click="accountModalOpen = false"></div>
          
          <!-- Modal Content -->
          <div class="relative w-full max-w-md bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl overflow-hidden" @click.stop>
            <!-- Header -->
            <div class="bg-gradient-to-r from-purple-600/20 to-cyan-600/20 p-6 border-b border-gray-800">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                  <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-cyan-500 rounded-xl flex items-center justify-center shadow-lg">
                    <Settings className="w-6 h-6 text-white" />
                  </div>
                  <div>
                    <h2 class="text-xl font-bold text-white">Minha Conta</h2>
                    <p class="text-xs text-gray-400">Edite suas informações pessoais</p>
                  </div>
                </div>
                <button @click="accountModalOpen = false" class="p-2 text-gray-500 hover:text-white hover:bg-gray-800 rounded-lg transition-all">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Body & Footer wrapped in Form -->
            <form @submit.prevent="saveProfile()">
              <div class="p-6 space-y-5 max-h-[60vh] overflow-y-auto">
                <!-- Name -->
                <div>
                  <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Nome</label>
                  <input type="text" x-model="profile.name" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" placeholder="Seu nome">
                </div>

                <!-- Email -->
                <div>
                  <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Email</label>
                  <input type="email" x-model="profile.email" autocomplete="email" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" placeholder="seu@email.com">
                </div>

                <!-- Password Change -->
                <div class="border-t border-gray-800 pt-5">
                  <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Alterar Senha</label>
                  <input type="password" x-model="profile.newPassword" autocomplete="new-password" class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" placeholder="Nova senha (deixe vazio para manter)">
                </div>

                <!-- Theme Toggle -->
                <div class="flex items-center justify-between border-t border-gray-800 pt-5">
                  <div>
                    <p class="text-sm font-semibold text-white">Tema Escuro</p>
                    <p class="text-xs text-gray-500">Ativar modo escuro no painel</p>
                  </div>
                  <div @click="profile.preferences.theme = (profile.preferences.theme === 'dark' ? 'light' : 'dark')"
                       class="w-12 h-6 rounded-full relative cursor-pointer transition-colors duration-300"
                       :class="profile.preferences.theme === 'dark' ? 'bg-purple-600' : 'bg-gray-700'">
                    <div class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full transition-transform duration-300"
                         :class="profile.preferences.theme === 'dark' ? 'translate-x-6' : 'translate-x-0'"></div>
                  </div>
                </div>

                <!-- Notifications Toggle -->
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm font-semibold text-white">Notificações</p>
                    <p class="text-xs text-gray-500">Receber alertas do sistema</p>
                  </div>
                  <div @click="profile.preferences.notifications = !profile.preferences.notifications"
                       class="w-12 h-6 rounded-full relative cursor-pointer transition-colors duration-300"
                       :class="profile.preferences.notifications ? 'bg-emerald-600' : 'bg-gray-700'">
                    <div class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full transition-transform duration-300"
                         :class="profile.preferences.notifications ? 'translate-x-6' : 'translate-x-0'"></div>
                  </div>
                </div>
              </div>

              <!-- Footer -->
              <div class="p-6 border-t border-gray-800 bg-gray-900/50 flex items-center justify-end space-x-3">
                <button type="button" @click="accountModalOpen = false" class="px-5 py-2.5 text-gray-400 hover:text-white transition-colors font-medium">Cancelar</button>
                <button type="submit" :disabled="savingProfile" class="px-6 py-2.5 bg-gradient-to-r from-purple-600 to-cyan-600 hover:from-purple-500 hover:to-cyan-500 text-white font-bold rounded-xl transition-all disabled:opacity-50 flex items-center space-x-2">
                  <span x-text="savingProfile ? 'Salvando...' : 'Salvar'"></span>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Conteúdo -->
        <main class="flex-1 overflow-y-auto p-8 scroll-smooth">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style is:global>
  [x-cloak] { display: none !important; }

  :root {
    --bg: #000000;
  }

  ::-webkit-scrollbar { width: 4px; height: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: #555; }

  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

  body {
    background-color: var(--bg);
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }
</style>
