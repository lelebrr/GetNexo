---
interface Props {
  title: string;
  activeTab?: string;
}

const { title, activeTab } = Astro.props;
const nonce = Astro.locals.nonce;

const urlActive = Astro.url.searchParams.get('tab');

// Map URL tab names back to internal Category IDs
const tabToCategoryMap = {
  'marketing': 'broadcasts',
  'strategy': 'magic',
  'security': 'seguranca',
  'loyalty': 'fidelidade',
  'integrations': 'integracoes'
};

let resolvedActive = activeTab || (urlActive ? (tabToCategoryMap[urlActive] || urlActive) : 'dashboard');
let activeCategory = resolvedActive;

import '../styles/global.css';
import { Home, MessageCircle, Megaphone, Users, ShoppingCart, Brain, BarChart, Heart, DollarSign, Zap, Plug, Settings, ShieldCheck, CircleHelp, Tag, Layers, FileText } from 'lucide-react';

const mainCategories = [
  { name: "Dashboard", id: "dashboard", icon: Home, color: "indigo" },
  { name: "Conversas", id: "live", icon: MessageCircle, color: "cyan", count: 8 },
  { name: "Marketing", id: "broadcasts", icon: Megaphone, color: "purple" },
  { name: "CRM", id: "crm", icon: Users, color: "emerald" },
  { name: "Produtos", id: "produtos", icon: ShoppingCart, color: "orange" },
  { name: "Magic IA", id: "magic", icon: Brain, color: "pink" },
  { name: "Pagamentos", id: "pagamentos", icon: DollarSign, color: "green" },
  { name: "Automations", id: "automations", icon: Zap, color: "yellow" },
  { name: "Analytics", id: "analytics", icon: BarChart, color: "blue" },
  { name: "Fidelidade", id: "fidelidade", icon: Heart, color: "red" },
  { name: "Tags", id: "tags", icon: Tag, color: "teal" },
  { name: "Integrações", id: "integracoes", icon: Plug, color: "violet" },
  { name: "Multi-Loja", id: "multiloja", icon: Layers, color: "amber" },
  { name: "Configurações", id: "config", icon: Settings, color: "gray" },
