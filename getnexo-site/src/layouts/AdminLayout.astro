---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <title>{title} | Admin GetNexo</title>
    <script is:inline>
      window.onerror = function (msg, url, lineNo, columnNo, error) {
        console.error('ERRO GLOBAL:', msg);
        console.error('URL:', url);
        console.error('Linha:', lineNo, 'Coluna:', columnNo);
        console.error('Erro completo:', error);
        return false; // deixa o erro aparecer no console
      };
      console.log('Erro global ativado – agora nada esconde!');
    </script>
  </head>
  <body>
    <script nonce={nonce} define:vars={{ submenus, mainCategories, activeCategory }}>
      document.addEventListener("alpine:init", () => {
        Alpine.data("sidebar", () => ({
          active: activeCategory, // Force server state (URL) to drive UI, ignore stale localStorage
          submenus: submenus,
          mainCategories: mainCategories,
          categoryToTabMap: {
            dashboard: 'dashboard',
            live: 'live',
            broadcasts: 'marketing',
            crm: 'crm',
            produtos: 'produtos',
            magic: 'strategy',
            pagamentos: 'pagamentos',
            automations: 'automations',
            analytics: 'analytics',
            fidelidade: 'loyalty',
            tags: 'tags',
            integracoes: 'integrations',
            multiloja: 'multiloja',
            config: 'config',
            seguranca: 'security',
            relatorios: 'relatorios',
            ajuda: 'support'
          },
          notifications: {
            conversations: 8,
            sales: 3,
            alerts: 2
          },
          toggle(event, cat) {
            event.preventDefault();
            this.active = cat;
            localStorage.setItem("activeAdminCat", cat);
            this.updateSidebar();
            // Navigate to the tab using the mapping
            // Navigate to the tab using the mapping
            const tabName = this.categoryToTabMap[cat] || cat;
            window.location.href = `/admin?tab=${tabName}`;
          },
          updateSidebar() {
            const titleEl = document.getElementById('sidebar-title');
            const navEl = document.getElementById('sidebar-nav');
            if (titleEl && navEl) {
              const cat = this.mainCategories.find(c => c.id === this.active);
              titleEl.textContent = cat ? cat.name : 'Dashboard';
              navEl.innerHTML = (this.submenus[this.active] || []).map(sub =>
                `<a href="${sub.href}" class="block px-5 py-3 rounded-lg hover:bg-gray-800 text-gray-200 transition relative group">
                  ${sub.title}
                  ${sub.badge ? `<span class="absolute right-4 top-1/2 -translate-y-1/2 bg-red-600 text-white text-xs px-2 py-0.5 rounded-full">${sub.badge}</span>` : ''}
                </a>`
              ).join('');
            }
          },
          updateNotifications() {
            // Simula atualização de notificações em tempo real
            this.notifications.conversations = Math.floor(Math.random() * 15) + 5;
            this.notifications.sales = Math.floor(Math.random() * 5) + 1;
            this.notifications.alerts = Math.floor(Math.random() * 3);
          },
          init() {
            this.updateSidebar();
            // Atualiza notificações a cada 30 segundos
            setInterval(() => this.updateNotifications(), 30000);
          }
        }));
      });
    </script>

    <div x-data="sidebar" x-init="init()" class="flex flex-col h-screen bg-gray-950 text-white overflow-hidden">
      <!-- Top Bar: Categorias principais com efeitos premium -->
      <header class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-r from-black/95 via-black/90 to-black/95 backdrop-blur-xl border-b border-gray-800/50 px-8 py-4 shadow-2xl">
        <div class="flex items-center justify-between max-w-screen-2xl mx-auto">
          <div class="flex items-center space-x-8">
            <!-- Logo com efeito neon -->
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center shadow-lg shadow-purple-500/30">
                <span class="text-white font-bold text-lg">G</span>
              </div>
              <h1 class="text-2xl font-bold bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400 bg-clip-text text-transparent">
                GetNexo
              </h1>
            </div>
            
            <!-- Navegação principal com efeitos (Scroll Horizontal) -->
            <nav class="flex-1 overflow-x-auto scrollbar-hide ml-8 mr-4 mask-linear-fade">
              <div class="flex space-x-2 whitespace-nowrap py-1">
                {mainCategories.map((cat) => (
                  <button
                    @click={`toggle($event, '${cat.id}')`}
                    class:list={[
                      "flex items-center px-4 py-2 rounded-full transition-all duration-300 relative group overflow-hidden shrink-0",
                      active === cat.id
                        ? `bg-gradient-to-r from-${cat.color}-600/40 to-${cat.color}-700/40 text-${cat.color}-300 border border-${cat.color}-500/50 shadow-lg shadow-${cat.color}-500/20`
                        : `bg-gray-900/50 hover:bg-${cat.color}-900/30 text-gray-300 border border-gray-700/50 hover:border-${cat.color}-500/30`
                    ]}
                  >
                    <span class="relative z-10 flex items-center text-sm font-medium">
                      <cat.icon className="w-4 h-4 mr-2" />
                      {cat.name}
                      {cat.count && (
                        <span class="ml-2 bg-red-600 text-white text-[10px] px-1.5 py-0.5 rounded-full shadow-md animate-pulse">
                          {cat.count}
                        </span>
                      )}
                    </span>
                    {active === cat.id && (
                      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    )}
                  </button>
                ))}
              </div>
            </nav>
          </div>
          
          <!-- Área de notificações e usuário -->
          <div class="flex items-center space-x-6">
            <!-- Notificações em tempo real -->
            <div class="flex items-center space-x-4">
              <div class="flex items-center space-x-2 text-cyan-400 text-sm">
                <span class="w-2 h-2 bg-cyan-400 rounded-full animate-pulse"></span>
                <span x-text="notifications.conversations"></span>
                <span class="text-gray-500">conversas</span>
              </div>
              <div class="flex items-center space-x-2 text-emerald-400 text-sm">
                <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
                <span x-text="notifications.sales"></span>
                <span class="text-gray-500">vendas</span>
              </div>
              <div class="flex items-center space-x-2 text-amber-400 text-sm" x-show="notifications.alerts > 0">
                <span class="w-2 h-2 bg-amber-400 rounded-full animate-pulse"></span>
                <span x-text="notifications.alerts"></span>
                <span class="text-gray-500">alertas</span>
              </div>
            </div>
            
            <!-- Perfil e logout -->
            <div class="flex items-center space-x-4 border-l border-gray-700 pl-6">
              <div class="text-right">
                <div class="text-sm font-semibold text-white">Master: Leandro</div>
                <div class="text-xs text-purple-400">Admin Full Access</div>
              </div>
              <a href="/logout" class="px-4 py-2 bg-red-600/20 hover:bg-red-600/40 text-red-400 hover:text-red-300 rounded-lg transition-all duration-300 border border-red-600/30 hover:border-red-500/50 text-sm font-medium">
                Sair
              </a>
            </div>
          </div>
        </div>
      </header>

      <!-- Sidebar Esquerda: Submenus da categoria ativa com efeitos premium -->
      <aside class="fixed left-0 top-16 w-72 h-full bg-gradient-to-b from-gray-900 to-gray-950 border-r border-gray-800/50 overflow-y-auto pt-6 px-4 shadow-xl">
        <!-- Cabeçalho do sidebar com gradiente -->
        <div class="mb-6 px-4">
          <h2 class="text-lg font-bold text-white mb-1" id="sidebar-title">Dashboard</h2>
          <div class="h-1 w-12 bg-gradient-to-r from-purple-500 to-cyan-500 rounded-full"></div>
        </div>
        
        <!-- Navegação com efeitos -->
        <nav class="space-y-1" id="sidebar-nav">
          {submenus.dashboard.map((sub) => (
            <a href={sub.href} class="group flex items-center justify-between px-5 py-3 rounded-lg bg-gray-900/50 hover:bg-gray-800 text-gray-300 hover:text-white transition-all duration-300 border border-transparent hover:border-gray-700/50">
              <span class="flex items-center">
                <span class="w-1.5 h-1.5 bg-gray-600 rounded-full mr-3 group-hover:bg-cyan-400 group-hover:scale-125 transition-all"></span>
                {sub.title}
              </span>
              {sub.badge && (
                <span class="bg-red-600/80 text-white text-xs px-2 py-0.5 rounded-full group-hover:bg-red-500 transition-colors">
                  {sub.badge}
                </span>
              )}
            </a>
          ))}
        </nav>
        
        <!-- Indicador de status do sistema -->
        <div class="mt-8 px-4 py-3 bg-gray-900/50 rounded-lg border border-gray-800/50">
          <div class="flex items-center justify-between text-xs">
            <span class="text-gray-500">Sistema</span>
            <span class="flex items-center text-emerald-400">
              <span class="w-2 h-2 bg-emerald-400 rounded-full mr-2 animate-pulse"></span>
              Online
            </span>
          </div>
        </div>
      </aside>

      <!-- Área Central Grande (content) com efeitos premium -->
      <main class="ml-72 mt-16 flex-1 overflow-hidden">
        <!-- Barra de breadcrumbs e ações -->
        <div class="bg-gray-900/50 border-b border-gray-800/50 px-10 py-4 flex items-center justify-between">
          <div class="flex items-center space-x-2 text-sm text-gray-400">
            <span>Admin</span>
            <span class="text-gray-600">/</span>
            <span class="text-white font-medium" id="current-section">Dashboard</span>
          </div>
          <div class="flex items-center space-x-3">
            <button class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-lg text-sm transition-colors">
              Atualizar
            </button>
            <button class="px-3 py-1.5 bg-purple-600/20 hover:bg-purple-600/40 text-purple-400 rounded-lg text-sm transition-colors border border-purple-600/30">
              + Nova Ação
            </button>
          </div>
        </div>
        
        <!-- Área de conteúdo com scroll suave -->
        <div class="h-full overflow-y-auto p-8 scroll-smooth">
          <div class="max-w-7xl mx-auto">
            <slot />
            

            
            <!-- Fallback se slot vazio -->
            <div x-show="$el.parentNode.innerText.trim() === $el.innerText.trim()" class="text-center text-gray-500 text-xl mt-20" style="display: none;">
              <div class="mb-4 text-6xl">👻</div>
              <p>Conteúdo não carregado.</p>
              <p class="text-sm mt-2">Clique em um menu à esquerda ou <a href="/admin" class="text-cyan-400 hover:underline">Recarregue o Dashboard</a>.</p>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>

<style is:global>
	:root {
		--bg: #030303;
		--sidebar: #080808;
		--border: #1a1a1a;
		--accent: #00f7ff; /* Neon Blue */
		--gold: #ffc400; /* Cyber Gold */
		--void: #050505;
		--text: #e0e0e0;
		--text-muted: #666;
		--neon-glow: 0 0 10px rgba(0, 247, 255, 0.3);
		--purple-glow: 0 0 15px rgba(168, 85, 247, 0.4);
		--pink-glow: 0 0 15px rgba(236, 72, 153, 0.4);
	}

	* { box-sizing: border-box; margin: 0; padding: 0; }

	body {
		font-family: 'Inter', sans-serif;
		background: var(--bg);
		color: var(--text);
		height: 100vh;
		display: flex;
		overflow: hidden;
	}

	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: #0a0a0a;
	}
	::-webkit-scrollbar-thumb {
		background: linear-gradient(180deg, #333, #555);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
