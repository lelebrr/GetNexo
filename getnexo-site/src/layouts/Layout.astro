      0% { transform: scale(1) rotate(0deg); }
      50% { transform: scale(0.9) rotate(3deg); }
      100% { transform: scale(0.95) rotate(2deg); }
    }

    /* Efeitos de brilho nos cliques */
    .feriado-ativo button:active::before,
    .feriado-ativo a:active::before,
    .feriado-ativo .btn-start:active::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 0%, transparent 70%);
      transform: translate(-50%, -50%);
      animation: holidayRipple 0.6s ease-out;
      pointer-events: none;
    }

    @keyframes holidayRipple {
      0% {
        width: 0;
        height: 0;
        opacity: 1;
      }
      100% {
        width: 300px;
        height: 300px;
        opacity: 0;
      }
    }

    /* Confete Caindo - Otimizado */
    .confete_caindo {
      background-image: url('/assets/holidays/confetti-bg.png');
      background-size: cover;
      background-position: center;
      animation: confettiFall 20s linear infinite;
      will-change: background-position;
    }
    @keyframes confettiFall {
      0% { background-position: 0 0; }
      100% { background-position: 0 200vh; }
    }

    /* Fogos de Contagem Regressiva */
    .fogos_contagem {
      background: radial-gradient(circle at 30% 20%, rgba(255, 87, 51, 0.3) 0%, transparent 50%),
                  radial-gradient(circle at 70% 80%, rgba(255, 0, 150, 0.3) 0%, transparent 50%);
      animation: fireworks 3s ease-in-out infinite alternate;
    }

    /* Neve Caindo */
    .neve_luzes {
      background-image: url('/assets/holidays/snow-bg.png');
      background-size: cover;
      animation: snowFall 25s linear infinite;
    }
    @keyframes snowFall {
      0% { background-position: 0 0; }
      100% { background-position: 0 150vh; }
    }

    /* Ovos Pulando */
    .ovos_pulando {
      background-image: url('/assets/holidays/eggs-bg.png');
      background-size: 100px;
      animation: eggsBounce 4s ease-in-out infinite;
    }
    @keyframes eggsBounce {
      0%, 100% { background-position: 0 0; transform: scale(1); }
      50% { background-position: 50px 20px; transform: scale(1.05); }
    }

    /* Corações Flutuando */
    .corações_flutuando {
      background-image: url('/assets/holidays/hearts-bg.png');
      animation: heartsFloat 12s ease-in-out infinite;
    }
    @keyframes heartsFloat {
      0% { background-position: 0 0; }
      50% { background-position: 100px 50px; opacity: 0.8; white-space: pre-line; }
      100% { background-position: 0 100px; opacity: 1; }
    }

    /* Bandeira BR Ondulando */
    .bandeira_br {
      background-image: url('/assets/holidays/flag-br-bg.png');
      animation: flagWave 6s ease-in-out infinite;
    }
    @keyframes flagWave {
      0%, 100% { background-position: 0 0; }
      50% { background-position: 20px 10px; }
    }

    /* Desconto Explosão */
    .desconto_explosao {
      background: linear-gradient(45deg, #ff4444, #ff8888, #ff4444);
      animation: discountExplode 2s ease-in-out infinite;
    }
    @keyframes discountExplode {
      0%, 100% { transform: scale(1); opacity: 0.7; }
      50% { transform: scale(1.1); opacity: 1; }
    }

    /* Balões Subindo */
    .baloes_brinquedos {
      background-image: url('/assets/holidays/balloons-bg.png');
      animation: balloonsRise 15s linear infinite;
    }
    @keyframes balloonsRise {
      0% { background-position: 0 100vh; }
      100% { background-position: 0 -100vh; }
    }

    /* Luz Azul Suave */
    .luz_azul {
      background: radial-gradient(circle, rgba(0, 150, 255, 0.3) 0%, transparent 70%);
      animation: blueLight 4s ease-in-out infinite alternate;
    }
    @keyframes blueLight {
      0% { opacity: 0.4; }
      100% { opacity: 0.8; white-space: pre-line; }
    }

    /* Velas Cinza */
    .velas_cinza {
      background-image: url('/assets/holidays/candles-bg.png');
      animation: candlesFlicker 3s ease-in-out infinite alternate;
    }
    @keyframes candlesFlicker {
      0%, 100% { opacity: 0.5; }
      50% { opacity: 0.8; white-space: pre-line; }
    }

    /* Bandeira Republicana */
    .bandeira_republica {
      background-image: url('/assets/holidays/flag-republic-bg.png');
      animation: republicFlag 5s ease-in-out infinite;
    }
    @keyframes republicFlag {
      0%, 100% { background-position: 0 0; }
      50% { background-position: 15px 8px; }
    }

    /* Pantera Preta */
    .pantera_preta {
      background: linear-gradient(45deg, #000000, #333333, #000000);
      animation: pantherGlow 4s ease-in-out infinite alternate;
    }
    @keyframes pantherGlow {
      0% { opacity: 0.6; }
      100% { opacity: 0.9; }
    }

    /* Flores Roxas */
    .flores_roxa {
      background-image: url('/assets/holidays/purple-flowers-bg.png');
      animation: flowersBloom 8s ease-in-out infinite;
    }
    @keyframes flowersBloom {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.05); }
    }

    /* Flores Rosa */
    .flores_rosa {
      background-image: url('/assets/holidays/pink-flowers-bg.png');
      animation: pinkFlowers 8s ease-in-out infinite;
    }
    @keyframes pinkFlowers {
      0%, 100% { opacity: 0.6; background-position: 0 0; }
      50% { opacity: 1; background-position: 50px 20px; }
    }

    /* Martelo Girando */
    .martelo_girando {
      background-image: url('/assets/holidays/hammer-bg.png');
      animation: hammerSpin 6s linear infinite;
    }
    @keyframes hammerSpin {
      0% { background-position: 0 0; transform: rotate(0deg); }
      100% { background-position: 100px 50px; transform: rotate(360deg); }
    }

    /* Hóstia Luz */
    .hostia_luz {
      background: radial-gradient(circle, rgba(255, 255, 150, 0.3) 0%, transparent 70%);
      animation: hostLight 4s ease-in-out infinite alternate;
    }
    @keyframes hostLight {
      0% { opacity: 0.4; }
      100% { opacity: 0.8; white-space: pre-line; }
    }

    /* Fogueira Balões */
    .fogueira_baloes {
      background-image: url('/assets/holidays/bonfire-bg.png');
      animation: bonfireGlow 3s ease-in-out infinite alternate;
    }
    @keyframes bonfireGlow {
      0% { opacity: 0.5; background-position: 0 0; }
      100% { opacity: 0.9; background-position: 30px 10px; }
    }

    /* Carrinho Desconto */
    .carrinho_desconto {
      background-image: url('/assets/holidays/cart-discount-bg.png');
      animation: cartDiscount 5s ease-in-out infinite;
    }
    @keyframes cartDiscount {
      0%, 100% { background-position: 0 0; transform: scale(1); }
      50% { background-position: 50px 20px; transform: scale(1.1); }
    }

    /* Loja Aberta */
    .loja_aberta {
      background: linear-gradient(45deg, rgba(0, 255, 0, 0.2), rgba(0, 200, 0, 0.1));
      animation: shopOpen 4s ease-in-out infinite alternate;
    }
    @keyframes shopOpen {
      0% { opacity: 0.6; }
      100% { opacity: 1; }
    }

    /* 🎉 Notificação de Feriado */
    .feriado-notification {
      position: fixed;
      top: 100px;
      right: 30px;
      max-width: 350px;
      z-index: 10000;
      animation: slideInRight 0.5s ease-out;
      border-color: rgba(0, 255, 157, 0.3);
      background: rgba(15, 23, 42, 0.95);
    }

    .feriado-content {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
    }

    .feriado-emoji {
      font-size: 2rem;
      animation: bounce 2s ease-in-out infinite;
    }

    .feriado-text h4 {
      color: var(--primary);
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .feriado-text p {
      color: white;
      font-size: 0.9rem;
      margin: 0;
    }

    .feriado-close {
      background: none;
      border: none;
      color: var(--text);
      font-size: 1.5rem;
      cursor: pointer;
      padding: 0.5rem;
      transition: 0.3s;
    }

    .feriado-close:hover {
      color: var(--primary);
    }

    @keyframes slideInRight {
      from { transform: translateX(100%); opacity: 0; }
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
      40% { transform: translateY(-10px); }
      60% { transform: translateY(-5px); }
    }

    /* Mobile ajustes para feriados */
    @media (max-width: 768px) {
      .feriado-notification {
        right: 20px;
        left: 20px;
        max-width: none;
        top: 80px;
      }
    }
  </style>

  <div id="discovery-hub" class="discovery-hub">
    <div class="hub-container glass-panel reveal">
      <div class="hub-header">
        <h3 class="text-gradient">Nexbot Discovery Hub</h3>
        <button id="hub-close" class="hub-close">×</button>
      </div>
      <div class="hub-body">
        <p class="hub-intro">Explore as ferramentas que estão transformando o WhatsApp em máquinas de lucro.</p>
        <div class="hub-features">
          <div class="hub-feature" data-tour="checkout">
            <span class="hub-icon">💰</span>
            <div class="hub-info">
              <strong>Checkout PIX</strong>
              <span>Venda no chat em 2 min</span>
            </div>
          </div>
          <div class="hub-feature" data-tour="ia">
            <span class="hub-icon">🧠</span>
            <div class="hub-info">
              <strong>IA Generativa</strong>
              <span>Treine seu bot com PDFs</span>
            </div>
          </div>
          <div class="hub-feature" data-tour="ads">
            <span class="hub-icon">🚀</span>
            <div class="hub-info">
              <strong>Click-to-WhatsApp</strong>
              <span>Anúncios que convertem</span>
            </div>
          </div>
        </div>
        <div class="hub-footer">
          <a href="/criar-bot" class="btn-primary-glow w-full">Ativar Todas as Soluções</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Global Floating UI - Left (Unified Accessibility & Tour) -->
  <div class="dock-left">
    <div class="accessibility-wrapper">
        <AccessibilityControls nonce={nonce} />
    </div>
    <slot name="dock-left" />
  </div>

  <!-- Global Floating UI - Right (Chat & Support) -->
  <div class="dock-right">
    <WhatsAppFloat />
  </div>

  <CookieConsent nonce={nonce} />
  <PreSupportModal nonce={nonce} />
  <ClippyAssistants nonce={nonce} />

  <style is:global>
    .dock-left {
      position: fixed; bottom: 24px; left: 24px;
      display: flex; flex-direction: column-reverse; gap: 12px; z-index: 9999;
      pointer-events: none;
    }
    .dock-right {
      position: fixed; bottom: 24px; right: 24px;
      display: flex; flex-direction: column-reverse; gap: 12px; z-index: 9999;
      pointer-events: none;
    }
    .dock-left > *, .dock-right > * { pointer-events: auto; }

    /* Component Fixed Overrides for Docks */
    .accessibility-trigger, .tour-trigger-btn, .whatsapp-float-btn {
      position: relative !important;
      bottom: auto !important;
      right: auto !important;
      left: auto !important;
    }

    @media (max-width: 768px) {
        .dock-left { bottom: 10px; left: 10px; gap: 8px; }
        .dock-right { bottom: 10px; right: 10px; gap: 8px; }
    }
  </style>


  <!-- Header & Mobile Menu Scripts -->
  <script is:inline nonce={nonce}>
    document.addEventListener('DOMContentLoaded', () => {
      const header = document.getElementById('main-nav');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileClose = document.getElementById('mobile-close');
      const backToTopBtn = document.getElementById('back-to-top');

      // Header Scroll Effect
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
        
        // Back to Top logic
        if (backToTopBtn) {
          if (window.scrollY > 500) {
            backToTopBtn.classList.add('visible');
          } else {
            backToTopBtn.classList.remove('visible');
          }
        }
      });

      // Mobile Menu Logic
      const toggleMobile = () => {
        mobileMenu.classList.toggle('active');
        document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
      };

      mobileBtn?.addEventListener('click', toggleMobile);
      mobileClose?.addEventListener('click', toggleMobile);
      
      // Close on link click
      mobileMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('active');
          document.body.style.overflow = '';
        });
      });

      // Discovery Hub Logic
      const magicBtn = document.getElementById('magic-discovery');
      const hub = document.getElementById('discovery-hub');
      const hubClose = document.getElementById('hub-close');

      const toggleHub = () => {
        hub?.classList.toggle('active');
        document.body.style.overflow = hub?.classList.contains('active') ? 'hidden' : '';
      };

      magicBtn?.addEventListener('click', toggleHub);
      hubClose?.addEventListener('click', toggleHub);
      
      hub?.addEventListener('click', (e) => {
        if (e.target === hub) toggleHub();
      });

      // Parallax Mouse Glow for Header (Surprise!)
      header?.addEventListener('mousemove', (e) => {
        const { left, top, width, height } = header.getBoundingClientRect();
        const x = ((e.clientX - left) / width) * 100;
        const y = ((e.clientY - top) / height) * 100;
        header.style.setProperty('--mouse-x', `${x}%`);
        header.style.setProperty('--mouse-y', `${y}%`);
        header.style.background = `radial-gradient(circle at ${x}% ${y}%, rgba(0, 212, 255, 0.15) 0%, rgba(3, 7, 18, 0.8) 50%)`;
      });
      
      header?.addEventListener('mouseleave', () => {
        header.style.background = '';
      });

      // Back to Top Click
      backToTopBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  </script>

  <style is:global>
    body, html {
      margin: 0 !important;
      padding: 0 !important;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
  </style>
</body>
</html>
