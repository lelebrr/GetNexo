  </style>
  
  <!-- Script de trusted-types-policy removido - não existe no projeto -->
  
  <script nonce={Astro.locals.nonce} define:vars={{ trustedTypesPolicy }}>
    (function() {
      try {
        var bgType = localStorage.getItem('getnexo-bg-type') || 'animated';
        document.documentElement.setAttribute('data-bg-type', bgType);
        
        // Initialize global state for dynamic scripts
        window.getNexoState = {
          scriptsLoaded: false,
          scriptsLoading: false
        };
        
        // Use explicit assignment to avoid SyntaxError with object literals if transpilation varies
        window.GETNEXO_CONFIG = {};
        window.GETNEXO_CONFIG.bgType = bgType;
        window.GETNEXO_CONFIG.trustedTypesPolicy = trustedTypesPolicy;
        
        // Force unregister service workers
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(function(registrations) {
            for(var i = 0; i < registrations.length; i++) {
              registrations[i].unregister();
            }
          });
        }
      } catch (e) {
        console.warn('LocalStorage access blocked:', e);
      }
    })();
  </script>
