      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .mobile-menu.active {
      display: flex;
      opacity: 1;
    }
    .mobile-nav {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
