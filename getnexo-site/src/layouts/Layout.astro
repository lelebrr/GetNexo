  <!-- Otimizações para dispositivos de baixa potência -->
  <script is:inline nonce={nonce}>
    // Battery awareness e reduce motion
    class PerformanceOptimizer {
      constructor() {
        this.init();
      }

      async init() {
        // Detectar bateria baixa
        if ('getBattery' in navigator) {
          try {
            const battery = await navigator.getBattery();
            this.handleBatteryChange(battery);

            battery.addEventListener('levelchange', () => this.handleBatteryChange(battery));
            battery.addEventListener('chargingchange', () => this.handleBatteryChange(battery));
          } catch (e) {
            console.warn('Battery API not supported');
          }
        }

        // Detectar preferência de movimento reduzido
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          this.enableReducedMotion();
        }
      }

      handleBatteryChange(battery) {
        const isLowBattery = battery.level < 0.2 && !battery.charging;

        if (isLowBattery) {
          document.documentElement.classList.add('low-battery-mode');
          // Pausar animações pesadas
          if (window.neuralBG && window.neuralBG.pause) {
            window.neuralBG.pause();
          }
          // Reduzir polling
          window.lowBatteryMode = true;
        } else {
          document.documentElement.classList.remove('low-battery-mode');
          window.lowBatteryMode = false;
        }
      }

      enableReducedMotion() {
        document.documentElement.classList.add('reduced-motion');
        // Injetar CSS para reduzir animações
        const style = document.createElement('style');
        style.textContent = `
          *, *::before, *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
          }
          .animated-bg { display: none !important; }
        `;
        document.head.appendChild(style);
      }
    }

    // Inicializar quando DOM estiver pronto
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => new PerformanceOptimizer());
    } else {
      new PerformanceOptimizer();
    }
  </script>

  <!-- GetNexo Custom Widget -->
  <script is:inline data-cfasync="false" nonce={nonce}>
    (function(d,t) {
      const loadWidget = () => {
        const isMobile = window.innerWidth < 768;
        const delay = isMobile ? 3000 : 0;
        
        setTimeout(() => {
          var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
          g.src="https://api.getnexo.com.br/widget.js";
          g.defer = true;
          g.async = true;
          g.setAttribute('data-bot', 'central');
          s.parentNode.insertBefore(g,s);
        }, delay);
      };

      if (document.readyState === 'complete') {
        loadWidget();
      } else {
        window.addEventListener('load', loadWidget);
      }
    })(document,"script");

    // Mobile Menu Toggle Logic
    document.addEventListener('DOMContentLoaded', () => {
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          menuBtn.classList.toggle('active');
          mobileMenu.classList.toggle('active');
          document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
        });

        // Close menu on link click
        mobileMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menuBtn.classList.remove('active');
            mobileMenu.classList.remove('active');
            document.body.style.overflow = '';
          });
        });
      }

      // Safety: Reveal all hidden elements if JS/Animations take too long
      setTimeout(() => {
        document.querySelectorAll('.reveal, .fade-in').forEach(el => {
          el.classList.add('active');
          el.classList.add('visible');
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
      }, 3000);
    });
  </script>
