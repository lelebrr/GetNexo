---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import PreSupportModal from '../components/PreSupportModal.astro';
import AccessibilityControls from '../components/AccessibilityControls.astro';
import CookieConsent from '../components/CookieConsent.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import ClippyAssistants from '../components/ClippyAssistants.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import TourGuided from '../components/TourGuided.astro';

const {
  title = "Chatbot WhatsApp IA Grátis Self-Hosted – Fecha Vendas 24h | GetNexo PIX Automático",
  description = "Chatbot WhatsApp IA grátis self-hosted: fecha vendas sozinho 24/7 no seu domínio. Sem taxa por mensagem, integra PIX automático, estoque, frete. Teste 7 dias grátis. API Meta Oficial + CRM IA.",
  keywords = "chatbot whatsapp gratis, chatbot whatsapp ia, automacao whatsapp vendas, chatbot whatsapp self hosted, pix no whatsapp automatico, ia whatsapp vendas, chatbot whatsapp conversao, vendas whatsapp 24h, chatbot whatsapp api oficial, getnexo chatbot whatsapp, chatbot whatsapp gratis brasil, chatbot whatsapp ia vendas, chatbot whatsapp sem mensalidade, chatbot whatsapp self hosted, chatbot whatsapp api meta, chatbot whatsapp pix automatico, chatbot whatsapp crm integrado",
  isLanding = false,
  preloadImage,
  ogImage = "https://getnexo.com.br/assets/og-poster.jpg",
  articleSchema = null,
  type = "website"
} = Astro.props;

const lang = Astro.url.pathname.split('/')[1] || 'pt';
let t;
try {
  const translations = await import(`../i18n/${lang}.json`);
  t = translations.default;
} catch (e) {
  const translations = await import(`../i18n/pt.json`);
  t = translations.default;
}

// Verificar feriados ativos para carregar CSS condicionalmente
let feriadoAtivo = false;
try {
  const feriadosResponse = await fetch('/data/feriados.json');
  const data = await feriadosResponse.json();
  const hoje = new Date().toISOString().slice(0,10);
  const ano = new Date().getFullYear();

  // Importar funções de cálculo de feriados
  const { verificaDataVariavel } = await import('../lib/feriados.js');

  // Verificar se há feriado ativo
  const feriadoHoje = data.feriados.find(f => {
    if (f.data === hoje) return true;
    const dataCalculada = verificaDataVariavel(f.data, ano);
    return dataCalculada === hoje;
  });

  feriadoAtivo = !!feriadoHoje;
} catch (error) {
  console.log('Erro ao verificar feriados:', error);
}

const nonce = Astro.locals.nonce;
const clientId = Astro.locals.clientId || 'default';
---
<!doctype html>
<html lang={lang}>
<head>
  <SEO 
    title={title}
    description={description}
    keywords={keywords}
    image={ogImage}
    lang={lang}
    type={type}
    structuredData={articleSchema}
  />
  
  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json">

  <!-- White-label CSS -->
  {clientId !== 'default' && (
    <link rel="stylesheet" href={`https://api.getnexo.com.br/api/whitelabel/css/${clientId}`} />
  )}

  <!-- Holiday Effects CSS - Carregado dinamicamente quando há feriados -->
  {feriadoAtivo && (
    <link rel="stylesheet" href="/custom/css/holiday-effects.css" />
  )}

  <!-- Desabilitar Rocket Loader do Cloudflare -->
  <meta name="cf-rocket-loader" content="false" />

  <slot name="head" />

  <!-- Animate On Scroll (Inline) -->
  <style>
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .animate-on-scroll.animate-in {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.animate-on-scroll').forEach(el => {
        observer.observe(el);
      });
    });
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style is:inline>
      /* Critical LCP Styles */
      .logo-text { font-family: 'Inter', sans-serif; font-weight: 800; visibility: visible !important; opacity: 1 !important; }
      @media (max-width: 768px) {
        .hero-title { font-size: 2.2rem !important; }
        .hero-split { padding-top: 6rem !important; }
      }
    </style>
  <style is:global define:vars={{ mainPadding: isLanding ? '0' : '80px', mainMinHeight: isLanding ? 'auto' : '100vh' }}>
    :root { 
      --primary: var(--primary); 
      --success: var(--success); 
      --dark: #030712; 
      --gray: #111827; 
      --light: #f8fafc; 
      --text: #94a3b8; 
      --glass: rgba(15, 23, 42, 0.7);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { 
      font-family: 'Inter', system-ui, sans-serif; 
      background: var(--dark); 
      color: var(--light); 
      line-height: 1.6; 
      overflow-x: hidden; 
    }

    /* Premium Common Styles */
    .text-gradient { background:linear-gradient(90deg, var(--primary), var(--success)); -webkit-background-clip:text; color:transparent; font-weight: 800; }
    .glass-panel { background: var(--glass); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.05); border-radius: 20px; }

    /* Foco Visível */
    :focus { outline: 3px solid var(--success); }

    /* Animated Background */
    .animated-bg { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: -1; overflow: hidden; background: #030712; }
    .blob { position: absolute; width: 600px; height: 600px; background: radial-gradient(circle, rgba(0, 212, 255, 0.15) 0%, transparent 70%); border-radius: 50%; filter: blur(80px); animation: move 20s infinite alternate; }
    .blob-1 { top: -100px; left: -100px; }
    .blob-2 { bottom: -100px; right: -100px; background: radial-gradient(circle, rgba(0, 255, 157, 0.10) 0%, transparent 70%); }
    @keyframes move { from { transform: translate(0, 0); } to { transform: translate(100px, 100px); } }

    /* Layout Parts */
    main { padding-top: var(--mainPadding); min-height: var(--mainMinHeight); }

    .global-header {
      background: rgba(3, 7, 18, 0.95);
      backdrop-filter: blur(20px);
      position: fixed; top: 0; width: 100%; z-index: 1000;
      padding: 1rem 5%;
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }
    .logo-link { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; }
    .logo-box {
      width: 48px; height: 48px;
      background: linear-gradient(135deg, var(--primary), var(--success));
      color: black;
      display: flex; align-items: center; justify-content: center;
      font-weight: 900; border-radius: 12px; font-size: 1.2rem;
      box-shadow: 0 4px 20px rgba(0, 212, 255, 0.4);
      position: relative;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    .logo-box::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: linear-gradient(45deg, transparent, rgba(255,255,255,0.2), transparent);
      transform: rotate(45deg);
      transition: all 0.3s;
    }
    .logo-box:hover {
      transform: scale(1.1) rotate(5deg);
      box-shadow: 0 8px 30px rgba(0, 212, 255, 0.6);
    }
    .logo-box:hover::before {
      animation: shimmer 1.5s;
    }
    @keyframes shimmer {
      0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
      100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
    }
    .logo-text { color:white; font-weight: 800; font-size: 1.2rem; margin:0; letter-spacing: -0.3px; display: flex; align-items: center; }
    .logo-text span.logo-highlight { color: var(--success); }

    .nav-links { display: flex; align-items: center; gap: 0.5rem; }
    .nav-links > li { position: relative; }
    .nav-links a {
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      padding: 0.8rem 1.2rem;
      border-radius: 12px;
      position: relative;
      overflow: hidden;
    }
    .nav-links a::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.1), transparent);
      transition: left 0.5s;
    }
    .nav-links a:hover {
      color: white;
      background: rgba(0, 212, 255, 0.15);
      border: 1px solid rgba(0, 212, 255, 0.3);
      transform: scale(1.05);
      box-shadow: 0 8px 25px rgba(0, 212, 255, 0.2);
    }
    .nav-links a:hover::before {
      left: 100%;
    }

    /* Dropdown Styles */
    .nav-dropdown { position: relative; }
    .nav-dropdown-toggle { cursor: pointer; display: flex; align-items: center; gap: 0.5rem; }
    .nav-dropdown-toggle::after { content: '▼'; font-size: 0.7rem; transition: 0.3s cubic-bezier(0.23, 1, 0.32, 1); }
    .nav-dropdown:hover .nav-dropdown-toggle::after { transform: rotate(180deg); }

    .nav-dropdown-menu {
      position: absolute; top: 110%; left: 50%; transform: translateX(-50%);
      min-width: 320px;
      background: rgba(15, 23, 42, 0.98); backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.15); border-radius: 16px;
      padding: 1.5rem; z-index: 1000; opacity: 0; visibility: hidden;
      transform: translateX(-50%) translateY(-10px); transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      box-shadow: 0 25px 50px rgba(0,0,0,0.4);
    }

    .nav-dropdown:hover .nav-dropdown-menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }

    .dropdown-section { margin-bottom: 1.5rem; }
    .dropdown-section:last-child { margin-bottom: 0; }
    .dropdown-title { font-size: 0.8rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; }
    .dropdown-links { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
    .dropdown-links a {
      padding: 0.8rem 1rem;
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: 10px;
      transition: all 0.3s ease;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.05);
    }
    .dropdown-links a:hover {
      background: rgba(0, 212, 255, 0.15);
      color: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 212, 255, 0.2);
    }

    /* Search Bar */
    .search-container { position: relative; margin-left: 1rem; }
    .search-input {
      background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
      color: white; padding: 0.4rem 2.5rem 0.4rem 1rem; border-radius: 20px;
      font-size: 0.85rem; width: 200px; outline: none; transition: 0.3s;
    }
    .search-input::placeholder { color: #94a3b8; }
    .search-input:focus { width: 250px; background: rgba(255,255,255,0.15); border-color: var(--primary); }
    .search-btn {
      position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: var(--primary); cursor: pointer; font-size: 1rem;
    }

    .header-ctas { display: flex; align-items: center; gap: 1rem; }
    .btn-login { color: white; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
    .btn-start {
      background: linear-gradient(135deg, var(--primary), var(--success));
      color: black;
      padding: 0.8rem 2rem;
      border-radius: 16px;
      font-weight: 900;
      text-decoration: none;
      font-size: 1rem;
      transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 8px 25px rgba(0, 212, 255, 0.3);
      border: 2px solid transparent;
    }
    .btn-start::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.5s;
    }
    .btn-start:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 12px 35px rgba(0, 212, 255, 0.5);
      border-color: rgba(255,255,255,0.3);
    }
    .btn-start:hover::before {
      left: 100%;
    }

    /* Language Selector */
    .lang-selector {
      position: relative;
      display: inline-block;
    }
    .lang-btn {
      background: rgba(255,255,255,0.1);
      color: white;
      border: 1px solid rgba(255,255,255,0.2);
      padding: 0.5rem 0.8rem;
      border-radius: 12px;
      cursor: pointer;
      font-size: 1.1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .lang-btn:hover { background: rgba(0, 212, 255, 0.15); border-color: var(--primary); transform: translateY(-1px); }
    #current-lang-code { font-size: 0.75rem; color: #94a3b8; }
    .lang-dropdown {
      position: absolute;
      top: 100%;
      right: 0;
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      min-width: 120px;
      display: none;
      z-index: 9999;
      margin-top: 0.5rem;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }
    .lang-dropdown.show { display: block; animation: fadeInDown 0.2s ease-out; }
    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .lang-option {
      display: block;
      color: white;
      text-decoration: none;
      padding: 0.8rem 1rem;
      font-size: 0.85rem;
      transition: 0.2s;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .lang-option:last-child { border-bottom: none; }
    .lang-option:hover { background: rgba(0, 212, 255, 0.1); }

    .global-footer { padding: 10rem 5% 4rem; background: #020617; border-top: 1px solid rgba(255,255,255,0.05); margin-top: 6rem; position: relative; z-index: 10; }
    .footer-grid { display: grid; grid-template-columns: 1.5fr repeat(4, 1fr); gap: 3rem; max-width: 1400px; margin: 0 auto; }
    .footer-col h3.footer-title { color: white; margin-bottom: 2rem; font-size: 1.15rem; font-weight: 800; letter-spacing: -0.5px; text-transform: uppercase; }
    .footer-links { display: flex; flex-direction: column; gap: 0.8rem; }
    .footer-links a { color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .footer-links a:hover { color: var(--primary); transform: translateX(5px); }
    .branding-col .footer-description { font-size: 1rem; color: #94a3b8; line-height: 1.7; margin-bottom: 2rem; max-width: 300px; }
    .footer-socials { display: flex; gap: 1.2rem; flex-wrap: wrap; }
    .footer-socials a {
      color: var(--text);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      backdrop-filter: blur(10px);
    }
    .footer-socials a:hover {
      transform: translateY(-4px) scale(1.05);
      box-shadow: 0 8px 25px rgba(0, 212, 255, 0.2);
    }
    .footer-socials a svg {
      width: 20px;
      height: 20px;
      transition: all 0.3s ease;
    }

    /* Redes sociais específicas com cores */
    .social-link.whatsapp:hover { background: linear-gradient(135deg, #25d366, #4fce5d); color: white; border-color: #25d366; }
    .social-link.facebook:hover { background: linear-gradient(135deg, #1877f2, #42a5f5); color: white; border-color: #1877f2; }
    .social-link.instagram:hover {
      background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
      color: white;
      border-color: #e4405f;
    }
    .social-link.linkedin:hover { background: linear-gradient(135deg, #0077b5, #42a5f5); color: white; border-color: #0077b5; }
    .social-link.tiktok:hover { background: linear-gradient(135deg, #000000, #333333); color: white; border-color: #000000; }
    .social-link.twitter:hover { background: linear-gradient(135deg, #1da1f2, #42a5f5); color: white; border-color: #1da1f2; }
    .social-link.youtube:hover { background: linear-gradient(135deg, #ff0000, #ff4444); color: white; border-color: #ff0000; }
    .social-link.discord:hover { background: linear-gradient(135deg, #5865f2, #42a5f5); color: white; border-color: #5865f2; }
    .social-link.telegram:hover { background: linear-gradient(135deg, #0088cc, #42a5f5); color: white; border-color: #0088cc; }

    /* Efeitos de brilho nos ícones */
    .footer-socials a::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
      border-radius: 14px;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: -1;
    }
    .footer-socials a:hover::before {
      opacity: 1;
    }

    /* Animação de pulso */
    @keyframes socialPulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }
    .footer-socials a:hover svg {
      animation: socialPulse 0.6s ease-in-out;
    }
    
    /* Footer Newsletter */
    .newsletter-text { font-size: 0.9rem; color: #94a3b8; margin-bottom: 1rem; }
    .footer-newsletter { display: flex; gap: 0.5rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); padding: 0.3rem; border-radius: 12px; }
    .footer-newsletter input { flex: 1; background: transparent; border: none; color: white; padding: 0.5rem 0.8rem; font-size: 0.85rem; outline: none; }
    .footer-newsletter button { background: var(--primary); color: black; border: none; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 800; cursor: pointer; transition: 0.3s; }
    .footer-newsletter button:hover { transform: scale(1.05); background: var(--success); }

    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.05); margin-top: 6rem; padding-top: 3rem; text-align: center; color: #475569; font-size: 0.85rem; }

    /* Footer Logo Styles */
    .footer-logo { width: 60px; height: 60px; font-size: 1.5rem; margin-bottom: 1rem; }
    .footer-text { font-size: 1.5rem; }

    .mt-6 { margin-top: 1.5rem; }

    @media (max-width: 1200px) {
      .footer-grid { grid-template-columns: repeat(3, 1fr); gap: 3rem; }
      .branding-col { grid-column: span 3; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 3rem; }
    }
    @media (max-width: 768px) {
      .footer-grid { grid-template-columns: repeat(2, 1fr); }
      .branding-col { grid-column: span 2; }
      .newsletter-col { grid-column: span 2; padding-top: 3rem; border-top: 1px solid rgba(255,255,255,0.05); }
    }
    @media (max-width: 480px) {
      .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; text-align: center; }
      .branding-col, .newsletter-col { grid-column: span 1; }
      .footer-socials, .footer-newsletter { justify-content: center; max-width: 300px; margin-left: auto; margin-right: auto; }
      .footer-links a:hover { transform: scale(1.05); }
    }

    /* Security Section Styles */
    .security-section {
      background: linear-gradient(135deg, rgba(3, 7, 18, 0.95), rgba(15, 23, 42, 0.95));
      border-top: 1px solid rgba(255,255,255,0.05);
      border-bottom: 1px solid rgba(255,255,255,0.05);
      padding: 5rem 5%;
      margin: 4rem 0;
    }

    .security-container { max-width: 1200px; margin: 0 auto; }

    .security-title {
      text-align: center;
      font-size: 2.5rem;
      font-weight: 800;
      color: white;
      margin-bottom: 1rem;
      text-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
    }

    .security-subtitle {
      text-align: center;
      font-size: 1.2rem;
      color: var(--text);
      margin-bottom: 4rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    .security-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .security-item {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 2rem;
      text-align: center;
      transition: 0.3s;
      height: 100%;
    }

    .security-item:hover {
      border-color: rgba(0, 212, 255, 0.3);
      transform: translateY(-5px);
      background: rgba(15, 23, 42, 0.8);
      box-shadow: 0 20px 40px rgba(0, 212, 255, 0.1);
    }

    .security-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      display: block;
    }

    .security-item h3 {
      color: white;
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .security-item p {
      color: var(--text);
      line-height: 1.6;
      margin: 0;
      font-size: 0.9rem;
    }

    .security-cta {
      background: rgba(0, 212, 255, 0.1);
      border: 1px solid rgba(0, 212, 255, 0.2);
      border-radius: 20px;
      padding: 3rem;
      text-align: center;
    }

    .security-highlight {
      font-size: 1.3rem;
      color: var(--primary);
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .security-cta p {
