      color: var(--text);
      border: 1px solid rgba(255,255,255,0.2);
      padding: 1rem 2rem;
      border-radius: 12px;
      font-weight: 600;
      text-decoration: none;
      font-size: 1rem;
      transition: 0.3s;
      display: inline-block;
