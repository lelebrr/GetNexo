  <script is:inline nonce={nonce}>
    // Sincronização de Fundo Global
    (function() {
      // Escutar mudanças de configuração via storage (toggles no painel admin ou controles)
      window.addEventListener('storage', (e) => {
        if (e.key === 'getnexo-bg-type') {
          document.documentElement.setAttribute('data-bg-type', e.newValue || 'animated');
        }
      });
    })();
  </script>

  <!-- Neural Background Controls -->
