  <link rel="alternate" hreflang="en" href={`${baseUrl}/en${currentPath}`} />
  <link rel="alternate" hreflang="x-default" href={`${baseUrl}/pt${currentPath}`} />
  
  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json">

  <!-- White-label CSS -->
  {clientId !== 'default' && (
