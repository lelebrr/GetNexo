  <!-- Widget carregado de forma lazy e apenas quando necessário -->
  <!-- Carregamento atrasado para não bloquear o LCP com estratégias avançadas -->
  <script defer data-cfasync="false" nonce={nonce}>
    (function(d,t) {
      const loadWidget = () => {
        const isMobile = window.innerWidth < 768;
        // Atraso maior para não bloquear o LCP
        const delay = isMobile ? 8000 : 3000; // Aumentado para reduzir impacto no LCP

        setTimeout(() => {
          // Widget habilitado
          // Verificar se o servidor da API está acessível antes de tentar carregar
          fetch('/widget.js', {
            method: 'HEAD',
            mode: 'no-cors',
            cache: 'force-cache'
          }).then((response) => {
            if (response.ok || response.type === 'opaque') {
              var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
              g.src="/widget.js?v=" + Date.now();
              g.defer = true;
              g.async = true;
              g.crossOrigin = 'anonymous';
              g.setAttribute('data-bot', 'central');
              g.fetchpriority = 'low';

              g.onerror = function() {
                console.warn('[Widget] GetNexo widget failed to load - API unavailable');
              };

              s.parentNode.insertBefore(g,s);
            } else {
              console.warn('[Widget] GetNexo API returned error status:', response.status);
            }
          }).catch((error) => {
            console.warn('[Widget] GetNexo API unavailable:', error.message);
          });
        }, delay);
      };

      if (document.readyState === 'complete') {
        loadWidget();
      } else {
        window.addEventListener('load', loadWidget);
      }
    })(document,"script");
  </script>
  
  
  <!-- Scripts de animação de scroll e efeitos da Home - Otimizados para performance -->
