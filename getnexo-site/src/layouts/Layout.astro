  <!-- GetNexo Custom Widget -->
  <script is:inline data-cfasync="false" nonce={nonce}>
    (function(d,t) {
      const loadWidget = () => {
        const isMobile = window.innerWidth < 768;
        const delay = isMobile ? 3000 : 0;

        setTimeout(() => {
          // Widget temporariamente desabilitado
          return;
          // Verificar se o servidor da API está acessível antes de tentar carregar
          fetch('/widget.js', {
            method: 'HEAD',
            mode: 'no-cors'
          }).then((response) => {
            if (response.ok || response.type === 'opaque') {
              var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
              g.src="/widget.js?v=" + Date.now();
              g.defer = true;
              g.async = true;
              g.setAttribute('data-bot', 'central');

              g.onerror = function() {
                console.warn('[Widget] GetNexo widget failed to load - API unavailable');
              };

              s.parentNode.insertBefore(g,s);
            } else {
              console.warn('[Widget] GetNexo API returned error status:', response.status);
            }
          }).catch((error) => {
            console.warn('[Widget] GetNexo API unavailable:', error.message);
          });
        }, delay);
      };

      if (document.readyState === 'complete') {
        loadWidget();
      } else {
        window.addEventListener('load', loadWidget);
      }
    })(document,"script");

    // Mobile Menu Toggle Logic
    document.addEventListener('DOMContentLoaded', () => {
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          menuBtn.classList.toggle('active');
          mobileMenu.classList.toggle('active');
          document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
        });

        mobileMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menuBtn.classList.remove('active');
            mobileMenu.classList.remove('active');
            document.body.style.overflow = '';
          });
        });
      }

      // Language Selector Toggle Logic
      const langBtn = document.getElementById('lang-btn');
      const langDropdown = document.getElementById('lang-dropdown');

      if (langBtn && langDropdown) {
        langBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          langDropdown.classList.toggle('show');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
          if (!langBtn.contains(e.target) && !langDropdown.contains(e.target)) {
            langDropdown.classList.remove('show');
          }
        });
      }
    });

    // Detecção de Feriados Festivos com Configuração
    (async function() {
      try {
        const [feriadosResponse, configResponse] = await Promise.all([
          fetch('/data/feriados.json'),
          fetch('/data/feriados-config.json')
        ]);

        const data = await feriadosResponse.json();
        const config = await configResponse.json();
        const hoje = new Date().toISOString().slice(0,10);
        const ano = new Date().getFullYear();

        // Função para calcular datas variáveis
        function calculaCarnaval(year) {
          const pascoa = calculaPascoa(year);
          const carnaval = new Date(pascoa);
          carnaval.setDate(carnaval.getDate() - 47);
          return carnaval.toISOString().slice(0,10);
        }

        function calculaPascoa(year) {
          const a = year % 19;
          const b = Math.floor(year / 100);
          const c = year % 100;
          const d = Math.floor(b / 4);
          const e = b % 4;
          const f = Math.floor((b + 8) / 25);
          const g = Math.floor((b - f + 1) / 3);
          const h = (19 * a + b - d - g + 15) % 30;
          const i = Math.floor(c / 4);
          const k = c % 4;
          const l = (32 + 2 * e + 2 * i - h - k) % 7;
          const m = Math.floor((a + 11 * h + 22 * l) / 451);
          const mes = Math.floor((h + l - 7 * m + 114) / 31);
          const dia = ((h + l - 7 * m + 114) % 31) + 1;
          return new Date(year, mes - 1, dia);
        }

        function calculaCorpus(year) {
          const pascoa = calculaPascoa(year);
          const corpus = new Date(pascoa);
          corpus.setDate(corpus.getDate() + 60);
          return corpus.toISOString().slice(0,10);
        }

        function blackFriday(year) {
          const nov = new Date(year, 10, 1);
          const diaSemana = nov.getDay();
          const ultimaSexta = new Date(nov);
          ultimaSexta.setDate(nov.getDate() + (5 - diaSemana + 26) % 7);
          return ultimaSexta.toISOString().slice(0,10);
        }

        function segundoDomingo(mes, year) {
          const primeiroDia = new Date(year, mes, 1);
          const primeiroDomingo = new Date(primeiroDia);
          primeiroDomingo.setDate(primeiroDia.getDate() + (7 - primeiroDia.getDay()));
          const segundoDomingo = new Date(primeiroDomingo);
          segundoDomingo.setDate(primeiroDomingo.getDate() + 7);
          return segundoDomingo.toISOString().slice(0,10);
        }

        function terceiroQuintaNovembro(year) {
          const nov = new Date(year, 10, 1);
          const primeiraQuinta = new Date(nov);
          primeiraQuinta.setDate(nov.getDate() + (4 - nov.getDay() + 7) % 7);
          const terceiraQuinta = new Date(primeiraQuinta);
          terceiraQuinta.setDate(primeiraQuinta.getDate() + 14);
          return terceiraQuinta.toISOString().slice(0,10);
        }

        function terceiraSegundaAbril(year) {
          const abr = new Date(year, 3, 1);
          const primeiraSegunda = new Date(abr);
          primeiraSegunda.setDate(abr.getDate() + (1 - abr.getDay() + 7) % 7);
          const terceiraSegunda = new Date(primeiraSegunda);
          terceiraSegunda.setDate(primeiraSegunda.getDate() + 14);
          return terceiraSegunda.toISOString().slice(0,10);
        }

        function sextaAntesPrimavera(year) {
          const primavera = new Date(year, 8, 22); // 22 de setembro
          if (primavera.getDay() === 5) primavera.setDate(primavera.getDate() - 7);
          while (primavera.getDay() !== 5) primavera.setDate(primavera.getDate() - 1);
          return primavera.toISOString().slice(0,10);
        }

        function variavelOrgulho(year) {
          return `${year}-06-28`; // Último dia de junho
        }

        // Verificar feriado
        const feriadoHoje = data.feriados.find(f => {
          if (f.data === hoje) return true;
          if (f.data === 'variavel_carnaval' && calculaCarnaval(ano) === hoje) return true;
          if (f.data === 'variavel_pascoa' && calculaPascoa(ano).toISOString().slice(0,10) === hoje) return true;
          if (f.data === 'variavel_corpus' && calculaCorpus(ano) === hoje) return true;
          if (f.data === 'variavel_blackfriday' && blackFriday(ano) === hoje) return true;
          if (f.data === 'segundo_domingo_maio' && segundoDomingo(4, ano) === hoje) return true;
          if (f.data === 'segundo_domingo_agosto' && segundoDomingo(7, ano) === hoje) return true;
          if (f.data === 'segundo_domingo_setembro' && segundoDomingo(8, ano) === hoje) return true;
          if (f.data === 'primeiro_domingo_julho' && segundoDomingo(6, ano) === hoje) return true;
          if (f.data === 'terceira_quinta_novembro' && terceiroQuintaNovembro(ano) === hoje) return true;
          if (f.data === 'terceira_segunda_abril' && terceiraSegundaAbril(ano) === hoje) return true;
          if (f.data === 'sexta_antes_primavera' && sextaAntesPrimavera(ano) === hoje) return true;
          if (f.data === 'variavel_orgulho' && variavelOrgulho(ano) === hoje) return true;
          return false;
        });

        if (feriadoHoje) {
          // Verificar se o feriado está ativo na configuração
          const feriadoAtivo = config.config.feriados[feriadoHoje.nome]?.ativo ?? true;

          if (feriadoAtivo) {
            document.body.classList.add('feriado-ativo', feriadoHoje.efeito);
            console.log(`🎉 Feriado ativado: ${feriadoHoje.nome} - Efeito: ${feriadoHoje.efeito}`);

            // Expor frase do bot para o widget
            window.feriadoFrase = feriadoHoje.bot_frase[Astro.locals.lang] || feriadoHoje.bot_frase.pt;
          } else {
            console.log(`🚫 Feriado desativado: ${feriadoHoje.nome} - Efeito bloqueado pela configuração`);
          }
        }
      } catch (error) {
        console.log('Erro ao carregar feriados:', error);
      }
    })();
  </script>

  <!-- Breadcrumb Generator Script -->
  <script is:inline>
    // Breadcrumb Generator
    function generateBreadcrumbs() {
      const path = window.location.pathname;
      const segments = path.split('/').filter(segment => segment !== '');

      // Breadcrumb mappings for better names
      const breadcrumbMap = {
        'chat-ia': 'Chat Inteligente',
        'sistema-tickets': 'Sistema de Tickets',
        'analise-sentimento': 'Análise de Sentimento',
        'magic-replies': 'Magic Replies',
        'gamificacao-vendas': 'Gamificação de Vendas',
        'programa-pontos': 'Programa de Pontos',
        'documentacao': 'Documentação',
        'api': 'API',
        'integracoes': 'Integrações',
        'suporte': 'Suporte',
        'faq': 'Perguntas Frequentes',
        'blog': 'Blog',
        'admin': 'Administração'
      };

      const breadcrumbNav = document.getElementById('breadcrumb-nav');
      const breadcrumbList = document.querySelector('.breadcrumb-list');

      if (segments.length === 0) {
        breadcrumbNav.style.display = 'none';
        return;
      }

      breadcrumbNav.style.display = 'block';

      // Clear existing breadcrumbs except home
      while (breadcrumbList.children.length > 1) {
        breadcrumbList.removeChild(breadcrumbList.lastChild);
      }

      let currentPath = '';

      segments.forEach((segment, index) => {
        currentPath += '/' + segment;

        const listItem = document.createElement('li');
        listItem.className = 'breadcrumb-item';

        const link = document.createElement('a');
        link.href = currentPath;
        link.className = 'breadcrumb-link';

        // Check if it's the last segment (current page)
        if (index === segments.length - 1) {
          link.classList.add('active');
          link.setAttribute('aria-current', 'page');
        }

        // Use mapped name or capitalize segment
        const displayName = breadcrumbMap[segment] ||
          segment.split('-').map(word =>
            word.charAt(0).toUpperCase() + word.slice(1)
          ).join(' ');

        link.textContent = displayName;
        listItem.appendChild(link);
        breadcrumbList.appendChild(listItem);
      });
    }

    // Generate breadcrumbs on page load and when navigating (for SPA-like behavior)
    document.addEventListener('DOMContentLoaded', generateBreadcrumbs);
    window.addEventListener('popstate', generateBreadcrumbs);
  </script>

