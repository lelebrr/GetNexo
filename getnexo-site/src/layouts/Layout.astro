  description = "Chatbot WhatsApp IA grátis self-hosted: fecha vendas sozinho 24/7 no seu domínio. Sem taxa por mensagem, integra PIX automático, estoque, frete. Teste 7 dias grátis. API Meta Oficial + CRM IA.",
  keywords = "chatbot whatsapp gratis, chatbot whatsapp ia, automacao whatsapp vendas, chatbot whatsapp self hosted, pix no whatsapp automatico, ia whatsapp vendas, chatbot whatsapp conversao, vendas whatsapp 24h, chatbot whatsapp api oficial, getnexo chatbot whatsapp, chatbot whatsapp gratis brasil, chatbot whatsapp ia vendas, chatbot whatsapp sem mensalidade, chatbot whatsapp self hosted, chatbot whatsapp api meta, chatbot whatsapp pix automatico, chatbot whatsapp crm integrado",
  isLanding = false,
  preloadImage,
  ogImage = "https://getnexo.com.br/assets/og-poster.jpg",
  articleSchema = null,
  type = "website",
  suppressDefaultSchema = false
} = Astro.props;

const lang = Astro.url.pathname.split('/')[1] || 'pt';
let translations;
try {
  const trans = await import(`../i18n/${lang}.json`);
  translations = trans.default;
} catch (e) {
  const trans = await import(`../i18n/pt.json`);
  translations = trans.default;
}

// Função para gerar URLs com idioma correto (sem trailing slash para evitar 404)
function getLangUrl(targetLang) {
  const currentPath = Astro.url.pathname;
  
  // Se for português e estiver na home, apontar para / (evita 404 em /pt)
  if (targetLang === 'pt' && (currentPath === '/' || currentPath === '/pt')) return '/';
  
  if (currentPath === '/') return `/${targetLang}`;
  
  const segments = currentPath.split('/').filter(s => s);

  // Se o primeiro segmento for um idioma, substitua-o
  if (['pt', 'en', 'es', 'fr'].includes(segments[0])) {
    segments[0] = targetLang;
    // Se o resultado for /pt, apontar para a raiz (evita redundância e 404)
    if (targetLang === 'pt' && segments.length === 1) return '/';
    return '/' + segments.join('/');
  } else {
    // Se não houver prefixo de idioma e o alvo for pt, retornar o path original
    if (targetLang === 'pt') return currentPath;
    // Se não houver prefixo de idioma, adicione-o
    return '/' + targetLang + (currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath);
  }
}

// Otimização: Verificação de feriados em tempo de build para evitar redeclaração e latência
const isFeriadoBuild = false; // Pode ser passado via props se necessário

const nonce = Astro.locals.nonce;
const trustedTypesPolicy = Astro.locals.trustedTypesPolicy || 'getnexo-trusted';
const clientId = Astro.locals.clientId || 'default';
