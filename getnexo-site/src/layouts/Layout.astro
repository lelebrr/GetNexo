---
import '../styles/global.css?v=premium_v1.8'; // Forced Cache Buster
import SEO from '../components/SEO.astro';
import PreSupportModal from '../components/PreSupportModal.astro';
import AccessibilityControls from '../components/AccessibilityControls.astro';
import CookieConsent from '../components/CookieConsent.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import ClippyAssistants from '../components/ClippyAssistants.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import TourGuided from '../components/TourGuided.astro';

const {
  title = "Chatbot WhatsApp IA Grátis Self-Hosted – Fecha Vendas 24h | GetNexo PIX Automático",
  description = "Chatbot WhatsApp IA grátis self-hosted: fecha vendas sozinho 24/7 no seu domínio. Sem taxa por mensagem, integra PIX automático, estoque, frete. Teste 7 dias grátis. API Meta Oficial + CRM IA.",
  keywords = "chatbot whatsapp gratis, chatbot whatsapp ia, automacao whatsapp vendas, chatbot whatsapp self hosted, pix no whatsapp automatico, ia whatsapp vendas, chatbot whatsapp conversao, vendas whatsapp 24h, chatbot whatsapp api oficial, getnexo chatbot whatsapp, chatbot whatsapp gratis brasil, chatbot whatsapp ia vendas, chatbot whatsapp sem mensalidade, chatbot whatsapp self hosted, chatbot whatsapp api meta, chatbot whatsapp pix automatico, chatbot whatsapp crm integrado",
  isLanding = false,
  preloadImage,
  ogImage = "https://getnexo.com.br/assets/og-poster.jpg",
  articleSchema = null,
  type = "website"
} = Astro.props;

const lang = Astro.url.pathname.split('/')[1] || 'pt';
let t;
try {
  const translations = await import(`../i18n/${lang}.json`);
  t = translations.default;
} catch (e) {
  const translations = await import(`../i18n/pt.json`);
  t = translations.default;
}

// Função para gerar URLs com idioma correto (sem trailing slash para evitar 404)
function getLangUrl(targetLang) {
  const currentPath = Astro.url.pathname;
  
  // Se for português e estiver na home, apontar para / (evita 404 em /pt)
  if (targetLang === 'pt' && (currentPath === '/' || currentPath === '/pt')) return '/';
  
  if (currentPath === '/') return `/${targetLang}`;
  
  const segments = currentPath.split('/').filter(s => s);

  // Se o primeiro segmento for um idioma, substitua-o
  if (['pt', 'en', 'es', 'fr'].includes(segments[0])) {
    segments[0] = targetLang;
    // Se o resultado for /pt, apontar para a raiz (evita redundância e 404)
    if (targetLang === 'pt' && segments.length === 1) return '/';
    return '/' + segments.join('/');
  } else {
    // Se não houver prefixo de idioma e o alvo for pt, retornar o path original
    if (targetLang === 'pt') return currentPath;
    // Se não houver prefixo de idioma, adicione-o
    return '/' + targetLang + (currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath);
  }
}

// Verificar feriados ativos para carregar CSS condicionalmente
let feriadoAtivo = false;
try {
  const feriadosResponse = await fetch('/data/feriados.json');
  const data = await feriadosResponse.json();
  const hoje = new Date().toISOString().slice(0,10);
  const ano = new Date().getFullYear();

  // Importar funções de cálculo de feriados
  const { verificaDataVariavel } = await import('../lib/feriados.js');

  // Verificar se há feriado ativo
  const feriadoHoje = data.feriados.find(f => {
    if (f.data === hoje) return true;
    const dataCalculada = verificaDataVariavel(f.data, ano);
    return dataCalculada === hoje;
  });

  feriadoAtivo = !!feriadoHoje;
} catch (error) {
  console.log('Erro ao verificar feriados:', error);
}

const nonce = Astro.locals.nonce;
const trustedTypesPolicy = Astro.locals.trustedTypesPolicy || 'getnexo-trusted';
const clientId = Astro.locals.clientId || 'default';
---
<!DOCTYPE html>
<html lang={lang} data-bg-type="animated">
<head>
  <!-- Trusted Types Policy Script (carregado com nonce do CSP) -->
  <!-- Trusted Types Policy Script -->
  <script is:inline src="/custom/js/trusted-types-policy.js"></script>
  
  <!-- Gerenciador de Fundo Instantâneo - BLOQUEANTE E NO TOPO PARA EVITAR FLICKER -->
  <script is:inline define:vars={{ trustedTypesPolicy }}>
    (function() {
      try {
        const bgType = localStorage.getItem('getnexo-bg-type') || 'animated';
        document.documentElement.setAttribute('data-bg-type', bgType);
        window.GETNEXO_CONFIG = { 
          bgType,
          trustedTypesPolicy: trustedTypesPolicy
        };
      } catch (e) {
        console.warn('LocalStorage access blocked:', e);
      }
    })();
  </script>
  <SEO
    title={title}
    description={description}
    keywords={keywords}
    image={ogImage}
    lang={lang}
    type={type}
    structuredData={articleSchema}
    nonce={nonce}
  />

  <!-- Hreflang Links for SEO -->
  <link rel="alternate" hreflang="pt-BR" href={`https://getnexo.com.br${getLangUrl('pt')}`} />
  <link rel="alternate" hreflang="en-US" href={`https://getnexo.com.br${getLangUrl('en')}`} />
  <link rel="alternate" hreflang="es-ES" href={`https://getnexo.com.br${getLangUrl('es')}`} />
  <link rel="alternate" hreflang="fr-FR" href={`https://getnexo.com.br${getLangUrl('fr')}`} />
  <link rel="alternate" hreflang="x-default" href="https://getnexo.com.br/" />

  <!-- NeuralBackground restored -->
  <NeuralBackground nonce={nonce} />
  
  <!-- PWA Manifest -->
  <link rel="manifest" href="/manifest.json">
  
  <!-- Click Fireworks Script handled in body -->

  <!-- White-label CSS -->
  {clientId !== 'default' && (
    <link rel="stylesheet" href={`https://api.getnexo.com.br/api/whitelabel/css/${clientId}`} />
  )}

  <!-- Holiday Effects CSS - Carregado dinamicamente quando há feriados -->
  {feriadoAtivo && (
    <link rel="stylesheet" href="/custom/css/holiday-effects.css" />
  )}

  <!-- Desabilitar Rocket Loader do Cloudflare -->
  <meta name="cf-rocket-loader" content="false" />

  <slot name="head" />

  <!-- Animate On Scroll (Inline) -->
  <style>
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .animate-on-scroll.animate-in {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
  <script is:inline nonce={nonce}>
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.animate-on-scroll').forEach(el => {
        observer.observe(el);
      });
    });
  </script>

  <script is:inline nonce={nonce}>
    // Aggressive Cache Buster & SW Killer
    const VERSION = '1.9-rc1-BUILD-debug';
    console.log(`%c GetNexo Site Version: ${VERSION}`, 'background: #222; color: #bada55; padding: 4px; border-radius: 4px;');
    if (localStorage.getItem('getnexo_v') !== VERSION) {
      localStorage.setItem('getnexo_v', VERSION);
      
      // Kill all service workers
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(registrations => {
          for(let r of registrations) r.unregister();
        });
      }
      
      // Clear all caches
      if ('caches' in window) {
        caches.keys().then(names => {
          for (let name of names) caches.delete(name);
        });
      }

    }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style is:inline>
      /* Critical LCP Styles */
      .logo-text { font-family: 'Inter', sans-serif; font-weight: 800; visibility: visible !important; opacity: 1 !important; }
      @media (max-width: 768px) {
        .hero-title { font-size: 2.2rem !important; }
        .hero-split { padding-top: 6rem !important; }
      }
    </style>
  <style is:global define:vars={{ mainPadding: isLanding ? '0' : '80px', mainMinHeight: isLanding ? 'auto' : '100vh' }}>
    :root { 
      --primary: #00d4ff; 
      --success: #00ff9d; 
      --neon-blue: #00d4ff;
      --neon-green: #00ff9d;
      --dark: #030712; 
      --gray: #111827; 
      --light: #f8fafc; 
      --text: #94a3b8; 
      --glass: rgba(15, 23, 42, 0.7);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { 
      font-family: 'Inter', system-ui, sans-serif; 
      background: var(--dark); 
      color: var(--light); 
      line-height: 1.6; 
      overflow-x: hidden; 
    }

    /* Premium Common Styles */
    .text-gradient { background:linear-gradient(90deg, var(--primary), var(--success)); -webkit-background-clip:text; color:transparent; font-weight: 800; }
    .glass-panel { background: var(--glass); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.05); border-radius: 20px; }

    /* Foco Visível */
    :focus { outline: 3px solid var(--success); }

    /* Animated Background & Neural Toggle */
    html[data-bg-type="neural"] .animated-bg { display: none !important; }
    html[data-bg-type="animated"] .neural-background { display: none !important; }

    .animated-bg { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: -99; overflow: hidden; background: #030712; }
    .blob { position: absolute; width: 600px; height: 600px; background: radial-gradient(circle, rgba(0, 212, 255, 0.15) 0%, transparent 70%); border-radius: 50%; filter: blur(80px); animation: move 20s infinite alternate; will-change: transform; }
    .blob-1 { top: -100px; left: -100px; }
    .blob-2 { bottom: -100px; right: -100px; background: radial-gradient(circle, rgba(0, 255, 157, 0.10) 0%, transparent 70%); }
    @keyframes move { from { transform: translate(0, 0); } to { transform: translate(100px, 100px); } }

    /* Layout Parts */
    main { padding-top: var(--mainPadding); min-height: var(--mainMinHeight); }

    .global-header {
      background: rgba(3, 7, 18, 0.7);
      backdrop-filter: blur(25px);
      position: fixed; top: 0; width: 100%; z-index: 1000;
      padding: 1rem 5%;
      display: flex; justify-content: space-between; align-items: center;
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
      border-bottom: 1px solid rgba(255,255,255,0.03);
    }
    .global-header.scrolled {
      padding: 0.6rem 5%;
      background: rgba(3, 7, 18, 0.95);
      box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 30px rgba(0, 212, 255, 0.05);
      border-bottom-color: rgba(0, 212, 255, 0.2);
    }
    .logo-link { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; }
    .logo-box {
      width: 44px; height: 44px;
      position: relative;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.5s var(--transition-smooth);
    }
    .logo-box svg { width: 100%; height: 100%; }
    .logo-box:hover { transform: scale(1.1) rotate(5deg); }
    
    .logo-text { 
      color:white; font-weight: 900; font-size: 1.4rem; margin:0; 
      letter-spacing: -1px; text-transform: lowercase; 
    }
    .logo-text span.logo-highlight { color: var(--success); text-transform: none; }

    .nav-links { display: flex; align-items: center; gap: 0.2rem; }
    .nav-links a {
      color: #94a3b8;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.85rem;
      transition: all 0.3s ease;
      padding: 0.6rem 1rem;
      border-radius: 10px;
    }
    .nav-links a:hover {
      color: white;
      background: rgba(255,255,255,0.05);
    }

    /* Premium Dropdown */
    .nav-dropdown { position: relative; }
    .nav-dropdown-toggle { display: flex; align-items: center; gap: 0.3rem; }
    .nav-dropdown-toggle::after { content: '›'; transform: rotate(90deg); font-size: 1rem; transition: 0.3s; }
    .nav-dropdown:hover .nav-dropdown-toggle::after { transform: rotate(270deg); color: var(--primary); }

    .nav-dropdown-menu {
      position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(20px);
      width: 520px; padding: 1.5rem;
      background: rgba(10, 14, 23, 0.98);
      backdrop-filter: blur(40px);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 24px;
      opacity: 0; visibility: hidden;
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
      box-shadow: 0 40px 80px rgba(0,0,0,0.9), 0 0 50px rgba(0,212,255,0.1);
      z-index: 100;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.8rem;
    }
    .nav-dropdown:hover .nav-dropdown-menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(10px); }
    
    .dropdown-links a {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      padding: 1rem;
      border-radius: 12px;
      border: 1px solid transparent;
      transition: 0.3s;
    }
    .dropdown-links a:hover {
      background: rgba(255,255,255,0.03);
      border-color: rgba(0,212,255,0.2);
      transform: translateY(-2px);
    }
    .dropdown-item-title { color: white; font-weight: 800; font-size: 0.9rem; }
    .dropdown-item-desc { color: #64748b; font-size: 0.75rem; font-weight: 500; }

    /* Search Bar */
    .search-container { position: relative; margin-left: 1rem; }
    .search-input {
      background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
      color: white; padding: 0.4rem 2.5rem 0.4rem 1rem; border-radius: 20px;
      font-size: 0.85rem; width: 200px; outline: none; transition: 0.3s;
    }
    .search-input::placeholder { color: #94a3b8; }
    .search-input:focus { width: 250px; background: rgba(255,255,255,0.15); border-color: var(--primary); }
    .search-btn {
      position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: var(--primary); cursor: pointer; font-size: 1rem;
    }

    .header-ctas { display: flex; align-items: center; gap: 1rem; }
    .btn-login { color: white; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
    .btn-start {
      background: linear-gradient(135deg, var(--neon-blue), var(--neon-green));
      color: black !important;
      padding: 0.8rem 1.8rem;
      border-radius: 12px;
      font-weight: 900;
      text-decoration: none;
      font-size: 0.95rem;
      transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      min-height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      white-space: nowrap;
      box-shadow: 0 10px 30px rgba(0, 212, 255, 0.5);
      border: none;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      animation: pulse-glow 2s infinite ease-in-out;
    }
    @keyframes pulse-glow {
      0%, 100% { opacity: 0.8; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.02); }
    }
    .btn-start:hover {
      transform: translateY(-3px) scale(1.05);
      background: linear-gradient(135deg, var(--neon-green), var(--neon-blue));
    }

    /* Language Selector */
    .lang-flags {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      margin-left: 1rem;
    }
    .flag-link {
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
        background: rgba(255,255,255,0.05);
        width: 32px;
        height: 22px;
        overflow: hidden;
        opacity: 0.8;
    }
    .flag-link img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.3s;
    }
    .flag-link:hover, .flag-link.active {
      opacity: 1;
      transform: translateY(-1px);
      background: rgba(0,212,255,0.1);
      border-color: var(--neon-blue);
      box-shadow: 0 0 10px rgba(0,212,255,0.2);
    }
    .flag-link.active {
      border-color: var(--neon-green);
      background: rgba(0,255,157,0.1);
    }

    .global-footer { padding: 4rem 5% 0.5rem !important; background: transparent !important; border-top: none !important; margin-top: 2rem !important; position: relative !important; z-index: 10 !important; width: 100% !important; display: block !important; }
    .footer-grid { display: grid !important; grid-template-columns: 1.2fr repeat(4, 1fr) !important; gap: 2rem !important; max-width: 1300px !important; margin: 0 auto !important; text-align: left !important; }
    .footer-col h3.footer-title { color: white; margin-bottom: 1.2rem; font-size: 0.9rem; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; opacity: 0.8; white-space: pre-line; }
    .footer-links { display: flex; flex-direction: column; gap: 0.8rem; }
    .footer-links a { color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .footer-links a:hover { color: var(--primary); transform: translateX(5px); }
    .branding-col .footer-description { font-size: 1rem; color: #94a3b8; line-height: 1.7; margin-bottom: 2rem; max-width: 300px; }
    .footer-socials { display: flex; gap: 1.2rem; flex-wrap: wrap; }
    .footer-socials a {
      color: var(--text);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      backdrop-filter: blur(10px);
    }
    .footer-socials a:hover {
      transform: translateY(-4px) scale(1.05);
      box-shadow: 0 8px 25px rgba(0, 212, 255, 0.2);
    }
    .footer-socials a svg {
      width: 20px;
      height: 20px;
      transition: all 0.3s ease;
    }

    /* Redes sociais específicas com cores */
    .social-link.whatsapp:hover { background: linear-gradient(135deg, #25d366, #4fce5d); color: white; border-color: #25d366; }
    .social-link.facebook:hover { background: linear-gradient(135deg, #1877f2, #42a5f5); color: white; border-color: #1877f2; }
    .social-link.instagram:hover {
      background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
      color: white;
      border-color: #e4405f;
    }
    .social-link.linkedin:hover { background: linear-gradient(135deg, #0077b5, #42a5f5); color: white; border-color: #0077b5; }
    .social-link.tiktok:hover { background: linear-gradient(135deg, #000000, #333333); color: white; border-color: #000000; }
    .social-link.twitter:hover { background: linear-gradient(135deg, #1da1f2, #42a5f5); color: white; border-color: #1da1f2; }
    .social-link.youtube:hover { background: linear-gradient(135deg, #ff0000, #ff4444); color: white; border-color: #ff0000; }
    .social-link.discord:hover { background: linear-gradient(135deg, #5865f2, #42a5f5); color: white; border-color: #5865f2; }
    .social-link.telegram:hover { background: linear-gradient(135deg, #0088cc, #42a5f5); color: white; border-color: #0088cc; }

    /* Efeitos de brilho nos ícones */
    .footer-socials a::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
      border-radius: 14px;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: -1;
    }
    .footer-socials a:hover::before {
      opacity: 1;
    }

    /* Animação de pulso */
    @keyframes socialPulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }
    .footer-socials a:hover svg {
      animation: socialPulse 0.6s ease-in-out;
    }
    
    /* Footer Newsletter */
    .newsletter-text { font-size: 0.8rem; color: #94a3b8; margin-bottom: 0.8rem; }
    .footer-newsletter { display: flex; gap: 0.5rem; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 0.2rem; border-radius: 10px; }
    .footer-newsletter input { flex: 1; background: transparent; border: none; color: white; padding: 0.4rem 0.6rem; font-size: 0.8rem; outline: none; }
    .footer-newsletter button { background: var(--primary); color: black; border: none; padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 800; cursor: pointer; transition: 0.3s; font-size: 0.8rem; }
    .footer-newsletter button:hover { transform: scale(1.05); background: var(--success); }

    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.03); margin-top: 3rem; padding-top: 1.5rem; text-align: center; color: #475569; font-size: 0.75rem; }

    /* Trust Badges Styles */
    .footer-trust-badges { 
      display: flex; justify-content: center; gap: 3rem; 
      padding: 1rem; background: rgba(255,255,255,0.015); 
      border-radius: 12px; margin-bottom: 2rem; border: 1px solid rgba(255,255,255,0.03);
    }
    .trust-badge { display: flex; align-items: center; gap: 0.6rem; }
    .badge-icon { font-size: 1.25rem; opacity: 0.8; white-space: pre-line; }
    .badge-text { font-size: 0.7rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }

    /* Footer Logo Styles */
    .footer-logo { width: 50px !important; height: 50px !important; font-size: 1.2rem !important; margin-bottom: 0.5rem !important; }
    .footer-text { font-size: 1.2rem !important; }
    .footer-description { font-size: 0.85rem !important; line-height: 1.5 !important; margin-bottom: 1.5rem !important; opacity: 0.8; white-space: pre-line; }

    .mt-6 { margin-top: 1rem; }

    @media (max-width: 1200px) {
      .footer-grid { grid-template-columns: repeat(3, 1fr) !important; gap: 2rem; }
      .branding-col { grid-column: span 3; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 2rem; }
    }
    @media (max-width: 768px) {
      .footer-trust-badges { flex-wrap: wrap; gap: 1rem; justify-content: center; }
      .footer-grid { grid-template-columns: repeat(2, 1fr) !important; }
      .branding-col { grid-column: span 2; }
      .newsletter-col { grid-column: span 2; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.05); }
    }
    @media (max-width: 480px) {
      .footer-grid { grid-template-columns: 1fr !important; gap: 2rem; text-align: center; }
      .branding-col, .newsletter-col { grid-column: span 1; }
      .footer-socials, .footer-newsletter { justify-content: center; max-width: 300px; margin-left: auto; margin-right: auto; }
      .footer-links a:hover { transform: scale(1.05); }
    }

    /* Security Section Styles */
    .security-section {
      background: linear-gradient(135deg, rgba(3, 7, 18, 0.95), rgba(15, 23, 42, 0.95));
      border-top: 1px solid rgba(255,255,255,0.05);
      border-bottom: 1px solid rgba(255,255,255,0.05);
      padding: 5rem 5%;
      margin: 4rem 0;
    }

    .security-container { 
      max-width: 1200px; 
      margin: 0 auto; 
    }

    .security-title {
      text-align: center;
      font-size: 2.5rem;
      font-weight: 800;
      color: white;
      margin-bottom: 1rem;
      text-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
    }

    .security-subtitle {
      text-align: center;
      font-size: 1.2rem;
      color: var(--text);
      margin-bottom: 4rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    .security-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .security-item {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 2rem;
      text-align: center;
      transition: 0.3s;
      height: 100%;
    }

    .security-item:hover {
      border-color: rgba(0, 212, 255, 0.3);
      transform: translateY(-5px);
      background: rgba(15, 23, 42, 0.8);
      box-shadow: 0 20px 40px rgba(0, 212, 255, 0.1);
    }

    .security-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      display: block;
    }

    .security-item h3 {
      color: white;
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .security-item p {
      color: var(--text);
      line-height: 1.6;
      margin: 0;
      font-size: 0.9rem;
    }

    .security-cta {
      background: rgba(0, 212, 255, 0.1);
      border: 1px solid rgba(0, 212, 255, 0.2);
      border-radius: 20px;
      padding: 3rem;
      text-align: center;
    }

    .security-highlight {
      font-size: 1.3rem;
      color: var(--primary);
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .security-cta p {
      color: var(--light);
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .security-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-security-primary {
      background: linear-gradient(135deg, var(--primary), var(--success));
      color: black;
      padding: 1rem 2rem;
      border-radius: 12px;
      font-weight: 800;
      text-decoration: none;
      font-size: 1rem;
      transition: 0.3s;
      display: inline-block;
      box-shadow: 0 10px 25px rgba(0, 212, 255, 0.3);
    }

    .btn-security-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 35px rgba(0, 212, 255, 0.4);
    }

    .btn-security-secondary {
      background: transparent;
      color: var(--text);
      border: 1px solid rgba(255,255,255,0.2);
      padding: 1rem 2rem;
      border-radius: 12px;
      font-weight: 600;
      text-decoration: none;
      font-size: 1rem;
      transition: 0.3s;
      display: inline-block;
    }

    .btn-security-secondary:hover {
      border-color: var(--primary);
      color: var(--primary);
      background: rgba(0, 212, 255, 0.1);
    }

    @media (max-width: 768px) {
      .security-title { font-size: 2rem; }
      .security-subtitle { font-size: 1rem; }
      .security-grid { grid-template-columns: 1fr; gap: 1.5rem; }
      .security-item { padding: 1.5rem; }
      .security-cta { padding: 2rem; }
      .security-highlight { font-size: 1.1rem; }
      .security-buttons { flex-direction: column; }
      .btn-security-primary, .btn-security-secondary { width: 100%; text-align: center; }
    }



    /* Header landing style - mais transparente */
    .header-landing { background: rgba(3, 7, 18, 0.5); border-bottom-color: rgba(0, 212, 255, 0.1); }

    /* Mobile Menu Button */
    .mobile-menu-btn {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 5px;
    }
    .mobile-menu-btn span {
      width: 25px;
      height: 3px;
      background: white;
      border-radius: 3px;
      transition: 0.3s;
    }
    .mobile-menu-btn.active span:nth-child(1) { transform: rotate(45deg) translate(6px, 6px); }
    .mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
    .mobile-menu-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(6px, -6px); }

    /* Mobile Menu Overlay */
    /* Mobile Menu - App Style */
    .mobile-menu {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(2, 6, 23, 0.95);
      backdrop-filter: blur(30px);
      z-index: 2000;
      opacity: 0; visibility: hidden;
      transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
      display: flex; align-items: center; justify-content: center;
    }
    .mobile-menu.active { opacity: 1; visibility: visible; }
    
    .mobile-nav {
      width: 90%; max-width: 400px;
      height: 85vh;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 40px;
      display: flex; flex-direction: column;
      overflow: hidden;
      transform: translateY(50px);
      transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
      box-shadow: 0 50px 100px rgba(0,0,0,0.8);
    }
    .mobile-menu.active .mobile-nav { transform: translateY(0); }

    .mobile-header { padding: 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .mobile-close { background: none; border: none; color: white; font-size: 2rem; cursor: pointer; }
    
    .mobile-scroll-area { flex: 1; overflow-y: auto; padding: 2rem; }
    .mobile-section { margin-bottom: 2.5rem; }
    .mobile-section-title { font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 1.5rem; display: block; }
    
    .mobile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .mobile-grid a {
      background: rgba(255,255,255,0.03);
      padding: 1.2rem; border-radius: 20px;
      font-size: 0.85rem; font-weight: 700; color: white;
      text-decoration: none; text-align: center;
      border: 1px solid rgba(255,255,255,0.05);
      transition: 0.3s;
    }
    .mobile-grid a:hover { background: rgba(0, 212, 255, 0.1); border-color: var(--primary); transform: scale(1.05); }

    .mobile-links-extra { display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem; }
    .mobile-links-extra a { color: #94a3b8; text-decoration: none; font-weight: 600; font-size: 0.95rem; }

    .mobile-footer { padding: 2rem; background: rgba(0,0,0,0.2); display: flex; flex-direction: column; gap: 1rem; }

    .mobile-lang-selector {
      display: flex;
      gap: 0.75rem;
      margin: 1rem 0;
      justify-content: center;
    }
    .mobile-lang-selector a {
      width: 46px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      transition: all 0.3s var(--transition-bounce);
      overflow: hidden;
    }
    .mobile-lang-selector a img {
      width: 28px;
      height: 18px;
      object-fit: cover;
      border-radius: 2px;
    }
    .mobile-lang-selector a.active {
      background: rgba(0, 212, 255, 0.1);
      border-color: var(--neon-blue);
      box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
      transform: scale(1.1);
    }
    .mobile-login { color: white; text-align: center; text-decoration: none; font-weight: 700; padding: 1rem; }

    /* Surprise Discovery Icon */
    .magic-discovery {
      position: relative;
      width: 42px; height: 42px;
      background: rgba(255, 215, 0, 0.05);
      border: 1px solid rgba(255, 215, 0, 0.2);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      margin-right: 0.5rem;
      font-size: 1.2rem;
    }
    .magic-discovery:hover { 
      transform: scale(1.15) rotate(15deg); 
      background: rgba(255, 215, 0, 0.15);
      border-color: rgba(255, 215, 0, 0.5);
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
    }
    .magic-discovery::after {
      content: 'AI';
      position: absolute; top: -6px; right: -6px;
      background: linear-gradient(135deg, #ffd700, #ff8c00); 
      color: black;
      font-size: 0.65rem; font-weight: 900;
      padding: 2px 5px; border-radius: 6px;
      box-shadow: 0 2px 10px rgba(255, 140, 0, 0.4);
    }

    @media (max-width: 1100px) {
      .nav-links { display: none; }
      .header-ctas { display: flex; gap: 0.5rem; }
      .btn-start { display: none; }
      .global-header { padding: 1rem 5%; }
      .mobile-menu-btn { display: flex; }
      .lang-btn { padding: 0.4rem 0.6rem; font-size: 1rem; }
    }

    /* Responsive dropdowns */
    @media (max-width: 768px) {
      .dropdown-links { grid-template-columns: 1fr; gap: 0.3rem; }
      .nav-dropdown-menu { min-width: 280px; left: 50%; transform: translateX(-50%) translateY(-10px); }
    }

    /* Force Chat Widget to Bottom-Right */
    #getnexo-root, .chatwoot-widget-holder, #chatwoot-widget-container { 
      top: auto !important; 
      bottom: 20px !important; 
      right: 20px !important; 
      left: auto !important;
    }
  </style>
</head>
<body>

  <div class="skip-links">
