    </button>
    <div class="controls-panel glass-panel">
      <div class="control-group">
        <label for="speed-slider">Velocidade</label>
        <input type="range" id="speed-slider" min="0.1" max="3" step="0.1" value="1">
        <span id="speed-value">1.0x</span>
      </div>
      <div class="control-group">
        <label for="theme-select">Tema</label>
        <select id="theme-select">
          <option value="default">Padrão</option>
          <option value="dark">Escuro</option>
          <option value="neural">Neural</option>
          <option value="cosmic">Cósmico</option>
        </select>
      </div>
      <button id="pause-neural" class="control-btn">⏸️ Pausar</button>
    </div>
  </div>

  <style is:global>
    .neural-canvas {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      z-index: -99; pointer-events: none; background: #030712;
    }

    .neural-controls {
      position: fixed; bottom: 120px; right: 30px; z-index: 9998;
      display: flex; flex-direction: column; align-items: flex-end; gap: 10px;
    }

    .neural-controls .control-btn {
      width: 45px; height: 45px; border-radius: 50%;
      background: rgba(0, 212, 255, 0.1); border: 1px solid rgba(0, 212, 255, 0.3);
      color: var(--primary); font-size: 18px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: 0.3s; backdrop-filter: blur(10px);
    }

    .neural-controls .control-btn:hover {
      background: rgba(0, 212, 255, 0.2); transform: scale(1.05);
    }

    .controls-panel {
      background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 15px; padding: 15px; display: flex; flex-direction: column; gap: 15px;
      min-width: 200px; animation: slideInRight 0.3s ease;
    }

    .control-group { display: flex; flex-direction: column; gap: 5px; }
    .control-group label { color: #94a3b8; font-size: 0.85rem; font-weight: 600; }
    .control-group input[type="range"] {
      width: 100%; height: 6px; background: rgba(255,255,255,0.1);
      border-radius: 3px; outline: none;
    }
    .control-group input[type="range"]::-webkit-slider-thumb {
      appearance: none; width: 16px; height: 16px; background: var(--primary);
      border-radius: 50%; cursor: pointer;
    }
    .control-group select {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
      color: white; padding: 5px 8px; border-radius: 6px;
    }
    #speed-value { color: var(--primary); font-size: 0.8rem; text-align: right; }

    @keyframes slideInRight { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }

    /* Mobile responsiveness for neural controls */
    @media (max-width: 768px) {
      .neural-controls {
        bottom: 100px;
        right: 20px;
      }
      .controls-panel {
        width: 280px;
        right: 0;
      }
    }

    @media (max-width: 480px) {
      .neural-controls {
        bottom: 120px;
        right: 15px;
      }
