  <!-- GetNexo Custom Widget -->
  <script is:inline data-cfasync="false" nonce={nonce}>
    (function(d,t) {
      const loadWidget = () => {
        const isMobile = window.innerWidth < 768;
        const delay = isMobile ? 3000 : 0;

        setTimeout(() => {
          // Widget temporariamente desabilitado
          return;
          // Verificar se o servidor da API está acessível antes de tentar carregar
          fetch('/widget.js', {
            method: 'HEAD',
            mode: 'no-cors'
          }).then((response) => {
            if (response.ok || response.type === 'opaque') {
              var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
              g.src="/widget.js?v=" + Date.now();
              g.defer = true;
              g.async = true;
              g.setAttribute('data-bot', 'central');

              g.onerror = function() {
                console.warn('[Widget] GetNexo widget failed to load - API unavailable');
              };

              s.parentNode.insertBefore(g,s);
            } else {
              console.warn('[Widget] GetNexo API returned error status:', response.status);
            }
          }).catch((error) => {
            console.warn('[Widget] GetNexo API unavailable:', error.message);
          });
        }, delay);
      };

      if (document.readyState === 'complete') {
        loadWidget();
      } else {
        window.addEventListener('load', loadWidget);
      }
    })(document,"script");

    // Mobile Menu Toggle Logic
    document.addEventListener('DOMContentLoaded', () => {
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          menuBtn.classList.toggle('active');
          mobileMenu.classList.toggle('active');
          document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
        });

        mobileMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menuBtn.classList.remove('active');
            mobileMenu.classList.remove('active');
            document.body.style.overflow = '';
          });
        });
      }

      // Language Selector Toggle Logic
      const langBtn = document.getElementById('lang-btn');
      const langDropdown = document.getElementById('lang-dropdown');

      if (langBtn && langDropdown) {
        let isDropdownOpen = false;

        langBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          isDropdownOpen = !isDropdownOpen;

          if (isDropdownOpen) {
            langDropdown.classList.add('show');
          } else {
            langDropdown.classList.remove('show');
          }
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
          if (!langBtn.contains(e.target) && !langDropdown.contains(e.target)) {
            langDropdown.classList.remove('show');
            isDropdownOpen = false;
          }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isDropdownOpen) {
            langDropdown.classList.remove('show');
            isDropdownOpen = false;
          }
        });
      }
    });

    // Detecção de Feriados Festivos com Sistema Completo
    (async function() {
      try {
        const feriadosResponse = await fetch('/data/feriados.json');
        const data = await feriadosResponse.json();
        const hoje = new Date().toISOString().slice(0,10);
        const ano = new Date().getFullYear();

        // Funções de cálculo de feriados inline
        function calculaPascoa(ano) {
          const a = ano % 19;
          const b = Math.floor(ano / 100);
          const c = ano % 100;
          const d = Math.floor(b / 4);
          const e = b % 4;
          const f = Math.floor((b + 8) / 25);
          const g = Math.floor((b - f + 1) / 3);
          const h = (19 * a + b - d - g + 15) % 30;
          const i = Math.floor(c / 4);
          const k = c % 4;
          const l = (32 + 2 * e + 2 * i - h - k) % 7;
          const m = Math.floor((a + 11 * h + 22 * l) / 451);
          const mes = Math.floor((h + l - 7 * m + 114) / 31);
          const dia = ((h + l - 7 * m + 114) % 31) + 1;
          return `${ano}-${mes.toString().padStart(2, '0')}-${dia.toString().padStart(2, '0')}`;
        }

        function calculaCarnaval(ano) {
          const pascoa = new Date(calculaPascoa(ano));
          const carnaval = new Date(pascoa);
          carnaval.setDate(carnaval.getDate() - 47);
          return carnaval.toISOString().slice(0, 10);
        }

        function calculaBlackFriday(ano) {
          const nov = new Date(ano, 10, 1);
          const ultimoDia = new Date(ano, 11, 0);
          const ultimaSexta = new Date(ultimoDia);
          while (ultimaSexta.getDay() !== 5) {
            ultimaSexta.setDate(ultimaSexta.getDate() - 1);
          }
          return ultimaSexta.toISOString().slice(0, 10);
        }

        function verificaDataVariavel(tipo, ano) {
          switch (tipo) {
            case 'variavel_carnaval': return calculaCarnaval(ano);
            case 'variavel_pascoa': return calculaPascoa(ano);
            case 'variavel_blackfriday': return calculaBlackFriday(ano);
            case 'segundo_domingo_maio': {
              const primeiroMaio = new Date(ano, 4, 1);
              const primeiroDomingo = new Date(primeiroMaio);
              primeiroDomingo.setDate(primeiroMaio.getDate() + (7 - primeiroMaio.getDay()) % 7);
              primeiroDomingo.setDate(primeiroDomingo.getDate() + 7);
              return primeiroDomingo.toISOString().slice(0, 10);
            }
            default: return null;
          }
        }

        // Verificar feriado
        const feriadoHoje = data.feriados.find(f => {
          if (f.data === hoje) return true;
          const dataCalculada = verificaDataVariavel(f.data, ano);
          return dataCalculada === hoje;
        });

        if (feriadoHoje) {
          document.body.classList.add('feriado-ativo', feriadoHoje.efeito);
          console.log(`🎉 Feriado ativado: ${feriadoHoje.nome} - Efeito: ${feriadoHoje.efeito}`);

          // Expor frase do bot para o widget
          const lang = window.location.pathname.split('/')[1] || 'pt';
          window.feriadoFrase = feriadoHoje.bot_frase[lang] || feriadoHoje.bot_frase.pt;

          // Mostrar notificação de feriado
          mostrarNotificacaoFeriado(feriadoHoje);
        }
      } catch (error) {
        console.log('Erro ao carregar feriados:', error);
      }
    })();

    function mostrarNotificacaoFeriado(feriado) {
      const notification = document.createElement('div');
      notification.className = 'feriado-notification glass-panel';
      notification.innerHTML = `
        <div class="feriado-content">
          <div class="feriado-emoji">🎉</div>
          <div class="feriado-text">
            <h4>${feriado.idiomas.pt}</h4>
            <p>${feriado.bot_frase.pt}</p>
          </div>
          <button class="feriado-close" onclick="this.parentElement.parentElement.remove()">×</button>
        </div>
      `;

      document.body.appendChild(notification);

      // Auto-remover após 10 segundos
      setTimeout(() => {
        if (notification.parentElement) {
          notification.remove();
        }
      }, 10000);
    }
  </script>

  <!-- Breadcrumb Generator Script -->
  <script is:inline>
    // Breadcrumb Generator
    function generateBreadcrumbs() {
      const path = window.location.pathname;
      const segments = path.split('/').filter(segment => segment !== '');

      // Breadcrumb mappings for better names
      const breadcrumbMap = {
        'chat-ia': 'Chat Inteligente',
        'sistema-tickets': 'Sistema de Tickets',
        'analise-sentimento': 'Análise de Sentimento',
        'magic-replies': 'Magic Replies',
        'gamificacao-vendas': 'Gamificação de Vendas',
        'programa-pontos': 'Programa de Pontos',
        'documentacao': 'Documentação',
        'api': 'API',
        'integracoes': 'Integrações',
        'suporte': 'Suporte',
        'faq': 'Perguntas Frequentes',
        'blog': 'Blog',
        'admin': 'Administração'
      };

      const breadcrumbNav = document.getElementById('breadcrumb-nav');
      const breadcrumbList = document.querySelector('.breadcrumb-list');

      if (segments.length === 0) {
        breadcrumbNav.style.display = 'none';
        return;
      }

      breadcrumbNav.style.display = 'block';

      // Clear existing breadcrumbs except home
      while (breadcrumbList.children.length > 1) {
        breadcrumbList.removeChild(breadcrumbList.lastChild);
      }

      let currentPath = '';

      segments.forEach((segment, index) => {
        currentPath += '/' + segment;

        const listItem = document.createElement('li');
        listItem.className = 'breadcrumb-item';

        const link = document.createElement('a');
        link.href = currentPath;
        link.className = 'breadcrumb-link';

        // Check if it's the last segment (current page)
        if (index === segments.length - 1) {
          link.classList.add('active');
          link.setAttribute('aria-current', 'page');
        }

        // Use mapped name or capitalize segment
        const displayName = breadcrumbMap[segment] ||
          segment.split('-').map(word =>
            word.charAt(0).toUpperCase() + word.slice(1)
          ).join(' ');

        link.textContent = displayName;
        listItem.appendChild(link);
        breadcrumbList.appendChild(listItem);
      });
    }

    // Generate breadcrumbs on page load and when navigating (for SPA-like behavior)
    document.addEventListener('DOMContentLoaded', generateBreadcrumbs);
    window.addEventListener('popstate', generateBreadcrumbs);
  </script>

