  <!-- Verification Tags (Replace content with your codes) -->
    <!-- Critical Resources Preload -->
    <!-- Script preloads removed to avoid warnings -->
    
    <!-- Fix Rocket Loader preload warning & Crossorigin issues -->
    <!-- This script runs immediately in the head to set crossorigin attributes before browser processes preloads -->
    <script is:inline>
      (function() {
        // Wait for the DOM to be ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', fixCrossorigin);
        } else {
          fixCrossorigin();
        }
        
        function fixCrossorigin() {
          // Handle all hoisted scripts
          document.querySelectorAll('script[src*="_astro/hoisted"]').forEach(s => {
            s.crossOrigin = 'anonymous';
          });
          
          // Handle preloads - add crossorigin attribute to prevent credential mode mismatch
          document.querySelectorAll('link[rel="preload"][as="script"]').forEach(l => {
            l.crossOrigin = 'anonymous';
          });
          
          // Also handle any other scripts that might be affected by Rocket Loader
          document.querySelectorAll('script[src]').forEach(s => {
            if (!s.crossOrigin) {
              s.crossOrigin = 'anonymous';
            }
          });
        }
      })();
    </script>

