      padding: 1rem 2rem;
      border-radius: 12px;
      font-weight: 800;
      text-decoration: none;
      font-size: 1rem;
      transition: 0.3s;
      display: inline-block;
      box-shadow: 0 10px 25px rgba(0, 212, 255, 0.3);
