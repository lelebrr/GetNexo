<button id="chat-fab" class="static z-[99999] flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-cyan-500 to-teal-500 shadow-xl hover:shadow-cyan-500/50 hover:scale-110 transition-all duration-300" aria-label="Abrir Demo IA" title="Falar com Demo IA">
  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    <path d="M12 11h.01"/><path d="M16 11h.01"/><path d="M8 11h.01"/>
  </svg>
</button>

<script nonce={Astro.locals.nonce}>
  // Carregamento dinâmico do script de modais apenas quando necessário
  let scriptsLoaded = false;
  let scriptsLoading = false;
  
  function loadModalScripts() {
    if (scriptsLoaded || scriptsLoading) return;
    
    scriptsLoading = true;
    
    // Carrega o script de modais dinamicamente
    const script = document.createElement('script');
    script.src = '/custom/js/modals-demo.js';
    script.isInline = true;
    document.head.appendChild(script);
    
    scriptsLoaded = true;
    console.log('Script de modais carregado dinamicamente');
  }
  
  document.getElementById('chat-fab').addEventListener('click', () => {
    // Carrega o script se ainda não foi carregado
    if (!scriptsLoaded) {
      loadModalScripts();
      // Aguarda um pouco para o script carregar antes de chamar a função
      setTimeout(() => {
        if (typeof abrirModalDemo === 'function') {
          abrirModalDemo();
        } else {
          // Se o script ainda não estiver pronto, tenta novamente
          setTimeout(() => {
            if (typeof abrirModalDemo === 'function') {
              abrirModalDemo();
            } else {
              alert('Demo chat ainda em setup – em breve!');
            }
          }, 500);
        }
      }, 300);
    } else {
      // Script já carregado, chama a função diretamente
      if (typeof abrirModalDemo === 'function') {
        abrirModalDemo();
      } else {
        alert('Demo chat ainda em setup – em breve!');
      }
    }
  });
</script>
