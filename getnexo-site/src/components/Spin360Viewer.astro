---
export interface Props {
  productId?: string;
  imageCount?: number;
  title?: string;
}

const {
  productId = 'demo',
  imageCount = 72,
  title = 'Girar Produto 360°'
} = Astro.props;
---

<!-- No painel: <div id="nexo-360-${productId}" class="w-full h-96 rounded-lg"></div> -->
<div id="nexo-360-${productId}" class="spin-360-container">
  <canvas id="spin-360-canvas-${productId}" class="spin-360-canvas"></canvas>

  <!-- Fallback -->
  <div class="spin-360-fallback">
    <img src="/assets/logo.svg" alt="Produto GetNexo" class="spin-360-preview" />
    <p>Carregando spinner 360°...</p>
    <div class="spin-360-loading">
      <div class="spin-360-spinner"></div>
    </div>
  </div>
</div>

<style>
  #nexo-360-${productId} {
    width: 100%;
    height: 400px;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .spin-360-canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    border-radius: 12px;
  }

  .spin-360-fallback {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    color: white;
    text-align: center;
    padding: 20px;
    border-radius: 12px;
  }

  .spin-360-preview {
    width: 120px;
    height: 120px;
    margin-bottom: 20px;
    filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.5));
    border-radius: 8px;
  }

  .spin-360-fallback p {
    margin: 10px 0 20px;
    font-size: 14px;
    opacity: 0.8;
  }

  .spin-360-loading {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .spin-360-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(0, 212, 255, 0.3);
    border-top: 4px solid #00d4ff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    #nexo-360-${productId} {
      height: 300px;
    }
  }
</style>

<script define:vars={{ productId, imageCount }}>
  import * as THREE from 'https://cdn.skypack.dev/three@0.150';
  import { OrbitControls } from 'https://cdn.skypack.dev/three@0.150/examples/jsm/controls/OrbitControls.js';

  const container = document.getElementById(`nexo-360-${productId}`);
  if (!container) return;

  // Carrega imagens em sequência
  const loader = new THREE.TextureLoader();
  const images = [];  // array de texturas
  let loaded = 0;

  for (let i = 1; i <= imageCount; i++) {
    const imgPath = `/360/${productId}/foto${String(i).padStart(3, '0')}.jpg`;
    loader.load(imgPath, (tex) => {
      images.push(tex);
      loaded++;
      if (loaded === imageCount) initSpinner();
    });
  }

  function initSpinner() {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(70, container.clientWidth / container.clientHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    container.appendChild(renderer.domElement);

    const geometry = new THREE.BoxGeometry(2, 2, 0.1);
    const material = new THREE.MeshBasicMaterial({ map: images[0] });
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    camera.position.z = 3;
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableZoom = false;
    controls.enablePan = false;

    let idx = 0;
    function animate() {
      requestAnimationFrame(animate);
      idx = (idx + 1) % imageCount;
      material.map = images[idx];
      material.needsUpdate = true;
      controls.update();
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
  }
</script>