---
import {
  Home as IconHome,
  MessageCircle as IconMessageCircle,
  Megaphone as IconSpeakerphone,
  Users as IconUsers,
  ShoppingCart as IconShoppingCart,
  Brain as IconBrain,
  BarChart as IconGraph,
  Heart as IconHeart,
  Plug as IconPlug,
  Settings as IconSettings,
  Shield as IconShield,
  HelpCircle as IconQuestionCircle,
  DollarSign as IconDollarSign,
  Zap as IconZap,
  LogOut as IconLogout,
  Tag as IconTag,
  ChevronDown as IconChevronDown,
  ChevronUp as IconChevronUp
} from 'lucide-react';

const { userName = 'Leandro' } = Astro.props;

const menuItems = [
  {
    title: "Dashboard Principal",
    href: "/admin",
    icon: IconHome,
    color: "indigo",
    badge: "Home",
    highlight: true
  },
  {
    title: "Conversas Ao Vivo",
    href: "/admin/live",
    icon: IconMessageCircle,
    color: "cyan",
    badge: "Live",
    highlight: true
  },
  {
    title: "Broadcasts & Campanhas",
    icon: IconSpeakerphone,
    color: "purple",
    subItems: [
      { title: "Nova Campanha", href: "/admin/broadcasts/new" },
      { title: "Histórico & ROI", href: "/admin/broadcasts/history" },
      { title: "A/B Testing", href: "/admin/broadcasts/abtest" },
      { title: "Templates Salvos", href: "/admin/broadcasts/templates" },
      { title: "Segmentação Avançada", href: "/admin/broadcasts/segments" }
    ]
  },
  {
    title: "Leads & CRM",
    icon: IconUsers,
    color: "emerald",
    subItems: [
      { title: "Lista Completa de Leads", href: "/admin/crm/leads" },
      { title: "Funil 360º", href: "/admin/crm/funnel" },
      { title: "Automação Follow-up", href: "/admin/crm/followup" },
      { title: "Histórico de Interações", href: "/admin/crm/history" },
      { title: "Exportar CSV", href: "/admin/crm/export" }
    ]
  },
  {
    title: "Catálogo & Produtos",
    icon: IconShoppingCart,
    color: "orange",
    subItems: [
      { title: "Todos os Produtos", href: "/admin/products" },
      { title: "Novo Produto", href: "/admin/products/new" },
      { title: "Editar Preços & Estoque", href: "/admin/products/edit" },
      { title: "Upload Imagens / 3D / Vídeo", href: "/admin/products/media" },
      { title: "Categorias & Tags", href: "/admin/products/categories" }
    ]
  },
  {
    title: "Magic Replies IA",
    icon: IconBrain,
    color: "pink",
    subItems: [
      { title: "Editor Visual de Fluxos", href: "/admin/magic-replies/editor" },
      { title: "Treinar IA Personalizada", href: "/admin/magic-replies/train" },
      { title: "Biblioteca Rápida", href: "/admin/magic-replies/library" },
      { title: "Testar Respostas", href: "/admin/magic-replies/test" },
      { title: "Histórico de Uso IA", href: "/admin/magic-replies/usage" }
    ]
  },
  {
    title: "PIX & Pagamentos",
    icon: IconDollarSign,
    color: "green",
    subItems: [
      { title: "Chaves PIX Ativas", href: "/admin/payments/keys" },
      { title: "Histórico de Recebimentos", href: "/admin/payments/history" },
      { title: "Reembolsos & Estornos", href: "/admin/payments/refunds" },
      { title: "Integração Mercado Pago", href: "/admin/payments/gateways" },
      { title: "Comprovantes Pendentes", href: "/admin/payments/pending" }
    ]
  },
  {
    title: "Automations & Flows",
    icon: IconZap,
    color: "yellow",
    subItems: [
      { title: "Criar Fluxo Novo", href: "/admin/automations/new" },
      { title: "Meus Fluxos", href: "/admin/automations/list" },
      { title: "Triggers (Eventos)", href: "/admin/automations/triggers" },
      { title: "Actions & Condições", href: "/admin/automations/actions" },
      { title: "Log de Execuções", href: "/admin/automations/logs" }
    ]
  },
  {
    title: "Analytics & BI",
    icon: IconGraph,
    color: "blue",
    subItems: [
      { title: "ROI Tempo Real", href: "/admin/analytics/roi" },
      { title: "Vendas por Produto", href: "/admin/analytics/products" },
      { title: "Geografia & Mapas", href: "/admin/analytics/geo" },
      { title: "Relatórios Customizados", href: "/admin/analytics/custom" },
      { title: "Agendar Emails Semanais", href: "/admin/analytics/schedule" }
    ]
  },
  {
    title: "Fidelidade & Retenção",
    icon: IconHeart,
    color: "red",
    subItems: [
      { title: "Sistema de Pontos", href: "/admin/loyalty/points" },
      { title: "Campanhas de Recompensa", href: "/admin/loyalty/rewards" },
      { title: "Top Clientes Fiéis", href: "/admin/loyalty/top" },
      { title: "Aniversariantes", href: "/admin/loyalty/birthdays" },
      { title: "Cupons Gerados", href: "/admin/loyalty/coupons" }
    ]
  },
  {
    title: "Tags & Segmentação",
    icon: IconTag,
    color: "teal",
    subItems: [
      { title: "Gerenciar Tags", href: "/admin/tags/manage" },
      { title: "Segmentos Dinâmicos", href: "/admin/tags/segments" },
      { title: "Relatório por Tag", href: "/admin/tags/reports" }
    ]
  },
  {
    title: "Integrações & APIs",
    icon: IconPlug,
    color: "violet",
    subItems: [
      { title: "Todas as 100+ Integrações", href: "/admin/integrations/list" },
      { title: "Nova Integração", href: "/admin/integrations/new" },
      { title: "Teste Webhook", href: "/admin/integrations/test" },
      { title: "Logs de Erros", href: "/admin/integrations/logs" }
    ]
  },
  {
    title: "Configurações Gerais",
    icon: IconSettings,
    color: "gray",
    subItems: [
      { title: "Perfil da Loja", href: "/admin/settings/profile" },
      { title: "Horário Comercial & Auto-Resposta", href: "/admin/settings/hours" },
      { title: "Multi-Loja / Filiais", href: "/admin/settings/multi" }
    ]
  },
  {
    title: "Segurança Master",
    icon: IconShield,
    color: "rose",
    subItems: [
      { title: "Whitelist de Números", href: "/admin/security/whitelist" },
      { title: "2FA & Acesso IP", href: "/admin/security/2fa" },
      { title: "Log Completo de Ações", href: "/admin/security/logs" },
      { title: "Bloqueio Anti-Spam", href: "/admin/security/spam" }
    ]
  },
  {
    title: "Ajuda & Suporte",
    href: "/admin/help",
    icon: IconQuestionCircle,
    color: "amber"
  }
];

// Color mapping for vibrant sections
const colorClasses = {
  indigo: {
    bg: "bg-indigo-900/30",
    hover: "hover:bg-indigo-900/50",
    text: "text-indigo-400",
    badge: "bg-indigo-600",
    border: "border-indigo-500/30"
  },
  cyan: {
    bg: "bg-cyan-900/30",
    hover: "hover:bg-cyan-900/50",
    text: "text-cyan-400",
    badge: "bg-cyan-600",
    border: "border-cyan-500/30"
  },
  purple: {
    bg: "bg-purple-900/30",
    hover: "hover:bg-purple-900/50",
    text: "text-purple-400",
    badge: "bg-purple-600",
    border: "border-purple-500/30"
  },
  emerald: {
    bg: "bg-emerald-900/30",
    hover: "hover:bg-emerald-900/50",
    text: "text-emerald-400",
    badge: "bg-emerald-600",
    border: "border-emerald-500/30"
  },
  orange: {
    bg: "bg-orange-900/30",
    hover: "hover:bg-orange-900/50",
    text: "text-orange-400",
    badge: "bg-orange-600",
    border: "border-orange-500/30"
  },
  pink: {
    bg: "bg-pink-900/30",
    hover: "hover:bg-pink-900/50",
    text: "text-pink-400",
    badge: "bg-pink-600",
    border: "border-pink-500/30"
  },
  green: {
    bg: "bg-green-900/30",
    hover: "hover:bg-green-900/50",
    text: "text-green-400",
    badge: "bg-green-600",
    border: "border-green-500/30"
  },
  yellow: {
    bg: "bg-yellow-900/30",
    hover: "hover:bg-yellow-900/50",
    text: "text-yellow-400",
    badge: "bg-yellow-600",
    border: "border-yellow-500/30"
  },
  blue: {
    bg: "bg-blue-900/30",
    hover: "hover:bg-blue-900/50",
    text: "text-blue-400",
    badge: "bg-blue-600",
    border: "border-blue-500/30"
  },
  red: {
    bg: "bg-red-900/30",
    hover: "hover:bg-red-900/50",
    text: "text-red-400",
    badge: "bg-red-600",
    border: "border-red-500/30"
  },
  teal: {
    bg: "bg-teal-900/30",
    hover: "hover:bg-teal-900/50",
    text: "text-teal-400",
    badge: "bg-teal-600",
    border: "border-teal-500/30"
  },
  violet: {
    bg: "bg-violet-900/30",
    hover: "hover:bg-violet-900/50",
    text: "text-violet-400",
    badge: "bg-violet-600",
    border: "border-violet-500/30"
  },
  gray: {
    bg: "bg-gray-800/50",
    hover: "hover:bg-gray-700/50",
    text: "text-gray-300",
    badge: "bg-gray-600",
    border: "border-gray-600/30"
  },
  rose: {
    bg: "bg-rose-900/30",
    hover: "hover:bg-rose-900/50",
    text: "text-rose-400",
    badge: "bg-rose-600",
    border: "border-rose-500/30"
  },
  amber: {
    bg: "bg-amber-900/30",
    hover: "hover:bg-amber-900/50",
    text: "text-amber-400",
    badge: "bg-amber-600",
    border: "border-amber-500/30"
  }
};
---

<aside class="w-72 bg-gradient-to-b from-gray-950 to-black text-white h-screen flex flex-col border-r border-gray-800 shadow-2xl overflow-y-auto">
  <!-- Header -->
  <div class="p-6 border-b border-gray-800 bg-gradient-to-r from-gray-900 to-gray-950">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20">
        <span class="text-white font-bold text-lg">G</span>
      </div>
      <div>
        <h1 class="text-xl font-bold bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">GetNexo Admin</h1>
        <p class="text-xs text-gray-400">Master: {userName}</p>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-4 py-6 space-y-1">
    {menuItems.map((item, index) => {
      const Icon = item.icon;
      const colors = colorClasses[item.color] || colorClasses.indigo;
      const isHighlighted = item.highlight;
      
      return (
        <div class="group" data-index={index}>
          <!-- Main Item -->
          <a
            href={item.href}
            class={`
              flex items-center justify-between px-4 py-3.5 rounded-xl
              transition-all duration-300 ease-out
              ${colors.bg} ${colors.hover}
              border border-transparent hover:border-${item.color}-500/30
              ${isHighlighted ? 'ring-2 ring-' + item.color + '-500/50 shadow-lg shadow-' + item.color + '-500/10' : ''}
              ${item.subItems ? 'cursor-pointer' : ''}
            `}
            data-has-sub={item.subItems ? 'true' : 'false'}
          >
            <div class="flex items-center space-x-4">
              <div class={`
                w-10 h-10 rounded-lg flex items-center justify-center
                ${colors.bg} ${colors.text}
                transition-transform duration-300 group-hover:scale-110
                shadow-lg shadow-${item.color}-500/20
              `}>
                <Icon className="w-6 h-6" />
              </div>
              <div class="flex flex-col">
                <span class={`font-semibold text-sm ${colors.text} transition-colors duration-200`}>
                  {item.title}
                </span>
                {item.badge && (
                  <span class={`text-xs ${colors.badge} px-2 py-0.5 rounded-full mt-1 inline-block w-fit`}>
                    {item.badge}
                  </span>
                )}
              </div>
            </div>
            
            {item.subItems && (
              <div class="flex items-center space-x-2">
                <span class="text-xs text-gray-500 group-hover:text-gray-300 transition-colors">
                  {item.subItems.length}
                </span>
                <div class="w-6 h-6 rounded-lg bg-gray-800/50 flex items-center justify-center transition-all duration-300 group-hover:bg-gray-700/50">
                  <IconChevronDown className="w-4 h-4 text-gray-400 group-hover:text-white transition-colors" />
                </div>
              </div>
            )}
          </a>

          <!-- Sub Items Dropdown -->
          {item.subItems && (
            <div
              class="ml-4 mt-1 space-y-1 overflow-hidden transition-all duration-500 ease-out max-h-0 opacity-0 group-hover:max-h-96 group-hover:opacity-100"
              data-submenu={index}
            >
              {item.subItems.map((sub, subIndex) => (
                <a
                  href={sub.href}
                  class={`
                    flex items-center px-4 py-2.5 rounded-lg
                    text-sm text-gray-400 hover:text-white
                    hover:bg-gray-800/50
                    transition-all duration-200
                    border-l-2 border-transparent hover:border-${item.color}-500/50
                    pl-6
                  `}
                >
                  <span class="flex-1">{sub.title}</span>
                  <span class="text-xs text-gray-600 hover:text-gray-400">→</span>
                </a>
              ))}
            </div>
          )}
        </div>
      );
    })}
  </nav>

  <!-- Footer -->
  <div class="p-4 border-t border-gray-800 bg-gradient-to-t from-gray-950 to-transparent">
    <a
      href="/logout"
      class={`
        flex items-center justify-center px-4 py-3.5 rounded-xl
        text-red-400 hover:text-red-300
        bg-red-900/20 hover:bg-red-900/30
        border border-red-500/20 hover:border-red-500/40
        transition-all duration-300
        group
      `}
    >
      <IconLogout className="w-5 h-5 mr-3 group-hover:scale-110 transition-transform" />
      <span class="font-medium">Sair do Painel</span>
    </a>
  </div>
</aside>

<script>
  // JavaScript para controlar os drop-downs
  document.addEventListener('DOMContentLoaded', () => {
    const menuItems = document.querySelectorAll('[data-has-sub="true"]');
    
    menuItems.forEach((item, index) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        
        const submenu = document.querySelector(`[data-submenu="${index}"]`);
        const chevron = item.querySelector('.w-6.h-6 svg');
        
        if (submenu) {
          const isExpanded = submenu.style.maxHeight && submenu.style.maxHeight !== '0px';
          
          if (isExpanded) {
            // Collapse
            submenu.style.maxHeight = '0px';
            submenu.style.opacity = '0';
            submenu.style.marginTop = '0';
            
            if (chevron) {
              chevron.style.transform = 'rotate(0deg)';
            }
          } else {
            // Expand
            submenu.style.maxHeight = '500px';
            submenu.style.opacity = '1';
            submenu.style.marginTop = '0.25rem';
            
            if (chevron) {
              chevron.style.transform = 'rotate(180deg)';
            }
          }
        }
      });
    });

    // Highlight active page
    const currentPath = window.location.pathname;
    const allLinks = document.querySelectorAll('a[href]');
    
    allLinks.forEach(link => {
      if (link.getAttribute('href') === currentPath) {
        link.classList.add('ring-2', 'ring-white/20');
        link.classList.add('bg-gray-800/50');
      }
    });
  });
</script>
