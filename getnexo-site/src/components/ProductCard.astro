---
// Produto vindo do JSON
interface Produto {
  imagens?: string[];
  imagem?: string;
  nome: string;
  preco: number;
  quartos?: number;
  area?: number;
  cpu?: string;
  cor?: string;
  '360'?: string;
  video?: string;
  audio?: string;
  voz?: boolean;
}

export let produto: Partial<Produto> = {};
---

<div class="product-card bg-void-black border border-neon-blue rounded-lg p-4 m-2 max-w-sm">
  {#if produto.imagens}
    <!-- Carrossel de imagens -->
    <div class="carousel relative overflow-hidden rounded">
      {#each (produto.imagens || []) as img, i}
        <img src={img} alt={produto.nome || ''} class="w-full h-48 object-cover {i === 0 ? '' : 'hidden'}" />
      {/each}
      <button type="button" aria-label="Anterior" class="prev absolute left-0 top-1/2 transform -translate-y-1/2 bg-black/50 text-white p-2 focus-visible:ring-2 focus-visible:outline-none rounded"><</button>
      <button type="button" aria-label="Próximo" class="next absolute right-0 top-1/2 transform -translate-y-1/2 bg-black/50 text-white p-2 focus-visible:ring-2 focus-visible:outline-none rounded">></button>
    </div>
  {#else if produto.imagem}
    <img src={produto.imagem} alt={produto.nome || ''} class="w-full h-48 object-cover rounded" />
  {/if}

  <h3 class="text-cyber-gold font-bold text-xl mt-2">{produto.nome || 'Produto'}</h3>
  <p class="text-matrix-green font-bold text-lg">R$ {(produto.preco || 0).toLocaleString()}</p>

  {#if produto.quartos}
    <p class="text-white">{produto.quartos} quartos • {produto.area}m²</p>
  {/if}

  {#if produto.cpu}
    <p class="text-white">{produto.cpu}</p>
  {/if}

  {#if produto.cor}
    <p class="text-white">Cor: {produto.cor}</p>
  {/if}

  <div class="mt-4 space-y-2" data-product-data={JSON.stringify(produto)}>
    {#if produto.360}
      <button class="btn-360 bg-void-black border border-matrix-green text-matrix-green px-6 py-2 rounded font-medium hover:bg-matrix-green hover:text-black transition">
        🔍 Girar 360°
      </button>
    {/if}

    {#if produto.video}
    <button class="btn-video mt-2 bg-void-black border border-cyber-gold text-cyber-gold px-6 py-2 rounded font-medium hover:bg-cyber-gold hover:text-black transition">
      ▶️ Ver vídeo
    </button>
    {/if}

    {#if produto.audio}
    <button class="btn-audio mt-2 bg-void-black border border-matrix-green text-matrix-green px-6 py-2 rounded font-medium hover:bg-matrix-green hover:text-black transition">
      🔊 Depoimento
    </button>
    {/if}

    {#if produto.voz}
    <button id="mic" class="mt-4 bg-black border border-neon-blue text-neon-blue px-6 py-3 rounded font-medium hover:bg-neon-blue hover:text-black transition">
      🎤 Falar por voz
    </button>
    {/if}
  </div>
</div>

<script nonce={Astro.locals.nonce}>
function createTrustedHTML(html) {
  if (window.getnexoTrustedTypes && window.getnexoTrustedTypes.policy) {
    return window.getnexoTrustedTypes.policy.createHTML(html);
  }
  return html;
}

function abrirVideo(url) {
  const iframe = document.createElement('iframe');
  iframe.src = url;
  iframe.width = '560';
  iframe.height = '315';
  iframe.frameBorder = '0';
  iframe.allowFullscreen = true;
  const modal = document.createElement('div');
  modal.className = 'fixed inset-0 bg-black/80 flex items-center justify-center z-50';
  
  const modalHtml = `
    <button type="button" aria-label="Fechar" class="modal-close absolute top-4 right-4 text-4xl text-white focus-visible:ring-2 focus-visible:outline-none rounded">&#x2715;</button>
    <div class="relative">${iframe.outerHTML}</div>
  `;
  modal.innerHTML = createTrustedHTML(modalHtml);
  
  const closeBtn = modal.querySelector('.modal-close');
  if (closeBtn) closeBtn.onclick = () => modal.remove();
  
  document.body.append(modal);
}

function tocarAudio(src) {
  const audio = new Audio(src);
  audio.play();
}

function abrir360(path) {
  const modal = document.createElement('div');
  modal.className = 'fixed inset-0 bg-black/90 flex items-center justify-center z-50';
  
  const modalHtml = `
    <button type="button" aria-label="Fechar" class="modal-close absolute top-4 right-4 text-white text-4xl focus-visible:ring-2 focus-visible:outline-none rounded">&#x2715;</button>
    <div id="viewer-360" class="w-11/12 h-80vh bg-gray-900"></div>
  `;
  modal.innerHTML = createTrustedHTML(modalHtml);
  
  const closeBtn = modal.querySelector('.modal-close');
  if (closeBtn) closeBtn.onclick = () => modal.remove();
  
  document.body.append(modal);

  // Carregar script do pannellum de forma lazy
  const script = document.createElement('script');
  script.src = 'https://cdn.jsdelivr.net/npm/pannellum@0.15.1/build/pannellum.js';
  script.loading = 'lazy';
  script.onload = () => {
    if (typeof pannellum !== 'undefined') {
      pannellum.viewer('viewer-360', {
        "type": "multires",
        "multiRes": {
          "basePath": path,
          "path": '/%l/%s%y.%p',
          "fallbackPath": '/fallback/%s.jpg',
          "extension": "jpg"
        },
        "autoLoad": true,
        "showZoomCtrl": true
      });
    }
  };
  document.head.append(script);
}

// Inicializar eventos para todos os cards
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.product-card').forEach(card => {
    const dataEl = card.querySelector('[data-product-data]');
    if (!dataEl) return;
    
    const data = JSON.parse(dataEl.getAttribute('data-product-data'));
    
    card.querySelector('.btn-360')?.addEventListener('click', () => abrir360(data['360']));
    card.querySelector('.btn-video')?.addEventListener('click', () => abrirVideo(data.video));
    card.querySelector('.btn-audio')?.addEventListener('click', () => tocarAudio(data.audio));
    
    const mic = card.querySelector('#mic');
    if (mic) {
      mic.addEventListener('click', () => {
        const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
        recognition.lang = 'pt-BR';
        recognition.onresult = e => {
          const texto = e.results[0][0].transcript;
          fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mensagem: texto })
          }).then(r => r.json()).then(newData => {
            const ut = new SpeechSynthesisUtterance(newData.resposta);
            ut.lang = 'pt-BR';
            speechSynthesis.speak(ut);
          });
        };
        recognition.start();
      });
    }
  });
});
</script>