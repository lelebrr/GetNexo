---
---
<!-- Modal Chat Completo -->
<div id="chat-modal" class="fixed inset-0 hidden z-[9999]" style="background: rgba(0,0,0,0.95); backdrop-filter: blur(8px); display: none;">
  <div class="modal-wrapper flex items-center justify-center min-h-screen p-4">
    <div class="bg-void-black border-2 border-neon-blue rounded-3xl p-6 w-full max-w-4xl h-[85vh] flex flex-col shadow-[0_0_50px_rgba(0,247,255,0.3)] relative">
    <div class="flex justify-between items-center mb-4">
      <div>
        <h3 class="text-2xl text-cyber-gold font-jetbrains">Demo GetNexo – IA Multimídia</h3>
        <p class="text-gray-300">IA responde e fala sozinha</p>
      </div>
      <button id="close-chat-modal-btn" aria-label="Fechar chat" class="text-neon-blue text-3xl hover:text-white focus-visible:ring-2 focus-visible:outline-none rounded">✖</button>
    </div>

    <div class="chat-container flex-1 overflow-hidden flex flex-col">
      <div class="chat-box flex-1 overflow-y-auto border border-neon-blue rounded p-4 mb-4 space-y-2" id="chat-messages-modal">
        <!-- Mensagem inicial -->
        <div class="flex justify-start">
          <div class="bg-neon-blue/20 border border-neon-blue/50 rounded-2xl px-4 py-3 max-w-md">
            <p class="text-white text-sm">🚀 <strong>Olá! Bem-vindo ao Chat IA do GetNexo!</strong></p>
            <p class="text-gray-300 text-xs mt-2">Eu sou um assistente inteligente capaz de:</p>
            <ul class="text-xs text-neon-blue mt-1 space-y-1">
              <li>• 💬 Conversar naturalmente sobre produtos</li>
              <li>• 🔍 Buscar itens em catálogo JSON</li>
              <li>• 🛒 Mostrar cards interativos com preços</li>
              <li>• 🔄 Exibir visualizações 360° dos produtos</li>
              <li>• 🎤 Responder por voz</li>
            </ul>
            <p class="text-cyber-gold text-xs mt-2 font-medium">💡 Teste comigo! Experimente:</p>
            <div class="flex flex-wrap gap-1 mt-2">
              <button class="preset-msg-btn bg-matrix-green/20 hover:bg-matrix-green/30 text-matrix-green text-xs px-2 py-1 rounded border border-matrix-green/30" data-msg="Quero um tênis branco">Quero um tênis branco</button>
              <button class="preset-msg-btn bg-cyber-gold/20 hover:bg-cyber-gold/30 text-cyber-gold text-xs px-2 py-1 rounded border border-cyber-gold/30" data-msg="Tem algum carro preto?">Tem carro preto?</button>
              <button class="preset-msg-btn bg-neon-blue/20 hover:bg-neon-blue/30 text-neon-blue text-xs px-2 py-1 rounded border border-neon-blue/30" data-msg="Procurando um PC gamer">PC gamer barato</button>
            </div>
          </div>
        </div>
      </div>

      <div class="input-bar flex gap-2">
        <input id="chat-input-modal" type="text" placeholder="Pergunte qualquer coisa..." class="flex-1 bg-void-black border border-neon-blue text-white rounded p-2" />
        <button id="send-msg-modal-btn" class="bg-cyber-gold text-black px-4 py-2 rounded">Enviar</button>
        <button id="start-voice-modal-btn" class="bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded">🎤 Voz</button>
      </div>
    </div>
  </div>
</div>

<script nonce={Astro.locals.nonce}>
  document.addEventListener('DOMContentLoaded', () => {
    const closeBtn = document.getElementById('close-chat-modal-btn');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        if (typeof window.fecharModalChat === 'function') {
          window.fecharModalChat();
        }
      });
    }

    const sendBtn = document.getElementById('send-msg-modal-btn');
    if (sendBtn) {
      sendBtn.addEventListener('click', () => {
        if (typeof window.sendMessageModal === 'function') {
          window.sendMessageModal();
        }
      });
    }

    const voiceBtn = document.getElementById('start-voice-modal-btn');
    if (voiceBtn) {
      voiceBtn.addEventListener('click', () => {
        if (typeof window.iniciarVozModal === 'function') {
          window.iniciarVozModal();
        }
      });
    }

    const chatInput = document.getElementById('chat-input-modal');
    if (chatInput) {
      chatInput.addEventListener('keydown', (e) => {
        if (typeof window.handleKeyPressModal === 'function') {
          window.handleKeyPressModal(e);
        }
      });
    }

    const presetBtns = document.querySelectorAll('.preset-msg-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const msg = btn.getAttribute('data-msg');
        if (msg && typeof window.preencherMensagemModal === 'function') {
          window.preencherMensagemModal(msg);
        }
      });
    });
  });
</script>
