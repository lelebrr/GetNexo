---
---
<!-- Modal Demo IA Interativa -->
<div id="ia-modal" class="fixed inset-0 hidden z-[9999]" style="background: rgba(0,0,0,0.95); backdrop-filter: blur(8px); display: none;">
  <div class="modal-wrapper flex items-center justify-center min-h-screen p-4">
    <div class="bg-void-black border-2 border-neon-blue rounded-3xl p-6 w-full max-w-6xl h-[90vh] overflow-hidden flex flex-col shadow-[0_0_50px_rgba(0,247,255,0.3)] relative">
    <div class="flex justify-between items-center mb-4">
      <div>
        <h3 class="text-2xl text-cyber-gold font-jetbrains">Demo IA Interativa GetNexo</h3>
        <p class="text-gray-300">Busca inteligente + multimídia</p>
      </div>
      <button id="close-ia-modal-btn" class="text-neon-blue text-3xl hover:text-white focus-visible:ring-2 focus-visible:outline-none rounded" aria-label="Fechar">×</button>
    </div>

    <div class="flex-1 overflow-hidden grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Chat Interface -->
      <div class="lg:col-span-2 bg-void-black/90 border border-neon-blue/50 rounded-2xl p-4 flex flex-col h-full">
        <div class="flex items-center mb-4">
          <div class="w-3 h-3 bg-matrix-green rounded-full mr-3"></div>
          <h4 class="text-xl text-cyber-gold font-jetbrains">Assistente IA</h4>
        </div>

        <div id="ia-chat-messages" class="flex-1 overflow-y-auto mb-4 space-y-4">
          <!-- Mensagem inicial -->
          <div class="flex justify-start">
            <div class="bg-neon-blue/20 border border-neon-blue/50 rounded-2xl px-4 py-3 max-w-md">
              <p class="text-white text-sm">🚀 <strong>Olá! Bem-vindo à Demo IA do GetNexo!</strong></p>
              <p class="text-gray-300 text-xs mt-2">Eu sou um assistente inteligente capaz de:</p>
              <ul class="text-xs text-neon-blue mt-1 space-y-1">
                <li>• 💬 Conversar naturalmente sobre produtos</li>
                <li>• 🔍 Buscar itens em catálogo JSON</li>
                <li>• 🛒 Mostrar cards interativos com preços</li>
                <li>• 🔄 Exibir visualizações 360° dos produtos</li>
                <li>• 🤖 Usar IA para entender suas necessidades</li>
              </ul>
              <p class="text-cyber-gold text-xs mt-2 font-medium">💡 Teste comigo! Experimente dizer:</p>
              <div class="flex flex-wrap gap-1 mt-2">
                <button class="preset-ia-msg-btn bg-matrix-green/20 hover:bg-matrix-green/30 text-matrix-green text-xs px-2 py-1 rounded border border-matrix-green/30" data-msg="apartamento 2 quartos">Apartamento 2 quartos</button>
                <button class="preset-ia-msg-btn bg-cyber-gold/20 hover:bg-cyber-gold/30 text-cyber-gold text-xs px-2 py-1 rounded border border-cyber-gold/30" data-msg="PC gamer barato">PC Gamer</button>
                <button class="preset-ia-msg-btn bg-neon-blue/20 hover:bg-neon-blue/30 text-neon-blue text-xs px-2 py-1 rounded border border-neon-blue/30" data-msg="pizza vegana">Pizza vegana</button>
              </div>
            </div>
          </div>
        </div>

        <div class="border-t border-neon-blue/30 pt-4">
          <div class="flex space-x-2">
            <input id="ia-chat-input" type="text" placeholder="Digite sua pergunta sobre produtos..." class="flex-1 bg-matrix-black border border-neon-blue/50 rounded-xl px-4 py-3 text-white placeholder-gray-400" />
            <button id="send-ia-msg-btn" class="bg-cyber-gold hover:bg-yellow-400 text-black px-6 py-3 rounded-xl font-medium">📤 Enviar</button>
            <button id="start-ia-voice-btn" class="bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-xl font-medium">🎤 Voz</button>
          </div>
        </div>
      </div>

      <!-- Product Showcase -->
      <div class="space-y-4 bg-void-black/90 border border-neon-blue/50 rounded-2xl p-4 overflow-y-auto">
        <h4 class="text-lg text-cyber-gold font-jetbrains mb-4">🎯 Produtos em Destaque</h4>

        <div class="space-y-3">
          <div id="show-product-car-btn" class="border border-matrix-green/30 rounded-lg p-3 bg-matrix-black/50 hover:bg-matrix-green/10 transition-colors cursor-pointer" data-type="carro" data-index="0">
            <div class="flex items-center space-x-2">
              <span class="text-2xl">🚗</span>
              <div class="flex-1">
                <h5 class="text-cyber-gold text-sm font-medium">Cruze RS Turbo 2026</h5>
                <p class="text-neon-blue text-xs">Preto • R$ 129.990</p>
              </div>
            </div>
          </div>

          <div id="show-product-phone-btn" class="border border-cyber-gold/30 rounded-lg p-3 bg-matrix-black/50 hover:bg-cyber-gold/10 transition-colors cursor-pointer" data-type="celular" data-index="0">
            <div class="flex items-center space-x-2">
              <span class="text-2xl">📱</span>
              <div class="flex-1">
                <h5 class="text-cyber-gold text-sm font-medium">iPhone 15 128GB</h5>
                <p class="text-neon-blue text-xs">Azul • R$ 4.299</p>
              </div>
            </div>
          </div>

          <div id="show-product-pc-btn" class="border border-neon-blue/30 rounded-lg p-3 bg-matrix-black/50 hover:bg-neon-blue/10 transition-colors cursor-pointer" data-type="computador" data-index="0">
            <div class="flex items-center space-x-2">
              <span class="text-2xl">💻</span>
              <div class="flex-1">
                <h5 class="text-cyber-gold text-sm font-medium">PC Warrior i5 12ª</h5>
                <p class="text-neon-blue text-xs">RTX 3060 • R$ 4.990</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal para produto IA -->
<div id="product-modal-ia" class="fixed inset-0 bg-black/80 hidden z-60 flex items-center justify-center">
  <div class="bg-void-black border border-neon-blue rounded-2xl p-6 max-w-md w-full mx-4">
    <div class="flex justify-between items-center mb-4">
      <h4 class="text-xl text-cyber-gold font-jetbrains">Produto Encontrado</h4>
      <button id="close-product-modal-ia-btn" class="text-neon-blue text-2xl hover:text-white focus-visible:ring-2 focus-visible:outline-none rounded" aria-label="Fechar">×</button>
    </div>
    <div id="product-content-ia"></div>
  </div>
</div>

<script nonce={Astro.locals.nonce}>
  document.addEventListener('DOMContentLoaded', () => {
    // Close IA Modal
    const closeIaBtn = document.getElementById('close-ia-modal-btn');
    if (closeIaBtn) {
      closeIaBtn.addEventListener('click', () => {
        if (typeof window.fecharModalIA === 'function') {
          window.fecharModalIA();
        }
      });
    }

    // Send IA Message
    const sendIaBtn = document.getElementById('send-ia-msg-btn');
    if (sendIaBtn) {
      sendIaBtn.addEventListener('click', () => {
        if (typeof window.sendMessageIA === 'function') {
          window.sendMessageIA();
        }
      });
    }

    // IA Voice
    const voiceIaBtn = document.getElementById('start-ia-voice-btn');
    if (voiceIaBtn) {
      voiceIaBtn.addEventListener('click', () => {
        if (typeof window.iniciarVozIA === 'function') {
          window.iniciarVozIA();
        }
      });
    }

    // Input Keypress
    const iaInput = document.getElementById('ia-chat-input');
    if (iaInput) {
      iaInput.addEventListener('keydown', (e) => {
        if (typeof window.handleKeyPressIA === 'function') {
          window.handleKeyPressIA(e);
        }
      });
    }

    // Preset Messages
    const presetIaBtns = document.querySelectorAll('.preset-ia-msg-btn');
    presetIaBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const msg = btn.getAttribute('data-msg');
        if (msg && typeof window.preencherMensagemIA === 'function') {
          window.preencherMensagemIA(msg);
        }
      });
    });

    // Show Product Buttons
    const productBtns = [
      document.getElementById('show-product-car-btn'),
      document.getElementById('show-product-phone-btn'),
      document.getElementById('show-product-pc-btn')
    ];
    productBtns.forEach(btn => {
      if (btn) {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-type');
          const index = parseInt(btn.getAttribute('data-index'));
          if (type && typeof window.mostrarProdutoIA === 'function') {
            window.mostrarProdutoIA(type, index);
          }
        });
      }
    });

    // Close Product Modal
    const closeProductBtn = document.getElementById('close-product-modal-ia-btn');
    if (closeProductBtn) {
      closeProductBtn.addEventListener('click', () => {
        if (typeof window.fecharModalProdutoIA === 'function') {
          window.fecharModalProdutoIA();
        }
      });
    }
  });
</script>
