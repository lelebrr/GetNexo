---
// Componente de Controles de Acessibilidade WCAG AA
export interface Props {
  showPanel?: boolean;
  nonce?: string;
}

const { showPanel = true, nonce } = Astro.props;
---

  <div id="accessibility-panel" class="accessibility-panel fixed bottom-[100px] left-6 z-[10000] bg-[#030712]/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-white/10 p-6 w-[280px] transition-all duration-300 pointer-events-none opacity-0 invisible translate-y-4 hidden-forced">
    <div class="flex items-center justify-between mb-4 border-b border-white/5 pb-2">
      <h3 class="text-sm font-bold text-white flex items-center">
        <span class="mr-2 text-[#00d4ff]">♿</span>
        Acessibilidade
      </h3>
      <button
        id="accessibility-close"
        class="text-gray-400 hover:text-white text-2xl leading-none transition-colors"
        aria-label="Fechar painel de acessibilidade"
      >
        ×
      </button>
    </div>

    <div class="space-y-5">
      <!-- Controle de Zoom -->
      <div class="flex flex-col gap-2">
        <label for="zoom-control" class="text-[10px] uppercase tracking-wider font-bold text-gray-500 flex items-center">
          <span class="mr-2 text-[#00d4ff]">🔍</span>
          Ajustar Zoom
        </label>
        <div class="flex items-center justify-between bg-white/5 rounded-xl p-2 border border-white/5">
          <button id="zoom-decrease" class="w-8 h-8 flex items-center justify-center text-lg bg-white/10 hover:bg-[#00d4ff] hover:text-black rounded-lg transition-all">-</button>
          <span id="zoom-level" class="text-xs font-black min-w-[3rem] text-center text-white">100%</span>
          <button id="zoom-increase" class="w-8 h-8 flex items-center justify-center text-lg bg-white/10 hover:bg-[#00d4ff] hover:text-black rounded-lg transition-all">+</button>
        </div>
      </div>

      <!-- Modo Acessibilidade -->
      <div class="flex items-center justify-between bg-white/5 rounded-xl p-3 border border-white/5">
        <label class="text-[10px] uppercase tracking-wider font-bold text-gray-500">Auto-Contraste</label>
        <button id="accessibility-mode-toggle" class="relative inline-flex h-6 w-11 items-center rounded-full bg-white/10 transition-colors">
          <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform translate-x-1 shadow-sm"></span>
        </button>
      </div>

      <!-- Reset -->
      <button id="accessibility-reset" class="w-full py-3 px-4 text-[10px] uppercase tracking-widest font-black bg-red-500/10 text-red-500 border border-red-500/20 rounded-xl hover:bg-red-500 hover:text-white transition-all duration-300">
        ✨ Resetar Padrão
      </button>
    </div>
  </div>

<!-- Minimized Circle Trigger -->
<button
  id="accessibility-trigger"
  class="accessibility-trigger"
  aria-label="Abrir painel de acessibilidade"
>
  <span class="acc-icon">♿</span>
</button>

<style>
  .accessibility-trigger {
    width: 56px;
    height: 56px;
    background: #007acc;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 122, 204, 0.4);
    border: 2px solid rgba(255,255,255,0.2);
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    pointer-events: auto;
    position: fixed;
    bottom: 30px;
    left: 30px;
    z-index: 9999;
  }
  .accessibility-trigger:hover {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 15px 40px rgba(0, 122, 204, 0.6);
  }
  @media (max-width: 768px) {
    .accessibility-trigger {
      width: 48px;
      height: 48px;
      font-size: 1.2rem;
    }
  }
</style>

<!-- Accessibility Styles -->
<style>
  .accessibility-panel {
    font-family: system-ui, -apple-system, sans-serif;
  }

  /* High Contrast Mode */
  .high-contrast {
    filter: contrast(150%);
  }

  .high-contrast * {
    border-color: #000 !important;
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  .reduced-motion * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  /* Focus Styles for Keyboard Navigation */
  .keyboard-navigation *:focus {
    outline: 3px solid #007acc !important;
    outline-offset: 2px !important;
  }

  /* Screen Reader Only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .sr-only.focus:not-sr-only {
    position: static;
    width: auto;
    height: auto;
    padding: inherit;
    margin: inherit;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>

<!-- Accessibility JavaScript -->
<script nonce={nonce}>
  // Accessibility State
  let accessibilityState = {
    zoom: 1,
    reducedMotion: false,
    highContrast: false,
    keyboardNavigation: false,
    screenReader: false,
    accessibilityMode: false
  };

  // Load saved preferences
  function loadAccessibilityPreferences() {
    const saved = localStorage.getItem('accessibility-preferences');
    if (saved) {
      accessibilityState = { ...accessibilityState, ...JSON.parse(saved) };
      applyAccessibilitySettings();
      updateUI();
    }

    // Check system preferences
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      accessibilityState.reducedMotion = true;
    }
  }

  // Save preferences
  function saveAccessibilityPreferences() {
    localStorage.setItem('accessibility-preferences', JSON.stringify(accessibilityState));
  }

  // Apply all settings
  function applyAccessibilitySettings() {
    const body = document.body;

    // Zoom
    body.style.zoom = accessibilityState.zoom;
    body.style.transform = `scale(${accessibilityState.zoom})`;
    body.style.transformOrigin = 'top left';

    // Reduced Motion
    if (accessibilityState.reducedMotion) {
      body.classList.add('reduced-motion');
    } else {
      body.classList.remove('reduced-motion');
    }

    // High Contrast
    if (accessibilityState.highContrast) {
      body.classList.add('high-contrast');
    } else {
      body.classList.remove('high-contrast');
    }

    // Keyboard Navigation
    if (accessibilityState.keyboardNavigation) {
      body.classList.add('keyboard-navigation');
    } else {
      body.classList.remove('keyboard-navigation');
    }
  }

  // Update UI elements
  function updateUI() {
    // Update zoom level
    const zoomLevel = document.getElementById('zoom-level');
    if (zoomLevel) {
      zoomLevel.textContent = Math.round(accessibilityState.zoom * 100) + '%';
    }

    // Update toggles
    updateToggle('accessibility-mode-toggle', accessibilityState.accessibilityMode);
    updateToggle('keyboard-nav-toggle', accessibilityState.keyboardNavigation);
  }

  function updateToggle(toggleId, state) {
    const toggle = document.getElementById(toggleId);
    if (toggle) {
      const span = toggle.querySelector('span');
      if (state) {
        toggle.classList.remove('bg-gray-200');
        toggle.classList.add('bg-blue-600');
        span.classList.add('translate-x-6');
        toggle.setAttribute('aria-checked', 'true');
      } else {
        toggle.classList.remove('bg-blue-600');
        toggle.classList.add('bg-gray-200');
        span.classList.remove('translate-x-6');
        span.classList.add('translate-x-1');
        toggle.setAttribute('aria-checked', 'false');
      }
    }
  }

  // Control Functions
  function changeZoom(delta) {
    accessibilityState.zoom = Math.max(0.5, Math.min(2, accessibilityState.zoom + delta));
    applyAccessibilitySettings();
    updateUI();
    saveAccessibilityPreferences();

    // Announce change for screen readers
    announceChange(`Zoom alterado para ${Math.round(accessibilityState.zoom * 100)}%`);
  }

  function toggleReducedMotion() {
    accessibilityState.reducedMotion = !accessibilityState.reducedMotion;
    applyAccessibilitySettings();
    updateUI();
    saveAccessibilityPreferences();

    announceChange(accessibilityState.reducedMotion ? 'Movimento reduzido ativado' : 'Movimento reduzido desativado');
  }

  function toggleHighContrast() {
    accessibilityState.highContrast = !accessibilityState.highContrast;
    applyAccessibilitySettings();
    updateUI();
    saveAccessibilityPreferences();

    announceChange(accessibilityState.highContrast ? 'Alto contraste ativado' : 'Alto contraste desativado');
  }

  function toggleAccessibilityMode() {
    accessibilityState.accessibilityMode = !accessibilityState.accessibilityMode;
    accessibilityState.reducedMotion = accessibilityState.accessibilityMode;
    accessibilityState.highContrast = accessibilityState.accessibilityMode;
    applyAccessibilitySettings();
    updateUI();
    saveAccessibilityPreferences();

    announceChange(accessibilityState.accessibilityMode ? 'Modo acessibilidade ativado' : 'Modo acessibilidade desativado');
  }

  function toggleKeyboardNavigation() {
    accessibilityState.keyboardNavigation = !accessibilityState.keyboardNavigation;
    applyAccessibilitySettings();
    updateUI();
    saveAccessibilityPreferences();

    announceChange(accessibilityState.keyboardNavigation ? 'Navegação por teclado ativada' : 'Navegação por teclado desativada');
  }

  function toggleScreenReader() {
    accessibilityState.screenReader = !accessibilityState.screenReader;

    if (accessibilityState.screenReader) {
      startScreenReader();
      announceChange('Assistente de voz ativado');
    } else {
      stopScreenReader();
      announceChange('Assistente de voz desativado');
    }

    saveAccessibilityPreferences();
  }

  function resetAccessibility() {
    accessibilityState = {
      zoom: 1,
      reducedMotion: false,
      highContrast: false,
      keyboardNavigation: false,
      screenReader: false,
      accessibilityMode: false
    };

    applyAccessibilitySettings();
    updateUI();
    saveAccessibilityPreferences();

    announceChange('Configurações de acessibilidade resetadas');
  }

  function toggleAccessibilityPanel() {
    const panel = document.getElementById('accessibility-panel');
    if (panel) {
      if (panel.style.display === 'none') {
        // Show
        panel.style.display = 'block';
        // Small delay to allow transition
        requestAnimationFrame(() => {
          panel.classList.remove('opacity-0', 'invisible', 'translate-y-4', 'pointer-events-none');
        });
      } else {
        // Hide
        panel.classList.add('opacity-0', 'invisible', 'translate-y-4', 'pointer-events-none');
        // Wait for transition to finish before setting display none (optional, but safer to just leave it hidden by classes if transition works, but if we want to force it away:)
        setTimeout(() => {
            if (panel.classList.contains('invisible')) {
                panel.style.display = 'none';
            }
        }, 300);
      }
    }
  }

  // Close panel on outside click
  document.addEventListener('click', (e) => {
    const panel = document.getElementById('accessibility-panel');
    const trigger = document.getElementById('accessibility-trigger');
    if (panel && panel.style.display !== 'none' && !panel.contains(e.target) && !trigger.contains(e.target)) {
      toggleAccessibilityPanel();
    }
  });

  // Screen Reader Functions
  let speechSynthesis = null;
  let currentSpeech = null;

  function startScreenReader() {
    if ('speechSynthesis' in window) {
      speechSynthesis = window.speechSynthesis;

      // Add click listeners to announce interactive elements
      document.addEventListener('click', handleElementAnnouncement);
      document.addEventListener('focus', handleElementAnnouncement);

      announceChange('Assistente de voz iniciado. Clique em elementos para ouvi-los.');
    } else {
      announceChange('Seu navegador não suporta síntese de voz.');
    }
  }

  function stopScreenReader() {
    if (speechSynthesis) {
      speechSynthesis.cancel();
    }
    document.removeEventListener('click', handleElementAnnouncement);
    document.removeEventListener('focus', handleElementAnnouncement);
  }

  function handleElementAnnouncement(event) {
    const element = event.target;
    let textToSpeak = '';

    // Get accessible text
    if (element.getAttribute('aria-label')) {
      textToSpeak = element.getAttribute('aria-label');
    } else if (element.textContent) {
      textToSpeak = element.textContent.trim();
    } else if (element.getAttribute('alt')) {
      textToSpeak = element.getAttribute('alt');
    } else if (element.tagName === 'BUTTON') {
      textToSpeak = 'Botão';
    } else if (element.tagName === 'INPUT') {
      textToSpeak = `${element.getAttribute('type') || 'campo de entrada'} ${element.getAttribute('placeholder') || ''}`;
    }

    if (textToSpeak) {
      speakText(textToSpeak);
    }
  }

  function speakText(text) {
    if (speechSynthesis) {
      // Cancel previous speech
      if (currentSpeech) {
        speechSynthesis.cancel();
      }

      currentSpeech = new SpeechSynthesisUtterance(text);
      currentSpeech.lang = 'pt-BR'; // Portuguese

      speechSynthesis.speak(currentSpeech);
    }
  }

  function announceChange(message) {
    if (accessibilityState.screenReader) {
      speakText(message);
    }

    // Also show as toast notification for visual feedback
    showToast(message);
  }

  function showToast(message) {
    // Simple toast implementation
    const toast = document.createElement('div');
    toast.className = 'fixed top-4 right-4 bg-blue-600 text-white px-4 py-2 rounded-lg shadow-lg z-50 max-w-xs';
    toast.textContent = message;

    document.body.appendChild(toast);

    setTimeout(() => {
      toast.remove();
    }, 3000);
  }

  // Skip Link Handler
  function handleSkipLink(event) {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      const mainContent = document.getElementById('main-content');
      if (mainContent) {
        mainContent.focus();
        mainContent.scrollIntoView();
      }
    }
  }

  // ARIA Live Region for announcements
  function createAriaLiveRegion() {
    const liveRegion = document.createElement('div');
    liveRegion.setAttribute('aria-live', 'polite');
    liveRegion.setAttribute('aria-atomic', 'true');
    liveRegion.className = 'sr-only';
    liveRegion.id = 'accessibility-announcements';
    document.body.appendChild(liveRegion);
  }

  // Keyboard Navigation Enhancements
  function enhanceKeyboardNavigation() {
    // Add visible focus indicators
    const style = document.createElement('style');
    style.textContent = `
      .keyboard-navigation *:focus {
        outline: 3px solid #007acc !important;
        outline-offset: 2px !important;
      }
    `;
    document.head.appendChild(style);

    // Handle Tab navigation
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Tab') {
        document.body.classList.add('keyboard-navigation');
      }
    });

    // Reset on mouse usage
    document.addEventListener('mousedown', function() {
      document.body.classList.remove('keyboard-navigation');
    });
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', function() {
    loadAccessibilityPreferences();
    createAriaLiveRegion();
    enhanceKeyboardNavigation();

    // Add keyboard shortcuts
    document.addEventListener('keydown', function(event) {
      // Alt+A to toggle accessibility panel
      if (event.altKey && event.key === 'a') {
        event.preventDefault();
        toggleAccessibilityPanel();
      }

      // Ctrl+Plus/Ctrl+Minus for zoom
      if (event.ctrlKey) {
        if (event.key === '=') {
          event.preventDefault();
          changeZoom(0.1);
        } else if (event.key === '-') {
          event.preventDefault();
          changeZoom(-0.1);
        } else if (event.key === '0') {
          event.preventDefault();
          accessibilityState.zoom = 1;
          applyAccessibilitySettings();
          updateUI();
          saveAccessibilityPreferences();
        }
      }
    });
  });

    // Export functions to global scope for inline onclick handlers - REMOVED, using event listeners now.
    // window.toggleAccessibilityPanel = toggleAccessibilityPanel;
    // window.changeZoom = changeZoom;
    // ...

    // Bind event listeners
    const el = (id) => document.getElementById(id);
    el('accessibility-close')?.addEventListener('click', toggleAccessibilityPanel);
    el('accessibility-trigger')?.addEventListener('click', toggleAccessibilityPanel);
    el('zoom-decrease')?.addEventListener('click', () => changeZoom(-0.1));
    el('zoom-increase')?.addEventListener('click', () => changeZoom(0.1));
    el('accessibility-mode-toggle')?.addEventListener('click', toggleAccessibilityMode);
    el('accessibility-reset')?.addEventListener('click', resetAccessibility);
</script>
