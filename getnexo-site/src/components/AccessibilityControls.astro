---
// Componente de Controles de Acessibilidade - Premium & Robust
// Uses scoped CSS to guarantee appearance independent of global Tailwind config
export interface Props {
  showPanel?: boolean;
}

const { showPanel = true } = Astro.props;
---

<div id="acc-widget-root">
  <button id="acc-trigger" class="accessibility-trigger" title="Acessibilidade" aria-label="Abrir opções de acessibilidade">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-cyan-400">
      <circle cx="12" cy="16" r="4" stroke="currentColor" stroke-width="2.5"/>
      <circle cx="12" cy="8" r="3" stroke="currentColor" stroke-width="2.5"/>
      <path d="M12 11v5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M8 16h8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M9 13l-2 3m10-3l2 3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M12 4v4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Panel -->
  <div id="acc-panel" class="hidden">
    <div class="acc-header">
      <h3>
        <span class="icon">♿</span> Acessibilidade
      </h3>
      <button id="acc-close" aria-label="Fechar painel">&times;</button>
    </div>

    <div class="acc-content">
      
      <!-- Feature Grid -->
      <div class="acc-grid">
        <!-- Font Size -->
        <div class="acc-item full-width">
          <label>Tamanho da Fonte</label>
          <div class="acc-buttons-row">
            <button id="zoom-out" aria-label="Diminuir fonte">-</button>
            <span id="zoom-display">100%</span>
            <button id="zoom-in" aria-label="Aumentar fonte">+</button>
          </div>
        </div>

        <!-- Tour Guided (Integrated) -->
        <button class="acc-toggle-btn tour-btn" id="trigger-tour">
          <span class="icon">🎯</span>
          <span>Iniciar Tour</span>
        </button>

        <!-- Legible Font -->
        <button class="acc-toggle-btn" id="toggle-font">
          <span class="icon">Aa</span>
          <span>Fonte Legível</span>
        </button>

        <!-- Highlight Links -->
        <button class="acc-toggle-btn" id="toggle-highlight">
          <span class="icon">🔗</span>
          <span>Links</span>
        </button>

        <!-- Big Cursor -->
        <button class="acc-toggle-btn" id="toggle-cursor">
          <span class="icon">👆</span>
          <span>Cursor</span>
        </button>

        <!-- Monochrome -->
        <button class="acc-toggle-btn" id="toggle-mono">
          <span class="icon">🌗</span>
          <span>P&B</span>
        </button>

        <!-- Contrast -->
        <button class="acc-toggle-btn" id="toggle-contrast">
          <span class="icon">👁️</span>
          <span>Contraste</span>
        </button>

         <!-- Stop Animations -->
         <button class="acc-toggle-btn" id="toggle-motion">
          <span class="icon">⏹️</span>
          <span>Parar Anim.</span>
        </button>
      </div>

      <!-- Reading Guide Control -->
      <div class="acc-control-group row top-border">
        <label>Guia de Leitura</label>
        <div class="acc-toggle-wrapper">
          <input type="checkbox" id="toggle-guide">
          <label for="toggle-guide" class="acc-toggle-label"></label>
        </div>
      </div>

      <!-- Reset -->
      <button id="acc-reset">Restaurar Padrão</button>
    </div>
  </div>
</div>

<!-- Reading Guide Element -->
<div id="reading-guide-line"></div>

<style is:global>
  /* Global CSS to guarantee look and feel and avoid scoping issues */
  #acc-widget-root {
    position: fixed;
    bottom: 30px;
    left: 30px;
    z-index: 99999999;
    font-family: 'Inter', system-ui, sans-serif;
    /* Reset font size on the widget container to 16px fixed, so it doesn't inherit root scaling */
    font-size: 16px !important;
  }

  /* Trigger Button - Smaller */
  #acc-trigger {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #00d4ff, #0056b3);
    border: 2px solid rgba(255, 255, 255, 0.2);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: auto;
  }

  #acc-trigger:hover {
    transform: scale(1.1) rotate(10deg);
    box-shadow: 0 12px 24px rgba(0, 212, 255, 0.4);
  }

  /* The Panel - Compact & Responsive */
  #acc-panel {
    display: none; /* Critical: hidden by default */
    position: absolute;
    bottom: 64px; /* 4rem -> 64px, nicely above button */
    left: 0;
    width: 260px; /* Fixed width */
    background-color: #0f172a !important; /* Force Solid Slate 900 */
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    color: white;
    z-index: 99999999;
    transform-origin: bottom left;
  }

  /* Responsive fixes */
  @media (max-width: 480px) {
    #acc-panel {
      width: 240px;
      bottom: 56px; /* 3.5rem equivalent */
    }
  }

  #acc-panel.open {
    display: block !important;
    animation: slideUp 0.3s ease-out;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(10px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Header - Compact */
  .acc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px; /* 0.75rem 1rem */
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .acc-header h3 {
    margin: 0;
    font-size: 13.6px; /* 0.85rem */
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6.4px; /* 0.4rem */
    color: white;
  }

  #acc-close {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 20px; /* 1.25rem */
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition: color 0.2s;
  }

  #acc-close:hover {
    color: white;
  }

  /* Content - Compact */
  .acc-content {
    padding: 16px; /* 1rem */
    display: flex;
    flex-direction: column;
    gap: 12.8px; /* 0.8rem */
    background: #0f172a;
  }

  /* Grid Layout - Tighter gap */
  .acc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px; /* 0.5rem */
  }

  .acc-item.full-width {
    grid-column: span 2;
    margin-bottom: 4px; /* 0.25rem */
  }

  .acc-item label {
    display: block;
    font-size: 11.2px; /* 0.7rem */
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 6.4px; /* 0.4rem */
  }

  /* Toggle Buttons - Compact */
  .acc-toggle-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 9.6px 6.4px; /* 0.6rem 0.4rem */
    color: #94a3b8;
    cursor: pointer;
    font-size: 11.2px; /* 0.7rem */
    font-weight: 600;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4.8px; /* 0.3rem */
    transition: all 0.2s;
  }

  .acc-toggle-btn .icon {
    font-size: 17.6px; /* 1.1rem */
    margin-bottom: 1.6px; /* 0.1rem */
  }

  .acc-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .acc-toggle-btn.active {
    background: rgba(0, 212, 255, 0.15);
    color: #00d4ff;
    border-color: rgba(0, 212, 255, 0.3);
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.1);
  }

  /* Tour Button Style */
  .acc-toggle-btn.tour-btn {
    border-color: rgba(147, 51, 234, 0.3);
    background: rgba(147, 51, 234, 0.05);
    color: #c084fc;
  }
  .acc-toggle-btn.tour-btn:hover {
    background: rgba(147, 51, 234, 0.15);
    color: white;
  }

  /* Zoom Control - Compact */
  .acc-buttons-row {
    display: flex;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 3px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .acc-buttons-row button {
    width: 32px; /* 2rem */
    height: 28.8px; /* 1.8rem */
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: white;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px; /* 1rem */
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .acc-buttons-row button:hover {
    background: rgba(0, 212, 255, 0.2);
    color: #00d4ff;
  }

  #zoom-display {
    flex: 1;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    font-size: 12.8px; /* 0.8rem */
    color: white;
  }

  /* Reading Guide Toggle Row */
  .acc-control-group.row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-border {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 12.8px; /* 0.8rem */
  }

  .acc-toggle-wrapper {
    position: relative;
    width: 36px;
    height: 20px;
  }

  .acc-toggle-wrapper input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .acc-toggle-label {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #334155;
    transition: .4s;
    border-radius: 34px;
  }

  .acc-toggle-label:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 2px;
    bottom: 2px;
    background-color: white;
    transition: .4s;
    border-radius: 50%;
  }

  input:checked + .acc-toggle-label {
    background-color: #00d4ff;
  }

  input:checked + .acc-toggle-label:before {
    transform: translateX(16px);
  }

  /* Reset Button - Compact */
  #acc-reset {
    width: 100%;
    background: rgba(239, 68, 68, 0.1);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 9.6px; /* 0.6rem */
    border-radius: 8px;
    font-weight: 700;
    font-size: 12px; /* 0.75rem */
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }

  #acc-reset:hover {
    background: rgba(239, 68, 68, 0.2);
    color: white;
  }

  /* Reading Guide Line */
  #reading-guide-line {
    position: fixed;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 0, 0.5);
    box-shadow: 0 0 0 10000px rgba(0, 0, 0, 0.3);
    z-index: 2147483640;
    pointer-events: none;
    display: none;
    transform: translateY(-50%);
  }
  #reading-guide-line.active {
    display: block;
  }

  /* Global Accessibility Classes (Body) */
  body.acc-dyslexia {
    font-family: 'Open Sans', 'Arial', sans-serif !important;
    line-height: 1.8 !important;
    letter-spacing: 0.05em !important;
  }
  body.acc-dyslexia p, 
  body.acc-dyslexia h1, 
  body.acc-dyslexia h2, 
  body.acc-dyslexia h3, 
  body.acc-dyslexia span {
    word-spacing: 0.1em;
  }

  body.acc-cursor {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewport="0 0 48 48" style="fill:black;stroke:white;stroke-width:2px;"><path d="M10 40L40 24L10 8z"/></svg>') 0 0, auto !important;
  }
  body.acc-cursor a, 
  body.acc-cursor button {
    cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewport="0 0 48 48" style="fill:yellow;stroke:black;stroke-width:2px;"><path d="M10 40L40 24L10 8z"/></svg>') 0 0, pointer !important;
  }

  body.acc-highlight-links a {
    text-decoration: underline !important;
    background-color: rgba(255, 255, 0, 0.2) !important;
    color: #000000 !important;
  }
  body.acc-highlight-links button {
    outline: 2px solid yellow !important;
  }

  body.acc-monochrome {
    filter: grayscale(100%) !important;
  }

  body.acc-stop-motion *,
  body.acc-stop-motion *::before,
  body.acc-stop-motion *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }

  body.high-contrast {
    background-color: #000000 !important;
    color: #ffff00 !important;
    border-color: #ffff00 !important;
  }
  body.high-contrast button {
    background-color: #ffff00 !important;
    color: #000000 !important;
  }
</style>

<script nonce={Astro.locals.nonce}>
  document.addEventListener('DOMContentLoaded', () => {
    // Elements
    const trigger = document.getElementById('acc-trigger');
    const panel = document.getElementById('acc-panel');
    const closeBtn = document.getElementById('acc-close');
    const resetBtn = document.getElementById('acc-reset');
    const zoomDisplay = document.getElementById('zoom-display');
    const readingGuide = document.getElementById('reading-guide-line');
    const tourTrigger = document.getElementById('trigger-tour');

    // State
    const state = {
      zoom: 100,
      font: false,
      highlight: false,
      cursor: false,
      mono: false,
      contrast: false,
      motion: false,
      guide: false
    };

    // --- Helper Functions ---
    const toggleClass = (cls, active) => {
      active ? document.body.classList.add(cls) : document.body.classList.remove(cls);
    };

    const updateBtn = (id, active) => {
      const btn = document.getElementById(id);
      if(btn) active ? btn.classList.add('active') : btn.classList.remove('active');
    };

    const setZoom = (val) => {
      // Range 80% to 150% is safer for rem scaling without breaking visuals too much
      const newZoom = Math.min(Math.max(val, 80), 160);
      state.zoom = newZoom;
      if (zoomDisplay) zoomDisplay.textContent = newZoom + '%';
      
      // Use Root Font Size scaling (standard a11y approach)
      // Default browser font size is usually 16px (100%).
      // We scale this percentage.
      document.documentElement.style.fontSize = `${newZoom}%`;
      
      // Remove old transform potential leftovers if they exist
      document.body.style.transform = '';
      document.body.style.transformOrigin = '';
      document.body.style.width = '';
    };

    // --- Event Listeners ---

    // Panel Toggle
    if (trigger) trigger.onclick = (e) => { e.stopPropagation(); panel.classList.toggle('open'); };
    if (closeBtn) closeBtn.onclick = (e) => { e.stopPropagation(); panel.classList.remove('open'); };
    document.onclick = (e) => {
      if (panel && panel.classList.contains('open') && !panel.contains(e.target) && !trigger.contains(e.target)) {
        panel.classList.remove('open');
      }
    };

    // Tour Trigger (Integrated)
    if (tourTrigger) tourTrigger.onclick = () => {
       if (window.startGetNexoTour) {
         window.startGetNexoTour();
         panel.classList.remove('open'); // Close panel when tour starts
       } else {
         console.warn('Tour function not ready yet');
       }
    };

    // Zoom
    document.getElementById('zoom-in')?.addEventListener('click', () => setZoom(state.zoom + 10));
    document.getElementById('zoom-out')?.addEventListener('click', () => setZoom(state.zoom - 10));

    // Dyslexia Font
    document.getElementById('toggle-font')?.addEventListener('click', () => {
      state.font = !state.font;
      toggleClass('acc-dyslexia', state.font);
      updateBtn('toggle-font', state.font);
    });

    // Highlight Links
    document.getElementById('toggle-highlight')?.addEventListener('click', () => {
      state.highlight = !state.highlight;
      toggleClass('acc-highlight-links', state.highlight);
      updateBtn('toggle-highlight', state.highlight);
    });

    // Big Cursor
    document.getElementById('toggle-cursor')?.addEventListener('click', () => {
      state.cursor = !state.cursor;
      toggleClass('acc-cursor', state.cursor);
      updateBtn('toggle-cursor', state.cursor);
    });

    // Monochrome
    document.getElementById('toggle-mono')?.addEventListener('click', () => {
      state.mono = !state.mono;
      toggleClass('acc-monochrome', state.mono);
      updateBtn('toggle-mono', state.mono);
    });

    // High Contrast
    document.getElementById('toggle-contrast')?.addEventListener('click', () => {
      state.contrast = !state.contrast;
      toggleClass('high-contrast', state.contrast);
      updateBtn('toggle-contrast', state.contrast);
    });

    // Stop Motion
    document.getElementById('toggle-motion')?.addEventListener('click', () => {
      state.motion = !state.motion;
      toggleClass('acc-stop-motion', state.motion);
      updateBtn('toggle-motion', state.motion);
    });

    // Reading Guide
    const toggleGuide = document.getElementById('toggle-guide');
    if (toggleGuide) {
      toggleGuide.onchange = (e) => {
        state.guide = e.target.checked;
        if (state.guide) {
          readingGuide.classList.add('active');
          document.addEventListener('mousemove', moveGuide);
        } else {
          readingGuide.classList.remove('active');
          document.removeEventListener('mousemove', moveGuide);
        }
      };
    }

    const moveGuide = (e) => {
      if (readingGuide) readingGuide.style.top = e.clientY + 'px';
    };

    // Reset All
    if (resetBtn) resetBtn.onclick = () => {
      state.zoom = 100;
      setZoom(100);

      const features = [
        { key: 'font', cls: 'acc-dyslexia', id: 'toggle-font' },
        { key: 'highlight', cls: 'acc-highlight-links', id: 'toggle-highlight' },
        { key: 'cursor', cls: 'acc-cursor', id: 'toggle-cursor' },
        { key: 'mono', cls: 'acc-monochrome', id: 'toggle-mono' },
        { key: 'contrast', cls: 'high-contrast', id: 'toggle-contrast' },
        { key: 'motion', cls: 'acc-stop-motion', id: 'toggle-motion' }
      ];

      features.forEach(f => {
        state[f.key] = false;
        document.body.classList.remove(f.cls);
        updateBtn(f.id, false);
      });

      // Reset Guide
      state.guide = false;
      if (toggleGuide) toggleGuide.checked = false;
      if (readingGuide) readingGuide.classList.remove('active');
      document.removeEventListener('mousemove', moveGuide);

      // Clean styles
      document.documentElement.style.fontSize = ''; 
      document.body.style.transform = '';
      document.body.style.width = '';
    };

  });
</script>
