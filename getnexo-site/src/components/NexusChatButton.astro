---
// Componente FAB (Floating Action Button) para abrir o chat Nexus IA
// Ícone: robô moderno
// Cor: fundo cyan-500, hover cyan-400, sombra suave
// Posição: bottom-6 right-6 (desktop), bottom-20 right-6 (mobile)
// Ao clicar: abre o modal do DemoChatComTudozinho
---

<button
  id="nexus-chat-fab"
  class="fixed bottom-6 right-6 z-50 w-16 h-16 rounded-full bg-cyan-500 flex items-center justify-center shadow-xl hover:bg-cyan-400 hover:scale-110 transition-all duration-300 group"
  aria-label="Falar com Nexus IA"
  title="Falar com Nexus IA"
>
  <!-- Ícone de robô moderno (SVG limpo) -->
  <svg 
    width="28" 
    height="28" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="white" 
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="transition-transform duration-200 group-hover:scale-110"
  >
    <!-- Corpo do robô -->
    <rect x="8" y="6" width="8" height="10" rx="2" fill="white" stroke="none"/>
    <!-- Cabeça do robô -->
    <circle cx="12" cy="4" r="3" fill="white" stroke="none"/>
    <!-- Olhos -->
    <circle cx="10" cy="4" r="0.8" fill="#0891b2"/>
    <circle cx="14" cy="4" r="0.8" fill="#0891b2"/>
    <!-- Antena -->
    <line x1="12" y1="1" x2="12" y2="3" stroke="white" stroke-width="1.5"/>
    <circle cx="12" cy="1" r="0.8" fill="#0891b2"/>
    <!-- Braços -->
    <line x1="6" y1="8" x2="4" y2="10" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="18" y1="8" x2="20" y2="10" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
    <!-- Pernas -->
    <line x1="10" y1="16" x2="9" y2="19" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="14" y1="16" x2="15" y2="19" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
</button>

<!-- Modal do DemoChatComTudozinho (inicialmente oculto) -->
<div 
  id="nexus-chat-modal" 
  class="fixed inset-0 z-[9999] hidden"
  style="background: rgba(0,0,0,0.95); backdrop-filter: blur(8px);"
>
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-gray-900 border-2 border-cyan-500 rounded-3xl p-6 w-full max-w-4xl h-[85vh] flex flex-col shadow-[0_0_50px_rgba(6,182,212,0.3)] relative">
      <!-- Cabeçalho do modal -->
      <div class="flex justify-between items-center mb-4">
        <div>
          <h3 class="text-2xl text-cyan-400 font-bold">🤖 Nexus IA - Chat Inteligente</h3>
          <p class="text-gray-400 text-sm">Assistente virtual com IA Generativa</p>
        </div>
        <button 
          onclick="fecharNexusChat()" 
          class="text-cyan-400 text-3xl hover:text-white transition-colors"
          aria-label="Fechar chat"
        >
          ×
        </button>
      </div>

      <!-- Área do chat (DemoChatComTudozinho) -->
      <div id="demo-chat-container" class="flex-1 overflow-hidden flex flex-col">
        <!-- O componente React será renderizado aqui via JavaScript -->
      </div>
    </div>
  </div>
</div>

<style>
  /* Animação de entrada do modal */
  #nexus-chat-modal:not(.hidden) {
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Responsividade */
  @media (max-width: 768px) {
    #nexus-chat-fab {
      bottom: 20px !important; /* Mais baixo para não cobrir o teclado */
      right: 20px !important;
      width: 56px !important;
      height: 56px !important;
    }

    #nexus-chat-modal .max-w-4xl {
      max-width: 100% !important;
      width: 100% !important;
      height: 90vh !important;
    }

    #nexus-chat-modal .p-6 {
      padding: 1rem !important;
    }

    #nexus-chat-modal .text-2xl {
      font-size: 1.25rem !important;
    }
  }
</style>

<script>
  // Funções para controle do chat
  function abrirNexusChat() {
    const modal = document.getElementById('nexus-chat-modal');
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Renderizar o componente DemoChatComTudozinho
    setTimeout(() => {
      const container = document.getElementById('demo-chat-container');
      if (container && !container.hasChildNodes()) {
        // Importar e renderizar o componente React
        import('./DemoChatComTudozinho.jsx').then(module => {
          const DemoChatComTudozinho = module.default;
          // Usar ReactDOM para renderizar o componente
          if (window.ReactDOM) {
            window.ReactDOM.render(
              window.React.createElement(DemoChatComTudozinho),
              container
            );
          }
        }).catch(err => {
          console.error('Erro ao carregar DemoChatComTudozinho:', err);
          container.innerHTML = `
            <div class="flex-1 overflow-y-auto p-4 space-y-3 bg-gray-800/30 rounded-t-xl">
              <div class="flex justify-start">
                <div class="bg-gray-800/80 text-gray-200 rounded-2xl px-4 py-3 max-w-md">
                  🤖 Carregando chat... (Erro: ${err.message})
                </div>
              </div>
            </div>
          `;
        });
      }
    }, 100);
  }

  function fecharNexusChat() {
    const modal = document.getElementById('nexus-chat-modal');
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    
    // Limpar o conteúdo do container
    const container = document.getElementById('demo-chat-container');
    if (container) {
      container.innerHTML = '';
    }
  }

  // Event listener para o botão FAB
  document.addEventListener('DOMContentLoaded', () => {
    const fab = document.getElementById('nexus-chat-fab');
    if (fab) {
      fab.addEventListener('click', abrirNexusChat);
    }
  });
</script>
