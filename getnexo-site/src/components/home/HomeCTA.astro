---
---

<section class="home-cta-section animate-on-scroll">
  <div class="glass-panel cta-box">
    <div class="cta-content">
      <h2 class="text-gradient">Pronto pra multiplicar suas vendas no WhatsApp?</h2>
      <p class="cta-subtext">
        <span class="pill">SEM CARTÃO DE CRÉDITO</span>
        <span class="separator">|</span>
        <span class="pill">CANCELA QUANDO QUISER</span>
        <span class="separator">|</span>
        <span class="pill">RESULTADOS REAIS</span>
      </p>
      
      <div class="cta-actions">
        <a href="/criar-bot" class="btn-primary-glow">
          Liberar Meu Bot GRÁTIS <span class="small-text">(7 Dias Sem Cartão)</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-cta-section {
    padding: 6rem 5%;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .glass-panel {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 24px;
    padding: 4rem 2rem;
    position: relative;
    overflow: hidden;
    transition: all 0.5s ease;
  }

  .glass-panel:hover {
    border-color: rgba(0, 212, 255, 0.2);
    box-shadow: 0 0 50px rgba(0, 212, 255, 0.1);
  }

  /* Efeito de brilho de fundo */
  .glass-panel::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(0, 212, 255, 0.05), transparent 60%);
    opacity: 0.5;
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    line-height: 1.1;
    color: white;
    max-width: 800px;
    margin-bottom: 0.5rem;
  }

  .cta-subtext {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .pill {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.4rem 1rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    white-space: nowrap;
    color: #e2e8f0;
  }

  .separator {
    color: #334155;
    font-weight: 300;
  }

  .btn-primary-glow {
    background: linear-gradient(135deg, #00d4ff 0%, #00ff9d 100%);
    color: #020617;
    padding: 1.4rem 3rem;
    border-radius: 16px;
    font-weight: 800;
    text-decoration: none;
    font-size: 1.25rem;
    display: inline-flex;
    align-items: center; /* Alinha o texto e o span verticalmente no centro */
    flex-direction: column; /* Coloca o small-text embaixo do texto principal */
    gap: 0.2rem;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 10px 30px rgba(0, 212, 255, 0.25);
    position: relative;
    overflow: hidden;
    line-height: 1.1;
  }

  .btn-primary-glow:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 20px 50px rgba(0, 212, 255, 0.4);
  }

  .btn-primary-glow::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: 0.5s;
  }

  .btn-primary-glow:hover::after {
    left: 100%;
  }

  .small-text {
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0.9;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .home-cta-section {
      padding: 4rem 1rem;
    }

    .glass-panel {
      padding: 3rem 1.5rem;
    }

    h2 {
      font-size: 2rem;
    }

    .cta-subtext {
      flex-direction: column;
      gap: 0.5rem;
    }

    .separator {
      display: none;
    }

    .btn-primary-glow {
      width: 100%;
      padding: 1.2rem;
      font-size: 1.1rem;
    }
  }
</style>
