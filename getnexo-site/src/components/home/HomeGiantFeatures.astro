---
// Traduções simples para evitar erros de importação
const translations = {
  features_giantranslations: {
    magic_replies: {
      title: "Magic Replies IA",
      description: "Respostas inteligentes que convertem automaticamente",
      f1: "Respostas instantâneas com IA Generativa",
      f2: "Aprende com cada conversa",
      f3: "Aumenta taxa de conversão em 300%"
    },
    loyalty: {
      title: "Programa de Fidelidade",
      description: "Retenção de clientes com gamificação inteligente",
      f1: "Sistema de pontos automático",
      f2: "Descontos progressivos",
      f3: "Clientes fiéis por vida"
    },
    analytics: {
      title: "Analytics Preditivo",
      description: "Inteligência que antecipa tendências",
      f1: "Previsão de vendas com IA",
      f2: "Análise de sentimento em tempo real",
      f3: "Otimização de campanhas"
    },
    integrations: {
      title: "Integrações Poderosas",
      description: "Conexão com seu ecossistema digital",
      f1: "Shopify, WooCommerce, Nuvemshop",
      f2: "API RESTful completa",
      f3: "Webhooks em tempo real"
    }
  }
};
---

<!-- Giant Features Showcase -->
<section class="giant-features">
  <!-- Magic Replies -->
  <div class="giant-feature-row animate-on-scroll">
      <div class="giant-feature-visual">
          <img src="/assets/features/magic-replies.webp" alt="Magic Replies AI" width="501" height="501" class="premium-visual" loading="lazy" />
      </div>
      <div class="giant-feature-info">
          <div class="feature-tag">Exclusivo</div>
          <h2 class="text-gradient">{translations.features_giantranslations.magic_replies.title}</h2>
          <p>{translations.features_giantranslations.magic_replies.description}</p>
          <ul class="feature-bullets">
              <li><span>✨</span> {translations.features_giantranslations.magic_replies.f1}</li>
              <li><span>🧠</span> {translations.features_giantranslations.magic_replies.f2}</li>
              <li><span>📈</span> {translations.features_giantranslations.magic_replies.f3}</li>
          </ul>
          <a href="/produtos/automacao" class="btn-outline-glow">Conhecer Magic Replies</a>
      </div>
  </div>

  <!-- Loyalty System -->
  <div class="giant-feature-row reverse animate-on-scroll">
      <div class="giant-feature-info">
          <div class="feature-tag gold">Retenção</div>
          <h2 class="text-gradient">{translations.features_giantranslations.loyalty.title}</h2>
          <p>{translations.features_giantranslations.loyalty.description}</p>
          <ul class="feature-bullets">
              <li><span>🏆</span> {translations.features_giantranslations.loyalty.f1}</li>
              <li><span>🎁</span> {translations.features_giantranslations.loyalty.f2}</li>
              <li><span>❤️</span> {translations.features_giantranslations.loyalty.f3}</li>
          </ul>
          <a href="/produtos/vendas" class="btn-outline-glow">Ver Fidelidade</a>
      </div>
      <div class="giant-feature-visual">
          <img src="/assets/features/loyalty.webp" alt="Loyalty System" width="501" height="501" class="premium-visual" loading="lazy" />
      </div>
  </div>

  <!-- Analytics -->
  <div class="giant-feature-row animate-on-scroll">
      <div class="giant-feature-visual">
          <img src="/assets/features/analytics.webp" alt="Advanced Analytics" width="501" height="501" class="premium-visual" loading="lazy" />
      </div>
      <div class="giant-feature-info">
          <div class="feature-tag blue">Inteligência</div>
          <h2 class="text-gradient">{translations.features_giantranslations.analytics.title}</h2>
          <p>{translations.features_giantranslations.analytics.description}</p>
          <ul class="feature-bullets">
              <li><span>📊</span> {translations.features_giantranslations.analytics.f1}</li>
              <li><span>📝</span> {translations.features_giantranslations.analytics.f2}</li>
              <li><span>🌍</span> {translations.features_giantranslations.analytics.f3}</li>
          </ul>
          <a href="/produtos/crm" class="btn-outline-glow">Explorar Dados</a>
      </div>
  </div>
  <!-- Integrations -->
  <div class="giant-feature-row reverse animate-on-scroll !mb-0 !pb-0">
      <div class="giant-feature-info">
          <div class="feature-tag green">Ecossistema</div>
          <h2 class="text-gradient">{translations.features_giantranslations.integrations.title}</h2>
          <p>{translations.features_giantranslations.integrations.description}</p>
          <ul class="feature-bullets">
              <li><span>🔗</span> {translations.features_giantranslations.integrations.f1}</li>
              <li><span>⚙️</span> {translations.features_giantranslations.integrations.f2}</li>
              <li><span>📡</span> {translations.features_giantranslations.integrations.f3}</li>
          </ul>
          <a href="/integracoes" class="btn-outline-glow">Ver Todas as Integrações</a>
      </div>
      <div class="giant-feature-visual">
          <img src="/assets/features/integrations.webp" alt="Integrations Map" width="501" height="501" class="premium-visual" loading="lazy" />
      </div>
  </div>


</section>

<style>
  .giant-features {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .giant-feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    opacity: 0;
    transform: translateY(30px);
    will-change: transform, opacity;
  }

  .giant-feature-row.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  .giant-feature-row.reverse {
    direction: rtl;
  }

  .giant-feature-row.reverse > * {
    direction: ltr;
  }

    .giant-feature-visual {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 255, 157, 0.05));
    border: 1px solid rgba(255, 255, 255, 0.1);
    height: auto !important; /* Allow height to adjust to width but maintain ratio */
    width: 100% !important;
    max-width: 500px !important;
    aspect-ratio: 1 / 1 !important; /* Force Square */
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .premium-visual {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .giant-feature-visual:hover .premium-visual {
    transform: scale(1.05);
  }

  .giant-feature-info {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ... rest of existing styles ... */
  
  @media (max-width: 1024px) {
    .giant-feature-visual {
      height: 400px; /* Adjusted for smaller screens */
    }
    .giant-feature-info {
      min-height: auto;
    }
  }

  @media (max-width: 768px) {
    .giant-feature-visual {
      height: 300px;
    }
  }

  .feature-tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(0, 212, 255, 0.1);
    border: 1px solid rgba(0, 212, 255, 0.3);
    color: #00d4ff;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 20px;
    margin-bottom: 1rem;
  }

  .feature-tag.gold {
    background: rgba(255, 215, 0, 0.1);
    border-color: rgba(255, 215, 0, 0.3);
    color: #ffd700;
  }

  .feature-tag.blue {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
    color: #3b82f6;
  }

  .feature-tag.green {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.3);
    color: #22c55e;
  }

  .giant-feature-info h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 900;
    color: white;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .giant-feature-info p {
    color: #94a3b8;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .feature-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
  }

  .feature-bullets li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: #cbd5e1;
    font-size: 1rem;
    margin-bottom: 0.8rem;
  }

  .feature-bullets li span {
    font-size: 1.2rem;
  }

  .btn-outline-glow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border: 2px solid rgba(0, 212, 255, 0.3);
    border-radius: 12px;
    color: #00d4ff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    background: transparent;
  }

  .btn-outline-glow:hover {
    border-color: #00d4ff;
    background: rgba(0, 212, 255, 0.1);
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .giant-feature-row {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }
    .giant-feature-info {
      padding: 1rem;
      align-items: center;
    }
    .feature-bullets {
      display: inline-block;
      text-align: left;
    }
    .giant-feature-visual {
      height: auto;
      max-width: 400px;
    }
  }

  @media (max-width: 768px) {
    .giant-features {
      gap: 4rem;
      padding: 4rem 1.2rem;
    }
    .giant-feature-info h2 { font-size: 1.8rem; }
  }

  @media (max-width: 480px) {
    .giant-features { gap: 3rem; }
    .giant-feature-info h2 { font-size: 1.5rem; }
    .giant-feature-info p { font-size: 1rem; }
    .btn-outline-glow { width: 100%; justify-content: center; }
  }
</style>
