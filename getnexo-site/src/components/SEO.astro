---
// Componente SEO Global Otimizado para Google e Bing
// Suporta Internacionalização (i18n) completa
export interface Props {
  title: string;
  description: string;
  keywords: string;
  image?: string;
  url?: string;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
  faq?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  structuredData?: any;
  lang?: string;
  nonce?: string;
}

const {
  title,
  description,
  keywords,
  image = "https://getnexo.com.br/assets/og-poster.jpg",
  url,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  section,
  tags,
  faq,
  breadcrumbs,
  structuredData,
  lang = Astro.url.pathname.split('/')[1] || 'pt',
  nonce
} = Astro.props;

// Load translations for SEO
let t;
try {
  const translations = await import(`../i18n/${lang}.json`);
  t = translations.default;
} catch (e) {
  const translations = await import(`../i18n/pt.json`);
  t = translations.default;
}

const canonicalUrl = url || `https://getnexo.com.br${Astro.url.pathname}`;
const currentPath = Astro.url.pathname.replace(/^\/(pt|es|fr|en)/, '');
const siteName = t.seo.site_name || "GetNexo";
const twitterHandle = "@getnexo";
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={author || "GetNexo"} />

<!-- Verification Tags -->
<meta name="google-site-verification" content="getnexo-verification-2026" />
<meta name="msvalidate.01" content="getnexo-ms-2026" />

<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={t.seo.og_locale || "pt_BR"} />
<meta property="og:locale:alternate" content="en_US" />
<meta property="og:locale:alternate" content="es_ES" />
<meta property="og:locale:alternate" content="fr_FR" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
<meta property="twitter:image:alt" content={title} />
<meta property="twitter:creator" content={twitterHandle} />
<meta property="twitter:site" content={twitterHandle} />

<!-- i18n Alternate Links (Hreflang) -->
<link rel="alternate" hreflang="pt" href={`https://getnexo.com.br/pt${currentPath}`} />
<link rel="alternate" hreflang="en" href={`https://getnexo.com.br/en${currentPath}`} />
<link rel="alternate" hreflang="es" href={`https://getnexo.com.br/es${currentPath}`} />
<link rel="alternate" hreflang="fr" href={`https://getnexo.com.br/fr${currentPath}`} />
<link rel="alternate" hreflang="x-default" href={`https://getnexo.com.br/pt${currentPath}`} />

<!-- Article Meta Tags (if applicable) -->
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{section && <meta property="article:section" content={section} />}
{author && <meta property="article:author" content={author} />}
{tags && tags.map(tag => <meta property="article:tag" content={tag} />)}

<!-- Business/Local Business Schema - Carregado com defer -->
<script defer type="application/ld+json" nonce={nonce} set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://getnexo.com.br/#organization",
      "name": "GetNexo",
      "url": "https://getnexo.com.br",
      "logo": "https://getnexo.com.br/logo.svg",
      "description": t.seo.organization_description,
      "foundingDate": "2024",
      "founder": {
        "@type": "Person",
        "name": "GetNexo Team"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+55-11-99999-9999",
        "contactType": "customer service",
        "availableLanguage": ["Portuguese", "English", "Spanish", "French"],
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      },
      "sameAs": [
        "https://linkedin.com/company/getnexo",
        "https://instagram.com/getnexo",
        "https://github.com/lelebrr",
        "https://youtube.com/@getnexo",
        "https://tiktok.com/@getnexo",
        "https://facebook.com/getnexo"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "BR",
        "addressRegion": "SP",
        "addressLocality": "São Paulo"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://getnexo.com.br/#website",
      "url": "https://getnexo.com.br",
      "name": siteName,
      "description": t.seo.default_description,
      "publisher": { "@id": "https://getnexo.com.br/#organization" },
      "inLanguage": lang,
      "copyrightHolder": { "@id": "https://getnexo.com.br/#organization" },
      "potentialAction": [
        {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://getnexo.com.br/buscar?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://getnexo.com.br/#software",
      "name": "GetNexo",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, WhatsApp",
      "softwareVersion": "2.0.0",
      "author": { "@id": "https://getnexo.com.br/#organization" },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "500"
      }
    },
    {
      "@type": "WebPage",
      "@id": canonicalUrl + "#webpage",
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://getnexo.com.br/#website" },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": image,
        "width": 1200,
        "height": 630
      },
      "datePublished": publishedTime || "2024-01-01T00:00:00+00:00",
      "dateModified": modifiedTime || "2024-12-31T23:59:59+00:00",
      "author": { "@id": "https://getnexo.com.br/#organization" },
      "publisher": { "@id": "https://getnexo.com.br/#organization" },
      "inLanguage": lang,
      "mainEntityOfPage": canonicalUrl,
      "breadcrumb": breadcrumbs ? {
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((crumb, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": crumb.name,
          "item": `https://getnexo.com.br${crumb.url}`
        }))
      } : undefined
    },
    ...(faq ? [{
      "@type": "FAQPage",
      "mainEntity": faq.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }] : []),
    ...(structuredData ? [structuredData] : [])
  ].filter(Boolean)
})}></script>

<!-- Additional SEO Meta Tags -->
<meta name="theme-color" content="#00d4ff" />

<!-- Preconnect to external domains -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://www.googletagmanager.com" />

<!-- Security Headers (Moved to HTTP headers where possible) -->
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta http-equiv="X-XSS-Protection" content="1; mode=block" />
<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
<meta name="format-detection" content="telephone=no" />

<!-- Mobile Optimization -->
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="GetNexo" />

<!-- Favicons -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="GetNexo Blog" href="/blog/rss.xml" />

<!-- Additional Link Tags -->
<link rel="search" href="/buscar" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<!-- DNS Prefetch -->
<link rel="dns-prefetch" href="//api.getnexo.com.br" />
<link rel="dns-prefetch" href="//cdn.getnexo.com.br" />
<link rel="dns-prefetch" href="//chat.getnexo.com.br" />

<!-- Article Schema (if article) -->
{type === "article" && (
  <script defer type="application/ld+json" nonce={nonce} set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": image,
    "author": {
      "@type": "Organization",
      "name": author || "GetNexo",
      "url": "https://getnexo.com.br"
    },
    "publisher": { "@id": "https://getnexo.com.br/#organization" },
    "datePublished": publishedTime,
    "dateModified": modifiedTime,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalUrl
    }
  })}></script>
)}