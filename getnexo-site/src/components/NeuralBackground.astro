---
// Neural Background Component - Advanced Animated Background
const { nonce } = Astro.props;
---

<div id="neural-background" class="neural-background">
  <!-- Primary Neural Network Layer -->
  <canvas id="neural-canvas-primary" class="neural-canvas"></canvas>

  <!-- Secondary Floating Elements -->
  <div class="floating-elements">
    <div class="neural-node node-1"></div>
    <div class="neural-node node-2"></div>
    <div class="neural-node node-3"></div>
    <div class="neural-node node-4"></div>
    <div class="neural-node node-5"></div>
    <div class="neural-node node-6"></div>
    <div class="neural-connection connection-1"></div>
    <div class="neural-connection connection-2"></div>
    <div class="neural-connection connection-3"></div>
  </div>

  <!-- Particle System Overlay -->
  <div class="particle-system">
    <div class="particle particle-1"></div>
    <div class="particle particle-2"></div>
    <div class="particle particle-3"></div>
    <div class="particle particle-4"></div>
    <div class="particle particle-5"></div>
    <div class="particle particle-6"></div>
    <div class="particle particle-7"></div>
    <div class="particle particle-8"></div>
  </div>

  <!-- Gradient Overlays -->
  <div class="gradient-overlay gradient-primary"></div>
  <div class="gradient-overlay gradient-secondary"></div>
  <div class="gradient-overlay gradient-tertiary"></div>
</div>

<style>
  .neural-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -99;
    background: linear-gradient(135deg, #030712 0%, #0f172a 50%, #1e293b 100%);
    overflow: hidden;
  }

  .neural-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.6;
  }

  /* Neural Nodes - Floating Brain-like Elements */
  .floating-elements {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .neural-node {
    position: absolute;
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.15) 0%, rgba(0, 255, 157, 0.08) 50%, transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
    animation: neuralFloat 20s infinite ease-in-out;
  }

  .neural-node.node-1 {
    top: 10%;
    left: 10%;
    animation-delay: 0s;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.2) 0%, rgba(0, 255, 157, 0.1) 40%, transparent 70%);
  }

  .neural-node.node-2 {
    top: 60%;
    right: 15%;
    animation-delay: -5s;
    background: radial-gradient(circle, rgba(0, 255, 157, 0.18) 0%, rgba(0, 212, 255, 0.09) 45%, transparent 70%);
  }

  .neural-node.node-3 {
    bottom: 20%;
    left: 20%;
    animation-delay: -10s;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.12) 0%, rgba(0, 212, 255, 0.08) 50%, transparent 70%);
  }

  .neural-node.node-4 {
    top: 30%;
    right: 25%;
    animation-delay: -15s;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.15) 0%, rgba(255, 107, 53, 0.07) 55%, transparent 70%);
  }

  .neural-node.node-5 {
    bottom: 40%;
    left: 60%;
    animation-delay: -8s;
    background: radial-gradient(circle, rgba(0, 255, 157, 0.16) 0%, rgba(0, 212, 255, 0.08) 45%, transparent 70%);
  }

  .neural-node.node-6 {
    top: 80%;
    right: 60%;
    animation-delay: -12s;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.14) 0%, rgba(0, 255, 157, 0.07) 50%, transparent 70%);
  }

  @keyframes neuralFloat {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg) scale(1);
      opacity: 0.6;
    }
    25% {
      transform: translate(30px, -20px) rotate(90deg) scale(1.1);
      opacity: 0.8;
    }
    50% {
      transform: translate(-20px, 30px) rotate(180deg) scale(0.9);
      opacity: 0.7;
    }
    75% {
      transform: translate(40px, 20px) rotate(270deg) scale(1.05);
      opacity: 0.9;
    }
  }

  /* Neural Connections - Animated Lines */
  .neural-connection {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.4), transparent);
    border-radius: 1px;
    animation: neuralPulse 8s infinite ease-in-out;
  }

  .neural-connection.connection-1 {
    top: 25%;
    left: 15%;
    width: 200px;
    transform: rotate(45deg);
    animation-delay: 0s;
  }

  .neural-connection.connection-2 {
    top: 45%;
    right: 20%;
    width: 150px;
    transform: rotate(-30deg);
    animation-delay: -3s;
  }

  .neural-connection.connection-3 {
    bottom: 35%;
    left: 35%;
    width: 180px;
    transform: rotate(60deg);
    animation-delay: -6s;
  }

  @keyframes neuralPulse {
    0%, 100% {
      opacity: 0.2;
      transform: scaleX(0.8);
    }
    50% {
      opacity: 0.8;
      transform: scaleX(1.2);
    }
  }

  /* Particle System */
  .particle-system {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: rgba(0, 212, 255, 0.8);
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.6);
    animation: particleFloat 15s infinite linear;
  }

  .particle.particle-1 { top: 20%; left: 10%; animation-delay: 0s; }
  .particle.particle-2 { top: 40%; right: 15%; animation-delay: -2s; background: rgba(0, 255, 157, 0.8); }
  .particle.particle-3 { top: 60%; left: 70%; animation-delay: -4s; }
  .particle.particle-4 { bottom: 30%; right: 40%; animation-delay: -6s; background: rgba(255, 107, 53, 0.8); }
  .particle.particle-5 { top: 10%; right: 70%; animation-delay: -8s; }
  .particle.particle-6 { bottom: 50%; left: 20%; animation-delay: -10s; background: rgba(0, 255, 157, 0.8); }
  .particle.particle-7 { top: 70%; right: 10%; animation-delay: -12s; }
  .particle.particle-8 { bottom: 20%; left: 80%; animation-delay: -14s; background: rgba(255, 107, 53, 0.8); }

  @keyframes particleFloat {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      transform: translate(100px, -50px) rotate(360deg);
      opacity: 0;
    }
  }

  /* Gradient Overlays */
  .gradient-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .gradient-primary {
    background: radial-gradient(circle at 20% 50%, rgba(0, 212, 255, 0.03) 0%, transparent 50%);
    animation: gradientShift 25s infinite ease-in-out;
  }

  .gradient-secondary {
    background: radial-gradient(circle at 80% 20%, rgba(0, 255, 157, 0.03) 0%, transparent 50%);
    animation: gradientShift 30s infinite ease-in-out reverse;
  }

  .gradient-tertiary {
    background: radial-gradient(circle at 60% 80%, rgba(255, 107, 53, 0.02) 0%, transparent 50%);
    animation: gradientShift 35s infinite ease-in-out;
  }

  @keyframes gradientShift {
    0%, 100% {
      transform: scale(1) rotate(0deg);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.2) rotate(180deg);
      opacity: 0.9;
    }
  }

  /* Performance Optimizations */
  @media (prefers-reduced-motion: reduce) {
    .neural-node,
    .neural-connection,
    .particle,
    .gradient-overlay {
      animation: none;
    }
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .neural-node {
      width: 80px;
      height: 80px;
      filter: blur(30px);
    }

    .neural-connection {
      width: 120px;
      height: 1px;
    }

    .particle {
      width: 3px;
      height: 3px;
    }
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .neural-background {
      background: linear-gradient(135deg, #000000 0%, #0f172a 50%, #1e293b 100%);
    }
  }
</style>

<script nonce={nonce}>
  (function() {
    if (window.NeuralBackground) return;

    class NeuralBackground {
      constructor() {
        this.canvas = document.getElementById('neural-canvas-primary');
        if (!this.canvas) return;

        this.ctx = this.canvas.getContext('2d');
        this.nodes = [];
        this.connections = [];
        this.animationId = null;
        this.mouse = { x: 0, y: 0 };
        
        // Cache dimensions to avoid layout thrashing
        this.width = 0;
        this.height = 0;

        const initOnIdle = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(() => {
              this.resize();
              // Break up node creation to avoid long tasks
              this.createNodesBatched(() => {
                this.createConnectionsBatched(() => {
                  this.animate();
                  this.bindEvents();
                });
              });
            }, { timeout: 2000 });
          } else {
            setTimeout(() => {
              this.resize();
              this.createNodes();
              this.createConnections();
              this.animate();
              this.bindEvents();
            }, 500);
          }
        };

        if (document.readyState === 'complete') {
          initOnIdle();
        } else {
          window.addEventListener('load', initOnIdle);
        }
      }

      resize() {
        const dpr = window.devicePixelRatio || 1;
        const rect = this.canvas.getBoundingClientRect();
        this.width = rect.width;
        this.height = rect.height;
        
        this.canvas.width = this.width * dpr;
        this.canvas.height = this.height * dpr;
        this.ctx.scale(dpr, dpr);
        
        // Reset nodes on major resize
        if (this.nodes.length > 0) {
          this.createNodes();
          this.createConnections();
        }
      }

      createNodes() {
        this.nodes = [];
        const isMobile = window.innerWidth < 768;
        const nodeCount = isMobile ? 40 : 100;

        for (let i = 0; i < nodeCount; i++) {
          this.nodes.push({
            x: Math.random() * this.width,
            y: Math.random() * this.height,
            vx: (Math.random() - 0.5) * 0.5,
            vy: (Math.random() - 0.5) * 0.5,
            radius: Math.random() * 2 + 1
          });
        }
      }

      createNodesBatched(callback) {
        const isMobile = window.innerWidth < 768;
        const totalNodes = isMobile ? 40 : 100;
        let created = 0;
        const batchSize = 20;

        const createBatch = () => {
          const end = Math.min(created + batchSize, totalNodes);
          for (let i = created; i < end; i++) {
            this.nodes.push({
              x: Math.random() * this.width,
              y: Math.random() * this.height,
              vx: (Math.random() - 0.5) * 0.5,
              vy: (Math.random() - 0.5) * 0.5,
              radius: Math.random() * 2 + 1
            });
          }
          created = end;
          if (created < totalNodes) {
            if (window.requestIdleCallback) {
              window.requestIdleCallback(createBatch);
            } else {
              setTimeout(createBatch, 10);
            }
          } else if (callback) {
            callback();
          }
        };
        createBatch();
      }

      createConnections() {
        this.connections = [];
        for (let i = 0; i < this.nodes.length; i++) {
          for (let j = i + 1; j < this.nodes.length; j++) {
            const dx = this.nodes[i].x - this.nodes[j].x;
            const dy = this.nodes[i].y - this.nodes[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);

            if (dist < 150) {
              this.connections.push({ i, j, dist });
            }
          }
        }
      }

      createConnectionsBatched(callback) {
        this.connections = [];
        let i = 0;
        const maxDist = 150;

        const processBatch = () => {
          const startTime = performance.now();
          while (i < this.nodes.length && performance.now() - startTime < 16) {
            for (let j = i + 1; j < this.nodes.length; j++) {
              const dx = this.nodes[i].x - this.nodes[j].x;
              const dy = this.nodes[i].y - this.nodes[j].y;
              const distSq = dx * dx + dy * dy;

              if (distSq < maxDist * maxDist) {
                this.connections.push({ i, j, dist: Math.sqrt(distSq) });
              }
            }
            i++;
          }

          if (i < this.nodes.length) {
            if (window.requestIdleCallback) {
              window.requestIdleCallback(processBatch);
            } else {
              setTimeout(processBatch, 10);
            }
          } else if (callback) {
            callback();
          }
        };
        processBatch();
      }

      animate() {
        if (!this.ctx) return;
        this.ctx.clearRect(0, 0, this.width, this.height);

        this.nodes.forEach(node => {
          node.x += node.vx;
          node.y += node.vy;

          if (node.x < 0 || node.x > this.width) node.vx *= -1;
          if (node.y < 0 || node.y > this.height) node.vy *= -1;

          this.ctx.beginPath();
          this.ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
          this.ctx.fillStyle = 'rgba(0, 212, 255, 0.2)';
          this.ctx.fill();
        });

        this.connections.forEach(conn => {
          const node1 = this.nodes[conn.i];
          const node2 = this.nodes[conn.j];
          const dx = node1.x - node2.x;
          const dy = node1.y - node2.y;
          const distSq = dx * dx + dy * dy;

          if (distSq < 150 * 150) {
            const dist = Math.sqrt(distSq);
            this.ctx.beginPath();
            this.ctx.moveTo(node1.x, node1.y);
            this.ctx.lineTo(node2.x, node2.y);
            this.ctx.strokeStyle = `rgba(0, 212, 255, ${0.1 * (1 - dist / 150)})`;
            this.ctx.stroke();
          }
        });

        this.animationId = requestAnimationFrame(() => this.animate());
      }

      bindEvents() {
        let resizeTicking = false;
        window.addEventListener('resize', () => {
          if (!resizeTicking) {
            window.requestAnimationFrame(() => {
              this.resize();
              resizeTicking = false;
            });
            resizeTicking = true;
          }
        }, { passive: true });

        window.addEventListener('mousemove', (e) => {
          this.mouse.x = e.clientX;
          this.mouse.y = e.clientY;
        }, { passive: true });
        
        window.addEventListener('beforeunload', () => {
          if (this.animationId) cancelAnimationFrame(this.animationId);
        });
      }
    }

    try {
      window.NeuralBackgroundInstance = new NeuralBackground();
      window.NeuralBackground = true;
    } catch (e) {
      console.warn('NeuralBackground init failed:', e);
    }
  })();
</script>