ts-box{border-bottom:1px solid rgba(255,255,255,.05);padding-bottom:1.5rem;margin-bottom:2rem}.res-val{display:block;font-size:2.5rem;font-weight:900;color:#fff;line-height:1;margin-bottom:.3rem}.res-lbl{color:#64748b;font-weight:800;font-size:.75rem;text-transform:uppercase;letter-spacing:1px}.quote-box{position:relative}.quote-icon{width:1.5rem;height:1.5rem;opacity:.3;margin-bottom:.8rem}.quote-box p{color:#cbd5e1;font-style:italic;font-size:1rem;line-height:1.6;margin:0}.slider-dots{display:flex;justify-content:center;gap:.6rem;margin-top:3rem}.dot{width:6px;height:6px;border-radius:50%;background:#ffffff1a;border:none;cursor:pointer;transition:.3s}.dot.active{width:24px;border-radius:6px;background:#22d3ee}
  
