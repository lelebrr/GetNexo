---

<section class="testimonials-root">
  <div class="glow-bg top-left"></div>
  <div class="glow-bg bottom-right"></div>

  <div class="content-wrapper">
    {showTitle && layout === 'section' && (
      <div class="section-header">
        <span class="badge">Prova Social</span>
        <h2>Quem usa, <span class="gradient-text">vende mais</span>.</h2>
        <p>Junte-se a centenas de lojistas que automatizaram suas vendas e escalaram seus resultados com o GetNexo.</p>
      </div>
    )}

    <div class="carousel-outer" id="carousel-outer">
      <!-- Arrows (Inside outer but outside slider) -->
      <button class="arrow-btn prev" id="carousel-prev" aria-label="Anterior">
        <svg viewBox="0 0 24 24" width="32" height="32" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="slider-viewport" id="slider-viewport">
        <div class="slider-track" id="slider-track">
          {testimonials.map((t) => (
            <div class="testimonial-card">
              <div class="card-header">
                <div class="avatar-wrapper">
                  <img src={t.photo} alt={t.name} class="avatar-img" loading="lazy" />
                  <div class="verified-indicator">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="white"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                  </div>
                </div>
                <div class="user-info">
                  <h4 class="user-name">{t.name}</h4>
                  <span class="user-handle">{t.handle}</span>
                  <span class="verified-label">⭐ Verificado</span>
                </div>
              </div>

              <div class="results-box">
                 <div class="res-val">{t.results}</div>
                 <div class="res-lbl">{t.resultLabel}</div>
              </div>

              <div class="quote-box">
                 <svg class="quote-icon" fill="#22d3ee" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.896 14.896 16.017 16.017 16.017H19.017V11H14.017V6H20.017V16.017C20.017 18.756 17.756 21 15.017 21H14.017ZM4.017 21V18C4.017 16.896 4.896 16.017 6.017 16.017H9.017V11H4.017V6H10.017V16.017C10.017 18.756 7.756 21 5.017 21H4.017Z"/></svg>
                 <p>{t.quote}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button class="arrow-btn next" id="carousel-next" aria-label="Próximo">
        <svg viewBox="0 0 24 24" width="32" height="32" stroke="white" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="slider-dots" id="slider-dots">
      {testimonials.map((_, i) => (
        <button class={`dot ${i === 0 ? 'active' : ''}`} data-index={i}></button>
      ))}
    </div>

    {layout === 'section' && (
      <div class="cta-bottom">
        <a href="/depoimentos" class="ghost-btn">
          Ver todas as histórias
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
      </div>
    )}
  </div>
</section>

<script is:inline>
  (function() {
    const initSlider = () => {
      const track = document.getElementById('slider-track');
      const prevBtn = document.getElementById('carousel-prev');
      const nextBtn = document.getElementById('carousel-next');
      const dots = document.querySelectorAll('#slider-dots .dot');
      
      if (!track || !prevBtn || !nextBtn) return;

      let currentIndex = 0;
      const totalItems = track.children.length;
      let timer = null;

      const getItemsVisible = () => {
        if (window.innerWidth < 768) return 1;
        if (window.innerWidth < 1100) return 2;
        return 3;
      };

      const updatePos = () => {
        const visible = getItemsVisible();
        const maxScroll = totalItems - visible;
        
        if (currentIndex < 0) currentIndex = maxScroll;
        if (currentIndex > maxScroll) currentIndex = 0;

        const card = track.children[0];
        const width = card.offsetWidth;
        const gap = 32;
        const offset = currentIndex * (width + gap);

        track.style.transform = `translateX(-${offset}px)`;

        // Dots
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === currentIndex);
        });
      };

      const moveNext = () => {
        currentIndex++;
        updatePos();
      };

      const movePrev = () => {
        currentIndex--;
        updatePos();
      };

      const startAuto = () => {
        stopAuto();
        timer = setInterval(moveNext, 5000);
      };

      const stopAuto = () => {
        if (timer) clearInterval(timer);
      };

      nextBtn.onclick = () => { moveNext(); startAuto(); };
      prevBtn.onclick = () => { movePrev(); startAuto(); };

      dots.forEach((dot, i) => {
        dot.onclick = () => {
          currentIndex = i;
          updatePos();
          startAuto();
        };
      });

      track.onmouseenter = stopAuto;
      track.onmouseleave = startAuto;

      window.onresize = updatePos;
      
      startAuto();
      updatePos();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlider);
    } else {
      initSlider();
    }
  })();
</script>

<style>
  .section-header {
    text-align: center;
    margin-bottom: 5rem;
  }
  .badge {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.2);
    color: #22d3ee;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 100px;
    margin-bottom: 1.5rem;
  }
  .section-header h2 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: white;
    margin-bottom: 1.5rem;
    line-height: 1;
    letter-spacing: -2px;
  }
  .gradient-text {
    background: linear-gradient(135deg, #22d3ee, #0ea5e9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .section-header p {
    color: #94a3b8;
    font-size: 1.25rem;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .testimonials-root {
    position: relative;
    padding: 8rem 0;
    background: #020617;
    overflow: hidden;
  }

  .content-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    position: relative;
    z-index: 10;
  }

  .glow-bg {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(150px);
    opacity: 0.05;
    pointer-events: none;
  }
  .top-left { top: -100px; left: -100px; background: cyan; }
  .bottom-right { bottom: -100px; right: -100px; background: lime; }

  .section-header { text-align: center; margin-bottom: 4rem; }
  .badge { display: inline-block; padding: 6px 16px; background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2); color: #22d3ee; font-size: 0.75rem; font-weight: 800; border-radius: 100px; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
  .section-header h2 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; color: white; margin-bottom: 1rem; line-height: 1; letter-spacing: -2px; }
  .gradient-text { background: linear-gradient(90deg, #22d3ee, #10b981); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .section-header p { color: #94a3b8; font-size: 1.2rem; max-width: 700px; margin: 0 auto; }

  .carousel-outer {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .slider-viewport {
    flex: 1;
    overflow: hidden;
    padding: 2rem 0.5rem;
  }

  .slider-track {
    display: flex;
    gap: 2rem;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .testimonial-card {
    flex: 0 0 100%;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 2.5rem;
    padding: 3rem;
    backdrop-filter: blur(10px);
    transition: 0.4s;
  }

  @media (min-width: 768px) { .testimonial-card { flex: 0 0 calc(50% - 1rem); } }
  @media (min-width: 1100px) { .testimonial-card { flex: 0 0 calc(33.333% - 1.35rem); } }

  .testimonial-card:hover {
    transform: translateY(-8px);
    border-color: rgba(34, 211, 238, 0.2);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Arrows with Drawing (SVG) - Larger and more prominent */
  .arrow-btn {
    width: 72px;
    height: 72px;
    background: rgba(15, 23, 42, 0.9);
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 50;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .arrow-btn svg {
    width: 40px;
    height: 40px;
    stroke-width: 3; /* Thicker arrows */
    transition: transform 0.3s ease;
  }

  .arrow-btn:hover {
    background: #22d3ee;
    border-color: #22d3ee;
    box-shadow: 0 0 30px rgba(34, 211, 238, 0.6);
    transform: translateY(-50%) scale(1.1); /* Keep centering while scaling */
  }
  
  .arrow-btn.prev:hover svg { transform: translateX(-3px); }
  .arrow-btn.next:hover svg { transform: translateX(3px); }
  
  .arrow-btn:hover svg { stroke: black; }

  .nav-arrow.prev { left: -36px; }
  .nav-arrow.next { right: -36px; }

  @media (max-width: 1024px) {
    .arrow-btn { width: 60px; height: 60px; }
    .arrow-btn svg { width: 32px; height: 32px; }
  }

  @media (max-width: 600px) {
    .arrow-btn { width: 50px; height: 50px; }
    .arrow-btn svg { width: 28px; height: 28px; }
    .arrow-btn.prev { left: -15px; }
    .arrow-btn.next { right: -15px; }
  }

  /* Content */
  .card-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .avatar-wrapper { position: relative; width: 64px; height: 64px; flex-shrink: 0; }
  .avatar-img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid rgba(34,211,238,0.2); }
  .verified-indicator { position: absolute; bottom: 0; right: 0; background: #fbbf24; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; border: 2.5px solid #020617; }

  .user-name { color: white; margin: 0; font-weight: 800; font-size: 1.1rem; line-height: 1.2; }
  .user-handle { color: #22d3ee; display: block; font-size: 0.85rem; font-weight: 600; opacity: 0.8; }
  .verified-label { display: block; color: #475569; font-size: 0.65rem; font-weight: 800; text-transform: uppercase; margin-top: 2px; }

  .results-box { border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 1.5rem; margin-bottom: 2rem; }
  .res-val { display: block; font-size: 2.5rem; font-weight: 900; color: white; line-height: 1; margin-bottom: 0.3rem; }
  .res-lbl { color: #64748b; font-weight: 800; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; }

  .quote-box { position: relative; }
  .quote-icon { width: 1.5rem; height: 1.5rem; opacity: 0.3; margin-bottom: 0.8rem; }
  .quote-box p { color: #cbd5e1; font-style: italic; font-size: 1rem; line-height: 1.6; margin: 0; }

  /* Dots */
  .slider-dots { display: flex; justify-content: center; gap: 0.6rem; margin-top: 3rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.1); border: none; cursor: pointer; transition: 0.3s; }
  .dot.active { width: 30px; border-radius: 6px; background: #22d3ee; }
</style>