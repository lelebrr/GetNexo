---
export interface Props {
  videoUrl?: string;
  posterUrl?: string;
  title?: string;
  autoplay?: boolean;
  controls?: boolean;
  loop?: boolean;
  muted?: boolean;
}

const {
  videoUrl = "/videos/demo-getnexo.mp4",
  posterUrl = "/assets/video-poster.jpg",
  title = "Demonstração GetNexo - IA Vendas WhatsApp",
  autoplay = false,
  controls = true,
  loop = false,
  muted = true
} = Astro.props;
---

<div class="video-demo-container">
  <div class="video-wrapper">
    <video
      class="video-player"
      poster={posterUrl}
      autoplay={autoplay}
      controls={controls}
      loop={loop}
      muted={muted}
      playsinline
      preload="metadata"
    >
      <source src={videoUrl} type="video/mp4" />
      <source src={videoUrl.replace('.mp4', '.webm')} type="video/webm" />
      Seu navegador não suporta vídeo HTML5.
    </video>

    <!-- Custom Play Button Overlay -->
    <div class="video-overlay" id="video-overlay">
      <div class="play-button" id="play-button-overlay">
        <div class="play-icon">▶</div>
        <div class="play-text">Ver Demo IA</div>
      </div>
      <div class="video-info">
        <h3>Veja como funciona em 1 minuto</h3>
        <p>Setup completo + vendas automáticas</p>
      </div>
    </div>

    <!-- Loading Spinner -->
    <div class="video-loading" id="video-loading">
      <div class="spinner"></div>
      <p>Carregando vídeo...</p>
    </div>

    <!-- Video Controls (if custom controls enabled) -->
    {!controls && (
      <div class="custom-controls" id="custom-controls">
        <button class="control-btn play-pause" id="play-pause-btn">
          <span class="play-icon">▶</span>
          <span class="pause-icon" style="display: none;">⏸</span>
        </button>
        <div class="progress-bar">
          <div class="progress-fill" id="progress-fill"></div>
        </div>
        <button class="control-btn volume" id="volume-btn">
          <span class="volume-on">🔊</span>
          <span class="volume-off" style="display: none;">🔇</span>
        </button>
        <button class="control-btn fullscreen" id="fullscreen-btn">
          <span>⛶</span>
        </button>
      </div>
    )}
  </div>

  <div class="video-meta">
    <h4>{title}</h4>
    <div class="video-stats">
      <span>📹 1:23 min</span>
      <span>👁️ 2.3k visualizações</span>
      <span>👍 98% aprovaram</span>
    </div>
  </div>
</div>

<style>
  .video-demo-container {
    max-width: 800px;
    margin: 0 auto;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    position: relative;
  }

  .video-wrapper {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    background: #000;
    border-radius: 20px;
    overflow: hidden;
  }

  .video-player {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    border-radius: 20px;
    transition: all 0.3s ease;
  }

  .video-player:hover {
    transform: scale(1.02);
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.7), rgba(0, 212, 255, 0.1));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 10;
    transition: all 0.4s ease;
    border-radius: 20px;
  }

  .play-button {
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 2rem;
  }

  .play-button:hover {
    transform: scale(1.1);
  }

  .play-icon {
    font-size: 4rem;
    color: #00d4ff;
    margin-bottom: 1rem;
    text-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  .play-text {
    color: white;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .video-info {
    text-align: center;
    color: white;
  }

  .video-info h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #00d4ff, #00ff9d);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .video-info p {
    font-size: 1rem;
    opacity: 0.9;
  }

  .video-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: white;
    z-index: 5;
  }

  .spinner {
    width: 50px;
    height: 50px;
    border: 4px solid rgba(255, 255, 255, 0.3);
    border-top: 4px solid #00d4ff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 1rem;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .custom-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 15;
  }

  .video-wrapper:hover .custom-controls {
    opacity: 1;
  }

  .control-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    border-radius: 8px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1.2rem;
  }

  .control-btn:hover {
    background: rgba(0, 212, 255, 0.2);
    border-color: #00d4ff;
    transform: scale(1.1);
  }

  .progress-bar {
    flex: 1;
    height: 6px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
    cursor: pointer;
    position: relative;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #00d4ff, #00ff9d);
    border-radius: 3px;
    width: 0%;
    transition: width 0.1s ease;
  }

  .video-meta {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .video-meta h4 {
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .video-stats {
    display: flex;
    gap: 1rem;
    color: #e2e8f0;
    font-size: 0.8rem;
    opacity: 0.8;
  }

  /* Video playing state */
  .video-playing .video-overlay {
    opacity: 0;
    pointer-events: none;
  }

  .video-playing .custom-controls {
    opacity: 1;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .video-demo-container {
      margin: 0 1rem;
      border-radius: 16px;
    }

    .video-wrapper {
      border-radius: 16px;
    }

    .video-player {
      border-radius: 16px;
    }

    .video-overlay {
      border-radius: 16px;
    }

    .play-icon {
      font-size: 3rem;
    }

    .play-text {
      font-size: 1rem;
    }

    .video-info h3 {
      font-size: 1.2rem;
    }

    .video-meta {
      padding: 1rem;
    }

    .video-stats {
      flex-direction: column;
      gap: 0.5rem;
    }

    .custom-controls {
      padding: 0.75rem;
      gap: 0.75rem;
    }

    .control-btn {
      width: 35px;
      height: 35px;
      font-size: 1rem;
    }
  }

  /* Loading state styles */
  .video-loading {
    display: none;
  }

  .video-loading.active {
    display: block;
  }

  /* Fullscreen styles */
  .video-fullscreen {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 9999;
    border-radius: 0 !important;
  }

  .video-fullscreen .video-player {
    border-radius: 0 !important;
  }

  .video-fullscreen .video-overlay {
    border-radius: 0 !important;
  }
</style>

<script nonce={Astro.locals.nonce}>
  let videoElement;
  let overlayElement;
  let loadingElement;
  let controlsElement;
  let progressFill;
  let playPauseBtn;
  let volumeBtn;

  function initializeVideo() {
    videoElement = document.querySelector('.video-player');
    overlayElement = document.getElementById('video-overlay');
    loadingElement = document.getElementById('video-loading');
    controlsElement = document.getElementById('custom-controls');
    progressFill = document.getElementById('progress-fill');
    playPauseBtn = document.querySelector('.play-pause');
    volumeBtn = document.querySelector('.volume');

    if (!videoElement) return;

    // Video event listeners
    videoElement.addEventListener('loadstart', showLoading);
    videoElement.addEventListener('canplay', hideLoading);
    videoElement.addEventListener('play', onPlay);
    videoElement.addEventListener('pause', onPause);
    videoElement.addEventListener('timeupdate', updateProgress);
    videoElement.addEventListener('ended', onEnded);

    // Progress bar click
    if (progressFill && progressFill.parentElement) {
      progressFill.parentElement.addEventListener('click', seekVideo);
    }

    // Event Listeners for buttons (replacing inline onclick)
    const playOverlay = document.getElementById('play-button-overlay');
    if (playOverlay) playOverlay.addEventListener('click', playVideo);

    if (playPauseBtn) playPauseBtn.addEventListener('click', togglePlayPause);
    if (volumeBtn) volumeBtn.addEventListener('click', toggleMute);
    const fullscreenBtn = document.getElementById('fullscreen-btn');
    if (fullscreenBtn) fullscreenBtn.addEventListener('click', toggleFullscreen);
  }

  function playVideo() {
    if (videoElement) {
      videoElement.play();
    }
  }

  function togglePlayPause() {
    if (!videoElement) return;

    if (videoElement.paused) {
      videoElement.play();
    } else {
      videoElement.pause();
    }
  }

  function toggleMute() {
    if (!videoElement) return;

    videoElement.muted = !videoElement.muted;
    updateVolumeButton();
  }

  function toggleFullscreen() {
    const wrapper = document.querySelector('.video-wrapper');
    if (!wrapper) return;

    if (document.fullscreenElement) {
      document.exitFullscreen();
      wrapper.classList.remove('video-fullscreen');
    } else {
      wrapper.requestFullscreen();
      wrapper.classList.add('video-fullscreen');
    }
  }

  function updateProgress() {
    if (!videoElement || !progressFill) return;

    const progress = (videoElement.currentTime / videoElement.duration) * 100;
    progressFill.style.width = progress + '%';
  }

  function seekVideo(e) {
    if (!videoElement) return;

    const rect = e.currentTarget.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const percentage = clickX / rect.width;
    const newTime = percentage * videoElement.duration;

    videoElement.currentTime = newTime;
  }

  function onPlay() {
    const wrapper = videoElement.closest('.video-wrapper');
    wrapper.classList.add('video-playing');
    updatePlayPauseButton(false);
  }

  function onPause() {
    updatePlayPauseButton(true);
  }

  function onEnded() {
    const wrapper = videoElement.closest('.video-wrapper');
    wrapper.classList.remove('video-playing');
    updatePlayPauseButton(true);
  }

  function updatePlayPauseButton(isPaused) {
    if (!playPauseBtn) return;

    const playIcon = playPauseBtn.querySelector('.play-icon');
    const pauseIcon = playPauseBtn.querySelector('.pause-icon');

    if (playIcon && pauseIcon) {
      if (isPaused) {
        playIcon.style.display = 'block';
        pauseIcon.style.display = 'none';
      } else {
        playIcon.style.display = 'none';
        pauseIcon.style.display = 'block';
      }
    }
  }

  function updateVolumeButton() {
    if (!volumeBtn) return;

    const volumeOn = volumeBtn.querySelector('.volume-on');
    const volumeOff = volumeBtn.querySelector('.volume-off');

    if (videoElement.muted) {
      volumeOn.style.display = 'none';
      volumeOff.style.display = 'block';
    } else {
      volumeOn.style.display = 'block';
      volumeOff.style.display = 'none';
    }
  }

  function showLoading() {
    if (loadingElement) {
      loadingElement.classList.add('active');
    }
  }

  function hideLoading() {
    if (loadingElement) {
      loadingElement.classList.remove('active');
    }
  }

  // Fullscreen change handler
  document.addEventListener('fullscreenchange', function() {
    const wrapper = document.querySelector('.video-wrapper');
    if (!document.fullscreenElement && wrapper) {
      wrapper.classList.remove('video-fullscreen');
    }
  });

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', initializeVideo);

  // Make functions globally available
  window.playVideo = playVideo;
  window.togglePlayPause = togglePlayPause;
  window.toggleMute = toggleMute;
  window.toggleFullscreen = toggleFullscreen;
</script>