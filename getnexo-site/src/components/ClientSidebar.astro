---
// ClientSidebar.astro - Menu premium completo para dashboard do cliente
// Focado em conversão e upsell de módulos

const { modules = [], plano = 'Básico' } = Astro.props;
const moduleSet = new Set(modules);

// Itens padrão (sempre visíveis)
const defaultItems = [
  { name: 'Dashboard', icon: 'home', link: '/client/dashboard' },
  { name: 'Minhas Vendas', icon: 'shopping-cart', link: '/client/sales' },
  { name: 'Funil de Vendas', icon: 'funnel-chart', link: '/client/funnel' },
  { name: 'Contatos / CRM', icon: 'users', link: '/client/contacts' },
  { name: 'Produtos / Catálogo', icon: 'package', link: '/client/products' },
  { name: 'Configurações', icon: 'settings', link: '/client/settings' },
  { name: 'Suporte 24h', icon: 'life-buoy', link: '/client/support' },
  { name: 'Sair', icon: 'log-out', link: '/api/logout' },
];

// Seção Estatísticas com submenus
const statsSection = {
  name: 'Estatísticas',
  icon: 'line-chart',
  link: '/client/stats',
  subItems: [
    { name: 'Visão Geral', icon: 'eye', link: '/client/stats/overview' },
    { name: 'Gráfico de Vendas', icon: 'bar-chart', link: '/client/stats/sales-chart' },
    { name: 'ROI Avançado', icon: 'trending-up', link: '/client/stats/roi', premium: true, price: 'R$ 99/mês' },
    { name: 'Taxa de Conversão', icon: 'percent', link: '/client/stats/conversion' },
  ]
};

// Novos itens principais
const newItems = [
  { name: 'Relatórios', icon: 'file-text', link: '/client/reports', premium: true, price: 'R$ 79/mês', badge: 'Novo' },
  { name: 'Ranking Revendas', icon: 'trophy', link: '/client/ranking', premium: true, price: 'R$ 49/mês' },
  { name: 'Notificações', icon: 'bell', link: '/client/notifications', badge: '3' },
];

// Seções Premium (condicionais)
const premiumSections = [
  {
    name: 'White Label',
    icon: 'paintbrush',
    link: '/client/white-label',
    module: 'white-label',
    description: 'Personaliza logo, cores e nome da marca',
    price: 'R$ 97/mês'
  },
  {
    name: 'IA Avançada',
    icon: 'bot',
    link: '/client/ai',
    module: 'ia-avancada',
    description: 'Prompts customizados e respostas inteligentes',
    price: 'R$ 147/mês'
  },
  {
    name: 'Produtos 3D',
    icon: 'cube',
    link: '/client/3d-products',
    module: 'produtos-3d',
    description: 'Modelos 3D no WhatsApp',
    price: 'R$ 77/mês'
  },
  {
    name: 'Relatórios ROI',
    icon: 'bar-chart-3',
    link: '/client/analytics',
    module: 'relatorios-roi',
    description: 'Gráficos ROI, Meta Ads + PIX',
    price: 'R$ 127/mês'
  },
  {
    name: 'Programa Fidelidade',
    icon: 'heart-handshake',
    link: '/client/loyalty',
    module: 'fidelidade',
    description: 'Pontos, cupons e cashback',
    price: 'R$ 87/mês'
  },
  {
    name: 'Integrações Meta',
    icon: 'facebook',
    link: '/client/meta',
    module: 'meta-integration',
    description: 'Configurações completas Facebook/Instagram',
    price: 'R$ 197/mês'
  },
  {
    name: 'PIX Automático',
    icon: 'coins',
    link: '/client/pix',
    module: 'pix-automatico',
    description: 'Dispara comprovante instantâneo',
    price: 'R$ 67/mês'
  },
  {
    name: 'Automação Avançada',
    icon: 'zap',
    link: '/client/automations',
    module: 'automacao-avancada',
    description: 'n8n custom, workflows',
    price: 'R$ 177/mês'
  },
];

// Ícones SVG (Lucide icons)
const icons = {
  home: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  'shopping-cart': `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H6.12"/></svg>`,
