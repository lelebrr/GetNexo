  bot: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4"/><path d="M12 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"/><path d="M12 12V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6"/><path d="M12 12v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-4"/><circle cx="8" cy="16" r="1"/><circle cx="16" cy="16" r="1"/></svg>`,
  cube: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 16-8-4-8 4m16 0-8 4-8-4"/><path d="M12 2v20"/><path d="M2 12l10-5 10 5-10 5z"/></svg>`,
  'bar-chart-3': `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>`,
