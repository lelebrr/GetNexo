// Verifica se módulo está contratado
const isModuleActive = (module) => moduleSet.has(module);
---

<div 
  x-data="{ sidebarOpen: window.innerWidth >= 1024, statsOpen: false, toggleSidebar() { this.sidebarOpen = !this.sidebarOpen; }, toggleStats() { this.statsOpen = !this.statsOpen; } }"
  class="sidebar-wrapper"
>
  <!-- Mobile Menu Button -->
  <button 
    @click="sidebarOpen = !sidebarOpen"
    class="mobile-menu-btn lg:hidden"
    aria-label="Toggle menu"
  >
    <Fragment set:html={icons.menu} />
  </button>

  <!-- Overlay for mobile -->
  <div 
    x-show="sidebarOpen" 
    x-cloak
    @click="sidebarOpen = false"
    x-transition.opacity
    class="sidebar-overlay lg:hidden"
  ></div>

  <!-- Sidebar -->
  <aside 
    x-show="sidebarOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="-translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-300"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="-translate-x-full"
    class="sidebar-aside"
  >
    <!-- Topo -->
    <div class="p-6 border-b border-cyan-900/30">
      <!-- Logo -->
      <a 
        href="/client/dashboard" 
        class="flex items-center gap-3 text-xl font-bold text-white hover:text-cyan-400 transition-colors mb-4"
      >
        <span class="text-cyan-400">
          <Fragment set:html={icons.rocket} />
        </span>
        JetNexus
      </a>

      <!-- Bem-vindo e Plano -->
      <div class="space-y-2">
        <p class="text-sm text-gray-400">Bem-vindo, <span class="text-white font-medium">Cliente</span></p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-cyan-900/30 rounded-full text-xs font-medium text-cyan-400 border border-cyan-800/50">
          <span>Plano {plano}</span>
        </div>
      </div>

      <!-- Botão Upgrade -->
      <a
        href="/client/upgrade"
        class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-medium rounded-lg hover:from-green-600 hover:to-emerald-700 transition-all duration-300 shadow-lg shadow-green-900/20"
        aria-label="Upgrade para plano premium - R$ 99/mês"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        Upgrade Plano
      </a>
    </div>

    <!-- Menu Principal -->
    <nav class="p-4 space-y-1">
      <!-- Seção Estatísticas (com submenu expansível) -->
      <div>
        <button
          @click="toggleStats()"
          class="flex items-center w-full py-3 px-4 rounded-lg text-gray-300 hover:bg-cyan-900/20 hover:text-white transition-all duration-300 group"
          aria-label="Expandir submenu de Estatísticas"
        >
          <span class="text-cyan-400 group-hover:text-cyan-300 transition-colors mr-3">
            <Fragment set:html={icons['line-chart']} />
          </span>
          <span class="font-medium flex-1">Estatísticas</span>
          <span class="text-cyan-400 group-hover:text-cyan-300 transition-colors">
            <Fragment set:html={icons['chevron-down']} />
          </span>
        </button>
        
        <div
          x-show="statsOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="pl-12 space-y-1 mt-1"
        >
          {statsSection.subItems.map(subItem => {
            const isPremium = subItem.premium;
            return (
              <a
                href={subItem.link}
                class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-cyan-900/20 hover:text-white transition-all duration-300 group"
              >
                <span class="text-gray-500 group-hover:text-cyan-300 transition-colors">
                  <Fragment set:html={icons[subItem.icon]} />
                </span>
                <span class="flex-1">{subItem.name}</span>
                {isPremium && (
                  <span class="text-xs text-cyan-400 bg-cyan-900/20 px-2 py-0.5 rounded-full">
                    {subItem.price}
                  </span>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Itens Padrão -->
      {defaultItems.map(item => (
        <a
          href={item.link}
          class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-cyan-900/20 hover:text-white transition-all duration-300 group"
        >
          <span class="text-cyan-400 group-hover:text-cyan-300 transition-colors">
            <Fragment set:html={icons[item.icon]} />
          </span>
          <span class="font-medium flex-1">{item.name}</span>
          {item.link === '/api/logout' && (
            <span class="text-xs text-gray-500 group-hover:text-gray-400">Sair</span>
          )}
        </a>
      ))}

      <!-- Novos Itens Principais -->
      {newItems.map(item => {
        const isPremium = item.premium;
        return (
          <a
            href={item.link}
            class="flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:bg-cyan-900/20 hover:text-white transition-all duration-300 group"
          >
            <span class="text-cyan-400 group-hover:text-cyan-300 transition-colors">
              <Fragment set:html={icons[item.icon]} />
            </span>
            <span class="font-medium flex-1">{item.name}</span>
            {item.badge && (
              <span class="text-xs text-cyan-400 bg-cyan-900/20 px-2 py-0.5 rounded-full">
                {item.badge}
              </span>
            )}
            {isPremium && (
              <span class="text-xs text-cyan-400 bg-cyan-900/20 px-2 py-0.5 rounded-full">
                {item.price}
              </span>
            )}
          </a>
        );
      })}

      <!-- Seção Premium -->
      <div class="mt-6 pt-4 border-t border-cyan-900/30">
        <p class="px-4 text-xs text-cyan-400 uppercase tracking-wider mb-3 font-semibold">
          ✨ Premium Features
        </p>
        
        {premiumSections.map(item => {
          const isActive = isModuleActive(item.module);
          return (
            <div class="mb-1">
              {isActive ? (
                <a
                  href={item.link}
                  class="flex items-center gap-3 px-4 py-3 rounded-lg bg-cyan-900/20 text-white hover:bg-cyan-800/30 transition-all duration-300 group"
                >
                  <span class="text-cyan-400 group-hover:text-cyan-300 transition-colors">
                    {icons[item.icon]}
                  </span>
                  <span class="font-medium flex-1">{item.name}</span>
                  <span class="flex items-center gap-1 text-xs text-green-400 bg-green-900/30 px-2 py-0.5 rounded-full">
                    <Fragment set:html={icons['check-circle']} />
                    Desbloqueado
                  </span>
                </a>
              ) : (
                <button
                  @click="toggleSidebar()"
                  class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-500 hover:bg-gray-800/50 hover:text-gray-300 transition-all duration-300 group"
                  aria-label={`Adquirir ${item.name} - ${item.price}`}
                >
                  <span class="text-gray-600 group-hover:text-gray-400 transition-colors">
                    <Fragment set:html={icons.lock} />
                  </span>
                  <span class="font-medium flex-1 text-left">{item.name}</span>
                  <span class="flex items-center gap-1 text-xs text-cyan-400 bg-cyan-900/20 px-2 py-0.5 rounded-full">
                    {item.price}
                    <Fragment set:html={icons['chevron-right']} />
                  </span>
                </button>
              )}
            </div>
          );
        })}
      </div>
    </nav>

    <!-- Footer com contagem de módulos -->
    <div class="p-4 mt-auto border-t border-cyan-900/30">
      <div class="flex items-center justify-between text-xs">
        <span class="text-gray-400">Módulos ativos</span>
        <span class="text-cyan-400 font-semibold">{modules.length} / {premiumSections.length}</span>
      </div>
      <div class="mt-2 h-1.5 bg-gray-800 rounded-full overflow-hidden">
        <div 
          class="h-full bg-gradient-to-r from-cyan-500 to-emerald-500 transition-all duration-500"
          style={`width: ${(modules.length / premiumSections.length) * 100}%`}
        ></div>
      </div>
    </div>
  </aside>
</div>

