---
export interface Props {
  productId?: string;
  glbUrl?: string;
  usdzUrl?: string;
  title?: string;
  fallbackImage?: string;
  showARButton?: boolean;
  showVRButton?: boolean;
}

const {
  productId = 'demo',
  glbUrl,
  usdzUrl,
  title = 'Ver em Realidade Aumentada',
  fallbackImage = '/assets/logo.svg',
  showARButton = true,
  showVRButton = true
} = Astro.props;

// Generate URLs if not provided
const finalGlbUrl = glbUrl || `/modelos/${productId}.glb`;
const finalUsdzUrl = usdzUrl || `/modelos/${productId}.usdz`;
---

<div class="ar-model-container">
  <model-viewer
    id="model-viewer-${productId}"
    src={finalGlbUrl}
    ios-src={finalUsdzUrl}
    alt="Produto em Realidade Aumentada - {productId}"
    camera-orbit="-45deg 55deg 2m"
    auto-rotate
    auto-rotate-delay="0"
    rotation-per-second="30deg"
    shadow-intensity="1"
    exposure="1"
    environment-image="neutral"
    skybox-image="neutral"
    ar
    ar-modes="webxr scene-viewer quick-look"
    ar-scale="auto"
    xr-environment
    camera-controls
    interaction-prompt="none"
    loading="eager"
    style="width: 100%; height: 400px; border-radius: 12px;"
  >
    <!-- Poster (fallback image) -->
    <div slot="poster" class="ar-poster">
      <img src={fallbackImage} alt="Carregando modelo 3D" class="ar-poster-image" />
      <div class="ar-loading">
        <div class="ar-spinner"></div>
        <p>Carregando modelo 3D...</p>
      </div>
    </div>

    <!-- Progress bar -->
    <div slot="progress-bar" class="ar-progress">
      <div class="ar-progress-bar"></div>
    </div>

    <!-- AR Button -->
    {showARButton && (
      <button slot="ar-button" class="ar-button-custom">
        <span class="ar-icon">📱</span>
        {title}
      </button>
    )}

    <!-- Hotspots can be added here for interactive features -->
    <!-- <button slot="hotspot-1" data-position="0 0 0" data-normal="0 0 1"></button> -->

    <!-- Error fallback -->
    <div slot="error" class="ar-error">
      <img src={fallbackImage} alt="Erro ao carregar modelo" class="ar-error-image" />
      <p>Erro ao carregar o modelo 3D</p>
      <p>Verifique sua conexão e tente novamente</p>
    </div>
  </model-viewer>

  <!-- Custom Controls -->
  <div class="ar-custom-controls">
    <button id="reset-view-${productId}" class="ar-control-btn">
      <span class="ar-icon">🔄</span>
      Reset Vista
    </button>
    {showVRButton && (
      <button id="enter-vr-${productId}" class="ar-control-btn">
        <span class="ar-icon">🥽</span>
        VR (WebXR)
      </button>
    )}
  </div>
</div>

<style>
  .ar-model-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  model-viewer {
    width: 100% !important;
    height: 400px !important;
    border-radius: 12px;
    background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
  }

  .ar-poster {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    color: white;
    text-align: center;
    padding: 20px;
    border-radius: 12px;
  }

  .ar-poster-image {
    width: 120px;
    height: 120px;
    margin-bottom: 20px;
    filter: drop-shadow(0 0 20px rgba(0, 212, 255, 0.5));
    border-radius: 8px;
  }

  .ar-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .ar-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(0, 212, 255, 0.3);
    border-top: 4px solid #00d4ff;
    border-radius: 50%;
    animation: ar-spin 1s linear infinite;
  }

  @keyframes ar-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .ar-loading p {
    margin: 0;
    font-size: 14px;
    opacity: 0.8;
  }

  .ar-progress {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
  }

  .ar-progress-bar {
    height: 100%;
    background: #00d4ff;
    width: 0%;
    transition: width 0.3s ease;
  }

  .ar-button-custom {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border: 2px solid #00d4ff;
    border-radius: 25px;
    background: rgba(0, 212, 255, 0.9);
    color: black;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s;
    font-size: 14px;
    z-index: 10;
  }

  .ar-button-custom:hover {
    background: #00d4ff;
    transform: translateY(-2px);
  }

  .ar-error {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    color: white;
    text-align: center;
    padding: 20px;
    border-radius: 12px;
  }

  .ar-error-image {
    width: 80px;
    height: 80px;
    margin-bottom: 20px;
    opacity: 0.5;
    border-radius: 8px;
  }

  .ar-error p {
    margin: 5px 0;
    font-size: 14px;
    opacity: 0.8;
  }

  .ar-custom-controls {
    display: flex;
    gap: 10px;
    padding: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ar-control-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid rgba(0, 212, 255, 0.3);
    border-radius: 20px;
    background: rgba(0, 212, 255, 0.1);
    color: white;
    font-weight: 500;
    cursor: pointer;
    transition: 0.3s;
    font-size: 13px;
  }

  .ar-control-btn:hover {
    background: rgba(0, 212, 255, 0.2);
    transform: translateY(-1px);
  }

  .ar-icon {
    font-size: 14px;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    model-viewer {
      height: 300px !important;
    }

    .ar-custom-controls {
      flex-direction: column;
      align-items: center;
    }

    .ar-control-btn {
      width: 180px;
      justify-content: center;
    }

    .ar-button-custom {
      bottom: 10px;
      right: 10px;
      padding: 10px 16px;
      font-size: 12px;
    }
  }

  /* Progress bar animation */
  model-viewer[loading] .ar-progress-bar {
    animation: progress-pulse 1.5s ease-in-out infinite;
  }

  @keyframes progress-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>

<script define:vars={{ productId, showVRButton }}>
  // @ts-ignore
  declare const ModelViewer: any;

  declare global {
    interface Window {
      [key: string]: any;
    }
  }

  class ARModelViewer {
    productId: string;
    modelViewer: any;
    showVRButton: boolean;

    constructor(productId: string, showVRButton: boolean) {
      this.productId = productId;
      this.showVRButton = showVRButton;
      this.modelViewer = document.getElementById(`model-viewer-${productId}`);

      this.init();
    }

    init() {
      if (!this.modelViewer) return;

      // Wait for model-viewer to be ready
      this.modelViewer.addEventListener('load', () => {
        console.log(`Model loaded for product ${this.productId}`);
        this.setupCustomControls();
        this.updateProgressBar(100);
      });

      this.modelViewer.addEventListener('progress', (event: any) => {
        const progress = (event.detail.totalProgress * 100) | 0;
        this.updateProgressBar(progress);
      });

      this.modelViewer.addEventListener('error', (event: any) => {
        console.error('Model viewer error:', event);
      });

      // Setup custom controls
      this.setupCustomControls();
    }

    setupCustomControls() {
      const resetBtn = document.getElementById(`reset-view-${this.productId}`);
      const vrBtn = document.getElementById(`enter-vr-${this.productId}`);

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          this.resetView();
        });
      }

      if (vrBtn && this.showVRButton) {
        vrBtn.addEventListener('click', () => {
          this.enterVR();
        });
      }
    }

    resetView() {
      if (this.modelViewer) {
        // Reset camera to default position
        this.modelViewer.cameraOrbit = '-45deg 55deg 2m';
        this.modelViewer.fieldOfView = '30deg';
      }
    }

    enterVR() {
      if (this.modelViewer && this.modelViewer.canActivateAR) {
        // Try WebXR VR mode
        this.modelViewer.activateAR();
      } else {
        alert('VR não suportado neste dispositivo ou navegador. Use um headset compatível com WebXR.');
      }
    }

    updateProgressBar(progress: number) {
      const progressBar = this.modelViewer?.querySelector('.ar-progress-bar') as HTMLElement;
      if (progressBar) {
        progressBar.style.width = `${progress}%`;
      }
    }
  }

  // Load model-viewer script if not already loaded
  document.addEventListener('DOMContentLoaded', () => {
    if (!customElements.get('model-viewer')) {
      const script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js';
      script.onload = () => initializeARViewer();
      document.head.appendChild(script);
    } else {
      initializeARViewer();
    }
  });

  function initializeARViewer() {
    // Small delay to ensure DOM is fully ready
    setTimeout(() => {
      window[`arModelViewer_${productId}`] = new ARModelViewer(productId, showVRButton);
    }, 100);
  }
</script>