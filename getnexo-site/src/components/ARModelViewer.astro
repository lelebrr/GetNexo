---
export interface Props {
  productId?: string;
  glbUrl?: string;
  usdzUrl?: string;
  title?: string;
}

const {
  productId = 'demo',
  glbUrl,
  usdzUrl,
  title = 'Ver em AR'
} = Astro.props;

// Generate URLs if not provided
const finalGlbUrl = glbUrl || `/modelos/${productId}.glb`;
const finalUsdzUrl = usdzUrl || `/modelos/${productId}.usdz`;
---

<!-- Botão no chat: -->
<button
  onclick="verAR('${productId}')"
  class="px-3 py-1 bg-green-500 text-white rounded text-sm">
  Ver em AR / Realidade Aumentada
</button>

<script define:vars={{ productId }}>
  // Load model-viewer script if not loaded
  if (!window.customElements || !window.customElements.get('model-viewer')) {
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js';
    script.type = 'module';
    document.head.appendChild(script);
  }

  // Variáveis globais para controle de trial e permissões
  window.trialMode = true; // Em trial por padrão
  window.nexoChave = ['ar', '360']; // Chaves disponíveis no trial

  window.mostrarUpgrade = function(mensagem) {
    alert(mensagem + '\n\nEntre em contato conosco para ativar este recurso.');
  };

  window.verAR = function(produtoId) {
    // Verifica se tá no trial ou ativado
    if (window.trialMode === false && !window.nexoChave.includes('ar')) {
      window.mostrarUpgrade('Ative AR por R$ 97');
      return;
    }

    // Abre direto no navegador
    const glb = `/modelos/${produtoId}.glb`;
    const usdz = `/modelos/${produtoId}.usdz`;  // pro iPhone

    // Mobile: vai pro AR viewer do Google
    if (window.customElements && window.customElements.get('model-viewer')) {
      // Create modal
      const modal = document.createElement('div');
      modal.style.cssText = `
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(0,0,0,0.8); z-index: 9999; display: flex;
        align-items: center; justify-content: center;
      `;

      modal.innerHTML = `
        <div style="position: relative; width: 90vw; height: 90vh; background: white; border-radius: 10px;">
          <button onclick="this.parentElement.parentElement.remove()" style="position: absolute; top: 10px; right: 10px; background: #333; color: white; border: none; border-radius: 50%; width: 40px; height: 40px; cursor: pointer; z-index: 10000;">×</button>
          <model-viewer
            src="${glb}"
            ios-src="${usdz}"
            ar
            ar-modes="webxr scene-viewer quick-look"
            camera-orbit="-45deg 55deg 2m"
            auto-rotate
            shadow-intensity="1"
            style="width: 100%; height: 100%; border-radius: 10px;"
          ></model-viewer>
        </div>
      `;

      document.body.appendChild(modal);

      // iPhone: se suportar USDZ
      if (navigator.userAgent.includes('iPhone')) {
        const link = document.createElement('a');
        link.href = usdz;
        link.rel = 'ar';
        link.onclick = () => modal.remove();
        link.style.display = 'none';
        document.body.appendChild(link);
        link.click();
      }
    } else {
      // Fallback: abre na web
      window.open(`/ar/${produtoId}`, '_blank');
    }
  }
</script>

<!-- Em /ar/ .astro: -->
<model-viewer
  src={finalGlbUrl}
  ar
  ios-src={finalUsdzUrl}
  camera-orbit="-45deg 55deg 2m"
  auto-rotate
  shadow-intensity="1"
  style="width:100vw; height:100vh;"
></model-viewer>

<style>
  /* Estilos simples para o botão AR */
  button {
    background: linear-gradient(135deg, #10b981, #059669);
    border: none;
    border-radius: 8px;
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
  }
</style>