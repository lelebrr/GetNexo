---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Black Friday 2026: Guía de Batalla de Automatización",
      "description": "Guía de Batalla Black Friday 2026: Automatización | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Guía de Batalla Black Friday 2026: Automatización | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Black Friday 2026:<br/><span class="text-primary">Guía de Batalla de Automatización</span></h1>
    <p>Prepare su operación para la mayor guerra de ventas del año.</p>
    <a href="/es/crear-bot" class="btn-primary">Preparar Black Friday</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
