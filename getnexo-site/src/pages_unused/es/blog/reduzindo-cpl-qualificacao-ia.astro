---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Reducción de CPL: Secretos de la Calificación IA",
      "description": "Reducción de CPL con Calificación IA | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Reducción de CPL con Calificación IA | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Reducción de CPL:<br/><span class="text-primary">Secretos de la Calificación IA</span></h1>
    <p>Cómo calificar leads automáticamente y reducir sus costos de adquisición.</p>
    <a href="/es/crear-bot" class="btn-primary">Optimizar Ahora</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
