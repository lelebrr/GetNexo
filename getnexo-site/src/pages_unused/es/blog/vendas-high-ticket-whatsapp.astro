---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Ventas High-Ticket: El Guía de Lujo para WhatsApp",
      "description": "Ventas High-Ticket en WhatsApp: Guía de Lujo | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Ventas High-Ticket en WhatsApp: Guía de Lujo | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Ventas High-Ticket:<br/><span class="text-primary">El Guía de Lujo para WhatsApp</span></h1>
    <p>Cómo cerrar grandes negocios y ventas consultivas a través del chat.</p>
    <a href="/es/crear-bot" class="btn-primary">Escalar High-Ticket</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
