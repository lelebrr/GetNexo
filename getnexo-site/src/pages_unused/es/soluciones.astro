---
import Layout from '../../layouts/Layout.astro';
const title = "Soluciones GetNexo - Automatización Completa para WhatsApp";
const description = "Soluciones completas de automatización para WhatsApp: chatbots, soporte 24/7, CRM integrado, analytics avanzado y mucho más.";
const keywords = "soluciones whatsapp, automatización whatsapp, chatbot whatsapp, soporte 24h, crm whatsapp";
---

<Layout title={title} description={description} keywords={keywords}>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-badge">🚀 Soluciones Completas</div>
      <h1>Soluciones que Transforman tu Negocio</h1>
      <p>Automatización completa para WhatsApp con IA avanzada. Aumenta ventas, mejora soporte y automatiza procesos con nuestra plataforma completa.</p>
      <div class="hero-features">
        <span>✅ IA Avanzada</span>
        <span>✅ Integración Total</span>
        <span>✅ Escalable</span>
      </div>
      <div class="hero-ctas">
        <a href="/es/crear-bot" class="btn-primary">Empezar Ahora</a>
        <a href="#demo" class="btn-secondary">Ver Demostración</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="solutions-dashboard">
        <div class="dashboard-header">📊 Dashboard de Soluciones</div>
        <div class="solutions-list">
          <div class="solution-item">
            <div class="solution-icon">🤖</div>
            <div class="solution-info">
              <span class="solution-title">Chatbots Inteligentes</span>
              <span class="solution-desc">IA que vende 24/7</span>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon">📊</div>
            <div class="solution-info">
              <span class="solution-title">Analytics Avanzado</span>
              <span class="solution-desc">Insights en tiempo real</span>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon">🎯</div>
            <div class="solution-info">
              <span class="solution-title">CRM Integrado</span>
              <span class="solution-desc">Gestión completa</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions Grid -->
  <section class="solutions-section">
    <div class="section-header">
      <h2>Nuestras Soluciones</h2>
      <p>Encuentra la solución perfecta para tu negocio</p>
    </div>

    <div class="solutions-grid">
      <div class="solution-card">
        <div class="solution-icon">🤖</div>
        <h3>Chatbots Inteligentes</h3>
        <p>IA avanzada que entiende contexto, sentimiento e intención del cliente. Respuestas personalizadas que convierten.</p>
        <ul class="solution-features">
          <li>✅ GPT-4 Turbo</li>
          <li>✅ Contexto de conversación</li>
          <li>✅ Personalización avanzada</li>
        </ul>
        <a href="/es/analytics" class="solution-cta">Saber Más</a>
      </div>

      <div class="solution-card">
        <div class="solution-icon">🎫</div>
        <h3>Sistema de Tickets</h3>
        <p>Gestión completa de soporte con categorización automática, reglas de automatización y multi-agente simultáneo.</p>
        <ul class="solution-features">
          <li>✅ Categorización automática</li>
          <li>✅ Reglas de automatización</li>
          <li>✅ Multi-agente</li>
        </ul>
        <a href="/es/tickets" class="solution-cta">Saber Más</a>
      </div>

      <div class="solution-card">
        <div class="solution-icon">📊</div>
        <h3>Analytics & BI</h3>
        <p>Dashboard completo con métricas en tiempo real, ROI de campañas, performance de canales e insights accionables.</p>
        <ul class="solution-features">
          <li>✅ ROI en tiempo real</li>
          <li>✅ Informes avanzados</li>
          <li>✅ Métricas geográficas</li>
        </ul>
        <a href="/es/analytics" class="solution-cta">Saber Más</a>
      </div>

      <div class="solution-card">
        <div class="solution-icon">🎯</div>
        <h3>CRM Integrado</h3>
        <p>Gestión completa de clientes con historial, segmentación, automatización de seguimientos e integración total.</p>
        <ul class="solution-features">
          <li>✅ Historial completo</li>
          <li>✅ Segmentación avanzada</li>
          <li>✅ Automatización de seguimientos</li>
        </ul>
        <a href="/es/crm" class="solution-cta">Saber Más</a>
      </div>

      <div class="solution-card">
        <div class="solution-icon">🎁</div>
        <h3>Fidelización & Gamificación</h3>
        <p>Sistema nativo de puntos, recompensas y gamificación para transformar clientes esporádicos en fans apasionados.</p>
        <ul class="solution-features">
          <li>✅ Puntuación automática</li>
          <li>✅ Canje en el chat</li>
          <li>✅ Retención de clientes</li>
        </ul>
        <a href="/es/fidelizacion" class="solution-cta">Saber Más</a>
      </div>

      <div class="solution-card">
        <div class="solution-icon">🔗</div>
        <h3>Integraciones</h3>
        <p>Ecosistema de 100+ integraciones con Google Sheets, Calendar, Slack, Webhooks y mucho más.</p>
        <ul class="solution-features">
          <li>✅ Sincronización en tiempo real</li>
          <li>✅ Automatización vía n8n</li>
          <li>✅ API oficial y robusta</li>
        </ul>
        <a href="/es/integraciones" class="solution-cta">Saber Más</a>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="use-cases">
    <div class="section-header">
      <h2>Casos de Uso</h2>
      <p>Cómo se benefician diferentes sectores</p>
    </div>

    <div class="cases-grid">
      <div class="case-card">
        <div class="case-icon">🛍️</div>
        <h3>E-commerce</h3>
        <p>Automatiza ventas, soporte post-venta, recuperación de carrito y upsell con IA.</p>
        <div class="case-metrics">
          <span>📈 +40% conversión</span>
          <span>⏱️ -75% tiempo</span>
        </div>
      </div>

      <div class="case-card">
        <div class="case-icon">🏢</div>
        <h3>B2B</h3>
        <p>Calificación de leads, agendamiento de reuniones, seguimientos automáticos y CRM integrado.</p>
        <div class="case-metrics">
          <span>📈 +60% leads</span>
          <span>⏱️ -50% tiempo</span>
        </div>
      </div>

      <div class="case-card">
        <div class="case-icon">🏥</div>
        <h3>Servicios</h3>
        <p>Agendamiento automático, confirmaciones, recordatorios y seguimientos post-servicio.</p>
        <div class="case-metrics">
          <span>📈 +35% retención</span>
          <span>⏱️ -80% no-show</span>
        </div>
      </div>

      <div class="case-card">
        <div class="case-icon">🎓</div>
        <h3>Educación</h3>
        <p>Soporte a alumnos, agendamiento de clases, recordatorios de tareas y comunicación con responsables.</p>
        <div class="case-metrics">
          <span>📈 +45% engagement</span>
          <span>⏱️ -60% trabajo</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="benefits-section">
    <div class="section-header">
      <h2>Beneficios de la Plataforma</h2>
      <p>Por qué elegir GetNexo</p>
    </div>

    <div class="benefits-grid">
      <div class="benefit-card">
        <div class="benefit-icon">⚡</div>
        <h3>Implementación Rápida</h3>
        <p>Configuración en minutos, no semanas. Interfaz intuitiva y soporte dedicado.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">🔒</div>
        <h3>Seguridad Total</h3>
        <p>Self-hosted, RGPD compliant, cifrado de extremo a extremo y auditorías regulares.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">💰</div>
        <h3>ROI Comprobado</h3>
        <p>Retorno medio de 3x en 90 días. Métricas claras y dashboard de ROI.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">📈</div>
        <h3>Escalabilidad</h3>
        <p>De startup a enterprise. Crecer sin preocupaciones de infraestructura.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">🌍</div>
        <h3>Multilíngüe</h3>
        <p>Portugués, Inglés, Español y Francés. Soporte global para tu negocio.</p>
      </div>

      <div class="benefit-card">
        <div class="benefit-icon">🔧</div>
        <h3>Customización</h3>
        <p>White-label completo, API robusta e integraciones personalizadas.</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section">
    <div class="section-header">
      <h2>Planes de Soluciones</h2>
      <p>Elige el plan ideal para tu negocio</p>
    </div>

    <div class="pricing-cards">
      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Starter</h3>
          <div class="price">$47<span>/mes</span></div>
          <p>Para pequeñas empresas</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Chatbot básico</li>
          <li>✅ Analytics simple</li>
          <li>✅ Hasta 2 agentes</li>
          <li>✅ Soporte por chat</li>
        </ul>
        <a href="/es/crear-bot" class="pricing-cta">Comenzar Starter</a>
      </div>

      <div class="pricing-card featured">
        <div class="pricing-badge">Más Popular</div>
        <div class="pricing-header">
          <h3>Professional</h3>
          <div class="price">$97<span>/mes</span></div>
          <p>Para empresas en crecimiento</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Todo del Starter</li>
          <li>✅ Sistema de tickets</li>
          <li>✅ Analytics avanzado</li>
          <li>✅ Hasta 5 agentes</li>
          <li>✅ Integraciones</li>
        </ul>
        <a href="/es/crear-bot" class="pricing-cta">Elegir Professional</a>
      </div>

      <div class="pricing-card">
        <div class="pricing-header">
          <h3>Enterprise</h3>
          <div class="price">$197<span>/mes</span></div>
          <p>Para grandes empresas</p>
        </div>
        <ul class="pricing-features">
          <li>✅ Todo del Professional</li>
          <li>✅ Agentes ilimitados</li>
          <li>✅ White-label</li>
          <li>✅ SLA garantizado</li>
          <li>✅ Consultoría</li>
        </ul>
        <a href="/es/contacto" class="pricing-cta">Hablar con Ventas</a>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="final-cta">
    <div class="cta-content">
      <h2>Transforma tu Negocio Hoy</h2>
      <p>Empieza a automatizar tu WhatsApp con IA avanzada. Resultados en 30 días.</p>
      <a href="/es/crear-bot" class="btn-primary-large">Empezar Ahora →</a>
    </div>
  </section>
</Layout>

<style>
  .hero-section { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; padding: 8rem 5%; max-width: 1400px; margin: 0 auto; align-items: center; }
  .hero-badge { background: rgba(0, 212, 255, 0.1); color: #00d4ff; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.9rem; font-weight: 600; display: inline-block; margin-bottom: 2rem; }
  .hero-content h1 { font-size: 3rem; font-weight: 900; margin-bottom: 1.5rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .hero-content p { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 2rem; line-height: 1.6; }
  .hero-features { display: flex; gap: 1rem; margin-bottom: 3rem; flex-wrap: wrap; }
  .hero-features span { background: rgba(0, 255, 157, 0.1); color: #00ff9d; padding: 0.5rem 1rem; border-radius: 15px; font-size: 0.9rem; font-weight: 600; }
  .hero-ctas { display: flex; gap: 1.5rem; }
  .btn-primary { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1rem 2rem; border-radius: 12px; font-weight: 800; text-decoration: none; transition: 0.3s; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0, 212, 255, 0.3); }
  .btn-secondary { border: 1px solid rgba(255,255,255,0.3); color: white; padding: 1rem 2rem; border-radius: 12px; font-weight: 600; text-decoration: none; transition: 0.3s; }
  .btn-secondary:hover { background: rgba(255,255,255,0.1); }

  .solutions-dashboard { background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2rem; }
  .dashboard-header { font-size: 1.2rem; font-weight: 800; color: #00d4ff; margin-bottom: 2rem; text-align: center; }
  .solutions-list { display: flex; flex-direction: column; gap: 1rem; }
  .solution-item { display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.05); padding: 1rem; border-radius: 10px; }
  .solution-icon { font-size: 2rem; }
  .solution-info { flex: 1; }
  .solution-title { color: white; font-weight: 600; display: block; }
  .solution-desc { color: #94a3b8; font-size: 0.9rem; }

  .solutions-section { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .solutions-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .solution-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 3rem; text-align: center; transition: 0.3s; }
  .solution-card:hover { transform: translateY(-10px); border-color: rgba(0, 212, 255, 0.3); }
  .solution-icon { font-size: 3rem; margin-bottom: 1.5rem; }
  .solution-card h3 { color: white; font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem; }
  .solution-card p { color: #e2e8f0; line-height: 1.6; margin-bottom: 1.5rem; }
  .solution-features { list-style: none; text-align: left; margin-bottom: 2rem; }
  .solution-features li { color: #e2e8f0; margin-bottom: 0.5rem; }
  .solution-cta { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 0.8rem 1.5rem; border-radius: 10px; font-weight: 700; text-decoration: none; display: inline-block; }

  .use-cases { padding: 8rem 5%; }
  .cases-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .case-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2.5rem; text-align: center; }
  .case-icon { font-size: 3rem; margin-bottom: 1rem; }
  .case-card h3 { color: white; font-size: 1.3rem; margin-bottom: 1rem; }
  .case-card p { color: #e2e8f0; line-height: 1.6; margin-bottom: 1.5rem; }
  .case-metrics { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .case-metrics span { background: rgba(0, 255, 157, 0.1); color: #00ff9d; padding: 0.5rem 1rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; }

  .benefits-section { padding: 8rem 5%; background: rgba(15, 23, 42, 0.5); }
  .benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .benefit-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 2.5rem; text-align: center; }
  .benefit-icon { font-size: 3rem; margin-bottom: 1rem; }
  .benefit-card h3 { color: white; font-size: 1.3rem; margin-bottom: 1rem; }
  .benefit-card p { color: #e2e8f0; line-height: 1.6; }

  .pricing-section { padding: 8rem 5%; max-width: 1200px; margin: 0 auto; }
  .pricing-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 4rem; }
  .pricing-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 3rem; text-align: center; position: relative; }
  .pricing-card.featured { border-color: #00d4ff; box-shadow: 0 0 30px rgba(0, 212, 255, 0.2); }
  .pricing-badge { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: #00d4ff; color: black; padding: 0.5rem 1rem; border-radius: 15px; font-weight: 800; font-size: 0.8rem; }
  .pricing-header h3 { color: white; font-size: 1.5rem; margin-bottom: 1rem; }
  .price { font-size: 3rem; font-weight: 900; color: #00ff9d; }
  .price span { font-size: 1rem; color: #94a3b8; }
  .pricing-features { list-style: none; text-align: left; margin: 2rem 0; }
  .pricing-features li { color: #e2e8f0; margin-bottom: 0.8rem; }
  .pricing-cta { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1rem 2rem; border-radius: 12px; font-weight: 800; text-decoration: none; display: inline-block; margin-top: 2rem; }

  .final-cta { padding: 8rem 5%; background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 255, 157, 0.1)); text-align: center; }
  .cta-content h2 { font-size: 3rem; font-weight: 900; margin-bottom: 1.5rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .cta-content p { font-size: 1.2rem; color: #e2e8f0; margin-bottom: 3rem; }
  .btn-primary-large { background: linear-gradient(135deg, #00d4ff, #00ff9d); color: black; padding: 1.5rem 3rem; border-radius: 15px; font-weight: 900; font-size: 1.2rem; text-decoration: none; transition: 0.3s; }
  .btn-primary-large:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(0, 212, 255, 0.4); }

  .section-header { text-align: center; margin-bottom: 4rem; }
  .section-header h2 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; background: linear-gradient(90deg, #00d4ff, #00ff9d); -webkit-background-clip: text; color: transparent; }
  .section-header p { color: #e2e8f0; font-size: 1.1rem; }

  @media (max-width: 900px) {
    .hero-section { grid-template-columns: 1fr; text-align: center; }
    .case-metrics { flex-direction: column; }
  }
</style>
