---
import Layout from '../../layouts/Layout.astro';

const title = "Analíticas Avanzadas para Ventas WhatsApp | GetNexo";
const description = "Analíticas en tiempo real para tus ventas WhatsApp. Rastrea conversiones, ROI, comportamiento del cliente y optimiza tu embudo de ventas con insights impulsados por IA.";
const keywords = "analíticas whatsapp, analíticas ventas, seguimiento conversiones, roi whatsapp, comportamiento cliente, optimización embudo ventas";

const lang = 'es';
---

<Layout title={title} description={description} keywords={keywords}>
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-center mb-8">Analíticas Avanzadas</h1>
      <p class="text-xl text-center text-gray-600 mb-12">Rastrea y optimiza el rendimiento de tus ventas WhatsApp</p>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-2xl font-semibold mb-4">Seguimiento de Conversiones</h3>
          <p>Monitorea cada paso de tu embudo de ventas desde el primer contacto hasta la finalización de la compra.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-2xl font-semibold mb-4">Analíticas de ROI</h3>
          <p>Mide el retorno de inversión de tus campañas de marketing WhatsApp en tiempo real.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-2xl font-semibold mb-4">Insights del Cliente</h3>
          <p>Entiende el comportamiento y preferencias del cliente para personalizar tu enfoque de ventas.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>