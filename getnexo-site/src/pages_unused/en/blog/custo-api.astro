---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "WhatsApp API Pricing: What You Really Pay",
      "description": "Breakdown of Meta's conversation-based pricing model.",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Costs"
    }
  ]
};
---
<Layout
  title="WhatsApp API Pricing Guide 2026 | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <header class="post-header">
      <div class="meta">Costs • Jan 2026</div>
      <h1>WhatsApp API Pricing:<br/><span class="text-primary">What You Really Pay</span></h1>
      <p class="subtitle">Breakdown of Meta's conversation-based pricing model.</p>
    </header>
    <div class="post-content">
      <p>Marketing, Utility, Authentication, and Service. Understand the categories and optimize your costs.</p>
      <a href="/en/pricing" class="btn-primary">View Plans</a>
    </div>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
