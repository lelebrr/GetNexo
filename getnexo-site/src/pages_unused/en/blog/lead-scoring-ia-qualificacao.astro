---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "AI Lead Scoring: Identify Gold Leads Automatically",
      "description": "Identify and prioritize high-intention leads automatically with AI.",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Intelligence"
    }
  ]
};
---
<Layout
  title="AI Lead Scoring: Identify Gold Leads | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <header class="post-header">
      <div class="meta">Intelligence • Jan 2026</div>
      <h1>AI Lead Scoring:<br/><span class="text-primary">Identify Gold Leads Automatically</span></h1>
      <p class="subtitle">Identify and prioritize high-intention leads automatically with AI.</p>
    </header>
    <div class="post-content">
      <p>Not all leads are created equal. AI scoring ensures your sales team spends time only on those ready to buy.</p>
      <a href="/en/create-bot" class="btn-primary">Try AI Scoring</a>
    </div>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
