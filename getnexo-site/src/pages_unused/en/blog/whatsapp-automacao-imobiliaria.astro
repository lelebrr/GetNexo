---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "WhatsApp for Real Estate: Automate Capture and Visits",
      "description": "Efficiently automate lead capture and visit scheduling with AI.",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Real Estate"
    }
  ]
};
---
<Layout
  title="WhatsApp for Real Estate: Capture & Visits | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <header class="post-header">
      <div class="meta">Real Estate • Jan 2026</div>
      <h1>WhatsApp for Real Estate:<br/><span class="text-primary">Automate Capture and Visits</span></h1>
      <p class="subtitle">Efficiently automate lead capture and visit scheduling with AI.</p>
    </header>
    <div class="post-content">
      <p>Real estate agents spend too much time qualifying leads. Let AI handle the first contact and only speak with serious buyers.</p>
      <a href="/en/create-bot" class="btn-primary">Real Estate Solution</a>
    </div>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
