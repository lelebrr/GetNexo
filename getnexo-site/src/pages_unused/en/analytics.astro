---
import Layout from '../../layouts/Layout.astro';

const title = "Advanced Analytics for WhatsApp Sales | GetNexo";
const description = "Real-time analytics for your WhatsApp sales. Track conversions, ROI, customer behavior and optimize your sales funnel with AI-powered insights.";
const keywords = "whatsapp analytics, sales analytics, conversion tracking, roi whatsapp, customer behavior analytics, sales funnel optimization";

const lang = 'en';
---

<Layout title={title} description={description} keywords={keywords}>
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-center mb-8">Advanced Analytics</h1>
      <p class="text-xl text-center text-gray-600 mb-12">Track and optimize your WhatsApp sales performance</p>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-2xl font-semibold mb-4">Conversion Tracking</h3>
          <p>Monitor every step of your sales funnel from first contact to purchase completion.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-2xl font-semibold mb-4">ROI Analytics</h3>
          <p>Measure the return on investment of your WhatsApp marketing campaigns in real-time.</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-2xl font-semibold mb-4">Customer Insights</h3>
          <p>Understand customer behavior and preferences to personalize your sales approach.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>