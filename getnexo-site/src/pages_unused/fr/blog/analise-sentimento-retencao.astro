---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Analyse de Sentiment : Le Cœur de la Rétention",
      "description": "Analyse de Sentiment : Le Cœur de la Rétention | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Analyse de Sentiment : Le Cœur de la Rétention | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Analyse de Sentiment :<br/><span class="text-primary">Le Cœur de la Rétention</span></h1>
    <p>Comprenez comment votre client se sent en temps réel et anticipez le churn avec précision.</p>
    <a href="/fr/creer-bot" class="btn-primary">Démarrer</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
