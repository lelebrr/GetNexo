---

<Layout title={pageTitle} description={pageDescription}>
  <div class="blog-index-page">
    <header class="blog-header">
      <div class="custom-container">
        <h1 class="hero-title">Blog <span class="text-gradient">GetNexo</span></h1>
        <p class="hero-subtitle">
          Apprenez à mettre à l'échelle votre opération avec l'IA et l'automatisation avancée sur WhatsApp.
        </p>
      </div>
    </header>

    <main class="blog-main">
      <div class="custom-container">
        <div class="blog-grid">
          {posts.map(post => (
            <article class:list={["blog-card glass-panel", { "featured": post.featured }]}>
              <div class="card-content">
                <div class="card-meta">
                  <span class="card-category">{post.category}</span>
                  <span class="card-date">{post.date}</span>
                </div>
                <h2><a href={`/fr/blog/${post.slug}`}>{post.title}</a></h2>
                <p>{post.excerpt}</p>
                <a href={`/fr/blog/${post.slug}`} class="read-more">
                   Lire l'Article <span class="arrow">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </main>
  </div>
</Layout>

<style>
/* Reusing styles */
  .blog-index-page { background: #030712; min-height: 100vh; padding-bottom: 8rem; }
  .custom-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .blog-header { padding: 10rem 0 6rem; text-align: center; }
  .hero-title { font-size: 4rem; font-weight: 800; margin-bottom: 1.5rem; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem; }
  .blog-card { padding: 2.5rem; display: flex; flex-direction: column; justify-content: space-between; height: 100%; transition: 0.4s; }
  .blog-card h2 { font-size: 1.6rem; font-weight: 800; margin-bottom: 1rem; }
  .blog-card h2 a { color: white; text-decoration: none; }
  .read-more { font-weight: 700; color: #fff; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; }
</style>
