---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Guide Officiel API WhatsApp : Tout ce que les Développeurs doivent savoir",
      "description": "Guide Officiel API WhatsApp pour Devs | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Guide Officiel API WhatsApp pour Devs | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Guide Officiel API WhatsApp :<br/><span class="text-primary">Tout ce que les Développeurs doivent savoir</span></h1>
    <p>Tout ce dont vous avez besoin pour une intégration robuste et évolutive.</p>
    <a href="/fr/creer-bot" class="btn-primary">Voir la Documentation</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
