---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Tarifs de l'API WhatsApp : Ce que vous payez réellement",
      "description": "Guide des Tarifs de l'API WhatsApp 2026 | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Guide des Tarifs de l'API WhatsApp 2026 | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Tarifs de l'API WhatsApp :<br/><span class="text-primary">Ce que vous payez réellement</span></h1>
    <p>Répartition du modèle de tarification basé sur les conversations de Meta.</p>
    <a href="/fr/prix" class="btn-primary">Voir les Tarifs</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
