---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Ventes High-Ticket : Le Guide de Luxe pour WhatsApp",
      "description": "Ventes High-Ticket sur WhatsApp : Guide de Luxe | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Ventes High-Ticket sur WhatsApp : Guide de Luxe | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Ventes High-Ticket :<br/><span class="text-primary">Le Guide de Luxe pour WhatsApp</span></h1>
    <p>Comment conclure des affaires importantes et des ventes consultatives via le chat.</p>
    <a href="/fr/creer-bot" class="btn-primary">Ventes High-Ticket</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
