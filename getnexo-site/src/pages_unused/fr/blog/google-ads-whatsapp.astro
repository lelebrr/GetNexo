---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Google Ads pour WhatsApp : La Stratégie de Conversion Cachée",
      "description": "Google Ads pour WhatsApp : La Stratégie Cachée | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="Google Ads pour WhatsApp : La Stratégie Cachée | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>Google Ads pour WhatsApp :<br/><span class="text-primary">La Stratégie de Conversion Cachée</span></h1>
    <p>Capturez l'intention de recherche et déplacez-la directement vers une conversation personnelle.</p>
    <a href="/fr/creer-bot" class="btn-primary">Connecter Google Ads</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
