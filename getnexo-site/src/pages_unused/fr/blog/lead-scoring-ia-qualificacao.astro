---
import Layout from '../../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "AI Lead Scoring : Identifiez les Leads d'Or Automatiquement",
      "description": "AI Lead Scoring : Identifiez les Leads d'Or | GetNexo",
      "author": { "@type": "Organization", "name": "GetNexo" },
      "publisher": { "@type": "Organization", "name": "GetNexo" },
      "datePublished": "2026-01-22",
      "articleSection": "Strategy"
    }
  ]
};
---
<Layout
  title="AI Lead Scoring : Identifiez les Leads d'Or | GetNexo" articleSchema={schema}
  type="article"
>
  <article class="post-container">
    <h1>AI Lead Scoring :<br/><span class="text-primary">Identifiez les Leads d'Or Automatiquement</span></h1>
    <p>Identifiez et priorisez les leads à fort potentiel automatiquement avec l'IA.</p>
    <a href="/fr/creer-bot" class="btn-primary">Tester le Scoring IA</a>
  </article>
</Layout>
<style>
  .post-container { max-width: 1000px; margin: 4rem auto; padding: 0 1.5rem; }
  h1 { font-size: 3.5rem; font-weight: 900; color: white; }
  .text-primary { color: #00f7ff; }
  .btn-primary { background: #00f7ff; color: black; padding: 1.2rem 3.5rem; border-radius: 50px; text-decoration: none; font-weight: 800; }
</style>
