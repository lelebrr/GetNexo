---
import Layout from '../../layouts/Layout.astro';

const title = "Prix GetNexo - Automatisation IA WhatsApp";
const description = "Prix transparents pour l'automatisation WhatsApp. Pas de frais cachés, pas de coûts de configuration. Payez seulement pour ce que vous utilisez.";
const keywords = "prix whatsapp, coût chatbot ia, prix whatsapp business, prix automatisation";

const lang = 'fr';
---

<Layout title={title} description={description} keywords={keywords}>
  <section class="py-20">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-center mb-8">Prix Transparents</h1>
      <p class="text-xl text-center text-gray-600 mb-12">Pas de mensualités. Payez seulement pour les transactions réussies.</p>

      <div class="max-w-4xl mx-auto">
        <div class="bg-white p-8 rounded-lg shadow-lg">
          <h2 class="text-2xl font-semibold mb-6">Comment Ça Marche</h2>
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-xl font-semibold mb-4">Gratuit pour Commencer</h3>
              <ul class="space-y-2">
                <li>• Configuration en 12 minutes</li>
                <li>• Fonctions IA de base</li>
                <li>• Jusqu'à 1,000 messages/mois</li>
                <li>• API WhatsApp Business</li>
              </ul>
            </div>
            <div>
              <h3 class="text-xl font-semibold mb-4">Payez par Succès</h3>
              <ul class="space-y-2">
                <li>• R$ 0.50 par transaction</li>
                <li>• Pas de mensualités</li>
                <li>• Évoluez avec votre croissance</li>
                <li>• Annulez quand vous voulez</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-12 text-center">
          <h3 class="text-2xl font-semibold mb-6">Calculateur de ROI</h3>
          <p class="text-gray-600 mb-8">Voyez combien vous pouvez économiser avec GetNexo</p>
          <div class="bg-blue-50 p-6 rounded-lg inline-block">
            <p class="text-lg">Client moyen économise R$ 2,500/mois</p>
            <p class="text-sm text-gray-600">Basé sur 500 conversations/mois</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>