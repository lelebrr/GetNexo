{
    "name": "Tone Analyzer Server",
    "nodes": [
        {
            "parameters": {
                "path": "tone",
                "method": "POST",
                "options": {}
            },
            "name": "Webhook Tone",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ]
        },
        {
            "parameters": {
                "operation": "set",
                "key": "={{ \"client_tone:\" + $json.body.client_id }}",
                "value": "={{ $json.body.score }}",
                "options": {
                    "expire": 86400
                }
            },
            "name": "Cache Redis Tone",
            "type": "n8n-nodes-base.redis",
            "typeVersion": 1,
            "position": [
                300,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "number": [
                        {
                            "value1": "={{ $json.body.score }}",
                            "operation": "greaterThan",
                            "value2": 0.7
                        }
                    ]
                }
            },
            "name": "If Anger High",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                500,
                300
            ]
        },
        {
            "parameters": {
                "message": "⚠️ *ALERTA DE RAIVA* ⚠️\nCliente {{ $json.body.client_id }} está muito irritado (Score: {{ $json.body.score }}).\n*Sugestão de Resposta*: \"Sinto muito que você esteja passando por isso. Vou resolver seu problema imediatamente.\"",
                "chatId": "-123456789"
            },
            "name": "Telegram Alert",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1,
            "position": [
                700,
                200
            ]
        },
        {
            "parameters": {
                "operation": "updateOne",
                "updateKey": "conversation_id",
                "updateValue": "={{ $json.body.conversation_id }}",
                "fields": {
                    "status": "open",
                    "priority": "urgent"
                }
            },
            "name": "Escalate Chatwoot",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                700,
                400
            ]
        }
    ],
    "connections": {
        "Webhook Tone": {
            "main": [
                [
                    {
                        "node": "Cache Redis Tone",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Cache Redis Tone": {
            "main": [
                [
                    {
                        "node": "If Anger High",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "If Anger High": {
            "main": [
                [
                    {
                        "node": "Telegram Alert",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Escalate Chatwoot",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}