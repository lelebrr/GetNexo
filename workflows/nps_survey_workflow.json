            "typeVersion": 1,
            "position": [
                680,
                300
            ]
        },
        {
            "parameters": {
                "resource": "database",
                "operation": "select",
                "tableName": "nps_surveys",
                "conditions": "survey_status = 'scheduled' AND order_date < NOW() - INTERVAL '24 hours'",
                "limit": 50
            },
            "name": "Get Pending Surveys",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                900,
                300
            ],
            "credentials": {
                "postgres": {
                    "id": "postgres_credentials",
                    "name": "Postgres account"
                }
