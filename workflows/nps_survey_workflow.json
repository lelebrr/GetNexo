        {
            "parameters": {
                "functionCode": "const surveyLink = `https://getnexo.com.br/nps-survey?token=${$node[\"Get Pending Surveys\"].json[\"order_id\"]}_${Date.now()}`;\n\nconst emailHtml = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Sua Opinião é Importante</title>\n</head>\n<body style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <div style=\"text-align: center; margin-bottom: 30px;\">\n    <img src=\"https://getnexo.com.br/logo.png\" alt=\"GetNexo\" style=\"max-width: 200px;\">\n  </div>\n  \n  <h1 style=\"color: #333; text-align: center;\">Olá ${$node[\"Get Pending Surveys\"].json[\"customer_name\"]}! 👋</h1>\n  \n  <p style=\"font-size: 16px; line-height: 1.6; color: #666;\">\n    Esperamos que tenha ficado satisfeito com sua compra recente em nossa loja!\n  </p>\n  \n  <p style=\"font-size: 16px; line-height: 1.6; color: #666;\">\n    Sua opinião é muito importante para nós. Por favor, responda esta rápida pesquisa de satisfação:\n  </p>\n  \n  <div style=\"text-align: center; margin: 40px 0;\">\n    <a href=\"${surveyLink}\" style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 15px 30px; text-decoration: none; border-radius: 25px; font-weight: bold; display: inline-block; box-shadow: 0 4px 15px rgba(0,0,0,0.2);\">Responder Pesquisa Agora</a>\n  </div>\n  \n  <p style=\"font-size: 14px; color: #888; text-align: center;\">\n    ⏰ A pesquisa leva menos de 1 minuto para responder\n  </p>\n  \n  <hr style=\"border: none; border-top: 1px solid #eee; margin: 30px 0;\">\n  \n  <p style=\"font-size: 16px; line-height: 1.6; color: #666;\">\n    <strong>Pedido #${$node[\"Get Pending Surveys\"].json[\"order_id\"]}</strong><br>\n    Valor: R$ ${$node[\"Get Pending Surveys\"].json[\"order_value\"].toFixed(2)}\n  </p>\n  \n  <p style=\"font-size: 14px; color: #666;\">\n    Atenciosamente,<br>\n    <strong>Equipe GetNexo</strong>\n  </p>\n  \n  <div style=\"text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n    <p style=\"font-size: 12px; color: #999;\">\n      Esta é uma mensagem automática. Para falar conosco, responda este email ou visite nosso site.\n    </p>\n  </div>\n</body>\n</html>`;\n\nconst emailText = `Olá ${$node[\"Get Pending Surveys\"].json[\"customer_name\"]}!\n\nEsperamos que tenha ficado satisfeito com sua compra recente!\n\nSua opinião é muito importante. Responda nossa rápida pesquisa:\n${surveyLink}\n\nPedido: #${$node[\"Get Pending Surveys\"].json[\"order_id\"]} - R$ ${$node[\"Get Pending Surveys\"].json[\"order_value\"].toFixed(2)}\n\nAtenciosamente,\nEquipe GetNexo`;\n\nreturn {\n  surveyLink,\n  emailHtml,\n  emailText\n};"
            },
            "name": "Generate Survey Email",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                1120,
                300
            ]
        },
        {
            "parameters": {
                "fromEmail": "pesquisa@getnexo.com.br",
                "toEmail": "={{ $json.customer_email }}",
                "subject": "Sua Opinião é Importante! ⭐",
                "html": "={{ $json.emailHtml }}",
                "text": "={{ $json.emailText }}",
                "options": {
                    "priority": "normal"
                }
            },
            "name": "Send Survey Email",
            "type": "n8n-nodes-base.emailSend",
            "typeVersion": 1,
            "position": [
                1340,
                300
            ],
            "credentials": {
                "smtp": {
                    "id": "smtp_credentials",
                    "name": "SMTP account"
