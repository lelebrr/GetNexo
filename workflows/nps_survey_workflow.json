        {
            "parameters": {
                "path": "nps-response",
                "responseMode": "responseNode",
                "options": {}
            },
            "name": "Survey Response Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                1780,
                100
            ]
        },
        {
            "parameters": {
                "functionCode": "// Parse survey response\nconst score = parseInt($node[\"Survey Response Webhook\"].json[\"score\"]);\nconst feedback = $node[\"Survey Response Webhook\"].json[\"feedback\"] || '';\nconst token = $node[\"Survey Response Webhook\"].json[\"token\"];\n\n// Extract order_id from token\nconst orderId = token.split('_')[0];\n\n// Calculate NPS category\nlet npsCategory = 'neutro';\nif (score >= 9) npsCategory = 'promotor';\nelse if (score <= 6) npsCategory = 'detrator';\n\n// Generate insights\nconst insights = {\n  urgency: score <= 6 ? 'high' : score >= 9 ? 'low' : 'medium',\n  sentiment: score <= 6 ? 'negative' : score >= 9 ? 'positive' : 'neutral',\n  action_needed: score <= 6,\n  referral_potential: score >= 9\n};\n\nreturn {\n  orderId,\n  score,\n  feedback,\n  npsCategory,\n  insights\n};"
            },
            "name": "Process Survey Response",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                2000,
                100
            ]
        },
        {
            "parameters": {
                "resource": "database",
                "operation": "update",
                "tableName": "nps_surveys",
                "updateFields": "survey_status,nps_score,nps_category,feedback,response_date",
                "updateValues": "'completed',{{$json.score}},'{{$json.npsCategory}}','{{$json.feedback}}',NOW()",
                "conditions": "order_id = '{{ $json.orderId }}'"
            },
            "name": "Save Survey Response",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                2220,
                100
            ],
            "credentials": {
                "postgres": {
                    "id": "postgres_credentials",
                    "name": "Postgres account"
                }
            }
        },
        {
            "parameters": {
                "value": "={{ $json.npsCategory }}",
                "rules": {
                    "rules": [
                        {
                            "conditions": [
                                {
                                    "id": "category",
                                    "value": "detrator"
                                }
                            ],
                            "output": "handle_detrator"
                        },
                        {
                            "conditions": [
                                {
                                    "id": "category",
                                    "value": "promotor"
                                }
                            ],
                            "output": "handle_promotor"
                        },
                        {
                            "conditions": [
                                {
                                    "id": "category",
                                    "value": "neutro"
                                }
                            ],
                            "output": "handle_neutro"
                        }
                    ]
                }
            },
            "name": "Route by NPS Category",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 1,
            "position": [
                2440,
                100
            ]
        },
        {
            "parameters": {
                "functionCode": "// Get customer data from database\nconst orderId = $node[\"Process Survey Response\"].json[\"orderId\"];\n\n// This would typically query the database for customer details\n// For now, we'll use placeholder data\nconst customerData = {\n  name: \"Cliente\",\n  email: \"cliente@email.com\",\n  phone: \"+5511999999999\",\n  order_value: 299.99,\n  last_purchase: \"2024-01-15\"\n};\n\nreturn customerData;"
