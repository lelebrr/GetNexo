        {
            "parameters": {
                "resource": "database",
                "operation": "update",
                "tableName": "nps_surveys",
                "updateFields": "survey_status,survey_sent_at",
                "updateValues": "'sent',NOW()",
                "conditions": "order_id = '{{ $json.order_id }}'"
            },
            "name": "Update Survey Status",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                1560,
                300
            ],
            "credentials": {
                "postgres": {
