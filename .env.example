# --- Application General ---
NODE_ENV=development
PORT=3006
SERVER_URL=https://api.getnexo.com.br

# --- Frontend ---
VITE_API_URL=https://api.getnexo.com.br

# --- Database (PostgreSQL) ---
# Used by both Backend and Evolution API
POSTGRES_USER=getnexo
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=getnexo_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://getnexo:strong_password@db:5432/getnexo_db

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- AI Models ---
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
# GROK_API_KEY=
# DEEPSEEK_API_KEY=

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=evolution_key_forte
EVOLUTION_URL=http://evolution:8080

# --- Cloudflare Tunnel (Optional) ---
CLOUDFLARED_TOKEN=your_tunnel_token_here

# --- Authentication & Security ---
JWT_SECRET=your_jwt_secret_here
ADMIN_PASSWORD=your_admin_password_here

# --- OAuth Providers ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
BASE_URL=http://localhost:4321

# --- Monitoring & Alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@getnexo.com.br
