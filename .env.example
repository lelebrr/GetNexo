# --- Application General ---
NODE_ENV=development
PORT=3006
SERVER_URL=https://api.getnexo.com.br
TZ=America/Sao_Paulo

# --- Frontend ---
VITE_API_URL=https://api.getnexo.com.br

# --- Database (PostgreSQL) ---
# Used by both Backend and Evolution API
POSTGRES_USER=getnexo
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=getnexo_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://getnexo:YOUR_POSTGRES_PASSWORD@db:5432/getnexo_db

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# --- AI Models ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
GROK_API_KEY=YOUR_GROK_API_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY

# --- Additional AI Providers (Optional) ---
OLLAMA_MODEL=phi3:mini
OLLAMA_ENABLED=true
GUARDRAIL_PII_REGEX=(?:\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}|\\d{11})
GUARDRAIL_MAX_TOKENS=4000

# --- Marketing Integrations ---
LINKEDIN_ACCESS_TOKEN=YOUR_LINKEDIN_ACCESS_TOKEN
LINKEDIN_ACCOUNT_ID=YOUR_LINKEDIN_ACCOUNT_ID

# --- E-commerce Integrations ---
SHOPIFY_API_KEY=YOUR_SHOPIFY_API_KEY
SHOPIFY_PASSWORD=YOUR_SHOPIFY_PASSWORD
SHOPIFY_STORE=YOUR_SHOPIFY_STORE
VTEX_APP_KEY=YOUR_VTEX_APP_KEY
VTEX_APP_TOKEN=YOUR_VTEX_APP_TOKEN
VTEX_ACCOUNT=YOUR_VTEX_ACCOUNT
NUVEMSHOP_ACCESS_TOKEN=YOUR_NUVEMSHOP_ACCESS_TOKEN
NUVEMSHOP_STORE_ID=YOUR_NUVEMSHOP_STORE_ID
WIX_SITE_ID=YOUR_WIX_SITE_ID
WIX_API_KEY=YOUR_WIX_API_KEY
BLING_API_KEY=YOUR_BLING_API_KEY
FRENET_TOKEN=YOUR_FRENET_TOKEN
MELHOR_ENVIO_TOKEN=YOUR_MELHOR_ENVIO_TOKEN
LOGGI_TOKEN=YOUR_LOGGI_TOKEN
UBER_DIRECT_TOKEN=YOUR_UBER_DIRECT_TOKEN
CORREIOS_CONTRATO=YOUR_CORREIOS_CONTRATO
CORREIOS_CODIGO=YOUR_CORREIOS_CODIGO
CORREIOS_SENHA=YOUR_CORREIOS_SENHA

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY
EVOLUTION_URL=http://evolution:8080

# --- WhatsApp Business Cloud API (Meta) ---
WA_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WA_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
WA_WEBHOOK_VERIFY_TOKEN=getnexo_verify_2026
WA_BUSINESS_ACCOUNT_ID=YOUR_BUSINESS_ACCOUNT_ID
WA_API_VERSION=v20.0

# --- Cloudflare Tunnel (Optional) ---
CLOUDFLARED_TOKEN=YOUR_CLOUDFLARED_TOKEN
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN

# --- Authentication & Security ---
JWT_SECRET=your_jwt_secret_here
ADMIN_PASSWORD=your_admin_password_here

# --- OAuth Providers ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
BASE_URL=http://localhost:4321

# --- Monitoring & Alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@getnexo.com.br

# --- Security & Limits ---
CORS_ORIGIN=https://getnexo.com.br
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
TRIAL_DAYS=36
INSTALL_DATE=2024-01-01

# --- Health Check ---
HEALTH_CHECK_ENABLED=true

