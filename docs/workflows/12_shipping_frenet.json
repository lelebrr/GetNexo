{
    "name": "12_Frenet_Shipping",
    "nodes": [
        {
            "parameters": {},
            "name": "Start",
            "type": "n8n-nodes-base.start",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "url": "http://api.frenet.com.br/shipping/quote",
                "method": "POST",
                "authentication": "headerAuth",
                "headerParametersUi": {
                    "parameter": [
                        {
                            "name": "token",
                            "value": "YOUR_FRENET_TOKEN"
                        }
                    ]
                },
                "bodyParametersUi": {
                    "parameter": [
                        {
                            "name": "SellerCEP",
                            "value": "00000000"
                        },
                        {
                            "name": "RecipientCEP",
                            "value": "={{$json[\"cep\"]}}"
                        },
                        {
                            "name": "ShipmentInvoiceValue",
                            "value": "100"
                        }
                    ]
                }
            },
            "name": "Frenet Quote",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        }
    ],
    "connections": {
        "Start": {
            "main": [
                [
                    {
                        "node": "Frenet Quote",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}