{
    "name": "24_License_Validation",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "validate-license",
                "options": {}
            },
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "operation": "get",
                "key": "license:{{$json[\"body\"][\"license_key\"]}}"
            },
            "name": "Check Redis",
            "type": "n8n-nodes-base.redis",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{$json[\"data\"] == \"VALID\"}}",
                            "value2": true
                        }
                    ]
                }
            },
            "name": "Is Valid?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "{\n  \"status\": \"authorized\",\n  \"valid_until\": \"2099-12-31\"\n}",
                "options": {}
            },
            "name": "Respond OK",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                850,
                200
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "{\n  \"status\": \"denied\",\n  \"reason\": \"Invalid License\"\n}",
                "options": {
                    "responseCode": 403
                }
            },
            "name": "Respond Forbidden",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                850,
                400
            ]
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "Check Redis",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Check Redis": {
            "main": [
                [
                    {
                        "node": "Is Valid?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Valid?": {
            "main": [
                [
                    {
                        "node": "Respond OK",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Respond Forbidden",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}